import core.assert.assert_eq
import testing.test

@test
fun a_long_name_is_filed_by_two_letter_pairs(): void {
    assert_eq(index_file_path("json").as_str(), "js/on/json.toml", "letters 1-2, then 3-4")
}

@test
fun a_three_letter_name_is_filed_by_its_first_letter(): void {
    assert_eq(index_file_path("yml").as_str(), "3/y/yml.toml", "short names get their own tree")
}

@test
fun a_two_letter_name_is_filed_by_length(): void {
    assert_eq(index_file_path("io").as_str(), "2/io.toml", "too short to split")
}

fun sample_entry(): str {
    return """schema = 1
name = "json"

[[version]]
version = "0.1.0"
source = { git = "https://example.org/json.git", rev = "abc" }
yanked = true
"""
}

@test
fun an_entry_reads_its_source(): void {
    val versions = parse_index_file(sample_entry())
    assert_eq(versions.at(0).rev.as_str(), "abc", "the pinned commit")
}

@test
fun an_entry_reads_a_yank(): void {
    val versions = parse_index_file(sample_entry())
    assert_eq(versions.at(0).yanked, true, "hidden from new resolution")
}

@test
fun an_entry_of_another_schema_reads_as_empty(): void {
    val versions = parse_index_file("schema = 2\nname = \"json\"\n\n[[version]]\nversion = \"0.1.0\"\n")
    assert_eq(versions.size(), 0, "a newer layout this komp cannot read")
}

@test
fun a_url_becomes_one_readable_directory(): void {
    assert_eq(url_as_directory("https://github.com/komp-co/index").as_str(), "github.com_komp-co_index",
        "scheme dropped, separators flattened")
}
