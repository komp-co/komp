// A line-by-line kf.toml parser; unknown keys are ignored.
//
//   [project] or [package]
//   name = "komp"
//   kind = "bin"           # "bin" (default) or "lib"
//
//   [lib]                  # in place of `kind`: the package holds a library,
//   [bin]                  # a program, or both; package_layout.kf has the rule
//
//   [lib]
//   name = "testing"       # the library crate's name, the package's by default
//
//   [dependencies]
//   kf_core = { path = "../kf-core" }     # dependency.kf reads the row
//
//   [dev-dependencies]     # as [dependencies], for the crate's tests only

import alloc.list.*

pub struct Manifest {
    pub val name: String
    /// "0" when absent.
    pub val version: String
    /// "bin" (default, gets a C `main`) or "lib".
    pub val kind: String
    /// `[lib]` and `[bin]` sections, which say what the package holds in
    /// place of `kind`.
    pub val lib_section: bool
    pub val bin_section: bool
    /// `[lib] name`, or "".
    pub val lib_name: String
    pub val deps: List<Dependency>
    /// What the crate's `_test.kf` files need beyond `deps`.
    pub val dev_deps: List<Dependency>
    /// `[lint]` rows verbatim, in file order; validated against the registry
    /// elsewhere.
    pub val lint_names: List<String>
    pub val lint_levels: List<String>
    /// Leaves out every crate's `hosted_c_sources`. Read from the root
    /// manifest only.
    pub val freestanding: bool
    pub val error: String
}

/// `dep_error` is the first malformed dependency's, or "".
pub fun new_manifest_with_lints(name: String, version: String, kind: String, deps: List<Dependency>,
    lint_names: List<String>, lint_levels: List<String>, freestanding: bool,
    dep_error: String): Manifest {
    val error = if name.as_str() == "" {
        String.from("manifest has no crate name (expected name in [project] or [package])")
    } else {
        dep_error
    }
    return Manifest {
        name: name, version: version, kind: kind, lib_section: false, bin_section: false, lib_name: "", deps: deps,
        dev_deps: List.new<Dependency>(), lint_names: lint_names, lint_levels: lint_levels,
        freestanding: freestanding, error: error
    }
}

/// Malformed lines are skipped; a missing name sets `Manifest.error`.
pub fun parse_manifest(src: str): Manifest {
    var name = ""
    var version = String.from("0")
    var kind = String.from("bin")
    var kind_given = false
    var lib_section = false
    var bin_section = false
    var lib_name = String.from("")
    var deps = List.new<Dependency>()
    var dev_deps = List.new<Dependency>()
    var lint_names = List.new<String>()
    var lint_levels = List.new<String>()
    var freestanding = false
    var section = ""
    var dep_error = String.from("")
    var index_names = List.new<String>()
    var index_urls = List.new<String>()

    val lines = split_lines(src)
    while raw in &lines {
        val line = trim_string(raw)
        val line_s = line.as_str()
        val is_blank = line_s == ""
        val is_comment = string_starts_with_byte(line, 35) // '#'
        if !is_blank {
            if !is_comment {
                val is_section = string_starts_with_byte(line, 91) // '['
                if is_section {
                    section = read_section_name(line)
                    if section.as_str() == "lib" { lib_section = true }
                    if section.as_str() == "bin" { bin_section = true }
                } else {
                    val sect_str = section.as_str()
                    val in_project = sect_str == "project" || sect_str == "package"
                    val in_deps = sect_str == "dependencies"
                    if in_project {
                        val key = read_key(line)
                        val k_str = key.as_str()
                        val is_name = k_str == "name"
                        if is_name {
                            name = read_string_value(line)
                        }
                        val is_version = k_str == "version"
                        if is_version {
                            version = read_string_value(line)
                        }
                        val is_kind = k_str == "kind"
                        if is_kind {
                            kind = read_string_value(line)
                            kind_given = true
                        }
                        val is_freestanding = k_str == "freestanding"
                        if is_freestanding {
                            freestanding = read_bool_value(line)
                        }
                    }
                    // One `name = "level"` per row.
                    if sect_str == "lint" {
                        val key = read_key(line)
                        val value = read_string_value(line)
                        if key.as_str() != "" && value.as_str() != "" {
                            lint_names.push(key.clone())
                            lint_levels.push(value.clone())
                        }
                    }
                    // One `name = "url"` per row.
                    if sect_str == "indexes" {
                        index_names.push(read_key(line.clone()))
                        index_urls.push(read_string_value(line.clone()))
                    }
                    if sect_str == "lib" && read_key(line.clone()).as_str() == "name" {
                        lib_name = read_string_value(line.clone())
                    }
                    if in_deps || sect_str == "dev-dependencies" {
                        val dep = parse_dependency(read_key(line.clone()), line.as_str())
                        if dep_error.byte_len() == 0 { dep_error = dep.source_error() }
                        if in_deps { deps.push(dep) } else { dev_deps.push(dep) }
                    }
                }
            }
        }
    }
    val looked_up = deps.looked_up_in(&index_names, &index_urls, &var dep_error)
    val dev_looked_up = dev_deps.looked_up_in(&index_names, &index_urls, &var dep_error)
    if kind_given && (lib_section || bin_section) && dep_error.byte_len() == 0 {
        dep_error = "`kind` and a `[lib]` or `[bin]` section both say what the package holds; keep the sections"
    }
    val made = new_manifest_with_lints(name, version, kind, looked_up, lint_names, lint_levels, freestanding, dep_error)
    return Manifest {
        name: made.name, version: made.version, kind: made.kind, lib_section: lib_section, bin_section: bin_section,
        lib_name: lib_name, deps: made.deps, dev_deps: dev_looked_up, lint_names: made.lint_names,
        lint_levels: made.lint_levels, freestanding: made.freestanding, error: made.error
    }
}

/// Each dependency naming a version, given the URL of the index it names;
/// the first index `[indexes]` does not declare goes in `error` unless one
/// is there already.
fun List<Dependency>.looked_up_in(index_names: &List<String>, index_urls: &List<String>,
    error: &var String): List<Dependency> {
    var out = List.new<Dependency>()
    while dep in &self {
        if dep.version.byte_len() == 0 {
            out.push(dep.clone())
            continue
        }
        val url = index_url_for(dep.index.as_str(), index_names, index_urls)
        if url.byte_len() == 0 && error.byte_len() == 0 {
            (*error) = "dependency `${dep.name}` names index `${dep.index}`, which `[indexes]` does not declare"
        }
        out.push(dep.in_index(url.as_str()))
    }
    return out
}

/// `[native] c_sources`: C files, relative to the crate root, compiled and
/// linked into every build. A lib bakes them into its archive.
pub fun manifest_c_sources(src: str): List<String> {
    return native_source_array(src, "c_sources")
}

/// `[native] hosted_c_sources`: C needing a hosted library. A freestanding
/// root drops them, so a symbol defined only here fails at link, naming
/// itself.
pub fun manifest_hosted_c_sources(src: str): List<String> {
    return native_source_array(src, "hosted_c_sources")
}

/// The whole key is compared: `c_sources` is a prefix of `hosted_c_sources`.
fun native_source_array(src: str, key: str): List<String> {
    var sources = List.new<String>()
    var in_native = false
    var collecting = false
    val lines = split_lines(src)
    while item in &lines {
        val line = trim_string(item)
        if string_starts_with_byte(line, 91) { // '['
            in_native = line.as_str() == "[native]"
            collecting = false
        } else {
            if in_native && !collecting && read_key(line).as_str() == key {
                collecting = true
            }
            if collecting {
                append_quoted_values(line.as_str(), &var sources)
                if string_contains_byte(line.as_str(), 93) { collecting = false } // ']'
            }
        }
    }
    return sources
}

pub fun split_lines(src: str): List<String> {
    var out = List.new<String>()
    val n = src.byte_len()
    var i = 0
    var start: uint64 = 0
    while i < n {
        val b = src.byte_at(i)
        if b == 10 { // '\n'
            val line = src.substring(start, i)
            out.push(line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        val line = src.substring(start, n)
        out.push(line)
    }
    return out
}

pub fun trim_string(s: String): String {
    val ss = s.as_str()
    val n = ss.byte_len()
    var i = 0
    while i < n {
        val b = ss.byte_at(i)
        val ws = b == 32 || b == 9 || b == 13
        if !ws {
            return ss.substring(i, n)
        }
        i = i + 1
    }
    return ""
}

pub fun string_starts_with_byte(s: String, byte: uint8): bool {
    val ss = s.as_str()
    val n = ss.byte_len()
    if n == 0 { return false }
    val b = ss.byte_at(0)
    return b == byte
}

fun string_contains_byte(s: str, byte: uint8): bool {
    val n = s.byte_len()
    var i = 0
    while i < n {
        if s.byte_at(i) == byte { return true }
        i = i + 1
    }
    return false
}

fun append_quoted_values(line: str, out: &var List<String>): void {
    val n = line.byte_len()
    var i = 0
    while i < n {
        if line.byte_at(i) == 34 {
            val start = i + 1
            i = start
            while i < n && line.byte_at(i) != 34 { i = i + 1 }
            if i < n { out.push(line.substring(start, i)) }
        }
        i = i + 1
    }
}

// '[section]' -> 'section'
pub fun read_section_name(s: String): String {
    val line = s.as_str()
    val n = line.byte_len()
    var end = n
    if n > 0 {
        val last = line.byte_at(n - 1)
        if last == 93 { end = n - 1 } // ']'
    }
    return line.substring(1, end)
}

// 'key = ...' -> 'key'
pub fun read_key(s: String): String {
    val line = s.as_str()
    val n = line.byte_len()
    var i = 0
    while i < n {
        val b = line.byte_at(i)
        val sep = b == 32 || b == 9 || b == 61 // ws or '='
        if sep { return line.substring(0, i) }
        i = i + 1
    }
    return ""
}

// 'name = "value"' -> 'value'
pub fun read_string_value(s: String): String {
    val line = s.as_str()
    val n = line.byte_len()
    var i = 0
    while i < n {
        val b = line.byte_at(i)
        if b == 34 { // '"'
            val first = i + 1
            i = first
            while i < n {
                val c = line.byte_at(i)
                if c == 34 {
                    return line.substring(first, i)
                }
                i = i + 1
            }
        }
        i = i + 1
    }
    return ""
}

// 'key = true' -> true. Anything else is false, a quoted "true" included.
pub fun read_bool_value(s: String): bool {
    val line = s.as_str()
    val n = line.byte_len()
    var i = 0
    while i < n {
        if line.byte_at(i) == 61 { // '='
            val tail = line.substring(i + 1, n)
            return trim_string(tail).as_str() == "true"
        }
        i = i + 1
    }
    return false
}
