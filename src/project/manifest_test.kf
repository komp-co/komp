import core.assert.assert_eq
import testing.test

fun sample_workspace(): str {
    return "[workspace]\nmembers = [\n  \"app\",\n  \"libs/core\"\n]\ndefault-member = \"app\"\n"
}

@test
fun test_package_section_supplies_project_fields(): void {
    val manifest = parse_manifest("[package]\nname = \"probe\"\nversion = \"1.2.3\"\nkind = \"lib\"\n")
    val fields_match = manifest.name.as_str() == "probe" && manifest.version.as_str() == "1.2.3" && manifest.kind.as_str() == "lib"
    assert_eq(fields_match, true, "package is an alias for the project section")
}

@test
fun test_manifest_without_name_reports_error(): void {
    val manifest = parse_manifest("[project]\nkind = \"bin\"\n")
    assert_eq(manifest.error.as_str(), "manifest has no crate name (expected name in [project] or [package])", "a nameless manifest is invalid")
}

@test
fun workspace_members_reads_multiline_array(): void {
    val members = workspace_members(sample_workspace())
    assert_eq(members.size(), 2, "workspace member count")
}

@test
fun workspace_members_preserves_nested_path(): void {
    val members = workspace_members(sample_workspace())
    assert_eq(members.at(1).as_str(), "libs/core", "nested workspace member")
}

@test
fun workspace_default_member_is_read(): void {
    assert_eq(workspace_default_member(sample_workspace()).as_str(), "app", "default member")
}

// `c_sources` is every build's; `hosted_c_sources` needs an OS. Only the root
// program says which world it is in.

@test
fun hosted_c_sources_is_read_separately_from_c_sources(): void {
    val src = "[native]\nc_sources = [\"native/core.c\"]\nhosted_c_sources = [\"native/core_hosted.c\"]\n"
    val plain = manifest_c_sources(src)
    val hosted = manifest_hosted_c_sources(src)
    val plain_ok = plain.size() == 1 && plain.at(0).as_str() == "native/core.c"
    val hosted_ok = hosted.size() == 1 && hosted.at(0).as_str() == "native/core_hosted.c"
    val split_cleanly = plain_ok && hosted_ok
    assert_eq(split_cleanly, true, "the two native arrays do not bleed into each other")
}

@test
fun a_manifest_without_the_hosted_key_has_no_hosted_sources(): void {
    val hosted = manifest_hosted_c_sources("[native]\nc_sources = [\"native/core.c\"]\n")
    assert_eq(hosted.size(), 0, "hosted_c_sources is optional")
}

@test
fun freestanding_is_off_unless_the_project_asks_for_it(): void {
    val manifest = parse_manifest("[project]\nname = \"probe\"\n")
    assert_eq(manifest.freestanding, false, "a project is hosted by default")
}

@test
fun a_project_can_declare_itself_freestanding(): void {
    val manifest = parse_manifest("[project]\nname = \"probe\"\nfreestanding = true\n")
    assert_eq(manifest.freestanding, true, "freestanding = true is read")
}

@test
fun freestanding_false_is_read_as_written(): void {
    val manifest = parse_manifest("[project]\nname = \"probe\"\nfreestanding = false\n")
    assert_eq(manifest.freestanding, false, "freestanding = false stays hosted")
}

fun one_dependency(row: str): Manifest {
    return parse_manifest("[project]\nname = \"app\"\n\n[dependencies]\n${row}\n".as_str())
}

@test
fun a_path_inside_a_git_url_is_not_a_path(): void {
    val manifest = one_dependency("json = { git = \"https://example.org/path/json.git\" }")
    assert_eq(manifest.deps.at(0).path.as_str(), "", "only a whole `path` key is a path")
}

@test
fun a_git_dependency_keeps_its_tag(): void {
    val manifest = one_dependency("json = { git = \"https://example.org/json.git\", tag = \"v0.2.0\" }")
    assert_eq(manifest.deps.at(0).tag.as_str(), "v0.2.0", "the ref travels with the source")
}

@test
fun a_dependency_without_a_source_is_an_error(): void {
    val manifest = one_dependency("json = { features = \"x\" }")
    val expected = "dependency `json` names no source: give it a version, `path`, `git` or `tarball`"
    assert_eq(manifest.error.as_str(), expected,
        "a table needs one of them")
}

@test
fun a_dependency_with_two_sources_is_an_error(): void {
    val manifest = one_dependency("json = { path = \"../json\", git = \"https://example.org/json.git\" }")
    val expected = "dependency `json` names more than one of a version, `path`, `git` and `tarball`"
    assert_eq(manifest.error.as_str(), expected,
        "which one would win is not the user's to guess")
}

@test
fun a_ref_without_git_is_an_error(): void {
    val manifest = one_dependency("json = { path = \"../json\", tag = \"v1\" }")
    assert_eq(manifest.error.as_str(), "dependency `json`: `rev`, `tag` and `branch` apply only to a `git` source",
        "a path has no refs")
}

@test
fun two_refs_are_an_error(): void {
    val manifest = one_dependency("json = { git = \"https://example.org/json.git\", tag = \"v1\", branch = \"main\" }")
    assert_eq(manifest.error.as_str(), "dependency `json` names more than one of `rev`, `tag` and `branch`",
        "one ref picks one commit")
}

@test
fun a_checksum_needs_its_algorithm(): void {
    val manifest = one_dependency("json = { tarball = \"https://example.org/json.tar.gz\", checksum = \"abc\" }")
    assert_eq(manifest.error.as_str(), "dependency `json`: a checksum is written `sha256:<hex digest>`",
        "the prefix leaves room for another algorithm")
}

@test
fun a_bare_version_is_a_requirement(): void {
    val manifest = one_dependency("json = \"0.2\"")
    assert_eq(manifest.deps.at(0).version.as_str(), "0.2", "a string row is a version")
}

@test
fun a_bare_version_is_looked_up_in_the_default_index(): void {
    val manifest = one_dependency("json = \"0.2\"")
    assert_eq(manifest.deps.at(0).index_url.as_str(), default_index_url().as_str(), "no `index` key")
}

@test
fun a_named_index_is_looked_up_in_indexes(): void {
    val dependencies = "[dependencies]\njson = { version = \"0.2\", index = \"work\" }\n"
    val manifest = parse_manifest(
        "[project]\nname = \"app\"\n\n${dependencies}\n[indexes]\nwork = \"file:///srv/index\"\n".as_str())
    assert_eq(manifest.deps.at(0).index_url.as_str(), "file:///srv/index", "`[indexes]` may follow its user")
}

@test
fun an_undeclared_index_is_an_error(): void {
    val manifest = one_dependency("json = { version = \"0.2\", index = \"work\" }")
    assert_eq(manifest.error.as_str(), "dependency `json` names index `work`, which `[indexes]` does not declare",
        "a typo in an index name")
}

@test
fun a_malformed_requirement_is_an_error(): void {
    val manifest = one_dependency("json = \"^0.2\"")
    assert_eq(manifest.error.as_str(), "dependency `json`: `^0.2` is not a version requirement such as \"1.4\"",
        "the caret is implied, and not written")
}

@test
fun dev_dependencies_are_read_apart_from_dependencies(): void {
    val manifest = parse_manifest("""[project]
name = "app"

[dev-dependencies]
helper = { path = "../helper" }
""")
    assert_eq(manifest.dev_deps.size() == 1 && manifest.deps.size() == 0, true, "only the tests use them")
}

@test
fun a_dev_dependency_by_version_is_looked_up_in_the_default_index(): void {
    val manifest = parse_manifest("[project]\nname = \"app\"\n\n[dev-dependencies]\ntesting = \"0.1\"\n")
    assert_eq(manifest.dev_deps.at(0).index_url.as_str(), default_index_url().as_str(), "as a dependency would be")
}

@test
fun a_lib_section_may_name_the_library(): void {
    val manifest = parse_manifest("[project]\nname = \"komp_test\"\n\n[lib]\nname = \"testing\"\n\n[bin]\n")
    assert_eq(manifest.first_crate_name().as_str(), "testing", "what a dependent imports")
}
