import core.assert.assert_eq
import testing.test

fun allows(requirement: str, version: str): bool {
    val wanted = parse_requirement(requirement) ?: return false
    val have = parse_version(version) ?: return false
    return wanted.allows(&have)
}

@test
fun a_minor_requirement_allows_a_later_patch(): void {
    assert_eq(allows("1.4", "1.4.7"), true, "a patch is compatible")
}

@test
fun a_minor_requirement_allows_a_later_minor(): void {
    assert_eq(allows("1.4", "1.9.0"), true, "past 1.0 a minor is compatible")
}

@test
fun a_minor_requirement_refuses_the_next_major(): void {
    assert_eq(allows("1.4", "2.0.0"), false, "a major is breaking")
}

@test
fun a_minor_requirement_refuses_an_earlier_minor(): void {
    assert_eq(allows("1.4", "1.3.9"), false, "the requirement is a floor")
}

@test
fun below_one_the_minor_is_breaking(): void {
    assert_eq(allows("0.2", "0.3.0"), false, "0.x treats the minor as the major")
}

@test
fun below_one_a_patch_is_compatible(): void {
    assert_eq(allows("0.2", "0.2.5"), true, "0.2 allows 0.2.5")
}

@test
fun a_zero_zero_requirement_is_exact(): void {
    assert_eq(allows("0.0.3", "0.0.4"), false, "0.0.x has no compatible neighbour")
}

@test
fun a_bare_zero_allows_any_zero_version(): void {
    assert_eq(allows("0", "0.9.0"), true, "`0` is <1.0.0")
}

@test
fun a_requirement_with_a_suffix_is_not_parsed(): void {
    assert_eq(parse_requirement("1.0.0-beta").is_none(), true, "pre-releases are not supported")
}

@test
fun a_version_needs_three_parts(): void {
    assert_eq(parse_version("1.0").is_none(), true, "an index version is exact")
}

@test
fun versions_order_numerically(): void {
    val nine = parse_version("0.9.0") ?: return
    val ten = parse_version("0.10.0") ?: return
    assert_eq(nine.compare(&ten) < 0, true, "0.9 < 0.10, not as text")
}
