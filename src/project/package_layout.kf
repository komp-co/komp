// What a package builds and where each part's sources are:
//
//   neither section   `kind` decides; the sources are `src/`
//   [lib]             a library, from `src/lib/`
//   [bin]             a program, from `src/bin/`
//   [lib] and [bin]   both; the program is a crate of its own, depending on
//                     the library, and the binary takes the package's name

pub fun Manifest.has_sections(): bool {
    return self.lib_section || self.bin_section
}

pub fun Manifest.has_library(): bool {
    return if self.has_sections() { self.lib_section } else { self.kind.as_str() != "bin" }
}

pub fun Manifest.has_program(): bool {
    return if self.has_sections() { self.bin_section } else { self.kind.as_str() == "bin" }
}

/// Both a library and a program: two crates in one package.
pub fun Manifest.holds_both(): bool {
    return self.lib_section && self.bin_section
}

/// The directory holding the sources of the crate a dependent builds against:
/// the library, or for a package holding only a program, that program.
pub fun Manifest.first_source_dir(root: str): String {
    if !self.has_sections() { return "${root}/src" }
    return if self.lib_section { "${root}/src/lib" } else { "${root}/src/bin" }
}

/// The crate a dependent builds against: the library, named by `[lib] name`
/// or after the package, or for a package holding only a program, that
/// program.
pub fun Manifest.first_crate_name(): String {
    return if self.has_library() && self.lib_name.byte_len() > 0 { self.lib_name.clone() } else { self.name.clone() }
}

/// The program's crate in a package holding both, named apart from the
/// library.
pub fun Manifest.program_crate_name(): String {
    return "${self.name}_bin"
}

pub fun program_source_dir(root: str): String {
    return "${root}/src/bin"
}
