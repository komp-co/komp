import std.env.env_var
// A `[dependencies]` row and where its crate comes from.
//
//   name = "0.2"                                                # from an index
//   name = { version = "0.2", index = "work" }                  # a named one
//   name = { path = "../name" }
//   name = { git = "https://host/name.git", tag = "v1.0.0" }    # or rev, branch
//   name = { tarball = "https://host/name.tar.gz", checksum = "sha256:..." }

/// Exactly one of `version`, `path`, `git` and `tarball` is set; the rest
/// are "". `index_url` is where a `version` is looked up.
@derive(Clone)
pub struct Dependency {
    pub val name: String
    pub val version: String
    pub val index: String
    pub val index_url: String
    pub val path: String
    pub val git: String
    pub val rev: String
    pub val tag: String
    pub val branch: String
    pub val tarball: String
    pub val checksum: String
}

pub fun new_dependency(name: String, path: String): Dependency {
    return Dependency {
        name: name, version: "", index: "", index_url: "", path: path, git: "", rev: "", tag: "", branch: "",
        tarball: "", checksum: ""
    }
}

/// `line` is the whole row, key included. `index_url` is left for the
/// manifest, which knows its `[indexes]`.
pub fun parse_dependency(name: String, line: str): Dependency {
    val bare_version = if line.contains("{") { String.from("") } else { read_string_value(String.from(line)) }
    return Dependency {
        name: name,
        version: if bare_version.byte_len() > 0 { bare_version } else { inline_table_value(line, "version") },
        index: inline_table_value(line, "index"),
        index_url: "",
        path: inline_table_value(line, "path"),
        git: inline_table_value(line, "git"),
        rev: inline_table_value(line, "rev"),
        tag: inline_table_value(line, "tag"),
        branch: inline_table_value(line, "branch"),
        tarball: inline_table_value(line, "tarball"),
        checksum: inline_table_value(line, "checksum")
    }
}

impl Dependency {
    /// Fetched rather than found on disk.
    pub fun is_remote(): bool {
        return self.version.byte_len() > 0 || self.git.byte_len() > 0 || self.tarball.byte_len() > 0
    }

    /// The same row, looked up in the index at `url`.
    pub fun in_index(url: str): Dependency {
        return Dependency {
            name: self.name.clone(), version: self.version.clone(), index: self.index.clone(),
            index_url: String.from(url),
            path: self.path.clone(), git: self.git.clone(), rev: self.rev.clone(), tag: self.tag.clone(),
            branch: self.branch.clone(), tarball: self.tarball.clone(), checksum: self.checksum.clone()
        }
    }

    /// "" for a well-formed row, else why it is not.
    pub fun source_error(): String {
        val sources = self.version.count_if_set() + self.path.count_if_set() + self.git.count_if_set() +
            self.tarball.count_if_set()
        if sources == 0 {
            return "dependency `${self.name}` names no source: give it a version, `path`, `git` or `tarball`"
        }
        if sources > 1 {
            return "dependency `${self.name}` names more than one of a version, `path`, `git` and `tarball`"
        }
        if self.index.byte_len() > 0 && self.version.byte_len() == 0 {
            return "dependency `${self.name}`: `index` applies only to a version"
        }
        if self.version.byte_len() > 0 && parse_requirement(self.version.as_str()).is_none() {
            return "dependency `${self.name}`: `${self.version}` is not a version requirement such as \"1.4\""
        }
        val refs = self.rev.count_if_set() + self.tag.count_if_set() + self.branch.count_if_set()
        if refs > 0 && self.git.byte_len() == 0 {
            return "dependency `${self.name}`: `rev`, `tag` and `branch` apply only to a `git` source"
        }
        if refs > 1 {
            return "dependency `${self.name}` names more than one of `rev`, `tag` and `branch`"
        }
        if self.checksum.byte_len() > 0 && self.tarball.byte_len() == 0 {
            return "dependency `${self.name}`: `checksum` applies only to a `tarball` source"
        }
        if self.checksum.byte_len() > 0 && !self.checksum.as_str().starts_with("sha256:") {
            return "dependency `${self.name}`: a checksum is written `sha256:<hex digest>`"
        }
        return ""
    }
}

fun String.count_if_set(): int32 {
    return if self.byte_len() > 0 { 1 } else { 0 }
}

/// The quoted value of `key` in the row's `{ ... }`, or "". Only whole keys
/// match, so a URL containing `path` is not a `path`.
pub fun inline_table_value(line: str, key: str): String {
    val n = line.byte_len()
    var i: uint64 = 0
    while i < n && line.byte_at(i) != 123 { i = i + 1 } // '{'
    i = i + 1
    while i < n {
        // Separators between entries: whitespace and ','.
        while i < n && is_table_space(line.byte_at(i)) { i = i + 1 }
        if i >= n || line.byte_at(i) == 125 { return "" } // '}'
        val key_start = i
        while i < n && !is_table_space(line.byte_at(i)) && line.byte_at(i) != 61 { i = i + 1 }
        val found = line.substring(key_start, i)
        while i < n && (is_table_space(line.byte_at(i)) || line.byte_at(i) == 61) { i = i + 1 }
        if i < n && line.byte_at(i) == 34 { // '"'
            val value_start = i + 1
            i = value_start
            while i < n && line.byte_at(i) != 34 { i = i + 1 }
            if found.as_str() == key { return line.substring(value_start, i) }
            i = i + 1
        } else {
            // An unquoted value: skip to the next entry.
            while i < n && line.byte_at(i) != 44 && line.byte_at(i) != 125 { i = i + 1 }
        }
    }
    return ""
}

fun is_table_space(b: uint8): bool {
    return b == 32 || b == 9 || b == 44 // ' ', tab, ','
}

/// The URL `[indexes]` gives `name`, the default index for "", or "" for a
/// name it does not declare.
pub fun index_url_for(name: str, names: &List<String>, urls: &List<String>): String {
    if name == "" { return default_index_url() }
    while i in 0..names.size() {
        if names.at(i).as_str() == name { return urls.at(i).clone() }
    }
    return ""
}

/// `$KFLAT_INDEX`, else komp-co/index.
pub fun default_index_url(): String {
    val chosen = env_var("KFLAT_INDEX") ?: String.from("")
    if chosen.byte_len() > 0 { return chosen }
    return "https://github.com/komp-co/index"
}
