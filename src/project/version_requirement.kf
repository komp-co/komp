// A package version, `MAJOR.MINOR.PATCH`, and a requirement on one.
//
//   "1.4"    >=1.4.0, <2.0.0      the leftmost non-zero part is fixed
//   "0.2"    >=0.2.0, <0.3.0
//   "0.2.3"  >=0.2.3, <0.3.0
//   "0.0.3"  >=0.0.3, <0.0.4
//   "0"      >=0.0.0, <1.0.0

@derive(Clone)
pub struct Version {
    pub val major: uint64
    pub val minor: uint64
    pub val patch: uint64
}

impl Compare for Version {
    fun compare(other: &Version): int32 {
        if self.major != other.major { return if self.major < other.major { -1 } else { 1 } }
        if self.minor != other.minor { return if self.minor < other.minor { -1 } else { 1 } }
        if self.patch != other.patch { return if self.patch < other.patch { -1 } else { 1 } }
        return 0
    }
}

/// The versions from `low`, inclusive, to `high`, exclusive.
pub struct Requirement {
    pub val low: Version
    pub val high: Version
}

impl Requirement {
    pub fun allows(version: &Version): bool {
        return version.compare(&self.low) >= 0 && version.compare(&self.high) < 0
    }
}

/// Every version: what naming a package with no requirement asks for.
pub fun any_version(): Requirement {
    return Requirement {
        low: Version { major: 0, minor: 0, patch: 0 },
        high: Version { major: 18446744073709551615, minor: 0, patch: 0 }
    }
}

/// Exactly three numeric parts.
pub fun parse_version(text: str): Version? {
    val parts = numeric_parts(text)
    if parts.size() != 3 { return null }
    return Version { major: *parts.at(0), minor: *parts.at(1), patch: *parts.at(2) }
}

/// One to three numeric parts, read as the table above.
pub fun parse_requirement(text: str): Requirement? {
    val parts = numeric_parts(text)
    val n = parts.size()
    if n == 0 || n > 3 { return null }
    val major = *parts.at(0)
    val minor: uint64 = if n > 1 { *parts.at(1) } else { 0 }
    val patch: uint64 = if n > 2 { *parts.at(2) } else { 0 }
    val low = Version { major: major, minor: minor, patch: patch }
    val high = if major > 0 || n == 1 {
        Version { major: major + 1, minor: 0, patch: 0 }
    } else if minor > 0 || n == 2 {
        Version { major: 0, minor: minor + 1, patch: 0 }
    } else {
        Version { major: 0, minor: 0, patch: patch + 1 }
    }
    return Requirement { low: low, high: high }
}

/// The dot-separated numbers of `text`, or none if any part is empty or
/// holds a non-digit.
fun numeric_parts(text: str): List<uint64> {
    var parts = List.new<uint64>()
    val n = text.byte_len()
    var value: uint64 = 0
    var digits = 0
    var i: uint64 = 0
    while i <= n {
        if i == n || text.byte_at(i) == 46 { // '.'
            if digits == 0 { return List.new<uint64>() }
            parts.push(value)
            value = 0
            digits = 0
        } else {
            val b = text.byte_at(i)
            if b < 48 || b > 57 { return List.new<uint64>() }
            value = value * 10 + (b - 48) as uint64
            digits = digits + 1
        }
        i = i + 1
    }
    return parts
}

pub fun Version.render(): String {
    return "${self.major}.${self.minor}.${self.patch}"
}
