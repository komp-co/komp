import core.assert.assert_eq
import testing.test

@test
fun a_snake_case_name_is_a_package_name(): void {
    assert_eq(is_package_name("json_schema2"), true, "letters, digits, underscore")
}

@test
fun an_uppercase_name_is_not_a_package_name(): void {
    assert_eq(is_package_name("Json"), false, "a crate name becomes a C identifier, and index paths are lowercase")
}

@test
fun a_hyphenated_name_is_not_a_package_name(): void {
    assert_eq(is_package_name("json-schema"), false, "`-` is not an identifier character")
}

@test
fun a_name_starting_with_a_digit_is_not_a_package_name(): void {
    assert_eq(is_package_name("2d"), false, "an identifier starts with a letter")
}

@test
fun an_ssh_remote_becomes_https(): void {
    assert_eq(public_git_url("git@github.com:komp-co/json.git").as_str(), "https://github.com/komp-co/json.git",
        "anyone can fetch it")
}

@test
fun an_ssh_url_remote_becomes_https(): void {
    assert_eq(public_git_url("ssh://git@git.example.org/team/json.git").as_str(),
        "https://git.example.org/team/json.git", "the scheme form too")
}

@test
fun an_https_remote_is_kept(): void {
    assert_eq(public_git_url("https://github.com/komp-co/json").as_str(), "https://github.com/komp-co/json",
        "already public")
}
