import core.assert.assert_eq
import std.fs.scratch_root
import testing.test

extern "C" fun system(cmd: str): int32
extern "C" fun setenv(name: str, value: str, overwrite: int32): int32
extern "C" fun kf_env_get(name: str): str

@test
fun a_github_url_names_its_repository(): void {
    assert_eq(github_repository("https://github.com/komp-co/index").as_str(), "komp-co/index", "owner/name")
}

@test
fun a_git_suffix_is_dropped_from_the_repository(): void {
    assert_eq(github_repository("https://github.com/komp-co/index.git").as_str(), "komp-co/index",
        "gh wants owner/name")
}

@test
fun another_host_has_no_github_repository(): void {
    assert_eq(github_repository("https://git.example.org/index").as_str(), "", "no gh for it")
}

@test
fun an_index_elsewhere_is_a_gh_problem(): void {
    assert_eq(gh_problem("").as_str(), "the index is not on github.com", "said before gh is even looked for")
}

/// A `gh` on PATH that is installed but logged in to nothing.
fun put_logged_out_gh_on_path(): void {
    val bin = "${scratch_root()}/kf_logged_out_gh"
    val script = "#!/bin/sh\n[ \"$1\" = --version ] && exit 0\nexit 1\n"
    unsafe { system("mkdir -p ${bin}".as_str()) }
    write_file("${bin}/gh".as_str(), script)
    unsafe { system("chmod +x ${bin}/gh".as_str()) }
    val path = unsafe { kf_env_get("PATH") }
    unsafe { setenv("PATH", "${bin}:${path}".as_str(), 1) }
}

@test
fun a_logged_out_gh_says_how_to_log_in(): void {
    put_logged_out_gh_on_path()
    assert_eq(gh_problem("komp-co/index").as_str(), "`gh` is not logged in to github.com: run `gh auth login`",
        "the one command that fixes it")
}

@test
fun a_missing_gh_says_where_to_get_it(): void {
    val empty = "${scratch_root()}/kf_no_gh"
    unsafe { system("mkdir -p ${empty}".as_str()) }
    unsafe { setenv("PATH", empty.as_str(), 1) }
    assert_eq(gh_problem("komp-co/index").as_str(), "`gh` is not installed (https://cli.github.com)",
        "where to get it")
}

@test
fun an_approved_pull_request_waits_to_be_merged(): void {
    assert_eq(review_status("OPEN", "APPROVED").as_str(), "approved, waiting to be merged", "a maintainer said yes")
}

@test
fun an_open_pull_request_without_a_decision_is_in_review(): void {
    assert_eq(review_status("OPEN", "").as_str(), "in review", "no decision yet")
}

@test
fun a_closed_pull_request_was_declined(): void {
    assert_eq(review_status("CLOSED", "").as_str(), "declined", "closed without merging")
}

@test
fun a_merged_pull_request_is_left_to_the_index(): void {
    assert_eq(review_status("MERGED", "APPROVED").as_str(), "", "the index lists it as published")
}
