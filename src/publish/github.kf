// The part of `komp publish` only GitHub can do, through `gh`: fork the
// index, push the entry's branch there, and open or find its pull request.
// Every step that fails says why and leaves the rest to a person.

/// `url` is the pull request, or `problem` says why there is none.
pub struct PullRequest {
    pub val url: String
    pub val problem: String
}

fun no_pull_request(problem: String): PullRequest {
    return PullRequest { url: "", problem: problem }
}

/// `https://github.com/o/r` or `.../o/r.git` -> `o/r`; "" for another host.
pub fun github_repository(url: str): String {
    val prefix = "https://github.com/"
    if !url.starts_with(prefix) { return "" }
    var repository = url.substring(prefix.byte_len(), url.byte_len())
    if repository.as_str().ends_with(".git") {
        repository = repository.as_str().substring(0, repository.byte_len() - 4)
    }
    if repository.as_str().ends_with("/") {
        repository = repository.as_str().substring(0, repository.byte_len() - 1)
    }
    return repository
}

/// "" when `gh` can act on `repository`, else why not.
pub fun gh_problem(repository: str): String {
    if repository == "" { return "the index is not on github.com" }
    if !tool("gh", "--version").succeeds() { return "`gh` is not installed (https://cli.github.com)" }
    if !tool("gh", "auth status --hostname github.com").succeeds() {
        return "`gh` is not logged in to github.com: run `gh auth login`"
    }
    return ""
}

/// Pushes `branch` of the clone at `dir` to the user's fork of `repository`
/// and opens a pull request into `base`, or finds the one already open.
pub fun open_pull_request(dir: str, repository: str, branch: str, base: str, title: str, body: str): PullRequest {
    val problem = gh_problem(repository)
    if problem.byte_len() > 0 { return no_pull_request(problem) }
    val login = output_of(tool("gh", "api user --jq .login")) ?: return no_pull_request("`gh api user` failed")
    if !tool("gh", "repo fork ${repository} --clone=false".as_str()).succeeds() {
        return no_pull_request("`gh repo fork ${repository}` failed")
    }
    val query = ".[] | select(.owner.login == \"${login}\") | .full_name"
    var forks = tool("gh", "api repos/${repository}/forks --jq".as_str())
    forks.arg(query.as_str())
    val fork = output_of(forks) ?: return no_pull_request("cannot find ${login}'s fork of ${repository}")
    if fork.byte_len() == 0 { return no_pull_request("cannot find ${login}'s fork of ${repository}") }
    var push = tool("git", "-C ${dir} -c credential.helper=".as_str())
    push.arg("-c")
    push.arg("credential.helper=!gh auth git-credential")
    push.arg("push")
    push.arg("--quiet")
    push.arg("--force")
    push.arg("https://github.com/${fork}.git".as_str())
    push.arg("HEAD:refs/heads/${branch}".as_str())
    if !push.succeeds() { return no_pull_request("pushing ${branch} to ${fork} failed") }
    val head = "${login}:${branch}"
    val listing = "pr list --repo ${repository} --head ${branch} --state open --json url --jq .[0].url"
    val open = output_of(tool("gh", listing.as_str())) ?: String.from("")
    if open.byte_len() > 0 { return PullRequest { url: open.clone(), problem: "" } }
    var create = tool("gh", "pr create --repo ${repository} --base ${base} --head ${head} --title".as_str())
    create.arg(title)
    create.arg("--body")
    create.arg(body)
    val created = output_of(create) ?: return no_pull_request("`gh pr create` failed")
    return PullRequest { url: created.clone(), problem: "" }
}
