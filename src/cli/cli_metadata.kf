// `komp metadata`: the resolved crates of a project or workspace, as JSON on
// stdout, fetched first as a build would be.

import komp.build.FetchPolicy
import komp.build.metadata_failure
import komp.build.metadata_members
import komp.build.project_metadata
import komp.build.sync_sources
import komp.fetch.cache_root
import komp.project.command_dir

/// 0 when the graph resolved; a failure prints JSON too, with an `error`.
pub fun metadata_command(project: str, nargs: int32): int32 {
    val dir = command_dir(project)
    val no_toolchain = toolchain_error_for(dir.as_str(), has_own_flag(nargs, "--offline"))
    if no_toolchain.byte_len() > 0 {
        println(metadata_failure(no_toolchain.as_str()).json.as_str())
        return 1
    }
    val policy = FetchPolicy {
        locked: has_own_flag(nargs, "--locked"), offline: has_own_flag(nargs, "--offline"), update: false
    }
    val members = metadata_members(dir.as_str())
    while member in &members {
        val error = sync_sources(member.as_str(), &policy, cache_root().as_str())
        if error.byte_len() > 0 {
            println(metadata_failure(error.as_str()).json.as_str())
            return 1
        }
    }
    val result = project_metadata(dir.as_str())
    println(result.json.as_str())
    return if result.ok { 0 } else { 1 }
}
