// `komp publish [--status] [--index <url>] [<project-dir>]`.

import komp.fetch.cache_root
import komp.project.default_index_url
import komp.publish.publish_package
import komp.publish.publish_status

pub fun publish_command(nargs: int32): int32 {
    var project = ""
    var index = ""
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if arg == "--index" || arg == "--manifest-path" || is_selection_value_flag(arg) {
            if arg == "--index" && i + 1 < nargs { index = String.from(cli_arg_get(i + 1)) }
            i = i + 1
        } else if arg == "--status" {
            // read below
        } else if starts_with_dash(arg) {
            return usage_error("publish")
        } else {
            project = String.from(arg)
        }
        i = i + 1
    }
    val from_manifest = manifest_root(nargs)
    if from_manifest.byte_len() > 0 { project = from_manifest }
    val root = single_selected_crate("publish", if project.byte_len() > 0 { project.as_str() } else { "." }, nargs)
    if root.byte_len() == 0 { return 1 }
    val url = if index.byte_len() > 0 { index } else { default_index_url() }
    if has_own_flag(nargs, "--status") { return publish_status(root.as_str(), url.as_str(), cache_root().as_str()) }
    return publish_package(root.as_str(), url.as_str(), cache_root().as_str())
}
