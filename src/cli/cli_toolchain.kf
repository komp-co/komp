// `komp toolchain install [<version>]`, `komp toolchain list` and
// `komp toolchain remove <version>`: the kflat releases the index lists as
// `kflatc`, installed under `~/.kflat/toolchains`.

import json.writer.JsonWriter
import komp.build.default_kflatc_version
import komp.fetch.cache_root
import komp.install.default_toolchain
import komp.install.install_home
import komp.install.install_toolchain
import komp.install.installed_bin_dir
import komp.install.installed_toolchains
import komp.install.make_default_toolchain
import komp.install.remove_toolchain
import komp.install.toolchain_kflatc
import komp.install.toolchain_release
import komp.project.parse_version
import komp.project.render
import std.fs.is_file

pub fun toolchain_command(nargs: int32): int32 {
    val args = arguments_without_format(nargs)
    if args.is_empty() { return usage_error("toolchain") }
    val home = install_home()
    when args[0].as_str() {
        "install" => {
            if args.size() > 2 { return usage_error("toolchain") }
            val version = if args.size() == 2 { args[1].clone() } else { String.from("") }
            if starts_with_dash(version.as_str()) { return usage_error("toolchain") }
            return toolchain_install(home.as_str(), version.as_str())
        }
        "list" => {
            if args.size() != 1 { return usage_error("toolchain") }
            return if wants_json(nargs) { list_toolchains_json(home.as_str()) } else { list_toolchains(home.as_str()) }
        }
        "remove" => {
            if args.size() != 2 || starts_with_dash(args[1].as_str()) { return usage_error("toolchain") }
            val error = remove_toolchain(home.as_str(), args[1].as_str(), default_kflatc_version().as_str())
            if error.byte_len() > 0 { return report_error(error.as_str(), wants_json(nargs)) }
            runtime_println("removed kflat ${args[1]}")
            return 0
        }
        _ => return usage_error("toolchain")
    }
}

/// `{"running", "default", "toolchains": [{"version", "path", "default", "running"}]}`,
/// `running` the kflatc komp runs now, `default` null when `bin/komp` points
/// at no toolchain.
fun list_toolchains_json(home: str): int32 {
    val chosen = default_toolchain(home)
    val running = default_kflatc_version()
    var writer = JsonWriter.object()
    writer.field_string("running", running.as_str())
    if chosen.is_empty() { writer.field_null("default") } else { writer.field_string("default", chosen.as_str()) }
    writer.key("toolchains")
    writer.begin_array()
    val versions = installed_toolchains(home)
    while version in &versions {
        val shown = version.render()
        writer.begin_object()
        writer.field_string("version", shown.as_str())
        writer.field_string("path", "${home}/toolchains/${shown}".as_str())
        writer.field_bool("default", shown.as_str() == chosen.as_str())
        writer.field_bool("running", shown.as_str() == running.as_str())
        writer.end_object()
    }
    writer.end_array()
    runtime_println(writer.finish().as_str())
    return 0
}

/// `wanted` is a version, a requirement such as `0.26`, or "" for the newest.
/// The release is installed unless it already is, then made the default.
fun toolchain_install(home: str, wanted: str): int32 {
    val release = toolchain_release(wanted, parse_version(wanted) != null, cache_root().as_str(), false)
    if release.error.byte_len() > 0 {
        runtime_println("error: ${release.error}")
        return 1
    }
    val version = release.version.as_str()
    val present = is_file(toolchain_kflatc(home, version).as_str())
    if !present {
        val failed = install_toolchain(&release, home, cache_root().as_str())
        if failed.byte_len() > 0 {
            runtime_println("error: ${failed}")
            return 1
        }
    }
    val unlinked = make_default_toolchain(home, version)
    if unlinked.byte_len() > 0 {
        runtime_println("error: ${unlinked}")
        return 1
    }
    val done = if present { "kflat ${version} is installed" } else { "installed kflat ${version}" }
    runtime_println("${done}; ${installed_bin_dir(home)}/kflatc now runs it")
    return 0
}

/// Each installed toolchain, the default and the running one marked.
fun list_toolchains(home: str): int32 {
    val versions = installed_toolchains(home)
    val running = default_kflatc_version()
    if versions.is_empty() {
        runtime_println("no toolchain is installed in ${home}/toolchains; komp runs kflatc ${running}")
        return 0
    }
    val chosen = default_toolchain(home)
    while version in &versions {
        val shown = version.render()
        var notes = ""
        if shown.as_str() == chosen.as_str() { notes.append("  default") }
        if shown.as_str() == running.as_str() { notes.append("  running") }
        runtime_println("${shown}${notes}  ${home}/toolchains/${shown}")
    }
    return 0
}
