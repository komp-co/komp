import core.assert.assert_eq
import alloc.list.*
import testing.test

fun pf(start: uint32, end: uint32, replacement: str): PendingFix {
    return PendingFix { start: start, end: end, replacement: String.from(replacement), title: String.from("t") }
}

fun one(f: PendingFix): List<PendingFix> {
    var l = List.new<PendingFix>()
    l.push(f)
    return l
}

@test
fun a_replacement_covers_exactly_its_span(): void {
    val out = apply_fixes("val x = foo()", &one(pf(8, 11, "bar")))
    assert_eq(out.text.as_str(), "val x = bar()", "the name changes and nothing else does")
    assert_eq(out.applied, 1 as uint64, "one edit written")
}

@test
fun a_zero_width_span_inserts(): void {
    // An import is an insertion.
    val out = apply_fixes("fun main() {}\n", &one(pf(0, 0, "import core.*\n\n")))
    assert_eq(out.text.as_str(), "import core.*\n\nfun main() {}\n", "text arrives before byte 0")
}

@test
fun two_edits_both_land_with_the_later_offsets_intact(): void {
    // A second edit measured against the original text must not shift.
    var fs = List.new<PendingFix>()
    fs.push(pf(0, 3, "hello"))
    fs.push(pf(8, 11, "world"))
    val out = apply_fixes("abc def ghi", &fs)
    assert_eq(out.text.as_str(), "hello def world", "the second edit is not displaced by the first")
    assert_eq(out.applied, 2 as uint64, "both written")
}

@test
fun edits_are_written_in_offset_order_not_report_order(): void {
    var fs = List.new<PendingFix>()
    fs.push(pf(8, 11, "world"))
    fs.push(pf(0, 3, "hello"))
    val out = apply_fixes("abc def ghi", &fs)
    assert_eq(out.text.as_str(), "hello def world", "the compiler may report them in any order")
}

@test
fun an_overlapping_edit_is_skipped_rather_than_spliced_into(): void {
    var fs = List.new<PendingFix>()
    fs.push(pf(0, 6, "replaced"))
    fs.push(pf(3, 9, "clashing"))
    val out = apply_fixes("abcdefghij", &fs)
    assert_eq(out.text.as_str(), "replacedghij", "the first wins whole")
    assert_eq(out.applied, 1 as uint64, "one written")
    assert_eq(out.skipped, 1 as uint64, "the other is left for the next pass")
}

@test
fun the_same_edit_reported_twice_is_written_once(): void {
    // The same import suggested three times is written once.
    var fs = List.new<PendingFix>()
    fs.push(pf(0, 0, "import core.*\n"))
    fs.push(pf(0, 0, "import core.*\n"))
    fs.push(pf(0, 0, "import core.*\n"))
    val out = apply_fixes("fun main() {}\n", &fs)
    assert_eq(out.text.as_str(), "import core.*\nfun main() {}\n", "one import line, not three")
    assert_eq(out.applied, 1 as uint64, "the duplicates are dropped")
    assert_eq(out.skipped, 0 as uint64, "and dropping is not skipping — a later pass has nothing to do")
}

@test
fun two_different_insertions_at_one_offset_both_land(): void {
    var fs = List.new<PendingFix>()
    fs.push(pf(0, 0, "import core.*\n"))
    fs.push(pf(0, 0, "import alloc.list.*\n"))
    val out = apply_fixes("fun main() {}\n", &fs)
    assert_eq(out.text.as_str(), """import core.*
import alloc.list.*
fun main() {}
""", "different text is not a duplicate")
    assert_eq(out.applied, 2 as uint64, "both written")
}

@test
fun an_edit_past_the_end_of_the_file_is_refused(): void {
    // Out of range is skipped and counted.
    val out = apply_fixes("short", &one(pf(2, 99, "x")))
    assert_eq(out.text.as_str(), "short", "the file is returned unchanged")
    assert_eq(out.applied, 0 as uint64, "nothing written")
    assert_eq(out.skipped, 1 as uint64, "and the refusal is visible")
}

@test
fun an_inverted_span_is_refused(): void {
    val out = apply_fixes("abcdef", &one(pf(4, 2, "x")))
    assert_eq(out.text.as_str(), "abcdef", "end before start is not an edit")
    assert_eq(out.skipped, 1 as uint64, "counted, not silently dropped")
}

@test
fun no_fixes_returns_the_source_unchanged(): void {
    val out = apply_fixes("unchanged\n", &List.new<PendingFix>())
    assert_eq(out.text.as_str(), "unchanged\n", "including the trailing newline")
    assert_eq(out.applied, 0 as uint64, "nothing to do")
}

@test
fun an_edit_at_the_very_end_keeps_the_prefix(): void {
    val out = apply_fixes("abcdef", &one(pf(6, 6, "!")))
    assert_eq(out.text.as_str(), "abcdef!", "an insertion at EOF is in range")
}
