import core.args.arg_count
import core.args.arg_at

pub fun is_help_flag(arg: str): bool {
    return arg == "-h" || arg == "--help"
}

/// Before `--`: `komp run <dir> -- --help` asks the program.
pub fun wants_help(): bool {
    var i = 0
    while i < arg_count() {
        val arg = arg_at(i)
        if arg == "--" { return false }
        if is_help_flag(arg) { return true }
        i = i + 1
    }
    return false
}

pub fun is_version_flag(arg: str): bool {
    return arg == "-V" || arg == "--version"
}

/// Before `--`.
pub fun wants_version(): bool {
    var i = 0
    while i < arg_count() {
        val arg = arg_at(i)
        if arg == "--" { return false }
        if is_version_flag(arg) { return true }
        i = i + 1
    }
    return false
}

/// Value of `<name> <value>` after the command, or "". From index 1, since
/// the project directory is optional.
fun flag_value(nargs: int32, name: str): str {
    var i = 1
    while i + 1 < nargs {
        if cli_arg_get(i) == name { return cli_arg_get(i + 1) }
        i = i + 1
    }
    return ""
}

/// From `start`, the slot after the command: its flags, and at most one
/// directory, before or after them.
fun test_flags_well_formed(nargs: int32, start: int32): bool {
    var i: int32 = start
    var directory_seen = false
    while i < nargs {
        val a = cli_arg_get(i)
        if a == "--workspace" || is_fetch_flag(a) {
            i = i + 1
        } else if !starts_with_dash(a) && !directory_seen {
            directory_seen = true
            i = i + 1
        } else {
            val takes_value = a == "--case" || a == "--filter" || a == "--manifest-path"
            if !takes_value && !is_selection_value_flag(a) { return false }
            if i + 1 >= nargs { return false }
            i = i + 2
        }
    }
    return true
}

pub fun starts_with_dash(value: str): bool {
    return value.byte_len() > 0 && value.byte_at(0) == 45
}
