// `komp add <name>[@<requirement>] [--index <name>]`.

import komp.fetch.cache_root
import komp.install.add_package

pub fun add_command(nargs: int32): int32 {
    var package = ""
    var index = ""
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if arg == "--index" && i + 1 < nargs {
            index = String.from(cli_arg_get(i + 1))
            i = i + 1
        } else if arg == "--manifest-path" || is_selection_value_flag(arg) {
            i = i + 1 // read by manifest_root / package_flag
        } else if is_fetch_flag(arg) {
            // read by fetched_for
        } else if starts_with_dash(arg) || package.byte_len() > 0 {
            return usage_error("add")
        } else {
            package = String.from(arg)
        }
        i = i + 1
    }
    if package.is_empty() { return usage_error("add") }
    val root = single_selected_crate("add", project_for(nargs, nargs).as_str(), nargs)
    if root.is_empty() { return 1 }
    val at = package.index_of("@")
    val name = if at == null { package.clone() } else { package.substring(0, at ?: 0) }
    val requirement = if at == null { String.from("") } else { package.substring((at ?: 0) + 1, package.byte_len()) }
    val added = add_package(root.as_str(), name.as_str(), requirement.as_str(), index.as_str(), cache_root().as_str())
    if added.error.byte_len() > 0 {
        runtime_println("error: ${added.error}")
        return 1
    }
    runtime_println("added `${name}` \"${added.requirement}\" to ${root}/kf.toml, resolving to ${added.version}")
    return if fetched_for(root.as_str(), nargs) { 0 } else { 1 }
}
