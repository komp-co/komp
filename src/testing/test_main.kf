// The main of a test program, which komp hands kflatc as `--entry-file`:
// `testing` runs every `@test` of the crate, holding back the `@disabled`.

import std.fs.write_text

/// `<dir>/<crate>_main.kf`, written; "" when it cannot be.
pub fun write_test_main(dir: str, crate_name: str): String {
    val path = "${dir}/${crate_name}_main.kf"
    if write_text(path.as_str(), test_main_source()).is_err() { return "" }
    return path
}

pub fun test_main_source(): str {
    return """import testing.disabled
import testing.run_tests
import testing.test

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
"""
}
