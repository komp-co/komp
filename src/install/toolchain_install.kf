// Installing a toolchain: its release, installed into a staging home so that
// only `toolchains/<version>` moves into the real one, whatever else the
// release's install.sh links. Making one the default links `bin/kflatc` to it.

import alloc.list.*
import komp.build.ensure_dir
import komp.fetch.fresh_staging
import komp.fetch.remove_tree
import std.fs.exists
import std.fs.is_file
import std.io.eprintln
import std.process.Command

/// As `choose_toolchain`, installing the release the pin needs first when
/// none installed fits, unless `offline`.
pub fun choose_or_install_toolchain(pin: str, default_version: str, home: str, cache: str,
    offline: bool): ToolchainChoice {
    val choice = choose_toolchain(pin, default_version, home)
    if choice.error.byte_len() == 0 || !choice.installable { return choice }
    if offline {
        return ToolchainChoice { kflatc: "", error: "${choice.error}; --offline installs none", installable: false }
    }
    val release = toolchain_release(pin, false, cache, false)
    if release.error.byte_len() > 0 {
        return ToolchainChoice { kflatc: "", error: "${choice.error}; ${release.error}", installable: false }
    }
    eprintln(&"komp: installing kflat ${release.version}, which kf.toml's `kflat = \"${pin}\"` needs")
    val failed = install_toolchain(&release, home, cache)
    if failed.byte_len() > 0 {
        val error = "${choice.error}; installing ${release.version}: ${failed}"
        return ToolchainChoice { kflatc: "", error: error, installable: false }
    }
    return choose_toolchain(pin, default_version, home)
}

/// Installs `release` as `<home>/toolchains/<version>`. "" once installed,
/// else why not.
pub fun install_toolchain(release: &ToolchainRelease, home: str, cache: str): String {
    val staging_home = fresh_staging(cache, "toolchain")
    if staging_home.byte_len() == 0 { return "cannot create a directory under ${cache}" }
    val failed = install_archive(release, staging_home.as_str(), cache)
    if failed.byte_len() > 0 {
        remove_tree(staging_home.as_str())
        return failed
    }
    val built = "${staging_home}/toolchains/${release.version}"
    if !is_file("${built}/bin/kflatc".as_str()) {
        remove_tree(staging_home.as_str())
        return "the ${release.version} release installed no kflatc"
    }
    val target = "${home}/toolchains/${release.version}"
    if !ensure_dir("${home}/toolchains".as_str()) { return "cannot create ${home}/toolchains" }
    remove_tree(target.as_str())
    // `mv`, not a rename: the cache and the install home may be on different filesystems.
    var move = Command.new("mv")
    move.arg(built.as_str())
    move.arg(target.as_str())
    val moved = move.status().success()
    remove_tree(staging_home.as_str())
    return if moved { "" } else { "cannot move ${built} to ${target}" }
}

/// The programs a toolchain links into `bin/`, those it has.
val TOOLCHAIN_PROGRAMS: str[] = ["kflatc", "kf-lint", "kf-editor"]

/// Links `<home>/bin/kflatc`, and the linter and editor endpoint when the
/// toolchain has them, to installed toolchain `version`. "" once linked,
/// else why not.
pub fun make_default_toolchain(home: str, version: str): String {
    if !ensure_dir("${home}/bin".as_str()) { return "cannot create ${home}/bin" }
    while program in &TOOLCHAIN_PROGRAMS {
        val from = "${home}/toolchains/${version}/bin/${program}"
        val link = "${home}/bin/${program}"
        if !exists(from.as_str()) {
            remove_tree(link.as_str())
            continue
        }
        var ln = Command.new("ln")
        ln.arg("-sfn")
        ln.arg(from.as_str())
        ln.arg(link.as_str())
        if !ln.status().success() { return "cannot link ${link} to ${from}" }
    }
    return ""
}
