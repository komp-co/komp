import core.assert.assert_eq
import alloc.list.*
import std.env.env_var
import std.env.set_env_var
import testing.test

/// The pages with `KFLAT_RELEASES` set to `value`, restored afterwards.
fun pages_with_releases(value: str): List<String> {
    val saved = env_var("KFLAT_RELEASES") ?: String.from("")
    set_env_var("KFLAT_RELEASES", value)
    val pages = toolchain_release_pages()
    set_env_var("KFLAT_RELEASES", saved.as_str())
    return pages
}

@test
fun kf_lang_is_asked_for_a_toolchain_first(): void {
    val pages = pages_with_releases("")
    assert_eq(pages.at(0).as_str(), "https://github.com/komp-co/kf-lang/releases", "the compiler's own releases")
}

@test
fun komps_page_still_serves_the_earlier_toolchains(): void {
    val pages = pages_with_releases("")
    assert_eq(pages.at(1).as_str(), "https://github.com/komp-co/komp/releases", "released before the move")
}

@test
fun kflat_releases_replaces_both_pages(): void {
    val pages = pages_with_releases("file:///srv/releases")
    assert_eq(pages.size() == 1 && pages.at(0).as_str() == "file:///srv/releases", true, "only the named one")
}
