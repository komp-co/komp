// Every version of every program komp has built, side by side under
// `<home>/tools/<package>/<version>/bin`, each built once: a published
// version never changes, so its version names its build.

import alloc.list.*
import komp.build.binary_path
import komp.build.ensure_dir
import komp.build.build_project_separate
import komp.build.default_fetch_policy
import komp.build.project_has_program
import komp.build.sync_sources
import komp.build.target_dir
import komp.fetch.LockEntry
import komp.fetch.cached_root
import komp.fetch.empty_lock_entry
import komp.fetch.fresh_staging
import komp.fetch.remove_tree
import komp.fetch.resolve_from_index
import komp.project.Dependency
import komp.project.Version
import komp.project.parse_version
import std.fs.exists
import std.fs.is_file
import std.fs.read_dir
import std.process.Command

/// A stored program: the source it was built from and its binary, or
/// `error` saying why there is none.
pub struct StoredTool {
    pub val entry: LockEntry
    pub val binary: String
    pub val error: String
}

fun store_failed(message: String): StoredTool {
    return StoredTool { entry: empty_lock_entry(), binary: "", error: message }
}

pub fun tool_dir(home: str, package: str, version: str): String {
    return "${home}/tools/${package}/${version}"
}

pub fun stored_binary(home: str, package: str, version: str): String {
    return "${tool_dir(home, package, version)}/bin/${installed_binary_name(package)}"
}

/// The versions of `package` in the store, ascending.
pub fun stored_versions(home: str, package: str): List<Version> {
    var out = List.new<Version>()
    val listed = read_dir("${home}/tools/${package}".as_str())
    if listed.is_err() { return out }
    while name in &listed.unwrap() {
        val version = parse_version(name.as_str()) ?: continue
        if is_file(stored_binary(home, package, name.as_str()).as_str()) { out.push(version) }
    }
    out.sort()
    return out
}

/// Every package with a version in the store.
pub fun stored_packages(home: str): List<String> {
    var out = List.new<String>()
    val listed = read_dir("${home}/tools".as_str())
    if listed.is_err() { return out }
    while name in &listed.unwrap() {
        if !stored_versions(home, name.as_str()).is_empty() { out.push(name.clone()) }
    }
    return out
}

/// The highest version of `package` in the index at `index_url` that
/// `requirement` allows ("" any), built into the store unless it is there
/// already. The package's own `kf.lock`, when it ships one, pins its
/// dependencies.
pub fun store_tool(package: str, requirement: str, index_url: str, cache: str, home: str): StoredTool {
    val dep = Dependency {
        name: String.from(package), version: String.from(requirement), index: "", index_url: String.from(index_url),
        path: "", git: "", rev: "", tag: "", branch: "", tarball: "", checksum: ""
    }
    var refreshed = List.new<String>()
    val fetched = resolve_from_index(&dep, cache, &refreshed)
    if fetched.error.byte_len() > 0 { return store_failed(fetched.error.clone()) }
    val binary = stored_binary(home, package, fetched.entry.version.as_str())
    if is_file(binary.as_str()) { return StoredTool { entry: fetched.entry.clone(), binary: binary, error: "" } }
    val source = fetched.entry.cached_root(cache)
    if !project_has_program(source.as_str()) {
        return store_failed("`${package}` is a library, not a program: add it to [dependencies] to use it")
    }
    val staging = fresh_staging(cache, "install")
    if staging.byte_len() == 0 { return store_failed("cannot create a build directory under ${cache}") }
    val built = build_in(source.as_str(), staging.as_str(), package, cache)
    if built.byte_len() == 0 {
        remove_tree(staging.as_str())
        return store_failed("`${package}` ${fetched.entry.version} did not build")
    }
    val bin = "${tool_dir(home, package, fetched.entry.version.as_str())}/bin"
    val copied = ensure_dir(bin.as_str()) && copy_file(built.as_str(), binary.as_str())
    remove_tree(staging.as_str())
    if !copied { return store_failed("cannot write ${binary}") }
    return StoredTool { entry: fetched.entry.clone(), binary: binary, error: "" }
}

/// The package's source, copied into `staging` and built there, so the
/// cache stays as it was fetched; the built binary's path, or "".
fun build_in(source: str, staging: str, name: str, cache: str): String {
    var copy = Command.new("cp")
    copy.arg("-R")
    copy.arg(source)
    copy.arg(staging)
    if !copy.status().success() { return "" }
    if sync_sources(staging, &default_fetch_policy(), cache).byte_len() > 0 { return "" }
    if build_project_separate(staging, "") != 0 { return "" }
    val built = binary_path(target_dir(staging).as_str(), name)
    if !exists(built.as_str()) { return "" }
    return built
}

/// Copied with its permissions, so the copy runs.
fun copy_file(from: str, to: str): bool {
    var copy = Command.new("cp")
    copy.arg("-p")
    copy.arg(from)
    copy.arg(to)
    return copy.status().success()
}
