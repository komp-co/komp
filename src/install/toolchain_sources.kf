// Where a pinned toolchain is fetched from. The compiler is released from
// kf-lang; the releases made before it moved stay on komp's own page.

import alloc.list.*
import alloc.path.Path
import std.env.env_var
import std.process.Command

/// `$KFLAT_RELEASES` alone when set; else kf-lang's releases, then komp's.
pub fun toolchain_release_pages(): List<String> {
    var pages = List.new<String>()
    val explicit = env_var("KFLAT_RELEASES") ?: String.from("")
    if explicit.byte_len() > 0 {
        pages.push(explicit)
        return pages
    }
    pages.push(String.from("https://github.com/komp-co/kf-lang/releases"))
    pages.push(String.from("https://github.com/komp-co/komp/releases"))
    return pages
}

/// The newest release of the first page that names one; "" when none does.
pub fun newest_toolchain_release(pages: &List<String>): String {
    while page in &pages {
        val newest = latest_release(page.as_str())
        if newest.byte_len() > 0 { return newest }
    }
    return String.from("")
}

/// The first page that publishes release `version`; "" when none does.
pub fun page_publishing(pages: &List<String>, version: str): String {
    while page in &pages {
        val digest = "${page}/download/v${version}/kflat-${version}.tar.gz.sha256"
        var ask = Command.new("curl")
        ask.arg("-fsSLI")
        ask.arg("-o")
        ask.arg("/dev/null")
        ask.arg(digest.as_str())
        if ask.status().success() { return page.clone() }
    }
    return String.from("")
}
