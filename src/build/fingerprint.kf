// Artifact fingerprints and the reuse decision. Identity is content, never
// timestamps: compiler and runtime ABI, target, profile, every source byte,
// and the dependency interfaces compiled against. The interface hash is kept
// apart from the implementation hash, so a private body change rebuilds one
// archive and relinks consumers without recompiling them.

import alloc.list.*

import komp.project.manifest_c_sources
import komp.project.manifest_hosted_c_sources
import komp.project.parse_manifest
import std.fs.exists

// Declared by kf_runtime.h already, so no second prototype is emitted.
extern "C" fun kf_file_hash(path: str): uint64

/// What komp compares artifacts by: the text's bytes, hashed.
pub fun content_hash(text: str): String {
    return "${hash_bytes(text)}"
}

/// Extra C flags select a profile. `freestanding` is part of it, not of any
/// crate's fingerprint: the root's flag changes which C every dependency
/// compiles from byte-identical sources.
pub fun build_profile_key(extra_cflags: str, freestanding: bool): String {
    var out = ""
    if freestanding { out = String.from("freestanding") }
    if extra_cflags.byte_len() != 0 {
        if out.as_str() != "" { out.append("+") }
        out.append("cflags-")
        out.append(content_hash(extra_cflags).as_str())
    }
    if out.as_str() == "" { return String.from("default") }
    return out
}

/// The manifest plus every production `.kf` file under `src_root`, by sorted
/// crate-relative path. "" for a crate shipped as artifacts only.
pub fun crate_source_fingerprint(crate_root: str, src_root: str, compiler: &CompilerIdentity): String {
    val paths = crate_kf_files(src_root, false)
    if paths.size() == 0 { return "" }
    // Both binaries are part of every fingerprint: a different kflatc emits
    // different C, and a different komp may compile it differently.
    var acc = "compiler=${compiler.binary_hash}\ntool="
    // CONSTRAINT: the binary's raw bytes. `read_file` stops at the ELF
    // header's first NUL, which would hash the same 7 bytes for every komp.
    acc.append(String.of(&((kf_file_hash("/proc/self/exe") as int64))).as_str())
    acc.append("\nkf.toml=")
    val manifest_path = String.from(crate_root) + String.from("/kf.toml")
    val manifest_content = read_file(manifest_path.as_str())
    acc.append(content_hash(manifest_content.as_str()).as_str())
    acc.append("\n")
    // Native C sources are hashed too, both tiers, sorted.
    var declared_c = manifest_c_sources(manifest_content.as_str())
    val hosted_c = manifest_hosted_c_sources(manifest_content.as_str())
    while item in &hosted_c {
        declared_c.push(item.clone())
    }
    val c_srcs = sorted_string_list(&declared_c)
    while rel in &c_srcs {
        val cpath = String.from(crate_root) + String.from("/") + rel.clone()
        acc.append("c:")
        acc.append(rel.as_str())
        acc.append("=")
        acc.append(content_hash(read_file(cpath.as_str()).as_str()).as_str())
        acc.append("\n")
    }
    val ordered = sorted_string_list(&paths)
    while path in &ordered {
        val logical = strip_path_prefix(path.as_str(), crate_root)
        acc.append(logical.as_str())
        acc.append("=")
        acc.append(content_hash(read_file(path.as_str()).as_str()).as_str())
        acc.append("\n")
    }
    return content_hash(acc.as_str())
}

/// `interface_hash` stays empty; the recorded one is verified against the
/// `.kfi` bytes.
pub fun BuildCrate.expected_artifact_manifest(profile: str, built_names: &List<String>, built_hashes: &List<String>,
    is_bin_root: bool, compiler: &CompilerIdentity): ArtifactManifest {
    val manifest_path = String.from(self.root.as_str()) + String.from("/kf.toml")
    val mf = parse_manifest(read_file(manifest_path.as_str()).as_str())
    val source_fp = crate_source_fingerprint(self.root.as_str(), self.src.as_str(), compiler)
    var dep_names = List.new<String>()
    var dep_hashes = List.new<String>()
    while dep in &self.deps {
        dep_names.push(dep.clone())
        dep_hashes.push(string_list_lookup(built_names, built_hashes, dep.as_str()))
    }
    var archive_file = "lib${self.name.as_str()}.a"
    if is_bin_root {
        archive_file = String.from(self.name.as_str()) + String.from(".o")
    }
    return ArtifactManifest {
        format: String.from(artifact_format_version()),
        compiler_abi: compiler.abi.clone(),
        runtime_abi: compiler.runtime.clone(),
        name: String.from(self.name.as_str()),
        version: mf.version,
        target: compiler.target.clone(),
        profile: String.from(profile),
        source_fingerprint: source_fp.clone(),
        interface_hash: "",
        implementation_hash: source_fp,
        interface_file: String.from(self.name.as_str()) + String.from(".kfi"),
        header_file: String.from(self.name.as_str()) + String.from(".h"),
        archive_file: archive_file,
        dep_names: dep_names,
        dep_hashes: dep_hashes
    }
}

pub struct ReuseDecision {
    pub val reuse: bool
    pub val reason: String
    pub val interface_hash: String
}

/// Every mismatch names its cause; a missing or corrupt artifact is a
/// rebuild, never an error.
pub fun decide_crate_reuse(tdir: str, expected: &ArtifactManifest): ReuseDecision {
    val mpath = crate_artifact_manifest_path(tdir, expected.name.as_str())
    if !exists(mpath.as_str()) {
        return reuse_no("no recorded artifact metadata")
    }
    val parsed = parse_artifact_manifest(read_file(mpath.as_str()).as_str())
    if !parsed.ok {
        return reuse_no_string(parsed.error)
    }
    val m = parsed.manifest
    if m.compiler_abi.as_str() != expected.compiler_abi.as_str() {
        return reuse_no("compiler ABI changed")
    }
    if m.runtime_abi.as_str() != expected.runtime_abi.as_str() {
        return reuse_no("runtime ABI changed")
    }
    if m.target.as_str() != expected.target.as_str() {
        return reuse_no("target changed")
    }
    if m.profile.as_str() != expected.profile.as_str() {
        return reuse_no("build profile changed")
    }
    if m.name.as_str() != expected.name.as_str() {
        return reuse_no("crate name changed")
    }
    if m.version.as_str() != expected.version.as_str() {
        return reuse_no("crate version changed")
    }
    // The same crate built as the program and as a dependency differs; the
    // archive name records which.
    if m.archive_file.as_str() != expected.archive_file.as_str() {
        return reuse_no("built as a program before and a library now, or the reverse")
    }
    // Artifacts-only crates are decided by compatibility and interface
    // integrity.
    if expected.source_fingerprint.as_str() != "" {
        if m.source_fingerprint.as_str() != expected.source_fingerprint.as_str() {
            return reuse_no("sources changed")
        }
    }
    if !dep_hashes_match(&m.dep_names, &m.dep_hashes, &expected.dep_names, &expected.dep_hashes) {
        return reuse_no("dependency interfaces changed")
    }
    if !artifact_file_present(tdir, m.interface_file.as_str()) {
        return reuse_no("interface artifact missing")
    }
    if !artifact_file_present(tdir, m.header_file.as_str()) {
        return reuse_no("header artifact missing")
    }
    if !artifact_file_present(tdir, m.archive_file.as_str()) {
        return reuse_no("compiled artifact missing")
    }
    val kfi_path = String.from(tdir) + String.from("/") + String.from(m.interface_file.as_str())
    val kfi_hash = content_hash(read_file(kfi_path.as_str()).as_str())
    if kfi_hash.as_str() != m.interface_hash.as_str() {
        return reuse_no("interface artifact corrupted")
    }
    val owned_interface_hash = m.interface_hash.clone()
    return ReuseDecision { reuse: true, reason: String.from("artifacts match"), interface_hash: owned_interface_hash }
}

fun reuse_no(reason: str): ReuseDecision {
    return ReuseDecision { reuse: false, reason: String.from(reason), interface_hash: "" }
}

fun reuse_no_string(reason: String): ReuseDecision {
    return ReuseDecision { reuse: false, reason: reason, interface_hash: "" }
}

fun dep_hashes_match(rec_names: &List<String>, rec_hashes: &List<String>, exp_names: &List<String>, exp_hashes: &List<String>): bool {
    if rec_names.size() != exp_names.size() { return false }
    if rec_hashes.size() != exp_hashes.size() { return false }
    while i in 0..rec_names.size() {
        if rec_names.at(i).as_str() != exp_names.at(i).as_str() { return false }
        if rec_hashes.at(i).as_str() != exp_hashes.at(i).as_str() { return false }
    }
    return true
}

fun artifact_file_present(tdir: str, rel: str): bool {
    val full = String.from(tdir) + String.from("/") + String.from(rel)
    return exists(full.as_str())
}

/// "" when absent.
pub fun string_list_lookup(names: &List<String>, values: &List<String>, name: str): String {
    while i in 0..names.size() {
        if names.at(i).as_str() == name {
            if i < values.size() { return values.at(i).clone() }
        }
    }
    return ""
}

/// Selection-sorted copy, byte order; avoids in-place swaps.
pub fun sorted_string_list(paths: &List<String>): List<String> {
    val n = paths.size()
    var used = List.new<bool>()
    var f = 0
    while f < n {
        used.push(false)
        f = f + 1
    }
    var out = List.new<String>()
    while out.size() < n {
        var best = n
        var i = 0
        while i < n {
            if !used.get(i) {
                if best == n {
                    best = i
                } else if str_byte_less(paths.at(i).as_str(), paths.at(best).as_str()) {
                    best = i
                }
            }
            i = i + 1
        }
        used.set(best, true)
        out.push(paths.at(best).clone())
    }
    return out
}

fun str_byte_less(a: str, b: str): bool {
    val an = a.byte_len()
    val bn = b.byte_len()
    var i = 0
    while i < an && i < bn {
        val ab = a.byte_at(i)
        val bb = b.byte_at(i)
        if ab < bb { return true }
        if ab > bb { return false }
        i = i + 1
    }
    return an < bn
}

fun strip_path_prefix(path: str, prefix: str): String {
    val pn = path.byte_len()
    val prefix_len = prefix.byte_len()
    if pn <= prefix_len { return String.from(path) }
    var i = 0
    while i < prefix_len {
        if path.byte_at(i) != prefix.byte_at(i) {
            return String.from(path)
        }
        i = i + 1
    }
    var start = prefix_len
    if path.byte_at(start) == 47 { start = start + 1 }
    return path.substring(start, pn)
}
