// artifact.toml: what a later build needs to decide reuse without opening
// sources: compatibility identity (formats, ABIs, target, profile), content
// identity (source fingerprint, interface and implementation hashes,
// dependency interface hashes) and the artifact file names, relative to the
// manifest. Versioned apart from `.kfi`.
//
// Strict where kf.toml is forgiving: any unknown, duplicate or missing entry
// is an error, since reuse on a half-understood manifest corrupts a build.

import alloc.list.*
import komp.project.*

extern "C" fun system(cmd: str): int32

pub fun artifact_format_version(): str {
    return "1"
}

pub struct ArtifactManifest {
    pub val format: String
    pub val compiler_abi: String
    pub val runtime_abi: String
    pub val name: String
    pub val version: String
    pub val target: String
    pub val profile: String
    pub val source_fingerprint: String
    pub val interface_hash: String
    pub val implementation_hash: String
    /// `<crate>.kfi`, relative to the manifest directory.
    pub val interface_file: String
    /// `<crate>.h`, relative to the manifest directory.
    pub val header_file: String
    /// `lib<crate>.a` for a library, `<crate>.o` for the binary root.
    pub val archive_file: String
    /// Direct dependencies and their interface hashes, in build order.
    pub val dep_names: List<String>
    pub val dep_hashes: List<String>
}

pub struct ArtifactManifestResult {
    pub val ok: bool
    pub val error: String
    pub val manifest: ArtifactManifest
}

pub fun empty_artifact_manifest(): ArtifactManifest {
    return ArtifactManifest {
        format: "",
        compiler_abi: "",
        runtime_abi: "",
        name: "",
        version: "",
        target: "",
        profile: "",
        source_fingerprint: "",
        interface_hash: "",
        implementation_hash: "",
        interface_file: "",
        header_file: "",
        archive_file: "",
        dep_names: List.new<String>(),
        dep_hashes: List.new<String>()
    }
}

/// Byte-identical for equal manifests: fixed key order, dependencies in
/// build order.
pub fun ArtifactManifest.render_artifact_manifest(): String {
    var out = String.from("[artifact]\n")
    out.artifact_field("format", self.format.as_str())
    out.artifact_field("compiler_abi", self.compiler_abi.as_str())
    out.artifact_field("runtime_abi", self.runtime_abi.as_str())
    out.artifact_field("name", self.name.as_str())
    out.artifact_field("version", self.version.as_str())
    out.artifact_field("target", self.target.as_str())
    out.artifact_field("profile", self.profile.as_str())
    out.artifact_field("source_fingerprint", self.source_fingerprint.as_str())
    out.artifact_field("interface_hash", self.interface_hash.as_str())
    out.artifact_field("implementation_hash", self.implementation_hash.as_str())
    out.artifact_field("interface", self.interface_file.as_str())
    out.artifact_field("header", self.header_file.as_str())
    out.artifact_field("archive", self.archive_file.as_str())
    out.append("\n[dep_interfaces]\n")
    var n = self.dep_names.size()
    if self.dep_hashes.size() < n { n = self.dep_hashes.size() }
    var i = 0
    while i < n {
        val dep_name = *self.dep_names.at(i)
        val dep_hash = *self.dep_hashes.at(i)
        out.artifact_field(dep_name.as_str(), dep_hash.as_str())
        i = i + 1
    }
    return out
}

mutating fun String.artifact_field(key: str, value: str): void {
    self.append(key)
    self.append(" = \"")
    self.append(value)
    self.append("\"\n")
}

pub fun parse_artifact_manifest(src: str): ArtifactManifestResult {
    var keys = List.new<String>()
    var values = List.new<String>()
    var dep_names = List.new<String>()
    var dep_hashes = List.new<String>()
    var section = ""
    var error = ""
    val lines = split_lines(src)
    while item in &lines {
        val line = trim_string(item)
        val line_s = line.as_str()
        val blank = line_s == ""
        val comment = string_starts_with_byte(line, 35)
        if !blank && !comment {
            if string_starts_with_byte(line, 91) {
                section = read_section_name(line)
                val s = section.as_str()
                if s != "artifact" && s != "dep_interfaces" {
                    error = artifact_error("unknown section '", s)
                }
            } else {
                val key = read_key(line)
                val value = read_string_value(line)
                val sect = section.as_str()
                if sect == "artifact" {
                    if artifact_list_has(&keys, key.as_str()) {
                        error = artifact_error("duplicate key '", key.as_str())
                    }
                    keys.push(key)
                    values.push(value)
                } else if sect == "dep_interfaces" {
                    if artifact_list_has(&dep_names, key.as_str()) {
                        error = artifact_error("duplicate dependency '", key.as_str())
                    }
                    dep_names.push(key)
                    dep_hashes.push(value)
                } else {
                    error = artifact_error("key outside a section: '", key.as_str())
                }
            }
        }
        if error.as_str() != "" { return artifact_failure(error) }
    }
    val format = required_artifact_field(&keys, &values, "format", &var error)
    val compiler_abi = required_artifact_field(&keys, &values, "compiler_abi", &var error)
    val runtime_abi = required_artifact_field(&keys, &values, "runtime_abi", &var error)
    val name = required_artifact_field(&keys, &values, "name", &var error)
    val version = required_artifact_field(&keys, &values, "version", &var error)
    val target = required_artifact_field(&keys, &values, "target", &var error)
    val profile = required_artifact_field(&keys, &values, "profile", &var error)
    val source_fingerprint = required_artifact_field(&keys, &values, "source_fingerprint", &var error)
    val interface_hash = required_artifact_field(&keys, &values, "interface_hash", &var error)
    val implementation_hash = required_artifact_field(&keys, &values, "implementation_hash", &var error)
    val interface_file = required_artifact_field(&keys, &values, "interface", &var error)
    val header_file = required_artifact_field(&keys, &values, "header", &var error)
    val archive_file = required_artifact_field(&keys, &values, "archive", &var error)
    check_known_artifact_keys(&keys, &var error)
    if error.as_str() == "" && format.as_str() != artifact_format_version() {
        error = artifact_error("unsupported artifact format '", format.as_str())
    }
    if error.as_str() != "" { return artifact_failure(error) }
    val m = ArtifactManifest {
        format: format,
        compiler_abi: compiler_abi,
        runtime_abi: runtime_abi,
        name: name,
        version: version,
        target: target,
        profile: profile,
        source_fingerprint: source_fingerprint,
        interface_hash: interface_hash,
        implementation_hash: implementation_hash,
        interface_file: interface_file,
        header_file: header_file,
        archive_file: archive_file,
        dep_names: dep_names,
        dep_hashes: dep_hashes
    }
    return ArtifactManifestResult { ok: true, error: "", manifest: m }
}

/// Through a staged file, so a racing reader never sees a torn manifest.
pub fun write_artifact_manifest(path: str, m: &ArtifactManifest): bool {
    return publish_text(path, m.render_artifact_manifest().as_str())
}

/// CONSTRAINT: the manifest alone declares a crate's artifacts current, so it
/// is removed before a rebuild; a rebuild that fails partway is then not read
/// as finished.
pub fun remove_artifact_manifest(path: str): bool {
    val cmd = "rm -f ${shell_quote(path).as_str()}"
    return unsafe { system(cmd.as_str()) } == 0
}

fun artifact_error(prefix: str, subject: str): String {
    val out = "artifact.toml: ${prefix}${subject}'"
    return out
}

fun artifact_failure(error: String): ArtifactManifestResult {
    return ArtifactManifestResult { ok: false, error: error, manifest: empty_artifact_manifest() }
}

fun artifact_list_has(names: &List<String>, target: str): bool {
    while name in &names {
        if name.as_str() == target { return true }
    }
    return false
}

// One report per missing field; the first error is kept. The value is
// cloned, since it outlives this borrow of the list.
fun required_artifact_field(keys: &List<String>, values: &List<String>, key: str, error: &var String): String {
    while i in 0..keys.size() {
        if keys.at(i).as_str() == key {
            if i < values.size() { return values.at(i).clone() }
        }
    }
    if error.as_str() == "" {
        (*error) = artifact_error("missing key '", key)
    }
    return ""
}

fun check_known_artifact_keys(keys: &List<String>, error: &var String): void {
    while k in &keys {
        if !artifact_key_known(k.as_str()) {
            if error.as_str() == "" {
                (*error) = artifact_error("unknown key '", k.as_str())
            }
        }
    }
}

fun artifact_key_known(key: str): bool {
    return when key {
        "format" => true
        "compiler_abi" => true
        "runtime_abi" => true
        "name" => true
        "version" => true
        "target" => true
        "profile" => true
        "source_fingerprint" => true
        "interface_hash" => true
        "implementation_hash" => true
        "interface" => true
        "header" => true
        "archive" => true
        _ => false
    }
}
