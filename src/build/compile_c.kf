// C toolchain calls for separate builds: compile, archive, link. Paths are
// shell-quoted for system(3); a failure prints its phase and target.

import alloc.list.*
import std.env.env_var

extern "C" fun system(cmd: str): int32

/// Single-quoted, with embedded quotes as `'\''`.
pub fun shell_quote(s: str): String {
    var out = String.from("'")
    val n = s.byte_len()
    var start: uint64 = 0
    var i = 0
    while i < n {
        if s.byte_at(i) == 39 {
            val piece = s.substring(start, i)
            out.append(piece.as_str())
            out.append("'\\''")
            start = i + 1
        }
        i = i + 1
    }
    val tail = s.substring(start, n)
    out.append(tail.as_str())
    out.append("'")
    return out
}

// A crate is one TU, so without sections a program links all of it. Section
// splitting plus `--gc-sections` makes a `core`+`alloc` program about a third
// smaller; the two must be used together. GNU/lld syntax; a non-GNU target
// needs `-dead_strip`.

fun section_split_flags(): str {
    return "-ffunction-sections -fdata-sections"
}

/// The C dialect the output is defined against, pinned so it does not float
/// with the host `cc`: C23 accepts a compatible struct redefinition and hides
/// duplicate-emission bugs. `scripts/check.sh` pins the same value.
pub fun dialect_flags(): str {
    return "-std=gnu17"
}

/// -O2: the test binary is itself the compiler that builds the corpus (22 s a
/// case at -O0, 0.28 s at -O2). Before `extra_cflags`, which then wins.
fun optimization_flags(): str {
    return "-O2"
}

/// Safe for trait objects: a coercion references the vtable, which references
/// the method; `dyn_archive_integration_test` covers it across crates.
fun dead_strip_flags(): str {
    return "-Wl,--gc-sections"
}

/// `KOMP_CFLAGS`, which `build`, `run` and `test` add to every C compile and
/// link, as `-fsanitize=address` for an ASan build; "" when unset.
pub fun user_cflags(): String {
    return env_var("KOMP_CFLAGS") ?: ""
}

/// `extra_cflags` is caller-trusted ("" or e.g. "-fsanitize=address").
pub fun compile_object(c_path: str, o_path: str, include_dir: str, extra_cflags: str): bool {
    var include_dirs = List.new<String>()
    include_dirs.push(String.from(include_dir))
    return compile_object_with_include_dirs(c_path, o_path, &include_dirs, extra_cflags)
}

/// With several header roots: test artifacts keep their header under
/// target/kflat/test while including dependency headers from target/kflat.
pub fun compile_object_with_include_dirs(c_path: str, o_path: str, include_dirs: &List<String>, extra_cflags: str): bool {
    var cmd = "cc ${dialect_flags()} ${optimization_flags()} ${section_split_flags()} ${extra_cflags}"
    while include_dir in &include_dirs {
        cmd.append(" -I ")
        cmd.append(shell_quote(include_dir.as_str()).as_str())
    }
    cmd.append(" -c ")
    cmd.append(shell_quote(c_path).as_str())
    return run_staged(cmd, o_path, "compile", c_path)
}

pub fun archive_object(a_path: str, o_path: str): bool {
    var objects = List.new<String>()
    objects.push(String.from(o_path))
    return archive_objects(a_path, &objects)
}

/// Written fresh under a staged name: `ar r` would keep stale members.
pub fun archive_objects(a_path: str, objects: &List<String>): bool {
    val staged = staging_path(a_path)
    discard_staged(staged.as_str())
    var cmd = String.from("ar rcs ")
    cmd.append(shell_quote(staged.as_str()).as_str())
    while object in &objects {
        cmd.append(" ")
        cmd.append(shell_quote(object.as_str()).as_str())
    }
    return finish_staged(run_tool(cmd, "archive", a_path), staged.as_str(), a_path)
}

/// The crate name, then the relative path with `/` and `.` folded to `_`:
/// "tui" + "term.c" is "tui__term_c.o".
pub fun c_object_name(crate: str, rel: str): String {
    var out = String.from(crate)
    out.append("__")
    val n = rel.byte_len()
    var i = 0
    while i < n {
        val b = rel.byte_at(i)
        if b == 47 || b == 46 { // '/' or '.'
            out.append("_")
        } else {
            val piece = rel.substring(i, i + 1)
            out.append(piece.as_str())
        }
        i = i + 1
    }
    out.append(".o")
    return out
}

/// Archives are passed dependents-first.
pub fun link_binary(bin_path: str, objects: &List<String>, archives: &List<String>, extra_cflags: str): bool {
    var cmd = "cc ${optimization_flags()} ${dead_strip_flags()} ${extra_cflags}"
    while object in &objects {
        cmd.append(" ")
        cmd.append(shell_quote(object.as_str()).as_str())
    }
    while archive in &archives {
        cmd.append(" ")
        cmd.append(shell_quote(archive.as_str()).as_str())
    }
    // libm, for core.math_hosted. Unused wrappers are dead-stripped first, and
    // every hosted target has the library, so it is always passed.
    cmd.append(" -lm")
    return run_staged(cmd, bin_path, "link", bin_path)
}

/// Output goes to a staged file published only on success.
fun run_staged(cmd: String, out: str, phase: str, target: str): bool {
    val staged = staging_path(out)
    var full = cmd
    full.append(" -o ")
    full.append(shell_quote(staged.as_str()).as_str())
    return finish_staged(run_tool(full, phase, target), staged.as_str(), out)
}

fun finish_staged(ok: bool, staged: str, out: str): bool {
    if ok && publish_staged(staged, out) { return true }
    discard_staged(staged)
    return false
}

fun run_tool(cmd: String, phase: str, target: str): bool {
    val raw = unsafe { system(cmd.as_str()) }
    if raw != 0 {
        val msg = "komp build: ${phase} phase failed for ${target}"
        runtime_println(msg.as_str())
        return false
    }
    return true
}
