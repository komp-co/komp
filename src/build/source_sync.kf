// Bringing fetched sources and `kf.lock` up to date before a build, and
// turning a dependency into the directory the build graph reads.
//
// The lock sits beside the workspace manifest when the crate is a member,
// else beside the crate's own, and covers every crate the members reach.

import alloc.list.*
import komp.fetch.*
import komp.project.Dependency
import komp.project.enclosing_workspace
import komp.project.parse_manifest
import komp.project.workspace_member_roots
import std.fs.exists
import std.fs.remove_file
import alloc.path.Path
import std.fs.absolute

/// `update` re-resolves every ref; `locked` fails rather than change
/// `kf.lock`; `offline` fails rather than fetch.
pub struct FetchPolicy {
    pub val locked: bool
    pub val offline: bool
    pub val update: bool
}

pub fun default_fetch_policy(): FetchPolicy {
    return FetchPolicy { locked: false, offline: false, update: false }
}

pub fun lock_dir_for(crate_root: str): String {
    val ws = enclosing_workspace(crate_root)
    if ws.byte_len() > 0 { return ws }
    return absolute(crate_root).normalized().raw
}

/// The rows of the lock covering `crate_root`; none when it has no lock.
pub fun read_lock(crate_root: str): List<LockEntry> {
    val path = "${lock_dir_for(crate_root)}/kf.lock"
    if !exists(path.as_str()) { return List.new<LockEntry>() }
    return parse_lockfile(read_file(path.as_str()).as_str())
}

/// The directory `dep` of the crate at `crate_root` builds from, or "" for
/// a remote dependency the lock does not pin or the cache does not hold.
pub fun dependency_root(crate_root: str, dep: &Dependency, lock: &List<LockEntry>, cache: str): String {
    if dep.is_remote() {
        while entry in &lock {
            if entry.satisfies(dep) {
                val root = entry.cached_root(cache)
                return if is_fetched(root.as_str()) { root } else { "" }
            }
        }
        return ""
    }
    // A fetched crate cannot know where this machine keeps the standard
    // library, so its `core`, `alloc` and `std` are the bundled ones.
    val stdlib = dep.name.as_str() == "core" || dep.name.as_str() == "alloc" || dep.name.as_str() == "std"
    if stdlib && Path.new(crate_root).starts_with(&Path.new(cache)) {
        val libs = bundled_libs_root(crate_root)
        if libs.byte_len() > 0 { return "${libs}/${dep.name}" }
    }
    return Path.new(crate_root).join(dep.path.as_str()).normalized().raw
}

/// Fetches what every crate the lock covers needs and rewrites `kf.lock`
/// when that changed it. "" on success, else the error to print.
pub fun sync_sources(crate_root: str, policy: &FetchPolicy, cache: str): String {
    val lock_dir = lock_dir_for(crate_root)
    val lock_path = "${lock_dir}/kf.lock"
    val had_lock = exists(lock_path.as_str())
    val old_text = if had_lock { read_file(lock_path.as_str()) } else { String.from("") }
    val old = parse_lockfile(old_text.as_str())
    var rows = List.new<LockEntry>()
    var refreshed = List.new<String>()
    var queue = lock_scope_roots(crate_root, lock_dir.as_str())
    val scope_roots = queue.size()
    var seen = List.new<String>()
    var complete = true
    var next = 0
    while next < queue.size() {
        val dir = queue.at(next).clone()
        next = next + 1
        if seen.any_equal(dir.as_str()) { continue }
        seen.push(dir.clone())
        val manifest_path = "${dir}/kf.toml"
        // A missing or broken manifest is the build graph's to report, and
        // leaves the lock as it is: the rows it would need are unknown.
        if !exists(manifest_path.as_str()) {
            complete = false
            continue
        }
        val manifest = parse_manifest(read_file(manifest_path.as_str()).as_str())
        if manifest.error.byte_len() > 0 {
            complete = false
            continue
        }
        // The members' tests are built here; a dependency's are not.
        var needed = manifest.deps.clone()
        if next <= scope_roots { needed.extend(manifest.dev_deps.clone()) }
        while dep in &needed {
            if dep.is_remote() {
                val fetched = resolve_remote(dep, &old, &rows, policy, cache, &var refreshed)
                if fetched.error.byte_len() > 0 {
                    return "error: dependency `${dep.name}` of ${dir}: ${fetched.error}"
                }
                val root = fetched.entry.cached_root(cache)
                if !rows.holds(&fetched.entry) { rows.push(fetched.entry.clone()) }
                queue.push(root)
            } else {
                val root = dependency_root(dir.as_str(), dep, &rows, cache)
                if !exists("${root}/kf.toml".as_str()) {
                    return "error: dependency `${dep.name}` of ${dir}: ${root} holds no kf.toml"
                }
                queue.push(root)
            }
        }
    }
    val conflict = rows.name_conflict()
    if conflict.byte_len() > 0 { return conflict }
    if !complete || (rows.size() == 0 && !had_lock) { return "" }
    val text = render_lockfile(&rows)
    if had_lock && text.as_str() == old_text.as_str() { return "" }
    if policy.locked {
        return "error: ${lock_path} is out of date; run `komp update`, or drop `--locked`"
    }
    if rows.size() == 0 {
        val _gone = remove_file(lock_path.as_str())
        return ""
    }
    if !publish_text(lock_path.as_str(), text.as_str()) { return "error: could not write ${lock_path}" }
    return ""
}

/// Every member of the workspace at `lock_dir`, or the crate alone.
fun lock_scope_roots(crate_root: str, lock_dir: str): List<String> {
    val ws = enclosing_workspace(crate_root)
    if ws.byte_len() == 0 {
        var alone = List.new<String>()
        alone.push(String.from(lock_dir))
        return alone
    }
    var out = List.new<String>()
    val members = workspace_member_roots(ws.as_str())
    while member in &members { out.push(absolute(member.as_str()).normalized().raw) }
    return out
}

/// A row chosen earlier in this run, then the lock's, else a fresh fetch.
fun resolve_remote(dep: &Dependency, old: &List<LockEntry>, rows: &List<LockEntry>, policy: &FetchPolicy,
    cache: str, refreshed: &var List<String>): Fetched {
    var chosen = rows.find_satisfying(dep)
    if chosen.is_none() && !policy.update { chosen = old.find_satisfying(dep) }
    when (chosen) {
        Some(entry) => return use_pinned(dep, &entry, policy, cache)
        None => {
            if policy.locked { return fetch_failed("kf.lock has no row for it; run `komp update`, or drop `--locked`") }
            if policy.offline { return fetch_failed("kf.lock has no row for it, and `--offline` forbids resolving it") }
            if dep.version.byte_len() > 0 { return resolve_from_index(dep, cache, refreshed) }
            return fetch_pinned(dep, &empty_lock_entry(), cache)
        }
    }
}

/// The cached copy of a pinned row, fetched again when the cache lost it.
fun use_pinned(dep: &Dependency, entry: &LockEntry, policy: &FetchPolicy, cache: str): Fetched {
    if is_fetched(entry.cached_root(cache).as_str()) { return Fetched { entry: entry.clone(), error: "" } }
    if policy.offline {
        return fetch_failed("its pinned source is not in the cache, and `--offline` forbids fetching it")
    }
    return fetch_pinned(dep, entry, cache)
}

fun fetch_pinned(dep: &Dependency, pin: &LockEntry, cache: str): Fetched {
    if dep.version.byte_len() > 0 {
        val fetched = fetch_exact_source(dep.name.as_str(), &pin.git, &pin.rev, &pin.tarball, &pin.checksum, cache)
        if fetched.error.byte_len() > 0 { return fetched }
        return Fetched { entry: fetched.entry.in_index(&pin.index), error: "" }
    }
    if dep.git.byte_len() > 0 { return fetch_git(dep, pin.rev.as_str(), cache) }
    return fetch_tarball(dep, pin.checksum.as_str(), cache)
}

fun List<LockEntry>.find_satisfying(dep: &Dependency): LockEntry? {
    while entry in &self {
        if entry.satisfies(dep) { return entry.clone() }
    }
    return null
}

fun List<LockEntry>.holds(wanted: &LockEntry): bool {
    while entry in &self {
        if entry.same_as(wanted) { return true }
    }
    return false
}

/// One source per crate name: two would define the same symbols.
fun List<LockEntry>.name_conflict(): String {
    while i in 0..self.size() {
        while j in 0..i {
            val a = self.at(i)
            val b = self.at(j)
            if a.name.as_str() == b.name.as_str() {
                val sources = "${b.source_table()} and ${a.source_table()}"
                return "error: crate `${a.name}` is required from two sources: ${sources}"
            }
        }
    }
    return ""
}

fun List<String>.any_equal(wanted: str): bool {
    while item in &self {
        if item.as_str() == wanted { return true }
    }
    return false
}
