// A workspace shares one target directory, so two komp processes may write
// one artifact at once. Every artifact is written under a process-private
// name and renamed over the real one; rename_path(2) is atomic within a
// filesystem, and two writers produce the same bytes.

import alloc.path.Path
import std.fs.create_dir_all
import std.fs.remove_file
import std.fs.rename_path
import std.fs.write_text_atomic
import std.process.process_id

pub fun staging_path(path: str): String {
    return "${path}.tmp.${process_id()}"
}

pub fun publish_staged(staged: str, path: str): bool {
    return rename_path(staged, path).is_ok()
}

/// Failures leave nothing behind.
pub fun discard_staged(staged: str): void {
    val _gone = remove_file(staged)
}

/// False, reported, when it cannot be written.
pub fun publish_text(path: str, content: str): bool {
    if write_text_atomic(path, content).is_ok() { return true }
    runtime_println("error: could not write ${path}")
    return false
}

/// Creates `path` and any missing parents; false, reported, when it cannot.
pub fun ensure_dir(path: str): bool {
    if create_dir_all(Path.new(path)) { return true }
    runtime_println("error: could not create ${path}")
    return false
}
