// The crate dependency graph for separate builds: walks manifests from the
// root, canonicalizes and deduplicates dependency paths, reports a complete
// cycle, and yields a deterministic dependencies-first order.

import alloc.list.*

import komp.fetch.LockEntry
import komp.fetch.cache_root
import komp.project.*
import std.fs.exists
import alloc.path.Path
import std.fs.absolute

// The compiler binary's directory, to find the bundled stdlib.
extern "C" fun kf_self_dir(): String

@derive(Clone)
pub struct BuildCrate {
    pub val name: String
    /// The package's directory, holding its kf.toml.
    pub val root: String
    /// The directory holding the crate's `.kf` files.
    pub val src: String
    /// The package's name: the crate's own, except for the program of a
    /// package holding a library too. A linked binary takes it.
    pub val package: String
    pub val is_bin: bool
    pub val deps: List<String>
    /// Every crate `deps` reach, dependencies first: the interfaces kflatc
    /// loads to compile this one.
    pub val loads: List<String>
    /// C sources relative to `root`, from `[native] c_sources`.
    pub val c_sources: List<String>
    /// `[native] hosted_c_sources`, as this build uses them: a freestanding
    /// root empties them for every crate, decided once here.
    pub val hosted_c_sources: List<String>
}

/// `crates` is dependencies-first and deterministic, the root last. `cycle` is
/// "" for a DAG, else the full cycle as "a -> b -> a".
pub struct BuildGraph {
    pub var crates: List<BuildCrate>
    pub val cycle: String
    /// The root's `freestanding = true`: a property of the program, since a
    /// library cannot know whether what links it has an operating system.
    pub val freestanding: bool
    pub val error: String
}

/// `with_tests` builds the root for its tests too: it then also depends on
/// its package's `[dev-dependencies]`. For a package holding a library and a
/// program, the program is the root.
pub fun build_crate_graph(root_dir: str, with_tests: bool): BuildGraph {
    return build_part_graph(root_dir, true, with_tests)
}

/// One graph per crate of the root package, each with that crate as its
/// root: the library's, then the program's for a package holding both.
pub fun build_package_graphs(root_dir: str, with_tests: bool): List<BuildGraph> {
    var graphs = List.new<BuildGraph>()
    val manifest = "${root_dir}/kf.toml"
    if exists(manifest.as_str()) && parse_manifest(read_file(manifest.as_str()).as_str()).holds_both() {
        graphs.push(build_part_graph(root_dir, false, with_tests))
    }
    graphs.push(build_part_graph(root_dir, true, with_tests))
    return graphs
}

fun build_part_graph(root_dir: str, with_program: bool, with_tests: bool): BuildGraph {
    var crates = List.new<BuildCrate>()
    var cycle = ""
    var error = ""
    var in_progress = List.new<String>()
    var done = List.new<String>()
    val root = absolute(root_dir).normalized().raw
    val freestanding = root_is_freestanding(root.as_str())
    val sources = DependencySources { lock: read_lock(root.as_str()), cache: cache_root() }
    visit_crate(root, freestanding, &sources, &var crates, &var cycle, &var error, &var in_progress, &var done)
    if with_program && error.as_str() == "" && !cycle.cycle_found() { crates.add_program() }
    if with_tests && error.as_str() == "" && !cycle.cycle_found() {
        crates.add_dev_dependencies(freestanding, &sources, &var cycle, &var error, &var done)
    }
    if error.as_str() != "" { crates = List.new<BuildCrate>() }
    return BuildGraph { crates: crates, cycle: cycle, freestanding: freestanding, error: error }
}

/// From the root manifest alone.
fun root_is_freestanding(root: str): bool {
    var manifest_path = String.from(root)
    manifest_path.append("/kf.toml")
    if !exists(manifest_path.as_str()) { return false }
    return parse_manifest(read_file(manifest_path.as_str()).as_str()).freestanding
}

/// What a remote dependency resolves through: the lock pins it, the cache
/// holds it.
struct DependencySources {
    val lock: List<LockEntry>
    val cache: String
}

fun visit_crate(root: String, freestanding: bool, sources: &DependencySources, crates: &var List<BuildCrate>,
    cycle: &var String, error: &var String, in_progress: &var List<String>,
    done: &var List<String>): void {
    if error.as_str() != "" { return }
    if cycle.cycle_found() { return }
    if path_list_has(done, root.as_str()) { return }
    if path_list_has(in_progress, root.as_str()) {
        cycle.record_cycle(in_progress, root.as_str())
        return
    }
    val manifest_path = root.clone() + String.from("/kf.toml")
    if !exists(manifest_path.as_str()) {
        (*error) = "error: no kf.toml manifest found at ${manifest_path}"
        return
    }
    val manifest_src = read_file(manifest_path.as_str())
    val mf = parse_manifest(manifest_src.as_str())
    if mf.error.as_str() != "" {
        (*error) = "error: invalid manifest ${manifest_path}: ${mf.error}"
        return
    }
    val uses_std = deps_have_alias(&mf.deps, "std") || crate_imports_std(root.as_str())
    if freestanding && mf.name.as_str() != "std" && uses_std {
        val why = "which needs an operating system, and this program is freestanding (`freestanding = true`)"
        (*error) = "error: ${root} uses std, ${why}"
        return
    }
    in_progress.push(root.clone())
    val eff_deps = mf.effective_deps(root.as_str(), freestanding)
    var dep_names = List.new<String>()
    while eff_dep in &eff_deps {
        val dep_root = dependency_root(root.as_str(), eff_dep, &sources.lock, sources.cache.as_str())
        if dep_root.byte_len() == 0 {
            (*error) = "error: dependency `${eff_dep.name}` of ${root} is not fetched; `komp build` fetches it"
            return
        }
        // The crate name comes from its own manifest; the dependency key is an
        // alias.
        val dep_manifest = dep_root.clone() + String.from("/kf.toml")
        visit_crate(dep_root.clone(), freestanding, sources, crates, cycle, error, in_progress, done)
        if cycle.cycle_found() || error.as_str() != "" { return }
        if exists(dep_manifest.as_str()) {
            val dep_mf = parse_manifest(read_file(dep_manifest.as_str()).as_str())
            dep_names.push(dep_mf.first_crate_name())
        }
    }
    in_progress.pop()
    done.push(root.clone())
    val is_bin = !mf.has_library()
    val c_sources = manifest_c_sources(manifest_src.as_str())
    // A freestanding program takes no crate's hosted half.
    var hosted_c_sources = List.new<String>()
    if !freestanding { hosted_c_sources = manifest_hosted_c_sources(manifest_src.as_str()) }
    val loads = crates.closure_of(&dep_names)
    val src = mf.first_source_dir(root.as_str())
    crates.push(BuildCrate {
        name: mf.first_crate_name(), root: root, src: src, package: String.from(mf.name.as_str()),
        is_bin: is_bin, deps: dep_names, loads: loads, c_sources: c_sources, hosted_c_sources: hosted_c_sources
    })
}

/// For a root package holding a library and a program, the program after the
/// library: a crate of its own, depending on the library and on what the
/// library does. The package's native C stays with the library.
mutating fun List<BuildCrate>.add_program(): void {
    val library = self.last() ?: return
    val mf = parse_manifest(read_file("${library.root}/kf.toml".as_str()).as_str())
    if !mf.holds_both() { return }
    var deps = library.deps.clone()
    deps.push(library.name.clone())
    val loads = self.closure_of(&deps)
    self.push(BuildCrate {
        name: mf.program_crate_name(), root: library.root.clone(), src: program_source_dir(library.root.as_str()),
        package: library.package.clone(), is_bin: true, deps: deps, loads: loads, c_sources: List.new<String>(),
        hosted_c_sources: List.new<String>()
    })
}

/// The crates `names` reach, in graph order, which puts each after its own
/// dependencies. Every one of them is already in the list.
fun List<BuildCrate>.closure_of(names: &List<String>): List<String> {
    var wanted = List.new<String>()
    while name in &names {
        wanted.push(name.clone())
    }
    while item in &self {
        if name_listed(&wanted, item.name.as_str()) {
            while dep in &item.loads {
                if !name_listed(&wanted, dep.as_str()) { wanted.push(dep.clone()) }
            }
        }
    }
    var ordered = List.new<String>()
    while item in &self {
        if name_listed(&wanted, item.name.as_str()) { ordered.push(item.name.clone()) }
    }
    return ordered
}

fun name_listed(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

// Declared dependencies, plus from the bundled sysroot (`<self_dir>/../libs`):
// `core` and `alloc` for a dependency-free crate, and `std` for a crate of a
// hosted program that imports it. A crate with dependencies inherits their
// `core` and `alloc`; injecting another would duplicate trait impls. A crate
// naming `core`, `alloc` or `std` manages its own tier.
fun Manifest.effective_deps(crate_root: str, freestanding: bool): List<Dependency> {
    var out = List.new<Dependency>()
    val cname = self.name.as_str()
    val is_stdlib = cname == "core" || cname == "alloc" || cname == "std"
    val declares_stdlib = deps_have_alias(&self.deps, "core") || deps_have_alias(&self.deps, "alloc") ||
        deps_have_alias(&self.deps, "std")
    if !is_stdlib && !declares_stdlib {
        val libs = bundled_libs_root(crate_root)
        if libs.byte_len() > 0 && self.deps.size() == 0 {
            out.push(new_dependency(String.from("core"), "${libs}/core"))
            out.push(new_dependency(String.from("alloc"), "${libs}/alloc"))
        }
        if libs.byte_len() > 0 && !freestanding && crate_imports_std(crate_root) {
            out.push(new_dependency(String.from("std"), "${libs}/std"))
        }
    }
    while dep in &self.deps {
        out.push(dep.clone())
    }
    return out
}

// Beside the compiler komp runs, which ships them; beside komp when that
// has none; the repository's `libs` for a compiler running from elsewhere
// during development.
pub fun bundled_libs_root(crate_root: str): String {
    val compiler = kflatc_path()
    val compiler_libs = "${parent_path(compiler.as_str())}/../libs"
    if exists("${compiler_libs}/core/kf.toml".as_str()) { return Path.new(compiler_libs.as_str()).normalized().raw }
    val base = kf_self_dir()
    if base.as_str().byte_len() > 0 {
        val beside = base + String.from("/../libs")
        val manifest = beside.clone() + String.from("/core/kf.toml")
        if exists(manifest.as_str()) {
            return Path.new(beside.as_str()).normalized().raw
        }
    }
    if exists("libs/core/kf.toml") {
        return absolute("libs").normalized().raw
    }
    // Normalized, so `komp check .` does not collapse to "".
    var here = absolute(crate_root).normalized().raw
    var depth = 0
    while depth < 16 {
        val candidate = here.clone() + String.from("/libs")
        val manifest = candidate.clone() + String.from("/core/kf.toml")
        if exists(manifest.as_str()) {
            return Path.new(candidate.as_str()).normalized().raw
        }
        val parent = parent_path(here.as_str())
        if parent.as_str() == here.as_str() { return "" }
        here = parent
        depth = depth + 1
    }
    return ""
}

fun deps_have_alias(deps: &List<Dependency>, alias: str): bool {
    while dep in &deps {
        if dep.name.as_str() == alias { return true }
    }
    return false
}

mutating fun String.cycle_found(): bool {
    return self.as_str().byte_len() > 0
}

// Every stack entry from `target`'s first occurrence, closed by `target`.
mutating fun String.record_cycle(in_progress: &var List<String>, target: str): void {
    var out = ""
    var started = false
    while p in &in_progress {
        if p.as_str() == target { started = true }
        if started {
            out = out + p + String.from(" -> ")
        }
    }
    out = out + String.from(target)
    (*self) = out
}

fun path_list_has(paths: &var List<String>, target: str): bool {
    while path in &paths {
        if path.as_str() == target { return true }
    }
    return false
}

/// The root, last, made to depend on its package's `[dev-dependencies]` too,
/// which go in before it.
mutating fun List<BuildCrate>.add_dev_dependencies(freestanding: bool, sources: &DependencySources,
    cycle: &var String, error: &var String, done: &var List<String>): void {
    val root = self.take_last() ?: return
    val manifest = parse_manifest(read_file("${root.root}/kf.toml".as_str()).as_str())
    var deps = root.deps.clone()
    while dev in &manifest.dev_deps {
        val dev_root = dependency_root(root.root.as_str(), dev, &sources.lock, sources.cache.as_str())
        if dev_root.byte_len() == 0 {
            (*error) = "error: dev-dependency `${dev.name}` of ${root.root} is not fetched; `komp test` fetches it"
            return
        }
        var in_progress = List.new<String>()
        visit_crate(dev_root.clone(), freestanding, sources, self, cycle, error, &var in_progress, done)
        if cycle.cycle_found() || error.as_str() != "" { return }
        val name = parse_manifest(read_file("${dev_root}/kf.toml".as_str()).as_str()).first_crate_name()
        if !name_listed(&deps, name.as_str()) { deps.push(name) }
    }
    val loads = self.closure_of(&deps)
    self.push(BuildCrate {
        name: root.name.clone(), root: root.root.clone(), src: root.src.clone(), package: root.package.clone(),
        is_bin: root.is_bin, deps: deps, loads: loads, c_sources: root.c_sources.clone(),
        hosted_c_sources: root.hosted_c_sources.clone()
    })
}
