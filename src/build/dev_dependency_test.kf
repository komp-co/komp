// A dev-dependency joins the graph only when the root is built for its
// tests, and a library may take a name of its own.

import core.assert.assert_eq
import alloc.list.*
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

/// `gdev_app`, whose tests use `gdev_helper`.
fun write_dev_project(): str {
    val helper = scratch_path("kf_g_dev_helper")
    val app = scratch_path("kf_g_dev_app")
    val _made = unsafe { system("rm -rf ${helper} ${app} && mkdir -p ${helper}/src ${app}/src") }
    write_file("${helper}/kf.toml".as_str(), "[project]\nname = \"gdev_helper\"\nkind = \"lib\"\n")
    write_file("${helper}/src/help.kf".as_str(), "pub fun help(): int32 { return 1 }\n")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "gdev_app"
kind = "lib"

[dev-dependencies]
gdev_helper = { path = "../kf_g_dev_helper" }
""")
    write_file("${app}/src/app.kf".as_str(), "pub fun app(): int32 { return 0 }\n")
    return app
}

/// `gnamed_user` depending on package `gnamed`, whose library is `gnamed_lib`.
fun write_named_library(): str {
    val package = scratch_path("kf_g_named")
    val user = scratch_path("kf_g_named_user")
    val _made = unsafe { system("rm -rf ${package} ${user} && mkdir -p ${package}/src/lib ${user}/src") }
    write_file("${package}/kf.toml".as_str(), "[project]\nname = \"gnamed\"\n\n[lib]\nname = \"gnamed_lib\"\n")
    write_file("${package}/src/lib/part.kf".as_str(), "pub fun part(): int32 { return 1 }\n")
    write_file("${user}/kf.toml".as_str(), """[project]
name = "gnamed_user"

[dependencies]
gnamed = { path = "../kf_g_named" }
""")
    write_file("${user}/src/main.kf".as_str(), "fun main(): int32 { return 0 }\n")
    return user
}

fun BuildGraph.names_crate(name: str): bool {
    while item in &self.crates {
        if item.name.as_str() == name { return true }
    }
    return false
}

@test
fun a_dev_dependency_is_built_for_the_tests(): void {
    val graph = build_crate_graph(write_dev_project(), true)
    assert_eq(graph.names_crate("gdev_helper"), true, "the tests import it")
}

@test
fun a_dev_dependency_is_not_built_for_the_program(): void {
    val graph = build_crate_graph(write_dev_project(), false)
    assert_eq(graph.names_crate("gdev_helper"), false, "a build leaves it out")
}

@test
fun the_root_depends_on_its_dev_dependencies_in_a_test_build(): void {
    val graph = build_crate_graph(write_dev_project(), true)
    val root = graph.crates.at(graph.crates.size() - 1)
    assert_eq(root.deps.contains(&String.from("gdev_helper")), true, "kflatc gets it as a --dep")
}

@test
fun a_named_library_is_the_crate_its_dependents_import(): void {
    val graph = build_crate_graph(write_named_library(), false)
    assert_eq(graph.names_crate("gnamed_lib"), true, "`[lib] name` names the crate")
}
