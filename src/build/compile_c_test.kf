import alloc.list.*
import core.assert.assert_eq
import std.fs.scratch_path
import testing.test

@test
fun plain_paths_are_single_quoted(): void {
    assert_eq(shell_quote("${scratch_path("a")} b/c.o").as_str(), "'${scratch_path("a")} b/c.o'", "spaces survive system(3)")
}

@test
fun embedded_single_quotes_are_spliced(): void {
    assert_eq(shell_quote("a'b").as_str(), "'a'\\''b'", "a quote inside the path re-enters quoting")
}

@test
fun compile_archive_link_round_trip(): void {
    write_file(scratch_path("kf_tool_lib.c"), "int kf_tool_answer(void) { return 42; }\n")
    write_file(scratch_path("kf_tool_main.c"), """int kf_tool_answer(void);
int main(void) { return kf_tool_answer() == 42 ? 0 : 1; }
""")
    var ok = compile_object(scratch_path("kf_tool_lib.c"), scratch_path("kf_tool_lib.o"), "/tmp", "")
    if ok { ok = archive_object(scratch_path("libkf_tool.a"), scratch_path("kf_tool_lib.o")) }
    if ok { ok = compile_object(scratch_path("kf_tool_main.c"), scratch_path("kf_tool_main.o"), "/tmp", "") }
    var objects = List.new<String>()
    objects.push(String.from(scratch_path("kf_tool_main.o")))
    var archives = List.new<String>()
    archives.push(String.from(scratch_path("libkf_tool.a")))
    if ok { ok = link_binary(scratch_path("kf_tool_bin"), &objects, &archives, "") }
    var rc: int32 = 1
    if ok { rc = unsafe { system(scratch_path("kf_tool_bin")) } }
    assert_eq(rc, 0, "cc -c, ar, and link compose into a running binary")
}

@test
fun tool_failures_name_the_phase(): void {
    // A broken TU fails the compile phase.
    write_file(scratch_path("kf_tool_broken.c"), "int broken(void) {\n")
    val ok = compile_object(scratch_path("kf_tool_broken.c"), scratch_path("kf_tool_broken.o"), "/tmp", "-w 2>/dev/null")
    assert_eq(ok, false, "a failed cc invocation reports failure")
}

@test
fun build_mode_unity_flag_selects_unity(): void {
    var is_unity = false
    when (build_mode_from_flag("--unity")) {
        Unity => { is_unity = true }
        Separate => {}
    }
    assert_eq(is_unity, true, "--unity maps to BuildMode.Unity")
}

@test
fun build_mode_defaults_to_separate(): void {
    var is_separate = false
    when (build_mode_from_flag("some/project")) {
        Unity => {}
        Separate => { is_separate = true }
    }
    assert_eq(is_separate, true, "a project path uses the artifact default")
}

@test
fun artifact_paths_land_under_target_kflat(): void {
    assert_eq(target_dir("/w/app").as_str(), "/w/app/target/kflat", "one target directory per project")
}

@test
fun archives_follow_the_lib_prefix_convention(): void {
    assert_eq(crate_archive_path("/t", "json").as_str(), "/t/libjson.a", "archives are named lib<crate>.a")
}
