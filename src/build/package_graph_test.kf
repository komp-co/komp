// A package holding a library and a program: two crates at one root, the
// program depending on the library, and a dependent seeing only the library.

import core.assert.assert_eq
import alloc.list.*
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

fun write_both_package(): str {
    val root = scratch_path("kf_g_both")
    val _made = unsafe { system("mkdir -p ${root}/src/lib ${root}/src/bin") }
    write_file("${root}/kf.toml".as_str(), "[project]\nname = \"gboth\"\n\n[lib]\n\n[bin]\n")
    write_file("${root}/src/lib/part.kf".as_str(), "pub fun part(): int32 { return 1 }\n")
    write_file("${root}/src/bin/main.kf".as_str(), "fun main(): int32 { return 0 }\n")
    return root
}

fun write_both_dependent(): str {
    val _package = write_both_package()
    val root = scratch_path("kf_g_both_user")
    val _made = unsafe { system("mkdir -p ${root}/src") }
    val manifest = "[project]\nname = \"gboth_user\"\n\n[dependencies]\ngboth = { path = \"../kf_g_both\" }\n"
    write_file("${root}/kf.toml".as_str(), manifest)
    write_file("${root}/src/main.kf".as_str(), "fun main(): int32 { return 0 }\n")
    return root
}

fun BuildGraph.root_crate(): BuildCrate {
    return self.crates.at(self.crates.size() - 1).clone()
}

fun BuildGraph.lists_crate(name: str): bool {
    while item in &self.crates {
        if item.name.as_str() == name { return true }
    }
    return false
}

@test
fun the_program_is_the_root_of_a_package_holding_both(): void {
    val graph = build_crate_graph(write_both_package(), false)
    assert_eq(graph.root_crate().name.as_str(), "gboth_bin", "the program is built last")
}

@test
fun the_program_depends_on_the_library(): void {
    val graph = build_crate_graph(write_both_package(), false)
    assert_eq(graph.root_crate().deps.contains(&String.from("gboth")), true, "the library is a dependency")
}

@test
fun the_program_reads_src_bin(): void {
    val root = write_both_package()
    val graph = build_crate_graph(root, false)
    assert_eq(graph.root_crate().src.ends_with("/src/bin"), true, "its own source directory")
}

@test
fun the_program_binary_takes_the_package_name(): void {
    val graph = build_crate_graph(write_both_package(), false)
    assert_eq(graph.root_crate().package.as_str(), "gboth", "not the program crate's name")
}

@test
fun each_crate_of_a_package_holding_both_gets_a_graph(): void {
    val graphs = build_package_graphs(write_both_package(), false)
    assert_eq(graphs.size(), 2, "the library's, then the program's")
}

@test
fun the_first_package_graph_has_the_library_as_its_root(): void {
    val graphs = build_package_graphs(write_both_package(), false)
    assert_eq(graphs.at(0).root_crate().name.as_str(), "gboth", "the library is tested on its own")
}

@test
fun a_dependent_builds_against_the_library_only(): void {
    val graph = build_crate_graph(write_both_dependent(), false)
    assert_eq(graph.lists_crate("gboth_bin"), false, "the program is not a dependency")
}

@test
fun a_dependent_reads_the_library_from_src_lib(): void {
    val graph = build_crate_graph(write_both_dependent(), false)
    var src = String.from("")
    while item in &graph.crates {
        if item.name.as_str() == "gboth" { src = item.src.clone() }
    }
    assert_eq(src.ends_with("/src/lib"), true, "the library's directory")
}
