// `komp check`: each dependency's interface brought up to date with kflatc,
// then the root checked against them. No C is compiled.

import alloc.list.*
import std.fs.exists

/// Returns 0 when the project checks clean: each crate of the package, the
/// library first. `as_json` prints diagnostics as newline-delimited JSON.
pub fun check_project_with_kflatc(root_dir: str, as_json: bool): int32 {
    var status = 0
    val graphs = build_package_graphs(root_dir, true)
    while graph in &graphs {
        val root = prepare_check(graph, root_dir, as_json) ?: return 1
        if root.invoke_kflatc_check(root_dir, target_dir(root_dir).as_str(), as_json) != 0 { status = 1 }
    }
    return status
}

/// As `check_project_with_kflatc`, kflatc tallying the lints it found.
pub fun lint_project_with_kflatc(root_dir: str, as_json: bool): int32 {
    var status = 0
    val graphs = build_package_graphs(root_dir, true)
    while graph in &graphs {
        val root = prepare_check(graph, root_dir, as_json) ?: return 1
        if root.invoke_kflatc_lint(root_dir, target_dir(root_dir).as_str(), as_json) != 0 { status = 1 }
    }
    return status
}

/// The graph's root crate, once every dependency's interface is current, or
/// None after reporting why the project cannot be checked.
pub fun prepare_check(graph: &BuildGraph, root_dir: str, as_json: bool): BuildCrate? {
    val problem = if graph.error.byte_len() > 0 {
        graph.error.clone()
    } else if graph.cycle.byte_len() > 0 {
        "error: dependency cycle: ${graph.cycle}"
    } else if graph.crates.size() == 0 {
        String.from("komp check: nothing to check")
    } else {
        String.from("")
    }
    if problem.byte_len() > 0 {
        if as_json { println(json_error_line(problem.as_str())) } else { println(problem) }
        return Option.None
    }
    val tdir = target_dir(root_dir)
    if !ensure_dir(tdir.as_str()) { return Option.None }
    val compiler = kflatc_identity() ?: return Option.None
    while i in 0..graph.crates.size() - 1 {
        val dependency = graph.crates.at(i)
        if !interface_is_current(tdir.as_str(), dependency, &compiler) {
            if !dependency.refresh_interface(root_dir, tdir.as_str(), &compiler) { return Option.None }
        }
    }
    return graph.crates.last()
}

/// Writes the dependency's interface with kflatc and stamps it, so the next
/// check can reuse it. Its own dependencies' interfaces are current by then.
fun BuildCrate.refresh_interface(root_dir: str, tdir: str, compiler: &CompilerIdentity): bool {
    var dep_hashes = List.new<String>()
    while dep in &self.deps {
        dep_hashes.push(content_hash(read_file(crate_interface_path(tdir, dep.as_str()).as_str()).as_str()))
    }
    if self.invoke_kflatc(root_dir, tdir, &dep_hashes, false) != 0 { return false }
    val fingerprint = crate_source_fingerprint(self.root.as_str(), self.src.as_str(), compiler)
    val stamp = crate_interface_stamp_path(tdir, self.name.as_str())
    write_file(stamp.as_str(), interface_stamp(fingerprint.as_str(), compiler).as_str())
    return true
}

/// The interface this compiler would write from the current sources: its
/// artifact manifest, or the stamp a `check` leaves, names this compiler and
/// the current source fingerprint. A sourceless crate has only its recorded
/// ABI.
pub fun interface_is_current(artifacts: str, dependency: &BuildCrate, compiler: &CompilerIdentity): bool {
    val name = dependency.name.as_str()
    if !exists(crate_interface_path(artifacts, name).as_str()) { return false }
    val fingerprint = crate_source_fingerprint(dependency.root.as_str(), dependency.src.as_str(), compiler)
    val stamp = crate_interface_stamp_path(artifacts, name)
    if exists(stamp.as_str()) {
        val expected = interface_stamp(fingerprint.as_str(), compiler)
        if read_file(stamp.as_str()).as_str() == expected.as_str() { return true }
    }
    val metadata = crate_artifact_manifest_path(artifacts, name)
    if !exists(metadata.as_str()) { return false }
    val parsed = parse_artifact_manifest(read_file(metadata.as_str()).as_str())
    if !parsed.ok || parsed.manifest.compiler_abi.as_str() != compiler.abi.as_str() { return false }
    return fingerprint.as_str() == "" || fingerprint.as_str() == parsed.manifest.source_fingerprint.as_str()
}

/// What a `check` records beside an interface it wrote: the compiler's ABI
/// and the sources the interface came from.
pub fun interface_stamp(fingerprint: str, compiler: &CompilerIdentity): String {
    return "${compiler.abi}\n${fingerprint}\n"
}
