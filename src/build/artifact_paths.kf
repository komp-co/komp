// What each artifact in a target directory is called. kflatc names the ones
// it writes itself (`.kfi`, `.h`, `.c`, `kf_runtime.h`, `test/`), as its
// command line documents; these must spell them the same way.

pub fun crate_header_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".h")
}

pub fun crate_source_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".c")
}

pub fun crate_interface_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".kfi")
}

/// Beside an interface a `check` wrote, which no build has archived yet.
pub fun crate_interface_stamp_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".kfi.stamp")
}

pub fun crate_object_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".o")
}

/// Reuse metadata for one crate's artifacts.
pub fun crate_artifact_manifest_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, ".artifact.toml")
}

pub fun crate_archive_path(tdir: str, crate_name: str): String {
    var out = String.from(tdir)
    out.append("/lib")
    out.append(crate_name)
    out.append(".a")
    return out
}

pub fun runtime_header_path(tdir: str): String {
    return join_artifact(tdir, "kf_runtime", ".h")
}

pub fun binary_path(tdir: str, crate_name: str): String {
    return join_artifact(tdir, crate_name, "")
}

fun join_artifact(tdir: str, stem: str, ext: str): String {
    var out = String.from(tdir)
    out.append("/")
    out.append(stem)
    out.append(ext)
    return out
}

/// Where a crate's test translation unit and binary live.
pub fun test_crate_dir(tdir: str): String {
    return "${tdir}/test"
}

pub fun test_artifact_path(test_dir: str, crate_name: str, extension: str): String {
    return "${test_dir}/${crate_name}_tests${extension}"
}
