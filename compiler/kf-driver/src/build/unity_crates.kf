// kflatc's unity build: a list of crates compiled into one C translation
// unit. The crates' own C sources are not included; the caller appends them.

import alloc.list.*

import kf_core.ast.new_crate_id
import kf_assemble.no_overlay
import kf_assemble.stamp_module_owner

import kf_driver.fresh_source_map
import kf_driver.run_pipeline
import kf_driver.testing.*
import kf_shared.publish_text
import kf_core.diagnostic.new_diagnostics

/// Compiles `crates`, dependencies first and the root last, into the C at
/// `out`. `with_tests` adds the root's `_test.kf` files and a generated test
/// main. Returns the number of errors; nothing is written when there are any.
pub fun compile_unity_crates(crates: &List<CrateSource>, is_bin: bool, with_tests: bool, out: str): int32 {
    val smap = fresh_source_map()
    var pdiags = new_diagnostics()
    val none = no_overlay()
    var modules = assemble_crate_list(crates, smap, &var pdiags, with_tests, &none)
    val parse_errors = report_parse_errors(&var pdiags, smap, false)
    // A test build stops here, before a parse error becomes a C compiler one.
    if with_tests && parse_errors != 0 { return parse_errors }
    if with_tests {
        val root_name = crates.at(crates.size() - 1).name.as_str()
        val names = collect_test_names(modules.clone())
        rename_main_decls(&var modules)
        var main_src = gen_test_main_imports(&modules)
        main_src.append(gen_test_main_src(names).as_str())
        var main_module = parse_test_main(main_src.as_str(), smap)
        stamp_module_owner(&var main_module, new_crate_id(root_name))
        modules.push(main_module)
    }
    var errors = new_diagnostics()
    errors.count_errors(parse_errors)
    var merged = merge_module_list(modules)
    val generated = merged.run_pipeline(is_bin || with_tests, &var errors, smap)
    val error_count = errors.error_count()
    if error_count == 0 && !publish_text(out, generated.as_str()) { return 1 }
    return error_count
}
