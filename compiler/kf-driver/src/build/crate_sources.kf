// kflatc's half of a separate build: one crate compiled against its
// dependencies' interfaces, written out as `.kfi`, `.h` and `.c` beside the
// runtime header they include.

import alloc.list.*

import kf_codegen.runtime.emit_runtime_header
import kf_shared.crate_header_path
import kf_shared.crate_source_path
import kf_shared.crate_interface_path
import kf_shared.runtime_header_path
import kf_shared.test_crate_dir
import kf_shared.test_artifact_path
import kf_shared.publish_text
import kf_shared.ensure_dir

/// Compiles the crate against the interfaces in `tdir` and writes its
/// `.kfi`, `.h` and `.c` there. False on any error, reported as it is found.
pub fun CompileUnit.write_crate_sources(tdir: str, is_bin_root: bool, errors: &var Diagnostics): bool {
    val res = self.compile_crate_against_interfaces(tdir, is_bin_root, errors)
    if errors.error_count() != 0 { return false }
    if !publish_runtime_header(tdir) { return false }
    val name = self.name.as_str()
    if !publish_text(crate_interface_path(tdir, name).as_str(), res.interface_text.as_str()) { return false }
    if !publish_text(crate_header_path(tdir, name).as_str(), res.output.header.as_str()) { return false }
    return publish_text(crate_source_path(tdir, name).as_str(), res.output.source.as_str())
}

/// Compiles the crate with its `_test.kf` files and a generated test main, and
/// writes `<name>_tests.h` and `.c` to `test_crate_dir(tdir)`. False on any
/// error.
pub fun CompileUnit.write_test_sources(tdir: str, errors: &var Diagnostics): bool {
    val res = self.compile_test_crate_against_interfaces(tdir, errors)
    if errors.error_count() != 0 { return false }
    if !publish_runtime_header(tdir) { return false }
    val test_dir = test_crate_dir(tdir)
    if !ensure_dir(test_dir.as_str()) { return false }
    val name = self.name.as_str()
    if !publish_text(test_artifact_path(test_dir.as_str(), name, ".h").as_str(), res.output.header.as_str()) {
        return false
    }
    return publish_text(test_artifact_path(test_dir.as_str(), name, ".c").as_str(), res.output.source.as_str())
}

/// `kf_runtime.h`, which every crate's header includes.
fun publish_runtime_header(tdir: str): bool {
    return publish_text(runtime_header_path(tdir).as_str(), emit_runtime_header().as_str())
}
