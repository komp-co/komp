import core.assert.assert_eq

import kf_core.diagnostic.*
import kf_core.span.*
import kf_driver.fresh_source_map
import kf_shared.render_json_error

@test
fun json_diagnostic_includes_location_and_escaped_message(): void {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    val file_id = unsafe { smap.add_file(new_source_file(String.from("input.kf"), String.from("bad\nsource"))) }
    val diag = error_at(Span { file_id: file_id, start: 1, end: 4 }, String.from("bad \"name\""))
    assert_eq(diag.render_json_diag(smap).as_str(), "{\"schema_version\":3,\"severity\":\"error\",\"code\":null,\"message\":\"bad \\\"name\\\"\",\"byte_start\":1,\"byte_end\":4,\"file\":\"input.kf\",\"line\":1,\"column\":2,\"secondary\":[],\"fix\":null}", "diagnostic JSON preserves the primary location")
}

@test
fun test_manifest_error_json_is_machine_readable(): void {
    val json = render_json_error("invalid manifest \"kf.toml\"")
    assert_eq(json.as_str(), "{\"schema_version\":3,\"severity\":\"error\",\"code\":null,\"message\":\"invalid manifest \\\"kf.toml\\\"\",\"byte_start\":0,\"byte_end\":0,\"file\":null,\"line\":null,\"column\":null,\"secondary\":[],\"fix\":null}", "manifest errors use the diagnostic JSON schema")
}

// `fix` is null on diagnostics without a repair.

@test
fun a_diagnostic_with_a_repair_serializes_it(): void {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    val file_id = unsafe { smap.add_file(new_source_file(String.from("input.kf"), String.from("p.sunm()\n"))) }
    val where = Span { file_id: file_id, start: 2, end: 6 }
    val diag = with_fix(error_at(where, String.from("no method")), where, String.from("sum"), String.from("change to `sum`"))
    val json = diag.render_json_diag(smap)
    assert_eq(json.as_str().contains("\"fix\":{\"title\":\"change to `sum`\""), true, "the title a menu shows")
    assert_eq(json.as_str().contains("\"replacement\":\"sum\""), true, "what to write")
    assert_eq(json.as_str().contains("\"byte_start\":2,\"byte_end\":6"), true, "and exactly where")
}

@test
fun the_json_names_the_lint_that_fired(): void {
    val d = lint_at("unused_import", no_span(), String.from("unused import `x`"))
    val json = d.render_json_diag(fresh_source_map())
    assert_eq(json.as_str().contains("\"code\":\"unused_import\""), true,
        "a client filters and suppresses on this")
}

@test
fun the_json_carries_each_supporting_label(): void {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    val file_id = unsafe { smap.add_file(new_source_file(String.from("a.kf"), String.from("fun f()\nfun f()\n"))) }
    var d = error_at(Span { file_id: file_id, start: 12, end: 13 }, String.from("duplicate `f`"))
    d.secondary.push(new_label(Span { file_id: file_id, start: 4, end: 5 }, String.from("first declared here")))
    val json = d.render_json_diag(smap).as_str()
    assert_eq(json.contains("\"secondary\":[{\"message\":\"first declared here\""), true,
        "an editor renders this as related information")
    assert_eq(json.contains("\"byte_start\":4,\"byte_end\":5,\"file\":\"a.kf\",\"line\":1,\"column\":5"), true,
        "with its own span, because a note routinely points elsewhere")
}

@test
fun a_diagnostic_with_no_notes_carries_an_empty_array(): void {
    // `[]`, not null.
    val d = error_at(no_span(), String.from("plain"))
    assert_eq(d.render_json_diag(fresh_source_map()).as_str().contains("\"secondary\":[]"), true,
        "always an array")
}

@test
fun a_note_the_map_cannot_place_still_carries_its_message(): void {
    var d = error_at(no_span(), String.from("plain"))
    d.secondary.push(new_label(no_span(), String.from("from a synthesized node")))
    val json = d.render_json_diag(fresh_source_map()).as_str()
    assert_eq(json.contains("\"message\":\"from a synthesized node\""), true, "the message survives")
    assert_eq(json.contains("\"file\":null,\"line\":null,\"column\":null"), true, "with nulls where a location would be")
}

@test
fun the_json_says_null_for_an_ordinary_error(): void {
    // Null, not an empty string.
    val d = error_at(no_span(), String.from("something is wrong"))
    val json = d.render_json_diag(fresh_source_map())
    assert_eq(json.as_str().contains("\"code\":null"), true, "no lint produced it")
}
