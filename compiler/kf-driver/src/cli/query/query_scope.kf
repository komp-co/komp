// Scope completion: the names visible at an offset with no receiver.
//
// The walk descends: it takes statements ending before the offset and enters
// only the one containing it, so a later local or a sibling block's is out.
//
// CONSTRAINT: this is the checked tree, where `while x in xs` is expanded and
// every minted node carries the loop's span. Synthesized bindings are
// transparent and arms are chosen by where their body opens; the loop
// variable arrives through the `Some(x)` pattern.

import alloc.list.*

import kf_core.ast.*
import kf_interface.emit.tyref_to_source
import json.writer.*

/// `kind` is KFlat's word; the plugins translate.
pub struct ScopeItem {
    pub val label:  String
    pub val kind:   String
    pub val detail: String
}

/// Innermost first: locals, parameters, reachable declarations, then the
/// signature table.
pub fun QueryCrate.scope_items_at(offset: uint32): List<ScopeItem> {
    var out = List.new<ScopeItem>()
    var seen = List.new<String>()
    collect_enclosing_fn(&self.module.decls, self, offset, "", &var out, &var seen)
    collect_crate_decls(&self.module.decls, self, &var out, &var seen)
    self.collect_imported_sigs(&var out, &var seen)
    return out
}

/// As the `items` array of a completion answer.
pub fun QueryCrate.scope_items_json(offset: uint32): String {
    val items = self.scope_items_at(offset)
    val arr = JsonWriter.array()
    while it in &items {
        val o = JsonWriter.object()
        o.field_string("label", it.label.as_str())
        o.field_string("kind", it.kind.as_str())
        o.field_string("detail", it.detail.as_str())
        arr.write_raw(o.finish().as_str())
    }
    return arr.finish()
}

/// Parameters, `self` for a method, and locals live at the offset, from the
/// innermost function covering it. `owner` is the enclosing impl target, or
/// "", and types `self`.
fun collect_enclosing_fn(decls: &List<TopDecl>, crate: &QueryCrate, offset: uint32, owner: str, out: &var List<ScopeItem>, seen: &var List<String>): bool {
    while td in &decls {
        if td.decl_covers_offset(crate.file_id, offset) {
            when (td.kind) {
                Function(params, _ret, body, _pub, _u, _mut, is_static) => {
                    if owner != "" && !is_static {
                        add_item(out, seen, "self", "parameter", owner)
                    }
                    add_params(&params, crate, out, seen)
                    collect_locals(&body, crate, offset, out, seen)
                    return true
                }
                ImplBlock(methods) => return collect_enclosing_fn(&methods, crate, offset, td.name.as_str(), out, seen)
                TraitDecl(methods, _pub, _supers) => return collect_enclosing_fn(&methods, crate, offset, td.name.as_str(), out, seen)
                TraitImpl(_trait_ref, methods) => return collect_enclosing_fn(&methods, crate, offset, td.name.as_str(), out, seen)
                _ => return false
            }
        }
    }
    return false
}

/// By full extent, not the leading keyword's span.
fun TopDecl.decl_covers_offset(file_id: uint32, offset: uint32): bool {
    if self.span.file_id != file_id { return false }
    val end = self.decl_extent_end()
    if end == 0 { return false }
    return offset >= self.span.start && offset < end
}

fun add_params(params: &List<Param>, crate: &QueryCrate, out: &var List<ScopeItem>, seen: &var List<String>): void {
    while p in &params {
        add_item(out, seen, p.name.as_str(), "parameter", tyref_ptr_text(p.ty).as_str())
    }
}

/// A statement ending before the cursor contributes its binding; one
/// containing it is descended and ends the walk; one after it ends the walk.
fun collect_locals(stmts: &List<Stmt>, crate: &QueryCrate, offset: uint32, out: &var List<ScopeItem>, seen: &var List<String>): void {
    while i in 0..stmts.size() {
        val s = stmts.at(i)
        if s.span.file_id != crate.file_id {
            continue
        }
        // Transparent: a synthesized binding carries its expander's span.
        if s.is_synthesized_binding() {
            continue
        }
        if s.span.end <= offset {
            s.add_binding(crate, out, seen)
        } else if offset >= s.span.start {
            // A binding statement encloses no scope, and its own name is not
            // bound until it finishes.
            if !s.stmt_binds() { s.descend_into(crate, offset, out, seen) }
            return
        } else {
            return
        }
    }
}

/// Typed from the checked initializer, else the annotation.
fun Stmt.add_binding(crate: &QueryCrate, out: &var List<ScopeItem>, seen: &var List<String>): void {
    when (self.kind) {
        LetVal(name, ann, init) => add_item(out, seen, name.as_str(), "local", binding_type_text(ann.view(), init.view(), crate).as_str())
        LetVar(name, ann, init) => add_item(out, seen, name.as_str(), "local", binding_type_text(ann.view(), init.view(), crate).as_str())
        _ => {}
    }
}

fun Stmt.stmt_binds(): bool {
    return when (self.kind) {
        LetVal(_n, _a, _i) => true
        LetVar(_n, _a, _i) => true
        _ => false
    }
}

fun Stmt.is_synthesized_binding(): bool {
    return when (self.kind) {
        LetVal(name, _a, _i) => is_synthesized_name(name.as_str())
        LetVar(name, _a, _i) => is_synthesized_name(name.as_str())
        _ => false
    }
}

fun binding_type_text(ann: Ptr<TypeRef>?, init: Ptr<Expr>?, crate: &QueryCrate): String {
    when (init) {
        Some(p) => {
            val from_init = expr_type_text(p, crate)
            if from_init.as_str() != "" { return from_init }
        }
        None => { }
    }
    val p = ann ?: return ""
    return tyref_ptr_text(p)
}

/// Enters only the sub-block holding the cursor, adding what the construct
/// binds. The block is chosen by where it opens, not where the header ends:
/// a header may be synthesized. The header end decides only an empty block.
fun Stmt.descend_into(crate: &QueryCrate, offset: uint32, out: &var List<ScopeItem>, seen: &var List<String>): void {
    when (self.kind) {
        If(cond, then_body, else_body) => {
            if block_holds(&else_body, crate.file_id, offset, cond) {
                collect_locals(&else_body, crate, offset, out, seen)
            } else if block_holds(&then_body, crate.file_id, offset, cond) {
                collect_locals(&then_body, crate, offset, out, seen)
            }
        }
        While(cond, body) => {
            if block_holds(&body, crate.file_id, offset, cond) { collect_locals(&body, crate, offset, out, seen) }
        }
        ForEach(binder, subject, body) => {
            if block_holds(&body, crate.file_id, offset, subject) {
                add_item(out, seen, binder.as_str(), "local", "")
                collect_locals(&body, crate, offset, out, seen)
            }
        }
        When(_subject, arms) => descend_into_arms(&arms, crate, offset, out, seen)
        _ => {}
    }
}

/// The arm whose body opens latest at or before the cursor: an expanded loop
/// gives both arms the loop's span.
fun descend_into_arms(arms: &List<Arm>, crate: &QueryCrate, offset: uint32, out: &var List<ScopeItem>, seen: &var List<String>): void {
    var chosen: int64 = -1
    var chosen_at = 0
    while i in 0..arms.size() {
        val a = arms.at(i)
        val at = a.arm_opens_at(crate.file_id)
        // A tie keeps the earlier arm, the one with the author's body.
        if at <= offset {
            if chosen < 0 || at > chosen_at {
                chosen = i as int64
                chosen_at = at
            }
        }
    }
    if chosen < 0 { return }
    val arm = arms.at(chosen as uint64)
    add_pattern_bindings(unsafe { &*arm.pattern }, out, seen)
    collect_locals(&arm.body, crate, offset, out, seen)
}

/// An empty arm uses its own span; another file's never opens here.
fun Arm.arm_opens_at(file_id: uint32): uint32 {
    if self.body.size() > 0 {
        val first = self.body.at(0)
        if first.span.file_id == file_id { return first.span.start }
    }
    if self.span.file_id != file_id { return no_offset() }
    return self.span.start
}

/// Above every real offset.
fun no_offset(): uint32 { return 4294967295 }

/// Payload patterns included.
fun Pattern.add_pattern_bindings(out: &var List<ScopeItem>, seen: &var List<String>): void {
    when (self.kind) {
        Identifier(name) => add_item(out, seen, name.as_str(), "local", "")
        Variant(_name, payloads) => add_pattern_list(&payloads, out, seen)
        StructPat(_name, _fields, pats) => add_pattern_list(&pats, out, seen)
        Or(alts) => add_pattern_list(&alts, out, seen)
        _ => {}
    }
}

fun add_pattern_list(pats: &List<Pattern>, out: &var List<ScopeItem>, seen: &var List<String>): void {
    while pat in &pats {
        pat.add_pattern_bindings(out, seen)
    }
}

/// An empty block falls back to its construct's header.
fun block_holds(stmts: &List<Stmt>, file_id: uint32, offset: uint32, header: Ptr<Expr>): bool {
    if stmts.size() == 0 { return offset > expr_end(header) }
    val first = stmts.at(0)
    if first.span.file_id != file_id { return false }
    return first.span.start <= offset
}

/// "" where omitted; the pointer is NULL then.
fun tyref_ptr_text(p: Ptr<TypeRef>): String {
    if unsafe { p as uint64 } == 0 { return "" }
    return (unsafe { &*p }).tyref_to_source()
}

/// "" when absent or unnamed.
fun expr_type_text(p: Ptr<Expr>, crate: &QueryCrate): String {
    if unsafe { p as uint64 } == 0 { return "" }
    val e = unsafe { &*p }
    if e.ty.is_poison() { return "" }
    return e.ty.query_display_type(crate.sigs)
}

fun expr_end(p: Ptr<Expr>): uint32 {
    if unsafe { p as uint64 } == 0 { return 0 }
    return unsafe { &*p }.span.end
}

/// A leading `__` marks a compiler-made name.
pub fun is_synthesized_name(label: str): bool {
    if label.byte_len() < 2 { return false }
    if label.byte_at(0) != 95 { return false }
    return label.byte_at(1) == 95
}

/// The first claim wins; the walk runs innermost out, so shadowing holds.
fun add_item(out: &var List<ScopeItem>, seen: &var List<String>, label: str, kind: str, detail: str): void {
    if label == "" { return }
    // Loop expansion binds `__forit_*` and `__foropt_*`, which nobody writes.
    if is_synthesized_name(label) { return }
    while item in &seen {
        if item.as_str() == label { return }
    }
    seen.push(String.from(label))
    out.push(ScopeItem { label: String.from(label), kind: String.from(kind), detail: String.from(detail) })
}
