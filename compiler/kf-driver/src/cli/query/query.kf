// `komp query`: an editor's questions about one file, answered as JSON on
// stdout, a pure function of source and position. Offsets are bytes; the
// client converts. Queries here only parse, so they answer on a file that
// does not typecheck.

import alloc.list.*

import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import kf_shared.render_json_error
import kf_shared.cli_arg_get

extern "C" fun access(path: str, mode: int32): int32

/// One file parsed alone. `overlay_path` is the editor's staged buffer, or ""
/// for the saved file. Parse diagnostics are dropped so a half-written tail
/// does not blank the answer. The file id is constant: no answer here carries
/// a line or column.
pub fun query_parse_file(path: str, overlay_path: str): Module {
    val src = query_source(path, overlay_path)
    return parse_source(src.as_str())
}

/// `text` parsed alone, as `query_parse_file` parses a file.
pub fun parse_source(text: str): Module {
    val toks = tokenize(text, 1)
    val p = new_parser(toks)
    return p.parse_module(List.new<String>())
}

/// An unreadable overlay is an error, not an empty document: an empty answer
/// looks correct and hides the plugin bug.
fun overlay_is_readable(overlay_path: str): bool {
    return unsafe { access(overlay_path, 4) } == 0
}

/// The staged buffer stands in for `path`, which is still where the crate
/// walk finds the file.
fun query_source(path: str, overlay_path: str): String {
    if overlay_path == "" { return read_file(path) }
    return read_file(overlay_path)
}

/// `offset_arg` is "" for queries without a position, `overlay_path` "" for
/// an unstaged buffer. Returns an exit code.
pub fun run_query(kind: str, path: str, offset_arg: str, name_arg: str, overlay_path: str): int32 {
    if overlay_path != "" && !overlay_is_readable(overlay_path) {
        val message = "cannot read the overlay file `${overlay_path}`"
        val json = render_json_error(message.as_str())
        runtime_println(json.as_str())
        return 1
    }
    when kind {
        "symbols" => {
            val m = query_parse_file(path, overlay_path)
            val json = render_symbols_json(path, &m)
            runtime_println(json.as_str())
            return 0
        }
        "folding" => {
            val m = query_parse_file(path, overlay_path)
            val json = render_folding_json(path, &m)
            runtime_println(json.as_str())
            return 0
        }
        "hover" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("hover needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_hover_query(path, parse_byte_offset(offset_arg), overlay_path)
        }
        "inlays" => return run_inlays_query(path, overlay_path)
        "tokens" => return run_tokens_query(path, overlay_path)
        "references" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("references needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_references_query(path, parse_byte_offset(offset_arg), overlay_path)
        }
        "signature" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("signature needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_signature_query(path, parse_byte_offset(offset_arg), overlay_path)
        }
        "rename" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("rename needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_rename_query(path, parse_byte_offset(offset_arg), name_arg, overlay_path)
        }
        "completion" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("completion needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_completion_query(path, parse_byte_offset(offset_arg), overlay_path)
        }
        "selection" => {
            if !is_byte_offset(offset_arg) {
                val json = render_json_error("selection needs a byte offset: --offset <N>")
                runtime_println(json.as_str())
                return 1
            }
            return run_selection_query(path, parse_byte_offset(offset_arg), overlay_path)
        }
        _ => { }
    }
    val message = "unknown query `${kind}`; known queries: symbols, folding, hover, inlays, selection, signature, references, tokens, completion, rename"
    val json = render_json_error(message.as_str())
    runtime_println(json.as_str())
    return 1
}

/// A non-empty run of digits and nothing else.
pub fun is_byte_offset(text: str): bool {
    val n = text.byte_len()
    if n == 0 { return false }
    var i = 0
    while i < n {
        val b = text.byte_at(i)
        if b < 48 || b > 57 { return false }
        i = i + 1
    }
    return true
}

pub fun parse_byte_offset(text: str): uint32 {
    val n = text.byte_len()
    var value: uint64 = 0
    var i: uint64 = 0
    while i < n {
        value = value * 10 + ((text.byte_at(i) - 48) as uint64)
        i = i + 1
    }
    return value as uint32
}

/// The byte past a declaration's last token, or its recorded span for a
/// synthesized or poisoned one.
pub fun TopDecl.decl_extent_end(): uint32 {
    if self.decl_end > self.span.start { return self.decl_end }
    return self.span.end
}

/// `komp query <what>` and its flags; `--overlay` is optional everywhere.
pub fun dispatch_query(nargs: int32): int32 {
    var file = ""
    var offset = ""
    var new_name = ""
    var overlay = ""
    var i = 2
    while i + 1 < nargs {
        val flag = cli_arg_get(i)
        val value = cli_arg_get(i + 1)
        when flag {
            "--file" => file = String.from(value)
            "--offset" => offset = String.from(value)
            "--new-name" => new_name = String.from(value)
            "--overlay" => overlay = String.from(value)
            // Read by the crate loader.
            "--crate" => { }
            _ => return query_usage()
        }
        i = i + 2
    }
    // A flag with no value, or no `--file`.
    if i != nargs { return query_usage() }
    if file.as_str() == "" { return query_usage() }
    return run_query(cli_arg_get(1), file.as_str(), offset.as_str(), new_name.as_str(), overlay.as_str())
}

fun query_usage(): int32 {
    runtime_println("usage: komp query <what> --file <path> [--offset <N>] [--new-name <name>] [--overlay <path>]")
    return 1
}
