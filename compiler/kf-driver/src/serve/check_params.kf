// What a `check` request names: one crate, shaped as `komp metadata` lists
// it, and the directory holding its dependencies' interfaces.

import alloc.list.*
import json.reader.*

pub struct CheckParams {
    pub val target_dir: String
    /// Crates whose interface is written from source, staged text included,
    /// before the check, dependencies first: the checked crate and each one
    /// after reads them from there instead of the target directory.
    pub val sources: List<SourceCrate>
    pub val name: String
    pub val root: String
    /// Every interface to load, dependencies first.
    pub val loads: List<String>
    /// `name=level` rows.
    pub val lints: List<String>
    /// `name.key=value` rows.
    pub val lint_options: List<String>
}

/// `null` when a field is missing or has the wrong type. Fields a
/// `komp metadata` crate carries beyond these are passed over.
pub fun read_check_params(line: str): CheckParams? {
    var reader = params_of(line) ?: return null
    if !reader.begin_object() { return null }
    var target_dir = String.from("")
    var sources = List.new<SourceCrate>()
    var name = String.from("")
    var root = String.from("")
    var loads = List.new<String>()
    var lints = List.new<String>()
    var lint_options = List.new<String>()
    while reader.object_has_next() {
        val key = reader.read_key()
        when key.as_str() {
            "target_dir" => target_dir = reader.read_string()
            "sources" => {
                val read = read_source_crates(&var reader)
                if read.is_none() { return null }
                sources = read ?: List.new<SourceCrate>()
            }
            "crate" => {
                if !reader.begin_object() { return null }
                while reader.object_has_next() {
                    val field = reader.read_key()
                    when field.as_str() {
                        "name" => name = reader.read_string()
                        "root" => root = reader.read_string()
                        "loads" => loads = read_strings(&var reader)
                        "lints" => lints = read_lint_rows(&var reader)
                        "lint_options" => lint_options = read_option_rows(&var reader)
                        _ => reader.skip_value()
                    }
                }
            }
            _ => reader.skip_value()
        }
    }
    if reader.has_error() || target_dir.is_empty() || name.is_empty() || root.is_empty() { return null }
    return Option.Some(CheckParams {
        target_dir: target_dir, sources: sources, name: name, root: root, loads: loads, lints: lints,
        lint_options: lint_options
    })
}

/// A crate of `sources`, shaped as `komp metadata` lists it.
@derive(Clone)
pub struct SourceCrate {
    pub val name: String
    pub val root: String
    pub val loads: List<String>
}

/// `null` when an entry has no name or root.
fun read_source_crates(reader: &var JsonReader): List<SourceCrate>? {
    var out = List.new<SourceCrate>()
    if !reader.begin_array() { return null }
    while reader.array_has_next() {
        if !reader.begin_object() { return null }
        var name = String.from("")
        var root = String.from("")
        var loads = List.new<String>()
        while reader.object_has_next() {
            val field = reader.read_key()
            when field.as_str() {
                "name" => name = reader.read_string()
                "root" => root = reader.read_string()
                "loads" => loads = read_strings(reader)
                _ => reader.skip_value()
            }
        }
        if name.is_empty() || root.is_empty() { return null }
        out.push(SourceCrate { name: name, root: root, loads: loads })
    }
    return Option.Some(out)
}

fun read_strings(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() { out.push(reader.read_string()) }
    return out
}

/// Each entry a `name=level` string or a `{"name", "level"}` object.
fun read_lint_rows(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() {
        if reader.peek_kind() != JsonKind.Object {
            out.push(reader.read_string())
            continue
        }
        var name = String.from("")
        var level = String.from("")
        val _opened = reader.begin_object()
        while reader.object_has_next() {
            val field = reader.read_key()
            when field.as_str() {
                "name" => name = reader.read_string()
                "level" => level = reader.read_string()
                _ => reader.skip_value()
            }
        }
        out.push("${name}=${level}")
    }
    return out
}

/// Each entry a `{"name", "key", "value"}` object; the value a string or a number.
fun read_option_rows(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() {
        var name = String.from("")
        var key = String.from("")
        var value = String.from("")
        if !reader.begin_object() { return out }
        while reader.object_has_next() {
            val field = reader.read_key()
            when field.as_str() {
                "name" => name = reader.read_string()
                "key" => key = reader.read_string()
                "value" => value = read_option_value(reader)
                _ => reader.skip_value()
            }
        }
        out.push("${name}.${key}=${value}")
    }
    return out
}

fun read_option_value(reader: &var JsonReader): String {
    if reader.peek_kind() == JsonKind.Number { return "${reader.read_int64()}" }
    return reader.read_string()
}
