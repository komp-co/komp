import core.assert.assert_eq

fun greeted(): ServeSession {
    var session = ServeSession.new()
    val _hello = session.answer("{\"id\":0,\"method\":\"hello\",\"params\":{\"protocol\":1}}")
    return session
}

@test
fun hello_names_the_protocol_and_compiler(): void {
    var session = ServeSession.new()
    val line = session.answer("{\"id\":1,\"method\":\"hello\",\"params\":{\"protocol\":1}}")
    assert_eq(line.as_str().starts_with("{\"id\":1,\"result\":{\"protocol\":1,\"compiler\":"), true, "handshake")
}

@test
fun an_unknown_protocol_is_refused(): void {
    var session = ServeSession.new()
    val line = session.answer("{\"id\":1,\"method\":\"hello\",\"params\":{\"protocol\":99}}")
    assert_eq(line.as_str().contains("\"code\":\"unsupported_protocol\""), true, "refused")
}

@test
fun a_request_before_hello_is_not_ready(): void {
    var session = ServeSession.new()
    val line = session.answer("{\"id\":1,\"method\":\"shutdown\"}")
    assert_eq(line.as_str().contains("\"code\":\"not_ready\""), true, "hello first")
}

@test
fun an_unknown_method_is_named(): void {
    var session = greeted()
    val line = session.answer("{\"id\":2,\"method\":\"compile\"}")
    assert_eq(line.as_str().contains("\"code\":\"unknown_method\""), true, "unknown")
}

@test
fun a_line_that_is_not_json_is_a_parse_error(): void {
    var session = greeted()
    assert_eq(session.answer("check please").as_str().contains("\"id\":null,\"error\":{\"code\":\"parse_error\""),
              true, "parse error")
}

@test
fun stage_without_a_path_is_invalid(): void {
    var session = greeted()
    val line = session.answer("{\"id\":3,\"method\":\"stage\",\"params\":{\"text\":\"x\"}}")
    assert_eq(line.as_str().contains("\"code\":\"invalid_params\""), true, "a path is required")
}

@test
fun check_without_a_crate_is_invalid(): void {
    var session = greeted()
    val line = session.answer("{\"id\":4,\"method\":\"check\",\"params\":{\"target_dir\":\"/t\"}}")
    assert_eq(line.as_str().contains("\"code\":\"invalid_params\""), true, "a crate is required")
}

@test
fun shutdown_answers_null_and_stops(): void {
    var session = greeted()
    val line = session.answer("{\"id\":5,\"method\":\"shutdown\"}")
    assert_eq(line.as_str() == "{\"id\":5,\"result\":null}" && session.stopping, true, "stops after answering")
}

@test
fun symbols_answer_from_staged_text(): void {
    var session = greeted()
    val stage = String.from("{\"id\":6,\"method\":\"stage\",\"params\":") +
        "{\"path\":\"/nowhere/a.kf\",\"text\":\"fun f(): int32 { return 1 }\"}}"
    val _staged = session.answer(stage.as_str())
    val line = session.answer("{\"id\":7,\"method\":\"symbols\",\"params\":{\"path\":\"/nowhere/a.kf\"}}")
    assert_eq(line.as_str().contains("\"name\":\"f\",\"kind\":\"function\""), true, "the staged function")
}

@test
fun a_file_neither_staged_nor_on_disk_is_named(): void {
    var session = greeted()
    val line = session.answer("{\"id\":8,\"method\":\"folding\",\"params\":{\"path\":\"/nowhere/b.kf\"}}")
    assert_eq(line.as_str().contains("\"code\":\"no_such_file\""), true, "no such file")
}

@test
fun selection_needs_an_offset(): void {
    var session = greeted()
    val stage = "{\"id\":9,\"method\":\"stage\",\"params\":{\"path\":\"/nowhere/c.kf\",\"text\":\"\"}}"
    val _staged = session.answer(stage.as_str())
    val line = session.answer("{\"id\":10,\"method\":\"selection\",\"params\":{\"path\":\"/nowhere/c.kf\"}}")
    assert_eq(line.as_str().contains("\"code\":\"invalid_params\""), true, "an offset is required")
}

@test
fun hover_without_crates_is_invalid(): void {
    var session = greeted()
    val line = session.answer("{\"id\":11,\"method\":\"hover\",\"params\":{\"path\":\"/nowhere/a.kf\",\"offset\":0}}")
    assert_eq(line.as_str().contains("\"code\":\"invalid_params\""), true, "crates are required")
}

@test
fun typed_params_keep_the_crates_in_order(): void {
    val line = String.from("{\"id\":12,\"method\":\"hover\",\"params\":{\"path\":\"/w/a/src/lib.kf\",\"offset\":4,") +
        "\"crates\":[{\"name\":\"core\",\"root\":\"/k/core\"},{\"name\":\"a\",\"root\":\"/w/a\"}]}}"
    val params = read_typed_params(line.as_str())
    assert_eq(params?.key ?: "", "core=/k/core\na=/w/a\n", "dependencies first")
}

@test
fun a_position_question_without_an_offset_is_invalid(): void {
    var session = greeted()
    val request = String.from("{\"id\":13,\"method\":\"signature\",\"params\":{\"path\":\"/w/a.kf\",") +
        "\"crates\":[{\"name\":\"a\",\"root\":\"/w\"}]}}"
    val line = session.answer(request.as_str())
    assert_eq(line.as_str().contains("\"code\":\"invalid_params\""), true, "signature asks about a position")
}

@test
fun typed_params_read_a_new_name(): void {
    val line = String.from("{\"id\":14,\"method\":\"rename\",\"params\":{\"path\":\"/w/a.kf\",\"offset\":4,") +
        "\"new_name\":\"scaled\",\"crates\":[{\"name\":\"a\",\"root\":\"/w\"}]}}"
    val params = read_typed_params(line.as_str())
    assert_eq(params?.new_name ?: "", "scaled", "rename's new name")
}

@test
fun typed_params_leave_a_missing_offset_negative(): void {
    val line = String.from("{\"id\":15,\"method\":\"tokens\",\"params\":{\"path\":\"/w/a.kf\",") +
        "\"crates\":[{\"name\":\"a\",\"root\":\"/w\"}]}}"
    val params = read_typed_params(line.as_str())
    assert_eq(params?.offset ?: 0, -1, "tokens need no offset")
}

@test
fun tokens_need_no_offset(): void {
    assert_eq(needs_offset("tokens"), false, "tokens cover the whole file")
}
