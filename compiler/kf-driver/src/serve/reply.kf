// The two shapes of a `kflatc serve` answer, one JSON object per line.

import json.writer.*

/// `id` and `result` are JSON text.
pub fun result_line(id: str, result: str): String {
    val writer = JsonWriter.object()
    writer.field_raw("id", id)
    writer.field_raw("result", result)
    return writer.finish()
}

/// `code` is one of the protocol's error names, which clients match on;
/// `message` is for people.
pub fun error_line(id: str, code: str, message: str): String {
    val writer = JsonWriter.object()
    writer.field_raw("id", id)
    writer.key("error")
    writer.begin_object()
    writer.field_string("code", code)
    writer.field_string("message", message)
    writer.end_object()
    return writer.finish()
}
