import core.assert.assert_eq
import json.reader.JsonReader

@test
fun a_request_keeps_its_integer_id(): void {
    val request = parse_request("{\"id\":3,\"method\":\"check\"}")
    assert_eq(request?.id ?: "", "3", "the id is its JSON text")
}

@test
fun a_request_keeps_its_string_id_quoted(): void {
    val request = parse_request("{\"id\":\"a\",\"method\":\"check\"}")
    assert_eq(request?.id ?: "", "\"a\"", "echoed as JSON")
}

@test
fun a_request_without_an_id_answers_to_null(): void {
    val request = parse_request("{\"method\":\"shutdown\"}")
    assert_eq(request?.id ?: "", "null", "no id")
}

@test
fun a_line_without_a_method_is_no_request(): void {
    assert_eq(parse_request("{\"id\":1}").is_none(), true, "a method is required")
}

@test
fun params_are_found_after_other_fields(): void {
    var reader = params_of("{\"id\":1,\"method\":\"hello\",\"params\":{\"protocol\":1}}") ?: JsonReader.new("")
    assert_eq(reader.begin_object(), true, "the reader stands at the params object")
}
