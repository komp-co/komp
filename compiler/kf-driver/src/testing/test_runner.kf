// Data transforms for `komp test`: discover @test decls, generate the test
// main, and parse it back. Orchestration is in multi_crate.kf.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser


/// In discovery order.
pub fun collect_test_names(modules: List<Module>): List<String> {
    var out = List.new<String>()
    while m in &modules {
        while td in &m.decls {
            val is_test = (&td).has_annotation("test")
            if is_test {
                out.push(td.name.as_string())
            }
        }
    }
    return out
}

/// The generated main is its own module and must import each module that
/// declares a test.
pub fun gen_test_main_imports(modules: &List<Module>): String {
    var out = ""
    var seen = List.new<String>()
    while m in &modules {
        while td in &m.decls {
            if (&td).has_annotation("test") {
                val path = td.module_path.as_string()
                if !path.as_str().equals("") && !import_seen(&seen, path.as_str()) {
                    out.append("import ")
                    out.append(path.as_str())
                    out.append(".*\n")
                    seen.push(path)
                }
            }
        }
    }
    return out
}

fun import_seen(seen: &List<String>, target: str): bool {
    while item in &seen {
        if item.as_str().equals(target) { return true }
    }
    return false
}

pub fun gen_test_main_src(names: List<String>): String {
    val n_str = "${names.size()}"
    var parts = List.new<String>()
    // Only `runtime_println` is declared; test files import core.assert.
    parts.push(String.from("extern \"C\" fun runtime_println(s: str): void\n"))
    parts.push(String.from("extern \"C\" fun kf_test_report(passed: int32, failed: int32): void\n"))
    parts.push(String.from("extern \"C\" fun kf_test_queue(name: str): void\n"))
    parts.push(String.from("extern \"C\" fun kf_test_run_queued(): int32\n"))
    parts.push(String.from("extern \"C\" fun kf_test_queued_count(): int32\n"))
    parts.push(gen_filter_helpers())
    parts.push(String.from("fun main(): int32 {\n"))
    parts.push(String.from("    val __f = __test_filter()\n"))
    parts.push(String.from("    val __one = __test_run_one()\n"))
    // Child half: run one test here; the parent reads the exit code.
    parts.push(gen_child_arms(names))
    parts.push(String.from("    runtime_println(\"running "))
    parts.push(n_str.clone())
    parts.push(String.from(" tests\")\n"))
    while nm in &names {
        parts.push("    if __test_matches(__f, \"${nm}\") { kf_test_queue(\"${nm}\") }\n")
    }
    // Run in order, several at a time; the runtime prints each result.
    parts.push(String.from("    val __failed = kf_test_run_queued()\n"))
    parts.push(String.from("    val __ran = kf_test_queued_count() - __failed\n"))
    parts.push(String.from("    runtime_println(\"\")\n"))
    // A filter matching nothing fails; a crate with no tests passes.
    parts.push(String.from("    if __test_filter_active(__f) && __ran == 0 && __failed == 0 {\n"))
    parts.push(String.from("        runtime_println(\"test result: FAILED — the filter matched no test\")\n"))
    parts.push(String.from("        return 1\n"))
    parts.push(String.from("    }\n"))
    parts.push(String.from("    kf_test_report(__ran, __failed)\n"))
    parts.push(String.from("    if __failed > 0 { return 1 }\n"))
    parts.push(String.from("    return 0\n}\n"))
    return join_parts(parts)
}

/// `--run-test <name>` runs one test and returns, emitted before the parent
/// loop so a child never spawns.
fun gen_child_arms(names: List<String>): String {
    var parts = List.new<String>()
    parts.push(String.from("    if __test_filter_active(__one) {\n"))
    while nm in &names {
        parts.push(String.from("        if __test_is(__one, \""))
        parts.push(nm.clone())
        parts.push(String.from("\") {\n"))
        parts.push(String.from("            "))
        parts.push(nm.clone())
        parts.push(String.from("()\n"))
        parts.push(String.from("            return 0\n"))
        parts.push(String.from("        }\n"))
    }
    // A stale name fails.
    parts.push(String.from("        runtime_println(\"test result: FAILED — no such test\")\n"))
    parts.push(String.from("        return 1\n"))
    parts.push(String.from("    }\n"))
    return join_parts(parts)
}

/// `--filter <substring>`, at run time so filtering needs no rebuild.
fun gen_filter_helpers(): String {
    var parts = List.new<String>()
    parts.push(String.from("extern \"C\" fun kf_arg_count(): int32\n"))
    parts.push(String.from("extern \"C\" fun kf_arg_get(i: int32): str\n"))
    parts.push(String.from("extern \"C\" fun (s: str).byte_len(): uint64\n"))
    parts.push(String.from("extern \"C\" fun (s: str).byte_at(i: uint64): uint8\n"))
    parts.push(String.from("fun __test_filter(): str {\n"))
    parts.push(String.from("    val n = kf_arg_count()\n"))
    parts.push(String.from("    var i: int32 = 0\n"))
    parts.push(String.from("    while i < n {\n"))
    parts.push(String.from("        if kf_arg_get(i) == \"--filter\" {\n"))
    parts.push(String.from("            if i + 1 < n { return kf_arg_get(i + 1) }\n"))
    parts.push(String.from("        }\n"))
    parts.push(String.from("        i = i + 1\n"))
    parts.push(String.from("    }\n"))
    parts.push(String.from("    return \"\"\n"))
    parts.push(String.from("}\n"))
    parts.push(String.from("fun __test_matches(needle: str, name: str): bool {\n"))
    parts.push(String.from("    val nn = needle.byte_len()\n"))
    parts.push(String.from("    if nn == 0 { return true }\n"))
    parts.push(String.from("    val hn = name.byte_len()\n"))
    parts.push(String.from("    if hn < nn { return false }\n"))
    parts.push(String.from("    var i: uint64 = 0\n"))
    parts.push(String.from("    while i + nn <= hn {\n"))
    parts.push(String.from("        var hit = true\n"))
    parts.push(String.from("        var j: uint64 = 0\n"))
    parts.push(String.from("        while j < nn {\n"))
    parts.push(String.from("            if name.byte_at(i + j) != needle.byte_at(j) { hit = false }\n"))
    parts.push(String.from("            j = j + 1\n"))
    parts.push(String.from("        }\n"))
    parts.push(String.from("        if hit { return true }\n"))
    parts.push(String.from("        i = i + 1\n"))
    parts.push(String.from("    }\n"))
    parts.push(String.from("    return false\n"))
    parts.push(String.from("}\n"))
    parts.push(String.from("fun __test_filter_active(f: str): bool {\n"))
    parts.push(String.from("    return f.byte_len() > 0\n"))
    parts.push(String.from("}\n"))
    parts.push(String.from("fun __test_run_one(): str {\n"))
    parts.push(String.from("    val n = kf_arg_count()\n"))
    parts.push(String.from("    var i: int32 = 0\n"))
    parts.push(String.from("    while i < n {\n"))
    parts.push(String.from("        if kf_arg_get(i) == \"--run-test\" {\n"))
    parts.push(String.from("            if i + 1 < n { return kf_arg_get(i + 1) }\n"))
    parts.push(String.from("        }\n"))
    parts.push(String.from("        i = i + 1\n"))
    parts.push(String.from("    }\n"))
    parts.push(String.from("    return \"\"\n"))
    parts.push(String.from("}\n"))
    // Exact, not substring.
    parts.push(String.from("fun __test_is(want: str, name: str): bool {\n"))
    parts.push(String.from("    val wn = want.byte_len()\n"))
    parts.push(String.from("    if wn != name.byte_len() { return false }\n"))
    parts.push(String.from("    var i: uint64 = 0\n"))
    parts.push(String.from("    while i < wn {\n"))
    parts.push(String.from("        if want.byte_at(i) != name.byte_at(i) { return false }\n"))
    parts.push(String.from("        i = i + 1\n"))
    parts.push(String.from("    }\n"))
    parts.push(String.from("    return true\n"))
    parts.push(String.from("}\n"))
    return join_parts(parts)
}

// In place: `__kf_v2_str_concat` copies the accumulator per fragment and
// frees none.
fun join_parts(parts: List<String>): String {
    var acc = ""
    while part in &parts {
        acc.append(part.as_str())
    }
    return acc
}

pub fun parse_test_main(src: str, smap: Ptr<SourceMap>): Module {
    val fid = unsafe { smap.add_file(new_source_file(String.from("<test-main>"), String.from(src))) }
    val toks = tokenize(src, fid)
    val p = new_parser(toks)
    var path = List.new<String>()
    path.push(String.from("test_main"))
    return p.parse_module(path)
}

/// Renames any `fun main` to `__user_main`, clear of the generated main.
pub fun rename_main_decls(modules: &var List<Module>): void {
    var mi = 0
    while mi < modules.size() {
        var m = *modules.at(mi)
        var di = 0
        while di < m.decls.size() {
            var td = *m.decls.at(di)
            if is_fn_named_main(td) {
                td.name = intern("__user_main")
                m.decls.set(di, td)
            }
            di = di + 1
        }
        modules.set(mi, m)
        mi = mi + 1
    }
}

fun is_fn_named_main(td: TopDecl): bool {
    val nm = td.name.as_str()
    val is_main = nm.equals("main")
    if !is_main { return false }
    return when (td.kind) {
        Function(_, _, _, _, _, _, _) => true
        _ => false
    }
}
