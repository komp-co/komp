// `kflatc lints`: every lint, by group, at the level this command line's
// configuration gives it.

import alloc.list.*

import kf_core.diagnostic.*

/// One group heading per group, then a row per lint: its name, its level
/// and, when configuration changed that, its default, then what it reports;
/// under it, a row for each option it takes, alike.
pub fun lint_table(cfg: &LintConfig): String {
    val all = lint_registry()
    var width: uint64 = 0
    while info in &all {
        if info.name.byte_len() > width { width = info.name.byte_len() }
    }
    var out = String.from("")
    val groups = lint_groups()
    while group in &groups {
        var heading = false
        while info in &all {
            if info.group.as_str() != group.as_str() { continue }
            if !heading {
                if !out.is_empty() { out.append("\n") }
                out.append("${group}\n")
                heading = true
            }
            val level = lint_level_name(cfg.configured_level(info.name.as_str()))
            val default = lint_level_name(info.default)
            var cell = String.from(level)
            if level != default { cell.append(" (default ${default})") }
            out.append("  ")
            out.append(info.name.as_str())
            while _ in info.name.byte_len()..width + 2 { out.push_byte(32) }
            out.append(cell.as_str())
            while _ in cell.byte_len()..22 { out.push_byte(32) }
            out.append("${info.description}\n")
            while option in &info.options {
                val value = cfg.options.get(info.name.as_str(), option.key.as_str())
                var cell = "${option.key} = ${value}"
                if value != option.default { cell.append(" (default ${option.default})") }
                out.append("      ")
                out.append(cell.as_str())
                while _ in cell.byte_len()..width + 18 { out.push_byte(32) }
                out.append("${option.description}\n")
            }
        }
    }
    return out
}

/// Prints the table for the configuration on the command line; exit 1, and
/// the problems, when that configuration names no lint or level.
pub fun print_lint_table(): int32 {
    var diags = List.new<Diagnostic>()
    val cfg = project_lint_config(&var diags)
    while d in &diags { println("error: ${d.primary.message}") }
    if !diags.is_empty() { return 1 }
    print(lint_table(&cfg).as_str())
    return 0
}
