// Orchestrates Parse, Assemble, Resolve, TypeCheck, Mono, Lower and Codegen.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*


import kf_resolve.*
import kf_typecheck.typecheck_module_with_imports
import kf_mono.mono_module
import kf_lower.*
import kf_lower.ownership.borrow_liveness_module
import kf_lower.ownership.borrow_exclusivity_module
import kf_lower.ownership.check_generic_copies
import kf_lower.ownership.check_generic_copies
import kf_codegen.emit_module_kind
import kf_codegen.emit_module_unit
import kf_driver.cli.print_json_diag
import kf_driver.cli.color_enabled
import kf_codegen.emit.symbols.qualify_type_symbols
import kf_codegen.emit.symbols.qualify_function_symbols
import kf_shared.normalized_path

extern "C" fun kf_warnings_are_muted(): int32
extern "C" fun kf_local_root(): str
extern "C" fun kf_set_local_root(path: str): void

// Shared by pointer. A struct because `alloc<int32>` mis-renders the
// primitive. Counts Error diagnostics so build and run can refuse to emit C.
pub struct ErrCount {
    pub var n: int32
}

/// Filled by the assembler, read by the diagnostic renderer.
/// Owned by the caller; the passes it is handed to borrow it.
pub fun fresh_source_map(): Box<SourceMap> {
    return Box.new(new_source_map())
}

/// The whole pipeline, from a merged module to one C translation unit.
pub mutating fun Module.run_pipeline(is_bin: bool, errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): String {
    return self.compile_module(is_bin, errp, smap)
}

pub mutating fun Module.compile_module(is_bin: bool, errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): String {
    self.run_resolve_typecheck(errp, smap)
    // Later passes assume a well-typed tree; the diagnostics are printed and
    // the caller refuses to write output.
    if unsafe { errp.n } != 0 { return "" }
    val list_name = self.lang_type_name(lang_list_key())
    self.report_template_copies(errp, smap)
    mono_module(self)
    report_lower_diags(lower_module(self, smap, list_name), self, errp, smap)
    trim_variant_binders(self)
    // A program is a closed world; a library's exports are its API, and
    // `drop_unreachable` no-ops without a `main`.
    if is_bin { drop_unreachable(self) }
    return emit_module_kind(self, is_bin)
}

/// Separate compilation: the same passes plus crate qualification, emitting a
/// unit that includes kf_runtime.h. Type renames land before Mono so every
/// mangle is qualified; function renames after Lower via mangled_callee.
pub mutating fun Module.compile_module_separate(is_bin: bool, errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): String {
    self.run_separate_passes(errp, smap)
    return emit_module_unit(self, is_bin)
}

/// Without emission, for callers rendering per-crate artifacts.
pub mutating fun Module.run_separate_passes(errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): void {
    self.run_interface_passes(errp, smap)
    self.run_separate_after_typecheck(errp, smap)
}

// The interface boundary: signatures and inferred public types are complete,
// and Mono has not yet stripped templates.
pub mutating fun Module.run_interface_passes(errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): void {
    self.run_resolve_typecheck(errp, smap)
}

pub mutating fun Module.run_separate_after_typecheck(errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): void {
    // Later passes assume a well-typed tree.
    if unsafe { errp.n } != 0 { return }
    qualify_type_symbols(self)
    val list_name = self.lang_type_name(lang_list_key())
    self.report_template_copies(errp, smap)
    mono_module(self)
    report_lower_diags(lower_module(self, smap, list_name), self, errp, smap)
    qualify_function_symbols(self)
    trim_variant_binders(self)
}

// CONSTRAINT: before Mono, which replaces each template with its instances.
fun Module.report_template_copies(errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): void {
    val lints: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *lints = List.new<Diagnostic>() }
    val clone_trait = self.lang_trait_name(lang_clone_key())
    check_generic_copies(self, smap, clone_trait, self.lang_trait_name(lang_copy_key()), lints)
    report_lower_diags(unsafe { *lints }, self, errp, smap)
}

// Import validation, Resolve and TypeCheck, shared by the unity and separate
// paths. Lints take their configured level; what survives is printed, and
// only errors are counted.
mutating fun Module.run_resolve_typecheck(errp: Ptr<ErrCount>, smap: Ptr<SourceMap>): void {
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    val import_diags = validate_imports_per_module(self, callers, targets, names, smap)
    var nerr = 0
    while d in &import_diags {
        if d.diag_is_error() { nerr = nerr + 1 }
        d.print_diag(smap)
    }

    var table = new_decl_table()
    resolve_module(self, &var table)
    val checked = typecheck_module_with_imports(self, &var table, callers, targets, names)
    val tc_diags = apply_lint_levels(checked, self, &build_lint_config())
    while d in &tc_diags {
        if d.diag_is_error() { nerr = nerr + 1 }
        d.print_diag(smap)
    }
    unsafe { errp.n = errp.n + nerr }
}

/// Resolve and TypeCheck only, for `komp check`. Returns the error count.
pub mutating fun Module.check_module(smap: Ptr<SourceMap>): int32 {
    return self.check_module_leveled(smap, &new_lint_config())
}

pub mutating fun Module.check_module_leveled(smap: Ptr<SourceMap>, cfg: &LintConfig): int32 {
    val diags = self.checked_diagnostics(smap, cfg)
    while d in &diags { d.print_diag(smap) }
    return count_errors(&diags)
}

pub mutating fun Module.check_module_json_leveled(smap: Ptr<SourceMap>, cfg: &LintConfig): int32 {
    val diags = self.checked_diagnostics(smap, cfg)
    while d in &diags { d.print_json_diag(smap) }
    return count_errors(&diags)
}

/// What `check` reports, in order: imports, then Resolve and TypeCheck at
/// their configured levels, then borrow liveness, which runs only when
/// nothing before it was an error.
pub mutating fun Module.checked_diagnostics(smap: Ptr<SourceMap>, cfg: &LintConfig): List<Diagnostic> {
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    var out = validate_imports_per_module(self, callers, targets, names, smap)
    var table = new_decl_table()
    resolve_module(self, &var table)
    val diags = apply_lint_levels(typecheck_module_with_imports(self, &var table, callers, targets, names), self, cfg)
    while d in &diags { out.push(d.clone()) }
    if count_errors(&out) > 0 { return out }
    alpha_rename_module(self)
    val live: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *live = List.new<Diagnostic>() }
    borrow_liveness_module(self, live)
    borrow_exclusivity_module(self, live)
    while i in 0..unsafe { live.size() } { out.push(unsafe { live.at(i) }.clone()) }
    return out
}

pub fun count_errors(diags: &List<Diagnostic>): int32 {
    var errors = 0
    while d in &diags {
        if d.diag_is_error() { errors = errors + 1 }
    }
    return errors
}

/// As `check_module_json`, returning the diagnostics for `komp fix`. Borrow
/// liveness reports no fixes and is not run.
pub mutating fun Module.collect_module_diags(smap: Ptr<SourceMap>): List<Diagnostic> {
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    var out = validate_imports_per_module(self, callers, targets, names, smap)
    var table = new_decl_table()
    resolve_module(self, &var table)
    val diags = typecheck_module_with_imports(self, &var table, callers, targets, names)
    while diag in &diags {
        out.push(diag)
    }
    return out
}

fun Diagnostic.diag_is_error(): bool {
    return when (self.severity) {
        Error => true
        _ => false
    }
}

/// Through kf-core's renderer, colored per `color_enabled`. A muted warning
/// is skipped; errors never are.
pub fun Diagnostic.print_diag(smap: Ptr<SourceMap>): void {
    if !self.diag_is_error() {
        if unsafe { kf_warnings_are_muted() } != 0 { return }
        if self.warning_belongs_to_a_dependency(smap) { return }
    }
    val text = render_colored(self, smap, color_enabled())
    runtime_println(text.as_str())
}

/// Warnings about other crates are hidden. Canonicalized, since a command
/// takes a root like `.`.
pub fun note_crate_being_built(root: str): void {
    unsafe { kf_set_local_root(normalized_path(root).as_str()) }
}

/// A consumer cannot edit its dependencies. Kept visible: errors (filtered by
/// the caller), a diagnostic without a file, and everything when no root was
/// set.
fun Diagnostic.warning_belongs_to_a_dependency(smap: Ptr<SourceMap>): bool {
    val root = unsafe { kf_local_root() }
    if root.byte_len() == 0 { return false }
    val path = unsafe { smap.file_path_of(self.primary.span.file_id) }
    if path.as_str().equals("") { return false }
    // CONSTRAINT: normalized: `komp check .` yields `./src/main.kf`.
    return !normalized_path(path.as_str()).as_str().starts_with(root)
}

