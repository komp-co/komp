import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.diagnostic.*

@test
fun nothing_found_says_so(): void {
    assert_eq(lint_summary(&List.new<Diagnostic>()).as_str(), "lint: no problems\n", "one line")
}

@test
fun each_lint_is_counted_by_name(): void {
    var diags = List.new<Diagnostic>()
    diags.push(lint_at("wildcard_import", no_span(), String.from("a")))
    diags.push(lint_at("unused_import", no_span(), String.from("b")))
    diags.push(lint_at("unused_import", no_span(), String.from("c")))
    val expected = "lint: 0 errors, 3 warnings\n  unused_import    2\n  wildcard_import  1\n"
    assert_eq(lint_summary(&diags).as_str(), expected, "sorted by name, counts aligned")
}

@test
fun an_error_without_a_lint_is_counted_as_an_error(): void {
    var diags = List.new<Diagnostic>()
    diags.push(error_at(no_span(), "mismatched types"))
    assert_eq(lint_summary(&diags).as_str(), "lint: 1 error, 0 warnings\n", "no lint row for it")
}
