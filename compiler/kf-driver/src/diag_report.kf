// What happens to a pass's diagnostics: printed, promoted or dropped by lint
// level.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.diagnostic.*
import kf_shared.compiler_warnings_quiet

/// Adds the errors among them to `errors`.
pub fun report_lower_diags(diags: List<Diagnostic>, m: &Module, errors: &var Diagnostics, smap: Ptr<SourceMap>): void {
    var nerr = 0
    val leveled = apply_lint_levels(diags, m, &build_lint_config())
    val quiet = compiler_warnings_quiet()
    while d in &leveled {
        if d.diag_is_error() { nerr = nerr + 1 }
        // `-q` silences advice; a Deny lint or an error is not advice.
        if !quiet || d.diag_is_error() { d.print_diag(smap) }
    }
    errors.count_errors(nerr)
}
