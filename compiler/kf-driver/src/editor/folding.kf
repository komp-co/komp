// Foldable regions: the import block and every declaration's extent, methods
// included. One-line ranges are left for the client to drop.

import alloc.list.*

import kf_core.ast.Import
import kf_core.ast.Module
import kf_core.ast.import_is_written
import kf_core.ast.declaration.TopDecl
import json.writer.*

/// `{"schema_version":1,"file":..,"ranges":[..]}`
pub fun render_folding_json(path: str, m: &Module): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    var arr = JsonWriter.array()
    arr.append_import_range(&m.imports)
    arr.append_decl_ranges(&m.decls)
    out.field_raw("ranges", arr.finish().as_str())
    return out.finish()
}

/// The whole import run. Parser-synthesized imports have an empty span at 0
/// and are skipped.
mutating fun JsonWriter.append_import_range(imports: &List<Import>): void {
    var start = 0
    var end = 0
    var seen: bool = false
    while im in &imports {
        if import_is_written(im) {
            if !seen {
                start = im.span.start
                seen = true
            }
            if im.span.end > end { end = im.span.end }
        }
    }
    if seen {
        self.write_raw(range_object(start, end, "imports").as_str())
    }
}

mutating fun JsonWriter.append_decl_ranges(decls: &List<TopDecl>): void {
    while td in &decls {
        val end = td.decl_extent_end()
        if end > td.span.start {
            self.write_raw(range_object(td.span.start, end, "region").as_str())
        }
        self.append_member_ranges(&td)
    }
}

mutating fun JsonWriter.append_member_ranges(td: &TopDecl): void {
    when (td.kind) {
        ImplBlock(methods) => self.append_decl_ranges(&methods)
        TraitDecl(methods, _pub, _supers) => self.append_decl_ranges(&methods)
        TraitImpl(_trait_ref, methods) => self.append_decl_ranges(&methods)
        _ => {}
    }
}

fun range_object(start: uint32, end: uint32, kind: str): String {
    var o = JsonWriter.object()
    o.field_uint32("byte_start", start)
    o.field_uint32("byte_end", end)
    o.field_string("kind", kind)
    return o.finish()
}
