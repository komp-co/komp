import core.assert.assert_eq
import kf_core.span.*

/// `f(a, g(b, c), d)`: the commas inside `g` are `g`'s.
fun nested_call_span(): Span {
    return Span { file_id: 1, start: 0, end: 16 }
}

@test
fun the_active_index_ignores_a_nested_call(): void {
    val at = active_parameter("f(a, g(b, c), d)", &nested_call_span(), 14)
    assert_eq(at, 2 as uint32, "the third argument, not the fifth")
}

@test
fun the_active_index_ignores_a_comma_in_a_string(): void {
    val at = active_parameter("f(\"a, b\", c)", &Span { file_id: 1, start: 0, end: 12 }, 10)
    assert_eq(at, 1 as uint32, "a comma inside a string separates nothing")
}

@test
fun the_active_index_ignores_an_escaped_quote(): void {
    val at = active_parameter("f(\"a\\\", b\", c)", &Span { file_id: 1, start: 0, end: 14 }, 12)
    assert_eq(at, 1 as uint32, "an escaped quote does not end the string")
}
