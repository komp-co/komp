// What can appear at the cursor: a type after `:`, keywords and names in a
// body, item keywords between declarations. Read from the text, since what is
// being typed often does not parse.

import alloc.list.*

import kf_parse.lexer.*
import json.writer.*

pub enum CompletionPos {
    /// Between declarations: an item keyword, or a type after `impl`.
    ItemPos
    /// After a `:` or inside `<...>`: a type.
    TypePos
    /// In a body: statements, locals, calls.
    ExprPos
}

pub fun pos_is_item(p: CompletionPos): bool { return when (p) { ItemPos => true _ => false } }
pub fun pos_is_type(p: CompletionPos): bool { return when (p) { TypePos => true _ => false } }
pub fun pos_is_expr(p: CompletionPos): bool { return when (p) { ExprPos => true _ => false } }

/// A `:` before the name being typed is an annotation (let, parameter, field,
/// return); `<` is a generic list; otherwise brace depth decides.
pub fun completion_pos_at(src: str, offset: uint32): CompletionPos {
    val prev = significant_byte_before(src, offset)
    // `::` is a path, not an annotation.
    if prev == 58 { return CompletionPos.TypePos }
    if prev == 60 { return CompletionPos.TypePos }
    // `as` and `impl` are followed by a type whatever the brace depth.
    val word = preceding_word(src, offset)
    if word.as_str() == "as" { return CompletionPos.TypePos }
    if word.as_str() == "impl" { return CompletionPos.TypePos }
    if brace_depth(src, offset) == 0 { return CompletionPos.ItemPos }
    return CompletionPos.ExprPos
}

/// `as` in `x as in`, `impl` in `impl Fo`; "" when a non-name byte separates.
fun preceding_word(src: str, offset: uint32): String {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { i = n }
    while i > 0 && is_completion_name_byte(src.byte_at(i - 1)) { i = i - 1 }
    var saw_space = false
    while i > 0 {
        val b = src.byte_at(i - 1)
        if b != 32 && b != 9 && b != 10 && b != 13 { break }
        saw_space = true
        i = i - 1
    }
    if !saw_space { return "" }
    val end = i
    while i > 0 && is_completion_name_byte(src.byte_at(i - 1)) { i = i - 1 }
    if i == end { return "" }
    return src.substring(i, end)
}

/// The last byte before `offset` that is not whitespace or the name being
/// typed; 0 when none.
fun significant_byte_before(src: str, offset: uint32): uint8 {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { i = n }
    while i > 0 && is_completion_name_byte(src.byte_at(i - 1)) { i = i - 1 }
    while i > 0 {
        val b = src.byte_at(i - 1)
        if b != 32 && b != 9 && b != 10 && b != 13 { return b }
        i = i - 1
    }
    return 0
}

fun is_completion_name_byte(b: uint8): bool {
    if b >= 97 && b <= 122 { return true }
    if b >= 65 && b <= 90 { return true }
    if b >= 48 && b <= 57 { return true }
    return b == 95
}

/// Ignoring strings and comments. A byte scan, since an edited prefix often
/// does not lex.
fun brace_depth(src: str, offset: uint32): int64 {
    val n = src.byte_len()
    var stop: uint64 = offset as uint64
    if stop > n { stop = n }
    var depth: int64 = 0
    var i = 0
    var in_line_comment = false
    var in_string = false
    var escaped = false
    while i < stop {
        val b = src.byte_at(i)
        if in_line_comment {
            if b == 10 { in_line_comment = false }
        } else {
            if in_string {
                if escaped { escaped = false }
                else {
                    if b == 92 { escaped = true }
                    if b == 34 { in_string = false }
                }
            } else {
                if b == 34 { in_string = true }
                else {
                    if b == 47 && i + 1 < stop && src.byte_at(i + 1) == 47 {
                        in_line_comment = true
                    }
                    if b == 123 { depth = depth + 1 }
                    if b == 125 { depth = depth - 1 }
                }
            }
        }
        i = i + 1
    }
    if depth < 0 { return 0 }
    return depth
}

/// Driven by the `Keyword` enum, so a new keyword fails to compile here
/// until placed.
pub fun keyword_items(pos: CompletionPos): List<ScopeItem> {
    var out = List.new<ScopeItem>()
    var i = 0
    while true {
        val k = keyword_at(i) ?: break
        if keyword_fits(k, pos) {
            out.push(ScopeItem { label: String.from(kw_str(k)), kind: String.from("keyword"), detail: String.from("") })
        }
        i = i + 1
    }
    return out
}

fun keyword_fits(k: Keyword, pos: CompletionPos): bool {
    return when (k) {
        Fun => pos_is_item(pos)
        Pub => pos_is_item(pos)
        Struct => pos_is_item(pos)
        Enum => pos_is_item(pos)
        Trait => pos_is_item(pos)
        Impl => pos_is_item(pos)
        Import => pos_is_item(pos)
        Extern => pos_is_item(pos)
        Static => pos_is_item(pos)
        Mutating => pos_is_item(pos)
        TypeKw => pos_is_item(pos)
        Val => pos_is_expr(pos)
        Var => pos_is_expr(pos)
        Return => pos_is_expr(pos)
        If => pos_is_expr(pos)
        Else => pos_is_expr(pos)
        While => pos_is_expr(pos)
        When => pos_is_expr(pos)
        For => pos_is_expr(pos)
        In => pos_is_expr(pos)
        Break => pos_is_expr(pos)
        Continue => pos_is_expr(pos)
        True => pos_is_expr(pos)
        False => pos_is_expr(pos)
        Unsafe => pos_is_expr(pos)
        As => pos_is_expr(pos)
        Dyn => pos_is_type(pos)
    }
}

/// The builtin types, which no declaration walk reaches.
pub fun primitive_type_items(): List<ScopeItem> {
    var out = List.new<ScopeItem>()
    push_primitive(&var out, "int8")
    push_primitive(&var out, "int16")
    push_primitive(&var out, "int32")
    push_primitive(&var out, "int64")
    push_primitive(&var out, "uint8")
    push_primitive(&var out, "uint16")
    push_primitive(&var out, "uint32")
    push_primitive(&var out, "uint64")
    push_primitive(&var out, "float32")
    push_primitive(&var out, "float64")
    push_primitive(&var out, "bool")
    push_primitive(&var out, "char")
    push_primitive(&var out, "str")
    push_primitive(&var out, "void")
    return out
}

fun push_primitive(out: &var List<ScopeItem>, name: str): void {
    out.push(ScopeItem { label: String.from(name), kind: String.from("primitive"), detail: String.from("builtin type") })
}

/// Types fit type and item positions; everything fits an expression position,
/// where a type name is a constructor or static receiver.
pub fun scope_kind_fits(kind: str, pos: CompletionPos): bool {
    if pos_is_expr(pos) { return true }
    return when kind {
        "struct" => true
        "enum" => true
        "trait" => true
        _ => false
    }
}

/// Keywords legal here, builtin types where a type belongs, and fitting names
/// in scope. Keywords lead.
pub fun TypedCrate.positional_items_json(offset: uint32, src: str): String {
    val pos = completion_pos_at(src, offset)
    var arr = JsonWriter.array()
    arr.push_items(&keyword_items(pos))
    if pos_is_type(pos) { arr.push_items(&primitive_type_items()) }
    val scoped = self.scope_items_at(offset)
    while it in &scoped {
        if scope_kind_fits(it.kind.as_str(), pos) { arr.push_item_json(it) }
    }
    return arr.finish()
}

mutating fun JsonWriter.push_items(items: &List<ScopeItem>): void {
    while item in &items {
        self.push_item_json(item)
    }
}

mutating fun JsonWriter.push_item_json(it: &ScopeItem): void {
    var o = JsonWriter.object()
    o.field_string("label", it.label.as_str())
    o.field_string("kind", it.kind.as_str())
    o.field_string("detail", it.detail.as_str())
    self.write_raw(o.finish().as_str())
}
