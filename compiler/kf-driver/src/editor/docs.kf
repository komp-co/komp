// The `///` run above a declaration, recovered from the source with
// `tokenize_with_comments` rather than carried on the AST, which no other
// pass wants. Lexed, so `"///"` inside a string is not documentation.

import alloc.list.*

import kf_core.span.*
import kf_parse.lexer.tokenize_with_comments

/// "" when there is none. The run is the contiguous `///` lines directly
/// above, so a blank line ends it. The marker and one space are stripped,
/// leaving markdown.
pub fun doc_comment_above(src: str, file_id: uint32, decl_start: uint32): String {
    val r = tokenize_with_comments(src, file_id)
    var lines = List.new<String>()
    // Upward a line at a time; `edge` is where the next comment must end.
    var edge = line_start_before(src, decl_start)
    while true {
        val idx = doc_comment_ending_at(src, &r.comments, edge)
        if idx < 0 { break }
        val span = r.comments.get(idx as uint64)
        lines.push(strip_doc_marker(src, span.start, span.end))
        edge = line_start_before(src, span.start)
        if edge == 0 && span.start == 0 { break }
    }
    if lines.size() == 0 { return "" }
    // Collected bottom-up.
    var out = String.from("")
    var i = lines.size()
    while i > 0 {
        i = i - 1
        out.append(lines.at(i).as_str())
        if i > 0 { out.append("\n") }
    }
    return out
}

/// 0 for offset 0, which the caller reads as "stop".
fun line_start_before(src: str, offset: uint32): uint32 {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { i = n }
    while i > 0 && src.byte_at(i - 1) != 10 { i = i - 1 }
    return i as uint32
}

/// The `///` comment immediately above `edge`, or -1.
fun doc_comment_ending_at(src: str, comments: &List<Span>, edge: uint32): int64 {
    if edge == 0 { return 0 - 1 }
    while i in 0..comments.size() {
        val c = comments.get(i)
        if c.end <= edge && is_doc_comment(src, c.start, c.end) {
            if only_blank_between(src, c.end, edge) { return i as int64 }
        }
    }
    return 0 - 1
}

fun is_doc_comment(src: str, start: uint32, end: uint32): bool {
    if end < start + 3 { return false }
    if src.byte_at(start as uint64) != 47 { return false }
    if src.byte_at((start + 1) as uint64) != 47 { return false }
    return src.byte_at((start + 2) as uint64) == 47
}

/// More than one newline is a blank line.
fun only_blank_between(src: str, from: uint32, to: uint32): bool {
    var newlines: uint32 = 0
    var i: uint64 = from as uint64
    while i < (to as uint64) {
        val b = src.byte_at(i)
        if b == 10 { newlines = newlines + 1 }
        else {
            if b != 32 && b != 9 && b != 13 { return false }
        }
        i = i + 1
    }
    return newlines <= 1
}

/// `/// text` -> `text`.
fun strip_doc_marker(src: str, start: uint32, end: uint32): String {
    var i: uint64 = (start + 3) as uint64
    val stop = end as uint64
    if i < stop && src.byte_at(i) == 32 { i = i + 1 }
    if i >= stop { return "" }
    return src.substring(i, stop)
}
