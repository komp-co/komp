// The declaration tree behind the `symbols` answer. Kinds are KFlat words;
// the client maps them to protocol numbers.

import alloc.list.*

import kf_core.ast.*
import kf_interface.emit.tyref_to_source
import json.writer.*

/// `{"schema_version":1,"file":..,"symbols":[..]}`
pub fun render_symbols_json(path: str, m: &Module): String {
    val out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_raw("symbols", render_symbol_list(&m.decls, false).as_str())
    return out.finish()
}

/// `nested` marks an impl or trait body's members, which are methods.
fun render_symbol_list(decls: &List<TopDecl>, nested: bool): String {
    val arr = JsonWriter.array()
    while td in &decls {
        val rendered = td.render_symbol(nested)
        if rendered.as_str() != "" {
            arr.write_raw(rendered.as_str())
        }
    }
    return arr.finish()
}

/// "" for a parse error.
fun TopDecl.render_symbol(nested: bool): String {
    val kind = self.symbol_kind_of(nested)
    if kind == "" { return "" }
    val o = JsonWriter.object()
    o.field_string("name", self.symbol_name_of().as_str())
    o.field_string("kind", kind)
    o.field_string("detail", self.symbol_detail_of().as_str())
    o.field_uint32("byte_start", self.span.start)
    o.field_uint32("byte_end", self.decl_extent_end())
    o.field_raw("children", self.symbol_children_of().as_str())
    return o.finish()
}

fun TopDecl.symbol_kind_of(nested: bool): str {
    return when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _mut, _st) => function_kind_name(nested)
        Struct(_f, _pub) => "struct"
        EnumDecl(_v, _pub) => "enum"
        Extern(_p, _r, _pub, _u) => "extern"
        ImplBlock(_methods) => "impl"
        TraitDecl(_methods, _pub, _supers) => "trait"
        TraitImpl(_trait_ref, _methods) => "impl"
        AssocType(_bounds) => "type"
        AssocTypeBinding(_chosen) => "type"
        Poison => ""
    }
}

fun function_kind_name(nested: bool): str {
    if nested { return "method" }
    return "function"
}

/// A signature for a callable, the trait for a trait impl, else "".
fun TopDecl.symbol_detail_of(): String {
    return when (self.kind) {
        Function(params, ret, _b, _pub, _u, _mut, _st) => {
            signature_text(&self.callable_params(&params), unsafe { *ret })
        }
        Extern(params, ret, _pub, _u) => signature_text(&params, unsafe { *ret })
        TraitImpl(trait_ref, _methods) => (unsafe { *trait_ref }).tyref_to_source()
        _ => ""
    }
}

/// `(a: int32, b: str): bool`
fun signature_text(params: &List<Param>, ret: &TypeRef): String {
    var out = String.from("(")
    while i in 0..params.size() {
        if i > 0 { out.append(", ") }
        val p = *params.at(i)
        out.append(p.name.as_str())
        out.append(": ")
        val pty: TypeRef = unsafe { *p.ty }
        out.append(pty.tyref_to_source().as_str())
    }
    out.append("): ")
    out.append(ret.tyref_to_source().as_str())
    return out
}

/// Methods, fields or variants.
fun TopDecl.symbol_children_of(): String {
    return when (self.kind) {
        ImplBlock(methods) => render_symbol_list(&methods, true)
        TraitDecl(methods, _pub, _supers) => render_symbol_list(&methods, true)
        TraitImpl(_trait_ref, methods) => render_symbol_list(&methods, true)
        Struct(fields, _pub) => render_field_list(&fields)
        EnumDecl(variants, _pub) => render_variant_list(&variants)
        _ => String.from("[]")
    }
}

fun render_field_list(fields: &List<Field>): String {
    val arr = JsonWriter.array()
    while f in &fields {
        val o = JsonWriter.object()
        o.field_string("name", f.name.as_str())
        o.field_string("kind", "field")
        val fty: TypeRef = unsafe { *f.ty }
        o.field_string("detail", fty.tyref_to_source().as_str())
        o.field_uint32("byte_start", f.span.start)
        o.field_uint32("byte_end", f.span.end)
        o.field_raw("children", "[]")
        arr.write_raw(o.finish().as_str())
    }
    return arr.finish()
}

fun render_variant_list(variants: &List<Variant>): String {
    val arr = JsonWriter.array()
    while v in &variants {
        val o = JsonWriter.object()
        o.field_string("name", v.name.as_str())
        o.field_string("kind", "variant")
        o.field_string("detail", "")
        o.field_uint32("byte_start", v.span.start)
        o.field_uint32("byte_end", v.span.end)
        o.field_raw("children", "[]")
        arr.write_raw(o.finish().as_str())
    }
    return arr.finish()
}

/// An extension as `Point.area`.
fun TopDecl.symbol_name_of(): String {
    if self.is_extension() { return self.extension_display_name() }
    return self.name.as_string()
}

/// Without an extension's `self`.
fun TopDecl.callable_params(params: &List<Param>): List<Param> {
    if self.is_extension() { return extension_written_params(params) }
    return params.clone()
}
