// On a parsed module: spans come from the parser.

import core.assert.assert_eq


fun hit_in(src: str, offset: uint32): ExprHit {
    val m = module_for(src)
    return m.innermost_expr_at(1, offset)
}

@test
fun the_walk_finds_the_expression_under_the_offset(): void {
    val hit = hit_in("fun f(): int32 { return 1 + 2 }", 24)
    assert_eq(hit.span.start, 24 as uint32, "the offset lands on the literal `1`")
}

@test
fun the_walk_stops_at_the_literal_rather_than_its_operator(): void {
    val hit = hit_in("fun f(): int32 { return 1 + 2 }", 24)
    assert_eq(hit.span.end, 25 as uint32, "a literal's span is the literal, not the sum")
}

@test
fun the_walk_widens_to_the_operator_between_operands(): void {
    val hit = hit_in("fun f(): int32 { return 1 + 2 }", 26)
    assert_eq(hit.span.start, 24 as uint32, "the `+` itself belongs to the whole sum")
}

@test
fun the_walk_finds_nothing_where_no_expression_reaches(): void {
    val hit = hit_in("fun f(): int32 { return 1 + 2 }", 3)
    assert_eq(hit.found, false, "the space after `fun` covers no expression")
}

@test
fun the_walk_finds_nothing_past_the_end_of_the_file(): void {
    val hit = hit_in("fun f(): int32 { return 1 + 2 }", 9000)
    assert_eq(hit.found, false, "an offset past the file covers no expression")
}

@test
fun the_walk_ignores_another_file(): void {
    val m = module_for("fun f(): int32 { return 1 + 2 }")
    val hit = m.innermost_expr_at(2, 24)
    assert_eq(hit.found, false, "an expression in file 1 does not answer for file 2")
}

@test
fun the_walk_reaches_inside_a_method_body(): void {
    // The literal sits at 33.
    val hit = hit_in("impl P { fun m(): int32 { return 7 } }", 33)
    assert_eq(hit.span.start, 33 as uint32, "a method body is walked like any other")
}

@test
fun the_walk_reaches_inside_a_nested_block(): void {
    // The 5 is at 34.
    val hit = hit_in("fun f(): int32 { if true { return 5 } return 0 }", 34)
    assert_eq(hit.span.start, 34 as uint32, "an if body is walked like any other")
}
