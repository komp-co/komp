// What the cursor names:
//
//   * a top-level declaration, through the declaration index;
//   * a method, found through its receiver (a type before the dot, or a
//     value the checker typed);
//   * a type used as a static receiver (`Point` of `Point.new`), which is not
//     an expression.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*

pub struct HoverDecl {
    pub val found: bool
    /// A callable's signature, `struct Point` for a type, or "".
    pub val label: String
    pub val doc: String
}

fun no_hover_decl(): HoverDecl {
    return HoverDecl { found: false, label: String.from(""), doc: String.from("") }
}

/// The more specific answer wins: a method `p.shifted` over the local `p`.
pub fun TypedCrate.hover_decl_at(offset: uint32): HoverDecl {
    val member = self.hover_member_at(offset)
    if member.found { return member }
    return self.hover_toplevel_at(offset)
}

fun TypedCrate.hover_member_at(offset: uint32): HoverDecl {
    val src = self.source.as_str()
    val start = word_start_at(src, offset)
    if start == 0 { return no_hover_decl() }
    if src.byte_at((start - 1) as uint64) != 46 { return no_hover_decl() }
    val name = word_at(src, offset)
    if name.as_str() == "" { return no_hover_decl() }
    val owner = self.member_owner_before(start - 1)
    if owner.as_str() == "" { return no_hover_decl() }
    return self.member_named(owner.as_str(), name.as_str())
}

/// The type whose members a `.` at `dot` reaches. Tried as a declared type
/// first: `Point` in `Point.new` is not an expression and types as poison.
fun TypedCrate.member_owner_before(dot: uint32): String {
    val src = self.source.as_str()
    val recv = word_at(src, dot - 1)
    if recv.as_str() != "" && self.module.names_a_type(recv.as_str()) { return recv }
    val hit = self.module.innermost_expr_at(self.file_id, dot - 1)
    if !hit.found || hit.ty.is_poison() { return "" }
    return hit.ty.type_base_name()
}

fun Module.names_a_type(name: str): bool {
    while td in &self.decls {
        if td.name.as_str() == name {
            when (td.kind) {
                Struct(_f, _p) => return true
                EnumDecl(_v, _p) => return true
                TraitDecl(_mm, _p2, _s) => return true
                _ => { }
            }
        }
    }
    return false
}

/// From any impl naming `owner`, inherent or trait.
fun TypedCrate.member_named(owner: str, name: str): HoverDecl {
    val own = self.impl_member_named(owner, name)
    if own.found { return own }
    while td in &self.module.decls {
        if td.extension_applies_to(owner) && td.ext_name.as_str() == name {
            return HoverDecl { found: true, label: td.signature_of().label, doc: td.span.doc_for_span(self) }
        }
    }
    return no_hover_decl()
}

fun TypedCrate.impl_member_named(owner: str, name: str): HoverDecl {
    while td in &self.module.decls {
        if td.name.as_str() == owner {
            val members = td.impl_members()
            while mm in &members {
                if mm.name.as_str() == name {
                    val rendered = mm.signature_of()
                    if rendered.found {
                        return HoverDecl { found: true, label: rendered.label, doc: mm.span.doc_for_span(self) }
                    }
                }
            }
        }
    }
    return no_hover_decl()
}

fun TypedCrate.hover_toplevel_at(offset: uint32): HoverDecl {
    val target = self.module.decl_at_offset(self.file_id, offset) ?: return no_hover_decl()
    while td in &self.module.decls {
        when (td.decl) {
            Some(d) => {
                if d.raw == target.raw {
                    return HoverDecl { found: true, label: td.decl_label(), doc: td.span.doc_for_span(self) }
                }
            }
            None => { }
        }
    }
    return no_hover_decl()
}

/// A callable's signature, or the keyword introducing a type.
fun TopDecl.decl_label(): String {
    val rendered = self.signature_of()
    if rendered.found { return rendered.label }
    return when (self.kind) {
        Struct(_f, _p) => "struct ${self.name.as_string()}"
        EnumDecl(_v, _p) => "enum ${self.name.as_string()}"
        TraitDecl(_m, _p2, _s) => "trait ${self.name.as_string()}"
        _ => String.from("")
    }
}

/// Read from whichever file declares it, usually not the hovered one.
pub fun Span.doc_for_span(crate: &TypedCrate): String {
    if (*self).is_none() { return "" }
    if self.file_id == crate.file_id {
        return doc_comment_above(crate.source.as_str(), crate.file_id, self.start)
    }
    val decl_path = path_for_file_id(crate.smap, self.file_id)
    if decl_path.as_str() == "" { return "" }
    val text = read_file(decl_path.as_str())
    if text.as_str() == "" { return "" }
    return doc_comment_above(text.as_str(), self.file_id, self.start)
}

/// First byte of the name covering `offset`, or `offset` when none does.
pub fun word_start_at(src: str, offset: uint32): uint32 {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { return offset }
    while i > 0 && is_word_byte(src.byte_at(i - 1)) { i = i - 1 }
    return i as uint32
}

/// "" off a name. `offset` may be any byte of it, the last included.
pub fun word_at(src: str, offset: uint32): String {
    val n = src.byte_len()
    var end: uint64 = offset as uint64
    if end > n { return "" }
    // Just past the name still names it.
    while end < n && is_word_byte(src.byte_at(end)) { end = end + 1 }
    var start = end
    while start > 0 && is_word_byte(src.byte_at(start - 1)) { start = start - 1 }
    if start == end { return "" }
    return src.substring(start, end)
}

fun is_word_byte(b: uint8): bool {
    if b >= 97 && b <= 122 { return true }
    if b >= 65 && b <= 90 { return true }
    if b >= 48 && b <= 57 { return true }
    return b == 95
}
