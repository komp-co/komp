// What the declarations around a file contribute to its scope, the same
// wherever the cursor sits.

import alloc.list.*

import kf_core.ast.*
import kf_typecheck.*

/// Types are offered crate-graph-wide, since types resolve globally whatever
/// the imports say. Free functions are gated per file and across crates: an
/// unimported one would not compile.
fun collect_crate_decls(decls: &List<TopDecl>, crate: &TypedCrate, out: &var List<ScopeItem>, seen: &var List<String>): void {
    val own = own_crate(decls, crate.file_id)
    while td in &decls {
        when (td.kind) {
            Function(params, ret, _body, is_pub, _u, _mut, _st) => {
                if !td.is_a_test() && td.function_is_callable_here(is_pub, own, crate) {
                    add_item(out, seen, td.name.as_str(), "function", fn_detail(&params, ret).as_str())
                }
            }
            Struct(_fields, _pub) => add_item(out, seen, td.name.as_str(), "struct", "")
            EnumDecl(_variants, _pub) => add_item(out, seen, td.name.as_str(), "enum", "")
            TraitDecl(_methods, _pub, _supers) => add_item(out, seen, td.name.as_str(), "trait", "")
            _ => {}
        }
    }
}

/// Nothing writes a call to a `@test`, and tests can be half a crate.
fun TopDecl.is_a_test(): bool {
    return self.has_annotation("test")
}

/// Poison for a file that declares nothing, which then sees only imports.
fun own_crate(decls: &List<TopDecl>, file_id: uint32): CrateId {
    while td in &decls {
        if td.span.file_id == file_id { return td.crate }
    }
    return crate_id_poison()
}

/// Same crate: yes, visibility is crate-scoped. Another crate: `pub` and the
/// declaring module imported. Skipped when the checker's own gate is off, so
/// completion offers exactly what compiles.
fun TopDecl.function_is_callable_here(is_pub: bool, own: CrateId, crate: &TypedCrate): bool {
    if self.crate.raw == own.raw { return true }
    if !unsafe { &*crate.sigs }.gate_visibility { return true }
    if !is_pub { return false }
    return unsafe { crate.sigs.file_admits(crate.file_id, self.module_path, self.name.as_str()) }
}

/// Gated by the checker's per-file import map. Methods, registered as
/// `Owner_name`, are left to member completion.
fun TypedCrate.collect_imported_sigs(out: &var List<ScopeItem>, seen: &var List<String>): void {
    val sigs = unsafe { &*self.sigs }
    var i = 0
    while i < sigs.sigs.size() {
        val sig = sigs.sigs.at(i)
        if sig.is_pub && !sig.is_static {
            if !is_method_name(sig.name.as_str(), sigs) {
                if unsafe { self.sigs.file_admits(self.file_id, sig.owner_module, sig.name.as_str()) } {
                    add_item(out, seen, sig.name.as_str(), "function", sig.sig_detail(self).as_str())
                }
            }
        }
        i = i + 1
    }
}

/// A method registered as `<Type>_<method>`, judged against the known types
/// so `str_contains` stays a function. Trait impls count: `impl Add for
/// int8` registers `int8_add__Add`.
fun is_method_name(name: str, sigs: &SigTable): bool {
    while i in 0..sigs.structs.size() {
        if name_has_owner_prefix(name, sigs.structs.at(i).name.as_str()) { return true }
    }
    while j in 0..sigs.enums.size() {
        if name_has_owner_prefix(name, sigs.enums.at(j).name.as_str()) { return true }
    }
    while k in 0..sigs.trait_impls.size() {
        if name_has_owner_prefix(name, sigs.trait_impls.at(k).type_name.as_str()) { return true }
    }
    return false
}

fun name_has_owner_prefix(name: str, owner: str): bool {
    val on = owner.byte_len()
    if on == 0 { return false }
    if name.byte_len() <= on + 1 { return false }
    var i = 0
    while i < on {
        if name.byte_at(i) != owner.byte_at(i) { return false }
        i = i + 1
    }
    return name.byte_at(on) == 95        // `_`
}

/// `(a: int32, b: int32): int32`
fun fn_detail(params: &List<Param>, ret: Ptr<TypeRef>): String {
    var out = String.from("(")
    while i in 0..params.size() {
        if i > 0 { out.append(", ") }
        val p = params.at(i)
        out.append(p.name.as_str())
        out.append(": ")
        out.append(tyref_ptr_text(p.ty).as_str())
    }
    out.append(")")
    val r = tyref_ptr_text(ret)
    if r.as_str() != "" {
        out.append(": ")
        out.append(r.as_str())
    }
    return out
}

fun FnSignature.sig_detail(crate: &TypedCrate): String {
    var out = String.from("(")
    while i in 0..self.params.size() {
        if i > 0 { out.append(", ") }
        out.append(written_type(self.params.at(i), crate.sigs).as_str())
    }
    out.append("): ")
    out.append(self.ret.written_type(crate.sigs).as_str())
    return out
}
