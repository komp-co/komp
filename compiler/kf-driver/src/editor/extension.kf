// An extension function as an editor sees it: under its called name, as a
// method of what it extends.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.new_param
import kf_interface.emit.tyref_to_source
import kf_core.diagnostic.new_diagnostics
import kf_typecheck.new_type_ctx
import kf_typecheck.check.extensions_callable_on

pub fun TopDecl.is_extension(): bool {
    return !self.ext_name.as_str().equals("")
}

/// `Point.area`.
pub fun TopDecl.extension_display_name(): String {
    return (&self.extension_receiver()).tyref_to_source() + String.from(".") + self.ext_name.as_string()
}

/// Everything after `self`.
pub fun extension_written_params(params: &List<Param>): List<Param> {
    var out = List.new<Param>()
    var i: uint64 = 1
    while i < params.size() {
        out.push(*params.at(i))
        i = i + 1
    }
    return out
}

/// For `area(&ps, x)`: the receiver first, as `self`.
pub fun extension_call_params(params: &List<Param>, td: &TopDecl): List<Param> {
    var out = List.new<Param>()
    if params.size() == 0 { return out }
    val first = *params.at(0)
    var shown = td.extension_receiver()
    when (unsafe { (*first.ty).kind }) {
        Reference(mutable, _inner) => {
            val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *inner = shown }
            shown = TypeRef.new(first.span, TypeRefKind.Reference(mutable, inner))
        }
        _ => { }
    }
    val slot: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *slot = shown }
    out.push(new_param(first.span, String.from("self"), slot))
    while p in &extension_written_params(params) {
        out.push(p.clone())
    }
    return out
}

/// `area(` rather than `ps.area(`, whose span starts at the receiver.
pub fun written_as_function(src: str, start: uint32, name: str): bool {
    val from = start as uint64
    val len = name.byte_len()
    if from + len >= src.byte_len() { return false }
    var i: uint64 = 0
    while i < len {
        if src.byte_at(from + i) != name.byte_at(i) { return false }
        i = i + 1
    }
    val next = src.byte_at(from + len)
    return next == 40 || next == 60
}

/// The hidden names of the extensions a call on `receiver` would pick: the
/// checker's verdict, so a bound the receiver does not meet rules one out.
pub fun TypedCrate.callable_extensions(receiver: &Type): List<String> {
    var sink = new_diagnostics()
    var ctx = new_type_ctx(Type.new_poison(), &var sink, null, self.sigs)
    // Visibility is judged from the queried file's module.
    while td in &self.module.decls {
        if td.span.file_id == self.file_id {
            ctx.owner_crate = td.crate
            ctx.owner_module = td.module_path
            break
        }
    }
    return extensions_callable_on(receiver, &var ctx)
}

/// Whether this is one of `links`, as `callable_extensions` named them.
pub fun TopDecl.is_extension_in(links: &List<String>): bool {
    if !self.is_extension() { return false }
    while link in &links {
        if link.as_str() == self.name.as_str() { return true }
    }
    return false
}

/// Without `self`'s reference; a trait receiver is shown as the trait.
fun TopDecl.extension_receiver(): TypeRef {
    val trait_params = self.annotation_words("receiver_trait")
    if trait_params.size() > 0 {
        while tp in &self.generics {
            if tp.name.as_str() == trait_params.at(0).as_str() && tp.bounds.size() > 0 {
                return *tp.bounds.at(0)
            }
        }
    }
    when (self.kind) {
        Function(params, _ret, _body, _is_pub, _is_unsafe, _is_mutating, _is_static) => {
            if params.size() == 0 { return TypeRef.new_poison(self.span) }
            val written: TypeRef = unsafe { *params.at(0).ty }
            when (written.kind) {
                Reference(_mutable, inner) => return unsafe { *inner }
                _ => return written
            }
        }
        _ => return TypeRef.new_poison(self.span)
    }
}
