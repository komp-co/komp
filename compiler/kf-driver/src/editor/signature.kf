// Signature help: the callee's declaration from the assembled crate, and the
// active parameter counted from commas in the text.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_interface.emit.tyref_to_source
import json.writer.*

/// `{"schema_version":1,"file":..,"offset":N,"label":..,"parameters":[..],
///   "active_parameter":N}`
///
/// `label` is null outside a call or for an undeclared callee.
pub fun render_signature_json(path: str, offset: uint32, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_uint32("offset", offset)

    val call = crate.module.innermost_call_at(crate.file_id, offset)
    if !call.is_call {
        out.field_null("label")
        out.field_raw("parameters", "[]")
        out.field_uint32("active_parameter", 0)
        return out.finish()
    }
    val decl = crate.module.callee_decl(&call, crate.source.as_str())
    if !decl.found {
        out.field_null("label")
        out.field_raw("parameters", "[]")
        out.field_uint32("active_parameter", 0)
        return out.finish()
    }
    out.field_string("label", decl.label.as_str())
    out.field_raw("parameters", decl.parameters.as_str())
    out.field_uint32("active_parameter", active_parameter(crate.source.as_str(), &call.span, offset))
    return out.finish()
}

/// Innermost: in `outer(inner(|))` the help is for `inner`.
fun Module.innermost_call_at(file_id: uint32, offset: uint32): CoveringSpan {
    val covering = self.covering_spans(file_id, offset)
    var best = plain_call_miss()
    while c in &covering {
        if c.is_call {
            if !best.is_call || c.span.call_width() <= best.span.call_width() { best = c }
        }
    }
    return best
}

fun plain_call_miss(): CoveringSpan {
    return CoveringSpan { span: no_span(), ty: poison_ty(), is_expr: false, is_call: false, callee: intern(""), recv_ty: poison_ty() }
}

fun Span.call_width(): uint32 {
    if self.end <= self.start { return 0 }
    return self.end - self.start
}

/// `found: false` for an undeclared callee.
pub struct SignatureText {
    pub var found: bool
    pub var label: String
    pub var parameters: String
}

fun no_signature(): SignatureText {
    return SignatureText { found: false, label: "", parameters: String.from("[]") }
}

/// A method from the impl matching the receiver's type; a free call from the
/// module's functions, dependencies included.
fun Module.callee_decl(call: &CoveringSpan, src: str): SignatureText {
    if call.recv_ty.is_poison() {
        return free_function_signature(&self.decls, call.callee.as_str(), src, call.span.start)
    }
    return method_signature(&self.decls, call.recv_ty.type_base_name().as_str(), call.callee.as_str())
}

/// A method-form extension call arrives rewritten; as a function, its
/// receiver is an argument.
fun free_function_signature(decls: &List<TopDecl>, name: str, src: str, start: uint32): SignatureText {
    while td in &decls {
        if td.name.as_str() == name {
            val as_function = td.is_extension() && written_as_function(src, start, td.ext_name.as_str())
            val rendered = if as_function { td.extension_function_signature() } else { td.signature_of() }
            if rendered.found { return rendered }
        }
    }
    return no_signature()
}

/// Falls back to any method of that name when the receiver did not check.
fun method_signature(decls: &List<TopDecl>, owner: str, name: str): SignatureText {
    var fallback = no_signature()
    while td in &decls {
        val members = td.impl_members()
        while mm in &members {
            if mm.name.as_str() == name {
                val rendered = mm.signature_of()
                if rendered.found {
                    if td.name.as_str() == owner { return rendered }
                    if !fallback.found { fallback = rendered }
                }
            }
        }
    }
    return fallback
}

/// Shared with completion.
pub fun TopDecl.impl_members(): List<TopDecl> {
    return when (self.kind) {
        ImplBlock(methods) => methods.clone()
        TraitImpl(_trait_ref, methods) => methods.clone()
        TraitDecl(methods, _pub, _supers) => methods.clone()
        _ => List.new<TopDecl>()
    }
}

/// `add(a: int32, b: int32): int32`, with each parameter's label.
pub fun TopDecl.signature_of(): SignatureText {
    when (self.kind) {
        Function(params, ret, _b, _pub, _u, _mut, _st) => {
            if self.is_extension() {
                val written = extension_written_params(&params)
                return rendered_signature(self.extension_display_name().as_str(), &written, unsafe { *ret })
            }
            return rendered_signature(self.name.as_str(), &params, unsafe { *ret })
        }
        Extern(params, ret, _pub, _u) => return rendered_signature(self.name.as_str(), &params, unsafe { *ret })
        _ => return no_signature()
    }
}

fun TopDecl.extension_function_signature(): SignatureText {
    when (self.kind) {
        Function(params, ret, _b, _pub, _u, _mut, _st) => {
            val all = extension_call_params(&params, self)
            return rendered_signature(self.ext_name.as_str(), &all, unsafe { *ret })
        }
        _ => return no_signature()
    }
}

fun rendered_signature(name: str, params: &List<Param>, ret: &TypeRef): SignatureText {
    var label = String.from(name)
    label.append("(")
    var arr = JsonWriter.array()
    while i in 0..params.size() {
        if i > 0 { label.append(", ") }
        val p = *params.at(i)
        var one = String.from(p.name.as_str())
        one.append(": ")
        val pty: TypeRef = unsafe { *p.ty }
        one.append(pty.tyref_to_source().as_str())
        label.append(one.as_str())
        var o = JsonWriter.object()
        o.field_string("label", one.as_str())
        arr.write_raw(o.finish().as_str())
    }
    label.append("): ")
    label.append(ret.tyref_to_source().as_str())
    return SignatureText { found: true, label: label, parameters: arr.finish() }
}

/// The impl target: `Pair__int32` and `Pair<int32>` both give `Pair`.
pub fun Type.type_base_name(): String {
    val spelled = type_identity_display(self.type_name_of())
    val n = spelled.as_str().byte_len()
    var i = 0
    while i < n {
        val b = spelled.as_str().byte_at(i)
        // `<` or `__` opens type arguments.
        if b == 60 { return spelled.as_str().substring(0, i) }
        if b == 95 && i + 1 < n {
            if spelled.as_str().byte_at(i + 1) == 95 {
                return spelled.as_str().substring(0, i)
            }
        }
        i = i + 1
    }
    return spelled
}

fun Type.type_name_of(): Sym {
    return when (self.kind) {
        Struct(name) => name
        EnumTy(name) => name
        TraitTy(name) => name
        Generic(name) => name
        RefTo(_m, inner) => type_name_of(unsafe { &*inner })
        PtrTo(inner) => type_name_of(unsafe { &*inner })
        BoxOf(inner) => type_name_of(unsafe { &*inner })
        _ => intern("")
    }
}

/// Commas directly inside the call before the offset, counted in the text:
/// the argument being typed often does not parse.
pub fun active_parameter(src: str, call: &Span, offset: uint32): uint32 {
    val n = src.byte_len()
    var i: uint64 = call.start as uint64
    val stop: uint64 = offset as uint64
    var depth = 0
    var commas: uint32 = 0
    var in_string: bool = false
    while i < n && i < stop {
        val b = src.byte_at(i)
        if in_string {
            if b == 92 { i = i + 1 }
            else if b == 34 { in_string = false }
        } else if b == 34 {
            in_string = true
        } else if b == 40 {
            depth = depth + 1
        } else if b == 41 {
            depth = depth - 1
        } else if b == 44 && depth == 1 {
            commas = commas + 1
        }
        i = i + 1
    }
    return commas
}
