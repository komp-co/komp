import core.assert.assert_eq

/// Where the declaration after a doc run starts.
fun end_of(src: str): uint32 {
    return src.byte_len() as uint32
}

@test
fun a_doc_run_above_a_declaration_is_read(): void {
    val src = "/// One.\n/// Two.\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "One.\nTwo.", "every line of the run, in the order written")
}

@test
fun the_marker_and_one_space_are_stripped(): void {
    val src = "///Tight.\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "Tight.", "no space to strip is not an error")
}

@test
fun a_plain_comment_is_not_documentation(): void {
    val src = "// Just a note.\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "", "`//` documents nothing")
}

@test
fun a_blank_line_detaches_the_run(): void {
    val src = "/// A file header.\n\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "", "a header separated by a blank line is not the declaration's doc")
}

@test
fun a_blank_line_ends_the_run_early(): void {
    // Only the second block attaches.
    val src = "/// Detached.\n\n/// Attached.\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "Attached.", "the run stops at the blank line")
}

@test
fun a_declaration_with_nothing_above_it_has_no_doc(): void {
    assert_eq(doc_comment_above("", 1, 0).as_str(), "", "byte zero has no line above it")
}

@test
fun a_doc_marker_inside_a_string_is_not_a_comment(): void {
    // The literal stays a literal.
    val src = "val s = \"/// not a doc\"\n"
    assert_eq(doc_comment_above(src, 1, end_of(src)).as_str(), "", "a marker in a string documents nothing")
}
