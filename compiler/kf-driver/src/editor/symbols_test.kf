import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser

/// As `parse_source` parses a buffer.
fun module_for(src: str): Module {
    val toks = tokenize(src, 1)
    val p = new_parser(toks)
    return p.parse_module(List.new<String>())
}

fun symbols_of(src: str): String {
    val m = module_for(src)
    return render_symbols_json("t.kf", &m)
}

@test
fun symbols_report_a_function_over_its_whole_extent(): void {
    val json = symbols_of("fun a(): void { }")
    assert_eq(json.as_str().contains("\"name\":\"a\",\"kind\":\"function\",\"detail\":\"(): void\",\"byte_start\":0,\"byte_end\":17"), true, "a function spans keyword to closing brace")
}

@test
fun symbols_nest_a_struct_field_under_its_struct(): void {
    val json = symbols_of("struct P { val x: int32 }")
    assert_eq(json.as_str().contains("\"name\":\"x\",\"kind\":\"field\",\"detail\":\"int32\",\"byte_start\":15,\"byte_end\":16"), true, "a field is a child spanning its name")
}

@test
fun symbols_nest_an_enum_variant_under_its_enum(): void {
    val json = symbols_of("enum E { A B }")
    assert_eq(json.as_str().contains("\"name\":\"A\",\"kind\":\"variant\""), true, "a variant is a child of its enum")
}

@test
fun symbols_call_a_declaration_inside_an_impl_a_method(): void {
    val json = symbols_of("impl P { fun m(): void { } }")
    assert_eq(json.as_str().contains("\"name\":\"m\",\"kind\":\"method\""), true, "an impl member is a method, not a free function")
}

@test
fun symbols_end_a_method_at_its_own_brace(): void {
    val json = symbols_of("impl P { fun m(): void { } }")
    assert_eq(json.as_str().contains("\"kind\":\"method\",\"detail\":\"(): void\",\"byte_start\":9,\"byte_end\":26"), true, "a method's extent stops before the impl's brace")
}

@test
fun symbols_name_the_trait_a_trait_impl_implements(): void {
    val json = symbols_of("impl Show for P { fun s(): void { } }")
    assert_eq(json.as_str().contains("\"name\":\"P\",\"kind\":\"impl\",\"detail\":\"Show\""), true, "a trait impl carries the trait as its detail")
}

@test
fun symbols_skip_a_declaration_that_did_not_parse(): void {
    val json = symbols_of("fun ok(): void { }\n1234")
    assert_eq(json.as_str().contains("\"name\":\"\""), false, "a poisoned declaration names nothing to navigate to")
}

@test
fun symbols_answer_on_a_file_with_no_declarations(): void {
    val json = symbols_of("")
    assert_eq(json.as_str(), "{\"schema_version\":1,\"file\":\"t.kf\",\"symbols\":[]}", "an empty file answers with an empty list")
}
