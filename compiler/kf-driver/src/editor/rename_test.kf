import core.assert.assert_eq

@test
fun a_single_identifier_is_the_only_acceptable_new_name(): void {
    assert_eq(is_single_identifier("scaled"), true, "a plain name")
    assert_eq(is_single_identifier("_x9"), true, "underscores and digits inside a name")
    assert_eq(is_single_identifier(""), false, "the empty string names nothing")
    assert_eq(is_single_identifier("1foo"), false, "a name cannot open with a digit")
    assert_eq(is_single_identifier("fun"), false, "a keyword is not available")
    assert_eq(is_single_identifier("a b"), false, "two identifiers are not one")
    assert_eq(is_single_identifier("a."), false, "an identifier plus punctuation is not one identifier")
}
