// An editor's questions about one file, answered as JSON, a pure function of
// source and position. Offsets are bytes; the client converts. The questions
// here only parse, so they answer on a file that does not typecheck.

import alloc.list.*

import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser

/// `text` parsed alone. Parse diagnostics are dropped so a half-written
/// tail does not blank the answer. The file id is constant: no answer here
/// carries a line or column.
pub fun parse_source(text: str): Module {
    val toks = tokenize(text, 1)
    val p = new_parser(toks)
    return p.parse_module(List.new<String>())
}

/// The byte past a declaration's last token, or its recorded span for a
/// synthesized or poisoned one.
pub fun TopDecl.decl_extent_end(): uint32 {
    if self.decl_end > self.span.start { return self.decl_end }
    return self.span.end
}
