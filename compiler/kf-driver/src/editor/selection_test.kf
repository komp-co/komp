import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*

/// `fun f(): int32 { return 1 + 2 }`: the `1` at 24, the sum 24..29, the
/// declaration 31 bytes.
fun chain_for(offset: uint32): List<Span> {
    val m = module_for("fun f(): int32 { return 1 + 2 }")
    return m.selection_chain(1, offset)
}

@test
fun the_chain_starts_at_the_expression_under_the_cursor(): void {
    val chain = chain_for(24)
    assert_eq(chain.get(0).end, 25 as uint32, "the innermost range is the literal alone")
}

@test
fun the_chain_widens_to_the_enclosing_expression(): void {
    val chain = chain_for(24)
    assert_eq(chain.get(1).end, 29 as uint32, "the next range is the sum around it")
}

@test
fun the_chain_ends_at_the_whole_declaration(): void {
    val chain = chain_for(24)
    assert_eq(chain.get(2).end, 31 as uint32, "the outermost range is the declaration's extent")
}

@test
fun the_chain_has_one_step_per_level(): void {
    val chain = chain_for(24)
    assert_eq(chain.size(), 3, "literal, sum, declaration — and no repeats")
}

@test
fun the_chain_is_empty_outside_every_declaration(): void {
    val m = module_for("fun f(): int32 { return 1 }\n\n\n")
    val chain = m.selection_chain(1, 28)
    assert_eq(chain.size(), 0, "the blank lines after a declaration are in nothing")
}

@test
fun the_chain_ignores_another_file(): void {
    val m = module_for("fun f(): int32 { return 1 + 2 }")
    val chain = m.selection_chain(2, 24)
    assert_eq(chain.size(), 0, "spans in file 1 do not answer for file 2")
}
