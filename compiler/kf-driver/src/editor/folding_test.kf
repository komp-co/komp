import core.assert.assert_eq

fun folding_of(src: str): String {
    val m = module_for(src)
    return render_folding_json("t.kf", &m)
}

@test
fun folding_covers_a_run_of_imports_as_one_region(): void {
    val json = folding_of("import core.option.*\nimport alloc.list.*\n\nfun a(): void { }")
    assert_eq(json.as_str().contains("{\"byte_start\":0,\"byte_end\":40,\"kind\":\"imports\"}"), true, "the import block folds first byte to last")
}

@test
fun folding_reports_no_import_region_without_imports(): void {
    val json = folding_of("fun a(): void { }")
    assert_eq(json.as_str().contains("\"kind\":\"imports\""), false, "a file with no imports has no import region")
}

@test
fun folding_gives_a_method_a_range_of_its_own(): void {
    val json = folding_of("impl P { fun m(): void { } }")
    assert_eq(json.as_str().contains("{\"byte_start\":9,\"byte_end\":26,\"kind\":\"region\"}"), true, "a method folds inside its impl")
}

@test
fun folding_reports_the_impl_that_encloses_a_method(): void {
    val json = folding_of("impl P { fun m(): void { } }")
    assert_eq(json.as_str().contains("{\"byte_start\":0,\"byte_end\":28,\"kind\":\"region\"}"), true, "the impl folds over its whole body")
}

@test
fun folding_answers_on_a_file_with_no_declarations(): void {
    val json = folding_of("")
    assert_eq(json.as_str(), "{\"schema_version\":1,\"file\":\"t.kf\",\"ranges\":[]}", "an empty file answers with an empty list")
}
