// Completion after `.`. Where the receiver ends is read from the text, since
// a half-typed member does not parse; what the receiver is comes from the
// checker, at the byte before the dot. Scope completion is scope.kf.

import alloc.list.*

import kf_core.ast.*
import kf_interface.emit.tyref_to_source
import json.writer.*

/// `{"schema_version":2,"file":..,"offset":N,"receiver_type":..,
///   "prefix":"..","items":[{"label":..,"kind":..,"detail":..}]}`
///
/// `receiver_type` is null off a member position, where the items are the
/// names in scope, and null with no items when the receiver has no type: a
/// list built from spelling looks authoritative and is worse than none.
/// `kind` is `local`, `parameter`, `function`, `struct`, `enum`, `trait`,
/// `field` or `method`.
pub fun render_completion_json(path: str, offset: uint32, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 2)
    out.field_string("file", path)
    out.field_uint32("offset", offset)

    val src = crate.source.as_str()
    val dot = member_dot_before(src, offset)
    if dot == 0 {
        out.field_null("receiver_type")
        out.field_string("prefix", typed_prefix(src, offset).as_str())
        out.field_raw("items", crate.positional_items_json(offset, src).as_str())
        return out.finish()
    }
    out.field_string("prefix", typed_prefix(src, offset).as_str())

    // The byte before the dot; for `foo().bar` that is the `)`, whose
    // narrowest covering expression is the call.
    val hit = crate.module.innermost_expr_at(crate.file_id, dot - 1)
    if !hit.found || hit.ty.is_poison() {
        out.field_null("receiver_type")
        out.field_raw("items", "[]")
        return out.finish()
    }
    val owner = hit.ty.type_base_name()
    if owner.as_str() == "" {
        out.field_null("receiver_type")
        out.field_raw("items", "[]")
        return out.finish()
    }
    out.field_string("receiver_type", hit.ty.written_type(crate.sigs).as_str())
    out.field_raw("items", crate.module.members_json(owner.as_str()).as_str())
    return out.finish()
}

/// Index of the `.` being completed after, or 0 off a member position. Skips
/// a partly typed name: `p.`, `p.x`, `p.sca`.
pub fun member_dot_before(src: str, offset: uint32): uint32 {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { return 0 }
    while i > 0 && is_name_byte(src.byte_at(i - 1)) { i = i - 1 }
    if i == 0 { return 0 }
    if src.byte_at(i - 1) != 46 { return 0 }
    return (i - 1) as uint32
}

/// The partly typed name, shown so a CLI answer can be checked by hand.
fun typed_prefix(src: str, offset: uint32): String {
    val n = src.byte_len()
    var i: uint64 = offset as uint64
    if i > n { return "" }
    val end = i
    while i > 0 && is_name_byte(src.byte_at(i - 1)) { i = i - 1 }
    return src.substring(i, end)
}

fun is_name_byte(b: uint8): bool {
    if b >= 97 && b <= 122 { return true }
    if b >= 65 && b <= 90 { return true }
    if b >= 48 && b <= 57 { return true }
    return b == 95
}

/// Fields from the struct and methods from every impl naming it, inherent and
/// trait alike.
fun Module.members_json(owner: str): String {
    var seen = List.new<String>()
    var arr = JsonWriter.array()
    while td in &self.decls {
        if td.name.as_str() == owner {
            td.add_fields(&var seen, &var arr)
            td.add_methods(&var seen, &var arr)
        }
        // After the type's own members.
        if td.extension_applies_to(owner) {
            push_item(&var seen, &var arr, td.ext_name.as_str(), "method", td.signature_of().label.as_str())
        }
    }
    return arr.finish()
}

fun TopDecl.add_fields(seen: &var List<String>, arr: &var JsonWriter): void {
    when (self.kind) {
        Struct(fields, _pub) => {
            while f in &fields {
                val ty: TypeRef = unsafe { *f.ty }
                push_item(seen, arr, f.name.as_str(), "field", ty.tyref_to_source().as_str())
            }
        }
        _ => {}
    }
}

fun TopDecl.add_methods(seen: &var List<String>, arr: &var JsonWriter): void {
    val members = self.impl_members()
    while mm in &members {
        if !mm.method_is_static() {
            val rendered = mm.signature_of()
            if rendered.found {
                push_item(seen, arr, mm.name.as_str(), "method", rendered.label.as_str())
            }
        }
    }
}

/// A `static fun` is not reachable through a receiver.
fun TopDecl.method_is_static(): bool {
    var is_static = false
    when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _mut, st) => is_static = st
        _ => {}
    }
    return is_static
}

/// Once per name, though several impls may offer it.
fun push_item(seen: &var List<String>, arr: &var JsonWriter, label: str, kind: str, detail: str): void {
    while item in &seen {
        if item.as_str() == label { return }
    }
    seen.push(String.from(label))
    var o = JsonWriter.object()
    o.field_string("label", label)
    o.field_string("kind", kind)
    o.field_string("detail", detail)
    arr.write_raw(o.finish().as_str())
}
