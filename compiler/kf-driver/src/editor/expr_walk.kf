// What a cursor is inside: every expression whose span covers the offset,
// with its declaration. Hover wants the narrowest; expand-selection the whole
// chain, innermost outward. A Stmt's span is its leading keyword, so no
// statement covers anything.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*

/// `is_expr` separates typed expressions from the declaration around them. A
/// call carries its name and receiver type for signature help.
pub struct CoveringSpan {
    pub val span:    Span
    pub val ty:      Type
    pub val is_expr: bool
    pub val is_call: bool
    pub val callee:  Sym
    pub val recv_ty: Type
}

fun plain_covering(span: Span, ty: Type, is_expr: bool): CoveringSpan {
    return CoveringSpan { span: span, ty: ty, is_expr: is_expr, is_call: false, callee: intern(""), recv_ty: poison_ty() }
}

/// `found` is false where nothing covers the offset: whitespace, a keyword,
/// an annotation.
pub struct ExprHit {
    pub var found: bool
    pub var span:  Span
    pub var ty:    Type
}

pub fun no_expr_hit(): ExprHit {
    return ExprHit { found: false, span: no_span(), ty: poison_ty() }
}

/// Everything covering `offset`, in walk order.
pub fun Module.covering_spans(file_id: uint32, offset: uint32): List<CoveringSpan> {
    var found = List.new<CoveringSpan>()
    hit_decl_list(&self.decls, file_id, offset, &var found)
    return found
}

pub fun Module.innermost_expr_at(file_id: uint32, offset: uint32): ExprHit {
    val found = self.covering_spans(file_id, offset)
    var hit = no_expr_hit()
    while c in &found {
        if c.is_expr {
            if !hit.found || c.span.span_width() <= hit.span.span_width() {
                hit.found = true
                hit.span = c.span
                hit.ty = c.ty
            }
        }
    }
    return hit
}

/// End-exclusive: a cursor just past a name belongs to what encloses it. A
/// zero-width span covers nothing.
fun Span.span_covers(file_id: uint32, offset: uint32): bool {
    if self.file_id != file_id { return false }
    if self.end <= self.start { return false }
    return self.start <= offset && offset < self.end
}

fun Span.span_width(): uint32 {
    if self.end <= self.start { return 0 }
    return self.end - self.start
}

fun hit_decl_list(decls: &List<TopDecl>, file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    while decl in &decls {
        decl.hit_decl(file_id, offset, found)
    }
}

fun TopDecl.hit_decl(file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    // The declaration's extent, not its first keyword.
    val extent = Span { file_id: self.span.file_id, start: self.span.start, end: self.decl_extent_end() }
    if extent.span_covers(file_id, offset) {
        found.push(plain_covering(extent, poison_ty(), false))
    }
    when (self.kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => hit_stmt_list(body, file_id, offset, found)
        ImplBlock(methods) => hit_decl_list(&methods, file_id, offset, found)
        TraitDecl(methods, _pub, _supers) => hit_decl_list(&methods, file_id, offset, found)
        TraitImpl(_trait_ref, methods) => hit_decl_list(&methods, file_id, offset, found)
        _ => {}
    }
}

fun hit_stmt_list(stmts: &List<Stmt>, file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    while stmt in &stmts {
        (stmt).hit_stmt(file_id, offset, found)
    }
}

fun Stmt.hit_stmt(file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    when (self.kind) {
        LetVal(_n, _ann, init) => hit_expr_ptr(init.view(), file_id, offset, found)
        LetVar(_n, _ann, init) => hit_expr_ptr(init.view(), file_id, offset, found)
        Assign(_n, e) => hit_expr_ptr(e, file_id, offset, found)
        AssignTo(place, e) => {
            hit_expr_ptr(place, file_id, offset, found)
            hit_expr_ptr(e, file_id, offset, found)
        }
        Return(e) => {
            val ep = e ?: return
            hit_expr_ptr(ep, file_id, offset, found)
        }
        If(c, then_body, else_body) => {
            hit_expr_ptr(c, file_id, offset, found)
            hit_stmt_list(then_body, file_id, offset, found)
            hit_stmt_list(else_body, file_id, offset, found)
        }
        While(c, body) => {
            hit_expr_ptr(c, file_id, offset, found)
            hit_stmt_list(body, file_id, offset, found)
        }
        ForEach(_binder, subject, body) => {
            hit_expr_ptr(subject, file_id, offset, found)
            hit_stmt_list(body, file_id, offset, found)
        }
        When(subject, arms) => {
            hit_expr_ptr(subject, file_id, offset, found)
            hit_arm_list(&arms, file_id, offset, found)
        }
        Switch(subject, sarms) => {
            hit_expr_ptr(subject, file_id, offset, found)
            while arm in &sarms {
                hit_stmt_list(&arm.body, file_id, offset, found)
            }
        }
        Expression(e) => hit_expr_ptr(e, file_id, offset, found)
        _ => {}
    }
}

fun hit_arm_list(arms: &List<Arm>, file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    while arm in &arms {
        hit_stmt_list(&arm.body, file_id, offset, found)
    }
}

fun hit_expr_ptr(p_opt: Ptr<Expr>?, file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    val p = p_opt ?: return
    hit_expr(unsafe { &*p }, file_id, offset, found)
}

fun Expr.hit_expr(file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    if self.span.span_covers(file_id, offset) {
        found.push(self.covering_for_expr())
    }
    // Descends whether or not this node covered the offset: a synthesized
    // node's span may be narrower than its children's.
    when (self.kind) {
        Binary(l, _op, r) => {
            hit_expr_ptr(l, file_id, offset, found)
            hit_expr_ptr(r, file_id, offset, found)
        }
        Unary(_op, inner) => hit_expr_ptr(inner, file_id, offset, found)
        Deref(inner) => hit_expr_ptr(inner, file_id, offset, found)
        Call(_name, args) => hit_expr_list(&args, file_id, offset, found)
        MethodCall(recv, _m, args) => {
            hit_expr_ptr(recv, file_id, offset, found)
            hit_expr_list(&args, file_id, offset, found)
        }
        FieldAccess(obj, _f) => hit_expr_ptr(obj, file_id, offset, found)
        IfExpr(c, t, el) => {
            hit_expr_ptr(c, file_id, offset, found)
            hit_expr_ptr(t, file_id, offset, found)
            hit_expr_ptr(el, file_id, offset, found)
        }
        WhenExpr(subject, arms) => {
            hit_expr_ptr(subject, file_id, offset, found)
            hit_arm_list(&arms, file_id, offset, found)
        }
        StructLit(_name, finits) => {
            while fi in &finits {
                hit_expr_ptr(fi.value, file_id, offset, found)
            }
        }
        Cast(inner, _target) => hit_expr_ptr(inner, file_id, offset, found)
        DynCoerce(inner, _vtable) => hit_expr_ptr(inner, file_id, offset, found)
        Lambda(_params, body) => hit_stmt_list(&body, file_id, offset, found)
        Block(stmts) => {
            while stmt in &stmts {
                (stmt).hit_stmt(file_id, offset, found)
            }
        }
        Retain(inner) => hit_expr_ptr(inner, file_id, offset, found)
        _ => {}
    }
}

fun Expr.covering_for_expr(): CoveringSpan {
    when (self.kind) {
        Call(name, _args) => {
            return CoveringSpan { span: self.span, ty: self.ty, is_expr: true, is_call: true, callee: name, recv_ty: poison_ty() }
        }
        MethodCall(recv, name, _args) => {
            return CoveringSpan { span: self.span, ty: self.ty, is_expr: true, is_call: true, callee: name, recv_ty: unsafe { recv.ty } }
        }
        _ => return plain_covering(self.span, self.ty, true)
    }
}

fun hit_expr_list(args: &List<Expr>, file_id: uint32, offset: uint32, found: &var List<CoveringSpan>): void {
    while arg in &args {
        arg.hit_expr(file_id, offset, found)
    }
}
