// The tally `komp lint` prints after a crate's diagnostics.

import alloc.list.*

import kf_core.diagnostic.*

/// "no problems", or the errors and warnings found and how many times each
/// lint fired, by name. An error with no lint behind it counts as an error.
pub fun lint_summary(diags: &List<Diagnostic>): String {
    var errors = 0
    var warnings = 0
    var names = List.new<String>()
    var counts = List.new<int32>()
    while d in &diags {
        if d.diag_is_error() { errors = errors + 1 } else { warnings = warnings + 1 }
        if d.code.is_empty() { continue }
        val at = names.position_of(d.code.as_str())
        if at < 0 {
            names.push(d.code.clone())
            counts.push(1)
        } else {
            counts.set(at as uint64, counts[at as uint64] + 1)
        }
    }
    if errors == 0 && warnings == 0 { return String.from("lint: no problems\n") }
    val error_count = plural(errors, "error")
    val warning_count = plural(warnings, "warning")
    var out = "lint: ${error_count}, ${warning_count}\n"
    var order = names.clone()
    order.sort()
    var width: uint64 = 0
    while name in &order {
        if name.byte_len() > width { width = name.byte_len() }
    }
    while name in &order {
        out.append("  ")
        out.append(name.as_str())
        while _ in name.byte_len()..width + 2 { out.push_byte(32) }
        out.append("${counts[names.position_of(name.as_str()) as uint64]}\n")
    }
    return out
}

pub fun print_lint_summary(diags: &List<Diagnostic>): void {
    print(lint_summary(diags).as_str())
}

fun plural(n: int32, noun: str): String {
    return if n == 1 { "1 ${noun}" } else { "${n} ${noun}s" }
}

/// Where `name` is in the list, or -1.
fun List<String>.position_of(name: str): int64 {
    while i in 0..self.size() {
        if self[i].as_str() == name { return i as int64 }
    }
    return -1
}
