import core.assert.assert_eq

@test
fun the_json_lists_every_group(): void {
    assert_eq(lint_list_json(&new_lint_config()).as_str().starts_with("{\"groups\":[\"correctness\","), true,
        "groups first, in the table's order")
}

@test
fun a_lint_carries_its_level_and_default(): void {
    var cfg = new_lint_config()
    cfg.set_lint_level("unused_import", LintLevel.Deny)
    val row = "\"name\":\"unused_import\",\"group\":\"style\",\"level\":\"deny\",\"default\":\"warn\""
    assert_eq(lint_list_json(&cfg).as_str().contains(row), true, "the configured level beside the default")
}

@test
fun an_option_carries_its_value_and_default(): void {
    var cfg = new_lint_config()
    cfg.options.set("too_many_parameters", "max", 4)
    assert_eq(lint_list_json(&cfg).as_str().contains("{\"key\":\"max\",\"value\":4,\"default\":7,"), true,
        "numbers, not text")
}
