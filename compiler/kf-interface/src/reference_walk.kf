// Names a declaration references, for the hidden-support closure. Matching
// them to declarations is export_set.kf's job.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.dyn_meta.*

/// Signatures and bodies: for templates, which instantiate on the consumer.
pub fun TopDecl.collect_decl_references(out: &var List<String>): void {
    self.collect_references_inner(out, true)
}

/// Signatures only: for archive-compiled declarations, whose by-value
/// signature types still need layouts on the consumer.
pub fun TopDecl.collect_signature_references(out: &var List<String>): void {
    self.collect_references_inner(out, false)
}

fun TopDecl.collect_references_inner(out: &var List<String>, with_bodies: bool): void {
    self.collect_dyn_metadata_names(out)
    while tp in &self.generics {
        while bound in &tp.bounds {
            (bound).collect_tyref_names(out)
        }
    }
    when (self.kind) {
        Function(params, ret, body, _pub, _u, _m, _s) => {
            collect_param_names(params, out)
            collect_tyref_ptr_names(unsafe { ret as Ptr<TypeRef> }, out)
            if with_bodies { collect_stmt_list_names(body, out) }
        }
        Struct(fields, _p) => {
            while field in &fields {
                collect_tyref_ptr_names(field.ty, out)
            }
        }
        EnumDecl(variants, _p) => {
            while v in &variants {
                while payload in &v.payloads {
                    (payload).collect_tyref_names(out)
                }
            }
        }
        Extern(params, ret, _pub, _u) => {
            collect_param_names(params, out)
            collect_tyref_ptr_names(unsafe { ret as Ptr<TypeRef> }, out)
        }
        ImplBlock(methods) => collect_method_names(methods, out, with_bodies)
        TraitDecl(methods, _p, _) => collect_method_names(methods, out, with_bodies)
        TraitImpl(trait_ref, methods) => {
            collect_tyref_ptr_names(unsafe { trait_ref as Ptr<TypeRef> }, out)
            collect_method_names(methods, out, with_bodies)
        }
        _ => {}
    }
}

fun collect_method_names(methods: &List<TopDecl>, out: &var List<String>, with_bodies: bool): void {
    while method in &methods {
        method.collect_references_inner(out, with_bodies)
    }
}

fun collect_param_names(params: &List<Param>, out: &var List<String>): void {
    while param in &params {
        collect_tyref_ptr_names(param.ty, out)
    }
}

fun collect_tyref_ptr_names(popt: Ptr<TypeRef>?, out: &var List<String>): void {
    val p = popt ?: return
    (unsafe { &*p }).collect_tyref_names(out)
}

pub fun TypeRef.collect_tyref_names(out: &var List<String>): void {
    when (self.kind) {
        Named(n, args) => {
            out.push(n.as_string())
            while arg in &args {
                (arg).collect_tyref_names(out)
            }
        }
        Reference(_m, inner) => collect_tyref_ptr_names(unsafe { inner as Ptr<TypeRef> }, out)
        DynTrait(name, args) => {
            out.push(name.as_string())
            while arg in &args {
                (arg).collect_tyref_names(out)
            }
        }
        _ => {}
    }
}

fun TopDecl.collect_dyn_metadata_names(out: &var List<String>): void {
    while layout in &self.dyn_layouts {
        out.push(type_identity_display(layout.principal))
        while ai in 0..layout.args.size() {
            collect_resolved_type_names(layout.args.at(ai), out)
        }
        while mi in 0..layout.methods.size() {
            val method = layout.methods.at(mi)
            var pi = 0
            while pi < method.params.size() {
                collect_resolved_type_names(method.params.at(pi), out)
                pi = pi + 1
            }
            method.ret.collect_resolved_type_names(out)
        }
    }
    while table in &self.dyn_vtables {
        table.receiver.collect_resolved_type_names(out)
    }
}

fun Type.collect_resolved_type_names(out: &var List<String>): void {
    when (self.kind) {
        Struct(name) => out.push(type_identity_display(name))
        EnumTy(name) => out.push(type_identity_display(name))
        TraitTy(name) => out.push(type_identity_display(name))
        DynTraitTy(_) => {
            out.push(type_identity_display(dyn_trait_name(self)))
            val args = dyn_trait_args(self)
            var i = 0
            while i < unsafe { args.size() } {
                val argument = unsafe { args.get(i) }
                argument.collect_resolved_type_names(out)
                i = i + 1
            }
        }
        PtrTo(inner) => collect_resolved_type_names(unsafe { &*inner }, out)
        BoxOf(inner) => collect_resolved_type_names(unsafe { &*inner }, out)
        RefTo(_mutable, inner) => collect_resolved_type_names(unsafe { &*inner }, out)
        FnTy(signature) => {
            var i = 0
            while i < unsafe { (*signature.params).size() } {
                val parameter = unsafe { (*signature.params).get(i) }
                parameter.collect_resolved_type_names(out)
                i = i + 1
            }
            collect_resolved_type_names(unsafe { &*signature.ret }, out)
        }
        Projection(owner, _member) => collect_resolved_type_names(unsafe { &*owner }, out)
        _ => { }
    }
}

fun collect_stmt_list_names(stmts: &List<Stmt>, out: &var List<String>): void {
    while stmt in &stmts {
        (stmt).collect_stmt_names(out)
    }
}

fun Stmt.collect_stmt_names(out: &var List<String>): void {
    when (self.kind) {
        LetVal(_n, ann, init) => {
            collect_tyref_ptr_names(ann.view(), out)
            val p = init ?: return
            collect_expr_names(unsafe { &*p }, out)
        }
        LetVar(_n, ann, init) => {
            collect_tyref_ptr_names(ann.view(), out)
            val p = init ?: return
            collect_expr_names(unsafe { &*p }, out)
        }
        Assign(_n, expr) => collect_expr_names(unsafe { &*expr }, out)
        AssignTo(place, expr) => {
            collect_expr_names(unsafe { &*place }, out)
            collect_expr_names(unsafe { &*expr }, out)
        }
        Return(expr) => {
            val e = expr ?: return
            collect_expr_names(unsafe { &*e }, out)
        }
        If(cond, then_body, else_body) => {
            collect_expr_names(unsafe { &*cond }, out)
            collect_stmt_list_names(then_body, out)
            collect_stmt_list_names(else_body, out)
        }
        While(cond, body) => {
            collect_expr_names(unsafe { &*cond }, out)
            collect_stmt_list_names(body, out)
        }
        When(subj, arms) => {
            collect_expr_names(unsafe { &*subj }, out)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => collect_expr_names(unsafe { &*guard }, out)
                    None => { }
                }
                collect_stmt_list_names(&arm.body, out)
            }
        }
        Switch(subj, sarms) => {
            collect_expr_names(unsafe { &*subj }, out)
            while arm in &sarms {
                when (arm.guard) {
                    Some(guard) => collect_expr_names(unsafe { &*guard }, out)
                    None => { }
                }
                collect_stmt_list_names(&arm.body, out)
            }
        }
        Expression(expr) => collect_expr_names(unsafe { &*expr }, out)
        _ => {}
    }
}

fun Expr.collect_expr_names(out: &var List<String>): void {
    while type_arg in &self.type_args {
        (type_arg).collect_tyref_names(out)
    }
    when (self.kind) {
        Call(name, args) => {
            out.push(name.as_string())
            collect_expr_list_names(args, out)
        }
        StructLit(name, finits) => {
            out.push(name.as_string())
            while fi in &finits {
                val vp: Ptr<Expr> = fi.value
                collect_expr_names(unsafe { &*vp }, out)
            }
        }
        Binary(lp, _op, rp) => {
            collect_expr_names(unsafe { &*lp }, out)
            collect_expr_names(unsafe { &*rp }, out)
        }
        Unary(_op, ip) => collect_expr_names(unsafe { &*ip }, out)
        Deref(ip) => collect_expr_names(unsafe { &*ip }, out)
        MethodCall(recv, _m, args) => {
            if self.is_static_call {
                val rk = unsafe { recv.kind }
                when (rk) {
                    Variable(tn) => { out.push(tn.as_string()) }
                    _ => {}
                }
            }
            collect_expr_names(unsafe { &*recv }, out)
            collect_expr_list_names(args, out)
        }
        FieldAccess(obj, _f) => collect_expr_names(unsafe { &*obj }, out)
        IfExpr(c, t, el) => {
            collect_expr_names(unsafe { &*c }, out)
            collect_expr_names(unsafe { &*t }, out)
            collect_expr_names(unsafe { &*el }, out)
        }
        Cast(ip, target) => {
            collect_expr_names(unsafe { &*ip }, out)
            collect_tyref_ptr_names(unsafe { target as Ptr<TypeRef> }, out)
        }
        DynCoerce(ip, _vtable) => collect_expr_names(unsafe { &*ip }, out)
        Retain(ip) => collect_expr_names(unsafe { &*ip }, out)
        _ => {}
    }
}

fun collect_expr_list_names(args: &List<Expr>, out: &var List<String>): void {
    while arg in &args {
        arg.collect_expr_names(out)
    }
}
