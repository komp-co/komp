import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Import
import kf_core.ast.Module
import kf_core.ast.new_crate_id
import kf_core.ast.declaration.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import kf_interface.*

fun stamped_module(src: str, crate_name: str): Module {
    val toks = tokenize(src, 0)
    var p = new_parser(toks)
    val parsed = p.parse_module(List.new<String>())
    val crate = new_crate_id(crate_name)
    var decls = List.new<TopDecl>()
    while i in 0..parsed.decls.size() {
        var td = *parsed.decls.at(i)
        td.crate = crate
        decls.push(td)
    }
    return Module { crate: crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun Module.first_decl(): TopDecl {
    return *self.decls.at(0)
}

@test
fun public_generic_fun_is_an_exported_template(): void {
    val m = stamped_module("pub fun id<T>(x: T): T { return x }", "aa")
    assert_eq(decl_is_exported_template(m.first_decl()), true, "public generic fun crosses as a template")
}

@test
fun private_generic_fun_is_not_exported(): void {
    val m = stamped_module("fun id<T>(x: T): T { return x }", "aa")
    assert_eq(decl_is_exported_template(m.first_decl()), false, "private generics stay out of the interface")
}

@test
fun generic_fun_is_not_a_plain_export(): void {
    val m = stamped_module("pub fun id<T>(x: T): T { return x }", "aa")
    assert_eq(decl_is_exported(m.first_decl()), false, "templates never export as bodyless declarations")
}

@test
fun primitive_trait_impl_crosses_interface(): void {
    val m = stamped_module("""trait Show { fun show(): String }
impl Show for int32 { fun show(): String { return String.from("") } }""", "aa")
    val impl_decl = *m.decls.at(1)
    assert_eq(impl_target_is_exported(impl_decl, &m, new_crate_id("aa")), true, "primitive trait implementations cross the interface")
}

@test
fun synthesized_template_is_not_exported(): void {
    var td = new_top_decl(no_span(), String.from("Synth"), TopDeclKind.Struct(List.new<Field>(), true))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    assert_eq(decl_is_exported_template(td), false, "no source extent means nothing to slice")
}

@test
fun hidden_support_includes_called_private_fun(): void {
    val src = "pub fun run<T>(x: T): T { helper()\nreturn x }\nfun helper(): void { }"
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "helper"), true, "template body pulls the private fn it calls")
}

@test
fun hidden_support_excludes_public_fun(): void {
    val src = "pub fun run<T>(x: T): T { helper()\nreturn x }\npub fun helper(): void { }"
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "helper"), false, "public decls already cross the interface")
}

@test
fun hidden_support_walks_private_fn_signatures(): void {
    val src = """pub fun run<T>(x: T): T { helper(make())
return x }
struct Inner { val n: int32 }
fun make(): Inner { return Inner { n: 0 } }
fun helper(v: Inner): void { }"""
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "Inner"), true, "private fn signature pulls its private param layout")
}

@test
fun hidden_support_is_cycle_safe(): void {
    val src = """pub fun run<T>(x: T): T { ping<T>(x)
return x }
fun ping<T>(x: T): T { return pong<T>(x) }
fun pong<T>(x: T): T { return ping<T>(x) }"""
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "ping") && hidden_name_in(&hidden, "pong"), true, "mutually recursive templates terminate and both ride along")
}

@test
fun hidden_support_pulls_impls_of_hidden_types(): void {
    val src = """pub fun run<T>(x: T): T { val v = make()
return x }
struct Inner { val n: int32 }
impl Inner { pub fun get(): int32 { return self.n } }
fun make(): Inner { return Inner { n: 0 } }"""
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "Inner"), true, "hidden type name covers its layout and impls")
}

@test
fun hidden_support_ignores_other_crates(): void {
    val src = "pub fun run<T>(x: T): T { helper()\nreturn x }"
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden.size(), 0 as uint64, "an unresolved name pulls nothing")
}

@test
fun hidden_support_includes_referenced_externs(): void {
    // Generic library code calls externs; their signatures ride along.
    val src = """extern "C" fun raw_len(s: str): uint64
pub fun measure<T>(x: T): uint64 { return unsafe { raw_len("a") } }"""
    val m = stamped_module(src, "aa")
    val hidden = m.collect_hidden_support(new_crate_id("aa"))
    assert_eq(hidden_name_in(&hidden, "raw_len"), true, "template body pulls the extern it calls")
}

@test
fun extern_reference_is_not_diagnosed(): void {
    val src = """extern "C" fun raw_len(s: str): uint64
pub fun measure<T>(x: T): uint64 { return unsafe { raw_len("a") } }"""
    val m = stamped_module(src, "aa")
    val errors = m.export_closure_diagnostics(new_crate_id("aa"))
    assert_eq(errors.size(), 0 as uint64, "externs are carried as hidden support, not errors")
}

@test
fun closure_diagnoses_unsliceable_public_template(): void {
    var td = new_top_decl(no_span(), String.from("Ghost"), TopDeclKind.Struct(List.new<Field>(), true))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    td.crate = new_crate_id("aa")
    var decls = List.new<TopDecl>()
    decls.push(td)
    val m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val errors = m.export_closure_diagnostics(new_crate_id("aa"))
    assert_eq(errors.size(), 1 as uint64, "a public template without source text is an error")
}

@test
fun closure_is_quiet_for_clean_templates(): void {
    val src = "pub fun id<T>(x: T): T { return x }"
    val m = stamped_module(src, "aa")
    val errors = m.export_closure_diagnostics(new_crate_id("aa"))
    assert_eq(errors.size(), 0 as uint64, "a self-contained template needs no diagnostics")
}
