import alloc.list.*

import kf_core.ast.CrateId
import kf_core.ast.Module
import kf_core.ast.type_retain_fn
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*

pub struct OwnershipGlue {
    pub val type_name: String
    pub val retain: String
    pub val drop: String
    pub val clone: String
}

pub fun Module.collect_public_glue(crate: CrateId): List<OwnershipGlue> {
    var out = List.new<OwnershipGlue>()
    var seen = List.new<String>()
    while td in &self.decls {
        if td.crate.raw == crate.raw {
            collect_glue_seeds(td, self, crate, &var out, &var seen)
        }
    }
    return out
}

fun collect_glue_seeds(td: TopDecl, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    if td.generics.size() > 0 { return }
    when (td.kind) {
        Struct(_fields, is_pub) => {
            if is_pub { add_owned_layout(td.name.as_str(), m, crate, out, seen) }
        }
        EnumDecl(_variants, is_pub) => {
            if is_pub { add_owned_layout(td.name.as_str(), m, crate, out, seen) }
        }
        Function(params, ret, _body, is_pub, _unsafe, _mutating, _static) => {
            if is_pub {
                collect_param_types(params, m, crate, out, seen)
                collect_type_ptr(ret, m, crate, out, seen)
            }
        }
        ImplBlock(methods) => collect_public_method_types(methods, m, crate, out, seen)
        TraitDecl(methods, is_pub, _) => {
            if is_pub { collect_public_method_types(methods, m, crate, out, seen) }
        }
        TraitImpl(_trait_ref, methods) => collect_public_method_types(methods, m, crate, out, seen)
        _ => {}
    }
}

fun collect_public_method_types(methods: &List<TopDecl>, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    while method in &methods {
        when (method.kind) {
            Function(params, ret, _body, is_pub, _unsafe, _mutating, _static) => {
                if is_pub {
                    collect_param_types(params, m, crate, out, seen)
                    collect_type_ptr(ret, m, crate, out, seen)
                }
            }
            _ => {}
        }
    }
}

fun collect_param_types(params: &List<Param>, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    while param in &params {
        collect_type_ptr(param.ty, m, crate, out, seen)
    }
}

fun collect_type_ptr(ptr: Ptr<TypeRef>, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    val raw: uint64 = unsafe { ptr as uint64 }
    if raw == 0 { return }
    val ty: TypeRef = unsafe { *ptr }
    collect_type_ref(ty, m, crate, out, seen)
}

fun collect_type_ref(ty: TypeRef, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    when (ty.kind) {
        Named(name, args) => {
            if args.size() == 0 { add_owned_layout(name.as_str(), m, crate, out, seen) }
        }
        DynTrait(_name, args) => {
            while arg in &args {
                collect_type_ref(arg, m, crate, out, seen)
            }
        }
        Reference(_mutating, _inner) => {}
        Function(_params, _ret) => {}
        Array(_element, _size) => {}
        Projection(_owner, _member) => {}
        Value(_v) => {}
        Poison => {}
    }
}

fun add_owned_layout(name: str, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    if glue_name_seen(seen, name) { return }
    while td in &m.decls {
        if td.crate.raw == crate.raw && td.name.as_str() == name && td.generics.size() == 0 {
            when (td.kind) {
                Struct(fields, _is_pub) => {
                    append_glue(String.from(td.name.as_str()), crate, out, seen)
                    collect_field_layouts(fields, m, crate, out, seen)
                    return
                }
                EnumDecl(variants, _is_pub) => {
                    append_glue(String.from(td.name.as_str()), crate, out, seen)
                    collect_variant_layouts(variants, m, crate, out, seen)
                    return
                }
                _ => {}
            }
        }
    }
}

fun append_glue(name: String, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    seen.push(name.clone())
    var c_name = crate.symbol_prefix()
    c_name.append(name.as_str())
    val retain = type_retain_fn(c_name.as_str())
    var drop = c_name.clone()
    drop.append("_drop")
    var clone = c_name.clone()
    clone.append("_clone")
    out.push(OwnershipGlue {
        type_name: name,
        retain: retain,
        drop: drop,
        clone: clone
    })
}

fun collect_field_layouts(fields: &List<Field>, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    while field in &fields {
        collect_type_ptr(field.ty, m, crate, out, seen)
    }
}

fun collect_variant_layouts(variants: &List<Variant>, m: &Module, crate: CrateId, out: &var List<OwnershipGlue>, seen: &var List<String>): void {
    while variant in &variants {
        while payload in &variant.payloads {
            collect_type_ref(payload, m, crate, out, seen)
        }
    }
}

fun glue_name_seen(seen: &List<String>, name: str): bool {
    while item in &seen {
        if item.as_str() == name { return true }
    }
    return false
}
