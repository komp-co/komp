import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*

fun glue_owned_decl(td: TopDecl): TopDecl {
    var owned = td
    owned.crate = new_crate_id("sample")
    owned.module_path = intern("sample.api")
    return owned
}

fun glue_type_ptr(name: str): Ptr<TypeRef> {
    val out: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *out = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>())) }
    return out
}

fun String.glue_name_view(): str {
    return self.as_str()
}

fun glue_closure_module(): Module {
    var envelope_fields = List.new<Field>()
    envelope_fields.push(new_field(no_span(), String.from("payload"), glue_type_ptr("Payload"), false, true))
    envelope_fields.push(new_field(no_span(), String.from("count"), glue_type_ptr("int32"), false, true))
    var payload_fields = List.new<Field>()
    payload_fields.push(new_field(no_span(), String.from("label"), glue_type_ptr("String"), false, false))
    var decls = List.new<TopDecl>()
    decls.push(glue_owned_decl(new_top_decl(no_span(), String.from("Envelope"), TopDeclKind.Struct(envelope_fields, true))))
    decls.push(glue_owned_decl(new_top_decl(no_span(), String.from("Payload"), TopDeclKind.Struct(payload_fields, false))))
    return Module {
        crate: new_crate_id("sample"),
        path: List.new<String>(),
        decls: decls,
        imports: List.new<Import>()
    }
}

@test
fun public_glue_closure_includes_private_owned_layouts_once(): void {
    val module = glue_closure_module()
    val glue = module.collect_public_glue(new_crate_id("sample"))
    assert_eq(glue.size(), 2, "public ABI closure contains both owned layouts")
}

@test
fun public_glue_symbols_use_qualified_c_type_names(): void {
    val module = glue_closure_module()
    val glue = module.collect_public_glue(new_crate_id("sample"))
    assert_eq((*glue.at(1)).drop.as_str(), "sample__Payload_drop", "private support glue uses owner-qualified symbols")
}

@test
fun ownership_glue_stores_compiler_names_as_str(): void {
    val module = glue_closure_module()
    val glue = module.collect_public_glue(new_crate_id("sample"))
    val item = glue.at(0)
    assert_eq(item.type_name.glue_name_view(), "Envelope", "ownership glue keeps owned compiler names in String")
}
