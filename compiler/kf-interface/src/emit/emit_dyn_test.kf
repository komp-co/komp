import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind

fun dyn_interface_module(): Module {
    return dyn_interface_module_with(false)
}

/// Parameterised so the hash test builds a changed module instead of mutating
/// `DynTraitLayout.methods`, which is `val`.
fun dyn_interface_module_with(send_mutating: bool): Module {
    var module = interface_test_module()
    var args = List.new<Type>()
    args.push(Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) })
    var methods = List.new<DynMethodSlot>()
    var send_params = List.new<Type>()
    send_params.push(Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) })
    methods.push(DynMethodSlot { name: intern("send"), params: send_params, ret: Type { kind: TypeKind.Void, provenance: Provenance.Inferred(no_span()) }, is_mutating: send_mutating, slot: 0 })
    methods.push(DynMethodSlot { name: intern("reset"), params: List.new<Type>(), ret: Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(no_span()) }, is_mutating: true, slot: 1 })
    val crate = new_crate_id("sample")
    val anchor = module.decls.at_mut(0)
    anchor.dyn_layouts.push(DynTraitLayout {
        identity: intern("Sink__int32"), principal: intern("Sink"), args: args, methods: methods,
        owner: crate, imported: false
    })
    var adapters = List.new<Sym>()
    adapters.push(intern("sample__Point_send__Sink__int32"))
    adapters.push(intern("sample__Point_reset__Sink__int32"))
    anchor.dyn_vtables.push(DynVTableInstance {
        layout: intern("Sink__int32"), receiver: Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Inferred(no_span()) },
        receiver_identity: intern("Point"), symbol: intern("DynVTableInstance__Point__Sink__int32"), adapters: adapters,
        owner: crate, linkage: Linkage.Source
    })
    return module
}

pub fun emitted_dyn_interface(): String {
    val module = dyn_interface_module()
    return module.emit_interface(String.from("sample"), &List.new<String>())
}

@test fun dyn_interface_emits_layout_identity_and_arguments(): void {
    val output = emitted_dyn_interface()
    assert_eq(interface_contains(output.as_str(), "\"dyn_traits\":[{\"identity\":\"Sink__int32\",\"principal\":\"Sink\",\"args\":[\"int32\"]"), true, "dynamic layout identity and concrete arguments are serialized")
}

@test fun dyn_interface_emits_slots_in_declaration_order(): void {
    val output = emitted_dyn_interface()
    val expected = "\"methods\":[{\"name\":\"send\",\"slot\":0,\"mutating\":false,\"params\":[\"int32\"],\"ret\":\"void\"},{\"name\":\"reset\",\"slot\":1,\"mutating\":true"
    assert_eq(interface_contains(output.as_str(), expected), true, "dynamic methods preserve slot order and signatures")
}

@test fun dyn_interface_emits_vtable_ownership_and_symbols(): void {
    val output = emitted_dyn_interface()
    val expected = "\"dyn_vtables\":[{\"layout\":\"Sink__int32\",\"receiver\":\"Point\",\"receiver_identity\":\"Point\",\"symbol\":\"DynVTableInstance__Point__Sink__int32\",\"owner\":\"sample\",\"linkage\":\"exported\""
    assert_eq(interface_contains(output.as_str(), expected), true, "vtable identity, owner, and linkage are serialized")
}

@test fun dyn_interface_uses_the_exact_cross_crate_c_symbol(): void {
    val module = dyn_interface_module()
    val table = *module.decls.at(0).dyn_vtables.at(0)
    val canonical = DynVTableInstance {
        layout: intern("shape_api::shape_api::Draw"), receiver: table.receiver,
        receiver_identity: intern("shape_impl::shape_impl::Secret"), symbol: table.symbol,
        adapters: table.adapters, owner: table.owner, linkage: table.linkage
    }
    assert_eq(canonical.interface_dyn_vtable_symbol().as_str(), "DynVTableInstance__shape_impl__Secret__Draw", "interface symbols match the implementation archive")
}

@test fun dyn_interface_omits_consumer_local_vtable_requirements(): void {
    var module = dyn_interface_module()
    val anchor = module.decls.at_mut(0)
    val table = *anchor.dyn_vtables.at(0)
    val requirement = DynVTableInstance {
        layout: table.layout, receiver: table.receiver, receiver_identity: table.receiver_identity,
        symbol: table.symbol, adapters: List.new<Sym>(), owner: table.owner, linkage: table.linkage
    }
    anchor.dyn_vtables = List.new<DynVTableInstance>()
    anchor.dyn_vtables.push(requirement)
    val output = module.emit_interface(String.from("sample"), &List.new<String>())
    assert_eq(interface_contains(output.as_str(), "\"dyn_vtables\":[]"), true, "consumer-local vtable requirements do not become exported ABI")
}

@test fun dyn_interface_emission_is_byte_identical(): void {
    val first = emitted_dyn_interface()
    val second = emitted_dyn_interface()
    assert_eq(first.as_str(), second.as_str(), "dynamic interface metadata is deterministic")
}

@test fun dyn_interface_slot_change_changes_content_hash(): void {
    val first = emitted_dyn_interface()
    val changed = dyn_interface_module_with(true)
    val second = changed.emit_interface(String.from("sample"), &List.new<String>())
    assert_eq(first.as_str() != second.as_str(), true, "a dynamic ABI change changes the interface text")
}
