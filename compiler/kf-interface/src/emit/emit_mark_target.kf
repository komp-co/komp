// An annotation's target in its interface record: the function type's or
// signature pattern's source, "" for a list of kinds, and the kinds, each
// with its bounds:
//
//     "function":"","kinds":[{"kind":"struct","bounds":["Plugin"]}]
//
// and its type parameters, the implicit ones included, each with its bounds:
// "params":[{"name":"T","bounds":["Display"]}].

import alloc.list.*

import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.MarkTarget
import kf_core.ast.declaration.TypeParam
import json.writer.JsonWriter

fun MarkTarget.function_source(): String {
    return when (self) {
        Function(ty) => (*ty).tyref_to_source()
        Signature(params, has_rest, ret) => signature_source(&params, has_rest, &*ret)
        _ => String.from("")
    }
}

fun MarkTarget.kinds_json(): String {
    var kinds = JsonWriter.array()
    val listed = self.kinds()
    while target in &listed {
        var o = JsonWriter.object()
        o.field_string("kind", target.kind.word())
        var bounds = JsonWriter.array()
        while bound in &target.bounds {
            bounds.write_string(bound.tyref_to_source().as_str())
        }
        o.field_raw("bounds", bounds.finish().as_str())
        kinds.write_raw(o.finish().as_str())
    }
    return kinds.finish()
}

/// `(bool, _, ..) -> _`, as the parser reads it back.
fun signature_source(params: &List<TypeRef>, has_rest: bool, ret: &TypeRef): String {
    var out = String.from("(")
    while i in 0..params.size() {
        if i > 0 { out.append(", ") }
        out.append(params.at(i).tyref_to_source().as_str())
    }
    if has_rest { out.append(if params.size() > 0 { ", .." } else { ".." }) }
    out.append(") -> ")
    out.append(ret.tyref_to_source().as_str())
    return out
}

fun type_params_json(params: &List<TypeParam>): String {
    var out = JsonWriter.array()
    while param in &params {
        var o = JsonWriter.object()
        o.field_string("name", param.name.as_str())
        var bounds = JsonWriter.array()
        while bound in &param.bounds {
            bounds.write_string(bound.tyref_to_source().as_str())
        }
        o.field_raw("bounds", bounds.finish().as_str())
        out.write_raw(o.finish().as_str())
    }
    return out.finish()
}
