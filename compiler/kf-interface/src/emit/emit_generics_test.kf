import alloc.list.*
import core.assert.assert_eq

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.declaration.new_top_decl
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import kf_interface.parse.*

fun generics_source_map(): Ptr<SourceMap> {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    return smap
}

// Templates can only be sliced from a file registered in the SourceMap.
fun mapped_module(src: str, crate_name: str, smap: Ptr<SourceMap>): Module {
    val fid = unsafe { smap.add_file(new_source_file(String.from("lib.kf"), String.from(src))) }
    val tokens = tokenize(src, fid)
    var p = new_parser(tokens)
    val parsed = p.parse_module(List.new<String>())
    val crate = new_crate_id(crate_name)
    var decls = List.new<TopDecl>()
    while i in 0..parsed.decls.size() {
        var td = *parsed.decls.at(i)
        td.crate = crate
        td.module_path = intern("sample.api")
        decls.push(td)
    }
    return Module { crate: crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun emit_mapped(src: str): String {
    val smap = generics_source_map()
    val m = mapped_module(src, "sample", smap)
    return m.emit_interface_full(String.from("sample"), &List.new<String>(), &List.new<String>(), smap)
}

fun generics_contains(haystack: str, needle: str): bool {
    val hn = haystack.byte_len()
    val nn = needle.byte_len()
    if nn == 0 { return true }
    if hn < nn { return false }
    var i: uint64 = 0
    while i + nn <= hn {
        var matches = true
        var j: uint64 = 0
        while j < nn {
            if haystack.byte_at(i + j) != needle.byte_at(j) {
                matches = false
            }
            j = j + 1
        }
        if matches { return true }
        i = i + 1
    }
    return false
}

@test
fun template_entry_carries_declaration_source(): void {
    val out = emit_mapped("pub fun id<T>(x: T): T { return x }")
    assert_eq(generics_contains(out.as_str(), "\"kind\":\"generic\",\"hidden\":false,\"name\":\"id\",\"src\":\"pub fun id<T>(x: T): T { return x }\""), true, "template crosses as its own source text")
}

@test
fun template_emission_is_deterministic(): void {
    val src = "pub fun id<T>(x: T): T { return x }"
    val smap = generics_source_map()
    val m = mapped_module(src, "sample", smap)
    val first = m.emit_interface_full(String.from("sample"), &List.new<String>(), &List.new<String>(), smap)
    val second = m.emit_interface_full(String.from("sample"), &List.new<String>(), &List.new<String>(), smap)
    assert_eq(first.as_str(), second.as_str(), "template emission is byte-identical on repeat")
}

@test
fun hidden_helper_rides_along_marked_hidden(): void {
    val out = emit_mapped("pub fun run<T>(x: T): T { helper()\nreturn x }\nfun helper(): void { }")
    assert_eq(generics_contains(out.as_str(), "\"kind\":\"fun\",\"hidden\":true,\"name\":\"helper\",\"pub\":false,\"link_name\":\"sample__helper\""), true, "private helper crosses bodyless with its archive symbol")
}

@test
fun private_fun_without_template_stays_out(): void {
    val out = emit_mapped("pub fun visible(): void { }\nfun helper(): void { }")
    assert_eq(generics_contains(out.as_str(), "helper"), false, "no template means no hidden support")
}

@test
fun template_annotation_is_reconstructed(): void {
    val out = emit_mapped("@derive(Default)\npub struct Wrap<T> { val v: T }")
    assert_eq(generics_contains(out.as_str(), "\"src\":\"@derive(Default)\\npub struct Wrap<T> { val v: T }\""), true, "annotation rides in front of the slice")
}

fun round_trip_generics(src: str): InterfaceLoad {
    val emit_map = generics_source_map()
    val m = mapped_module(src, "sample", emit_map)
    val encoded = m.emit_interface_full(String.from("sample"), &List.new<String>(), &List.new<String>(), emit_map)
    return parse_interface_mapped(encoded.as_str(), generics_source_map())
}

fun InterfaceLoad.find_decl(name: str): TopDecl {
    while m in &self.modules {
        while j in 0..m.decls.size() {
            val td = *m.decls.at(j)
            if td.name.as_str() == name { return td.clone() }
        }
    }
    return new_top_decl(no_span(), "", TopDeclKind.Poison)
}

@test
fun restored_template_carries_template_linkage(): void {
    val loaded = round_trip_generics("pub fun id<T>(x: T): T { return x }")
    val td = loaded.find_decl("id")
    assert_eq(td.linkage.is_template(), true, "restored template is marked GenericTemplate")
}

@test
fun restored_template_keeps_type_params(): void {
    val loaded = round_trip_generics("pub fun id<T>(x: T): T { return x }")
    val td = loaded.find_decl("id")
    assert_eq(td.generics.size(), 1 as uint64, "type parameters survive the round trip")
}

@test
fun restored_template_keeps_its_body(): void {
    val loaded = round_trip_generics("pub fun id<T>(x: T): T { return x }")
    val td = loaded.find_decl("id")
    var body_size: uint64 = 0
    when (td.kind) {
        Function(_p, _r, body, _pub, _u, _m, _s) => { body_size = body.size() }
        _ => {}
    }
    assert_eq(body_size, 1 as uint64, "template body statements are restored")
}

@test
fun restored_template_keeps_bounds(): void {
    val loaded = round_trip_generics("pub fun show<T: Displayable>(x: T): T { return x }")
    val td = loaded.find_decl("show")
    val tp = *td.generics.at(0)
    assert_eq(tp.bounds.size(), 1 as uint64, "trait bounds survive the round trip")
}

@test
fun restored_template_keeps_module_path(): void {
    val loaded = round_trip_generics("pub fun id<T>(x: T): T { return x }")
    val td = loaded.find_decl("id")
    assert_eq(td.module_path.as_str(), "sample.api", "template restores into its original module")
}

@test
fun restored_hidden_helper_is_hidden_support(): void {
    val loaded = round_trip_generics("pub fun run<T>(x: T): T { helper()\nreturn x }\nfun helper(): void { }")
    val td = loaded.find_decl("helper")
    assert_eq(td.linkage.is_hidden(), true, "hidden helper restores as HiddenSupport")
}

@test
fun restored_hidden_helper_keeps_link_name(): void {
    val loaded = round_trip_generics("pub fun run<T>(x: T): T { helper()\nreturn x }\nfun helper(): void { }")
    val td = loaded.find_decl("helper")
    assert_eq(td.link_name.as_str(), "sample__helper", "hidden helper calls through its archive symbol")
}

@test
fun corrupt_template_source_is_a_normal_load_error(): void {
    val source = "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":[],\"dyn_vtables\":[],\"modules\":[{\"path\":\"sample.api\",\"files\":[],\"decls\":[{\"kind\":\"generic\",\"hidden\":false,\"name\":\"id\",\"src\":\"fun id<T>(\"}],\"reexports\":[]}]}"
    val loaded = parse_interface(source)
    assert_eq(loaded.ok, false, "unparseable template text is diagnosed, not crashed on")
}

@test
fun restored_extern_is_hidden_support(): void {
    val loaded = round_trip_generics("""extern "C" fun raw_len(s: str): uint64
pub fun measure<T>(x: T): uint64 { return unsafe { raw_len("a") } }""")
    val td = loaded.find_decl("raw_len")
    var is_extern = false
    when (td.kind) {
        Extern(_p, _r, _pub, _u) => { is_extern = true }
        _ => {}
    }
    assert_eq(is_extern && td.linkage.is_hidden(), true, "extern signature restores as hidden support")
}
