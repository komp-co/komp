import alloc.list.*

import kf_core.ast.*
import json.writer.*
import kf_core.ast.dyn_meta.*

pub fun Module.emit_interface_dyn_traits(crate: CrateId): String {
    val layouts = self.collect_interface_dyn_traits(crate)
    var array = JsonWriter.array()
    while layout in &layouts {
        var object = JsonWriter.object()
        object.field_string("identity", layout.identity.as_str())
        object.field_string("principal", layout.principal.as_str())
        object.field_raw("args", emit_dyn_types(&layout.args).as_str())
        object.field_raw("methods", emit_dyn_methods(&layout.methods).as_str())
        array.write_raw(object.finish().as_str())
    }
    return array.finish()
}

pub fun Module.emit_interface_dyn_vtables(crate: CrateId): String {
    val tables = self.collect_interface_dyn_vtables(crate)
    var array = JsonWriter.array()
    while table in &tables {
        var object = JsonWriter.object()
        object.field_string("layout", table.layout.as_str())
        object.field_string("receiver", table.receiver.dyn_type_to_source().as_str())
        object.field_string("receiver_identity", table.receiver_identity.as_str())
        object.field_string("symbol", table.interface_dyn_vtable_symbol().as_str())
        object.field_string("owner", dyn_crate_name(table.owner).as_str())
        object.field_string("linkage", dyn_linkage_name(table.linkage))
        object.field_raw("adapters", emit_dyn_symbols(&table.adapters).as_str())
        array.write_raw(object.finish().as_str())
    }
    return array.finish()
}

fun emit_dyn_methods(methods: &List<DynMethodSlot>): String {
    var array = JsonWriter.array()
    while method in &methods {
        var object = JsonWriter.object()
        object.field_string("name", method.name.as_str())
        object.field_int64("slot", method.slot as int64)
        object.field_bool("mutating", method.is_mutating)
        object.field_raw("params", emit_dyn_types(&method.params).as_str())
        object.field_string("ret", method.ret.dyn_type_to_source().as_str())
        array.write_raw(object.finish().as_str())
    }
    return array.finish()
}

fun emit_dyn_types(types: &List<Type>): String {
    var array = JsonWriter.array()
    while item in &types {
        array.write_string(item.dyn_type_to_source().as_str())
    }
    return array.finish()
}

fun emit_dyn_symbols(symbols: &List<Sym>): String {
    var array = JsonWriter.array()
    while symbol in &symbols {
        array.write_string(symbol.as_str())
    }
    return array.finish()
}

pub fun Type.dyn_type_to_source(): String {
    when (self.kind) {
        Int8 => return String.from("int8")
        Int16 => return String.from("int16")
        Int32 => return String.from("int32")
        Int64 => return String.from("int64")
        UInt8 => return String.from("uint8")
        UInt16 => return String.from("uint16")
        UInt32 => return String.from("uint32")
        UInt64 => return String.from("uint64")
        Float32 => return String.from("float32")
        Float64 => return String.from("float64")
        Bool => return String.from("bool")
        Char => return String.from("char")
        StrTy => return String.from("str")
        Void => return String.from("void")
        Never => return String.from("never")
        Struct(name) => return type_identity_display(name)
        EnumTy(name) => return type_identity_display(name)
        TraitTy(name) => return type_identity_display(name)
        Generic(name) => return name.as_string()
        DynTraitTy(_) => return self.dyn_trait_type_source()
        PtrTo(inner) => return dyn_wrapped_type_source("Ptr<", unsafe { &*inner }, ">")
        BoxOf(inner) => return dyn_wrapped_type_source("Box<", unsafe { &*inner }, ">")
        ArrayOf(_inner, length) => return "${self.array_element().dyn_type_to_source()}[${length}]"
        RefTo(mutable, inner) => {
            if mutable { return dyn_wrapped_type_source("&var ", unsafe { &*inner }, "") }
            return dyn_wrapped_type_source("&", unsafe { &*inner }, "")
        }
        FnTy(signature) => return dyn_function_type_source(unsafe { &*signature })
        Projection(_, _) => return String.from("poison")
        Poison => return String.from("poison")
    }
}

fun Type.dyn_trait_type_source(): String {
    var result = String.from("dyn ")
    result.append(type_identity_display(dyn_trait_name(self)).as_str())
    val args = dyn_trait_args(self)
    if unsafe { args as uint64 } == 0 || unsafe { args.size() } == 0 { return result }
    result.append("<")
    var i = 0
    while i < unsafe { args.size() } {
        if i > 0 { result.append(", ") }
        val argument = unsafe { args.get(i) }
        result.append(argument.dyn_type_to_source().as_str())
        i = i + 1
    }
    result.append(">")
    return result
}

fun dyn_wrapped_type_source(prefix: str, inner: &Type, suffix: str): String {
    var result = String.from(prefix)
    result.append(inner.dyn_type_to_source().as_str())
    result.append(suffix)
    return result
}

fun FnSig.dyn_function_type_source(): String {
    var result = String.from("(")
    var i = 0
    while i < unsafe { (*self.params).size() } {
        if i > 0 { result.append(", ") }
        val parameter = unsafe { (*self.params).get(i) }
        result.append(parameter.dyn_type_to_source().as_str())
        i = i + 1
    }
    result.append(") -> ")
    result.append(dyn_type_to_source(unsafe { &*self.ret }).as_str())
    return result
}

fun Module.collect_interface_dyn_traits(crate: CrateId): List<DynTraitLayout> {
    var result = List.new<DynTraitLayout>()
    while declaration in &self.decls {
        while j in 0..declaration.dyn_layouts.size() {
            val layout = declaration.dyn_layouts.at(j)
            if self.interface_dyn_layout_required(crate, layout.identity, layout.owner) && !dyn_layout_emitted(&result, layout.identity) {
                result.push(clone_dyn_trait_layout(layout))
            }
        }
    }
    return result
}

fun Module.interface_dyn_layout_required(crate: CrateId, identity: Sym, owner: CrateId): bool {
    if owner.raw == crate.raw { return true }
    while declaration in &self.decls {
        while table in &declaration.dyn_vtables {
            if table.owner.raw == crate.raw && table.layout.id == identity.id { return true }
        }
    }
    return false
}

fun Module.collect_interface_dyn_vtables(crate: CrateId): List<DynVTableInstance> {
    var result = List.new<DynVTableInstance>()
    while declaration in &self.decls {
        var j = 0
        while j < declaration.dyn_vtables.size() {
            val table = declaration.dyn_vtables.at(j)
            if table.owner.raw == crate.raw && table.adapters.size() > 0 {
                val exported = table.interface_dyn_vtable_record(declaration.generics.size() > 0)
                merge_interface_dyn_vtable(&var result, &exported)
            }
            j = j + 1
        }
    }
    return result
}

fun DynVTableInstance.interface_dyn_vtable_record(generic: bool): DynVTableInstance {
    val linkage = if generic { Linkage.GenericTemplate } else { self.linkage }
    return DynVTableInstance {
        layout: self.layout, receiver: self.receiver.clone(),
        receiver_identity: self.receiver_identity, symbol: self.symbol,
        adapters: clone_dyn_symbol_list(&self.adapters), owner: self.owner,
        linkage: linkage
    }
}

fun DynVTableInstance.interface_dyn_vtable_symbol(): String {
    var receiver = type_identity_display(self.receiver_identity)
    val receiver_crate = canonical_identity_crate(self.receiver_identity)
    if !receiver_crate.is_poison() {
        receiver = receiver_crate.symbol_prefix() + receiver
    }
    return "DynVTableInstance__${receiver}__${type_identity_display(self.layout)}"
}

fun clone_dyn_symbol_list(source: &List<Sym>): List<Sym> {
    var result = List.new<Sym>()
    while item in &source {
        result.push(item)
    }
    return result
}

fun merge_interface_dyn_vtable(result: &var List<DynVTableInstance>, table: &DynVTableInstance): void {
    var i = 0
    while i < result.size() {
        val existing = result.at(i)
        if existing.layout.id == table.layout.id && existing.receiver_identity.id == table.receiver_identity.id {
            if existing.adapters.size() == 0 && table.adapters.size() > 0 {
                result.set(i, clone_dyn_vtable_instance(table))
            }
            return
        }
        i = i + 1
    }
    result.push(clone_dyn_vtable_instance(table))
}

fun dyn_layout_emitted(layouts: &List<DynTraitLayout>, identity: Sym): bool {
    while layout in &layouts {
        if layout.identity.id == identity.id { return true }
    }
    return false
}

fun dyn_linkage_name(linkage: Linkage): str {
    return when (linkage) {
        GenericTemplate => "generic"
        ImportedCompiled => "imported"
        HiddenSupport => "hidden"
        _ => "exported"
    }
}

fun dyn_crate_name(crate: CrateId): String {
    return Sym { id: crate.raw }.as_string()
}
