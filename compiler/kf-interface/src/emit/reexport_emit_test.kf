import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.new_reexport
import kf_core.ast.new_renaming_reexport
import kf_core.span.no_span

fun reexporting_module(): Module {
    var m = interface_test_module()
    var path = List.new<String>()
    path.push(String.from("sample"))
    path.push(String.from("parse"))
    path.push(String.from("read"))
    m.imports.push(new_reexport(no_span(), path, false, String.from("sample.api")))
    return m
}

@test fun a_module_carries_its_reexports(): void {
    val out = reexporting_module().emit_interface(String.from("sample"), &List.new<String>())
    val expected = "\"reexports\":[{\"path\":\"sample.parse.read\",\"wildcard\":false,\"as\":\"\"}]"
    assert_eq(interface_contains(out.as_str(), expected), true, "the export as written")
}

@test fun a_dependencys_reexport_is_not_carried_as_this_crates(): void {
    var m = interface_test_module()
    var path = List.new<String>()
    path.push(String.from("other"))
    path.push(String.from("thing"))
    m.imports.push(new_reexport(no_span(), path, true, String.from("other")))
    val out = m.emit_interface(String.from("sample"), &List.new<String>())
    assert_eq(interface_contains(out.as_str(), "other.thing"), false, "only this crate's re-exports")
}

@test fun a_renamed_export_carries_its_new_name(): void {
    var m = interface_test_module()
    var path = List.new<String>()
    path.push(String.from("sample"))
    path.push(String.from("parse"))
    path.push(String.from("read"))
    var imp = new_renaming_reexport(no_span(), path, String.from("parse_file"))
    imp.owner = String.from("sample.api")
    m.imports.push(imp)
    val out = m.emit_interface(String.from("sample"), &List.new<String>())
    assert_eq(interface_contains(out.as_str(), "\"as\":\"parse_file\""), true, "the `as` name crosses the interface")
}
