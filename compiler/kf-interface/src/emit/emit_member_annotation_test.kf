import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.annotation.new_annotation
import kf_interface.parse.parse_interface

/// `@rename("id")`.
fun rename_use(): Annotation {
    var args = List.new<AnnotationArg>()
    val value = Expr.new(no_span(), ExprKind.LitStr(String.from("id")))
    args.push(AnnotationArg { name: intern(""), value: Box.new(value) })
    return Annotation { name: intern("rename"), args: args, has_parens: true, span: no_span() }
}

fun member_module(kind: TopDeclKind): Module {
    var decl = new_top_decl(no_span(), String.from("User"), kind)
    decl.crate = new_crate_id("sample")
    decl.module_path = intern("sample")
    var decls = List.new<TopDecl>()
    decls.push(decl)
    return Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

/// The first member's uses as `m` reads back, each as written.
fun round_trip_member_uses(m: Module): String {
    val out = m.emit_interface(String.from("sample"), &List.new<String>())
    val loaded = parse_interface(out.as_str())
    var text = String.from("")
    while module in &loaded.modules {
        while td in &module.decls {
            val uses = when (td.kind) {
                Struct(fields, _pub) => fields.at(0).annotations.clone()
                EnumDecl(variants, _pub) => variants.at(0).annotations.clone()
                _ => List.new<Annotation>()
            }
            while annotation in &uses {
                if text.byte_len() > 0 { text.append(" ") }
                text.append(annotation.to_source().as_str())
            }
        }
    }
    return text
}

@test
fun a_field_annotation_crosses_the_interface(): void {
    var field = new_field(no_span(), String.from("user_id"), Box.new(TypeRef.new(no_span(),
        TypeRefKind.Named(intern("int64"), List.new<TypeRef>()))), false, true)
    field.annotations.push(rename_use())
    field.annotations.push(new_annotation(no_span(), "skip", List.new<String>()))
    var fields = List.new<Field>()
    fields.push(field)
    val text = round_trip_member_uses(member_module(TopDeclKind.Struct(fields, true)))
    assert_eq(text.as_str(), "rename(\"id\") skip", "both uses, arguments and order kept")
}

@test
fun a_variant_annotation_crosses_the_interface(): void {
    var variant = new_variant(no_span(), String.from("Circle"), List.new<TypeRef>())
    variant.annotations.push(rename_use())
    var variants = List.new<Variant>()
    variants.push(variant)
    val text = round_trip_member_uses(member_module(TopDeclKind.EnumDecl(variants, true)))
    assert_eq(text.as_str(), "rename(\"id\")", "the variant's use")
}
