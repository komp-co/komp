import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.type_ref_borrow_origin
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.Annotation
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import json.writer.*
import kf_core.ast.subst.mangle_tyref

fun emit_decl(td: &TopDecl, hidden: bool, unmangled: bool, m: &Module): String {
    val views = m.view_type_names()
    when (td.kind) {
        Function(params, ret, _b, is_pub, _u, _mut, _st) => {
            var o = JsonWriter.object()
            o.field_string("kind", "fun")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            var link = td.crate.symbol_prefix()
            link.append(td.name.as_str())
            o.field_string("link_name", link.as_str())
            o.field_raw("params", emit_interface_params(params).as_str())
            val ret_tr: TypeRef = unsafe { *ret }
            o.field_string("ret", ret_tr.tyref_to_source().as_str())
            o.field_int64("borrows", borrow_origin_of(&params, &ret_tr, false, &views) as int64)
            o.field_bool("prelude", (&td).has_annotation("prelude"))
            if !td.ext_name.as_str().equals("") { o.field_string("ext", td.ext_name.as_str()) }
            return o.finish()
        }
        Struct(fields, is_pub) => {
            var o = JsonWriter.object()
            o.field_string("kind", "struct")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            var cname = if unmangled { String.from("") } else { String.from(td.crate.symbol_prefix().as_str()) }
            cname.append(td.name.as_str())
            o.field_string("c_type_name", cname.as_str())
            o.field_bool("no_mangle", unmangled)
            o.field_string("lang", (&td).lang_key_of().as_str())
            o.field_bool("view", td.is_view_type())
            var arr = JsonWriter.array()
            while f in &fields {
                var fo = JsonWriter.object()
                fo.field_string("name", f.name.as_str())
                val fty: TypeRef = unsafe { *f.ty }
                fo.field_string("type", fty.tyref_to_source().as_str())
                fo.field_bool("var", f.is_var)
                fo.field_bool("pub", f.is_pub)
                fo.field_raw("annotations", annotations_json(&f.annotations).as_str())
                arr.write_raw(fo.finish().as_str())
            }
            o.field_raw("fields", arr.finish().as_str())
            return o.finish()
        }
        EnumDecl(variants, is_pub) => {
            var o = JsonWriter.object()
            o.field_string("kind", "enum")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            var cname = if unmangled { String.from("") } else { String.from(td.crate.symbol_prefix().as_str()) }
            cname.append(td.name.as_str())
            o.field_string("c_type_name", cname.as_str())
            o.field_bool("no_mangle", unmangled)
            o.field_string("lang", (&td).lang_key_of().as_str())
            o.field_bool("view", td.is_view_type())
            var arr = JsonWriter.array()
            while v in &variants {
                var vo = JsonWriter.object()
                vo.field_string("name", v.name.as_str())
                var payloads = JsonWriter.array()
                while item in &v.payloads {
                    payloads.write_string(item.tyref_to_source().as_str())
                }
                vo.field_raw("payloads", payloads.finish().as_str())
                vo.field_raw("annotations", annotations_json(&v.annotations).as_str())
                arr.write_raw(vo.finish().as_str())
            }
            o.field_raw("variants", arr.finish().as_str())
            return o.finish()
        }
        ImplBlock(methods) => {
            var o = JsonWriter.object()
            o.field_string("kind", "impl")
            o.field_bool("hidden", hidden)
            o.field_string("target", td.name.as_str())
            o.field_raw("methods", emit_interface_methods(td, methods, true, hidden, "", unmangled, &views).as_str())
            return o.finish()
        }
        TraitDecl(methods, is_pub, supers) => {
            var o = JsonWriter.object()
            o.field_string("kind", "trait")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            // A consumer rejects its own impls of a sealed trait.
            o.field_bool("sealed", td.is_sealed)
            o.field_string("lang", (&td).lang_key_of().as_str())
            // Supertraits cross too, or a consumer accepts an impl the
            // defining crate rejects.
            var supers_arr = JsonWriter.array()
            while item in &supers {
                supers_arr.write_string(item.tyref_to_source().as_str())
            }
            o.field_raw("supertraits", supers_arr.finish().as_str())
            // Every trait method crosses, `pub` or not: they are the trait's
            // whole contract.
            o.field_raw("methods", emit_interface_methods(td, methods, false, true, "", false, &views).as_str())
            return o.finish()
        }
        Extern(params, ret, is_pub, is_unsafe) => {
            // The C prototype comes from kf_runtime.h; only the semantic
            // signature travels.
            var o = JsonWriter.object()
            o.field_string("kind", "extern")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            o.field_bool("unsafe", is_unsafe)
            o.field_raw("params", emit_interface_params(params).as_str())
            val ret_tr: TypeRef = unsafe { *ret }
            o.field_string("ret", ret_tr.tyref_to_source().as_str())
            o.field_int64("borrows", borrow_origin_of(&params, &ret_tr, false, &views) as int64)
            return o.finish()
        }
        TraitImpl(trait_ref, methods) => {
            var o = JsonWriter.object()
            o.field_string("kind", "trait_impl")
            o.field_bool("hidden", hidden)
            o.field_string("target", td.name.as_str())
            val trait_type: TypeRef = unsafe { *trait_ref }
            o.field_string("trait", trait_type.tyref_to_source().as_str())
            // Every method crosses, `pub` or not: an impl's methods are the
            // trait's contract.
            o.field_raw("methods", emit_interface_methods(td, methods, true, true, interface_trait_suffix(trait_type, m), unmangled, &views).as_str())
            return o.finish()
        }
        AnnotationDecl(_params, target, is_pub) => {
            var o = JsonWriter.object()
            o.field_string("kind", "annotation")
            o.field_bool("hidden", hidden)
            o.field_string("name", td.name.as_str())
            o.field_bool("pub", is_pub)
            o.field_string("function", target.function_source().as_str())
            o.field_raw("kinds", target.kinds_json().as_str())
            o.field_raw("params", type_params_json(td.generics).as_str())
            return o.finish()
        }
        _ => return String.from("{}")
    }
}

fun interface_trait_suffix(trait_ref: TypeRef, m: &Module): String {
    when (trait_ref.kind) {
        Named(name, args) => {
            if args.size() == 0 && m.is_auto_trait(name.as_str()) { return "" }
            var suffix = String.from(name.as_str())
            while item in &args {
                suffix.append("__")
                val arg = mangle_tyref(item)
                suffix.append(arg.as_str())
            }
            return suffix
        }
        _ => return ""
    }
}

// Hidden entries carry private methods too: a template body may call them
// through archive symbols.
fun emit_interface_methods(owner: &TopDecl, methods: &List<TopDecl>, callable: bool, include_private: bool, suffix: String,
    unmangled: bool, views: &List<String>): String {
    var arr = JsonWriter.array()
    while method in &methods {
        when (method.kind) {
            Function(params, ret, _body, is_pub, _unsafe, is_mutating, is_static) => {
                if is_pub || include_private {
                    var object = JsonWriter.object()
                    object.field_string("name", method.name.as_str())
                    if callable {
                        var link = String.from("")
                        if !unmangled { link.append(owner.crate.symbol_prefix().as_str()) }
                        link.append(owner.name.as_str())
                        link.append("_")
                        link.append(method.name.as_str())
                        if !suffix.as_str().equals("") {
                            link.append("__")
                            link.append(suffix.as_str())
                        }
                        object.field_string("link_name", link.as_str())
                    } else {
                        object.field_string("link_name", "")
                    }
                    object.field_bool("pub", is_pub)
                    object.field_bool("static", is_static)
                    object.field_bool("mutating", is_mutating)
                    object.field_raw("params", emit_interface_params(params).as_str())
                    val return_type: TypeRef = unsafe { *ret }
                    object.field_string("ret", return_type.tyref_to_source().as_str())
                    object.field_int64("borrows", borrow_origin_of(&params, &return_type, !is_static, views) as int64)
                    arr.write_raw(object.finish().as_str())
                }
            }
            _ => {}
        }
    }
    return arr.finish()
}

fun emit_interface_params(params: &List<Param>): String {
    var arr = JsonWriter.array()
    while p in &params {
        var po = JsonWriter.object()
        po.field_string("name", p.name.as_str())
        val pty: TypeRef = unsafe { *p.ty }
        po.field_string("type", pty.tyref_to_source().as_str())
        arr.write_raw(po.finish().as_str())
    }
    return arr.finish()
}

/// KFlat surface syntax, which the consumer feeds to the ordinary type parser.
pub fun TypeRef.tyref_to_source(): String {
    when (self.kind) {
        Named(n, args) => {
            if args.size() == 0 {
                return n.as_string()
            }
            var out = n.as_string()
            out.append("<")
            while i in 0..args.size() {
                if i > 0 { out.append(", ") }
                val item = *args.at(i)
                out.append(item.tyref_to_source().as_str())
            }
            out.append(">")
            return out
        }
        DynTrait(n, args) => {
            var out = String.from("dyn ")
            out.append(n.as_str())
            if args.size() == 0 { return out }
            out.append("<")
            while i in 0..args.size() {
                if i > 0 { out.append(", ") }
                val item = *args.at(i)
                out.append(item.tyref_to_source().as_str())
            }
            out.append(">")
            return out
        }
        Reference(is_mut, inner) => {
            var out = String.from("&")
            if is_mut { out.append("var ") }
            val inner_tr: TypeRef = unsafe { *inner }
            out.append(inner_tr.tyref_to_source().as_str())
            return out
        }
        Function(params, ret) => {
            var out = String.from("(")
            while i in 0..params.size() {
                if i > 0 { out.append(", ") }
                out.append(params.at(i).tyref_to_source().as_str())
            }
            out.append(") -> ")
            out.append(ret.tyref_to_source().as_str())
            return out
        }
        Array(_e, _n) => return String.from("poison")
        Value(v) => return "${v}"
        Projection(owner, member) => {
            val owner_tr: TypeRef = unsafe { *owner }
            var out = owner_tr.tyref_to_source()
            out.append(".")
            out.append(member.as_str())
            return out
        }
        Poison => return String.from("poison")
    }
}

/// Which parameter a returned borrow comes from, or -1. Same rule TypeCheck
/// enforces.
fun borrow_origin_of(params: &List<Param>, ret: &TypeRef, has_self: bool, views: &List<String>): int32 {
    var types = List.new<TypeRef>()
    while p in &params {
        types.push(unsafe { *p.ty })
    }
    return type_ref_borrow_origin(&types, ret, has_self, views)
}

/// A member's annotation uses, each as written without the `@`.
fun annotations_json(annotations: &List<Annotation>): String {
    var out = JsonWriter.array()
    while annotation in &annotations {
        out.write_string(annotation.to_source().as_str())
    }
    return out.finish()
}
