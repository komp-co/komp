import alloc.list.*
import core.assert.assert_eq

import kf_core.ast.lang_annotation
import kf_interface.*
import kf_interface.emit.interface_test_module
import kf_interface.emit.emit_interface

fun round_trip_interface(): InterfaceLoad {
    val m = interface_test_module()
    val encoded = m.emit_interface(String.from("sample"), &List.new<String>())
    return parse_interface(encoded.as_str())
}

@test
fun interface_round_trip_loads_successfully(): void {
    val loaded = round_trip_interface()
    assert_eq(loaded.ok, true, "emitted interface parses")
}

@test
fun interface_round_trip_restores_module_path(): void {
    val loaded = round_trip_interface()
    val module = *loaded.modules.at(0)
    assert_eq(module.path.at(1).as_str(), "api", "dotted module path is restored")
}

@test
fun interface_round_trip_restores_imported_linkage(): void {
    val loaded = round_trip_interface()
    val module = *loaded.modules.at(0)
    val function = *module.decls.at(1)
    assert_eq(function.linkage.is_imported(), true, "function is marked imported")
}

@test
fun interface_round_trip_restores_exact_link_name(): void {
    val loaded = round_trip_interface()
    val module = *loaded.modules.at(0)
    val function = *module.decls.at(1)
    assert_eq(function.link_name.as_str(), "sample__distance", "archive symbol survives round trip")
}

@test
fun unsupported_interface_version_is_rejected_first(): void {
    val loaded = parse_interface("{\"kfi\":99,\"crate\":\"sample\",\"modules\":[{\"decls\":\"not-an-array\"}]}")
    assert_eq(loaded.error.as_str(), "unsupported interface version (expected 21, got 99)", "version gate precedes declarations")
}

@test
fun version_one_is_rejected_before_declarations(): void {
    val loaded = parse_interface("{\"kfi\":1,\"crate\":\"sample\",\"modules\":\"bad\"}")
    assert_eq(loaded.error.as_str(), "unsupported interface version (expected 21, got 1)", "old interfaces fail at the version gate")
}

@test
fun malformed_interface_is_reported_without_crashing(): void {
    val loaded = parse_interface("{")
    assert_eq(loaded.error.as_str(), "malformed interface JSON", "malformed JSON is a normal load error")
}

@test
fun interface_round_trip_restores_trait_declaration(): void {
    val loaded = round_trip_interface()
    val declaration = *loaded.modules.at(0).decls.at(2)
    var is_trait = false
    when (declaration.kind) {
        TraitDecl(_methods, _pub, _) => { is_trait = true }
        _ => {}
    }
    assert_eq(is_trait, true, "public trait declaration survives round trip")
}

@test
fun interface_round_trip_restores_trait_impl(): void {
    val loaded = round_trip_interface()
    val declaration = *loaded.modules.at(0).decls.at(3)
    var is_impl = false
    when (declaration.kind) {
        TraitImpl(_trait, _methods) => { is_impl = true }
        _ => {}
    }
    assert_eq(is_impl, true, "trait implementation survives round trip")
}

@test
fun interface_round_trip_restores_trait_impl_method_link_name(): void {
    val loaded = round_trip_interface()
    val declaration = *loaded.modules.at(0).decls.at(3)
    var link_name = ""
    when (declaration.kind) {
        TraitImpl(_trait, methods) => { link_name = methods.at(0).link_name.as_string() }
        _ => {}
    }
    assert_eq(link_name.as_str(), "sample__Point_display__Displayable", "implementation method keeps its archive symbol")
}

@test
fun trait_impl_method_without_link_name_is_rejected(): void {
    val source = "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":[],\"dyn_vtables\":[],\"modules\":[{\"path\":\"sample.api\",\"files\":[],\"decls\":[{\"kind\":\"trait_impl\",\"hidden\":false,\"target\":\"Point\",\"trait\":\"Displayable\",\"methods\":[{\"name\":\"display\",\"link_name\":\"\",\"pub\":true,\"static\":false,\"mutating\":false,\"params\":[],\"ret\":\"String\"}]}],\"reexports\":[]}]}"
    val loaded = parse_interface(source)
    assert_eq(loaded.ok, false, "callable interface methods require an archive symbol")
}

@test
fun unsupported_runtime_abi_is_rejected_before_modules(): void {
    val source = "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"old\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"modules\":\"not-an-array\"}"
    val loaded = parse_interface(source)
    assert_eq(loaded.error.as_str(), "unsupported runtime ABI", "runtime ABI gate precedes modules")
}

@test
fun interface_round_trip_restores_ownership_glue(): void {
    val loaded = round_trip_interface()
    assert_eq((*loaded.glue.at(0)).clone.as_str(), "sample__Point_clone", "ownership glue survives round trip")
}

@test
fun malformed_ownership_glue_is_rejected_normally(): void {
    val source = "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[{\"type\":\"Point\",\"retain\":\"\",\"drop\":\"sample__Point_drop\",\"clone\":\"sample__Point_clone\"}],\"modules\":[]}"
    val loaded = parse_interface(source)
    assert_eq(loaded.error.as_str(), "malformed ownership glue", "invalid glue is a normal interface error")
}

@test
fun a_trait_with_an_associated_type_survives_without_type_params(): void {
    // A trait declaring `type Out` travels as source with no type parameters.
    val source = "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":[],\"dyn_vtables\":[],\"modules\":[{\"path\":\"sample.api\",\"files\":[],\"decls\":[{\"kind\":\"generic\",\"hidden\":false,\"name\":\"Zilch\",\"src\":\"pub trait Zilch {\\n    type Out\\n    fun call(): Out\\n}\"}],\"reexports\":[]}]}"
    val loaded = parse_interface(source)
    assert_eq(loaded.ok, true, "the interface loads")
    var binds_out = false
    when (loaded.modules.at(0).decls.at(0).kind) {
        TraitDecl(methods, _is_pub, _) => {
            while method in &methods {
                when (method.kind) {
                    AssocType(_bounds) => { binds_out = true }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    assert_eq(binds_out, true, "the associated type survives the round trip")
}

@test
fun interface_round_trip_restores_a_lang_key(): void {
    var m = interface_test_module()
    var marked = *m.decls.at(0)
    marked.annotations.push(lang_annotation("string"))
    m.decls.set(0, marked)
    val encoded = m.emit_interface(String.from("sample"), &List.new<String>())
    val loaded = parse_interface(encoded.as_str())
    assert_eq(encoded.as_str().contains("\"lang\":\"string\""), true, "the key is written")
    val point = *loaded.modules.at(0).decls.at(0)
    assert_eq(point.name.as_str(), "Point", "the marked struct comes back first")
    assert_eq((&point).lang_key_of().as_str(), "string", "a consumer finds the type the language builds on")
}

@test
fun interface_round_trip_leaves_an_unmarked_type_unmarked(): void {
    val loaded = round_trip_interface()
    val point = *loaded.modules.at(0).decls.at(0)
    assert_eq((&point).lang_key_of().as_str(), "", "no annotation is invented")
}

fun reexport_interface_source(): String {
    val reexports = "[{\"path\":\"sample.parse.read\",\"wildcard\":false,\"as\":\"parse_file\"}]"
    val module = "{\"path\":\"sample\",\"files\":[],\"decls\":[],\"reexports\":${reexports}}"
    val header = "\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\""
    val rest = "\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":[],\"dyn_vtables\":[]"
    return "{${header},${rest},\"modules\":[${module}]}"
}

@test
fun a_loaded_reexport_is_a_pub_import(): void {
    val loaded = parse_interface(reexport_interface_source().as_str())
    assert_eq(loaded.modules.at(0).imports.at(0).is_pub, true, "an export comes back as a `pub` import")
}

@test
fun a_loaded_reexport_keeps_its_owner(): void {
    val loaded = parse_interface(reexport_interface_source().as_str())
    assert_eq(loaded.modules.at(0).imports.at(0).owner.as_str(), "sample", "owned by the module it was written in")
}

@test
fun a_loaded_export_keeps_its_new_name(): void {
    val loaded = parse_interface(reexport_interface_source().as_str())
    assert_eq(loaded.modules.at(0).imports.at(0).exposed.as_str(), "parse_file", "the `as` name survives the load")
}
