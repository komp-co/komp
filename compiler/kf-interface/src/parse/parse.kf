// Versioned `.kfi` reader. Embedded type spellings go through the ordinary
// type parser.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import json.reader.*
import kf_interface.*

pub struct InterfaceLoad {
    pub val ok: bool
    pub val error: String
    pub val crate_name: String
    pub var glue: List<OwnershipGlue>
    pub var dyn_traits: List<DynTraitLayout>
    pub var dyn_vtables: List<DynVTableInstance>
    pub var modules: List<Module>
}

fun load_error(msg: str): InterfaceLoad {
    return InterfaceLoad { ok: false, error: String.from(msg), crate_name: "", glue: List.new<OwnershipGlue>(), dyn_traits: List.new<DynTraitLayout>(), dyn_vtables: List.new<DynVTableInstance>(), modules: List.new<Module>() }
}

/// Template fragments get spans in a throwaway map; production uses
/// `parse_interface_mapped` so they stay renderable.
pub fun parse_interface(src: str): InterfaceLoad {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    return parse_interface_mapped(src, smap)
}

pub fun parse_interface_mapped(src: str, smap: Ptr<SourceMap>): InterfaceLoad {
    var reader = JsonReader.new(src)
    if !reader.begin_object() { return load_error("malformed interface JSON") }
    if !reader.expect_key("kfi") {
        if reader.has_error() { return load_error("malformed interface JSON") }
        return load_error("missing interface version")
    }
    val version = reader.read_int64()
    if reader.has_error() { return load_error("missing interface version") }
    if version != interface_format_version() {
        val expected = "${interface_format_version()}"
        val actual = "${version}"
        val message = "unsupported interface version (expected ${expected.as_str()}, got ${actual.as_str()})"
        return InterfaceLoad { ok: false, error: message, crate_name: "", glue: List.new<OwnershipGlue>(), dyn_traits: List.new<DynTraitLayout>(), dyn_vtables: List.new<DynVTableInstance>(), modules: List.new<Module>() }
    }
    if !reader.expect_key("crate") { return load_error("interface names no crate") }
    val crate_name = reader.read_string()
    if crate_name.as_str().byte_len() == 0 { return load_error("interface names no crate") }
    if !reader.expect_key("compiler_abi") { return load_error("missing compiler ABI") }
    if reader.read_string().as_str() != interface_compiler_abi() { return load_error("unsupported compiler ABI") }
    if !reader.expect_key("runtime_abi") { return load_error("missing runtime ABI") }
    if reader.read_string().as_str() != interface_runtime_abi() { return load_error("unsupported runtime ABI") }
    if !reader.expect_key("target") { return load_error("missing interface target") }
    if reader.read_string().as_str() != interface_target() { return load_error("unsupported interface target") }
    if !reader.expect_key("deps") { return load_error("missing dependency hashes") }
    if !reader.skip_dependencies() { return load_error("malformed dependency hashes") }
    if !reader.expect_key("glue") { return load_error("malformed ownership glue") }
    val glue_result = reader.load_ownership_glue()
    if !glue_result.ok { return load_error("malformed ownership glue") }
    if !reader.expect_key("dyn_traits") { return load_error("malformed dynamic trait metadata") }
    val trait_result = reader.load_dyn_traits(new_crate_id(crate_name.as_str()))
    if !trait_result.ok { return load_error("malformed dynamic trait metadata") }
    if !reader.expect_key("dyn_vtables") { return load_error("malformed dynamic vtable metadata") }
    val vtable_result = reader.load_dyn_vtables(new_crate_id(crate_name.as_str()), &trait_result.items)
    if !vtable_result.ok { return load_error("malformed dynamic vtable metadata") }
    if !reader.expect_key("modules") { return load_error("missing interface modules") }
    val crate = new_crate_id(crate_name.as_str())
    var modules = reader.load_modules(crate, crate_name.as_str(), smap)
    if reader.has_error() { return load_error("malformed interface declaration") }
    if reader.object_has_next() { return load_error("malformed interface JSON") }
    if reader.has_error() { return load_error("malformed interface JSON") }
    attach_imported_dyn_metadata(&var modules, &trait_result.items, &vtable_result.items, crate)
    return InterfaceLoad { ok: true, error: "", crate_name: crate_name, glue: glue_result.items, dyn_traits: trait_result.items, dyn_vtables: vtable_result.items, modules: modules }
}

mutating fun JsonReader.expect_key(expected: str): bool {
    if !self.object_has_next() { return false }
    return self.read_key().as_str() == expected
}

mutating fun JsonReader.skip_dependencies(): bool {
    if !self.begin_array() { return false }
    while self.array_has_next() {
        if !self.begin_object() { return false }
        if !self.expect_key("name") { return false }
        val _name = self.read_string()
        if !self.expect_key("hash") { return false }
        val _hash = self.read_string()
        if self.object_has_next() { return false }
    }
    return !self.has_error()
}

struct OwnershipGlueLoad {
    val ok: bool
    val items: List<OwnershipGlue>
}

mutating fun JsonReader.load_ownership_glue(): OwnershipGlueLoad {
    var items = List.new<OwnershipGlue>()
    if !self.begin_array() { return OwnershipGlueLoad { ok: false, items: items } }
    while self.array_has_next() {
        if !self.begin_object() { return OwnershipGlueLoad { ok: false, items: items } }
        if !self.expect_key("type") { return OwnershipGlueLoad { ok: false, items: items } }
        val type_name = self.read_string()
        if !self.expect_key("retain") { return OwnershipGlueLoad { ok: false, items: items } }
        val retain = self.read_string()
        if !self.expect_key("drop") { return OwnershipGlueLoad { ok: false, items: items } }
        val drop = self.read_string()
        if !self.expect_key("clone") { return OwnershipGlueLoad { ok: false, items: items } }
        val clone = self.read_string()
        if self.object_has_next() { return OwnershipGlueLoad { ok: false, items: items } }
        if interface_string_empty(type_name.as_str()) || interface_string_empty(retain.as_str()) {
            return OwnershipGlueLoad { ok: false, items: items }
        }
        if interface_string_empty(drop.as_str()) || interface_string_empty(clone.as_str()) {
            return OwnershipGlueLoad { ok: false, items: items }
        }
        if glue_type_exists(&items, type_name.as_str()) {
            return OwnershipGlueLoad { ok: false, items: items }
        }
        items.push(OwnershipGlue {
            type_name: String.from(type_name.as_str()),
            retain: String.from(retain.as_str()),
            drop: String.from(drop.as_str()),
            clone: String.from(clone.as_str())
        })
    }
    return OwnershipGlueLoad { ok: !self.has_error(), items: items }
}

fun interface_string_empty(value: str): bool {
    return value.byte_len() == 0
}

fun glue_type_exists(items: &List<OwnershipGlue>, name: str): bool {
    while item in &items {
        if item.type_name.as_str() == name { return true }
    }
    return false
}

mutating fun JsonReader.load_modules(crate: CrateId, crate_name: str, smap: Ptr<SourceMap>): List<Module> {
    var modules = List.new<Module>()
    if !self.begin_array() { return modules }
    while self.array_has_next() {
        if !self.begin_object() { return modules }
        if !self.expect_key("path") { return modules }
        val path = self.read_string()
        if !self.expect_key("files") { return modules }
        if !self.load_module_files(path.as_str(), smap) { return modules }
        if !self.expect_key("decls") { return modules }
        val decls = self.load_decls(crate, crate_name, path.as_str(), smap)
        if self.object_has_next() { return modules }
        modules.push(Module { crate: crate, path: split_dotted_path(path.as_str()), decls: decls, imports: List.new<Import>() })
    }
    return modules
}

/// The module's source file names, registered as importable dotted paths.
mutating fun JsonReader.load_module_files(path: str, smap: Ptr<SourceMap>): bool {
    if !self.begin_array() { return false }
    while self.array_has_next() {
        val stem = self.read_string()
        if self.has_error() { return false }
        var dotted = String.from(path)
        dotted.append(".")
        dotted.append(stem.as_str())
        unsafe { smap.interface_files.push(dotted) }
    }
    return true
}

mutating fun JsonReader.load_decls(crate: CrateId, crate_name: str, path: str, smap: Ptr<SourceMap>): List<TopDecl> {
    var decls = List.new<TopDecl>()
    if !self.begin_array() { return decls }
    while self.array_has_next() {
        val td = self.load_decl(crate, crate_name, path, smap)
        if decl_is_poison(td) { return decls }
        decls.push(td)
    }
    return decls
}

mutating fun JsonReader.load_decl(crate: CrateId, crate_name: str, path: str, smap: Ptr<SourceMap>): TopDecl {
    if !self.begin_object() { return poison_decl() }
    if !self.expect_key("kind") { return poison_decl() }
    val kind = self.read_string()
    if !self.expect_key("hidden") { return poison_decl() }
    val hidden = self.read_bool()
    return when kind.as_str() {
        "fun" => self.load_fun(crate, path, hidden)
        "struct" => self.load_struct(crate, path, hidden)
        "enum" => self.load_enum(crate, path, hidden)
        "impl" => self.load_impl(crate, path, hidden)
        "trait" => self.load_trait(crate, path, hidden)
        "trait_impl" => self.load_trait_impl(crate, path, hidden)
        "extern" => self.load_extern_decl(crate, path, hidden)
        "generic" => self.load_generic(crate, crate_name, path, smap)
        _ => poison_decl()
    }
}

mutating fun JsonReader.load_fun(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    var link_name = ""
    if self.object_has_next() {
        val key = self.read_key()
        if key.as_str() == "link_name" {
            link_name = self.read_string()
            if !self.expect_key("params") { return poison_decl() }
        } else if key.as_str() != "params" {
            return poison_decl()
        }
    } else {
        return poison_decl()
    }
    val params = self.load_params()
    if !self.expect_key("ret") { return poison_decl() }
    val ret = parse_type_ptr(self.read_string().as_str())
    if !self.expect_key("borrows") { return poison_decl() }
    // Read and ignored: recomputed from the signature by the rule that wrote it.
    val _borrows = self.read_int64()
    if !self.expect_key("prelude") { return poison_decl() }
    val is_prelude = self.read_bool()
    var ext_name = ""
    if !self.read_ext_name(&var ext_name) { return poison_decl() }
    val kind = TopDeclKind.Function(params, ret, List.new<Stmt>(), is_pub, false, false, false)
    var decl = new_top_decl(no_span(), name, kind)
    decl.ext_name = intern(ext_name.as_str())
    if is_prelude { decl.annotations.push("prelude") }
    return stamp_imported(decl, crate, path, link_name, hidden)
}

mutating fun JsonReader.load_struct(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    val naming = self.read_c_naming() ?: return poison_decl()
    if !self.expect_key("fields") { return poison_decl() }
    val fields = self.load_fields()
    if self.object_has_next() { return poison_decl() }
    val decl = new_top_decl(no_span(), name, TopDeclKind.Struct(fields, is_pub))
    return mark_c_naming(stamp_imported(decl, crate, path, "", hidden), naming)
}

mutating fun JsonReader.load_fields(): List<Field> {
    var fields = List.new<Field>()
    if !self.begin_array() { return fields }
    while self.array_has_next() {
        if !self.begin_object() { return fields }
        if !self.expect_key("name") { return fields }
        val name = self.read_string()
        if !self.expect_key("type") { return fields }
        val ty = parse_type_ptr(self.read_string().as_str())
        if !self.expect_key("var") { return fields }
        val is_var = self.read_bool()
        if !self.expect_key("pub") { return fields }
        val is_pub = self.read_bool()
        if self.object_has_next() { return fields }
        fields.push(new_field(no_span(), name, ty, is_var, is_pub))
    }
    return fields
}

mutating fun JsonReader.load_enum(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    val naming = self.read_c_naming() ?: return poison_decl()
    if !self.expect_key("variants") { return poison_decl() }
    val variants = self.load_variants()
    if self.object_has_next() { return poison_decl() }
    val decl = new_top_decl(no_span(), name, TopDeclKind.EnumDecl(variants, is_pub))
    return mark_c_naming(stamp_imported(decl, crate, path, "", hidden), naming)
}

mutating fun JsonReader.load_variants(): List<Variant> {
    var variants = List.new<Variant>()
    if !self.begin_array() { return variants }
    while self.array_has_next() {
        if !self.begin_object() { return variants }
        if !self.expect_key("name") { return variants }
        val name = self.read_string()
        if !self.expect_key("payloads") { return variants }
        var payloads = List.new<TypeRef>()
        if !self.begin_array() { return variants }
        while self.array_has_next() {
            val ty = parse_type_ptr(self.read_string().as_str())
            payloads.push(unsafe { *ty })
        }
        if self.object_has_next() { return variants }
        variants.push(new_variant(no_span(), name, payloads))
    }
    return variants
}

mutating fun JsonReader.load_impl(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("target") { return poison_decl() }
    val target = self.read_string()
    if !self.expect_key("methods") { return poison_decl() }
    val methods = self.load_method_list(crate, path, true, hidden)
    if self.object_has_next() { return poison_decl() }
    return stamp_imported(new_top_decl(no_span(), target, TopDeclKind.ImplBlock(methods)), crate, path, "", hidden)
}

mutating fun JsonReader.load_trait(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    if !self.expect_key("lang") { return poison_decl() }
    val lang = self.read_string()
    if !self.expect_key("supertraits") { return poison_decl() }
    var supers = List.new<TypeRef>()
    if !self.begin_array() { return poison_decl() }
    while self.array_has_next() {
        // CONSTRAINT: kept in a local. The parsed tokens slice this buffer, so
        // a temporary would be freed while the parse result still reads it.
        val super_src = self.read_string()
        val sref = parse_type_ptr(super_src.as_str())
        supers.push(unsafe { *sref })
    }
    if !self.expect_key("methods") { return poison_decl() }
    val methods = self.load_method_list(crate, path, false, hidden)
    if self.object_has_next() { return poison_decl() }
    var decl = new_top_decl(no_span(), name, TopDeclKind.TraitDecl(methods, is_pub, supers))
    if !lang.as_str().equals("") { decl.annotations.push("lang(${lang.as_str()})") }
    return stamp_imported(decl, crate, path, "", hidden)
}

mutating fun JsonReader.load_trait_impl(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("target") { return poison_decl() }
    val target = self.read_string()
    if !self.expect_key("trait") { return poison_decl() }
    val trait_ref = parse_type_ptr(self.read_string().as_str())
    if !self.expect_key("methods") { return poison_decl() }
    val methods = self.load_method_list(crate, path, true, hidden)
    if self.object_has_next() { return poison_decl() }
    return stamp_imported(new_top_decl(no_span(), target, TopDeclKind.TraitImpl(trait_ref, methods)), crate, path, "", hidden)
}

mutating fun JsonReader.load_method_list(crate: CrateId, path: str, requires_link_name: bool, hidden: bool): List<TopDecl> {
    var methods = List.new<TopDecl>()
    if !self.begin_array() { return methods }
    while self.array_has_next() {
        val method = self.load_method(crate, path, requires_link_name, hidden)
        if decl_is_poison(method) { return methods }
        methods.push(method)
    }
    return methods
}

mutating fun JsonReader.load_method(crate: CrateId, path: str, requires_link_name: bool, hidden: bool): TopDecl {
    if !self.begin_object() { return poison_decl() }
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("link_name") { return poison_decl() }
    val link_name = self.read_string()
    if requires_link_name {
        if link_name.as_str().byte_len() == 0 { return poison_decl() }
    }
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    if !self.expect_key("static") { return poison_decl() }
    val is_static = self.read_bool()
    if !self.expect_key("mutating") { return poison_decl() }
    val is_mutating = self.read_bool()
    if !self.expect_key("params") { return poison_decl() }
    val params = self.load_params()
    if !self.expect_key("ret") { return poison_decl() }
    val ret = parse_type_ptr(self.read_string().as_str())
    if !self.expect_key("borrows") { return poison_decl() }
    // Read and ignored: recomputed from the signature by the rule that wrote it.
    val _borrows = self.read_int64()
    if self.object_has_next() { return poison_decl() }
    val kind = TopDeclKind.Function(params, ret, List.new<Stmt>(), is_pub, false, is_mutating, is_static)
    return stamp_imported(new_top_decl(no_span(), name, kind), crate, path, link_name, hidden)
}
