// A module's exports, read back from its `.kfi`.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Import
import kf_core.ast.new_reexport
import kf_core.ast.new_renaming_reexport
import json.reader.*

/// The module's exports, as `pub` imports it owns.
mutating fun JsonReader.load_reexports(owner: str): List<Import> {
    var out = List.new<Import>()
    if !self.begin_array() { return out }
    while self.array_has_next() {
        if !self.begin_object() { return out }
        if !self.expect_key("path") { return out }
        val path = self.read_string()
        if !self.expect_key("wildcard") { return out }
        val wildcard = self.read_bool()
        if !self.expect_key("as") { return out }
        val exposed = self.read_string()
        if self.object_has_next() { return out }
        if wildcard {
            out.push(new_reexport(no_span(), split_dotted_path(path.as_str()), true, String.from(owner)))
        } else {
            var imp = new_renaming_reexport(no_span(), split_dotted_path(path.as_str()), exposed)
            imp.owner = String.from(owner)
            out.push(imp)
        }
    }
    return out
}
