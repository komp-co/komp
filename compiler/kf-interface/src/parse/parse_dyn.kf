import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import json.reader.*
import kf_core.ast.subst.mangle_tyref
import kf_core.ast.dyn_meta.*

pub struct DynTraitLoad {
    pub val ok: bool
    pub val items: List<DynTraitLayout>
}

pub struct DynVTableLoad {
    pub val ok: bool
    pub val items: List<DynVTableInstance>
}

pub mutating fun JsonReader.load_dyn_traits(crate: CrateId): DynTraitLoad {
    var items = List.new<DynTraitLayout>()
    if !self.begin_array() { return DynTraitLoad { ok: false, items: items } }
    while self.array_has_next() {
        if !self.begin_object() { return DynTraitLoad { ok: false, items: items } }
        if !self.expect_key("identity") { return DynTraitLoad { ok: false, items: items } }
        val identity = self.read_string()
        if !self.expect_key("principal") { return DynTraitLoad { ok: false, items: items } }
        val principal = self.read_string()
        if !self.expect_key("args") { return DynTraitLoad { ok: false, items: items } }
        val args = self.load_dyn_types()
        if !args.ok { return DynTraitLoad { ok: false, items: items } }
        if !self.expect_key("methods") { return DynTraitLoad { ok: false, items: items } }
        val methods = self.load_dyn_methods()
        if !methods.ok { return DynTraitLoad { ok: false, items: items } }
        if self.object_has_next() { return DynTraitLoad { ok: false, items: items } }
        if dyn_string_empty(identity.as_str()) || dyn_string_empty(principal.as_str()) { return DynTraitLoad { ok: false, items: items } }
        if dyn_layout_exists(&items, identity.as_str()) { return DynTraitLoad { ok: false, items: items } }
        var layout_owner = canonical_identity_crate(intern(principal.as_str()))
        if layout_owner.is_poison() { layout_owner = crate }
        items.push(DynTraitLayout {
            identity: intern(identity.as_str()), principal: intern(principal.as_str()), args: args.items,
            methods: methods.items, owner: layout_owner, imported: true
        })
    }
    return DynTraitLoad { ok: !self.has_error(), items: items }
}

pub mutating fun JsonReader.load_dyn_vtables(crate: CrateId, layouts: &List<DynTraitLayout>): DynVTableLoad {
    var items = List.new<DynVTableInstance>()
    if !self.begin_array() { return DynVTableLoad { ok: false, items: items } }
    while self.array_has_next() {
        if !self.begin_object() { return DynVTableLoad { ok: false, items: items } }
        if !self.expect_key("layout") { return DynVTableLoad { ok: false, items: items } }
        val layout_name = self.read_string()
        if !self.expect_key("receiver") { return DynVTableLoad { ok: false, items: items } }
        val receiver = parse_dyn_metadata_type(self.read_string().as_str())
        if !self.expect_key("receiver_identity") { return DynVTableLoad { ok: false, items: items } }
        val receiver_identity = self.read_string()
        if !self.expect_key("symbol") { return DynVTableLoad { ok: false, items: items } }
        val symbol = self.read_string()
        if !self.expect_key("owner") { return DynVTableLoad { ok: false, items: items } }
        val owner = self.read_string()
        if !self.expect_key("linkage") { return DynVTableLoad { ok: false, items: items } }
        val linkage = self.read_string()
        if !self.expect_key("adapters") { return DynVTableLoad { ok: false, items: items } }
        val adapters = self.load_dyn_symbols()
        if !adapters.ok { return DynVTableLoad { ok: false, items: items } }
        if self.object_has_next() { return DynVTableLoad { ok: false, items: items } }
        val layout_index = dyn_layout_index(layouts, layout_name.as_str())
        if layout_index < 0 { return DynVTableLoad { ok: false, items: items } }
        if receiver.is_poison() || dyn_string_empty(receiver_identity.as_str()) || dyn_string_empty(symbol.as_str()) { return DynVTableLoad { ok: false, items: items } }
        if dyn_string_empty(owner.as_str()) || !dyn_linkage_valid(linkage.as_str()) { return DynVTableLoad { ok: false, items: items } }
        if adapters.items.size() != layouts.at(layout_index as uint64).methods.size() { return DynVTableLoad { ok: false, items: items } }
        if dyn_vtable_exists(&items, layout_name.as_str(), receiver_identity.as_str()) { return DynVTableLoad { ok: false, items: items } }
        items.push(DynVTableInstance {
            layout: intern(layout_name.as_str()), receiver: receiver, receiver_identity: intern(receiver_identity.as_str()),
            symbol: intern(symbol.as_str()), adapters: adapters.items, owner: new_crate_id(owner.as_str()),
            linkage: if linkage.as_str() == "generic" { Linkage.GenericTemplate } else { Linkage.ImportedCompiled }
        })
    }
    return DynVTableLoad { ok: !self.has_error(), items: items }
}

struct DynTypeLoad {
    val ok: bool
    val items: List<Type>
}

struct DynMethodLoad {
    val ok: bool
    val items: List<DynMethodSlot>
}

struct DynSymbolLoad {
    val ok: bool
    val items: List<Sym>
}

mutating fun JsonReader.load_dyn_types(): DynTypeLoad {
    var items = List.new<Type>()
    if !self.begin_array() { return DynTypeLoad { ok: false, items: items } }
    while self.array_has_next() {
        val item = parse_dyn_metadata_type(self.read_string().as_str())
        if item.is_poison() { return DynTypeLoad { ok: false, items: items } }
        items.push(item)
    }
    return DynTypeLoad { ok: !self.has_error(), items: items }
}

mutating fun JsonReader.load_dyn_methods(): DynMethodLoad {
    var items = List.new<DynMethodSlot>()
    if !self.begin_array() { return DynMethodLoad { ok: false, items: items } }
    while self.array_has_next() {
        if !self.begin_object() { return DynMethodLoad { ok: false, items: items } }
        if !self.expect_key("name") { return DynMethodLoad { ok: false, items: items } }
        val name = self.read_string()
        if !self.expect_key("slot") { return DynMethodLoad { ok: false, items: items } }
        val slot = self.read_int64()
        if !self.expect_key("mutating") { return DynMethodLoad { ok: false, items: items } }
        val mutable = self.read_bool()
        if !self.expect_key("params") { return DynMethodLoad { ok: false, items: items } }
        val params = self.load_dyn_types()
        if !params.ok { return DynMethodLoad { ok: false, items: items } }
        if !self.expect_key("ret") { return DynMethodLoad { ok: false, items: items } }
        val ret = parse_dyn_metadata_type(self.read_string().as_str())
        if self.object_has_next() { return DynMethodLoad { ok: false, items: items } }
        if dyn_string_empty(name.as_str()) || slot < 0 || slot as uint64 != items.size() || ret.is_poison() { return DynMethodLoad { ok: false, items: items } }
        if dyn_method_name_exists(&items, name.as_str()) { return DynMethodLoad { ok: false, items: items } }
        items.push(DynMethodSlot { name: intern(name.as_str()), params: params.items, ret: ret, is_mutating: mutable, slot: slot as uint64 })
    }
    return DynMethodLoad { ok: !self.has_error(), items: items }
}

mutating fun JsonReader.load_dyn_symbols(): DynSymbolLoad {
    var items = List.new<Sym>()
    if !self.begin_array() { return DynSymbolLoad { ok: false, items: items } }
    while self.array_has_next() {
        val value = self.read_string()
        if dyn_string_empty(value.as_str()) { return DynSymbolLoad { ok: false, items: items } }
        items.push(intern(value.as_str()))
    }
    return DynSymbolLoad { ok: !self.has_error(), items: items }
}

pub fun parse_dyn_metadata_type(source: str): Type {
    val tokens = tokenize(source, 0)
    var parser = new_parser(tokens)
    val parsed = parser.parse_type_ref_ptr()
    if parser.diags.size() > 0 { return poison_ty() }
    return dyn_type_from_ref(unsafe { *parsed })
}

fun dyn_type_from_ref(reference: TypeRef): Type {
    when (reference.kind) {
        Named(name, args) => return name.dyn_named_type(&args)
        DynTrait(principal, args) => {
            var resolved = new_type_vec()
            while arg in &args {
                val argument = dyn_type_from_ref(arg)
                if argument.is_poison() { return poison_ty() }
                resolved.push(argument)
            }
            return dyn_trait_type(principal, resolved, no_span())
        }
        Reference(mutable, inner) => return dyn_reference_type(mutable, dyn_type_from_ref(unsafe { *inner }))
        Function(params, ret) => return dyn_function_type(&params, unsafe { *ret })
        Array(element, length) => {
            val inner = dyn_type_from_ref(*element)
            if inner.is_poison() || length == null { return poison_ty() }
            return array_ty(inner, length ?: 0, no_span())
        }
        _ => return poison_ty()
    }
}

fun Sym.dyn_named_type(args: &List<TypeRef>): Type {
    val spelling = self.as_str()
    if args.size() == 0 { return self.dyn_primitive_or_struct() }
    if spelling.equals("Ptr") && args.size() == 1 { return dyn_pointer_type(dyn_type_from_ref(*args.at(0)), false) }
    if spelling.equals("Box") && args.size() == 1 { return dyn_pointer_type(dyn_type_from_ref(*args.at(0)), true) }
    val mangled = mangle_tyref(&new_type_ref(no_span(), TypeRefKind.Named(Sym { id: self.id }, args.clone())))
    return Type { kind: TypeKind.Struct(intern(mangled.as_str())), provenance: Provenance.Inferred(no_span()) }
}

fun Sym.dyn_primitive_or_struct(): Type {
    val value = self.as_str()
    return when value {
        "int8" => Type { kind: TypeKind.Int8, provenance: Provenance.Inferred(no_span()) }
        "int16" => Type { kind: TypeKind.Int16, provenance: Provenance.Inferred(no_span()) }
        "int32" => Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) }
        "int64" => Type { kind: TypeKind.Int64, provenance: Provenance.Inferred(no_span()) }
        "uint8" => Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(no_span()) }
        "uint16" => Type { kind: TypeKind.UInt16, provenance: Provenance.Inferred(no_span()) }
        "uint32" => Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(no_span()) }
        "uint64" => Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
        "float32" => Type { kind: TypeKind.Float32, provenance: Provenance.Inferred(no_span()) }
        "float64" => Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(no_span()) }
        "bool" => Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(no_span()) }
        "char" => Type { kind: TypeKind.Char, provenance: Provenance.Inferred(no_span()) }
        "str" => Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
        "void" => Type { kind: TypeKind.Void, provenance: Provenance.Inferred(no_span()) }
        "never" => Type { kind: TypeKind.Never, provenance: Provenance.Inferred(no_span()) }
        _ => Type { kind: TypeKind.Struct(Sym { id: self.id }), provenance: Provenance.Inferred(no_span()) }
    }
}

fun dyn_reference_type(mutable: bool, inner: Type): Type {
    if inner.is_poison() { return poison_ty() }
    val pointer: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *pointer = inner }
    return Type { kind: TypeKind.RefTo(mutable, pointer), provenance: Provenance.Inferred(no_span()) }
}

fun dyn_pointer_type(inner: Type, boxed: bool): Type {
    if inner.is_poison() { return poison_ty() }
    val pointer: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *pointer = inner }
    if boxed { return Type { kind: TypeKind.BoxOf(pointer), provenance: Provenance.Inferred(no_span()) } }
    return Type { kind: TypeKind.PtrTo(pointer), provenance: Provenance.Inferred(no_span()) }
}

fun dyn_function_type(params: &List<TypeRef>, ret: TypeRef): Type {
    var values = new_type_vec()
    while param in &params {
        val parameter = dyn_type_from_ref(param)
        if parameter.is_poison() { return poison_ty() }
        values.push(parameter)
    }
    val result = dyn_type_from_ref(ret)
    if result.is_poison() { return poison_ty() }
    return fn_ty(values, result, Provenance.Inferred(no_span()))
}

pub fun attach_imported_dyn_metadata(modules: &var List<Module>, layouts: &List<DynTraitLayout>, tables: &List<DynVTableInstance>, crate: CrateId): void {
    while i in 0..modules.size() {
        val module = modules.at_mut(i)
        var j = 0
        while j < module.decls.size() {
            val declaration = module.decls.at_mut(j)
            if declaration.crate.raw == crate.raw {
                declaration.dyn_layouts = clone_dyn_layout_list(layouts)
                declaration.dyn_vtables = clone_dyn_vtable_list(tables)
                return
            }
            j = j + 1
        }
    }
}

fun dyn_layout_index(layouts: &List<DynTraitLayout>, identity: str): int64 {
    while i in 0..layouts.size() {
        if layouts.at(i).identity.as_str().equals(identity) { return i as int64 }
    }
    return 0 - 1
}

fun dyn_layout_exists(layouts: &List<DynTraitLayout>, identity: str): bool { return dyn_layout_index(layouts, identity) >= 0 }

fun dyn_vtable_exists(tables: &List<DynVTableInstance>, layout: str, receiver: str): bool {
    while item in &tables {
        if item.layout.as_str().equals(layout) && item.receiver_identity.as_str().equals(receiver) { return true }
    }
    return false
}

fun dyn_method_name_exists(methods: &List<DynMethodSlot>, name: str): bool {
    while method in &methods {
        if method.name.as_str().equals(name) { return true }
    }
    return false
}

fun dyn_linkage_valid(value: str): bool {
    return when value {
        "exported" => true
        "generic" => true
        "imported" => true
        "hidden" => true
        _ => false
    }
}

fun dyn_string_empty(value: str): bool { return value.byte_len() == 0 }
