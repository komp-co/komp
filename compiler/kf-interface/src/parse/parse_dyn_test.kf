import core.assert.assert_eq

import kf_core.ast.new_crate_id
import kf_interface.interface_format_version
import kf_interface.emit.emitted_dyn_interface
import kf_interface.emit.dyn_type_to_source

fun loaded_dyn_interface(): InterfaceLoad {
    val encoded = emitted_dyn_interface()
    return parse_interface(encoded.as_str())
}

fun raw_dyn_interface(traits: str, vtables: str): String {
    return "{\"kfi\":21,\"crate\":\"sample\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":${traits},\"dyn_vtables\":${vtables},\"modules\":[]}"
}

fun valid_dyn_layout_json(): str {
    return "[{\"identity\":\"Score\",\"principal\":\"Score\",\"args\":[],\"methods\":[{\"name\":\"score\",\"slot\":0,\"mutating\":false,\"params\":[],\"ret\":\"int32\"}]}]"
}

@test fun interface_version_twenty_one_is_current(): void {
    assert_eq(interface_format_version(), 21, "view types cross in interface version twenty-one")
}

@test fun interface_version_eight_is_rejected(): void {
    val loaded = parse_interface("{\"kfi\":8}")
    assert_eq(loaded.error.as_str(), "unsupported interface version (expected 21, got 8)", "an older version is rejected")
}

@test fun dyn_interface_round_trip_restores_method_order(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.dyn_traits.at(0).methods.at(1).name.as_str(), "reset", "dynamic method order survives round trip")
}

@test fun dyn_interface_round_trip_restores_mutability(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.dyn_traits.at(0).methods.at(1).is_mutating, true, "dynamic method mutability survives round trip")
}

@test fun dyn_interface_round_trip_restores_method_types(): void {
    val loaded = loaded_dyn_interface()
    val method = *loaded.dyn_traits.at(0).methods.at(0)
    val parameter = *method.params.at(0)
    assert_eq(parameter.dyn_type_to_source().as_str() == "int32" && method.ret.dyn_type_to_source().as_str() == "void", true, "dynamic parameter and result types survive round trip")
}

@test fun dyn_interface_round_trip_restores_vtable_symbol(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.dyn_vtables.at(0).symbol.as_str(), "DynVTableInstance__Point__Sink__int32", "vtable symbol survives round trip")
}

@test fun dyn_interface_round_trip_marks_metadata_imported(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.dyn_traits.at(0).imported && loaded.dyn_vtables.at(0).linkage.is_imported(), true, "loaded dynamic metadata is imported compiled ABI")
}

@test fun dyn_interface_restores_generic_vtable_linkage(): void {
    val tables = "[{\"layout\":\"Score\",\"receiver\":\"Box\",\"receiver_identity\":\"Box\",\"symbol\":\"Table\",\"owner\":\"sample\",\"linkage\":\"generic\",\"adapters\":[\"Box_score__Score\"]}]"
    val loaded = parse_interface(raw_dyn_interface(valid_dyn_layout_json(), tables).as_str())
    assert_eq(loaded.ok && loaded.dyn_vtables.at(0).linkage.is_template(), true, "generic vtable linkage survives interface loading")
}

@test fun dyn_interface_round_trip_restores_vtable_owner(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.dyn_vtables.at(0).owner.raw, new_crate_id("sample").raw, "dynamic vtable ownership survives round trip")
}

@test fun dyn_interface_round_trip_attaches_to_anchor(): void {
    val loaded = loaded_dyn_interface()
    assert_eq(loaded.modules.at(0).decls.at(0).dyn_vtables.size(), 1, "loaded dynamic metadata is attached to the crate anchor")
}

@test fun dyn_interface_rejects_a_slot_gap(): void {
    val traits = "[{\"identity\":\"Score\",\"principal\":\"Score\",\"args\":[],\"methods\":[{\"name\":\"score\",\"slot\":1,\"mutating\":false,\"params\":[],\"ret\":\"int32\"}]}]"
    val loaded = parse_interface(raw_dyn_interface(traits, "[]").as_str())
    assert_eq(loaded.ok, false, "dynamic slots must be contiguous from zero")
}

@test fun dyn_interface_rejects_duplicate_slots(): void {
    val traits = "[{\"identity\":\"Score\",\"principal\":\"Score\",\"args\":[],\"methods\":[{\"name\":\"first\",\"slot\":0,\"mutating\":false,\"params\":[],\"ret\":\"int32\"},{\"name\":\"second\",\"slot\":0,\"mutating\":false,\"params\":[],\"ret\":\"int32\"}]}]"
    val loaded = parse_interface(raw_dyn_interface(traits, "[]").as_str())
    assert_eq(loaded.ok, false, "duplicate dynamic slots are rejected")
}

@test fun dyn_interface_rejects_duplicate_layouts(): void {
    val one: str = "{\"identity\":\"Score\",\"principal\":\"Score\",\"args\":[],\"methods\":[]}"
    val traits = "[${one},${one}]"
    val loaded = parse_interface(raw_dyn_interface(traits.as_str(), "[]").as_str())
    assert_eq(loaded.ok, false, "duplicate dynamic layout identities are rejected")
}

@test fun dyn_interface_rejects_an_empty_vtable_symbol(): void {
    val tables = "[{\"layout\":\"Score\",\"receiver\":\"Point\",\"receiver_identity\":\"Point\",\"symbol\":\"\",\"owner\":\"sample\",\"linkage\":\"exported\",\"adapters\":[\"Point_score__Score\"]}]"
    val loaded = parse_interface(raw_dyn_interface(valid_dyn_layout_json(), tables).as_str())
    assert_eq(loaded.ok, false, "an empty dynamic vtable symbol is rejected")
}

@test fun dyn_interface_rejects_an_unknown_layout(): void {
    val tables = "[{\"layout\":\"Other\",\"receiver\":\"Point\",\"receiver_identity\":\"Point\",\"symbol\":\"Table\",\"owner\":\"sample\",\"linkage\":\"exported\",\"adapters\":[\"Point_score__Score\"]}]"
    val loaded = parse_interface(raw_dyn_interface(valid_dyn_layout_json(), tables).as_str())
    assert_eq(loaded.ok, false, "vtable metadata must reference a known layout")
}

@test fun dyn_interface_rejects_an_adapter_count_mismatch(): void {
    val tables = "[{\"layout\":\"Score\",\"receiver\":\"Point\",\"receiver_identity\":\"Point\",\"symbol\":\"Table\",\"owner\":\"sample\",\"linkage\":\"exported\",\"adapters\":[]}]"
    val loaded = parse_interface(raw_dyn_interface(valid_dyn_layout_json(), tables).as_str())
    assert_eq(loaded.ok, false, "every dynamic slot requires one adapter")
}
