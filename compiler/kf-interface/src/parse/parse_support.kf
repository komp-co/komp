import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import json.reader.*
import kf_interface.trait_declares_assoc_type

mutating fun JsonReader.load_extern_decl(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    if !self.expect_key("unsafe") { return poison_decl() }
    val is_unsafe = self.read_bool()
    if !self.expect_key("params") { return poison_decl() }
    val params = self.load_params()
    if !self.expect_key("ret") { return poison_decl() }
    val ret = parse_type_ptr(self.read_string().as_str())
    if !self.expect_key("borrows") { return poison_decl() }
    val _borrows = self.read_int64()
    if self.object_has_next() { return poison_decl() }
    val kind = TopDeclKind.Extern(params, ret, is_pub, is_unsafe)
    return stamp_imported(new_top_decl(no_span(), name.clone(), kind), crate, path, name, hidden)
}

mutating fun JsonReader.load_generic(crate: CrateId, crate_name: str, path: str, smap: Ptr<SourceMap>): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("src") { return poison_decl() }
    val src = self.read_string()
    if self.object_has_next() { return poison_decl() }
    if src.as_str().byte_len() == 0 { return poison_decl() }
    var fragment_path = String.from(crate_name)
    fragment_path.append(".kfi:")
    fragment_path.append(path)
    val fid = unsafe { smap.add_file(new_source_file(fragment_path, src.clone())) }
    val tokens = tokenize(src.as_str(), fid)
    val parser = new_parser(tokens)
    val fragment = parser.parse_module(List.new<String>())
    if parser.diags.size() > 0 || fragment.decls.size() != 1 { return poison_decl() }
    var td = fragment.decls.at(0).clone()
    // Source-shipped: a generic template, or a trait declaring an associated
    // type. An extension whose parameters all come from its receiver names
    // them with `@receiver_params` or `@receiver_trait`.
    val receiver_generic = (&td).has_annotation("receiver_params") || (&td).has_annotation("receiver_trait")
    if td.generics.size() == 0 && !receiver_generic {
        if !td.trait_declares_assoc_type() { return poison_decl() }
    }
    if td.name.as_str() != name.as_str() { return poison_decl() }
    stamp_decl_owner(&var td, crate, intern(path))
    td.linkage = Linkage.GenericTemplate
    return td
}

mutating fun JsonReader.load_params(): List<Param> {
    var params = List.new<Param>()
    if !self.begin_array() { return params }
    while self.array_has_next() {
        if !self.begin_object() || !self.expect_key("name") { return params }
        val name = self.read_string()
        if !self.expect_key("type") { return params }
        val ty = parse_type_ptr(self.read_string().as_str())
        if self.object_has_next() { return params }
        params.push(new_param(no_span(), name, ty))
    }
    return params
}

fun stamp_imported(td: TopDecl, crate: CrateId, path: str, link_name: String, hidden: bool): TopDecl {
    var stamped = td
    stamp_decl_owner(&var stamped, crate, intern(path))
    if hidden { stamped.linkage = Linkage.HiddenSupport } else { stamped.linkage = Linkage.ImportedCompiled }
    stamped.link_name = intern(link_name.as_str())
    return stamped
}

/// `@no_mangle`, and the `@lang(...)` key or "".
@derive(Clone)
struct CNaming {
    val unmangled: bool
    val lang: String
}

/// None when any key is missing.
mutating fun JsonReader.read_c_naming(): CNaming? {
    if !self.expect_key("c_type_name") { return Option.None }
    val _c_name = self.read_string()
    if !self.expect_key("no_mangle") { return Option.None }
    val unmangled = self.read_bool()
    if !self.expect_key("lang") { return Option.None }
    return Option.Some(CNaming { unmangled: unmangled, lang: self.read_string() })
}

fun mark_c_naming(td: TopDecl, naming: CNaming): TopDecl {
    var marked = td
    if naming.unmangled { marked.annotations.push(String.from("no_mangle")) }
    if !naming.lang.as_str().equals("") { marked.annotations.push("lang(${naming.lang.as_str()})") }
    return marked
}

fun decl_is_poison(td: TopDecl): bool {
    when (td.kind) { Poison => return true _ => return false }
}

fun poison_decl(): TopDecl { return new_top_decl(no_span(), "", TopDeclKind.Poison) }

fun parse_type_ptr(source: str): Ptr<TypeRef> {
    val tokens = tokenize(source, 0)
    val parser = new_parser(tokens)
    val parsed = parser.parse_type_ref_ptr()
    return parsed
}

fun split_dotted_path(path: str): List<String> {
    var out = List.new<String>()
    val n = path.byte_len()
    var start = 0
    var i = 0
    while i <= n {
        var split = i == n
        if !split && path.byte_at(i) == 46 { split = true }
        if split {
            if i > start { out.push(path.substring(start, i)) }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

/// The optional `ext` key: the name an extension is called by. False when
/// anything else follows `borrows`.
mutating fun JsonReader.read_ext_name(out: &var String): bool {
    if !self.object_has_next() { return true }
    if self.read_key().as_str() != "ext" { return false }
    out.append(self.read_string().as_str())
    return !self.object_has_next()
}
