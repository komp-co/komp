import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_interface.*

// Public non-generic functions, structs, enums and traits, impls of exported
// types, and public annotations, whose type parameters their record carries.
// Generic templates are selected by `decl_is_exported_template`.
pub fun decl_is_exported(td: &TopDecl): bool {
    if td.generics.size() > 0 && !td.is_annotation_decl() { return false }
    // Sent as a template: a structured row cannot carry an associated type.
    if td.trait_declares_assoc_type() { return false }
    if is_mangled_decl_name(td.name.as_str()) { return false }
    when (td.kind) {
        Function(_p, _r, _b, is_pub, _u, _mut, _st) => {
            if td.name.as_str() == "main" { return false }
            return is_pub
        }
        Struct(_f, is_pub) => return is_pub
        EnumDecl(_v, is_pub) => return is_pub
        ImplBlock(_methods) => return true
        TraitDecl(_methods, is_pub, _) => return is_pub
        TraitImpl(_trait_ref, _methods) => return true
        AnnotationDecl(_params, _target, is_pub) => return is_pub
        _ => return false
    }
}

/// A public generic, or a trait declaring an associated type: sent as source.
/// Synthesized declarations (derive) are excluded; the consumer re-synthesizes
/// them.
pub fun decl_is_exported_template(td: &TopDecl): bool {
    if td.generics.size() == 0 {
        if !td.trait_declares_assoc_type() { return false }
    }
    if is_mangled_decl_name(td.name.as_str()) { return false }
    if td.decl_end == 0 as uint32 { return false }
    return when (td.kind) {
        Function(_p, _r, _b, is_pub, _u, _mut, _st) => is_pub
        Struct(_f, is_pub) => is_pub
        EnumDecl(_v, is_pub) => is_pub
        TraitDecl(_methods, is_pub, _) => is_pub
        ImplBlock(_methods) => true
        TraitImpl(_trait_ref, _methods) => true
        _ => false
    }
}

/// Such a trait must travel as source: a structured row would drop the
/// associated type.
pub fun TopDecl.trait_declares_assoc_type(): bool {
    when (self.kind) {
        TraitDecl(methods, _is_pub, _) => {
            while method in &methods {
                when (method.kind) {
                    AssocType(_bounds) => return true
                    _ => { }
                }
            }
            return false
        }
        _ => return false
    }
}

// An impl of a private type would reference a layout the interface never
// carries.
pub fun impl_target_is_exported(td: &TopDecl, m: &Module, crate: CrateId): bool {
    val list_name = m.lang_type_name(lang_list_key())
    val option_name = m.lang_type_name(lang_option_key())
    var is_impl = false
    when (td.kind) {
        ImplBlock(_methods) => { is_impl = true }
        TraitImpl(_trait_ref, _methods) => { is_impl = true }
        _ => {}
    }
    if !is_impl { return true }
    if is_runtime_type_name(td.name.as_str()) ||
        is_container_type_name(td.name.as_str(), list_name, option_name) { return true }
    while other in &m.decls {
        if other.crate.raw == crate.raw {
            if other.name.as_str() == td.name.as_str() {
                when (other.kind) {
                    Struct(_f, is_pub) => return is_pub
                    EnumDecl(_v, is_pub) => return is_pub
                    _ => {}
                }
            }
        }
    }
    return false
}

pub fun decl_crosses_interface(td: &TopDecl, m: &Module, crate: CrateId): bool {
    if !decl_is_exported(td) {
        if !decl_is_exported_template(td) { return false }
    }
    return impl_target_is_exported(td, m, crate)
}

/// Private declarations an exported template needs to instantiate on the
/// consumer side: functions (bodyless), types, traits, templates, and every
/// hidden type's impls. First-reference order; each name enters once.
pub fun Module.collect_hidden_support(crate: CrateId): List<String> {
    val list_name = self.lang_type_name(lang_list_key())
    val option_name = self.lang_type_name(lang_option_key())
    var queue = List.new<String>()
    while td in &self.decls {
        if td.crate.raw == crate.raw {
            if decl_is_exported_template(td) {
                if impl_target_is_exported(td, self, crate) {
                    td.collect_decl_references(&var queue)
                }
            }
        }
    }
    var hidden = List.new<String>()
    var q = 0
    while q < queue.size() {
        val name = queue.at(q).clone()
        q = q + 1
        if is_runtime_type_name(name.as_str()) ||
            is_container_type_name(name.as_str(), list_name, option_name) { continue }
        if is_mangled_decl_name(name.as_str()) { continue }
        if hidden_name_in(&hidden, name.as_str()) { continue }
        var matched = false
        while other in &self.decls {
            if other.crate.raw == crate.raw {
                if other.name.as_str() == name.as_str() {
                    if !decl_crosses_interface(other, self, crate) {
                        if hidden_supportable(other) {
                            matched = true
                            if other.generics.size() > 0 {
                                other.collect_decl_references(&var queue)
                            } else {
                                other.collect_signature_references(&var queue)
                            }
                        }
                    }
                }
            }
        }
        if matched { hidden.push(name) }
    }
    // Hidden types' impls may pull in further layouts, hence a second round.
    var extra = List.new<String>()
    while item in &hidden {
        while d2 in 0..self.decls.size() {
            val other = *self.decls.at(d2)
            if other.crate.raw == crate.raw {
                if other.name.as_str() == item.as_str() {
                    if decl_is_impl(other) {
                        collect_signature_references(self.decls.at(d2), &var extra)
                    }
                }
            }
        }
    }
    var x = 0
    while x < extra.size() {
        val name = extra.at(x).clone()
        x = x + 1
        if is_runtime_type_name(name.as_str()) ||
            is_container_type_name(name.as_str(), list_name, option_name) { continue }
        if is_mangled_decl_name(name.as_str()) { continue }
        if hidden_name_in(&hidden, name.as_str()) { continue }
        if self.same_crate_private_type_exists(crate, name.as_str()) {
            hidden.push(name)
        }
    }
    return hidden
}

fun hidden_supportable(td: TopDecl): bool {
    return when (td.kind) {
        Function(_p, _r, _b, _pub, _u, _mut, _st) => true
        Struct(_f, _p) => true
        EnumDecl(_v, _p) => true
        TraitDecl(_methods, _p, _) => true
        ImplBlock(_methods) => true
        TraitImpl(_t, _methods) => true
        Extern(_ep, _er, _epub, _eu) => true
        _ => false
    }
}

fun decl_is_impl(td: TopDecl): bool {
    return when (td.kind) {
        ImplBlock(_m) => true
        TraitImpl(_t, _m) => true
        _ => false
    }
}

fun Module.same_crate_private_type_exists(crate: CrateId, name: str): bool {
    while td in &self.decls {
        if td.crate.raw == crate.raw {
            if td.name.as_str() == name {
                if !decl_crosses_interface(td, self, crate) {
                    when (td.kind) {
                        Struct(_f, _p) => return true
                        EnumDecl(_v, _p) => return true
                        _ => {}
                    }
                }
            }
        }
    }
    return false
}

pub fun hidden_name_in(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

/// Closure members the interface cannot carry, as rendered messages. Externs
/// are not errors; they ride along as hidden support.
pub fun Module.export_closure_diagnostics(crate: CrateId): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        if td.crate.raw == crate.raw {
            if td.generics.size() > 0 {
                if td.decl_end == 0 as uint32 {
                    if template_requires_slice(td) {
                        val msg = "error: exported generic `${td.name.as_str()}` has no source extent; the interface cannot carry it"
                        out.push(msg)
                    }
                }
            }
        }
    }
    return out
}

fun template_requires_slice(td: TopDecl): bool {
    return when (td.kind) {
        Function(_p, _r, _b, is_pub, _u, _mut, _st) => is_pub
        Struct(_f, is_pub) => is_pub
        EnumDecl(_v, is_pub) => is_pub
        TraitDecl(_methods, is_pub, _) => is_pub
        _ => false
    }
}

fun TopDecl.is_annotation_decl(): bool {
    return when (self.kind) {
        AnnotationDecl(_params, _target, _is_pub) => true
        _ => false
    }
}
