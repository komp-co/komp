import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

// Fixtures are built by hand: kf-resolve cannot depend on kf-parse.

fun make_fun_decl(name: str): TopDecl {
    val ret_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ptr = TypeRef.new_poison(no_span()) }
    val kind = TopDeclKind.Function(List.new<Param>(), ret_ptr, List.new<Stmt>(), false, false, false, false)
    return new_top_decl(no_span(), String.from(name), kind)
}

fun make_struct_decl(name: str): TopDecl {
    val kind = TopDeclKind.Struct(List.new<Field>(), false)
    return new_top_decl(no_span(), String.from(name), kind)
}

fun make_enum_decl(name: str): TopDecl {
    val kind = TopDeclKind.EnumDecl(List.new<Variant>(), false)
    return new_top_decl(no_span(), String.from(name), kind)
}

fun make_extern_decl(name: str): TopDecl {
    val ret_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ptr = TypeRef.new_poison(no_span()) }
    val kind = TopDeclKind.Extern(List.new<Param>(), ret_ptr, false, false)
    return new_top_decl(no_span(), String.from(name), kind)
}

fun make_impl_block(target: str): TopDecl {
    val kind = TopDeclKind.ImplBlock(List.new<TopDecl>())
    return new_top_decl(no_span(), String.from(target), kind)
}

fun module_with_decls(decls: List<TopDecl>): Module {
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

@test fun resolve_module_assigns_ids_to_fun_decls(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_fun_decl("a"))
    ds.push(make_fun_decl("b"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    assert_eq(t.names.size(), 2, "two registered")
    assert_eq(t.next_id, 3, "next_id incremented past 2")
}

@test fun resolve_module_stamps_decl_id_on_topdecl(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_fun_decl("foo"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    val td = *m.decls.at(0)
    val id = td.decl ?: {
        assert(false, "decl id not stamped")
        return
    }
    assert_eq(id.raw, 1, "first fun gets id 1")
}

@test fun resolve_module_skips_impl_block(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_struct_decl("S"))
    ds.push(make_impl_block("S"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    // Only S registers; impl block is skipped (it attaches methods,
    // it isn't itself a named declaration).
    assert_eq(t.names.size(), 1, "only struct S registers")
}

@test fun resolve_module_registers_struct_and_enum(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_struct_decl("A"))
    ds.push(make_enum_decl("B"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    assert_eq(t.names.size(), 2, "struct A + enum B")
    assert_eq(t.lookup("A").is_some(), true, "A found")
    assert_eq(t.lookup("B").is_some(), true, "B found")
}

@test fun resolve_module_registers_extern(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_extern_decl("puts"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    assert_eq(t.names.size(), 1, "extern fun registers")
    assert_eq(t.lookup("puts").is_some(), true, "puts found")
}

@test fun resolve_module_assigns_monotonic_ids(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_fun_decl("foo"))
    ds.push(make_fun_decl("bar"))
    ds.push(make_fun_decl("baz"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    assert_eq(t.lookup("foo")!!.raw, 1, "foo gets id 1")
    assert_eq(t.lookup("bar")!!.raw, 2, "bar gets id 2")
    assert_eq(t.lookup("baz")!!.raw, 3, "baz gets id 3")
}

@test fun resolve_module_lookup_unknown_finds_nothing(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_fun_decl("foo"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    assert_eq(t.lookup("does_not_exist").is_none(), true, "an unknown name finds nothing")
}

@test fun resolve_module_mixed_decls(): void {
    var ds = List.new<TopDecl>()
    ds.push(make_struct_decl("Point"))
    ds.push(make_enum_decl("Color"))
    ds.push(make_impl_block("Point"))
    ds.push(make_fun_decl("classify"))
    var m = module_with_decls(ds)
    var t = new_decl_table()
    resolve_module(&var m, &var t)
    // Point + Color + classify register. ImplBlock skipped.
    assert_eq(t.names.size(), 3, "three registered (impl skipped)")
}

/// A function whose body is one statement: a call to `callee`.
fun make_caller(name: str, callee: str): TopDecl {
    val ret_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ptr = TypeRef.new_poison(no_span()) }
    val call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_ptr = Expr.new(no_span(), ExprKind.Call(intern(callee), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Expression(call_ptr)))
    val kind = TopDeclKind.Function(List.new<Param>(), ret_ptr, body, false, false, false, false)
    return new_top_decl(no_span(), String.from(name), kind)
}

/// The DeclId stamped on the call in `decls[idx]`'s body, or 0.
///
/// Read through borrows: copying a Stmt out of a body would alias the
/// Expr pointer inside it and free it twice.
fun Module.stamped_call_id(idx: uint64): uint32 {
    var out: uint32 = 0
    when (self.decls.at(idx).kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => {
            if body.size() > 0 {
                when (body.at(0).kind) {
                    Expression(e) => {
                        when (e.decl) {
                            Some(d) => out = d.raw
                            None => out = 0
                        }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    return out
}

fun resolved_module(decls: List<TopDecl>): Module {
    var m = module_with_decls(decls)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    return m
}

@test fun a_call_is_stamped_with_the_declaration_it_names(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_fun_decl("target"))
    decls.push(make_caller("caller", "target"))
    val m = resolved_module(decls)
    assert_eq(m.stamped_call_id(1), 1 as uint32, "the call carries the callee's id")
}

@test fun a_call_to_nothing_stays_unresolved(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_caller("caller", "nobody"))
    val m = resolved_module(decls)
    assert_eq(m.stamped_call_id(0), 0 as uint32, "a name nothing declares keeps its poison")
}

@test fun a_call_resolves_a_declaration_written_later(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_caller("caller", "target"))
    decls.push(make_fun_decl("target"))
    val m = resolved_module(decls)
    assert_eq(m.stamped_call_id(0), 2 as uint32, "the pre-pass makes forward references resolve")
}
