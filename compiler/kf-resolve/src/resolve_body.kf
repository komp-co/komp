// Stamps every name that refers to a top-level declaration with its DeclId.
// Parameters and locals keep the None they were parsed with; typecheck
// resolves those.

import alloc.list.*

import kf_core.ast.*

pub mutating fun TopDecl.resolve_decl_body(table: &var DeclTable): void {
    when (self.kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => resolve_stmt_list(&var body, table)
        ImplBlock(methods) => resolve_decl_body_list(&var methods, table)
        TraitDecl(methods, _pub, _supers) => resolve_decl_body_list(&var methods, table)
        TraitImpl(_trait_ref, methods) => resolve_decl_body_list(&var methods, table)
        _ => {}
    }
}

fun resolve_decl_body_list(decls: &var List<TopDecl>, table: &var DeclTable): void {
    while i in 0..decls.size() {
        resolve_decl_body(decls.at_mut(i), table)
    }
}

fun resolve_stmt_list(stmts: &var List<Stmt>, table: &var DeclTable): void {
    while i in 0..stmts.size() {
        (stmts.at_mut(i)).resolve_stmt(table)
    }
}

mutating fun Stmt.resolve_stmt(table: &var DeclTable): void {
    when (self.kind) {
        LetVal(_n, _ann, init) => resolve_expr_ptr(init.view(), table)
        LetVar(_n, _ann, init) => resolve_expr_ptr(init.view(), table)
        Assign(_n, value) => resolve_expr_ptr(value, table)
        AssignTo(place, value) => {
            resolve_expr_ptr(place, table)
            resolve_expr_ptr(value, table)
        }
        Return(value) => {
            val vp = value ?: return
            resolve_expr_ptr(vp, table)
        }
        If(cond, then_body, else_body) => {
            resolve_expr_ptr(cond, table)
            resolve_stmt_list(&var then_body, table)
            resolve_stmt_list(&var else_body, table)
        }
        While(cond, body) => {
            resolve_expr_ptr(cond, table)
            resolve_stmt_list(&var body, table)
        }
        ForEach(_binder, subject, body) => {
            resolve_expr_ptr(subject, table)
            resolve_stmt_list(&var body, table)
        }
        When(subject, arms) => {
            resolve_expr_ptr(subject, table)
            resolve_arm_list(&var arms, table)
        }
        Switch(subject, arms) => {
            resolve_expr_ptr(subject, table)
            resolve_switch_arm_list(&var arms, table)
        }
        Expression(e) => resolve_expr_ptr(e, table)
        _ => {}
    }
}

fun resolve_arm_list(arms: &var List<Arm>, table: &var DeclTable): void {
    while i in 0..arms.size() {
        resolve_expr_ptr(arms.at(i).guard.view(), table)
        resolve_stmt_list(&var arms.at_mut(i).body, table)
    }
}

fun resolve_switch_arm_list(arms: &var List<SwitchArm>, table: &var DeclTable): void {
    while i in 0..arms.size() {
        resolve_stmt_list(&var arms.at_mut(i).body, table)
    }
}

fun resolve_expr_ptr(p_opt: Ptr<Expr>?, table: &var DeclTable): void {
    val p = p_opt ?: return
    resolve_expr(unsafe { &var *p }, table)
}

mutating fun Expr.resolve_expr(table: &var DeclTable): void {
    self.stamp_name(table)
    when (self.kind) {
        Call(_name, args) => resolve_expr_list(&var args, table)
        MethodCall(recv, _m, args) => {
            resolve_expr_ptr(recv, table)
            resolve_expr_list(&var args, table)
        }
        FieldAccess(obj, _f) => resolve_expr_ptr(obj, table)
        Binary(l, _op, r) => {
            resolve_expr_ptr(l, table)
            resolve_expr_ptr(r, table)
        }
        Unary(_op, inner) => resolve_expr_ptr(inner, table)
        Deref(inner) => resolve_expr_ptr(inner, table)
        IfExpr(c, t, el) => {
            resolve_expr_ptr(c, table)
            resolve_expr_ptr(t, table)
            resolve_expr_ptr(el, table)
        }
        WhenExpr(subject, arms) => {
            resolve_expr_ptr(subject, table)
            resolve_arm_list(&var arms, table)
        }
        StructLit(_name, fields) => resolve_field_init_list(&var fields, table)
        Cast(inner, _target) => resolve_expr_ptr(inner, table)
        DynCoerce(inner, _vtable) => resolve_expr_ptr(inner, table)
        Lambda(_params, body) => resolve_stmt_list(&var body, table)
        // CONSTRAINT: iterate here instead of calling resolve_stmt_list. A
        // `when` binder passed as an argument is owned by the arm, whose drop
        // would free statements the AST still points at.
        Block(stmts) => {
            while i in 0..stmts.size() {
                (stmts.at_mut(i)).resolve_stmt(table)
            }
        }
        Retain(inner) => resolve_expr_ptr(inner, table)
        _ => {}
    }
}

fun resolve_expr_list(args: &var List<Expr>, table: &var DeclTable): void {
    while i in 0..args.size() {
        resolve_expr(args.at_mut(i), table)
    }
}

fun resolve_field_init_list(fields: &var List<FieldInit>, table: &var DeclTable): void {
    while field in &fields {
        resolve_expr_ptr(field.value, table)
    }
}

// CONSTRAINT: a statement `when`, not `val found = when (...)`. A
// when-expression yielding a type from another crate emits an unusable C
// type name for its temporary, and `komp check` does not catch it.
mutating fun Expr.stamp_name(table: &var DeclTable): void {
    var found: DeclId? = null
    when (self.kind) {
        Variable(name) => found = table.lookup(name.as_str())
        Call(name, _args) => found = table.lookup(name.as_str())
        StructLit(name, _fields) => found = table.lookup(name.as_str())
        _ => {}
    }
    if found.is_some() { self.decl = found }
}
