import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.span.*

fun make_decl(name: str, module_path: str): TopDecl {
    return make_decl_at(no_span(), name, module_path)
}

fun make_decl_at(span: Span, name: str, module_path: str): TopDecl {
    val kind = TopDeclKind.Function(List.new<Param>(), null_type_ref_ptr(), List.new<Stmt>(), false, false, false, false)
    var decl = new_top_decl(span, String.from(name), kind)
    decl.module_path = intern(module_path.as_str())
    return decl
}

fun null_type_ref_ptr(): Ptr<TypeRef> {
    return unsafe { 0 as Ptr<TypeRef> }
}

fun make_import(seg1: String, seg2: String, wildcard: bool): Import {
    var path = List.new<String>()
    path.push(seg1)
    path.push(seg2)
    return Import { span: no_span(), path: path, wildcard: wildcard }
}

fun make_import3(seg1: String, seg2: String, seg3: String, wildcard: bool): Import {
    var path = List.new<String>()
    path.push(seg1)
    path.push(seg2)
    path.push(seg3)
    return Import { span: no_span(), path: path, wildcard: wildcard }
}

fun make_import_with_fid(seg1: String, seg2: String, wildcard: bool, file_id: uint32): Import {
    var path = List.new<String>()
    path.push(seg1)
    path.push(seg2)
    val s = Span { file_id: file_id, start: 0, end: 0 }
    return Import { span: s, path: path, wildcard: wildcard }
}

/// An empty map: enough for every case that imports a module by its full
/// path, since no file name has to be resolved to answer those.
fun no_files(): Ptr<SourceMap> {
    val p: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *p = new_source_map() }
    return p
}

/// A map holding one registered source file, and the FileId to stamp on a
/// declaration so the resolver can see which file it came from.
fun map_with_file(path: str): Ptr<SourceMap> {
    val p = no_files()
    unsafe { p.add_file(new_source_file(String.from(path), String.from(""))) }
    return p
}

/// A declaration that came from a real file, so its module reports that file
/// as importable. `make_decl` leaves `no_span()`, which names no file at all.
fun make_decl_in_file(name: str, module_path: str, file_id: uint32): TopDecl {
    return make_decl_at(Span { file_id: file_id, start: 0, end: 0 }, name, module_path)
}

fun module_with(decls: List<TopDecl>, imports: List<Import>): Module {
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: imports }
}

@test fun valid_wildcard_import_passes(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("foo", "my_crate.utils"))
    var imports = List.new<Import>()
    imports.push(make_import(String.from("my_crate"), String.from("utils"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 0, "valid wildcard import produces no diagnostics")
}

@test fun unknown_module_is_reported(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("foo", "my_crate.utils"))
    var imports = List.new<Import>()
    imports.push(make_import(String.from("nonexistent"), String.from("stuff"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 1, "unknown module produces one diagnostic")
}

@test fun empty_module_produces_no_import_diags(): void {
    // Module with no decls — all imports fail because no module_paths exist.
    val decls = List.new<TopDecl>()
    var imports = List.new<Import>()
    imports.push(make_import(String.from("a"), String.from("b"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 1, "import of non-existent module is an error")
}

@test fun flat_crate_import_resolves_via_fallback(): void {
    val smap = map_with_file("libs/core/src/string.kf")
    var decls = List.new<TopDecl>()
    // core/string.kf → module_path = "core" (flat crate, file in src/).
    decls.push(make_decl_in_file("contains", "core", 1))
    // import core.string.* → full "core.string" misses; the fallback to
    // `core` is allowed because `string.kf` is a file core really has.
    var imports = List.new<Import>()
    imports.push(make_import(String.from("core"), String.from("string"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(smap)
    assert_eq(diags.size(), 0, "flat crate fallback resolves")
}

@test fun a_flat_crate_import_naming_no_file_is_reported(): void {
    val smap = map_with_file("libs/core/src/string.kf")
    var decls = List.new<TopDecl>()
    decls.push(make_decl_in_file("contains", "core", 1))
    // `core` is a real module and `memory.kf` is not one of its files.
    var imports = List.new<Import>()
    imports.push(make_import(String.from("core"), String.from("memory"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(smap)
    assert_eq(diags.size(), 1, "a wildcard naming no module and no file is an error")
    val msg = diags.at(0).primary.message.as_str()
    assert_eq(msg.contains("no such module or source file"), true, "the message says what is missing")
    assert_eq(msg.contains("memory"), true, "and names the segment that is wrong")
}

@test fun an_interface_carries_its_file_names(): void {
    // A dependency compiled separately has no sources on disk; its file
    // names arrive through the `.kfi` and land in the same SourceMap.
    val smap = no_files()
    unsafe { smap.interface_files.push(String.from("core.string")) }
    var decls = List.new<TopDecl>()
    decls.push(make_decl("contains", "core"))
    var imports = List.new<Import>()
    imports.push(make_import(String.from("core"), String.from("string"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(smap)
    assert_eq(diags.size(), 0, "a file the interface reported is importable")
}

@test fun specific_import_valid_when_name_exists(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("Expression", "kf_core.ast"))
    var imports = List.new<Import>()
    imports.push(make_import3(String.from("kf_core"), String.from("ast"), String.from("Expression"), false))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 0, "specific import with existing name passes")
}

@test fun specific_import_reports_missing_name(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("Expression", "kf_core.ast"))
    var imports = List.new<Import>()
    imports.push(make_import3(String.from("kf_core"), String.from("ast"), String.from("Nonexistent"), false))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 1, "missing name produces one diagnostic")
}

@test fun per_module_map_records_caller_and_target(): void {
    var decls = List.new<TopDecl>()
    // mod_a has two decls, one with file_id=42 (the caller).
    val d = make_decl_in_file("foo", "mod_a", 42)
    decls.push(d)
    decls.push(make_decl("other", "mod_a"))
    // mod_b.sub has one decl (the import target).
    decls.push(make_decl("bar", "mod_b.sub"))

    var imports = List.new<Import>()
    // import mod_b.sub.* from file_id=42; recorded against the file.
    imports.push(make_import_with_fid(String.from("mod_b"), String.from("sub"), true, 42))

    val m = module_with(decls, imports)
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    val diags = validate_imports_per_module(&m, callers, targets, names, no_files())
    assert_eq(diags.size(), 0, "valid import produces no diagnostic")
    assert_eq(unsafe { callers.size() }, 1, "one caller entry")
    assert_eq(unsafe { targets.size() }, 1, "one target entry")
}

@test fun an_unresolvable_import_is_recorded_with_a_poison_target(): void {
    // Recorded with a poison target, keeping the lists index-aligned
    // with `m.imports`.
    var decls = List.new<TopDecl>()
    val d = make_decl_in_file("foo", "mod_a", 1)
    decls.push(d)

    var imports = List.new<Import>()
    // This import from file_id=1 targets a non-existent module.
    imports.push(make_import_with_fid(String.from("ghost"), String.from("mod"), true, 1))

    val m = module_with(decls, imports)
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    val _diags = validate_imports_per_module(&m, callers, targets, names, no_files())
    assert_eq(unsafe { callers.size() }, 1, "one entry per import, aligned with m.imports")
    assert_eq(unsafe { targets.size() }, 1, "including the ones that resolve to nothing")
    assert_eq(unsafe { targets.get(0).id }, 0 as uint32, "and its target is poison, so it grants nothing")
}

@test fun unknown_module_message_names_the_path(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("foo", "crate_a.mod"))
    var imports = List.new<Import>()
    imports.push(make_import(String.from("ghost"), String.from("missing"), true))
    val m = module_with(decls, imports)
    val diags = m.validate_imports(no_files())
    assert_eq(diags.size(), 1, "produces one diagnostic")
    val msg = diags.at(0).primary.message.as_str()
    assert_eq(msg.contains("ghost.missing"), true, "message names the unresolved path")
}

@test fun the_recorded_caller_is_the_importing_file(): void {
    // Two files in one module, one import. Only the file that wrote it is
    // recorded, which is what lets the checker refuse a sibling.
    var decls = List.new<TopDecl>()
    val d1 = make_decl_in_file("foo", "mod_a", 1)
    decls.push(d1)
    val d2 = make_decl_in_file("bar", "mod_a", 2)
    decls.push(d2)
    val d3 = make_decl_in_file("target", "mod_b", 3)
    decls.push(d3)

    var imports = List.new<Import>()
    imports.push(make_import_with_fid(String.from("mod_b"), "", true, 1))

    val m = module_with(decls, imports)
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    val _d = validate_imports_per_module(&m, callers, targets, names, no_files())
    assert_eq(unsafe { callers.size() }, 1, "one entry, for the file that wrote the import")
    assert_eq(unsafe { callers.get(0) }, 1 as uint32, "file 1 wrote it; file 2 did not")
}
