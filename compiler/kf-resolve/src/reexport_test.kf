import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_core.span.no_span

fun whole_module(owner: str, target: str): Reexport {
    return Reexport { owner: intern(owner), target: intern(target), offered: Sym { id: 0 }, exposed: Sym { id: 0 } }
}

fun one_name(owner: str, target: str, offered: str, exposed: str): Reexport {
    return Reexport { owner: intern(owner), target: intern(target), offered: intern(offered), exposed: intern(exposed) }
}

fun forwarded_text(admitted: Sym, r: &Reexport): String {
    val through = forwarded_admission(admitted, r) ?: intern("<none>")
    return String.from(through.as_str())
}

@test fun a_wildcard_import_takes_the_name_an_export_offers(): void {
    val r = one_name("lib", "lib.parse", "read", "read")
    assert_eq(forwarded_text(Sym { id: 0 }, &r).as_str(), "read", "only the exported name")
}

@test fun a_named_import_passes_a_whole_module_export(): void {
    val r = whole_module("lib", "lib.parse")
    assert_eq(forwarded_text(intern("read"), &r).as_str(), "read", "the imported name, from the export's module")
}

@test fun a_named_import_does_not_pass_another_names_export(): void {
    val r = one_name("lib", "lib.parse", "write", "write")
    assert_eq(forwarded_text(intern("read"), &r).as_str(), "<none>", "a different name is not forwarded")
}

@test fun a_renamed_export_is_written_by_its_new_name(): void {
    val r = one_name("lib", "lib.parse", "read", "parse_file")
    assert_eq(forwarded_text(Sym { id: 0 }, &r).as_str(), "parse_file=read", "written `parse_file`, calling `read`")
}

@test fun a_named_import_of_a_renamed_export_finds_the_function(): void {
    val r = one_name("lib", "lib.parse", "read", "parse_file")
    assert_eq(forwarded_text(intern("parse_file"), &r).as_str(), "parse_file=read", "the new name reaches `read`")
}

@test fun a_renamed_exports_old_name_is_not_offered(): void {
    val r = one_name("lib", "lib.parse", "read", "parse_file")
    assert_eq(forwarded_text(intern("read"), &r).as_str(), "<none>", "only the new name is the module's")
}

@test fun an_alias_narrows_to_an_exported_name(): void {
    val r = one_name("lib", "lib.parse", "read", "read")
    assert_eq(forwarded_text(alias_admission("lib"), &r).as_str(), "as lib read", "through the alias, only that name")
}

@test fun an_alias_carries_a_rename(): void {
    val r = one_name("lib", "lib.parse", "read", "parse_file")
    val through = forwarded_text(alias_admission("lib"), &r)
    assert_eq(through.as_str(), "as lib parse_file=read", "`lib.parse_file` calls `read`")
}

@test fun a_rename_of_a_rename_keeps_the_first_written_name(): void {
    val r = one_name("mid", "deep", "raw", "read")
    val through = forwarded_text(intern("parse_file=read"), &r)
    assert_eq(through.as_str(), "parse_file=raw", "the name the file writes stays")
}

@test fun an_exports_own_entry_forwards_nothing(): void {
    var reexports = List.new<Reexport>()
    reexports.push(whole_module("app", "app.parts"))
    var entries = new_import_entries()
    entries.add(1, intern("app.parts"), export_admission())
    assert_eq(forwarded_entries(&reexports, &entries).files.size(), 0, "an export does not import into its file")
}

@test fun an_import_is_forwarded_through_a_chain_of_exports(): void {
    var reexports = List.new<Reexport>()
    reexports.push(whole_module("app", "app.mid"))
    reexports.push(whole_module("app.mid", "app.deep"))
    var entries = new_import_entries()
    entries.add(1, intern("app"), Sym { id: 0 })
    val forwarded = forwarded_entries(&reexports, &entries)
    assert_eq(forwarded.targets.get(1).as_str(), "app.deep", "the export of an export")
}

@test fun an_export_cycle_terminates(): void {
    var reexports = List.new<Reexport>()
    reexports.push(whole_module("app.a", "app.b"))
    reexports.push(whole_module("app.b", "app.a"))
    var entries = new_import_entries()
    entries.add(1, intern("app.a"), Sym { id: 0 })
    val forwarded = forwarded_entries(&reexports, &entries)
    assert_eq(forwarded.files.size(), 2, "each module once")
}

fun export_of(owner: str, module: List<String>, name: str, exposed: str): Import {
    var path = module
    path.push(String.from(name))
    var imp = new_renaming_reexport(no_span(), path, String.from(exposed))
    imp.owner = String.from(owner)
    return imp
}

fun app_parse(): List<String> {
    var path = List.new<String>()
    path.push(String.from("my_crate"))
    path.push(String.from("parse"))
    return path
}

fun named_import(module: str, name: str): Import {
    var path = List.new<String>()
    path.push(String.from(module))
    path.push(String.from(name))
    return new_import(no_span(), path, false)
}

@test fun a_named_import_of_an_exported_name_resolves(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("read", "my_crate.parse"))
    var imports = List.new<Import>()
    imports.push(export_of("my_crate", app_parse(), "read", ""))
    imports.push(named_import("my_crate", "read"))
    val diags = crate_module_with(decls, imports).validate_imports(no_files())
    assert_eq(diags.size(), 0, "`my_crate.read` names what `my_crate` exports")
}

@test fun a_named_import_of_a_renamed_export_resolves(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("read", "my_crate.parse"))
    var imports = List.new<Import>()
    imports.push(export_of("my_crate", app_parse(), "read", "parse_file"))
    imports.push(named_import("my_crate", "parse_file"))
    val diags = crate_module_with(decls, imports).validate_imports(no_files())
    assert_eq(diags.size(), 0, "`my_crate.parse_file` names the renamed export")
}

@test fun an_export_of_a_missing_name_is_reported(): void {
    var decls = List.new<TopDecl>()
    decls.push(make_decl("read", "my_crate.parse"))
    var imports = List.new<Import>()
    imports.push(export_of("my_crate", app_parse(), "nope", ""))
    val diags = crate_module_with(decls, imports).validate_imports(no_files())
    assert_eq(diags.size(), 1, "an export names something its module declares")
}
