import core.assert.*

@test fun new_decl_table_is_empty(): void {
    val t = new_decl_table()
    assert_eq(t.names.size(), 0, "no names")
    assert_eq(t.next_id, 1, "next_id starts at 1 (0 is poison)")
}

@test fun insert_returns_id_1_first(): void {
    var t = new_decl_table()
    val id = t.insert(String.from("foo"))
    assert_eq(id.raw, 1, "first insert returns id 1")
    assert_eq(t.next_id, 2, "next_id incremented")
    assert_eq(t.names.size(), 1, "names vec size 1")
}

@test fun insert_assigns_monotonic_ids(): void {
    var t = new_decl_table()
    val a = t.insert(String.from("foo"))
    val b = t.insert(String.from("bar"))
    val c = t.insert(String.from("baz"))
    assert_eq(a.raw, 1, "id 1")
    assert_eq(b.raw, 2, "id 2")
    assert_eq(c.raw, 3, "id 3")
    assert_eq(t.next_id, 4, "next_id incremented")
}

@test fun lookup_unknown_returns_nothing(): void {
    val t = new_decl_table()
    val id = t.lookup("missing")
    assert_eq(id.is_none(), true, "lookup of a missing name finds nothing")
}

@test fun lookup_finds_inserted(): void {
    var t = new_decl_table()
    val expected = t.insert(String.from("add"))
    val found = t.lookup("add") ?: {
        assert(false, "lookup found nothing")
        return
    }
    assert_eq(found.raw, expected.raw, "lookup finds inserted id")
}

@test fun lookup_finds_specific_match_among_many(): void {
    var t = new_decl_table()
    t.insert(String.from("a"))
    val target = t.insert(String.from("b"))
    t.insert(String.from("c"))
    val found = t.lookup("b") ?: {
        assert(false, "lookup found nothing")
        return
    }
    assert_eq(found.raw, target.raw, "found b's id, not a/c")
}

@test fun lookup_distinguishes_similar_names(): void {
    var t = new_decl_table()
    t.insert(String.from("foo"))
    t.insert(String.from("foobar"))
    assert_eq(t.lookup("foo").is_some(), true, "foo found")
    assert_eq(t.lookup("fo").is_none(), true, "fo is missing")
    assert_eq(t.lookup("foobaz").is_none(), true, "foobaz is missing")
}
