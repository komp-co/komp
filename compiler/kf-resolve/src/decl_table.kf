import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.*

/// Top-level names and the DeclIds they were registered under.
///
/// The lists record every registration, duplicates included; `index` answers
/// `lookup` and holds only the FIRST id each name got. `insert` mints a fresh
/// id even for a name already present.
pub struct DeclTable {
    pub var names: List<String>
    pub var decl_ids: List<DeclId>
    pub var index: HashMap<String, DeclId>
    pub var next_id: uint32
}

pub fun new_decl_table(): DeclTable {
    return DeclTable {
        names: List.new<String>(),
        decl_ids: List.new<DeclId>(),
        index: HashMap.new<String, DeclId>(),
        next_id: 1
    }
}

impl DeclTable {
    pub mutating fun insert(name: String): DeclId {
        val id: uint32 = self.next_id
        self.next_id = self.next_id + 1
        val d = new_decl_id(id)
        val key = String.from(name.as_str())
        if !self.index.contains(&key) {
            self.index.insert(key, d)
        }
        self.names.push(name)
        self.decl_ids.push(d)
        return d
    }

    /// None for anything that is not a top-level declaration: a parameter,
    /// a local, a method.
    pub fun lookup(name: str): DeclId? {
        val key = String.from(name)
        when (self.index.get(&key)) {
            Some(d) => { return *d }
            None => { return null }
        }
    }
}
