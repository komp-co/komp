import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.span.*

/// Owned by the caller; validation and typecheck borrow it.
pub fun new_import_syms(): Box<List<Sym>> {
    return Box.new(List.new<Sym>())
}

pub fun new_import_files(): Box<List<uint32>> {
    return Box.new(List.new<uint32>())
}

/// One error per import whose module, or whose named declaration, does not
/// exist.
pub fun Module.validate_imports(smap: Ptr<SourceMap>): List<Diagnostic> {
    val files = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    return validate_imports_per_module(self, files, targets, names, smap)
}

/// `validate_imports`, also filling three parallel lists with one entry per
/// import, in import order: the file it is written in, the module it
/// resolved to, and the one name it admits (poison for a wildcard, which
/// admits every name). Typecheck gates visibility per importing file from
/// them.
pub fun validate_imports_per_module(m: &Module,
                                    caller_files: Ptr<List<uint32>>,
                                    imported_targets: Ptr<List<Sym>>,
                                    imported_names: Ptr<List<Sym>>,
                                    smap: Ptr<SourceMap>): List<Diagnostic> {
    var diags = List.new<Diagnostic>()

    var module_paths = List.new<Sym>()
    var decl_names   = List.new<Sym>()
    var i = 0
    while i < m.decls.size() {
        val d = *m.decls.at(i)
        val mp = d.module_path
        // An extension is imported by the name it is called by.
        val dn = if d.ext_name.as_str().equals("") { d.name } else { d.ext_name }
        if !has_pair(&module_paths, &decl_names, mp, dn) {
            module_paths.push(mp)
            decl_names.push(dn)
        }
        i = i + 1
    }

    val file_paths = m.collect_importable_files(smap)

    // CONSTRAINT: an unresolved import is still recorded, with a poison
    // target, so index `i` of every list stays on `m.imports.get(i)`.
    while imp in &m.imports {
        val source_file = imp.span.file_id
        var resolved = poison_sym()
        var admitted = poison_sym()
        if imp.wildcard {
            resolved = imp.resolve_wildcard(&module_paths, &file_paths)
            if resolved.id == 0 {
                diags.push(error_at(imp.span, wildcard_not_found_message(&imp.path, &module_paths)))
            }
        } else {
            resolved = imp.resolve_specific(&module_paths, &decl_names, &file_paths)
            if resolved.id != 0 { admitted = import_admitted_name(&imp.path) }
            if resolved.id == 0 {
                val seg_count = imp.path.size()
                val target_name = if seg_count > 0 { *imp.path.at(seg_count - 1) } else { String.from("") }
                diags.push(error_at(imp.span, import_name_not_found(target_name, &imp.path)))
            }
        }
        record_import(caller_files, imported_targets, imported_names, source_file, resolved, admitted)
    }

    return diags
}

fun poison_sym(): Sym {
    return Sym { id: 0 }
}

/// The module a wildcard import targets, or poison.
fun Import.resolve_wildcard(valid_paths: &List<Sym>, file_paths: &List<Sym>): Sym {
    val path_len = self.path.size()
    if path_len == 0 {
        return poison_sym()
    }
    val full = import_module_sym(&self.path, path_len)
    if contains_sym(valid_paths, full) {
        return full
    }
    if path_len >= 2 {
        // `core.hash` may name the file `hash.kf` in module `core`, but only
        // if that file exists.
        if contains_sym(file_paths, full) {
            val fallback = import_module_sym(&self.path, path_len - 1)
            if contains_sym(valid_paths, fallback) {
                return fallback
            }
        }
    }
    return poison_sym()
}

/// The module a named import targets, or poison.
fun Import.resolve_specific(valid_paths: &List<Sym>, valid_names: &List<Sym>, file_paths: &List<Sym>): Sym {
    val seg_count = self.path.size()
    if seg_count == 0 {
        return poison_sym()
    }
    val target_name = *self.path.at(seg_count - 1)
    val name_sym = intern(target_name.as_str())

    val module_seg_count = seg_count - 1
    if module_seg_count == 0 {
        if has_name_in_any_module(valid_paths, valid_names, name_sym) {
            return poison_sym()
        }
        return poison_sym()
    }

    val module_sym = import_module_sym(&self.path, module_seg_count)
    if contains_sym(valid_paths, module_sym) {
        if has_name_in_module(valid_paths, valid_names, module_sym, name_sym) {
            return module_sym
        }
    }

    if module_seg_count >= 2 {
        // As for a wildcard: the dropped segment must name an existing file.
        if contains_sym(file_paths, module_sym) {
            val fallback = import_module_sym(&self.path, module_seg_count - 1)
            if contains_sym(valid_paths, fallback) {
                if has_name_in_module(valid_paths, valid_names, fallback, name_sym) {
                    return fallback
                }
            }
        }
    }

    return poison_sym()
}

/// Every `<module>.<file stem>` an import may name: stems of this crate's
/// source files, plus those a dependency's `.kfi` carries, since a
/// separately compiled dependency has no sources to read.
fun Module.collect_importable_files(smap: Ptr<SourceMap>): List<Sym> {
    var out = List.new<Sym>()
    while d in &self.decls {
        var from_source = false
        when (d.linkage) {
            Source => { from_source = true }
            _ => { }
        }
        if from_source {
            val stem = unsafe { smap.file_stem_of(d.span.file_id) }
            if !stem.as_str().is_empty() {
                var dotted = String.from(d.module_path.as_str())
                dotted.append(".")
                dotted.append(stem.as_str())
                val sym = intern(dotted.as_str())
                if !contains_sym(&out, sym) { out.push(sym) }
            }
        }
    }
    var k = 0
    while k < unsafe { smap.interface_files.size() } {
        val entry = unsafe { *smap.interface_files.at(k) }
        val sym = intern(entry.as_str())
        if !contains_sym(&out, sym) { out.push(sym) }
        k = k + 1
    }
    return out
}

fun import_module_sym(path: &List<String>, count: uint64): Sym {
    var joined = ""
    var i = 0
    while i < count {
        if i > 0 {
            joined = joined + String.from(".")
        }
        joined = joined + *path.at(i)
        i = i + 1
    }
    return intern(joined.as_str())
}

fun contains_sym(list: &List<Sym>, target: Sym): bool {
    while item in &list {
        if item.id == target.id {
            return true
        }
    }
    return false
}

fun record_import(callers: Ptr<List<uint32>>,
                  targets: Ptr<List<Sym>>,
                  names: Ptr<List<Sym>>,
                  source: uint32,
                  imported: Sym,
                  admitted: Sym): void {
    unsafe { callers.push(source) }
    unsafe { targets.push(imported) }
    unsafe { names.push(admitted) }
}

fun import_admitted_name(path: &List<String>): Sym {
    val n = path.size()
    if n == 0 { return poison_sym() }
    val last = *path.at(n - 1)
    return intern(last.as_str())
}

fun has_pair(paths: &List<Sym>, names: &List<Sym>, mp: Sym, name: Sym): bool {
    while i in 0..paths.size() {
        if paths.get(i).id == mp.id {
            if names.get(i).id == name.id {
                return true
            }
        }
    }
    return false
}

fun has_name_in_any_module(paths: &List<Sym>, names: &List<Sym>, name_sym: Sym): bool {
    while name in &names {
        if name.id == name_sym.id {
            return true
        }
    }
    return false
}

fun has_name_in_module(paths: &List<Sym>, names: &List<Sym>, module_sym: Sym, name_sym: Sym): bool {
    while i in 0..paths.size() {
        if paths.get(i).id == module_sym.id {
            if names.get(i).id == name_sym.id {
                return true
            }
        }
    }
    return false
}

/// When every segment but the last resolves, names that segment rather than
/// the whole path.
fun wildcard_not_found_message(path: &List<String>, valid_paths: &List<Sym>): String {
    val n = path.size()
    if n >= 2 {
        val prefix = import_module_sym(path, n - 1)
        if contains_sym(valid_paths, prefix) {
            val msg = "cannot find `${path.at(n - 1).as_str()}` in module `${prefix.as_str()}` — no such module or source file"
            return msg
        }
    }
    return import_not_found_message(path)
}

fun import_not_found_message(path: &List<String>): String {
    var msg = String.from("cannot find module `")
    msg = msg + format_import_path(path)
    msg = msg + String.from("` — no such module exists in any dependency")
    return msg
}

fun import_name_not_found(name: String, path: &List<String>): String {
    val seg_count = path.size()
    var msg = String.from("cannot find `")
    msg = msg + name
    msg = msg + String.from("` in module `")
    if seg_count >= 2 {
        msg = msg + format_path_prefix(path, seg_count - 1)
    } else {
        msg = msg + *path.at(0)
    }
    msg = msg + String.from("`")
    return msg
}

fun format_import_path(path: &List<String>): String {
    var s = ""
    while i in 0..path.size() {
        if i > 0 {
            s = s + String.from(".")
        }
        s = s + *path.at(i)
    }
    return s
}

fun format_path_prefix(path: &List<String>, count: uint64): String {
    var s = ""
    var i = 0
    while i < count {
        if i > 0 {
            s = s + String.from(".")
        }
        s = s + *path.at(i)
        i = i + 1
    }
    return s
}
