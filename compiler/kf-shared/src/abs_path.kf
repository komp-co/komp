// Absolute paths for the crate-dedup key. Collapsing `..` is sound only on an
// absolute path: a relative one underflows, two routes to one crate stop
// comparing equal, and it is assembled twice. Symlinks stay unresolved.

import alloc.list.*

extern "C" fun kf_current_dir(): String

/// `p` unchanged when already absolute; otherwise `<cwd>/<p>`.
pub fun absolutize(p: str): String {
    val n = p.byte_len()
    if n > 0 {
        if p.byte_at(0) == 47 { // '/'
            return String.from(p)
        }
    }
    return shell_cwd() + String.from("/") + String.from(p)
}

/// Through getcwd, not a shell and a shared temp file. Not `current_dir`,
/// which is std.env's.
fun shell_cwd(): String {
    return kf_current_dir()
}

pub fun join_path(a: str, b: str): String {
    return String.from(a) + String.from("/") + String.from(b)
}

/// An absolute path unchanged, a relative one joined to `base`.
pub fun resolve_path(base: str, rel: str): String {
    val rn = rel.byte_len()
    if rn > 0 && rel.byte_at(0) == 47 {
        return String.from(rel)
    }
    return join_path(base, rel)
}

/// CONSTRAINT: absolutize first; canonicalize_path only collapses, and `.`
/// collapses to "".
pub fun normalized_path(p: str): String {
    return canonicalize_path(absolutize(p).as_str())
}

/// Collapses `.` and `<segment>/..`.
pub fun canonicalize_path(p: str): String {
    val n = p.byte_len()
    if n == 0 { return "" }
    var segs = List.new<String>()
    var i = 0
    val starts_abs = p.byte_at(0) == 47
    var start = 0
    if starts_abs {
        i = 1
        start = 1
    }
    while i <= n {
        val at_end = i == n
        val is_sep = !at_end && p.byte_at(i) == 47
        if at_end || is_sep {
            if i > start {
                val seg = p.substring(start, i)
                val seg_str = seg.as_str()
                if seg_str == ".." {
                    if segs.size() > 0 { segs.pop() }
                } else if seg_str != "." {
                    segs.push(seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    var out = ""
    if starts_abs { out = String.from("/") }
    while j in 0..segs.size() {
        if j > 0 { out = out + String.from("/") }
        out = out + *segs.at(j)
    }
    return out
}

/// Whether `path` lies under `prefix`, at a path boundary.
pub fun starts_with_path(path: str, prefix: str): bool {
    val pn = prefix.byte_len()
    val n = path.byte_len()
    if pn > n { return false }
    var i = 0
    while i < pn {
        if path.byte_at(i) != prefix.byte_at(i) { return false }
        i = i + 1
    }
    // At a boundary: `/a/lib` does not match `/a/library/src/x.kf`.
    if pn == n { return true }
    return path.byte_at(pn) == 47
}
