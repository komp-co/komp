// The program versions a project pins: `[tools]` in its kf.toml, or its
// workspace's, one row per package written as a dependency would be:
//
//   [tools]
//   komp_fmt = "0.1"
//   komp_doc = { version = "0.3", index = "work" }

import alloc.list.*
import kf_shared.join_path
import kf_tool.fetch.empty_lock_entry
import kf_tool.project.discover_manifest_root
import kf_tool.project.enclosing_workspace
import kf_tool.project.declared_index_url
import kf_tool.project.parse_dependency
import kf_tool.project.parse_requirement
import kf_tool.project.read_key
import kf_tool.project.render
import kf_tool.project.split_lines
import std.fs.exists
import std.io.eprintln

/// A pin: the requirement and the index it is resolved in, or `error`.
pub struct ToolPin {
    pub val requirement: String
    pub val index_url: String
    pub val error: String
}

/// The pin on `package` by the project holding `dir`, or null when no
/// project there pins it.
pub fun project_tool_pin(dir: str, package: str): ToolPin? {
    val root = discover_manifest_root(dir)
    if root.is_empty() { return null }
    val workspace = enclosing_workspace(root.as_str())
    val manifest = join_path(if workspace.is_empty() { root.as_str() } else { workspace.as_str() }, "kf.toml")
    if !exists(manifest.as_str()) { return null }
    val src = read_file(manifest.as_str())
    val row = tools_row(src.as_str(), package)
    if row.is_empty() { return null }
    val dep = parse_dependency(String.from(package), row.as_str())
    if parse_requirement(dep.version.as_str()) == null {
        val error = "kf.toml's [tools] gives `${package}` no version"
        return Option.Some(ToolPin { requirement: "", index_url: "", error: error })
    }
    val url = declared_index_url(src.as_str(), dep.index.as_str())
    if url.is_empty() {
        val error = "kf.toml's [tools] names index `${dep.index}` for `${package}`, which [indexes] does not declare"
        return Option.Some(ToolPin { requirement: "", index_url: "", error: error })
    }
    return Option.Some(ToolPin { requirement: dep.version.clone(), index_url: url, error: "" })
}

/// The stored binary `pin` picks: the highest version it allows, installed
/// first when none is stored. `error` when there is none.
pub fun pinned_tool(pin: &ToolPin, package: str, cache: str, home: str): StoredTool {
    if pin.error.byte_len() > 0 { return pinned_tool_failed(pin.error.as_str()) }
    val wanted = parse_requirement(pin.requirement.as_str()) ?: return pinned_tool_failed("bad requirement")
    var chosen = ""
    val stored = stored_versions(home, package)
    while version in &stored {
        if wanted.allows(version) { chosen = version.render() }
    }
    if chosen.byte_len() > 0 {
        val binary = stored_binary(home, package, chosen.as_str())
        return StoredTool { entry: empty_lock_entry(), binary: binary, error: "" }
    }
    eprintln(&"komp: installing `${package}`, which kf.toml's [tools] pins to \"${pin.requirement}\"")
    return store_tool(package, pin.requirement.as_str(), pin.index_url.as_str(), cache, home)
}

fun pinned_tool_failed(error: str): StoredTool {
    return StoredTool { entry: empty_lock_entry(), binary: "", error: String.from(error) }
}

/// `[tools]`'s whole row for `package`, or "".
fun tools_row(src: str, package: str): String {
    var in_tools = false
    val lines = split_lines(src)
    while item in &lines {
        val line = item.as_str().trim()
        if line.starts_with("[") {
            in_tools = line.as_str() == "[tools]"
        } else if in_tools && read_key(String.from(line.as_str())).as_str() == package {
            return line
        }
    }
    return ""
}
