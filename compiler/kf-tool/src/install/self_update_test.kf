import core.assert.assert_eq

@test
fun a_release_page_names_its_version(): void {
    assert_eq(version_in_release_url("https://github.com/komp-co/komp/releases/tag/v0.5.1").as_str(), "0.5.1",
        "after /tag/v")
}

@test
fun the_releases_list_names_no_version(): void {
    assert_eq(version_in_release_url("https://github.com/komp-co/komp/releases").as_str(), "", "no tag")
}
