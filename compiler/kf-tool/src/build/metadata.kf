// `komp metadata`: a project's resolved crates as JSON, for tools that drive
// kflatc themselves. Every crate a member reaches appears once, dependencies
// first, in the order the build graph gives.

import alloc.list.*
import json.writer.JsonWriter
import kf_tool.fetch.cache_root
import kf_tool.project.enclosing_workspace
import kf_tool.project.is_workspace_dir
import kf_tool.project.workspace_member_roots
import kf_tool.komp_version
import kf_tool.project.lint_toml_for
import alloc.path.Path
import std.fs.absolute

/// Bumped when a field changes meaning or goes away; a new field is not a
/// change.
pub fun metadata_schema(): int64 {
    return 1
}

/// The members of the workspace listing `dir`, or `dir` alone.
pub fun metadata_members(dir: str): List<String> {
    val workspace = metadata_workspace(dir)
    var out = List.new<String>()
    if workspace.as_str() == "" {
        out.push(canonical(dir))
        return out
    }
    val roots = workspace_member_roots(workspace.as_str())
    while root in &roots { out.push(canonical(root.as_str())) }
    return out
}

/// `dir` when it is a workspace, the workspace listing it when it is a member,
/// else "".
fun metadata_workspace(dir: str): String {
    if is_workspace_dir(dir) { return canonical(dir) }
    val listing = enclosing_workspace(dir)
    if listing.as_str() == "" { return listing }
    return canonical(listing.as_str())
}

fun canonical(path: str): String {
    return absolute(path).normalized().raw
}

/// The JSON `komp metadata` prints for the project at `dir`, and whether the
/// graph resolved. A failure still prints JSON: `schema` and `error`.
pub fun project_metadata(dir: str): MetadataResult {
    val members = metadata_members(dir)
    var graphs = List.new<BuildGraph>()
    while member in &members {
        val graph = build_crate_graph(member.as_str(), true)
        val error = graph.failure()
        if error.as_str() != "" { return metadata_failure(error.as_str()) }
        graphs.push(graph)
    }
    val first = if members.size() > 0 { members.at(0).clone() } else { String.from(dir) }
    var writer = JsonWriter.object()
    writer.field_int64("schema", metadata_schema())
    writer.field_string("komp_version", komp_version())
    writer.field_string("kflatc", kflatc_path().as_str())
    val workspace = metadata_workspace(dir)
    if workspace.as_str() == "" { writer.field_null("workspace_root") } else {
        writer.field_string("workspace_root", workspace.as_str())
    }
    writer.field_string("target_dir", target_dir(first.as_str()).as_str())
    writer.key("members")
    writer.write_string_list(&members)
    val places = CratePlaces { libs: bundled_libs_root(first.as_str()), cache: cache_root() }
    var seen = List.new<String>()
    writer.key("crates")
    writer.begin_array()
    while graph in &graphs {
        while item in &graph.crates {
            // A package holding a library and a program is two crates at one root.
            val key = "${item.name}=${item.root}"
            if !seen.contains(&key) {
                seen.push(key)
                item.write_metadata(&var writer, &members, &places)
            }
        }
    }
    writer.end_array()
    return MetadataResult { json: writer.finish(), ok: true }
}

pub struct MetadataResult {
    pub val json: String
    pub val ok: bool
}

pub fun metadata_failure(error: str): MetadataResult {
    var writer = JsonWriter.object()
    writer.field_int64("schema", metadata_schema())
    writer.field_string("error", error)
    return MetadataResult { json: writer.finish(), ok: false }
}

/// The graph's own error, else its cycle, else "".
fun BuildGraph.failure(): String {
    if self.error.as_str() != "" { return self.error.clone() }
    if self.cycle.as_str() != "" { return "dependency cycle: ${self.cycle}" }
    return ""
}

/// Where the bundled libraries and fetched crates live, to say where each
/// crate came from.
struct CratePlaces {
    val libs: String
    val cache: String
}

/// "bundled", "fetched" or "path".
fun CratePlaces.source_of(root: str): String {
    if self.libs.as_str() != "" && root.starts_with("${self.libs}/".as_str()) { return "bundled" }
    if root.starts_with("${self.cache}/".as_str()) { return "fetched" }
    return "path"
}

/// Which of `deps` only the crate's tests need: its `[dev-dependencies]`
/// that are not also `[dependencies]`.
///
/// CONSTRAINT: no capturing lambda. kf_tool is a library, and a capturing
/// lambda in one breaks every crate using it with the released compilers.
fun BuildCrate.dev_deps_of(manifest: &Manifest): List<String> {
    var dev: List<String> = []
    while dep in &manifest.dev_deps { dev.push(dep.name.clone()) }
    var regular: List<String> = []
    while dep in &manifest.deps { regular.push(dep.name.clone()) }
    var out: List<String> = []
    while name in &self.deps {
        if dev.contains(name) && !regular.contains(name) { out.push(name.clone()) }
    }
    return out
}

fun BuildCrate.write_metadata(writer: &var JsonWriter, members: &List<String>, places: &CratePlaces): void {
    val manifest = manifest_of(self.root.as_str())
    writer.begin_object()
    writer.field_string("name", self.name.as_str())
    writer.field_string("version", manifest.version.as_str())
    writer.field_string("kind", if self.is_bin { "bin" } else { "lib" })
    writer.field_string("root", self.root.as_str())
    writer.field_string("src", self.src.as_str())
    writer.field_string("source", places.source_of(self.root.as_str()).as_str())
    writer.field_bool("member", members.contains(&self.root))
    writer.key("deps")
    writer.write_string_list(&self.deps)
    writer.key("loads")
    writer.write_string_list(&self.loads)
    writer.key("dev_deps")
    writer.write_string_list(&self.dev_deps_of(&manifest))
    writer.key("lints")
    writer.begin_array()
    val file = lint_toml_for(self.root.as_str())
    while row in &file.groups { writer.write_lint_row(row.as_str()) }
    while row in &file.lints { writer.write_lint_row(row.as_str()) }
    while row in 0..manifest.lint_names.size() {
        writer.begin_object()
        writer.field_string("name", manifest.lint_names.at(row).as_str())
        writer.field_string("level", manifest.lint_levels.at(row).as_str())
        writer.end_object()
    }
    writer.end_array()
    writer.key("lint_options")
    writer.begin_array()
    while row in &file.options { writer.write_lint_option(row.as_str()) }
    writer.end_array()
    writer.end_object()
}

/// A lint.toml option, `name.key=value`, as `{"name": ..., "key": ..., "value": ...}`;
/// the value stays the text lint.toml gives, for the compiler to check.
mutating fun JsonWriter.write_lint_option(row: str): void {
    val dot = row.index_of(".") ?: return
    val eq = row.index_of("=") ?: return
    self.begin_object()
    self.field_string("name", row.substring(0, dot).as_str())
    self.field_string("key", row.substring(dot + 1, eq).as_str())
    self.field_string("value", row.substring(eq + 1, row.byte_len()).as_str())
    self.end_object()
}

/// A lint.toml row, `name=level`, as `{"name": ..., "level": ...}`.
mutating fun JsonWriter.write_lint_row(row: str): void {
    val eq = row.index_of("=") ?: return
    self.begin_object()
    self.field_string("name", row.substring(0, eq).as_str())
    self.field_string("level", row.substring(eq + 1, row.byte_len()).as_str())
    self.end_object()
}

mutating fun JsonWriter.write_string_list(items: &List<String>): void {
    self.begin_array()
    while item in items { self.write_string(item.as_str()) }
    self.end_array()
}
