// A diamond (app -> liba, libb; both -> libc) and a two-crate cycle: the
// shared crate is deduplicated, order is deterministic, the cycle is complete.

import core.assert.assert_eq
import alloc.list.*
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun write_graph_crate(root: str, name: str, kind: str, deps: str): void {
    val mk = "mkdir -p ${root}/src"
    val _rc = unsafe { system(mk.as_str()) }
    var toml = "[project]\nname = \"${name}\"\nkind = \"${kind}\"\n"
    toml.append("\n[dependencies]\n")
    toml.append(deps)
    val toml_path = String.from(root) + String.from("/kf.toml")
    write_file(toml_path.as_str(), toml.as_str())
    val src = "pub fun ${name}_touch(): int32 { return 0 }\n"
    val src_path = String.from(root) + String.from("/src/lib.kf")
    write_file(src_path.as_str(), src.as_str())
}

fun write_diamond(): void {
    write_graph_crate(scratch_path("kf_g_libc"), "glibc_fx", "lib", "")
    write_graph_crate(scratch_path("kf_g_liba"), "gliba_fx", "lib", "glibc_fx = { path = \"../kf_g_libc\" }\n")
    write_graph_crate(scratch_path("kf_g_libb"), "glibb_fx", "lib", "glibc_fx = { path = \"../kf_g_libc\" }\n")
    write_graph_crate(scratch_path("kf_g_app"), "gapp_fx", "bin", """gliba_fx = { path = "../kf_g_liba" }
glibb_fx = { path = "../kf_g_libb" }
""")
}

fun write_nameless_graph_crate(): void {
    val _rc = unsafe { system("mkdir -p ${scratch_path("kf_g_nameless/src")}") }
    write_file(scratch_path("kf_g_nameless/kf.toml"), "[project]\nkind = \"bin\"\n")
    write_file(scratch_path("kf_g_nameless/src/main.kf"), "fun main(): void {}\n")
}

fun write_graph_with_valid_and_nameless_dependencies(): void {
    write_graph_crate(scratch_path("kf_g_valid_before_bad"), "valid_before_bad", "lib", "")
    val _created = unsafe { system("mkdir -p ${scratch_path("kf_g_bad_dependency/src")}") }
    write_file(scratch_path("kf_g_bad_dependency/kf.toml"), "[project]\nkind = \"lib\"\n")
    write_file(scratch_path("kf_g_bad_dependency/src/lib.kf"), "pub fun touch_bad(): int32 { return 0 }\n")
    val deps = "valid = { path = \"../kf_g_valid_before_bad\" }\nbad = { path = \"../kf_g_bad_dependency\" }\n"
    write_graph_crate(scratch_path("kf_g_partial_app"), "partial_app", "bin", deps)
}

fun write_graph_with_missing_dependency_manifest(): void {
    val _removed = unsafe { system("rm -f ${scratch_path("kf_g_missing_manifest_78/kf.toml")}") }
    write_graph_crate(scratch_path("kf_g_missing_manifest_app"), "missing_manifest_app", "bin", "missing = { path = \"../kf_g_missing_manifest_78\" }\n")
}

fun BuildGraph.graph_names(): String {
    var out = ""
    while i in 0..self.crates.size() {
        if i > 0 { out.append(",") }
        out.append(self.crates.at(i).name.as_str())
    }
    return out
}

@test
fun diamond_orders_dependencies_first_and_deduplicates(): void {
    write_diamond()
    val g = build_crate_graph(scratch_path("kf_g_app"))
    assert_eq(g.graph_names().as_str(), "core,alloc,glibc_fx,gliba_fx,glibb_fx,gapp_fx", "stdlib and shared deps appear once before dependents")
}

@test
fun diamond_graph_is_deterministic(): void {
    write_diamond()
    val first = build_crate_graph(scratch_path("kf_g_app"))
    val second = build_crate_graph(scratch_path("kf_g_app"))
    assert_eq(first.graph_names().as_str() == second.graph_names().as_str(), true, "two walks yield one order")
}

@test
fun diamond_graph_is_acyclic(): void {
    write_diamond()
    val g = build_crate_graph(scratch_path("kf_g_app"))
    assert_eq(g.cycle.as_str(), "", "a DAG reports no cycle")
}

@test
fun root_records_direct_dependency_names(): void {
    write_diamond()
    val g = build_crate_graph(scratch_path("kf_g_app"))
    val root = *g.crates.at(g.crates.size() - 1)
    val two = root.deps.size() == 2
    val named = root.deps.at(0).as_str() == "gliba_fx"
    assert_eq(two && named, true, "direct deps carry manifest crate names in order")
}

@test
fun cycles_are_reported_completely(): void {
    write_graph_crate(scratch_path("kf_g_x"), "gx_fx", "lib", "gy_fx = { path = \"../kf_g_y\" }\n")
    write_graph_crate(scratch_path("kf_g_y"), "gy_fx", "lib", "gx_fx = { path = \"../kf_g_x\" }\n")
    val g = build_crate_graph(scratch_path("kf_g_x"))
    val has_x = g.graph_cycle_mentions(scratch_path("kf_g_x"))
    val has_y = g.graph_cycle_mentions(scratch_path("kf_g_y"))
    assert_eq(has_x && has_y, true, "the reported cycle names every participant")
}

@test
fun test_nameless_manifest_stops_graph_construction(): void {
    write_nameless_graph_crate()
    val graph = build_crate_graph(scratch_path("kf_g_nameless"))
    val expected: str = "error: invalid manifest ${scratch_path("kf_g_nameless/kf.toml")}: manifest has no crate name (expected name in [project] or [package])"
    assert_eq(graph.crates.size() == 0 && graph.error.as_str() == expected, true, "invalid manifest stops before an empty crate enters the graph")
}

@test
fun test_nameless_dependency_discards_partial_graph(): void {
    write_graph_with_valid_and_nameless_dependencies()
    val graph = build_crate_graph(scratch_path("kf_g_partial_app"))
    val names_bad_manifest = graph.error.as_str() == "error: invalid manifest ${scratch_path("kf_g_bad_dependency/kf.toml")}: manifest has no crate name (expected name in [project] or [package])".as_str()
    assert_eq(graph.crates.size() == 0 && names_bad_manifest, true, "an invalid dependency invalidates the entire graph")
}

@test
fun test_missing_dependency_manifest_invalidates_graph(): void {
    write_graph_with_missing_dependency_manifest()
    val graph = build_crate_graph(scratch_path("kf_g_missing_manifest_app"))
    val expected: str = "error: no kf.toml manifest found at ${scratch_path("kf_g_missing_manifest_78/kf.toml")}"
    assert_eq(graph.crates.size() == 0 && graph.error.as_str() == expected, true, "a missing dependency manifest invalidates the graph")
}

fun BuildGraph.graph_cycle_mentions(needle: str): bool {
    return self.cycle.as_str().contains(needle)
}

fun joined(names: &List<String>): String {
    var out = ""
    while name in &names {
        if out.byte_len() > 0 { out.append(",") }
        out.append(name.as_str())
    }
    return out
}

@test
fun a_crate_loads_its_whole_closure_dependencies_first(): void {
    write_diamond()
    val g = build_crate_graph(scratch_path("kf_g_app"))
    val app = g.crates.at(g.crates.size() - 1)
    assert_eq(joined(&app.loads).as_str(), "core,alloc,glibc_fx,gliba_fx,glibb_fx", "every reached crate, in graph order")
}
