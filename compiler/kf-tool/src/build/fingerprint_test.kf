// Content decides everything: identical bytes rewritten change nothing, and
// timestamps are never read.

import core.assert.assert_eq
import alloc.list.*

import std.fs.scratch_path
import kf_shared.crate_artifact_manifest_path
import std.fs.exists

extern "C" fun system(cmd: str): int32

fun prepare_fingerprint_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_fp")} && mkdir -p ${scratch_path("kf_sc7_fp/src/inner")} ${scratch_path("kf_sc7_fp/native")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_sc7_fp/kf.toml"), """[project]
name = "fp"
kind = "lib"

[native]
c_sources = ["native/fp.c"]
""")
    write_file(scratch_path("kf_sc7_fp/src/lib.kf"), "pub fun one(): int32 {\n    return 1\n}\n")
    write_file(scratch_path("kf_sc7_fp/src/inner/two.kf"), "pub fun two(): int32 {\n    return 2\n}\n")
    write_file(scratch_path("kf_sc7_fp/native/fp.c"), "int fp_native(void) { return 1; }\n")
    return 0
}

@test
fun source_fingerprint_is_deterministic(): void {
    val prep = prepare_fingerprint_fixture()
    val first = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    val second = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && first.as_str() == second.as_str(), true, "same tree fingerprints identically")
}

@test
fun source_fingerprint_ignores_timestamps(): void {
    val prep = prepare_fingerprint_fixture()
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    write_file(scratch_path("kf_sc7_fp/src/lib.kf"), "pub fun one(): int32 {\n    return 1\n}\n")
    val _touch = unsafe { system("touch ${scratch_path("kf_sc7_fp/src/inner/two.kf")}") }
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && before.as_str() == after.as_str(), true, "identical bytes fingerprint identically regardless of mtime")
}

@test
fun source_fingerprint_tracks_content(): void {
    val prep = prepare_fingerprint_fixture()
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    write_file(scratch_path("kf_sc7_fp/src/lib.kf"), "pub fun one(): int32 {\n    return 3\n}\n")
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && before.as_str() != after.as_str(), true, "a changed body changes the fingerprint")
}

@test
fun source_fingerprint_tracks_native_content(): void {
    val prep = prepare_fingerprint_fixture()
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    write_file(scratch_path("kf_sc7_fp/native/fp.c"), "int fp_native(void) { return 2; }\n")
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && before.as_str() != after.as_str(), true, "changed native source changes the fingerprint")
}

@test
fun source_fingerprint_tracks_the_manifest(): void {
    val prep = prepare_fingerprint_fixture()
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    write_file(scratch_path("kf_sc7_fp/kf.toml"), "[project]\nname = \"fp\"\nversion = \"0.2.0\"\nkind = \"lib\"\n")
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && before.as_str() != after.as_str(), true, "a manifest change changes the fingerprint")
}

@test
fun source_fingerprint_empty_for_missing_source(): void {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_fp_none")} && mkdir -p ${scratch_path("kf_sc7_fp_none")}") }
    val fp = crate_source_fingerprint(scratch_path("kf_sc7_fp_none"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && fp.as_str() == "", true, "an artifacts-only crate has no source fingerprint")
}

@test
fun profile_key_separates_instrumented_builds(): void {
    val plain = build_profile_key("", false)
    val asan = build_profile_key("-fsanitize=address", false)
    assert_eq(plain.as_str() == "default" && asan.as_str() != "default", true, "extra cflags select a distinct profile")
}

@test
fun sorted_string_list_orders_bytes(): void {
    var xs = List.new<String>()
    xs.push(String.from("b/z.kf"))
    xs.push(String.from("a/z.kf"))
    xs.push(String.from("a/a.kf"))
    val ordered = sorted_string_list(&xs)
    var ok = ordered.at(0).as_str() == "a/a.kf"
    ok = ok && ordered.at(1).as_str() == "a/z.kf"
    ok = ok && ordered.at(2).as_str() == "b/z.kf"
    assert_eq(ok, true, "paths sort bytewise ascending")
}

@test
fun reuse_rejected_without_metadata(): void {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_fp_meta")} && mkdir -p ${scratch_path("kf_sc7_fp_meta")}") }
    val expected = empty_artifact_manifest()
    val decision = decide_crate_reuse(scratch_path("kf_sc7_fp_meta"), &expected)
    assert_eq(prep == 0 && decision.reuse == false, true, "no recorded metadata means rebuild")
}

@test
fun reused_interface_hash_outlives_parsed_metadata(): void {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_fp_reuse")} && mkdir -p ${scratch_path("kf_sc7_fp_reuse")}") }
    val expected = sample_artifact_manifest()
    val interface_text = String.from("interface bytes")
    val interface_hash = content_hash(interface_text.as_str())
    val recorded = expected.recorded_artifact_manifest(interface_hash.as_str())
    write_file(scratch_path("kf_sc7_fp_reuse/gen_dep.kfi"), interface_text.as_str())
    write_file(scratch_path("kf_sc7_fp_reuse/gen_dep.h"), "header")
    write_file(scratch_path("kf_sc7_fp_reuse/libgen_dep.a"), "archive")
    val wrote = write_artifact_manifest(scratch_path("kf_sc7_fp_reuse/gen_dep.artifact.toml"), &recorded)
    val decision = decide_crate_reuse(scratch_path("kf_sc7_fp_reuse"), &expected)
    var churn = List.new<String>()
    var i: uint64 = 0
    while i < 128 {
        churn.push(String.from("replacement"))
        i = i + 1
    }
    assert_eq(prep == 0 && wrote && decision.interface_hash.as_str() == interface_hash.as_str(), true, "reuse returns an owned interface hash")
}

@test
fun profile_key_separates_a_freestanding_build(): void {
    val hosted = build_profile_key("", false)
    val bare = build_profile_key("", true)
    assert_eq(hosted.as_str() == "default" && bare.as_str() != hosted.as_str(), true, "freestanding is its own profile")
}

@test
fun profile_key_separates_freestanding_from_instrumented(): void {
    val bare = build_profile_key("", true)
    val asan = build_profile_key("-fsanitize=address", false)
    val both = build_profile_key("-fsanitize=address", true)
    val all_distinct = bare.as_str() != asan.as_str() && bare.as_str() != both.as_str() && asan.as_str() != both.as_str()
    assert_eq(all_distinct, true, "the two profile axes compose without colliding")
}

@test
fun a_changed_hosted_c_source_changes_the_fingerprint(): void {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_fp_hosted")} && mkdir -p ${scratch_path("kf_sc7_fp_hosted/src")} ${scratch_path("kf_sc7_fp_hosted/native")}") }
    write_file(scratch_path("kf_sc7_fp_hosted/kf.toml"), """[project]
name = "fph"
kind = "lib"

[native]
c_sources = ["native/a.c"]
hosted_c_sources = ["native/b.c"]
""")
    write_file(scratch_path("kf_sc7_fp_hosted/src/lib.kf"), "pub fun one(): int32 {\n    return 1\n}\n")
    write_file(scratch_path("kf_sc7_fp_hosted/native/a.c"), "int a_native(void) { return 1; }\n")
    write_file(scratch_path("kf_sc7_fp_hosted/native/b.c"), "int b_native(void) { return 1; }\n")
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp_hosted"), &fixture_compiler("bin"))
    write_file(scratch_path("kf_sc7_fp_hosted/native/b.c"), "int b_native(void) { return 2; }\n")
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp_hosted"), &fixture_compiler("bin"))
    assert_eq(prep == 0 && before.as_str() != after.as_str(), true, "the hosted half is fingerprinted like any other C source")
}

fun prepare_failing_native_fixture(): int32 {
    val root = scratch_path("kf_sc7_fail")
    val prep = unsafe { system("rm -rf ${root} && mkdir -p ${root}/src ${root}/native") }
    if prep != 0 { return prep }
    write_file("${root}/kf.toml".as_str(), "[project]\nname = \"fail_lib\"\nversion = \"0.1.0\"\nkind = \"lib\"\n\n[native]\nc_sources = [\"native/bit.c\"]\n")
    write_file("${root}/src/lib.kf".as_str(), "pub fun answer(): int32 { return 42 }\n")
    write_file("${root}/native/bit.c".as_str(), "int fail_lib_bit(void) { return 1; }\n")
    return 0
}

@test
fun a_rebuild_that_fails_leaves_no_reuse_metadata(): void {
    // The `.h` is written before the compile that can fail; a surviving
    // manifest would pair it with the old archive.
    val root = scratch_path("kf_sc7_fail")
    assert_eq(prepare_failing_native_fixture(), 0, "the fixture is prepared")
    assert_eq(build_project_separate(root, ""), 0, "it builds once")
    val manifest = crate_artifact_manifest_path(target_dir(root).as_str(), "fail_lib")
    assert_eq(exists(manifest.as_str()), true, "a finished build records its metadata")

    // The native source is fingerprinted, so this rebuilds and fails at cc.
    write_file("${root}/native/bit.c".as_str(), "int fail_lib_bit(void) {\n")
    assert_eq(build_project_separate(root, "-w 2>/dev/null") != 0, true, "the rebuild fails")
    assert_eq(!exists(manifest.as_str()), true, "and leaves nothing claiming the crate is current")
}

@test
fun a_crate_is_rebuilt_after_a_failed_rebuild(): void {
    val root = scratch_path("kf_sc7_fail_again")
    val prep = unsafe { system("rm -rf ${root} && mkdir -p ${root}/src ${root}/native") }
    assert_eq(prep, 0, "the fixture is prepared")
    write_file("${root}/kf.toml".as_str(), "[project]\nname = \"again_lib\"\nversion = \"0.1.0\"\nkind = \"lib\"\n\n[native]\nc_sources = [\"native/bit.c\"]\n")
    write_file("${root}/src/lib.kf".as_str(), "pub fun answer(): int32 { return 42 }\n")
    write_file("${root}/native/bit.c".as_str(), "int again_lib_bit(void) { return 1; }\n")
    assert_eq(build_project_separate(root, ""), 0, "it builds once")
    write_file("${root}/native/bit.c".as_str(), "int again_lib_bit(void) {\n")
    assert_eq(build_project_separate(root, "-w 2>/dev/null") != 0, true, "the rebuild fails")
    // Repairing the source suffices; no target directory is deleted.
    write_file("${root}/native/bit.c".as_str(), "int again_lib_bit(void) { return 2; }\n")
    assert_eq(build_project_separate(root, ""), 0, "the repaired crate builds again")
}

fun fixture_compiler(binary_hash: str): CompilerIdentity {
    return CompilerIdentity {
        abi: String.from("komp-1"), runtime: String.from("kflat-runtime-1"), target: String.from("x86_64-linux-gnu"),
        binary_hash: String.from(binary_hash)
    }
}

@test
fun a_different_compiler_binary_changes_the_fingerprint(): void {
    val _prep = prepare_fingerprint_fixture()
    val before = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("one"))
    val after = crate_source_fingerprint(scratch_path("kf_sc7_fp"), &fixture_compiler("two"))
    assert_eq(before.as_str() != after.as_str(), true, "a rebuilt kflatc rebuilds the crate")
}

@test
fun a_version_field_is_read_by_its_key(): void {
    val lines = "kflatc 0.1.0\nabi komp-1\nruntime kflat-runtime-1\n".lines()
    assert_eq(version_field(&lines, "runtime").as_str(), "kflat-runtime-1", "the value after the key")
}
