import alloc.list.*
import core.assert.assert_eq

fun version_lines(first: str): List<String> {
    var lines = List.new<String>()
    lines.push(String.from(first))
    lines.push(String.from("abi komp-1"))
    return lines
}

@test
fun a_kflatc_older_than_komp_drives_is_named(): void {
    assert_eq(kflatc_too_old(&version_lines("kflatc 0.5.4")).as_str(), "0.5.4", "its version")
}

@test
fun the_oldest_kflatc_komp_drives_is_not_too_old(): void {
    assert_eq(kflatc_too_old(&version_lines("kflatc 0.6.0")).as_str(), "", "the floor itself")
}

@test
fun a_version_line_komp_cannot_read_is_not_refused(): void {
    assert_eq(kflatc_too_old(&version_lines("kflatc dev")).as_str(), "", "left to the abi check")
}
