import alloc.list.*
import kf_shared.canonicalize_path
import std.fs.exists



pub struct NativeSources {
    pub val text: String
    pub val error: String
}

fun native_path_seen(paths: &List<String>, path: str): bool {
    while item in &paths {
        if item.as_str() == path { return true }
    }
    return false
}

mutating fun String.append_native_source(source: String): void {
    self.append(source.as_str())
    val len = source.as_str().byte_len()
    if len == 0 {
        self.append("\n")
        return
    }
    if source.as_str().byte_at(len - 1) != 10 {
        self.append("\n")
    }
}

/// In manifest order, skipping paths already taken. "" on success, else the
/// diagnostic.
fun append_crate_sources(crate_name: str, crate_root: str, relatives: &List<String>, seen: &var List<String>, text: &var String): String {
    while relative in &relatives {
        var joined = String.from(crate_root)
        joined.append("/")
        joined.append(relative.as_str())
        val path = canonicalize_path(joined.as_str())
        if !native_path_seen(seen, path.as_str()) {
            if !exists(path.as_str()) {
                val error = "error: native source for crate `${crate_name}` does not exist: ${relative.as_str()} (${path.as_str()})"
                return error
            }
            seen.push(path.clone())
            text.append_native_source(read_file(path.as_str()))
        }
    }
    return ""
}

pub fun BuildGraph.collect_native_sources(): NativeSources {
    var text = ""
    var seen = List.new<String>()
    while crate in &self.crates {
        val name = crate.name.as_str()
        val root = crate.root.as_str()
        val plain = append_crate_sources(name, root, &crate.c_sources, &var seen, &var text)
        if plain.as_str() != "" { return NativeSources { text: "", error: plain } }
        // The hosted half follows, so a freestanding build is a prefix of a
        // hosted one.
        val hosted = append_crate_sources(name, root, &crate.hosted_c_sources, &var seen, &var text)
        if hosted.as_str() != "" { return NativeSources { text: "", error: hosted } }
    }
    return NativeSources { text: text, error: "" }
}

pub fun compose_unity_source(root_dir: str, generated: String): NativeSources {
    val graph = build_crate_graph(root_dir)
    if graph.error.as_str() != "" {
        return NativeSources { text: "", error: graph.error }
    }
    val native = graph.collect_native_sources()
    if native.error.as_str() != "" { return native }
    return compose_unity_text(generated, native.text)
}

pub fun compose_unity_text(generated: String, native: String): NativeSources {
    var text = generated
    text.append("\n#define KF_NATIVE_UNITY 1\n")
    text.append(native.as_str())
    return NativeSources { text: text, error: "" }
}

/// None, reported, when a crate's native sources cannot be read.
pub fun compose_project_unity(root_dir: str, generated: String): String? {
    val unity = compose_unity_source(root_dir, generated)
    if unity.error.as_str() == "" { return Option.Some(unity.text) }
    runtime_println(unity.error.as_str())
    return Option.None
}
