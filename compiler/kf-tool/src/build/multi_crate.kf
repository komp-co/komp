// A whole project in one module: the unity build through kflatc, and the
// in-process check the tests drive.

import std.fs.*
import alloc.list.*
import alloc.path.*
import std.process.*

import kf_tool.project.*
import kf_shared.join_path

extern "C" fun write_file(path: str, content: str): void

/// kflatc's unity output with every crate's native C appended, or None when
/// it failed, reported.
pub fun compile_project(root_dir: str): String? {
    val graph = build_crate_graph(root_dir)
    if graph.error.as_str() != "" {
        runtime_println(graph.error.as_str())
        return Option.None
    }
    val temp = TempDir.new("komp-unity")
    val generated = temp.path().join("generated.c")
    if graph.invoke_kflatc_unity(root_dir, generated.as_str(), project_is_bin(root_dir), false) != 0 {
        return Option.None
    }
    return compose_project_unity(root_dir, read_file(generated.as_str()))
}

/// `kind = "bin"` (the default) rather than `"lib"`. A lib emits no `main`.
pub fun project_is_bin(root: str): bool {
    if manifest_missing(root) { return false }
    val manifest_path = join_path(root, "kf.toml")
    val toml_src = read_file(manifest_path.as_str())
    val mf = parse_manifest(toml_src.as_str())
    return mf.kind.as_str() == "bin"
}

/// The root manifest, re-read for its `[lint]` rows.
pub fun manifest_of(root_dir: str): Manifest {
    return parse_manifest(read_file(join_path(root_dir, "kf.toml").as_str()).as_str())
}

/// Dependencies compile as production, the root with its `_test.kf` files and
/// a synthesized `main` calling every `@test`. Returns the test binary's exit
/// status.
pub fun test_project(root_dir: str): int32 {
    val graph = build_crate_graph(root_dir)
    if graph.error.as_str() != "" {
        runtime_println(graph.error.as_str())
        return 1
    }
    val temp = TempDir.new("komp-test")
    val generated_path = temp.path().join("generated.c")
    if graph.invoke_kflatc_unity(root_dir, generated_path.as_str(), false, true) != 0 {
        runtime_println("komp test: compilation errors")
        return 1
    }
    val generated = read_file(generated_path.as_str())
    val unity = compose_unity_source(root_dir, generated)
    if unity.error.as_str() != "" {
        runtime_println(unity.error.as_str())
        return 1
    }
    val c = unity.text
    val source = temp.path().join("tests.c")
    val binary = temp.path().join("tests")
    write_file(source.as_str(), c.as_str())
    var cc = Command.new("cc")
    cc.arg(dialect_flags())
    cc.arg(source.as_str())
    cc.arg("-o")
    cc.arg(binary.as_str())
    val cc_status = cc.status()
    if !cc_status.success() {
        runtime_println("komp test: cc failed")
        return cc_status.exit_code()
    }
    var child = Command.new(binary.as_str())
    child.env("KFLATC", kflatc_path().as_str())
    return child.status().exit_code()
}
