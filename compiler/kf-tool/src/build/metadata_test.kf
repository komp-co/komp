// `komp metadata` over scratch projects: a lone crate with a path dependency,
// a two-member workspace sharing one, and a graph that does not resolve.

import core.assert.assert_eq
import alloc.list.*
import json.reader.JsonKind
import json.reader.JsonReader
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun write_metadata_crate(dir: str, name: str, kind: str, deps: str): void {
    val _made = unsafe { system("rm -rf ${dir} && mkdir -p ${dir}/src") }
    val project = "[project]\nname = \"${name}\"\nversion = \"1.2.3\"\nkind = \"${kind}\"\n"
    write_file("${dir}/kf.toml".as_str(), "${project}\n[dependencies]\n${deps}".as_str())
    write_file("${dir}/src/lib.kf".as_str(), "pub fun ${name}_touch(): int32 { return 0 }\n".as_str())
}

/// `kf_md_app` (bin, `[lint] dead_code = "allow"`) depending on `kf_md_util`.
fun lone_project(): String {
    write_metadata_crate(scratch_path("kf_md_util"), "md_util", "lib", "")
    write_metadata_crate(scratch_path("kf_md_app"), "md_app", "bin", "md_util = { path = \"../kf_md_util\" }\n")
    val manifest = read_file(scratch_path("kf_md_app/kf.toml"))
    write_file(scratch_path("kf_md_app/kf.toml"), "${manifest}\n[lint]\ndead_code = \"allow\"\n".as_str())
    return String.from(scratch_path("kf_md_app"))
}

/// Members `one` and `two`, both depending on `shared` outside the workspace.
fun workspace_project(): String {
    val ws = scratch_path("kf_md_ws")
    val _made = unsafe { system("rm -rf ${ws} && mkdir -p ${ws}") }
    write_metadata_crate(scratch_path("kf_md_shared"), "md_shared", "lib", "")
    val dep = "md_shared = { path = \"../../kf_md_shared\" }\n"
    write_metadata_crate("${ws}/one".as_str(), "md_one", "lib", dep)
    write_metadata_crate("${ws}/two".as_str(), "md_two", "lib", dep)
    write_file("${ws}/kf.toml".as_str(), "[workspace]\nmembers = [\"one\", \"two\"]\n")
    return String.from(ws)
}

/// The value of top-level `field` as JSON text, or "" when it is absent.
fun top_level_string(json: &String, field: str): String {
    var reader = JsonReader.new(json.as_str())
    if !reader.begin_object() { return "" }
    while reader.object_has_next() {
        val key = reader.read_key()
        if key.as_str() == field {
            if reader.take_null() { return "null" }
            return reader.read_string()
        }
        reader.skip_value()
    }
    return ""
}

/// `field` of every crate in order, joined by ",": booleans as true/false.
fun crate_fields(json: &String, field: str): String {
    var reader = JsonReader.new(json.as_str())
    var out = ""
    if !reader.begin_object() { return out }
    while reader.object_has_next() {
        val key = reader.read_key()
        if key.as_str() != "crates" {
            reader.skip_value()
        } else if reader.begin_array() {
            while reader.array_has_next() {
                out.append(reader.crate_field(field).as_str())
                out.append(",")
            }
        }
    }
    return out
}

mutating fun JsonReader.crate_field(field: str): String {
    var found = ""
    if !self.begin_object() { return found }
    while self.object_has_next() {
        val key = self.read_key()
        if key.as_str() != field {
            self.skip_value()
        } else if field == "member" {
            found = if self.read_bool() { String.from("true") } else { String.from("false") }
        } else if field == "lints" || field == "deps" {
            found = self.string_array_or_rows()
        } else if field == "lint_options" {
            found = self.option_rows()
        } else {
            found = self.read_string()
        }
    }
    return found
}

/// `["a","b"]` as `a b`; `[{"name":n,"level":l}]` as `n=l`.
mutating fun JsonReader.string_array_or_rows(): String {
    var out = ""
    if !self.begin_array() { return out }
    while self.array_has_next() {
        if out.byte_len() > 0 { out.append(" ") }
        if self.peek_kind() != JsonKind.Object {
            out.append(self.read_string().as_str())
        } else {
            val _opened = self.begin_object()
            var name = ""
            var level = ""
            while self.object_has_next() {
                val key = self.read_key()
                if key.as_str() == "name" { name = self.read_string() } else { level = self.read_string() }
            }
            out.append("${name}=${level}".as_str())
        }
    }
    return out
}

@test
fun a_lone_crate_lists_its_dependency_first(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "name").as_str().ends_with("md_util,md_app,"), true,
        "the bundled libraries, then the dependency, then the root")
}

@test
fun a_lone_crate_has_no_workspace(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(top_level_string(&metadata.json, "workspace_root").as_str(), "null", "null, not absent")
}

@test
fun only_the_crate_asked_about_is_a_member(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "member").as_str().ends_with("false,true,"), true,
        "its dependency is not")
}

@test
fun a_crate_names_its_dependencies_by_crate_name(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "deps").as_str().ends_with(",md_util,"), true, "the root's deps")
}

@test
fun a_crate_carries_its_version_and_kind(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "version").as_str().ends_with("1.2.3,1.2.3,"), true, "from kf.toml")
}

/// `[{"name":n,"key":k,"value":v}]` as `n.k=v`.
mutating fun JsonReader.option_rows(): String {
    var out = ""
    if !self.begin_array() { return out }
    while self.array_has_next() {
        if out.byte_len() > 0 { out.append(" ") }
        var name = ""
        var key = ""
        var value = ""
        val _opened = self.begin_object()
        while self.object_has_next() {
            val field = self.read_key()
            when field.as_str() {
                "name" => name = self.read_string()
                "key" => key = self.read_string()
                _ => value = self.read_string()
            }
        }
        out.append("${name}.${key}=${value}".as_str())
    }
    return out
}

@test
fun a_crate_carries_its_lint_toml_options(): void {
    val root = lone_project()
    write_file("${root}/lint.toml".as_str(), "[lints]\ntoo_many_parameters = { max = 5 }\n")
    val metadata = project_metadata(root.as_str())
    assert_eq(crate_fields(&metadata.json, "lint_options").as_str().ends_with(",too_many_parameters.max=5,"), true,
        "the rows kflatc gets as --lint-toml-option")
}

@test
fun a_crate_carries_its_lint_table(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "lints").as_str().ends_with(",dead_code=allow,"), true,
        "the rows kflatc gets as --lint")
}

@test
fun the_bundled_libraries_say_so(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "source").as_str().starts_with("bundled,"), true, "core comes with komp")
}

@test
fun a_path_dependency_is_a_path_source(): void {
    val metadata = project_metadata(lone_project().as_str())
    assert_eq(crate_fields(&metadata.json, "source").as_str().ends_with("path,path,"), true, "neither is fetched")
}

@test
fun a_shared_dependency_appears_once(): void {
    val metadata = project_metadata(workspace_project().as_str())
    assert_eq(crate_fields(&metadata.json, "name").as_str().ends_with("md_shared,md_one,md_two,"), true,
        "every crate once, dependencies first")
}

@test
fun a_member_answers_for_its_whole_workspace(): void {
    val metadata = project_metadata("${workspace_project()}/two".as_str())
    assert_eq(crate_fields(&metadata.json, "name").as_str().ends_with("md_one,md_two,"), true,
        "a language server sees every member from any file")
}

@test
fun a_workspace_names_its_root(): void {
    val ws = workspace_project()
    val metadata = project_metadata(ws.as_str())
    assert_eq(top_level_string(&metadata.json, "workspace_root").as_str().ends_with("/kf_md_ws"), true,
        "the directory holding [workspace]")
}

@test
fun an_unresolved_graph_is_an_error_in_json(): void {
    write_metadata_crate(scratch_path("kf_md_broken"), "md_broken", "bin", "gone = { path = \"../kf_md_nowhere\" }\n")
    val metadata = project_metadata(scratch_path("kf_md_broken"))
    assert_eq(metadata.ok, false, "a graph that does not resolve")
}

@test
fun an_unresolved_graph_says_why(): void {
    write_metadata_crate(scratch_path("kf_md_broken2"), "md_broken2", "bin", "gone = { path = \"../kf_md_nowhere\" }\n")
    val metadata = project_metadata(scratch_path("kf_md_broken2"))
    assert_eq(top_level_string(&metadata.json, "error").byte_len() > 0, true, "an error field a tool can show")
}
