// What a fetch hands back, and the steps every source shares: a staging
// directory beside the cache entry, and publishing it under its final name.

import alloc.list.*
import kf_tool.project.parse_manifest
import kf_shared.ensure_dir
import kf_shared.staging_path
import std.fs.exists
import std.fs.remove_dir_all
import std.fs.rename

/// `error` is "" when `entry` is usable.
pub struct Fetched {
    pub val entry: LockEntry
    pub val error: String
}

pub fun fetch_failed(message: String): Fetched {
    return Fetched { entry: empty_lock_entry(), error: message }
}

/// A row with every field "": no pin.
pub fun empty_lock_entry(): LockEntry {
    return LockEntry {
        name: "", version: "", index: "", git: "", tag: "", branch: "", rev: "", tarball: "", checksum: ""
    }
}

/// An empty directory private to this process under `<cache>/<kind>`.
pub fun fresh_staging(cache: str, kind: str): String {
    val parent = "${cache}/${kind}"
    if !ensure_dir(parent.as_str()) { return "" }
    val staged = staging_path("${parent}/fetch".as_str())
    remove_tree(staged.as_str())
    return staged
}

pub fun remove_tree(path: str): void {
    val _removed = remove_dir_all(path)
}

/// Moves `staged` to `root`. Losing a race to another komp is success: both
/// wrote the same bytes.
pub fun publish_fetched(staged: str, root: str): bool {
    if rename(staged, root).is_ok() { return true }
    remove_tree(staged)
    return exists(root)
}

/// The row for the crate published at `root`, named by its own manifest.
pub fun entry_at(root: str, git: &String, tag: &String, branch: &String, rev: String, tarball: &String,
                 checksum: String): Fetched {
    if !is_fetched(root) { return fetch_failed("the source has no kf.toml at its root") }
    val manifest = parse_manifest(read_file("${root}/kf.toml".as_str()).as_str())
    if manifest.error.byte_len() > 0 { return fetch_failed("its kf.toml is invalid: ${manifest.error}") }
    return Fetched {
        entry: LockEntry {
            name: manifest.name.clone(), version: manifest.version.clone(), index: "", git: git.clone(),
            tag: tag.clone(),
            branch: branch.clone(), rev: rev, tarball: tarball.clone(), checksum: checksum
        },
        error: ""
    }
}
