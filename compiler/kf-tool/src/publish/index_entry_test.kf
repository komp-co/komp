import core.assert.assert_eq
import kf_tool.fetch.index_file_description
import kf_tool.fetch.parse_index_file

@test
fun a_first_version_starts_the_file(): void {
    val text = entry_with_version("", "json", "", "0.1.0", "https://h/json", "abc")
    val expected = """schema = 1
name = "json"

[[version]]
version = "0.1.0"
source = { git = "https://h/json", rev = "abc" }
"""
    assert_eq(text.as_str(), expected, "schema and name, then the version")
}

@test
fun a_later_version_is_appended(): void {
    val first = entry_with_version("", "json", "", "0.1.0", "https://h/json", "abc")
    val second = entry_with_version(first.as_str(), "json", "", "0.2.0", "https://h/json", "def")
    assert_eq(parse_index_file_count(second.as_str()), 2, "published versions are never edited")
}

@test
fun a_file_without_a_final_newline_still_parses(): void {
    val text = entry_with_version("schema = 1\nname = \"json\"", "json", "", "0.1.0", "https://h/json", "abc")
    assert_eq(parse_index_file_count(text.as_str()), 1, "the block starts on its own line")
}

@test
fun a_first_version_carries_the_description(): void {
    val text = entry_with_version("", "json", "JSON for KFlat", "0.1.0", "https://h/json", "abc")
    assert_eq(index_file_description(text.as_str()).as_str(), "JSON for KFlat", "in the header")
}

@test
fun a_later_description_replaces_the_earlier(): void {
    val first = entry_with_version("", "json", "JSON", "0.1.0", "https://h/json", "abc")
    val second = entry_with_version(first.as_str(), "json", "JSON for KFlat", "0.2.0", "https://h/json", "def")
    assert_eq(index_file_description(second.as_str()).as_str(), "JSON for KFlat", "one description, the newest")
}

@test
fun a_description_goes_after_the_name_of_a_file_without_one(): void {
    val first = entry_with_version("", "json", "", "0.1.0", "https://h/json", "abc")
    val second = entry_with_version(first.as_str(), "json", "JSON", "0.2.0", "https://h/json", "def")
    assert_eq(second.as_str().starts_with("schema = 1\nname = \"json\"\ndescription = \"JSON\"\n"), true,
        "in the header")
}

@test
fun an_empty_description_keeps_the_files(): void {
    val first = entry_with_version("", "json", "JSON", "0.1.0", "https://h/json", "abc")
    val second = entry_with_version(first.as_str(), "json", "", "0.2.0", "https://h/json", "def")
    assert_eq(index_file_description(second.as_str()).as_str(), "JSON", "left as it was")
}

fun parse_index_file_count(text: str): uint64 {
    return parse_index_file(text).size()
}
