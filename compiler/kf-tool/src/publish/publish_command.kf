// `komp publish`: add this crate's tagged version to a package index by pull
// request. `komp publish --status`: what the index has of it, and what is
// waiting for review.

import alloc.list.*
import alloc.path.Path
import alloc.text_split.split
import kf_tool.build.check_project_with_kflatc
import kf_tool.fetch.*
import kf_tool.project.parse_manifest
import std.fs.create_dir_all
import std.fs.exists

pub fun publish_package(root: str, index_url: str, cache: str): int32 {
    val facts = release_facts(root)
    if facts.error.byte_len() > 0 { return publish_refused(facts.error.as_str()) }
    val release = "${facts.name} ${facts.version}"
    if check_project_with_kflatc(root, false) != 0 { return publish_refused("${release} has errors; fix them first") }
    println("checked  ${release}")

    var refreshed = List.new<String>()
    val checkout = index_checkout(index_url, cache, &var refreshed)
    if checkout.error.byte_len() > 0 { return publish_refused(checkout.error.as_str()) }
    val relative = index_file_path(facts.name.as_str())
    val file = "${checkout.dir}/${relative}"
    val existing = if exists(file.as_str()) { read_file(file.as_str()) } else { String.from("") }
    if parse_index_file(existing.as_str()).holds_version(facts.version.as_str()) {
        return publish_refused("${release} is already in ${index_url}")
    }

    val work = "${cache}/publish/${facts.name}-${facts.version}"
    val branch = "publish/${facts.name}-${facts.version}"
    remove_tree(work.as_str())
    if !tool("git", "clone --quiet ${checkout.dir} ${work}".as_str()).succeeds() {
        return publish_refused("cannot copy the index into ${work}")
    }
    val base = git_in(work.as_str(), "rev-parse --abbrev-ref HEAD") ?: String.from("main")
    val _origin = git_in(work.as_str(), "remote set-url origin ${index_url}".as_str())
    val _branch = git_in(work.as_str(), "checkout --quiet -b ${branch}".as_str())
    val target = "${work}/${relative}"
    create_dir_all(Path.new(target.as_str()).parent())
    val text = entry_with_version(existing.as_str(), facts.name.as_str(), facts.description.as_str(),
        facts.version.as_str(), facts.git.as_str(), facts.rev.as_str())
    write_file(target.as_str(), text.as_str())
    if !commit_entry(work.as_str(), relative.as_str(), release.as_str()) {
        return publish_refused("cannot commit the entry in ${work}")
    }
    println("entry    ${relative}: ${facts.version} at ${facts.rev.as_str().substring(0, 7)}")

    val body = "Adds ${release}: ${facts.git} at ${facts.rev}.\n\nOpened by `komp publish`."
    val opened = open_pull_request(work.as_str(), github_repository(index_url).as_str(), branch.as_str(), base.as_str(),
        release.as_str(), body.as_str())
    if opened.problem.byte_len() == 0 {
        println("opened   ${opened.url}")
        return 0
    }
    println("not opened: ${opened.problem}")
    println("The entry is committed on branch ${branch} in ${work}.")
    println("Fix the above and run `komp publish` again, or push that branch to a fork of")
    println("${index_url} and open a pull request from it.")
    return 1
}

fun publish_refused(reason: str): int32 {
    println("komp publish: ${reason}")
    return 1
}

/// Committed as the user when git knows who that is, else as komp.
fun commit_entry(work: str, relative: str, message: str): bool {
    if !tool("git", "-C ${work} add ${relative}".as_str()).succeeds() { return false }
    val email = git_in(work, "config user.email") ?: String.from("")
    val identity = if email.byte_len() > 0 {
        String.from("")
    } else {
        String.from("-c user.name=komp-publish -c user.email=komp-publish@users.noreply.github.com")
    }
    var commit = tool("git", "-C ${work} ${identity} commit --quiet -m".as_str())
    commit.arg(message)
    return commit.succeeds()
}

fun List<IndexVersion>.holds_version(version: str): bool {
    while entry in &self {
        if entry.version.as_str() == version { return true }
    }
    return false
}

pub fun publish_status(root: str, index_url: str, cache: str): int32 {
    val manifest = parse_manifest(read_file("${root}/kf.toml".as_str()).as_str())
    if manifest.error.byte_len() > 0 { return publish_refused("invalid kf.toml: ${manifest.error}".as_str()) }
    val name = manifest.name.clone()
    var refreshed = List.new<String>()
    val checkout = index_checkout(index_url, cache, &var refreshed)
    if checkout.error.byte_len() > 0 { return publish_refused(checkout.error.as_str()) }
    val file = "${checkout.dir}/${index_file_path(name.as_str())}"
    val existing = if exists(file.as_str()) { read_file(file.as_str()) } else { String.from("") }
    val published = parse_index_file(existing.as_str())
    while entry in &published {
        println("${name} ${entry.version}   ${if entry.yanked { "yanked" } else { "published" }}")
    }
    val repository = github_repository(index_url)
    val problem = gh_problem(repository.as_str())
    if problem.byte_len() > 0 {
        if published.size() == 0 { println("${name} has no version in ${index_url}") }
        println("(pull requests not shown: ${problem})")
        return 0
    }
    val fields = "title,state,reviewDecision,url"
    var list = tool("gh", "pr list --repo ${repository} --state all --json ${fields} --jq".as_str())
    list.arg(".[] | [.title, .state, .reviewDecision, .url] | join(\"\\t\")")
    val rows = output_of(list) ?: return publish_refused("`gh pr list` failed")
    var pending = 0
    val lines = rows.as_str().lines()
    while line in &lines {
        val fields = line.as_str().split("\t")
        if fields.size() == 4 && fields.at(0).as_str().starts_with("${name} ".as_str()) {
            val version = fields.at(0).as_str().substring(name.byte_len() + 1, fields.at(0).byte_len())
            val word = review_status(fields.at(1).as_str(), fields.at(2).as_str())
            if !published.holds_version(version.as_str()) && word.byte_len() > 0 {
                println("${fields.at(0)}   ${word}   ${fields.at(3)}")
                pending = pending + 1
            }
        }
    }
    if published.size() == 0 && pending == 0 { println("${name} has no version in ${index_url}") }
    return 0
}

/// A pull request's state and review decision as `--status` says them; ""
/// for a merged one, which the index itself reports.
pub fun review_status(state: str, decision: str): String {
    if state == "MERGED" { return "" }
    if state == "CLOSED" { return "declined" }
    if decision == "APPROVED" { return "approved, waiting to be merged" }
    if decision == "CHANGES_REQUESTED" { return "changes requested" }
    return "in review"
}
