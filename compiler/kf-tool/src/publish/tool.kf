// Running git and gh for `komp publish`, and reading what they print.

import alloc.list.*
import alloc.path.Path
import alloc.text_edit.trim
import alloc.text_split.split_whitespace
import std.fs.scratch_path
import std.process.Command
import std.fs.remove_file

/// `program` with `words` split on whitespace; an argument holding a space
/// is added with `arg` afterwards.
pub fun tool(program: str, words: str): Command {
    var command = Command.new(program)
    val split = words.split_whitespace()
    while word in &split { command.arg(word.as_str()) }
    return command
}

/// Exited 0. A program that is not installed does not.
pub fun Command.succeeds(): bool {
    return self.status().success()
}

/// Its standard output, trimmed, or None when it failed or could not run.
pub fun output_of(command: Command): String? {
    val file = scratch_path("komp_publish_tool_output")
    var running = command
    running.stdout_to(Path.new(file))
    val ok = running.status().success()
    val text = read_file(file)
    val _gone = remove_file(file)
    if !ok { return null }
    return text.trim()
}

/// `git -C dir <words>`'s output, as `output_of` reads it.
pub fun git_in(dir: str, words: str): String? {
    return output_of(tool("git", "-C ${dir} ${words}".as_str()))
}
