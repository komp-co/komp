// What a package release is, read from its manifest and its git checkout,
// and every reason it cannot be published yet.

import kf_tool.project.manifest_description
import kf_tool.project.parse_manifest
import kf_tool.project.parse_version
import kf_shared.normalized_path

/// `error` is "" when the rest is filled in.
pub struct ReleaseFacts {
    pub val name: String
    pub val version: String
    pub val git: String
    pub val rev: String
    /// kf.toml's `description`, or "".
    pub val description: String
    pub val error: String
}

fun refused(message: String): ReleaseFacts {
    return ReleaseFacts { name: "", version: "", git: "", rev: "", description: "", error: message }
}

/// The crate at `root`, released as the commit its `vX.Y.Z` tag names.
pub fun release_facts(root: str): ReleaseFacts {
    val manifest_text = read_file("${root}/kf.toml".as_str())
    val manifest = parse_manifest(manifest_text.as_str())
    if manifest.error.byte_len() > 0 { return refused("invalid kf.toml: ${manifest.error}") }
    val name = manifest.name.clone()
    if !is_package_name(name.as_str()) {
        return refused("`${name}` is not a package name: lowercase letters, digits and `_`, starting with a letter")
    }
    if parse_version(manifest.version.as_str()).is_none() {
        return refused("kf.toml's version `${manifest.version}` is not MAJOR.MINOR.PATCH")
    }
    val version = manifest.version.clone()
    val top = git_in(root, "rev-parse --show-toplevel") ?: return refused("${root} is not in a git repository")
    if normalized_path(top.as_str()).as_str() != normalized_path(root).as_str() {
        return refused("the crate must be at its repository's root, ${top}")
    }
    val changes = git_in(root, "status --porcelain --untracked-files=no") ?: return refused("`git status` failed")
    if changes.byte_len() > 0 { return refused("the working tree has uncommitted changes; commit them first") }
    val head = git_in(root, "rev-parse HEAD") ?: return refused("the repository has no commit")
    val tag = "v${version}"
    val push = "`git push origin ${tag}`"
    val tagged = git_in(root, "rev-parse --verify --quiet ${tag}^{commit}".as_str()) ?:
        return refused("no tag ${tag}: run `git tag ${tag}`, then ${push}")
    if tagged.as_str() != head.as_str() {
        return refused("${tag} names ${tagged.as_str().substring(0, 7)}, not the checked-out commit")
    }
    val remote = git_in(root, "remote get-url origin") ?: return refused("there is no `origin` remote to fetch it from")
    val listed = git_in(root, "ls-remote origin refs/tags/${tag} refs/tags/${tag}^{}".as_str()) ?:
        return refused("cannot reach `origin` (${remote})")
    if !listed.as_str().contains(head.as_str()) { return refused("${tag} is not on `origin`: run ${push}") }
    return ReleaseFacts {
        name: name, version: version, git: public_git_url(remote.as_str()), rev: head.clone(),
        description: manifest_description(manifest_text.as_str()), error: ""
    }
}

/// Lowercase `snake_case`: a crate name becomes a C identifier.
pub fun is_package_name(name: str): bool {
    val n = name.byte_len()
    if n == 0 || n > 64 { return false }
    val first = name.byte_at(0)
    if first < 97 || first > 122 { return false }
    var i: uint64 = 0
    while i < n {
        val b = name.byte_at(i)
        if !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { return false }
        i = i + 1
    }
    return true
}

/// The URL anyone can fetch: `git@host:o/r.git` and `ssh://git@host/o/r.git`
/// become `https://host/o/r.git`; anything else is kept.
pub fun public_git_url(url: str): String {
    if url.starts_with("git@") {
        val colon = url.index_of(":") ?: return String.from(url)
        return "https://${url.substring(4, colon)}/${url.substring(colon + 1, url.byte_len())}"
    }
    if url.starts_with("ssh://git@") { return "https://${url.substring(10, url.byte_len())}" }
    return String.from(url)
}
