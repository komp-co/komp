// `komp self update [<version>]`, `komp self list` and `komp self uninstall
// <version>`: the kflat releases installed under `~/.kflat/toolchains`.

import json.writer.JsonWriter
import kf_shared.kflat_version
import kf_tool.fetch.cache_root
import kf_tool.install.default_toolchain
import kf_tool.install.install_home
import kf_tool.install.installed_bin_dir
import kf_tool.install.installed_toolchains
import kf_tool.install.remove_toolchain
import kf_tool.install.self_update
import kf_tool.project.render

pub fun self_command(nargs: int32): int32 {
    val args = arguments_without_format(nargs)
    if args.is_empty() { return usage_error("self") }
    val home = install_home()
    when args[0].as_str() {
        "update" => {
            if args.size() > 2 { return usage_error("self") }
            val version = if args.size() == 2 { args[1].clone() } else { String.from("") }
            if starts_with_dash(version.as_str()) { return usage_error("self") }
            return update_self(home.as_str(), version.as_str())
        }
        "list" => {
            if args.size() != 1 { return usage_error("self") }
            return if wants_json(nargs) { list_toolchains_json(home.as_str()) } else { list_toolchains(home.as_str()) }
        }
        "uninstall" => {
            if args.size() != 2 || starts_with_dash(args[1].as_str()) { return usage_error("self") }
            val error = remove_toolchain(home.as_str(), args[1].as_str(), kflat_version())
            if error.byte_len() > 0 { return report_error(error.as_str(), wants_json(nargs)) }
            runtime_println("uninstalled kflat ${args[1]}")
            return 0
        }
        _ => return usage_error("self")
    }
}

/// `{"running", "default", "toolchains": [{"version", "path", "default", "running"}]}`,
/// `default` null when `bin/komp` points at no toolchain.
fun list_toolchains_json(home: str): int32 {
    val chosen = default_toolchain(home)
    var writer = JsonWriter.object()
    writer.field_string("running", kflat_version())
    if chosen.is_empty() { writer.field_null("default") } else { writer.field_string("default", chosen.as_str()) }
    writer.key("toolchains")
    writer.begin_array()
    val versions = installed_toolchains(home)
    while version in &versions {
        val shown = version.render()
        writer.begin_object()
        writer.field_string("version", shown.as_str())
        writer.field_string("path", "${home}/toolchains/${shown}".as_str())
        writer.field_bool("default", shown.as_str() == chosen.as_str())
        writer.field_bool("running", shown.as_str() == kflat_version())
        writer.end_object()
    }
    writer.end_array()
    runtime_println(writer.finish().as_str())
    return 0
}

fun update_self(home: str, version: str): int32 {
    val done = self_update(version, kflat_version(), home, cache_root().as_str())
    if done.error.byte_len() > 0 {
        runtime_println("error: ${done.error}")
        return 1
    }
    if !done.installed {
        runtime_println("komp ${done.version} is the newest release")
        return 0
    }
    runtime_println("installed komp ${done.version}; ${installed_bin_dir(home)}/komp now runs it")
    return 0
}

/// Each installed toolchain, the default and the running one marked.
fun list_toolchains(home: str): int32 {
    val versions = installed_toolchains(home)
    if versions.is_empty() {
        runtime_println("no toolchain is installed in ${home}/toolchains; this komp is ${kflat_version()}")
        return 0
    }
    val chosen = default_toolchain(home)
    while version in &versions {
        val shown = version.render()
        var notes = ""
        if shown.as_str() == chosen.as_str() { notes.append("  default") }
        if shown.as_str() == kflat_version() { notes.append("  running") }
        runtime_println("${shown}${notes}  ${home}/toolchains/${shown}")
    }
    return 0
}
