// `komp search [<query>]` and `komp info <name>`: what a package index
// offers, read from its checkout in the cache.

import alloc.list.*
import kf_shared.cli_arg_get
import kf_tool.fetch.IndexPackage
import kf_tool.fetch.cache_root
import kf_tool.fetch.index_package
import kf_tool.fetch.search_index
import kf_tool.project.default_index_url

/// The one positional argument and `--index <url>`; `ok` false on a
/// malformed line.
struct IndexArgs {
    val positional: String
    val index: String
    val ok: bool
}

fun index_args(nargs: int32): IndexArgs {
    var positional = ""
    var index = default_index_url()
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if arg == "--index" && i + 1 < nargs {
            index = String.from(cli_arg_get(i + 1))
            i = i + 1
        } else if starts_with_dash(arg) || positional.byte_len() > 0 {
            return IndexArgs { positional: "", index: "", ok: false }
        } else {
            positional = String.from(arg)
        }
        i = i + 1
    }
    return IndexArgs { positional: positional, index: index, ok: true }
}

/// Each package whose name contains the query, with its newest version.
pub fun search_command(nargs: int32): int32 {
    val args = index_args(nargs)
    if !args.ok { return usage_error("search") }
    val found = search_index(args.index.as_str(), args.positional.as_str(), cache_root().as_str())
    if found.error.byte_len() > 0 {
        runtime_println("error: ${found.error}")
        return 1
    }
    if found.packages.is_empty() {
        runtime_println("no package in ${args.index} matches `${args.positional}`")
        return 0
    }
    var width: uint64 = 0
    while package in &found.packages {
        if package.name.byte_len() > width { width = package.name.byte_len() }
    }
    while package in &found.packages {
        val newest = package.newest()
        val shown = if newest.is_empty() { String.from("(every version yanked)") } else { newest }
        runtime_println("${padded(package.name.as_str(), width)}  ${shown}")
    }
    return 0
}

/// Every version of one package, the newest and the yanked marked.
pub fun info_command(nargs: int32): int32 {
    val args = index_args(nargs)
    if !args.ok || args.positional.is_empty() { return usage_error("info") }
    val found = index_package(args.index.as_str(), args.positional.as_str(), cache_root().as_str())
    if found.error.byte_len() > 0 {
        runtime_println("error: ${found.error}")
        return 1
    }
    found.packages[0].print_versions(args.index.as_str())
    return 0
}

fun IndexPackage.print_versions(index: str): void {
    runtime_println("${self.name}, in ${index}")
    val newest = self.newest()
    while version in &self.versions {
        val is_newest = version.version.as_str() == newest.as_str()
        val note = if version.yanked { "  yanked" } else if is_newest { "  newest" } else { "" }
        runtime_println("  ${version.version}${note}")
    }
}

fun padded(text: str, width: uint64): String {
    var out = String.from(text)
    while out.byte_len() < width { out.append(" ") }
    return out
}
