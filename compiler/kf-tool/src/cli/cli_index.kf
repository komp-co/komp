// `komp search [<query>]` and `komp info <name>`: what a package index
// offers, read from its checkout in the cache.

import alloc.list.*
import json.writer.JsonWriter
import kf_shared.cli_arg_get
import kf_tool.fetch.IndexPackage
import kf_tool.fetch.cache_root
import kf_tool.fetch.index_package
import kf_tool.fetch.search_index
import kf_tool.project.default_index_url

/// The one positional argument and `--index <url>`; `ok` false on a
/// malformed line.
struct IndexArgs {
    val positional: String
    val index: String
    val ok: bool
}

fun index_args(nargs: int32): IndexArgs {
    var positional = ""
    var index = default_index_url()
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if is_format_flag(arg) {
            // read by wants_json
        } else if arg == "--index" && i + 1 < nargs {
            index = String.from(cli_arg_get(i + 1))
            i = i + 1
        } else if starts_with_dash(arg) || positional.byte_len() > 0 {
            return IndexArgs { positional: "", index: "", ok: false }
        } else {
            positional = String.from(arg)
        }
        i = i + 1
    }
    return IndexArgs { positional: positional, index: index, ok: true }
}

/// Each package whose name contains the query, with its newest version.
pub fun search_command(nargs: int32): int32 {
    val args = index_args(nargs)
    if !args.ok { return usage_error("search") }
    val found = search_index(args.index.as_str(), args.positional.as_str(), cache_root().as_str())
    if found.error.byte_len() > 0 { return report_error(found.error.as_str(), wants_json(nargs)) }
    if wants_json(nargs) {
        var writer = JsonWriter.object()
        writer.field_string("index", args.index.as_str())
        writer.key("packages")
        writer.begin_array()
        while package in &found.packages {
            writer.begin_object()
            writer.field_string("name", package.name.as_str())
            writer.write_optional("newest", package.newest().as_str())
            writer.write_optional("description", package.description.as_str())
            writer.end_object()
        }
        writer.end_array()
        runtime_println(writer.finish().as_str())
        return 0
    }
    if found.packages.is_empty() {
        runtime_println("no package in ${args.index} matches `${args.positional}`")
        return 0
    }
    var name_width: uint64 = 0
    var version_width: uint64 = 0
    while package in &found.packages {
        if package.name.byte_len() > name_width { name_width = package.name.byte_len() }
        if package.shown_version().byte_len() > version_width { version_width = package.shown_version().byte_len() }
    }
    while package in &found.packages {
        val version = padded(package.shown_version().as_str(), version_width)
        val line = "${padded(package.name.as_str(), name_width)}  ${version}"
        val described = if package.description.is_empty() { line } else { "${line}  ${package.description}" }
        runtime_println(described.as_str().trim_end())
    }
    return 0
}

/// Every version of one package, the newest and the yanked marked.
pub fun info_command(nargs: int32): int32 {
    val args = index_args(nargs)
    if !args.ok || args.positional.is_empty() { return usage_error("info") }
    val found = index_package(args.index.as_str(), args.positional.as_str(), cache_root().as_str())
    if found.error.byte_len() > 0 { return report_error(found.error.as_str(), wants_json(nargs)) }
    if wants_json(nargs) {
        runtime_println(found.packages[0].versions_json(args.index.as_str()).as_str())
        return 0
    }
    found.packages[0].print_versions(args.index.as_str())
    return 0
}

fun IndexPackage.print_versions(index: str): void {
    runtime_println("${self.name}, in ${index}")
    if !self.description.is_empty() { runtime_println(self.description.as_str()) }
    val newest = self.newest()
    while version in &self.versions {
        val is_newest = version.version.as_str() == newest.as_str()
        val note = if version.yanked { "  yanked" } else if is_newest { "  newest" } else { "" }
        runtime_println("  ${version.version}${note}")
    }
}

fun IndexPackage.shown_version(): String {
    val newest = self.newest()
    return if newest.is_empty() { String.from("(every version yanked)") } else { newest }
}

/// `{"index", "name", "description", "newest", "versions": [{"version", "yanked"}]}`.
fun IndexPackage.versions_json(index: str): String {
    var writer = JsonWriter.object()
    writer.field_string("index", index)
    writer.field_string("name", self.name.as_str())
    writer.write_optional("description", self.description.as_str())
    writer.write_optional("newest", self.newest().as_str())
    writer.key("versions")
    writer.begin_array()
    while version in &self.versions {
        writer.begin_object()
        writer.field_string("version", version.version.as_str())
        writer.field_bool("yanked", version.yanked)
        writer.end_object()
    }
    writer.end_array()
    return writer.finish()
}

/// `name: value`, or `name: null` for "".
mutating fun JsonWriter.write_optional(name: str, value: str): void {
    if value.is_empty() { self.field_null(name) } else { self.field_string(name, value) }
}

fun padded(text: str, width: uint64): String {
    var out = String.from(text)
    while out.byte_len() < width { out.append(" ") }
    return out
}
