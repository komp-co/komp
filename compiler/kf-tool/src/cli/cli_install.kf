// `komp install [<name>[@<requirement>]] [--index <url>]`,
// `komp uninstall <name>`, `komp update --installed [<name>...]`,
// `komp self update`, and `komp <command>` running an installed
// `komp-<command>`.

import alloc.list.*
import kf_tool.build.beside_self
import kf_tool.fetch.cache_root
import kf_tool.install.install_home
import json.writer.JsonWriter
import kf_tool.install.install_package
import kf_tool.install.installed_tools
import kf_tool.install.named
import kf_tool.install.pinned_tool
import kf_tool.install.project_tool_pin
import kf_tool.install.stored_packages
import kf_tool.install.stored_versions
import kf_tool.project.render
import kf_tool.install.installed_bin_dir
import kf_tool.install.installed_binary_name
import kf_tool.install.installed_packages
import kf_tool.install.uninstall_package
import kf_tool.install.update_installed
import kf_tool.project.default_index_url
import kf_shared.cli_arg_get
import kf_shared.kflat_version
import std.env.env_var
import std.fs.exists
import std.process.Command

/// With no package, lists what is installed.
pub fun install_command(nargs: int32): int32 {
    var package = ""
    var index = ""
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if is_format_flag(arg) {
            // read by wants_json
        } else if arg == "--index" {
            if i + 1 >= nargs { return usage_error("install") }
            index = String.from(cli_arg_get(i + 1))
            i = i + 1
        } else if starts_with_dash(arg) || package.byte_len() > 0 {
            return usage_error("install")
        } else {
            package = String.from(arg)
        }
        i = i + 1
    }
    val home = install_home()
    if package.byte_len() == 0 {
        if wants_json(nargs) { return list_installed_json(home.as_str()) }
        return list_installed(home.as_str())
    }
    val at = package.index_of("@")
    val name = when (at) {
        Some(split) => package.substring(0, split)
        None => package.clone()
    }
    val requirement = when (at) {
        Some(split) => package.substring(split + 1, package.byte_len())
        None => String.from("")
    }
    val url = if index.byte_len() > 0 { index } else { default_index_url() }
    val done = install_package(name.as_str(), requirement.as_str(), url.as_str(), cache_root().as_str(), home.as_str())
    if done.error.byte_len() > 0 {
        runtime_println("error: ${done.error}")
        return 1
    }
    runtime_println("installed `${name}` ${done.entry.version} as ${done.binary}")
    val bin = installed_bin_dir(home.as_str())
    if !on_path(bin.as_str()) { runtime_println("note: ${bin} is not on PATH; komp runs what is there all the same") }
    return 0
}

pub fun uninstall_command(nargs: int32): int32 {
    if nargs != 2 || starts_with_dash(cli_arg_get(1)) { return usage_error("uninstall") }
    val package = String.from(cli_arg_get(1))
    val at = package.index_of("@")
    val name = if at == null { package.clone() } else { package.substring(0, at ?: 0) }
    val version = if at == null { String.from("") } else { package.substring((at ?: 0) + 1, package.byte_len()) }
    val error = uninstall_package(name.as_str(), version.as_str(), install_home().as_str())
    if error.byte_len() > 0 {
        runtime_println("error: ${error}")
        return 1
    }
    runtime_println(if version.is_empty() { "uninstalled `${name}`" } else { "uninstalled `${name}` ${version}" })
    return 0
}

/// `komp update --installed [<name>...]`: 1 when any program could not be
/// updated.
pub fun update_installed_command(nargs: int32): int32 {
    var names = List.new<String>()
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if arg != "--installed" {
            if starts_with_dash(arg) { return usage_error("update") }
            names.push(String.from(arg))
        }
        i = i + 1
    }
    val home = install_home()
    val updates = update_installed(&names, cache_root().as_str(), home.as_str())
    if updates.is_empty() { runtime_println("nothing is installed") }
    var failed = false
    while update in &updates {
        if update.error.byte_len() > 0 {
            runtime_println("error: `${update.name}` ${update.error}")
            failed = true
        } else if update.from.as_str() == update.to.as_str() {
            runtime_println("`${update.name}` ${update.from} is the newest its requirement allows")
        } else {
            runtime_println("updated `${update.name}` ${update.from} -> ${update.to}")
        }
    }
    return if failed { 1 } else { 0 }
}

/// What `komp <command>` runs: `path` "" when no program answers to it, or
/// `error` when a pin cannot be met.
pub struct ToolCommand {
    pub val path: String
    pub val error: String
}

/// The package whose program `komp <command>` runs: `komp_` and the command,
/// `-` read as `_`.
pub fun tool_package(command: str): String {
    return "komp_${command.replace("-", "_")}"
}

/// The `komp-<command>` that `komp <command>` runs: the version the current
/// project's `[tools]` pins, installed on first use, else the default.
pub fun installed_command(command: str): ToolCommand {
    val none = ToolCommand { path: "", error: "" }
    if command.byte_len() == 0 || starts_with_dash(command) || command.contains("/") { return none }
    val home = install_home()
    val package = tool_package(command)
    val pinned = project_tool_pin(".", package.as_str())
    if pinned != null {
        val pin = pinned ?: return none
        val chosen = pinned_tool(&pin, package.as_str(), cache_root().as_str(), home.as_str())
        return ToolCommand { path: chosen.binary.clone(), error: chosen.error.clone() }
    }
    val path = "${installed_bin_dir(home.as_str())}/komp-${command}"
    return if exists(path.as_str()) { ToolCommand { path: path, error: "" } } else { none }
}

/// `komp <command>` run as a program's: its exit status, or null when no
/// program answers to `command`.
pub fun run_tool_command(command: str, nargs: int32): int32? {
    val tool = installed_command(command)
    if tool.error.byte_len() > 0 {
        runtime_println("error: ${tool.error}")
        return Option.Some(1)
    }
    if tool.path.is_empty() { return null }
    return Option.Some(run_installed(tool.path.as_str(), nargs))
}

/// Replaces komp with `path`, given every argument after the command, so
/// the program owns komp's process, stdio and signals. `KOMP_BIN` names this
/// komp unless it is already set, so a program that asks komp about the
/// project asks the one that started it. Comes back only when `path` could
/// not be started.
pub fun run_installed(path: str, nargs: int32): int32 {
    var command = Command.new(path)
    while i in 1..nargs { command.arg(cli_arg_get(i)) }
    if env_var("KOMP_BIN") == null { command.env("KOMP_BIN", beside_self("komp").as_str()) }
    val failed = command.exec()
    runtime_println("error: cannot run ${path}: ${failed.message}")
    return 127
}

/// Each default, and every version in the store beside it.
fun list_installed(home: str): int32 {
    val rows = installed_packages(home)
    val stored = stored_packages(home)
    if rows.is_empty() && stored.is_empty() {
        runtime_println("nothing is installed")
        return 0
    }
    val bin = installed_bin_dir(home)
    while row in &rows {
        val others = other_versions(home, row.name.as_str(), row.version.as_str())
        val binary = "${bin}/${installed_binary_name(row.name.as_str())}"
        val also = if others.is_empty() { String.from("") } else { "; also ${others}" }
        runtime_println("${row.name} ${row.version}  ${binary}${also}")
    }
    while package in &stored {
        var has_default = false
        while row in &rows {
            if row.name.as_str() == package.as_str() { has_default = true }
        }
        if !has_default {
            runtime_println("${package}  ${other_versions(home, package.as_str(), "")}, for the projects that pin it")
        }
    }
    return 0
}

/// `{"programs": [{"name", "default", "binary", "requirement", "versions"}]}`,
/// `default`, `binary` and `requirement` null for a program only stored.
fun list_installed_json(home: str): int32 {
    val tools = installed_tools(home)
    var names = stored_packages(home)
    while tool in &tools {
        if !names.contains(&tool.entry.name) { names.push(tool.entry.name.clone()) }
    }
    names.sort()
    var writer = JsonWriter.object()
    writer.key("programs")
    writer.begin_array()
    while name in &names {
        writer.begin_object()
        writer.field_string("name", name.as_str())
        val chosen = tools.named(name.as_str())
        when (chosen) {
            Some(tool) => {
                writer.field_string("default", tool.entry.version.as_str())
                val binary = "${installed_bin_dir(home)}/${installed_binary_name(name.as_str())}"
                writer.field_string("binary", binary.as_str())
                writer.field_string("requirement", tool.requirement.as_str())
            }
            None => {
                writer.field_null("default")
                writer.field_null("binary")
                writer.field_null("requirement")
            }
        }
        writer.key("versions")
        writer.begin_array()
        val versions = stored_versions(home, name.as_str())
        while version in &versions { writer.write_string(version.render().as_str()) }
        writer.end_array()
        writer.end_object()
    }
    writer.end_array()
    runtime_println(writer.finish().as_str())
    return 0
}

/// "0.1.4, 0.1.5": the stored versions other than `except`.
fun other_versions(home: str, package: str, except: str): String {
    var out = ""
    val versions = stored_versions(home, package)
    while version in &versions {
        val shown = version.render()
        if shown.as_str() == except { continue }
        if out.byte_len() > 0 { out.append(", ") }
        out.append(shown.as_str())
    }
    return out
}

fun on_path(dir: str): bool {
    val path = env_var("PATH") ?: String.from("")
    var start: uint64 = 0
    while i in 0..(path.byte_len() + 1) {
        if i == path.byte_len() || path.byte_at(i) == 58 {
            if path.substring(start, i).as_str() == dir { return true }
            start = i + 1
        }
    }
    return false
}
