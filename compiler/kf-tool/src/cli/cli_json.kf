// `--format=json`: the listing commands' output as one JSON object on one
// line, for editors and scripts, and an error as `{"error": "..."}`.

import alloc.list.*
import json.writer.JsonWriter
import kf_shared.cli_arg_get

pub fun wants_json(nargs: int32): bool {
    return has_own_flag(nargs, "--format=json")
}

pub fun is_format_flag(arg: str): bool {
    return arg == "--format=json"
}

/// The arguments after the command, `--format=json` left out.
pub fun arguments_without_format(nargs: int32): List<String> {
    var out = List.new<String>()
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if !is_format_flag(arg) { out.push(String.from(arg)) }
        i = i + 1
    }
    return out
}

/// Prints `message` as text, or as `{"error": message}` for `json`; 1.
pub fun report_error(message: str, json: bool): int32 {
    if !json {
        runtime_println("error: ${message}")
        return 1
    }
    var writer = JsonWriter.object()
    writer.field_string("error", message)
    runtime_println(writer.finish().as_str())
    return 1
}
