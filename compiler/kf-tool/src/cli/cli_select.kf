// Running a command on the selected crates. A directory is a crate or a
// workspace; `--package <name>` picks one member, `--workspace` all, and
// neither means the default member.

import kf_tool.build.*
import kf_tool.project.command_dir
import kf_tool.project.select_crate_roots
import kf_tool.testing.test_project_separate
import kf_shared.cli_arg_get

/// Before `--`, or "".
fun own_flag_value(nargs: int32, name: str): str {
    var i = 1
    while i + 1 < nargs {
        val arg = cli_arg_get(i)
        if arg == "--" { return "" }
        if arg == name { return cli_arg_get(i + 1) }
        i = i + 1
    }
    return ""
}

fun has_own_flag(nargs: int32, name: str): bool {
    var i = 1
    while i < nargs {
        val arg = cli_arg_get(i)
        if arg == "--" { return false }
        if arg == name { return true }
        i = i + 1
    }
    return false
}

pub fun package_flag(nargs: int32): str {
    val short = own_flag_value(nargs, "-p")
    if short != "" { return short }
    return own_flag_value(nargs, "--package")
}

pub fun is_selection_value_flag(arg: str): bool {
    return arg == "-p" || arg == "--package"
}

pub fun wants_workspace(nargs: int32): bool {
    return has_own_flag(nargs, "--workspace")
}

/// "" once the reason has been printed.
pub fun single_selected_crate(command: str, project: str, nargs: int32): String {
    if wants_workspace(nargs) {
        runtime_println("error: `komp ${command}` works on one crate; pass `--package <name>` instead of `--workspace`")
        return ""
    }
    val roots = select_crate_roots(command_dir(project).as_str(), package_flag(nargs), false)
    if roots.size() == 0 { return "" }
    return *roots.at(0)
}

/// A failing crate does not stop the rest. `flag` is the command's one
/// boolean option.
pub fun run_on_selected(command: str, project: str, nargs: int32, flag: bool): int32 {
    val roots = select_crate_roots(command_dir(project).as_str(), package_flag(nargs), wants_workspace(nargs))
    if roots.size() == 0 { return 1 }
    var rc = 0
    while root in &roots {
        if roots.size() > 1 { runtime_println("==> komp ${command} ${root.as_str()}") }
        val one = run_on_crate(command, root.as_str(), nargs, flag)
        if one != 0 { rc = one }
    }
    return rc
}

fun run_on_crate(command: str, root: str, nargs: int32, flag: bool): int32 {
    if !fetched_for(root, nargs) { return 1 }
    when command {
        "check" => return check_crate(root, flag)
        "lint" => return lint_crate(root, flag)
        "fix" => return run_fix(root, flag)
        "build" => return build_project_separate_verbose(root, "", flag)
        _ => { }
    }
    if flag { return test_project(root) }
    return test_project_separate(root, own_flag_value(nargs, "--case"), own_flag_value(nargs, "--filter"))
}

/// As `check_crate`, with a tally of what was found after the diagnostics.
fun lint_crate(root: str, as_json: bool): int32 {
    return if lint_project_with_kflatc(root, as_json) != 0 { 1 } else { 0 }
}

fun check_crate(root: str, as_json: bool): int32 {
    val failed = check_project_with_kflatc(root, as_json) != 0
    if as_json { return if failed { 1 } else { 0 } }
    println(if failed { "check: found errors" } else { "check: OK" })
    return if failed { 1 } else { 0 }
}
