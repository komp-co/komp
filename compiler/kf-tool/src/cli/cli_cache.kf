// `komp cache list | remove <name>[@<version>] | clean | verify`: the
// downloads komp keeps in `$KFLAT_CACHE`, else `~/.cache/kflat`.

import alloc.list.*
import json.writer.JsonWriter
import kf_tool.fetch.CachedSource
import kf_tool.fetch.cache_root
import kf_tool.fetch.cached_indexes
import kf_tool.fetch.cached_sources
import kf_tool.fetch.clean_cache
import kf_tool.fetch.remove_cached
import kf_tool.fetch.verify_cache

pub fun cache_command(nargs: int32): int32 {
    val args = arguments_without_format(nargs)
    val json = wants_json(nargs)
    if args.is_empty() { return usage_error("cache") }
    val cache = cache_root()
    when args[0].as_str() {
        "list" => {
            if args.size() != 1 { return usage_error("cache") }
            return if json { list_cache_json(cache.as_str()) } else { list_cache(cache.as_str()) }
        }
        "remove" => {
            if args.size() != 2 || starts_with_dash(args[1].as_str()) { return usage_error("cache") }
            return remove_from_cache(cache.as_str(), args[1].as_str())
        }
        "clean" => {
            if args.size() != 1 { return usage_error("cache") }
            clean_cache(cache.as_str())
            runtime_println("emptied ${cache}; the bootstrap seeds stay")
            return 0
        }
        "verify" => {
            if args.size() != 1 { return usage_error("cache") }
            return verify_cache_command(cache.as_str(), json)
        }
        _ => return usage_error("cache")
    }
}

/// `{"cache", "sources": [{"name", "version", "kind", "key", "root"}], "indexes": [...]}`.
fun list_cache_json(cache: str): int32 {
    var writer = JsonWriter.object()
    writer.field_string("cache", cache)
    writer.key("sources")
    writer.begin_array()
    val sources = cached_sources(cache)
    while source in &sources {
        writer.begin_object()
        writer.write_source_fields(source)
        writer.field_string("root", source.root.as_str())
        writer.end_object()
    }
    writer.end_array()
    writer.key("indexes")
    writer.begin_array()
    val indexes = cached_indexes(cache)
    while index in &indexes { writer.write_string(index.as_str()) }
    writer.end_array()
    runtime_println(writer.finish().as_str())
    return 0
}

mutating fun JsonWriter.write_source_fields(source: &CachedSource): void {
    self.field_string("name", source.name.as_str())
    self.field_string("version", source.version.as_str())
    self.field_string("kind", source.kind.as_str())
    self.field_string("key", source.key.as_str())
}

fun list_cache(cache: str): int32 {
    val sources = cached_sources(cache)
    val indexes = cached_indexes(cache)
    if sources.is_empty() && indexes.is_empty() {
        runtime_println("${cache} holds nothing")
        return 0
    }
    while source in &sources { runtime_println(source.line().as_str()) }
    while index in &indexes { runtime_println("index  ${index}") }
    return 0
}

fun remove_from_cache(cache: str, package: str): int32 {
    val at = package.index_of("@")
    val name = if at == null { String.from(package) } else { package.substring(0, at ?: 0) }
    val version = if at == null { String.from("") } else { package.substring((at ?: 0) + 1, package.byte_len()) }
    val removed = remove_cached(cache, name.as_str(), version.as_str())
    if removed.is_empty() {
        runtime_println("error: the cache holds no `${package}`")
        return 1
    }
    while source in &removed { runtime_println("removed ${source.line()}") }
    return 0
}

/// 1 when a source was damaged: removed, it is fetched again by the next
/// command that needs it. As JSON, `{"checked", "damaged", "sources": [{...,
/// "state"}]}` with each state "ok", "damaged" or "recorded".
fun verify_cache_command(cache: str, json: bool): int32 {
    val verified = verify_cache(cache)
    var damaged = 0
    var writer = JsonWriter.object()
    writer.key("sources")
    writer.begin_array()
    while one in &verified {
        if one.state.as_str() == "damaged" { damaged = damaged + 1 }
        if json {
            writer.begin_object()
            writer.write_source_fields(&one.source)
            writer.field_string("state", one.state.as_str())
            writer.end_object()
            continue
        }
        val what = "${one.source.name} ${one.source.version} (${one.source.kind} ${one.source.short_key()})"
        when one.state.as_str() {
            "damaged" => runtime_println("damaged  ${what}: removed; the next build fetches it again")
            "recorded" => runtime_println("recorded ${what}: fetched before digests were kept; its digest is now")
            _ => runtime_println("ok       ${what}")
        }
    }
    writer.end_array()
    if json {
        writer.field_uint64("checked", verified.size())
        writer.field_int64("damaged", damaged as int64)
        runtime_println(writer.finish().as_str())
    } else {
        runtime_println("${verified.size()} checked, ${damaged} damaged")
    }
    return if damaged > 0 { 1 } else { 0 }
}

fun CachedSource.short_key(): String {
    return if self.key.byte_len() > 12 { self.key.substring(0, 12) } else { self.key.clone() }
}

fun CachedSource.line(): String {
    return "${self.name} ${self.version}  ${self.kind} ${self.short_key()}  ${self.root}"
}
