import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_mono.collect.ret_op

fun defaults_test_type(name: str): Ptr<TypeRef> {
    val out: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *out = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>())) }
    return out
}

fun defaults_test_method(name: str, with_body: bool): TopDecl {
    var body = List.new<Stmt>()
    if with_body {
        val value: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *value = Expr.new(no_span(), ExprKind.LitInt(42)) }
        body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(value))))
    }
    return new_top_decl(no_span(), String.from(name), TopDeclKind.Function(List.new<Param>(), defaults_test_type("int32"), body, true, false, false, false))
}

fun defaults_test_module(explicit_default: bool): Module {
    var trait_methods = List.new<TopDecl>()
    trait_methods.push(defaults_test_method("answer", true))
    val trait_decl = new_top_decl(no_span(), String.from("Answer"), TopDeclKind.TraitDecl(trait_methods, true, List.new<TypeRef>()))

    var impl_methods = List.new<TopDecl>()
    if explicit_default { impl_methods.push(defaults_test_method("answer", true)) }
    val trait_ref: Ptr<TypeRef> = defaults_test_type("Answer")
    val trait_impl = new_top_decl(no_span(), String.from("Value"), TopDeclKind.TraitImpl(trait_ref, impl_methods))

    var declarations = List.new<TopDecl>()
    declarations.push(trait_decl)
    declarations.push(trait_impl)
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
}

fun Module.defaults_test_method_count(): uint64 {
    while declaration in &self.decls {
        when (declaration.kind) {
            ImplBlock(methods) => return methods.size()
            _ => { }
        }
    }
    return 0
}

@test fun mono_materializes_an_omitted_trait_default(): void {
    var module = defaults_test_module(false)
    module.normalize_trait_impls()
    assert_eq(module.defaults_test_method_count(), 1, "an omitted default becomes a concrete impl method")
}

@test fun mono_does_not_duplicate_an_explicit_override(): void {
    var module = defaults_test_module(true)
    module.normalize_trait_impls()
    assert_eq(module.defaults_test_method_count(), 1, "an explicit method replaces its trait default")
}

fun self_call_stmt(target: str): Stmt {
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("self"))) }
    val call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_ptr = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern(target), List.new<Expr>())) }
    return Stmt.new(no_span(), StmtKind.Return(ret_op(call_ptr)))
}

fun defaults_test_method_calling(name: str, target: str): TopDecl {
    var body = List.new<Stmt>()
    body.push(self_call_stmt(target))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.Function(List.new<Param>(), defaults_test_type("int32"), body, true, false, false, false))
}

/// The `mangled_callee` on a named impl method's first `return self.x()`, or "".
fun Module.sibling_call_mangled_callee(impl_method_name: str): String {
    while declaration in &self.decls {
        when (declaration.kind) {
            ImplBlock(methods) => {
                while j in 0..methods.size() {
                    val m = *methods.at(j)
                    if m.name.as_str().equals(impl_method_name) {
                        when (m.kind) {
                            Function(_p, _r, body, _pub, _u, _mut, _s) => {
                                val s0 = body.at(0)
                                when (s0.kind) {
                                    Return(expr_ptr) => {
                                        val p = expr_ptr ?: return String.from("")
                                        return unsafe { (*p).mangled_callee.as_string() }
                                    }
                                    _ => { }
                                }
                            }
                            _ => { }
                        }
                    }
                }
            }
            _ => { }
        }
    }
    return String.from("")
}

// Default bodies are never typechecked; Mono must still give their
// `self.name()` calls a trait-suffixed callee.
@test fun mono_default_body_self_call_gets_trait_suffix(): void {
    var trait_methods = List.new<TopDecl>()
    trait_methods.push(defaults_test_method("name", false))
    trait_methods.push(defaults_test_method_calling("greeting", "name"))
    val trait_decl = new_top_decl(no_span(), String.from("Answer"), TopDeclKind.TraitDecl(trait_methods, true, List.new<TypeRef>()))

    var impl_methods = List.new<TopDecl>()
    impl_methods.push(defaults_test_method("name", true))
    val trait_ref: Ptr<TypeRef> = defaults_test_type("Answer")
    val trait_impl = new_top_decl(no_span(), String.from("Value"), TopDeclKind.TraitImpl(trait_ref, impl_methods))

    var declarations = List.new<TopDecl>()
    declarations.push(trait_decl)
    declarations.push(trait_impl)
    var module = Module { crate: crate_id_poison(), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }

    module.normalize_trait_impls()

    val mangled = module.sibling_call_mangled_callee("greeting__Answer")
    assert_eq(mangled.as_str(), "Value_name__Answer", "a default body's self-call to a sibling trait method carries the trait suffix")
}
