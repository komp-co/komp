// An impl is emitted only for instances that satisfy its bounds:
// `impl Equal for Option<T: Equal>` must not be cloned for `Option<Never>`,
// whose `equals` would call a function nothing defines. Struct and enum
// layouts are not gated; typecheck already rejected unsatisfying instances.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.fn_frag_parts
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TypeParam
import kf_typecheck.*
import kf_typecheck.types.trait_args_key
import kf_typecheck.traits.type_param_key
import kf_core.ast.subst.clone_type_ref
import kf_core.ast.subst.subst_tref_list

/// Register every `impl Trait for Type` so `type_implements` can answer.
/// CONSTRAINT: runs before `normalize_trait_impls`, while the `TraitImpl`
/// shape still exists.
pub fun Module.trait_impl_registry(sigs: Ptr<SigTable>): void {
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                val tr = unsafe { *tref }
                when (tr.kind) {
                    Named(trait_sym, trait_args) => {
                        unsafe { sigs.insert_trait_impl(TraitImplInfo {
                            type_name: td.name.as_string(),
                            receiver_identity: td.name,
                            trait_name: trait_sym.as_string(),
                            trait_args: trait_args_key(&trait_args),
                            generics: type_param_key(&td.generics),
                            arg_count: trait_args.size()
                        }) }
                    }
                    _ => { }
                }
            }
            _ => { }
        }
    }
}

/// True for anything that is not an impl, and for an impl whose target
/// parameters carry no bounds.
pub fun TopDecl.template_accepts_args(args: &List<TypeRef>, sigs: Ptr<SigTable>, copy_name: Sym): bool {
    var is_impl = false
    when (self.kind) {
        ImplBlock(_ms) => { is_impl = true }
        TraitImpl(_t, _ms) => { is_impl = true }
        _ => { }
    }
    if !is_impl { return true }
    // Bounds are read at the instance's types:
    // `impl Iterable<T> for Wrap<I: Sink<T>, T>` at `<Counter, uint64>` asks
    // whether `Counter` implements `Sink<uint64>`, not `Sink<T>`.
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    while g in 0..self.generics.size() {
        if g < args.size() {
            names.push(self.generics.at(g).name.as_string())
            repls.push(clone_type_ref(args.at(g)))
        }
    }
    while i in 0..self.generics.size() {
        val tp = self.generics.at(i)
        if i < args.size() {
            if !(args.at(i)).arg_meets_bounds(tp, sigs, copy_name, &var names, &var repls) { return false }
        }
    }
    return true
}

fun TypeRef.arg_meets_bounds(
    tp: &TypeParam,
    sigs: Ptr<SigTable>,
    copy_name: Sym,
    names: &var List<String>,
    repls: &var List<TypeRef>
): bool {
    if tp.bounds.size() == 0 { return true }

    // No `impl Trait for` a borrow, function type or array can be written, so
    // the answer is a decided no, except that a shared borrow and a function
    // type are `Copy`.
    when (self.kind) {
        Reference(mutable, _pointee) => return !mutable && tp.bounded_by_copy_alone(copy_name)
        Function(_params, _ret) => return tp.bounded_by_copy_alone(copy_name)
        Array(_elem, _n) => { return false }
        _ => { }
    }

    val base = self.tyref_base_name()
    if fn_frag_parts(base.as_str()) != null { return tp.bounded_by_copy_alone(copy_name) }
    // A projection or poison is undecidable here; typecheck judges it.
    if base.as_str().equals("") { return true }
    while b in &tp.bounds {
        when (b.kind) {
            Named(trait_sym, targs) => {
                // Substitute the bound's own arguments first: for
                // `Rev<I: Iterator<T>, T>` the registry holds `Iterator<int32>`,
                // never `Iterator<T>`.
                val bound_args = subst_tref_list(&targs, names, repls)
                val ok = unsafe { sigs.type_implements(base.as_str(), trait_sym.as_str(), trait_args_key(&bound_args).as_str()) }
                if !ok { return false }
            }
            _ => { }
        }
    }
    return true
}

/// As typecheck's `type_is_copy` judges a shared borrow.
fun TypeParam.bounded_by_copy_alone(copy_name: Sym): bool {
    if copy_name.as_str().byte_len() == 0 { return false }
    while b in &self.bounds {
        when (b.kind) {
            Named(trait_sym, _targs) => {
                if trait_sym.as_str() != copy_name.as_str() { return false }
            }
            _ => return false
        }
    }
    return true
}

fun TypeRef.tyref_base_name(): String {
    return when (self.kind) {
        Named(n, _args) => n.as_string()
        _ => ""
    }
}
