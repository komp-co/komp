import alloc.list.*

import kf_core.span.*
import kf_core.ast.CrateId
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import kf_core.ast.subst.*

pub fun new_owned_top_decl(owner: CrateId, span: Span, name: str, kind: TopDeclKind): TopDecl {
    var decl = new_top_decl(span, String.from(name), kind)
    decl.crate = owner
    return decl
}

fun TopDecl.attach_subst_dyn_metadata(target: TopDecl, names: &var List<String>, repls: &var List<TypeRef>): TopDecl {
    var result = target
    result.dyn_layouts = subst_dyn_layouts(&self.dyn_layouts, names, repls)
    result.dyn_vtables = subst_dyn_vtables(&self.dyn_vtables, names, repls)
    return result
}

pub fun clone_subst_decl(tmpl: &TopDecl, args: &List<TypeRef>, mangled: String): TopDecl {
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    while k in 0..tmpl.generics.size() {
        val tp = *tmpl.generics.at(k)
        names.push(tp.name.as_string())
        if k < args.size() {
            repls.push(*args.at(k))
        }
    }
    when (tmpl.kind) {
        Struct(fields, is_pub) => {
            var nf = List.new<Field>()
            while f in &fields {
                val nty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *nty = subst_type_ref(&*f.ty, &var names, &var repls) }
                nf.push(new_field(f.span, f.name.as_string(), nty, f.is_var, f.is_pub))
            }
            val result = new_owned_top_decl(tmpl.crate, tmpl.span, mangled.as_str(), TopDeclKind.Struct(nf, is_pub))
            val attached = tmpl.attach_subst_dyn_metadata(tmpl.carry_view(result), &var names, &var repls)
            return attached
        }
        EnumDecl(variants, is_pub) => {
            var nv = List.new<Variant>()
            while v in &variants {
                var npay = List.new<TypeRef>()
                while item in &v.payloads {
                    val sub = subst_type_ref(item, &var names, &var repls)
                    // A payload that substituted to `void` keeps its slot:
                    // `void` has a storage type (`kf_unit`).
                    npay.push(sub)
                }
                nv.push(new_variant(v.span, v.name.as_string(), npay))
            }
            val result = new_owned_top_decl(tmpl.crate, tmpl.span, mangled.as_str(), TopDeclKind.EnumDecl(nv, is_pub))
            val attached = tmpl.attach_subst_dyn_metadata(tmpl.carry_view(result), &var names, &var repls)
            return attached
        }
        Function(_params, _ret_ptr, _body, _pub, _u, _m, _s) => {
            var fn = clone_subst_method(tmpl, &var names, &var repls)
            fn.name = intern(mangled.as_str())
            return fn
        }
        ImplBlock(methods) => {
            // Methods keep their own names; mono_top_decl mangles them from
            // the concrete self type.
            var nm = List.new<TopDecl>()
            while method in &methods {
                nm.push(clone_subst_member(method, &var names, &var repls))
            }
            val result = new_owned_top_decl(tmpl.crate, tmpl.span, mangled.as_str(), TopDeclKind.ImplBlock(nm))
            val attached = tmpl.attach_subst_dyn_metadata(result, &var names, &var repls)
            return attached
        }
        TraitImpl(tref, methods) => {
            // CONSTRAINT: keep the trait ref until normalization. A generic
            // trait's dispatch-name suffix comes from it, and without it an
            // `impl Iterator` `next` collides with an inherent `next`.
            var nm = List.new<TopDecl>()
            while method in &methods {
                nm.push(clone_subst_member(method, &var names, &var repls))
            }
            val new_trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *new_trait_ref = subst_type_ref(&*tref, &var names, &var repls) }
            val result = new_owned_top_decl(tmpl.crate, tmpl.span, mangled.as_str(), TopDeclKind.TraitImpl(new_trait_ref, nm))
            val attached = tmpl.attach_subst_dyn_metadata(result, &var names, &var repls)
            val retargeted = retarget_dyn_vtables(attached, mangled.as_str())
            return retargeted
        }
        Extern(_p, _r, _pub, _u) => {
            return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        }
        // Trait declarations are never materialized, only their impls.
        // Associated types are members, specialized by clone_subst_member.
        AssocType(_bounds) => return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        AssocTypeBinding(_chosen) => return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        AnnotationDecl(_params, _target, _pub) => return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        Template(_kind, _marked, _body) => return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        TraitDecl(_methods, _pub, _) => {
            return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
        }
        Poison => return new_owned_top_decl(tmpl.crate, tmpl.span, "", TopDeclKind.Poison)
    }
}

fun retarget_dyn_vtables(declaration: TopDecl, receiver_name: str): TopDecl {
    var result = declaration
    var tables = List.new<DynVTableInstance>()
    while table in &result.dyn_vtables {
        val symbol = "DynVTableInstance__${receiver_name}__${table.layout.as_str()}"
        val was = table.receiver.mangle_frag()
        tables.push(DynVTableInstance {
            layout: table.layout,
            receiver: Type { kind: TypeKind.Struct(intern(receiver_name)), provenance: table.receiver.provenance },
            receiver_identity: intern(receiver_name), symbol: intern(symbol.as_str()),
            adapters: retarget_dyn_adapters(&table.adapters, was.as_str(), receiver_name),
            owner: table.owner, linkage: table.linkage
        })
    }
    result.dyn_vtables = tables
    return result
}

/// An adapter symbol is `<receiver>_<method>[__<Trait>]`, so retargeting is a
/// prefix swap. A name not starting with the template's receiver is an
/// imported `link_name` and is left alone.
fun retarget_dyn_adapters(adapters: &List<Sym>, was: str, now: str): List<Sym> {
    var out = List.new<Sym>()
    while adapter in &adapters {
        out.push(adapter.retarget_dyn_adapter(was, now))
    }
    return out
}

fun Sym.retarget_dyn_adapter(was: str, now: str): Sym {
    val text = self.as_str()
    val n = was.byte_len()
    if n == 0 { return Sym { id: self.id } }
    if text.byte_len() <= n { return Sym { id: self.id } }
    var i = 0
    while i < n {
        if text.byte_at(i) != was.byte_at(i) { return Sym { id: self.id } }
        i = i + 1
    }
    // `_` must follow, so a template `Opt` does not match `Option_...`.
    if text.byte_at(n) != 95 { return Sym { id: self.id } }
    var out = String.from(now)
    val rest = text.substring(n, text.byte_len())
    out.append(rest.as_str())
    return intern(out.as_str())
}

/// Members include associated-type bindings, which specialize like any type.
fun clone_subst_member(member: &TopDecl, names: &var List<String>, repls: &var List<TypeRef>): TopDecl {
    when (member.kind) {
        AssocTypeBinding(chosen) => {
            val nchosen: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *nchosen = subst_type_ref(&*chosen, names, repls) }
            var bind = new_owned_top_decl(member.crate, member.span, member.name.as_str(), TopDeclKind.AssocTypeBinding(nchosen))
            bind.module_path = member.module_path
            return bind
        }
        _ => return clone_subst_method(member, names, repls)
    }
}

/// The type parameters this substitution did not consume, bounds specialized.
/// A method's own parameters (`fun map<F: Call1<T>>`) survive, so the clone
/// stays a template that materialize_impl_method specializes per call site.
fun retained_generics(gps: &List<TypeParam>, names: &var List<String>, repls: &var List<TypeRef>): List<TypeParam> {
    var out = List.new<TypeParam>()
    while gp in &gps {
        var consumed = false
        while ni in 0..names.size() {
            if names.at(ni).as_str().equals(gp.name.as_str()) { consumed = true }
        }
        if !consumed {
            var nbounds = List.new<TypeRef>()
            while bi in 0..gp.bounds.size() {
                nbounds.push(subst_type_ref(gp.bounds.at(bi), names, repls))
            }
            out.push(TypeParam { span: gp.span, name: gp.name, bounds: nbounds })
        }
    }
    return out
}

/// Keeps the decl's own name; only its types and body are specialized.
fun clone_subst_method(meth: &TopDecl, names: &var List<String>, repls: &var List<TypeRef>): TopDecl {
    when (meth.kind) {
        Function(params, ret_ptr, body, is_pub, is_unsafe, is_mut, is_static) => {
            var nparams = List.new<Param>()
            while p in &params {
                val npty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *npty = subst_type_ref(&*p.ty, names, repls) }
                nparams.push(new_param(p.span, p.name.as_string(), npty))
            }
            val nret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *nret = subst_type_ref(&*ret_ptr, names, repls) }
            val nbody = subst_stmt_list(body, names, repls)
            var result = new_owned_top_decl(meth.crate, meth.span, meth.name.as_str(), TopDeclKind.Function(nparams, nret, nbody, is_pub, is_unsafe, is_mut, is_static))
            result.generics = retained_generics(&meth.generics, names, repls)
            val attached = meth.attach_subst_dyn_metadata(result, names, repls)
            return attached
        }
        _ => return new_owned_top_decl(meth.crate, meth.span, "", TopDeclKind.Poison)
    }
}

/// An instance of a view type is a view too.
fun TopDecl.carry_view(instance: TopDecl): TopDecl {
    var marked = instance
    marked.is_view = self.is_view
    return marked
}
