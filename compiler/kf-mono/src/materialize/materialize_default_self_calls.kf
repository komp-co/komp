// A default method body is never typechecked, so `self.other()` inside it has
// no mangled_callee. This stamps one onto each sibling trait-method call in
// the clone made for one impl.
//
// CONSTRAINT: runs after all generic materialization, so `owner_name` is
// already the final concrete name.

import alloc.list.*

import kf_core.ast.Intrinsic
import kf_core.ast.intern
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_mono.mangle_method

fun trait_method_names(defaults: &List<TopDecl>): List<String> {
    var names = List.new<String>()
    while method in &defaults {
        names.push(method.name.as_string())
    }
    return names
}

fun is_self_receiver(e: &Expr): bool {
    return when (e.kind) {
        Variable(sym) => sym.as_str().equals("self")
        _ => false
    }
}

fun mangled_sibling_name(owner_name: str, method: str, suffix: str): String {
    var mangled = mangle_method(owner_name, method)
    if !suffix.equals("") {
        mangled.append("__")
        mangled.append(suffix)
    }
    return mangled
}

pub mutating fun TopDecl.stamp_default_self_calls(owner_name: str, suffix: str, defaults: &List<TopDecl>): void {
    val siblings = trait_method_names(defaults)
    when (self.kind) {
        Function(_params, _ret, body, _pub, _unsafe, _mut, _static) => {
            stamp_stmt_list(&var body, owner_name, suffix, &siblings)
        }
        _ => { }
    }
}

fun stamp_stmt_list(stmts: &var List<Stmt>, owner_name: str, suffix: str, siblings: &List<String>): void {
    while i in 0..stmts.size() {
        (stmts.at_mut(i)).stamp_stmt(owner_name, suffix, siblings)
    }
}

mutating fun Stmt.stamp_stmt(owner_name: str, suffix: str, siblings: &List<String>): void {
    when (self.kind) {
        LetVal(_, _, init_ptr) => {
            val p = init_ptr ?: return
            stamp_expr(unsafe { &var *p }, owner_name, suffix, siblings)
        }
        LetVar(_, _, init_ptr) => {
            val p = init_ptr ?: return
            stamp_expr(unsafe { &var *p }, owner_name, suffix, siblings)
        }
        Assign(_, expr_ptr) => {
            stamp_expr(unsafe { &var *expr_ptr }, owner_name, suffix, siblings)
        }
        AssignTo(place_ptr, expr_ptr) => {
            stamp_expr(unsafe { &var *place_ptr }, owner_name, suffix, siblings)
            stamp_expr(unsafe { &var *expr_ptr }, owner_name, suffix, siblings)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            stamp_expr(unsafe { &var *ep }, owner_name, suffix, siblings)
        }
        Expression(expr_ptr) => {
            stamp_expr(unsafe { &var *expr_ptr }, owner_name, suffix, siblings)
        }
        If(cond_ptr, then_body, else_body) => {
            stamp_expr(unsafe { &var *cond_ptr }, owner_name, suffix, siblings)
            stamp_stmt_list(&var then_body, owner_name, suffix, siblings)
            stamp_stmt_list(&var else_body, owner_name, suffix, siblings)
        }
        While(cond_ptr, body) => {
            stamp_expr(unsafe { &var *cond_ptr }, owner_name, suffix, siblings)
            stamp_stmt_list(&var body, owner_name, suffix, siblings)
        }
        ForEach(_binder, subj_ptr, body) => {
            stamp_expr(unsafe { &var *subj_ptr }, owner_name, suffix, siblings)
            stamp_stmt_list(&var body, owner_name, suffix, siblings)
        }
        When(subj_ptr, arms) => {
            stamp_expr(unsafe { &var *subj_ptr }, owner_name, suffix, siblings)
            while i in 0..arms.size() {
                val arm = arms.at_mut(i)
                when (arm.guard) {
                    Some(guard) => stamp_expr(unsafe { &var *guard }, owner_name, suffix, siblings)
                    None => { }
                }
                stamp_stmt_list(&var arm.body, owner_name, suffix, siblings)
            }
        }
        _ => return
    }
}

mutating fun Expr.stamp_expr(owner_name: str, suffix: str, siblings: &List<String>): void {
    when (self.kind) {
        Binary(lhs_ptr, _, rhs_ptr) => {
            stamp_expr(unsafe { &var *lhs_ptr }, owner_name, suffix, siblings)
            stamp_expr(unsafe { &var *rhs_ptr }, owner_name, suffix, siblings)
        }
        Unary(_, inner_ptr) => {
            stamp_expr(unsafe { &var *inner_ptr }, owner_name, suffix, siblings)
        }
        Deref(inner_ptr) => {
            stamp_expr(unsafe { &var *inner_ptr }, owner_name, suffix, siblings)
        }
        Call(_, args) => {
            stamp_args(args, owner_name, suffix, siblings)
        }
        Intrinsic(_, args) => {
            stamp_args(args, owner_name, suffix, siblings)
        }
        CallValue(callee_ptr, args) => {
            stamp_expr(&var *callee_ptr, owner_name, suffix, siblings)
            stamp_args(args, owner_name, suffix, siblings)
        }
        MethodCall(recv_ptr, method_sym, args) => {
            stamp_expr(unsafe { &var *recv_ptr }, owner_name, suffix, siblings)
            stamp_args(args, owner_name, suffix, siblings)
            val recv = unsafe { *recv_ptr }
            if is_self_receiver(&recv) && str_name_list_contains(siblings, method_sym.as_str()) {
                val mangled = mangled_sibling_name(owner_name, method_sym.as_str(), suffix)
                self.mangled_callee = intern(mangled.as_str())
            }
        }
        FieldAccess(obj_ptr, _) => {
            stamp_expr(unsafe { &var *obj_ptr }, owner_name, suffix, siblings)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            stamp_expr(unsafe { &var *c_ptr }, owner_name, suffix, siblings)
            stamp_expr(unsafe { &var *t_ptr }, owner_name, suffix, siblings)
            stamp_expr(unsafe { &var *e_ptr }, owner_name, suffix, siblings)
        }
        WhenExpr(subj_ptr, arms) => {
            stamp_expr(unsafe { &var *subj_ptr }, owner_name, suffix, siblings)
            while i in 0..arms.size() {
                val arm = arms.at_mut(i)
                when (arm.guard) {
                    Some(guard) => stamp_expr(unsafe { &var *guard }, owner_name, suffix, siblings)
                    None => { }
                }
                stamp_stmt_list(&var arm.body, owner_name, suffix, siblings)
            }
        }
        StructLit(_, fields) => {
            while fi in &fields {
                val vp = fi.value
                stamp_expr(unsafe { &var *vp }, owner_name, suffix, siblings)
            }
        }
        Cast(inner_ptr, _) => {
            stamp_expr(unsafe { &var *inner_ptr }, owner_name, suffix, siblings)
        }
        DynCoerce(inner_ptr, _) => {
            stamp_expr(unsafe { &var *inner_ptr }, owner_name, suffix, siblings)
        }
        _ => return
    }
}

fun stamp_args(args: &var List<Expr>, owner_name: str, suffix: str, siblings: &List<String>): void {
    while i in 0..args.size() {
        stamp_expr(args.at_mut(i), owner_name, suffix, siblings)
    }
}
