import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.view
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*

// `struct Window<T> { val start: Ptr<T> }`, a `view struct` when asked.
fun window_template(view: bool): TopDecl {
    var elem = List.new<TypeRef>()
    elem.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("T"), List.new<TypeRef>())))
    val start_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *start_ty = TypeRef.new(no_span(), TypeRefKind.Named(intern("Ptr"), elem)) }
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("start"), start_ty, false, true))
    var td = new_top_decl(no_span(), String.from("Window"), TopDeclKind.Struct(fields, true))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    td.is_view = view
    return td
}

fun int32_args(): List<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    return args
}

@test fun an_instance_of_a_view_is_a_view(): void {
    val instance = clone_subst_decl(&window_template(true), &int32_args(), String.from("Window__int32"))
    assert_eq(instance.is_view_type(), true, "its values borrow as the template's do")
}

@test fun an_instance_of_an_owned_type_is_not_a_view(): void {
    val instance = clone_subst_decl(&window_template(false), &int32_args(), String.from("Window__int32"))
    assert_eq(instance.is_view_type(), false, "nothing is invented")
}
