import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.declaration.new_top_decl
import kf_core.ast.subst.mangle_tyref
import kf_core.ast.dyn_meta.clone_dyn_layout_list
import kf_core.ast.dyn_meta.clone_dyn_vtable_list

/// Every TraitImpl becomes an ImplBlock and every TraitDecl is dropped.
mutating fun Module.normalize_trait_impls(): void {
    var kept = List.new<TopDecl>()
    while td in &self.decls {
        when (td.kind) {
            TraitDecl(_methods, _pub, _) => { }
            TraitImpl(tref, methods) => {
                val suffix = trait_ref_arg_suffix(unsafe { *tref }, self)
                val completed = self.append_default_trait_methods(&td, unsafe { *tref }, methods, suffix.as_str())
                var renamed = List.new<TopDecl>()
                while j in 0..completed.size() {
                    var method = *completed.at(j)
                    if !suffix.as_str().equals("") {
                        var renamed_name = String.from(method.name.as_str())
                        renamed_name.append("__")
                        renamed_name.append(suffix.as_str())
                        method.name = intern(renamed_name.as_str())
                    }
                    // The last point where trait origin is known; codegen uses
                    // it for header declarations. A field write, so no payload
                    // is moved out of the enum.
                    method.from_trait_impl = true
                    renamed.push(method)
                }
                var normalized = new_top_decl(td.span, td.name.as_string(), TopDeclKind.ImplBlock(renamed))
                normalized.crate = td.crate
                normalized.module_path = td.module_path
                normalized.decl = td.decl
                normalized.generics = td.generics
                normalized.annotations = td.annotations.clone()
                normalized.linkage = td.linkage
                normalized.link_name = td.link_name
                normalized.dyn_layouts = clone_dyn_layout_list(&td.dyn_layouts)
                normalized.dyn_vtables = clone_dyn_vtable_list(&td.dyn_vtables)
                normalized.decl_end = td.decl_end
                val principal = tref.trait_ref_principal()
                normalized.implemented_lang_trait = self.lang_key_of_trait(principal.as_str())
                kept.push(normalized)
            }
            _ => kept.push(td)
        }
    }
    self.decls = kept
}

/// CONSTRAINT: runs while the trait declaration still exists.
fun Module.append_default_trait_methods(owner: &TopDecl, tref: TypeRef, methods: List<TopDecl>, suffix: str): List<TopDecl> {
    var completed = methods
    val trait_name = tref.trait_ref_principal()
    while candidate in &self.decls {
        if candidate.name.as_str().equals(trait_name.as_str()) {
            when (candidate.kind) {
                TraitDecl(defaults, _pub, _) => append_missing_defaults(&var completed, owner, &candidate, &tref, &defaults, suffix)
                _ => { }
            }
        }
    }
    return completed
}

fun append_missing_defaults(out: &var List<TopDecl>, owner: &TopDecl, trait_decl: &TopDecl, tref: &TypeRef, defaults: &List<TopDecl>, suffix: str): void {
    var names = List.new<String>()
    var replacements = List.new<TypeRef>()
    names.push(String.from("Self"))
    replacements.push(TypeRef.new(owner.span, TypeRefKind.Named(owner.name, List.new<TypeRef>())))
    trait_decl.append_trait_arg_substitutions(tref, &var names, &var replacements)
    while method in &defaults {
        if method.default_method_has_body() && !method_list_has_name(out, method.name.as_str()) {
            var concrete = clone_subst_method(method, &var names, &var replacements)
            concrete.crate = owner.crate
            concrete.module_path = owner.module_path
            concrete.from_trait_impl = true
            concrete.stamp_default_self_calls(owner.name.as_str(), suffix, defaults)
            out.push(concrete)
        }
    }
}

fun TopDecl.append_trait_arg_substitutions(tref: &TypeRef, names: &var List<String>, replacements: &var List<TypeRef>): void {
    when (tref.kind) {
        Named(_name, args) => {
            var i = 0
            while i < self.generics.size() && i < args.size() {
                names.push(self.generics.at(i).name.as_string())
                replacements.push(*args.at(i))
                i = i + 1
            }
        }
        _ => { }
    }
}

fun TopDecl.default_method_has_body(): bool {
    return when (self.kind) {
        Function(_params, _ret, body, _pub, _unsafe, _mutating, _static) => body.size() > 0
        _ => false
    }
}

fun method_list_has_name(methods: &List<TopDecl>, name: str): bool {
    while method in &methods {
        if method.name.as_str().equals(name) { return true }
    }
    return false
}

fun TypeRef.trait_ref_principal(): String {
    return when (self.kind) {
        Named(name, _args) => name.as_string()
        _ => ""
    }
}

pub fun trait_ref_arg_suffix(tref: TypeRef, m: &Module): String {
    when (tref.kind) {
        Named(name, args) => {
            if args.size() == 0 && m.is_auto_trait(name.as_str()) { return "" }
            var out = String.from(name.as_str())
            while item in &args {
                out.append("__")
                val arg = mangle_tyref(item)
                out.append(arg.as_str())
            }
            return out
        }
        _ => return ""
    }
}

mutating fun Module.strip_templates(): void {
    var kept = List.new<TopDecl>()
    while td in &self.decls {
        var keep = td.generics.size() == 0
        when (td.kind) {
            // Kept until normalize_trait_impls: default methods still need them.
            TraitDecl(_methods, _pub, _) => { keep = true }
            _ => { }
        }
        if keep { kept.push(td) }
    }
    self.decls = kept
}

fun is_poison_decl(td: TopDecl): bool {
    return when (td.kind) {
        Poison => true
        _ => false
    }
}

/// The lang key of the trait named `name`, or empty for an ordinary trait.
/// CONSTRAINT: runs while the trait declaration still exists.
fun Module.lang_key_of_trait(name: str): Sym {
    while td in &self.decls {
        when (td.kind) {
            TraitDecl(_members, _pub, _supers) => {
                if td.name.as_str() == name { return intern((&td).lang_key_of().as_str()) }
            }
            _ => { }
        }
    }
    return intern("")
}
