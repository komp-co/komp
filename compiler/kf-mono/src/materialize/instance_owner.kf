// Which impl block a generic method's instance is minted in: its receiver's
// instance, which may itself be minted later in the worklist.

import alloc.list.*

import kf_core.ast.Module

/// A call on `self` inside a clone names the template as its owner; from
/// `from` on, such instances belong to `instance`.
mutating fun List<Inst>.own_self_calls(from: uint64, template: str, instance: str): void {
    if template == instance { return }
    while i in from..self.size() {
        if self.at(i).owner.as_str() != template { continue }
        val inst = self.at(i)
        val owned = Inst { base: inst.base.clone(), args: inst.args.clone(), owner: String.from(instance) }
        self.set(i, owned)
    }
}

fun Module.has_impl_block(name: str): bool {
    while td in &self.decls {
        if td.name.as_str() != name { continue }
        when (td.kind) {
            ImplBlock(_) => return true
            _ => { }
        }
    }
    return false
}
