import alloc.list.*

import kf_core.ast.statement.Stmt

pub mutating fun Stmt.mono_stmt(): void {
    self.mono_stmt_in("")
}

pub mutating fun Stmt.mono_stmt_in(owner: str): void {
    when (self.kind) {
        LetVal(_, _, init_ptr) => {
            val p = init_ptr ?: return
            mono_expr_in(unsafe { &var *p }, owner)
        }
        LetVar(_, _, init_ptr) => {
            val p = init_ptr ?: return
            mono_expr_in(unsafe { &var *p }, owner)
        }
        Assign(_, expr_ptr) => {
            mono_expr_in(unsafe { &var *expr_ptr }, owner)
        }
        AssignTo(place_ptr, expr_ptr) => {
            mono_expr_in(unsafe { &var *place_ptr }, owner)
            mono_expr_in(unsafe { &var *expr_ptr }, owner)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            mono_expr_in(unsafe { &var *ep }, owner)
        }
        Expression(expr_ptr) => {
            mono_expr_in(unsafe { &var *expr_ptr }, owner)
        }
        If(cond_ptr, then_body, else_body) => {
            mono_expr_in(unsafe { &var *cond_ptr }, owner)
            mono_stmt_list_in(&var then_body, owner)
            mono_stmt_list_in(&var else_body, owner)
        }
        While(cond_ptr, body) => {
            mono_expr_in(unsafe { &var *cond_ptr }, owner)
            mono_stmt_list_in(&var body, owner)
        }
        ForEach(_binder, subj_ptr, body) => {
            mono_expr_in(unsafe { &var *subj_ptr }, owner)
            mono_stmt_list_in(&var body, owner)
        }
        When(subj_ptr, arms) => {
            mono_expr_in(unsafe { &var *subj_ptr }, owner)
            while i in 0..arms.size() {
                val arm = arms.at_mut(i)
                when (arm.guard) {
                    Some(guard) => mono_expr_in(unsafe { &var *guard }, owner)
                    None => { }
                }
                mono_stmt_list_in(&var arm.body, owner)
            }
        }
        Switch(_, _) => return
        Drop(_) => return
        Release(_) => return
        Break => return
        Continue => return
        Poison => return
    }
}

pub fun mono_stmt_list_in(stmts: &var List<Stmt>, owner: str): void {
    while i in 0..stmts.size() {
        (stmts.at_mut(i)).mono_stmt_in(owner)
    }
}
