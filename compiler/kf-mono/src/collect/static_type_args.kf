// `Type.method<A, B>(...)` writes the receiver's type arguments and the
// method's own in one list. The boundary is the method template's own arity.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl

/// A generic method template's own parameter count, keyed `Owner_method`.
///
/// CONSTRAINT: `pub`, because `collect_method_arities` is and names it. A
/// public signature naming a private type emits two incompatible C structs.
pub struct MethodArity {
    pub val key: String
    pub val count: uint64
}

/// Built once per run: cloning only substitutes parameters away, so no
/// template gains generics while the worklist runs.
pub fun Module.collect_method_arities(): List<MethodArity> {
    var out = List.new<MethodArity>()
    while td in &self.decls {
        when (td.kind) {
            ImplBlock(methods) => { push_method_arities(td.name.as_str(), methods, &var out) }
            TraitImpl(_tref, methods) => { push_method_arities(td.name.as_str(), methods, &var out) }
            _ => { }
        }
    }
    return out
}

fun push_method_arities(owner: str, methods: &List<TopDecl>, out: &var List<MethodArity>): void {
    while mth in &methods {
        if mth.generics.size() > 0 {
            var key = String.from(owner)
            key.append("_")
            key.append(mth.name.as_str())
            out.push(MethodArity { key: key, count: mth.generics.size() })
        }
    }
}

/// Zero when `method` on `owner` declares none.
fun method_own_arity(marities: &List<MethodArity>, owner: &String, method: str): uint64 {
    var key = String.from(owner.as_str())
    key.append("_")
    key.append(method)
    while ma in &marities {
        if ma.key.as_str().equals(key.as_str()) { return ma.count }
    }
    return 0
}

/// `args[0..n)`: the receiver's type arguments.
fun tref_vec_head(args: &List<TypeRef>, n: uint64): List<TypeRef> {
    var out = List.new<TypeRef>()
    var i = 0
    while i < n {
        if i < args.size() { out.push(*args.at(i)) }
        i = i + 1
    }
    return out
}

/// `args[n..)`: the method's own.
fun tref_vec_tail(args: &List<TypeRef>, n: uint64): List<TypeRef> {
    var out = List.new<TypeRef>()
    var i: uint64 = n
    while i < args.size() {
        out.push(*args.at(i))
        i = i + 1
    }
    return out
}
