import alloc.list.*

import kf_core.ast.Intrinsic
import kf_core.ast.array_literal_callee
import kf_core.ast.view
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_mono.materialize.*
import kf_mono.extract_struct_name
import kf_core.ast.subst.clone_tref_vec
import kf_core.ast.subst.monomorphized_type_name

fun name_is_generic_param(name: str, gps: &List<String>): bool {
    while gp in &gps {
        if gp.as_str().equals(name) { return true }
    }
    return false
}

/// Mentions no generic-parameter name anywhere, so it may be materialized.
fun TypeRef.tref_is_concrete(gps: &List<String>): bool {
    when (self.kind) {
        Named(name, args) => {
            if name_is_generic_param(name.as_str(), gps) { return false }
            while arg in &args {
                if !(arg).tref_is_concrete(gps) { return false }
            }
            return true
        }
        DynTrait(_name, args) => {
            while arg in &args {
                if !(arg).tref_is_concrete(gps) { return false }
            }
            return true
        }
        Reference(_m, inner) => return (unsafe { &*inner }).tref_is_concrete(gps)
        Array(inner, _s) => return (unsafe { &*inner }).tref_is_concrete(gps)
        Value(_v) => return true
        Function(params, ret) => {
            while param in &params {
                if !(param).tref_is_concrete(gps) { return false }
            }
            return (unsafe { &*ret }).tref_is_concrete(gps)
        }
        // A projection is as concrete as its owner; the owner's impl picks the
        // member. Treating it as concrete regardless mints an instance keyed
        // on the unresolved name.
        Projection(owner, _member) => return (unsafe { &*owner }).tref_is_concrete(gps)
        Poison => return true
    }
}

fun tref_vec_has_generic(args: &List<TypeRef>, gps: &List<String>): bool {
    while arg in &args {
        if !(arg).tref_is_concrete(gps) { return true }
    }
    return false
}

pub fun TopDecl.collect_insts_in_decl(gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    when (self.kind) {
        Function(params, ret, body, _pub, _u, _m, _s) => {
            while param in &params {
                (unsafe { &*param.ty }).collect_insts_in_tyref(gps, marities, work)
            }
            (unsafe { &*ret }).collect_insts_in_tyref(gps, marities, work)
            collect_insts_in_stmt_list(body, gps, marities, work)
        }
        Struct(fields, _pub) => {
            while field in &fields {
                (unsafe { &*field.ty }).collect_insts_in_tyref(gps, marities, work)
            }
        }
        EnumDecl(variants, _pub) => {
            while variant in &variants {
                while j in 0..variant.payloads.size() {
                    (variant.payloads.at(j)).collect_insts_in_tyref(gps, marities, work)
                }
            }
        }
        ImplBlock(methods) => {
            while method in &methods {
                method.collect_insts_in_decl(gps, marities, work)
            }
        }
        TraitImpl(_tref, methods) => {
            while method in &methods {
                method.collect_insts_in_decl(gps, marities, work)
            }
        }
        _ => { }
    }
}

fun collect_insts_in_stmt_list(stmts: &List<Stmt>, gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    while stmt in &stmts {
        (stmt).collect_insts_in_stmt(gps, marities, work)
    }
}

fun collect_insts_in_optional_tyref(tropt: Ptr<TypeRef>?, gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    val tr = tropt ?: return
    (unsafe { &*tr }).collect_insts_in_tyref(gps, marities, work)
}

fun Stmt.collect_insts_in_stmt(gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    when (self.kind) {
        LetVal(_n, ty, init_ptr) => {
            collect_insts_in_optional_tyref(ty.view(), gps, marities, work)
            val p = init_ptr ?: return
            collect_insts_in_expr(unsafe { &*p }, gps, marities, work)
        }
        LetVar(_n, ty, init_ptr) => {
            collect_insts_in_optional_tyref(ty.view(), gps, marities, work)
            val p = init_ptr ?: return
            collect_insts_in_expr(unsafe { &*p }, gps, marities, work)
        }
        Assign(_n, expr_ptr) => { collect_insts_in_expr(unsafe { &*expr_ptr }, gps, marities, work) }
        AssignTo(place_ptr, expr_ptr) => {
            collect_insts_in_expr(unsafe { &*place_ptr }, gps, marities, work)
            collect_insts_in_expr(unsafe { &*expr_ptr }, gps, marities, work)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            collect_insts_in_expr(unsafe { &*ep }, gps, marities, work)
        }
        If(cond_ptr, then_body, else_body) => {
            collect_insts_in_expr(unsafe { &*cond_ptr }, gps, marities, work)
            collect_insts_in_stmt_list(then_body, gps, marities, work)
            collect_insts_in_stmt_list(else_body, gps, marities, work)
        }
        While(cond_ptr, body) => {
            collect_insts_in_expr(unsafe { &*cond_ptr }, gps, marities, work)
            collect_insts_in_stmt_list(body, gps, marities, work)
        }
        ForEach(_binder, subj_ptr, body) => {
            collect_insts_in_expr(unsafe { &*subj_ptr }, gps, marities, work)
            collect_insts_in_stmt_list(body, gps, marities, work)
        }
        When(subj_ptr, arms) => {
            collect_insts_in_expr(unsafe { &*subj_ptr }, gps, marities, work)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => collect_insts_in_expr(unsafe { &*guard }, gps, marities, work)
                    None => { }
                }
                collect_insts_in_stmt_list(arm.body, gps, marities, work)
            }
        }
        Expression(expr_ptr) => { collect_insts_in_expr(unsafe { &*expr_ptr }, gps, marities, work) }
        Switch(subj_ptr, sarms) => {
            collect_insts_in_expr(unsafe { &*subj_ptr }, gps, marities, work)
            while sa in &sarms {
                when (sa.guard) {
                    Some(guard) => collect_insts_in_expr(unsafe { &*guard }, gps, marities, work)
                    None => { }
                }
                collect_insts_in_stmt_list(sa.body, gps, marities, work)
            }
        }
        Drop(_n) => { }
        Release(_n) => { }
        Break => { }
        Continue => { }
        Poison => { }
    }
}

fun TypeRef.collect_insts_in_tyref(gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    when (self.kind) {
        Named(name, args) => {
            // Only a concrete instantiation is pushed (`List<int32>`, not
            // `ListIter<T>`), but args are walked either way so
            // `Foo<T, List<int32>>` still finds `List__int32`.
            if args.size() > 0 && self.tref_is_concrete(gps) {
                work.push(free_inst(name.as_string(), clone_tref_vec(args)))
            }
            while arg in &args {
                (arg).collect_insts_in_tyref(gps, marities, work)
            }
        }
        DynTrait(_name, args) => {
            while arg in &args {
                (arg).collect_insts_in_tyref(gps, marities, work)
            }
        }
        Reference(_mutable, inner) => (unsafe { &*inner }).collect_insts_in_tyref(gps, marities, work)
        Array(inner, _size) => (unsafe { &*inner }).collect_insts_in_tyref(gps, marities, work)
        Value(_v) => { }
        Function(params, ret) => {
            while param in &params {
                (param).collect_insts_in_tyref(gps, marities, work)
            }
            (unsafe { &*ret }).collect_insts_in_tyref(gps, marities, work)
        }
        // Its owner is collected wherever it appears as a type in its own right.
        Projection(_owner, _member) => { }
        Poison => { }
    }
}

fun Expr.collect_insts_in_expr(gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    val n_ta: uint64 = self.type_args.size()
    when (self.kind) {
        Call(name, args) => {
            if name.as_str() == array_literal_callee() {
                // The array a literal builds, which may be named nowhere else.
                while t in &self.type_args { t.collect_insts_in_tyref(gps, marities, work) }
            } else if n_ta > 0 && !tref_vec_has_generic(self.type_args, gps) {
                work.push(free_inst(String.from(name.as_str()), clone_tref_vec(self.type_args)))
            }
            collect_insts_in_expr_list(args, gps, marities, work)
        }
        Intrinsic(_intrinsic, args) => collect_insts_in_expr_list(args, gps, marities, work)
        StructLit(name, finits) => {
            if n_ta > 0 && !tref_vec_has_generic(self.type_args, gps) { work.push(free_inst(String.from(name.as_str()), clone_tref_vec(self.type_args))) }
            while fi in &finits {
                val vp: Ptr<Expr> = fi.value
                collect_insts_in_expr(unsafe { &*vp }, gps, marities, work)
            }
        }
        Binary(lp, _op, rp) => {
            collect_insts_in_expr(unsafe { &*lp }, gps, marities, work)
            collect_insts_in_expr(unsafe { &*rp }, gps, marities, work)
        }
        Unary(_op, ip) => { collect_insts_in_expr(unsafe { &*ip }, gps, marities, work) }
        Deref(ip) => { collect_insts_in_expr(unsafe { &*ip }, gps, marities, work) }
        FnRef(_) => { }
        CallValue(callee_ptr, args) => {
            collect_insts_in_expr(&*callee_ptr, gps, marities, work)
            collect_insts_in_expr_list(args, gps, marities, work)
        }
        MethodCall(recv_ptr, method_sym, args) => {
            // CONSTRAINT: the receiver is walked first, so an instance it
            // mints (`Bag<int32> { .. }`) is queued ahead of the method's.
            collect_insts_in_expr(unsafe { &*recv_ptr }, gps, marities, work)
            // `Type.method<Targs>(...)` needs `Type<Targs>`, and with it the
            // impl holding the static method.
            if self.is_static_call {
                if n_ta > 0 && !tref_vec_has_generic(self.type_args, gps) {
                    val rk = unsafe { recv_ptr.kind }
                    when (rk) {
                        Variable(tn) => {
                            // One written list holds the receiver's type args
                            // then the method's own; the method template's arity
                            // is the boundary, zero for a non-generic static.
                            val owner = String.from(tn.as_str())
                            val n_meth = method_own_arity(marities, &owner, method_sym.as_str())
                            var split: uint64 = n_ta
                            if n_meth < split { split = split - n_meth } else { split = 0 }
                            val recv_args = tref_vec_head(self.type_args, split)
                            val meth_args = tref_vec_tail(self.type_args, split)
                            // CONSTRAINT: the receiver's instance is queued
                            // first and named as the method's owner, so the
                            // specialization lands in the impl block that
                            // instance mints, not in the template's.
                            var mowner = owner.clone()
                            if recv_args.size() > 0 {
                                mowner = monomorphized_type_name(owner.clone(), &recv_args)
                                work.push(free_inst(owner.clone(), recv_args))
                            }
                            if meth_args.size() > 0 {
                                work.push(Inst {
                                    base: method_sym.as_string(),
                                    args: meth_args,
                                    owner: mowner
                                })
                            }
                        }
                        _ => { }
                    }
                }
            } else {
                // `recv.method<Targs>(..)`: the template lives in the receiver
                // type's impl block, so the instance is owner-qualified.
                if n_ta > 0 && !tref_vec_has_generic(self.type_args, gps) {
                    val recv = unsafe { *recv_ptr }
                    val owner = extract_struct_name(recv.ty)
                    if !owner.as_str().equals("") {
                        work.push(Inst {
                            base: method_sym.as_string(),
                            args: clone_tref_vec(self.type_args),
                            owner: owner
                        })
                    } else {
                        // No owner: the receiver names a type, as in the
                        // generic variant constructor `Res.Ok(7)`. The instance
                        // to mint is `Res<int32>` itself.
                        val rk = unsafe { recv_ptr.kind }
                        when (rk) {
                            Variable(tn) => { work.push(free_inst(String.from(tn.as_str()), clone_tref_vec(self.type_args))) }
                            _ => { }
                        }
                    }
                }
            }
            collect_insts_in_expr_list(args, gps, marities, work)
        }
        FieldAccess(obj_ptr, _f) => { collect_insts_in_expr(unsafe { &*obj_ptr }, gps, marities, work) }
        IfExpr(c, t, el) => {
            collect_insts_in_expr(unsafe { &*c }, gps, marities, work)
            collect_insts_in_expr(unsafe { &*t }, gps, marities, work)
            collect_insts_in_expr(unsafe { &*el }, gps, marities, work)
        }
        WhenExpr(subj_ptr, arms) => {
            collect_insts_in_expr(unsafe { &*subj_ptr }, gps, marities, work)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => collect_insts_in_expr(unsafe { &*guard }, gps, marities, work)
                    None => { }
                }
                collect_insts_in_stmt_list(arm.body, gps, marities, work)
            }
        }
        Cast(ip, _t) => { collect_insts_in_expr(unsafe { &*ip }, gps, marities, work) }
        DynCoerce(ip, _vtable) => { collect_insts_in_expr(unsafe { &*ip }, gps, marities, work) }
        Retain(ip) => { collect_insts_in_expr(unsafe { &*ip }, gps, marities, work) }
        LitInt(_v) => { }
        LitStr(_s) => { }
        LitFloat(_) => { }
        LitChar(_) => { }
        LitBool(_b) => { }
        Variable(_n) => { }
        Release(_n) => { }
        Lambda(_, _) => { }
        Block(stmts) => {
            while stmt in &stmts {
                (stmt).collect_insts_in_stmt(gps, marities, work)
            }
        }
        Poison => { }
    }
}

fun collect_insts_in_expr_list(args: &List<Expr>, gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>): void {
    while arg in &args {
        arg.collect_insts_in_expr(gps, marities, work)
    }
}
