import kf_mono.mono_module
import kf_mono.materialize.*

fun mtr_p(n: str): Ptr<TypeRef> {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = TypeRef.new(no_span(), TypeRefKind.Named(intern(n), List.new<TypeRef>())) }
    return p
}

fun mtr_v(n: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(n), List.new<TypeRef>()))
}

@test fun str_name_list_finds_owned_mangled_name(): void {
    var names = List.new<String>()
    names.push(String.from("Wrap__int32"))
    assert_eq(str_name_list_contains(&names, "Wrap__int32"), true, "owned mangled name is found")
}

fun mep(k: ExprKind): Ptr<Expr> {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = Expr.new(no_span(), k) }
    return p
}

pub mutating fun Module.has_decl(name: str): bool {
    while td in &self.decls {
        if td.name.as_str().equals(name) { return true }
    }
    return false
}

mutating fun Module.mod_has_template(name: str): bool {
    while td in &self.decls {
        if td.generics.size() > 0 {
            if td.name.as_str().equals(name) { return true }
        }
    }
    return false
}

mutating fun Module.mod_has_impl(target: str): bool {
    while td in &self.decls {
        if td.name.as_str().equals(target) {
            when (td.kind) {
                ImplBlock(_) => return true
                _ => { }
            }
        }
    }
    return false
}

// impl Wrap<T> { pub fun get(): T { return self.v } }
fun mk_box_impl_decl(): TopDecl {
    val selfv = mep(ExprKind.Variable(intern("self")))
    val fa = mep(ExprKind.FieldAccess(selfv, intern("v")))
    var mbody = List.new<Stmt>()
    mbody.push(Stmt.new(no_span(), StmtKind.Return(ret_op(fa))))
    val getm = new_top_decl(no_span(), String.from("get"), TopDeclKind.Function(List.new<Param>(), mtr_p("T"), mbody, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(getm)
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.ImplBlock(methods))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

// struct Wrap<T> { pub val v: T }
fun mk_box_decl(): TopDecl {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("v"), mtr_p("T"), false, true))
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.Struct(fields, true))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

@test fun clone_subst_decl_accepts_owned_str_name(): void {
    var args = List.new<TypeRef>()
    args.push(mtr_v("int32"))
    val specialized = clone_subst_decl(mk_box_decl(), &args, String.from("Wrap__int32"))
    assert_eq(specialized.name.as_str(), "Wrap__int32", "specialized declaration interns the owned String name")
}

@test fun new_owned_top_decl_accepts_borrowed_name(): void {
    val name = String.from("Borrowed")
    val decl = new_owned_top_decl(crate_id_poison(), no_span(), name.as_str(), TopDeclKind.Poison)
    assert_eq(decl.name.as_str(), "Borrowed", "declaration constructor interns a borrowed name")
}

@test fun mono_materializes_generic_used_only_by_field_type(): void {
    var args = List.new<TypeRef>()
    args.push(mtr_v("int32"))
    val wrap_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *wrap_ty = TypeRef.new(no_span(), TypeRefKind.Named(intern("Wrap"), args)) }
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("value"), wrap_ty, false, true))
    val holder = new_top_decl(no_span(), String.from("Holder"), TopDeclKind.Struct(fields, true))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_box_decl())
    m.decls.push(holder)
    m.mono_module()
    assert_eq(m.has_decl("Wrap__int32"), true, "field type materializes Wrap__int32")
}

// enum Option<T> { Some(T)  None }
fun mk_option_enum_decl(): TopDecl {
    var some_pay = List.new<TypeRef>()
    some_pay.push(mtr_v("T"))
    var variants = List.new<Variant>()
    variants.push(new_variant(no_span(), String.from("Some"), some_pay))
    variants.push(new_variant(no_span(), String.from("None"), List.new<TypeRef>()))
    var td = new_top_decl(no_span(), String.from("Option"), TopDeclKind.EnumDecl(variants, true))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

@test fun mono_materializes_option_as_generic_enum(): void {
    var args = List.new<TypeRef>()
    args.push(mtr_v("int32"))
    val opt_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *opt_ty = TypeRef.new(no_span(), TypeRefKind.Named(intern("Option"), args)) }
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("value"), opt_ty, false, true))
    val holder = new_top_decl(no_span(), String.from("Holder"), TopDeclKind.Struct(fields, true))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_option_enum_decl())
    m.decls.push(holder)
    m.mono_module()
    assert_eq(m.has_decl("Option__int32"), true, "Option de-magic: Option<int32> monomorphizes like any generic enum")
}

// fun wrap<T>(x: T): Wrap<T> { return Wrap<T>{v:x} }
fun mk_wrap_body(): TopDecl {
    var finits = List.new<FieldInit>()
    finits.push(FieldInit.new(no_span(), String.from("v"), mep(ExprKind.Variable(intern("x")))))
    var slit = Expr.new(no_span(), ExprKind.StructLit(intern("Wrap"), finits))
    var targs = List.new<TypeRef>()
    targs.push(mtr_v("T"))
    slit.type_args = targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(slit_p))))
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("x"), mtr_p("T")))
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    var rargs = List.new<TypeRef>()
    rargs.push(mtr_v("T"))
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("Wrap"), rargs)) }
    return new_top_decl(no_span(), String.from("wrap"), TopDeclKind.Function(params, ret, body, true, false, false, false))
}

fun mk_wrap_decl(): TopDecl {
    var td = mk_wrap_body()
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

@test fun mono_unannotated_let_does_not_deref_null_annotation(): void {
    val init = mep(ExprKind.LitInt(1))
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("value"), null, init)))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), body, true, false, false, false))
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(main_td)
    m.mono_module()
    assert_eq(m.decls.size(), 1, "mono accepts a let without a type annotation")
}

@test fun mono_materializes_used_generic_struct(): void {
    val box_td = mk_box_decl()
    var finits = List.new<FieldInit>()
    finits.push(FieldInit.new(no_span(), String.from("v"), mep(ExprKind.LitInt(7))))
    var slit = Expr.new(no_span(), ExprKind.StructLit(intern("Wrap"), finits))
    var targs = List.new<TypeRef>()
    targs.push(mtr_v("int32"))
    slit.type_args = targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("b"), null, slit_p)))
    val bv = mep(ExprKind.FieldAccess(mep(ExprKind.Variable(intern("b"))), intern("v")))
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(bv))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(box_td)
    m.decls.push(main_td)
    m.mono_module()
    assert_eq(m.has_decl("Wrap__int32"), true, "Wrap__int32 materialized")
    assert_eq(m.mod_has_template("Wrap"), false, "Wrap template stripped")
}

mutating fun Module.has_trait_decl(): bool {
    while decl in &self.decls {
        when (decl.kind) {
            TraitDecl(_, _, _) => return true
            _ => { }
        }
    }
    return false
}

// trait Show { fun show(): int32 }
fun mk_show_trait_mono(): TopDecl {
    val showk = TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), List.new<Stmt>(), true, false, false, false)
    val showm = new_top_decl(no_span(), String.from("show"), showk)
    var methods = List.new<TopDecl>()
    methods.push(showm)
    val k = TopDeclKind.TraitDecl(methods, true, List.new<TypeRef>())
    return new_top_decl(no_span(), String.from("Show"), k)
}

// impl Show for Point { fun show(): int32 { return 0 } }
fun mk_show_impl_mono(): TopDecl {
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(mep(ExprKind.LitInt(0))))))
    val showk = TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), body, true, false, false, false)
    val showm = new_top_decl(no_span(), String.from("show"), showk)
    var methods = List.new<TopDecl>()
    methods.push(showm)
    val tref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tref = TypeRef.new(no_span(), TypeRefKind.Named(intern("Show"), List.new<TypeRef>())) }
    val k = TopDeclKind.TraitImpl(tref, methods)
    return new_top_decl(no_span(), String.from("Point"), k)
}

@test fun trait_ref_arg_suffix_owns_generic_suffix(): void {
    var args = List.new<TypeRef>()
    args.push(mtr_v("int32"))
    val tref = TypeRef.new(no_span(), TypeRefKind.Named(intern("Show"), args))
    val m = new_module(List.new<String>())
    val suffix: String = trait_ref_arg_suffix(tref, &m)
    assert_eq(suffix.as_str(), "Show__int32", "generic trait suffix is owned String text")
}

@test fun mono_normalizes_concrete_trait_impl_to_implblock(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_show_trait_mono())
    m.decls.push(mk_show_impl_mono())
    m.mono_module()
    assert_eq(m.mod_has_impl("Point"), true, "trait impl normalized to a Point ImplBlock")
    assert_eq(m.has_trait_decl(), false, "TraitDecl stripped")
}

// A used Wrap<int32> materializes both the layout and the impl block.
@test fun mono_materializes_generic_inherent_impl(): void {
    val box_td = mk_box_decl()
    val box_impl = mk_box_impl_decl()
    var finits = List.new<FieldInit>()
    finits.push(FieldInit.new(no_span(), String.from("v"), mep(ExprKind.LitInt(7))))
    var slit = Expr.new(no_span(), ExprKind.StructLit(intern("Wrap"), finits))
    var targs = List.new<TypeRef>()
    targs.push(mtr_v("int32"))
    slit.type_args = targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("b"), null, slit_p)))
    val bv = mep(ExprKind.FieldAccess(mep(ExprKind.Variable(intern("b"))), intern("v")))
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(bv))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(box_td)
    m.decls.push(box_impl)
    m.decls.push(main_td)
    m.mono_module()
    assert_eq(m.has_decl("Wrap__int32"), true, "Wrap__int32 struct materialized")
    assert_eq(m.mod_has_impl("Wrap__int32"), true, "Wrap__int32 impl block materialized")
    assert_eq(m.mod_has_template("Wrap"), false, "Wrap templates (struct+impl) stripped")
}

@test fun mono_closes_transitively(): void {
    val box_td = mk_box_decl()
    val wrap_td = mk_wrap_decl()
    var cargs = List.new<Expr>()
    cargs.push(Expr.new(no_span(), ExprKind.LitInt(5)))
    var call = Expr.new(no_span(), ExprKind.Call(intern("wrap"), cargs))
    var targs = List.new<TypeRef>()
    targs.push(mtr_v("int32"))
    call.type_args = targs
    val call_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_p = call }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("b"), null, call_p)))
    val bv = mep(ExprKind.FieldAccess(mep(ExprKind.Variable(intern("b"))), intern("v")))
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(bv))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), mtr_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(box_td)
    m.decls.push(wrap_td)
    m.decls.push(main_td)
    m.mono_module()
    assert_eq(m.has_decl("wrap__int32"), true, "wrap__int32 materialized")
    assert_eq(m.has_decl("Wrap__int32"), true, "Wrap__int32 induced transitively")
}

@test fun mono_lit_int_unchanged(): void {
    var e = Expr.new(no_span(), ExprKind.LitInt(42))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "", "lit int leaves mangled_callee empty")
}

@test fun mono_variable_unchanged(): void {
    var e = Expr.new(no_span(), ExprKind.Variable(intern("x")))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "", "variable leaves mangled_callee empty")
}

@test fun mono_module_empty_runs_clean(): void {
    var m = Module {
        crate: crate_id_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    m.mono_module()
    assert_eq(m.decls.size() == 0, true, "empty module mono'd without error")
}

@test fun mono_non_generic_call_passes_through(): void {
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.Call(intern("foo"), args))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "foo", "non-generic call → bare name")
}

@test fun mono_keeps_a_callee_selected_before_materialization(): void {
    var e = Expr.new(no_span(), ExprKind.Call(intern("max"), List.new<Expr>()))
    e.type_args.push(mtr_v("Point"))
    e.mangled_callee = intern("max__aa__Point")
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "max__aa__Point", "Mono keeps the qualified callee chosen earlier")
}

@test fun mono_names_no_callee_for_an_intrinsic(): void {
    var e = Expr.new(no_span(), ExprKind.Intrinsic(Intrinsic.Alloc, List.new<Expr>()))
    e.type_args.push(mtr_v("Point"))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "", "codegen reads the type argument, not a name")
}

@test fun generic_call_base_returns_owned_str(): void {
    val base: String = generic_call_base("Wrap__Point")
    assert_eq(base.as_str(), "Wrap", "the instance's type arguments are cut off")
}

@test fun generic_call_base_keeps_a_crate_qualified_prefix(): void {
    assert_eq(generic_call_base("kf__c3__max__int32").as_str(), "kf__c3__max", "the fold starts after the crate")
}

// A non-generic call keeps its bare name.
@test fun mono_call_keeps_bare_name(): void {
    var args = List.new<Expr>()
    var arg = Expr.new(no_span(), ExprKind.LitInt(42))
    arg.ty = Type.new_int32(no_span())
    args.push(arg)
    var e = Expr.new(no_span(), ExprKind.Call(intern("identity"), args))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "identity", "identity(42) → bare identity")
}

fun mk_typed_arg_int32(n: int64): Expr {
    var a = Expr.new(no_span(), ExprKind.LitInt(n))
    a.ty = Type.new_int32(no_span())
    return a
}

fun mk_typed_arg_bool(b: bool): Expr {
    var a = Expr.new(no_span(), ExprKind.LitBool(b))
    a.ty = Type.new_bool(no_span())
    return a
}

@test fun mono_call_two_args_keeps_bare_name(): void {
    var args = List.new<Expr>()
    args.push(mk_typed_arg_int32(1))
    args.push(mk_typed_arg_bool(true))
    var e = Expr.new(no_span(), ExprKind.Call(intern("pair"), args))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "pair", "pair(1, true) → bare pair")
}

fun mk_struct_recv(sname: Sym): Expr {
    var r = Expr.new(no_span(), ExprKind.Variable(intern("xs")))
    r.ty = Type { kind: TypeKind.Struct(sname), provenance: Provenance.Inferred(no_span()) }
    return r
}

fun mk_int_recv(): Expr {
    var r = Expr.new(no_span(), ExprKind.LitInt(5))
    r.ty = Type.new_int32(no_span())
    return r
}

@test fun mono_method_call_on_struct_receiver(): void {
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = mk_struct_recv(intern("List__String")) }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("push"), args))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "List__String_push", "xs.push() → List__String_push")
}

@test fun mono_method_call_on_non_struct_leaves_empty(): void {
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = mk_int_recv() }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("foo"), args))
    e.mono_expr()
    assert_eq(e.mangled_callee.as_str(), "", "method on non-struct → empty")
}

// An impl's associated-type binding specializes like any other type:
// `type Out = T` in `impl Producer for Wrap<T>` becomes `type Out = int32`.

/// `impl Producer for Wrap<T> { type Out = T }` as a generic template.
fun mk_binding_template(): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocTypeBinding(mtr_p("T"))))
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.TraitImpl(mtr_p("Producer"), members))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    return td
}

/// The type `member_index` of `td` binds its associated type to, or a marker
/// naming what was found instead.
fun TopDecl.impl_binding_choice(member_index: uint64): String {
    when (self.kind) {
        TraitImpl(_tref, members) => return binding_choice_name(members.at(member_index))
        ImplBlock(members) => return binding_choice_name(members.at(member_index))
        _ => return String.from("<not an impl>")
    }
}

fun TopDecl.binding_choice_name(): String {
    when (self.kind) {
        AssocTypeBinding(chosen) => return tref_choice_name(unsafe { &*chosen })
        Poison => return String.from("<poisoned>")
        _ => return String.from("<not a binding>")
    }
}

fun TypeRef.tref_choice_name(): String {
    when (self.kind) {
        Named(n, _args) => return n.as_string()
        _ => return String.from("<other>")
    }
}

@test fun specializing_an_impl_substitutes_its_assoc_binding(): void {
    var args = List.new<TypeRef>()
    args.push(mtr_v("int32"))
    val inst = clone_subst_decl(mk_binding_template(), &args, String.from("Wrap__int32"))
    assert_eq(inst.impl_binding_choice(0).as_str(), "int32", "the instance records the substituted choice")
}

pub fun ret_op(p: Ptr<Expr>): Box<Expr>? {
    return p
}

@test fun retarget_rewrites_only_the_template_half(): void {
    assert_eq(retarget_callee_owner("Wrap_peek", "Wrap__int32").as_str(),
        "Wrap__int32_peek", "a self-call names the instance the body sits in")
    assert_eq(retarget_callee_owner("Wrap_next__Iterator__int32", "Wrap__int32").as_str(),
        "Wrap__int32_next__Iterator__int32", "the method tail keeps its trait identity")
}

@test fun retarget_leaves_a_foreign_or_settled_callee_alone(): void {
    assert_eq(retarget_callee_owner("String_clone", "Wrap__int32").as_str(),
        "String_clone", "another receiver's callee is already correct")
    assert_eq(retarget_callee_owner("Wrap__int32_peek", "Wrap__int32").as_str(),
        "Wrap__int32_peek", "an already-concrete callee is not rewritten twice")
    assert_eq(retarget_callee_owner("", "Wrap__int32").as_str(),
        "", "an unstamped callee is left for the receiver's type to name")
    assert_eq(retarget_callee_owner("bare", "Wrap__int32").as_str(),
        "bare", "a callee with no receiver half has nothing to retarget")
}
