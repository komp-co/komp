import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_mono.extract_struct_name
import kf_mono.mangle_method
import kf_core.ast.subst.monomorphized_type_name

fun mk_struct_ty(name: str, span: Span): Type {
    return Type { kind: TypeKind.Struct(intern(name)), provenance: Provenance.Inferred(span) }
}

mutating fun Expr.set_expr_ty(t: Type): void {
    self.ty = t
}

mutating fun Expr.set_expr_mangled(s: str): void {
    self.mangled_callee = intern(s)
}

/// A use-site generic Call/StructLit: the monomorphized callee name and, for a
/// StructLit, the concrete `.ty`, from the concrete type_args.
mutating fun Expr.apply_generic_mangle(name: str, is_struct_lit: bool): void {
    val mn = monomorphized_type_name(String.from(name), &self.type_args)
    if is_struct_lit {
        self.set_expr_ty(mk_struct_ty(mn.as_str(), self.span))
    }
    self.set_expr_mangled(mn.as_str())
}

/// A body outside any impl block.
pub mutating fun Expr.mono_expr(): void {
    mono_expr_in(self, "")
}

/// `owner` is the concrete impl block the body lives in (`Wrap__int32`), empty
/// at the top level; the body itself still names `self` by the template's name.
pub fun mono_expr_in(e: &var Expr, owner: str): void {
    when (e.kind) {
        LitInt(_) => return
        LitStr(_) => return
        LitFloat(_) => return
        LitChar(_) => return
        LitBool(_) => return
        Variable(_) => return
        Binary(lhs_ptr, _, rhs_ptr) => {
            mono_expr_in(unsafe { &var *lhs_ptr }, owner)
            mono_expr_in(unsafe { &var *rhs_ptr }, owner)
        }
        Unary(_, inner_ptr) => {
            mono_expr_in(unsafe { &var *inner_ptr }, owner)
        }
        Deref(inner_ptr) => {
            mono_expr_in(unsafe { &var *inner_ptr }, owner)
        }
        Call(name_sym, args) => {
            mono_args(args, owner)
            // `id<int32>(x)` becomes `id__int32`, from the substituted type
            // args. A non-generic call keeps its bare name.
            val n_ta: uint64 = e.type_args.size()
            if n_ta > 0 {
                if e.mangled_callee.as_str() == "" {
                    val base = generic_call_base(name_sym.as_str())
                    e.apply_generic_mangle(base.as_str(), false)
                }
            } else {
                e.mangled_callee = intern(name_sym.as_str())
            }
        }
        MethodCall(recv_ptr, method_sym, args) => {
            val method = method_sym.as_str()
            mono_expr_in(unsafe { &var *recv_ptr }, owner)
            mono_args(args, owner)
            if e.is_dynamic_call { return }
            // TypeCheck already mangled a static call; its type-name receiver
            // is typed poison, so there is nothing to recompute from.
            if e.is_static_call { return }
            val recv = unsafe { *recv_ptr }
            val struct_name = extract_struct_name(recv.ty)
            val sname_str = struct_name.as_str()
            val empty = sname_str.equals("")
            // A call on `self` in a materialized impl still names the template
            // (`Wrap_peek`). Retarget the receiver half to the instance and
            // keep the method tail, which may carry trait identity
            // (`_next__Iterator__int32`).
            if !owner.equals("") {
                e.mangled_callee = intern(retarget_callee_owner(e.mangled_callee.as_str(), owner).as_str())
            }
            if !empty && e.mangled_callee.as_str().equals("") {
                // Same type-arg suffix materialize_impl_method gave the
                // specialization: `t.draw<DrawProbe>(..)` is
                // `Terminal_draw__DrawProbe`. Both go through
                // monomorphized_type_name.
                var method_seg = String.from(method)
                if e.type_args.size() > 0 {
                    method_seg = monomorphized_type_name(method_seg, &e.type_args)
                }
                val mangled = mangle_method(struct_name.as_str(), method_seg.as_str())
                e.mangled_callee = intern(mangled.as_str())
            }
        }
        FieldAccess(obj_ptr, _) => {
            mono_expr_in(unsafe { &var *obj_ptr }, owner)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            mono_expr_in(unsafe { &var *c_ptr }, owner)
            mono_expr_in(unsafe { &var *t_ptr }, owner)
            mono_expr_in(unsafe { &var *e_ptr }, owner)
        }
        WhenExpr(subj_ptr, arms) => {
            mono_expr_in(unsafe { &var *subj_ptr }, owner)
            while i in 0..arms.size() {
                val arm = arms.at_mut(i)
                when (arm.guard) {
                    Some(guard) => mono_expr_in(unsafe { &var *guard }, owner)
                    None => { }
                }
                mono_stmt_list_in(&var arm.body, owner)
            }
        }
        StructLit(name_sym, fields) => {
            while fi in &fields {
                val vp = fi.value
                mono_expr_in(unsafe { &var *vp }, owner)
            }
            // `Box<int32>{...}`: the name and `.ty` are recomputed from the
            // substituted type args, so Lower emits `Box__int32_drop` rather
            // than the template's `Box__T_drop`.
            val n_ta: uint64 = e.type_args.size()
            if n_ta > 0 {
                e.apply_generic_mangle(name_sym.as_str(), true)
            }
        }
        Cast(inner_ptr, _) => {
            mono_expr_in(unsafe { &var *inner_ptr }, owner)
        }
        DynCoerce(inner_ptr, _) => {
            mono_expr_in(unsafe { &var *inner_ptr }, owner)
        }
        Retain(_) => return
        Release(_) => return
        Lambda(_, _) => return
        Block(stmts) => {
            while i in 0..stmts.size() {
                (stmts.at_mut(i)).mono_stmt_in(owner)
            }
            return
        }
        Poison => return
    }
}

// Memory intrinsics are already folded to `alloc__T` by the parser; Mono
// replaces that tail rather than appending to it.
fun generic_call_base(name: str): String {
    // A crate-qualified name keeps its prefix; the fold starts after it.
    if qualified_generic_crate(name) >= 0 {
        val plain = qualified_generic_name(name)
        val prefix = name.substring(0, name.byte_len() - plain.byte_len())
        return prefix + generic_call_base(plain.as_str())
    }
    val length = name.byte_len()
    var i: uint64 = 0
    while i + 1 < length {
        if name.byte_at(i) == 95 {
            if name.byte_at(i + 1) == 95 {
                val prefix = name.substring(0, i)
                return String.from(prefix.as_str())
            }
        }
        i = i + 1
    }
    return String.from(name)
}

/// `Wrap_peek` inside `Wrap__int32` becomes `Wrap__int32_peek`. Callees on
/// other receivers, already-concrete ones and "" are left alone. Splits at
/// the first single `_`: `__` is the mangle's compound delimiter.
fun retarget_callee_owner(callee: str, owner: str): String {
    val n = callee.byte_len()
    if n == 0 { return String.from(callee) }
    var boundary: uint64 = n
    var i = 0
    while i < n {
        if callee.byte_at(i) == 95 {
            if i + 1 < n && callee.byte_at(i + 1) == 95 {
                i = i + 2
            } else {
                boundary = i
                i = n
            }
        } else {
            i = i + 1
        }
    }
    if boundary == n { return String.from(callee) }
    val prefix = callee.substring(0, boundary)
    val base = generic_call_base(owner)
    if !prefix.as_str().equals(base.as_str()) { return String.from(callee) }
    if prefix.as_str().equals(owner) { return String.from(callee) }
    val tail = callee.substring(boundary, n)
    var out = String.from(owner)
    out.append(tail.as_str())
    return out
}

fun mono_args(args: &var List<Expr>, owner: str): void {
    while i in 0..args.size() {
        // CONSTRAINT: mutate in place through at_mut. A get/set round-trip
        // drops the old element while the copy still aliases its buffers.
        mono_expr_in(args.at_mut(i), owner)
    }
}
