import alloc.list.*

import kf_core.ast.*
import kf_typecheck.*
import kf_typecheck.types.resolved_projection_type
import kf_typecheck.check.decl.assoc_projection_registry
import kf_core.span.no_span
import kf_core.ast.dyn_meta.*

pub mutating fun Module.mono_dyn_metadata(): void {
    val projections = assoc_projection_registry(self)
    while i in 0..self.decls.size() {
        normalize_dyn_decl(self.decls.at_mut(i), "", projections)
    }
}

mutating fun TopDecl.normalize_dyn_decl(self_name: str, projections: Ptr<SigTable>): void {
    // CONSTRAINT: an independent copy. Replacing self.dyn_layouts frees its old
    // buffer, which a shallow copy would still read.
    val old_layouts = clone_dyn_layout_list(&self.dyn_layouts)
    var layouts = List.new<DynTraitLayout>()
    while old_layout in &old_layouts {
        val normalized = normalize_dyn_layout(old_layout, self_name, projections)
        if !dyn_layout_list_has(&layouts, normalized.identity) { layouts.push(normalized) }
    }
    self.dyn_layouts = layouts

    var tables = List.new<DynVTableInstance>()
    while dyn_vtable in &self.dyn_vtables {
        val normalized = normalize_dyn_vtable(dyn_vtable, &old_layouts, &self.dyn_layouts, self_name, projections)
        if !dyn_vtable_list_has(&tables, normalized.layout, normalized.receiver_identity) { tables.push(normalized) }
    }
    self.dyn_vtables = tables

    when (self.kind) {
        ImplBlock(members) => normalize_dyn_members(members, self.name.as_str(), projections)
        TraitImpl(_, members) => normalize_dyn_members(members, self.name.as_str(), projections)
        TraitDecl(members, _, _) => normalize_dyn_members(members, "", projections)
        _ => { }
    }
}

fun normalize_dyn_members(members: &var List<TopDecl>, self_name: str, projections: Ptr<SigTable>): void {
    while i in 0..members.size() {
        normalize_dyn_decl(members.at_mut(i), self_name, projections)
    }
}

fun normalize_dyn_layout(layout: DynTraitLayout, self_name: str, projections: Ptr<SigTable>): DynTraitLayout {
    var args = List.new<Type>()
    val type_args = new_type_vec()
    while arg in &layout.args {
        val argument = resolved_projection_type(arg, self_name, projections)
        args.push(argument.clone())
        type_args.push(argument)
    }
    val dynamic = dyn_trait_type(layout.principal, type_args, no_span())
    var methods = List.new<DynMethodSlot>()
    while method in &layout.methods {
        var params = List.new<Type>()
        while pi in 0..method.params.size() {
            params.push(resolved_projection_type(method.params.at(pi), self_name, projections))
        }
        methods.push(DynMethodSlot {
            name: method.name, params: params,
            ret: resolved_projection_type(&method.ret, self_name, projections),
            is_mutating: method.is_mutating, slot: method.slot
        })
    }
    return DynTraitLayout {
        identity: dyn_trait_identity(&dynamic), principal: layout.principal, args: args,
        methods: methods, owner: layout.owner, imported: layout.imported
    }
}

fun normalize_dyn_vtable(table: DynVTableInstance, old_layouts: &List<DynTraitLayout>, layouts: &List<DynTraitLayout>, self_name: str, projections: Ptr<SigTable>): DynVTableInstance {
    val receiver = resolved_projection_type(&table.receiver, self_name, projections)
    val receiver_identity = receiver.mono_dyn_receiver_identity()
    var layout_identity = table.layout
    while old_layout in &old_layouts {
        if old_layout.identity.id == table.layout.id {
            val normalized = normalize_dyn_layout(old_layout, self_name, projections)
            layout_identity = normalized.identity
        }
    }
    val symbol_text = "DynVTableInstance__${receiver_identity.as_str()}__${layout_identity.as_str()}"
    return DynVTableInstance {
        layout: layout_identity, receiver: receiver, receiver_identity: receiver_identity,
        symbol: intern(symbol_text.as_str()), adapters: clone_dyn_sym_list(&table.adapters),
        owner: table.owner, linkage: table.linkage
    }
}

fun Type.mono_dyn_receiver_identity(): Sym {
    return when (self.kind) {
        Struct(identity) => identity
        EnumTy(identity) => identity
        _ => intern(ty_to_mangle(self.clone()).as_str())
    }
}

pub fun clone_dyn_sym_list(source: &List<Sym>): List<Sym> {
    var result = List.new<Sym>()
    while item in &source {
        result.push(item)
    }
    return result
}

fun dyn_layout_list_has(layouts: &List<DynTraitLayout>, identity: Sym): bool {
    while layout in &layouts {
        if layout.identity.id == identity.id { return true }
    }
    return false
}

fun dyn_vtable_list_has(tables: &List<DynVTableInstance>, layout: Sym, receiver: Sym): bool {
    while table in &tables {
        if table.layout.id == layout.id && table.receiver_identity.id == receiver.id { return true }
    }
    return false
}

pub fun Module.assert_dyn_metadata_concrete(): void {
    while decl in &self.decls {
        decl.assert_dyn_decl_concrete()
    }
}

fun TopDecl.assert_dyn_decl_concrete(): void {
    while layout in &self.dyn_layouts {
        while arg in &layout.args {
            arg.assert_dyn_type_concrete()
        }
        while method in &layout.methods {
            while param in &method.params {
                param.assert_dyn_type_concrete()
            }
            method.ret.assert_dyn_type_concrete()
        }
    }
    while dyn_vtable in &self.dyn_vtables {
        dyn_vtable.receiver.assert_dyn_type_concrete()
    }
    when (self.kind) {
        Function(_, _, body, _, _, _, _) => assert_dyn_stmt_list_concrete(&body)
        ImplBlock(members) => assert_dyn_member_list_concrete(&members)
        TraitImpl(_, members) => assert_dyn_member_list_concrete(&members)
        TraitDecl(members, _, _) => assert_dyn_member_list_concrete(&members)
        _ => { }
    }
}

fun assert_dyn_member_list_concrete(members: &List<TopDecl>): void {
    while member in &members {
        member.assert_dyn_decl_concrete()
    }
}

fun Type.assert_dyn_type_concrete(): void {
    when (self.kind) {
        Generic(_) => unsafe { panic("unresolved generic in dynamic trait metadata") }
        Projection(_, _) => unsafe { panic("unresolved generic in dynamic trait metadata") }
        PtrTo(inner) => assert_dyn_type_concrete(unsafe { &*inner })
        BoxOf(inner) => assert_dyn_type_concrete(unsafe { &*inner })
        RefTo(_, inner) => assert_dyn_type_concrete(unsafe { &*inner })
        DynTraitTy(_) => {
            val args = dyn_trait_args(self)
            var i = 0
            while i < unsafe { args.size() } {
                val argument = unsafe { args.get(i) }
                argument.assert_dyn_type_concrete()
                i = i + 1
            }
        }
        _ => { }
    }
}

fun assert_dyn_stmt_list_concrete(stmts: &List<Stmt>): void {
    while stmt in &stmts {
        (stmt).assert_dyn_stmt_concrete()
    }
}

fun assert_dyn_opt_expr_concrete(value: Ptr<Expr>?): void {
    val p = value ?: return
    assert_dyn_expr_concrete(unsafe { &*p })
}

fun Stmt.assert_dyn_stmt_concrete(): void {
    when (self.kind) {
        LetVal(_, _, value) => assert_dyn_opt_expr_concrete(value.view())
        LetVar(_, _, value) => assert_dyn_opt_expr_concrete(value.view())
        Assign(_, value) => assert_dyn_expr_concrete(unsafe { &*value })
        AssignTo(place, value) => { assert_dyn_expr_concrete(unsafe { &*place }); assert_dyn_expr_concrete(unsafe { &*value }) }
        Return(value) => when (value) {
            Some(inner) => assert_dyn_expr_concrete(unsafe { &*inner })
            None => { }
        }
        If(condition, then_body, else_body) => { assert_dyn_expr_concrete(unsafe { &*condition }); assert_dyn_stmt_list_concrete(&then_body); assert_dyn_stmt_list_concrete(&else_body) }
        While(condition, body) => { assert_dyn_expr_concrete(unsafe { &*condition }); assert_dyn_stmt_list_concrete(&body) }
        Expression(value) => assert_dyn_expr_concrete(unsafe { &*value })
        When(subject, arms) => {
            assert_dyn_expr_concrete(unsafe { &*subject })
            while arm in &arms {
                assert_dyn_opt_expr_concrete(arm.guard.view())
                assert_dyn_stmt_list_concrete(&arm.body)
            }
        }
        Switch(subject, arms) => {
            assert_dyn_expr_concrete(unsafe { &*subject })
            while arm in &arms {
                assert_dyn_opt_expr_concrete(arm.guard.view())
                assert_dyn_stmt_list_concrete(&arm.body)
            }
        }
        _ => { }
    }
}

fun Expr.assert_dyn_expr_concrete(): void {
    when (self.kind) {
        DynCoerce(inner, _) => { self.ty.assert_dyn_type_concrete(); assert_dyn_type_concrete(unsafe { &inner.ty }); assert_dyn_expr_concrete(unsafe { &*inner }) }
        MethodCall(receiver, _, args) => {
            if self.is_dynamic_call { self.ty.assert_dyn_type_concrete(); assert_dyn_type_concrete(unsafe { &receiver.ty }) }
            assert_dyn_expr_concrete(unsafe { &*receiver })
            var i = 0
            while i < args.size() { assert_dyn_expr_concrete(args.at(i)); i = i + 1 }
        }
        Binary(left, _, right) => { assert_dyn_expr_concrete(unsafe { &*left }); assert_dyn_expr_concrete(unsafe { &*right }) }
        Unary(_, inner) => assert_dyn_expr_concrete(unsafe { &*inner })
        Deref(inner) => assert_dyn_expr_concrete(unsafe { &*inner })
        Call(_, args) => { var i: uint64 = 0; while i < args.size() { assert_dyn_expr_concrete(args.at(i)); i = i + 1 } }
        FieldAccess(inner, _) => assert_dyn_expr_concrete(unsafe { &*inner })
        IfExpr(condition, then_value, else_value) => { assert_dyn_expr_concrete(unsafe { &*condition }); assert_dyn_expr_concrete(unsafe { &*then_value }); assert_dyn_expr_concrete(unsafe { &*else_value }) }
        StructLit(_, fields) => {
            var i = 0
            while i < fields.size() { assert_dyn_expr_concrete(unsafe { &*fields.at(i).value }); i = i + 1 }
        }
        Cast(inner, _) => assert_dyn_expr_concrete(unsafe { &*inner })
        Retain(inner) => assert_dyn_expr_concrete(unsafe { &*inner })
        _ => { }
    }
}
