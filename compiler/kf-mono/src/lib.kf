// Materializes generic instances, then writes `mangled_callee` onto every
// Call and MethodCall. Emits no diagnostics.

import kf_core.ast.*
import kf_mono.materialize.materialize_generics
import kf_mono.collect.mono_stmt_list_in

pub mutating fun Module.mono_module(): void {
    self.materialize_generics()
    self.assert_dyn_metadata_concrete()
    while i in 0..self.decls.size() {
        mono_top_decl(self.decls.at_mut(i), "")
    }
}

/// `owner` is the impl block a method body sits in, empty for a free function.
mutating fun TopDecl.mono_top_decl(owner: str): void {
    when (self.kind) {
        Function(_, _, body, _, _, _, _) => {
            mono_stmt_list_in(&var body, owner)
        }
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                mono_top_decl(methods.at_mut(i), self.name.as_str())
            }
        }
        _ => { }
    }
}
