import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.dyn_meta.*
import kf_mono.materialize.clone_subst_decl

fun mono_dyn_generic(): Type {
    return Type.new_generic(String.from("T"), no_span())
}

fun mono_dyn_object(): Type {
    var args = List.new<Type>()
    args.push(mono_dyn_generic())
    return dyn_trait_type(intern("Sink"), args, no_span())
}

fun mono_dyn_ref(): Type {
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = mono_dyn_object() }
    return Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Declared(no_span()) }
}

fun mono_dyn_template(): TopDecl {
    var source = Expr.new(no_span(), ExprKind.Variable(intern("box")))
    source.ty = Type { kind: TypeKind.Struct(intern("Box__T")), provenance: Provenance.Declared(no_span()) }
    val source_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *source_ptr = source }
    var coercion = Expr.new(no_span(), ExprKind.DynCoerce(source_ptr, intern("DynVTableInstance__Box__T__Sink__T")))
    coercion.ty = mono_dyn_ref()
    val coercion_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *coercion_ptr = coercion }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("object"), null, coercion_ptr)))

    var receiver = Expr.new(no_span(), ExprKind.Variable(intern("object")))
    receiver.ty = mono_dyn_ref()
    val receiver_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *receiver_ptr = receiver }
    var call = Expr.new(no_span(), ExprKind.MethodCall(receiver_ptr, intern("send"), List.new<Expr>()))
    call.ty = mono_dyn_generic()
    call.is_dynamic_call = true
    call.dynamic_slot = 0
    call.dynamic_layout = intern("Sink__T")
    val call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_ptr = call }
    body.push(Stmt.new(no_span(), StmtKind.Expression(call_ptr)))

    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    var decl = new_top_decl(no_span(), String.from("use_sink"), TopDeclKind.Function(List.new<Param>(), ret, body, true, false, false, false))
    decl.generics.push(new_type_param(no_span(), String.from("T")))
    var slot_params = List.new<Type>()
    slot_params.push(mono_dyn_generic())
    var methods = List.new<DynMethodSlot>()
    methods.push(DynMethodSlot { name: intern("send"), params: slot_params, ret: mono_dyn_generic(), is_mutating: false, slot: 0 })
    var layout_args = List.new<Type>()
    layout_args.push(mono_dyn_generic())
    val layout = DynTraitLayout { identity: intern("Sink__T"), principal: intern("Sink"), args: layout_args, methods: methods, owner: crate_id_poison(), imported: false }
    val layout_copy = clone_dyn_trait_layout(&layout)
    decl.dyn_layouts.push(layout)
    decl.dyn_layouts.push(layout_copy)
    var adapters = List.new<Sym>()
    adapters.push(intern("Box__T_send"))
    val table = DynVTableInstance {
        layout: intern("Sink__T"), receiver: Type { kind: TypeKind.Struct(intern("Box__T")), provenance: Provenance.Declared(no_span()) },
        receiver_identity: intern("Box__T"), symbol: intern("DynVTableInstance__Box__T__Sink__T"), adapters: adapters,
        owner: crate_id_poison(), linkage: linkage_source()
    }
    val table_copy = clone_dyn_vtable_instance(&table)
    decl.dyn_vtables.push(table)
    decl.dyn_vtables.push(table_copy)
    return decl
}

fun mono_dyn_materialized(): TopDecl {
    val template = mono_dyn_template()
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    var module = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    module.decls.push(clone_subst_decl(template, &args, String.from("use_sink__int32")))
    module.mono_dyn_metadata()
    module.assert_dyn_metadata_concrete()
    return *module.decls.at(0)
}

@test fun dyn_trait_mono_recomputes_layout_identity(): void {
    val decl = mono_dyn_materialized()
    assert_eq(decl.dyn_layouts.at(0).identity.as_str(), "Sink__int32", "dynamic layout identity is concrete")
}

@test fun dyn_trait_mono_recomputes_vtable_pair(): void {
    val decl = mono_dyn_materialized()
    val table = *decl.dyn_vtables.at(0)
    assert_eq(table.receiver_identity.as_str() == "Box__int32" && table.layout.as_str() == "Sink__int32", true, "vtable pair is concrete")
}

@test fun dyn_trait_mono_deduplicates_metadata(): void {
    val decl = mono_dyn_materialized()
    assert_eq(decl.dyn_layouts.size() == 1 && decl.dyn_vtables.size() == 1, true, "concrete dynamic metadata is deduplicated")
}

@test fun dyn_trait_mono_substitutes_adapter_symbol(): void {
    val decl = mono_dyn_materialized()
    assert_eq(decl.dyn_vtables.at(0).adapters.get(0).as_str(), "Box__int32_send", "vtable adapter names are concrete")
}

@test fun dyn_trait_mono_substitutes_layout_slot_types(): void {
    val decl = mono_dyn_materialized()
    val slot = *decl.dyn_layouts.at(0).methods.at(0)
    when (slot.params.at(0).kind) {
        Int32 => when (slot.ret.kind) {
            Int32 => assert_eq(true, true, "slot parameter and result are concrete")
            _ => assert_eq(false, true, "slot result remains generic")
        }
        _ => assert_eq(false, true, "slot parameter remains generic")
    }
}

@test fun dyn_trait_mono_substitutes_coercion_and_call_symbols(): void {
    val decl = mono_dyn_materialized()
    when (decl.kind) {
        Function(_, _, body, _, _, _, _) => {
            val first = *body.at(0)
            val second = *body.at(1)
            when (first.kind) {
                LetVal(_, _, init) => when (unsafe { (init!!).kind }) {
                    DynCoerce(_, vtable) => when (second.kind) {
                        Expression(call) => assert_eq(vtable.as_str() == "DynVTableInstance__Box__int32__Sink__int32" && unsafe { call.dynamic_layout.as_str() } == "Sink__int32" && mono_dyn_ref_argument_is_int32(unsafe { &(init!!).ty }) && mono_dyn_type_is_int32(unsafe { &call.ty }), true, "coercion and call metadata is concrete")
                        _ => assert_eq(false, true, "expected dynamic call")
                    }
                    _ => assert_eq(false, true, "expected dynamic coercion")
                }
                _ => assert_eq(false, true, "expected local binding")
            }
        }
        _ => assert_eq(false, true, "expected materialized function")
    }
}

fun Type.mono_dyn_type_is_int32(): bool {
    when (self.kind) {
        Int32 => return true
        _ => return false
    }
}

fun Type.mono_dyn_ref_argument_is_int32(): bool {
    when (self.kind) {
        RefTo(_, object) => {
            val args = dyn_trait_args(unsafe { &*object })
            if unsafe { args.size() } != 1 { return false }
            val argument = unsafe { args.get(0) }
            return argument.mono_dyn_type_is_int32()
        }
        _ => return false
    }
}
