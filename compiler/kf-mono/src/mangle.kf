// `__` separates a template name from its type args; `_` separates a type
// from a method name.
//
//   List<String>               -> "List__String"
//   xs.push(d) on List__String -> "List__String_push"
//   List.new<int32>()          -> "new_list__int32"

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.types.type_identity_display
import kf_core.ast.dyn_meta.dyn_trait_identity

pub fun mangle_struct_name(name: str, args: List<Type>): String {
    var result = String.from(name)
    while a in &args {
        val arg_name = ty_to_mangle(a)
        result.append("__")
        result.append(arg_name.as_str())
    }
    return result
}

pub fun mangle_method(struct_mangle: str, method: str): String {
    var result = String.from(struct_mangle)
    result.append("_")
    result.append(method)
    return result
}

pub fun mangle_fn_call(callee: str, type_args: List<Type>): String {
    var result = String.from(callee)
    while a in &type_args {
        val arg_name = ty_to_mangle(a)
        result.append("__")
        result.append(arg_name.as_str())
    }
    return result
}

/// "" unless the type is a struct, or a primitive or pointer whose method
/// mangles through one.
pub fun extract_struct_name(t: Type): String {
    val tk = t.kind
    return when (tk) {
        Struct(n) => type_identity_display(n)
        // Primitives whose methods mangle by name: `str_equals`, `int64_equals`.
        StrTy => String.from("str")
        Int64 => String.from("int64")
        // Pointers and borrows dispatch on the pointee, as typecheck autoderefs.
        PtrTo(p) => extract_struct_name(unsafe { *p })
        BoxOf(p) => extract_struct_name(unsafe { *p })
        RefTo(_, p) => extract_struct_name(unsafe { *p })
        _ => ""
    }
}

pub fun ty_to_mangle(t: Type): String {
    val tk = t.kind
    when (tk) {
        Int8 => return String.from("int8")
        Int16 => return String.from("int16")
        Int32 => return String.from("int32")
        Int64 => return String.from("int64")
        UInt8 => return String.from("uint8")
        UInt16 => return String.from("uint16")
        UInt32 => return String.from("uint32")
        UInt64 => return String.from("uint64")
        Float32 => return String.from("float32")
        Float64 => return String.from("float64")
        Bool => return String.from("bool")
        Char => return String.from("char")
        StrTy => return String.from("str")
        Void => return String.from("void")
        Never => return String.from("never")
        Struct(n) => return type_identity_display(n)
        EnumTy(n) => return type_identity_display(n)
        TraitTy(n) => return type_identity_display(n)
        DynTraitTy(_) => return dyn_trait_identity(&t).as_string()
        Generic(n) => return String.from(n.as_str())
        PtrTo(p) => {
            val inner = unsafe { *p }
            val inner_name = ty_to_mangle(inner)
            var result = String.from("Ptr__")
            result.append(inner_name.as_str())
            return result
        }
        BoxOf(p) => {
            val inner = unsafe { *p }
            val inner_name = ty_to_mangle(inner)
            var result = String.from("Box__")
            result.append(inner_name.as_str())
            return result
        }
        RefTo(is_mut, p) => {
            val inner = unsafe { *p }
            val inner_name = ty_to_mangle(inner)
            return borrow_frag(is_mut, inner_name.as_str())
        }
        FnTy(_) => {
            val parts = t.fn_parts() ?: return String.from("poison")
            var params = List.new<String>()
            while param in &parts.params {
                params.push(ty_to_mangle(param))
            }
            return fn_frag(&params, ty_to_mangle(parts.ret).as_str())
        }
        // Still unresolved; keeping owner and member apart lets substitution
        // finish it later.
        Projection(owner, member) => {
            val inner = ty_to_mangle(unsafe { *owner })
            return projection_mangle_frag(inner.as_str(), member.as_str())
        }
        Value(v) => return value_frag(v)
        Poison => return String.from("poison")
    }
}
