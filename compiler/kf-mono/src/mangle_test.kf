import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.*

@test fun mangle_struct_name_no_args(): void {
    val name: String = mangle_struct_name("Foo", List.new<Type>())
    assert_eq(name.as_str(), "Foo", "no args → bare name")
}

@test fun mangle_struct_name_single_primitive(): void {
    var args = List.new<Type>()
    args.push(Type.new_int32(no_span()))
    val name: String = mangle_struct_name("List", args)
    assert_eq(name.as_str(), "List__int32", "List<int32>")
}

@test fun mangle_struct_name_nested(): void {
    val inner = Type { kind: TypeKind.Struct(intern("List__String")), provenance: Provenance.Inferred(no_span()) }
    var args = List.new<Type>()
    args.push(inner)
    val name: String = mangle_struct_name("List", args)
    assert_eq(name.as_str(), "List__List__String", "List<List<String>>")
}

@test fun mangle_method_simple(): void {
    val name: String = mangle_method("List__String", "push")
    assert_eq(name.as_str(), "List__String_push", "List<String>.push")
}

@test fun mangle_fn_call_with_one_arg(): void {
    var ta = List.new<Type>()
    ta.push(Type.new_int32(no_span()))
    val name: String = mangle_fn_call("new_list", ta)
    assert_eq(name.as_str(), "new_list__int32", "List.new<int32>")
}

@test fun mangle_fn_call_no_type_args(): void {
    val name: String = mangle_fn_call("foo", List.new<Type>())
    assert_eq(name.as_str(), "foo", "non-generic fn → bare name")
}

@test fun extract_struct_name_from_struct(): void {
    val t = Type { kind: TypeKind.Struct(intern("List__String")), provenance: Provenance.Inferred(no_span()) }
    val n: String = extract_struct_name(t)
    assert_eq(n.as_str(), "List__String", "Struct gives its name")
}

@test fun extract_struct_name_hides_canonical_identity(): void {
    val identity = TypeIdentity.new(new_crate_id("kf_core"), intern("span"), intern("SourceMap"))
    val t = named_struct_ty(identity, no_span())
    val n: String = extract_struct_name(t)
    assert_eq(n.as_str(), "SourceMap", "C name omits semantic identity")
}

@test fun extract_struct_name_from_int_is_empty(): void {
    val t = Type.new_int32(no_span())
    val n: String = extract_struct_name(t)
    assert_eq(n.as_str(), "", "non-Struct gives empty string")
}

@test fun ty_to_mangle_primitive(): void {
    val n: String = ty_to_mangle(Type.new_int32(no_span()))
    assert_eq(n.as_str(), "int32", "int32 mangle")
}

@test fun ty_to_mangle_string(): void {
    val n: String = ty_to_mangle(intern("String").lang_struct_ty(no_span()))
    assert_eq(n.as_str(), "String", "String mangle")
}

@test fun ty_to_mangle_hides_canonical_identity(): void {
    val identity = TypeIdentity.new(new_crate_id("kf_core"), intern("span"), intern("SourceMap"))
    val n: String = ty_to_mangle(named_struct_ty(identity, no_span()))
    assert_eq(n.as_str(), "SourceMap", "type mangle omits semantic identity")
}
