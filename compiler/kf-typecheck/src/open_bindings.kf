// An unannotated binding whose initializer leaves its type open (a number
// literal, `null`, `List.new()`) is decided by its uses. The first use needing
// a type of its own decides it, and a later use needing another conflicts.
// Decided after earlier uses, which were checked against the provisional type,
// the body is checked again with the type in place, as if written.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.span.*

/// A type a use decided, for the body's next check. The binding is found by
/// its initializer, which a fresh copy of the body keeps.
@derive(Clone)
pub struct OpenDecision {
    pub val init: Span
    pub val ty: Type
    pub val decided_at: Span
}

impl TypeCtx {
    /// The innermost binding named `name`.
    fun binding_index(name: str): uint64? {
        var i: uint64 = self.locals.size()
        while i > 0 {
            i = i - 1
            if self.locals.at(i).name.as_str() == name { return i }
        }
        return null
    }

    /// The binding's initializer while its type is open.
    pub fun open_init(name: str): Ptr<Expr>? {
        val i = self.binding_index(name) ?: return null
        return self.locals.at(i).flexible_init
    }

    /// How many places have read the binding.
    pub fun binding_uses(name: str): uint64 {
        val i = self.binding_index(name) ?: return 0
        return self.locals.at(i).uses
    }

    /// The use that decided the binding, or `no_span()`.
    pub fun binding_decided_at(name: str): Span {
        val i = self.binding_index(name) ?: return no_span()
        return self.locals.at(i).decided_at
    }

    /// The first use that narrowed the binding without deciding it, or
    /// `no_span()`.
    pub fun binding_narrowed_at(name: str): Span {
        val i = self.binding_index(name) ?: return no_span()
        return self.locals.at(i).narrowed_at
    }

    /// Records the use at `at` as narrowing the binding, unless one already did.
    pub mutating fun narrow_binding(name: str, at: Span): void {
        val i = self.binding_index(name) ?: return
        val binding = self.locals.at_mut(i)
        if binding.narrowed_at.is_none() { binding.narrowed_at = at }
    }

    /// Closes the binding as `ty`, decided by the use at `at`.
    pub mutating fun decide_binding(name: str, ty: Type, at: Span): void {
        val i = self.binding_index(name) ?: return
        val binding = self.locals.at_mut(i)
        binding.ty = ty
        binding.flexible_init = null
        binding.decided_at = at
    }

    /// Decides the binding, and has the body checked again with `ty` at its
    /// initializer, since earlier uses saw the provisional type.
    pub mutating fun decide_binding_on_recheck(name: str, init: Span, ty: Type, at: Span): void {
        self.decisions.push(OpenDecision { init: init, ty: ty.clone(), decided_at: at })
        self.decide_binding(name, ty, at)
    }

    /// What an earlier check of this body decided for the binding initialized
    /// at `init`.
    pub fun preset_for(init: Span): OpenDecision? {
        while preset in &self.presets {
            if preset.init.same_as(init) { return preset.clone() }
        }
        return null
    }

    /// A binding a previous check decided, declared as it was.
    pub mutating fun declare_decided(name: String, preset: &OpenDecision, is_var: bool): void {
        if is_var {
            self.declare(name.clone(), preset.ty.clone())
        } else {
            self.declare_val(name.clone(), preset.ty.clone())
        }
        val i = self.binding_index(name.as_str()) ?: return
        self.locals.at_mut(i).decided_at = preset.decided_at
    }
}
