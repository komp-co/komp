import kf_core.ast.types.Type

impl SigTable {
    pub mutating fun note_fn_type(t: &Type): void {
        val frag = t.mangle_frag()
        if self.fn_type_for(frag.as_str()) != null { return }
        self.fn_types.push(*t)
    }

    /// The function type a mangle fragment names, if one was met.
    pub fun fn_type_for(frag: str): Type? {
        while t in &self.fn_types {
            if t.mangle_frag().as_str() == frag { return t }
        }
        return null
    }
}

impl TypeCtx {
    pub mutating fun note_fn_type(t: &Type): void {
        unsafe { (*self.sigs).note_fn_type(t) }
    }

    pub fun fn_type_for(frag: str): Type? {
        return unsafe { (*self.sigs).fn_type_for(frag) }
    }
}
