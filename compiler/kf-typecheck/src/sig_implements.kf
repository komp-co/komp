// Whether a type implements a trait. A receiver may be named by canonical
// identity (`crate::module::Name`) or by the display name an impl registers
// under, and each must find the other; a monomorphized instance
// (`Box2__int32`) matches its template's impl (`Box2`) via `mangle_base_name`.

import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.*
import kf_typecheck.traits.trait_args_satisfy
import kf_typecheck.check.mangle_base_name

impl SigTable {
    /// Returned rather than a bool, so a duplicate can name what it conflicts
    /// with.
    pub fun find_trait_impl(receiver_identity: Sym, type_name: str, trait_name: str, trait_args: str): TraitImplInfo? {
        val has_identity = receiver_identity.as_str().byte_len() > 0
        while ti in &self.trait_impls {
            var receiver_matches = false
            if has_identity {
                receiver_matches = ti.receiver_identity.id == receiver_identity.id
            } else {
                receiver_matches = ti.type_name.as_str().equals(type_name)
            }
            if receiver_matches {
                if ti.trait_name.as_str().equals(trait_name) {
                    if ti.trait_args.as_str().equals(trait_args) { return Option.Some(ti) }
                }
            }
        }
        return Option.None
    }

    pub mutating fun insert_bound(b: BoundInfo): void {
        self.bounds.push(b)
    }

    /// Both are base names. `trait_args` has the caller's bindings substituted;
    /// the impl's own parameters act as placeholders.
    pub fun type_implements(type_base: str, trait_name: str, trait_args: str): bool {
        while ti in &self.trait_impls {
            if ti.type_name.as_str().equals(type_base) {
                if ti.trait_name.as_str().equals(trait_name) {
                    if trait_args_satisfy(trait_args, ti.trait_args.as_str(), ti.generics.as_str(), ti.arg_count, &List.new<String>()) {
                        return true
                    }
                }
            }
        }
        // A type from an extension's return arrives canonical while impls
        // register under the display name; asked once more with it.
        if identity_is_canonical(type_base) {
            val bare = identity_display_of(type_base)
            return self.type_implements(bare.as_str(), trait_name, trait_args)
        }
        return false
    }

    /// Any impl of `trait_name`, whatever its arguments: `while x in subject`
    /// must know the protocol exists before it knows what it yields.
    pub fun type_implements_any(type_base: str, trait_name: str): bool {
        while ti in &self.trait_impls {
            if ti.type_name.as_str().equals(type_base) {
                if ti.trait_name.as_str().equals(trait_name) { return true }
            }
        }
        if identity_is_canonical(type_base) {
            val bare = identity_display_of(type_base)
            return self.type_implements_any(bare.as_str(), trait_name)
        }
        return false
    }

    pub fun identity_implements(receiver: Sym, trait_name: str, trait_args: str): bool {
        while ti in &self.trait_impls {
            if ti.receiver_identity.id == receiver.id {
                if ti.trait_name.as_str().equals(trait_name) {
                    if trait_args_satisfy(trait_args, ti.trait_args.as_str(), ti.generics.as_str(), ti.arg_count, &List.new<String>()) { return true }
                }
            }
        }
        // Only a provenance-lost display name may fall back by name; canonical
        // identities stay isolated across crates.
        if !identity_is_canonical(receiver.as_str()) {
            // Instances match their template's impl: `impl Shout<T> for Box2<T>`
            // registers `Box2`.
            val display = type_identity_display(receiver)
            return self.type_implements(mangle_base_name(display).as_str(), trait_name, trait_args)
        }
        return false
    }

    pub fun identity_implements_any(receiver: Sym, trait_name: str): bool {
        while ti in &self.trait_impls {
            if ti.receiver_identity.id == receiver.id {
                if ti.trait_name.as_str().equals(trait_name) { return true }
            }
        }
        if !identity_is_canonical(receiver.as_str()) {
            val display = type_identity_display(receiver)
            return self.type_implements_any(mangle_base_name(display).as_str(), trait_name)
        }
        return false
    }
}

fun identity_is_canonical(name: str): bool {
    val n = name.byte_len()
    var i: uint64 = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 {
            if name.byte_at(i + 1) == 58 { return true }
        }
        i = i + 1
    }
    return false
}
