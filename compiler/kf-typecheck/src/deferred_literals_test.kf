import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.diagnostic.error_at
import kf_resolve.*

fun deferring_ctx(): TypeCtx {
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, Option.None, signatures)
}

fun literal_at(offset: uint32): Span {
    return Span { file_id: 1, start: offset, end: offset + 6 }
}

fun mismatch_in(ctx: &var TypeCtx, literal: Span): void {
    val mark = ctx.reported()
    ctx.emit(error_at(literal, String.from("this element is `bool`, but the array holds `int32`")))
    ctx.defer_since(mark, literal)
}

@test fun a_deferred_mismatch_is_not_reported_yet(): void {
    var ctx = deferring_ctx()
    mismatch_in(&var ctx, literal_at(4))
    assert_eq(ctx.reported(), 0 as uint64, "it waits for a slot")
}

@test fun an_unsettled_mismatch_is_reported_at_the_end(): void {
    var ctx = deferring_ctx()
    mismatch_in(&var ctx, literal_at(4))
    ctx.report_unsettled_literals()
    assert_eq(ctx.reported(), 1 as uint64, "no slot settled it")
}

@test fun a_settled_literal_reports_nothing(): void {
    var ctx = deferring_ctx()
    mismatch_in(&var ctx, literal_at(4))
    ctx.settle_literal(literal_at(4))
    ctx.report_unsettled_literals()
    assert_eq(ctx.reported(), 0 as uint64, "a slot retyped it")
}

@test fun settling_one_literal_keeps_another_waiting(): void {
    var ctx = deferring_ctx()
    mismatch_in(&var ctx, literal_at(4))
    mismatch_in(&var ctx, literal_at(20))
    ctx.settle_literal(literal_at(4))
    ctx.report_unsettled_literals()
    assert_eq(ctx.reported(), 1 as uint64, "the other literal still waits")
}
