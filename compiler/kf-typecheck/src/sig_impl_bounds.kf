// What an impl's own type parameters must satisfy for the impl to apply.

import alloc.list.*

import kf_core.ast.declaration.TypeParam

/// One impl's parameter bounds: an entry per type parameter, in declaration
/// order, naming the traits it is bounded by joined with `+` ("" for none).
@derive(Clone)
pub struct ImplParamBounds {
    pub val type_name: String
    pub val trait_name: String
    pub val bounds: List<String>
}

impl SigTable {
    pub mutating fun note_impl_param_bounds(type_name: String, trait_name: String, params: &List<TypeParam>): void {
        var bounds = List.new<String>()
        while tp in params {
            var names = String.from("")
            while bound in &tp.bounds {
                when (bound.kind) {
                    Named(name, _args) => {
                        if names.as_str().byte_len() > 0 { names.append("+") }
                        names.append(name.as_str())
                    }
                    _ => { }
                }
            }
            bounds.push(names)
        }
        self.impl_param_bounds.push(ImplParamBounds { type_name: type_name, trait_name: trait_name, bounds: bounds })
    }

    /// Every recorded impl of `trait_name` for `type_name`.
    pub fun impl_param_bounds_of(type_name: str, trait_name: str): List<ImplParamBounds> {
        var out = List.new<ImplParamBounds>()
        while each in &self.impl_param_bounds {
            if each.type_name.as_str().equals(type_name) && each.trait_name.as_str().equals(trait_name) {
                out.push(each.clone())
            }
        }
        return out
    }
}
