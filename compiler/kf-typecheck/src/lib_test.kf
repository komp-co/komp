// Several features at once, plus one known-bad case.
@test fun integration_minimal_valid_module(): void {
    // struct Point { x: int32, y: int32 }
    var fields = List.new<Field>()
    val x_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *x_ty = new_type_ref(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    fields.push(new_field(no_span(), String.from("x"), x_ty, false, true))
    val y_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *y_ty = new_type_ref(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    fields.push(new_field(no_span(), String.from("y"), y_ty, false, true))
    val struct_td = new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(fields, true))

    // fun main(): void { val n: int32 = 42 }
    val ret_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ty = new_type_ref(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = new_expr(no_span(), ExprKind.LitInt(42)) }
    val ann: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ann = new_type_ref(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("n"), ann, ip)))
    val fn_kind = TopDeclKind.Function(List.new<Param>(), ret_ty, body, true, false, false, false)
    val fn_td = new_top_decl(no_span(), String.from("main"), fn_kind)

    var m = Module {
        crate: crate_id_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    m.decls.push(struct_td)
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() == 0, true, "valid module → zero diagnostics")
}

// An impl method's sig includes the receiver, so `recv.method()` resolves:
// binding its int32 result to `bool` must report a mismatch.
@test fun integration_impl_method_resolves_to_ret_ty(): void {
    // struct Foo { }
    val foo_td = new_top_decl(no_span(), String.from("Foo"), TopDeclKind.Struct(List.new<Field>(), true))
    // impl Foo { fun area(): int32 { return 0 } }
    val m_ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *m_ret = new_type_ref(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    val zero: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *zero = new_expr(no_span(), ExprKind.LitInt(0)) }
    var m_body = List.new<Stmt>()
    m_body.push(new_stmt(no_span(), StmtKind.Return(ret_op(zero))))
    val area_kind = TopDeclKind.Function(List.new<Param>(), m_ret, m_body, true, false, false, false)
    val area_td = new_top_decl(no_span(), String.from("area"), area_kind)
    var methods = List.new<TopDecl>()
    methods.push(area_td)
    val impl_td = new_top_decl(no_span(), String.from("Foo"), TopDeclKind.ImplBlock(methods))
    // fun use(f: Foo): void { val n: bool = f.area() }
    val use_ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *use_ret = new_type_ref(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    val f_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *f_ty = new_type_ref(no_span(), TypeRefKind.Named(intern("Foo"), List.new<TypeRef>())) }
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("f"), f_ty))
    val recv_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_p = new_expr(no_span(), ExprKind.Variable(intern("f"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv_p, intern("area"), List.new<Expr>())) }
    val bool_ann: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *bool_ann = new_type_ref(no_span(), TypeRefKind.Named(intern("bool"), List.new<TypeRef>())) }
    var use_body = List.new<Stmt>()
    use_body.push(new_stmt(no_span(), StmtKind.LetVal(intern("n"), bool_ann, call)))
    val use_kind = TopDeclKind.Function(params, use_ret, use_body, true, false, false, false)
    val use_td = new_top_decl(no_span(), String.from("use"), use_kind)

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(foo_td)
    m.decls.push(impl_td)
    m.decls.push(use_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "f.area() resolved to int32 → bool-annotation mismatch")
}

