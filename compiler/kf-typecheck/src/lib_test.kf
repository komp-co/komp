    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl("A", "Item", "int32"))
    m.decls.push(mk_widget_impl("B", "Item", "bool"))
    m.decls.push(mk_probe_fn(tref_proj("Widget", "Item"), ep(ExprKind.LitInt(7))))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "two traits binding Item for Widget → ambiguous")
}

// A projection on a generic owner is deferred to Mono, not rejected.
@test fun a_projection_on_a_generic_owner_is_deferred_not_rejected(): void {
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("items"), tref_p("C")))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.Variable(intern("items")))))))
    var fn_td = new_top_decl(no_span(), String.from("first"), TopDeclKind.Function(params, tref_proj("C", "Iter"), body, true, false, false, false))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("C")))
    fn_td.generics = tps

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "C.Iter on a generic C is slice 4's job, not an error")
}

// A projection resolves in a signature too, which reaches the checker by a
// different route.
@test fun a_projection_resolves_in_signature_position(): void {
    val sig_td = new_top_decl(no_span(), String.from("sig"), TopDeclKind.Function(List.new<Param>(), tref_proj("Widget", "Nope"), List.new<Stmt>(), true, false, false, false))
    val diags = check_decls(mk_producer_trait("Producer", "Out"), mk_widget(), mk_widget_impl("Producer", "Out", "int32"), sig_td)
    // Exactly one, though signatures are resolved twice.
    assert_eq(diags.size(), 1, "an unbound projection in a return type is reported once")
}

// A projection as a type argument mangles with owner and member, so
// `List<F.Out>` and `List<G.Out>` stay apart.
@test fun a_deferred_projection_mangles_to_its_owner_and_member(): void {
    val f_out = mangle_type(projection_ty(generic_ty(String.from("F"), no_span()), intern("Out"), no_span()))
    assert_eq(f_out.as_str() == "Proj__F__Out__EndProj", true, "the mangle names owner and member")
}

@test fun two_projections_do_not_share_a_mangled_name(): void {
    val f_out = mangle_type(projection_ty(generic_ty(String.from("F"), no_span()), intern("Out"), no_span()))
    val g_out = mangle_type(projection_ty(generic_ty(String.from("G"), no_span()), intern("Out"), no_span()))
    assert_eq(f_out.as_str().equals(g_out.as_str()), false, "F.Out and G.Out are different names")
}

/// An empty `bound` declares it unbounded.
fun mk_trait_with_assoc(name: str, assoc: str, bound: str): TopDecl {
    var bounds = List.new<TypeRef>()
    if !String.from(bound).equals("") { bounds.push(tref_v(bound)) }
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocType(bounds)))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.TraitDecl(members, true, List.new<TypeRef>()))
}

/// With an impl for `<target>`, so a bound can be satisfied.
fun mk_marker_trait(name: str): TopDecl {
    var ms = List.new<TopDecl>()
    ms.push(new_top_decl(no_span(), String.from("mark"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), List.new<Stmt>(), true, false, false, false)))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.TraitDecl(ms, true, List.new<TypeRef>()))
}

fun mk_marker_impl(trait_name: str, target: str): TopDecl {
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    var ms = List.new<TopDecl>()
    ms.push(new_top_decl(no_span(), String.from("mark"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false)))
    return new_top_decl(no_span(), String.from(target), TopDeclKind.TraitImpl(tref_p(trait_name), ms))
}

fun mk_named_struct(name: str): TopDecl {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("v"), tref_p("int32"), false, true))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.Struct(fields, true))
}

/// No binding at all when `assoc` is empty.
fun mk_widget_assoc_impl(trait_name: str, assoc: str, chosen: str): TopDecl {
    var members = List.new<TopDecl>()
    if !String.from(assoc).equals("") {
        members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocTypeBinding(tref_p(chosen))))
    }
    return new_top_decl(no_span(), String.from("Widget"), TopDeclKind.TraitImpl(tref_p(trait_name), members))
}

/// Filler for an unused slot; `check_five` supplies `Widget` itself.
fun mk_unused_decl(): TopDecl {
    return mk_named_struct("Unused")
}

fun check_five(a: TopDecl, b: TopDecl, c: TopDecl, d: TopDecl, e: TopDecl): List<Diagnostic> {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_named_struct("Widget"))
    m.decls.push(a)
    m.decls.push(b)
    m.decls.push(c)
    m.decls.push(d)
    m.decls.push(e)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    return m.typecheck_module(&var table)
}

// A choice that does implement the bound is accepted.
@test fun an_assoc_type_choice_may_satisfy_its_bound(): void {
    val diags = check_five(mk_marker_trait("Marker"), mk_trait_with_assoc("Producer", "Item", "Marker"), mk_named_struct("Tag"), mk_marker_impl("Marker", "Tag"), mk_widget_assoc_impl("Producer", "Item", "Tag"))
    assert_eq(diags.size(), 0, "Tag implements Marker, so it may be the Item")
}

@test fun an_assoc_type_choice_must_satisfy_its_bound(): void {
    val diags = check_five(mk_marker_trait("Marker"), mk_trait_with_assoc("Producer", "Item", "Marker"), mk_named_struct("Tag"), mk_unused_decl(), mk_widget_assoc_impl("Producer", "Item", "Tag"))
    assert_eq(diags.size() >= 1, true, "Tag does not implement Marker → bound violation")
}

@test fun an_unbounded_assoc_type_accepts_any_choice(): void {
    val diags = check_five(mk_marker_trait("Marker"), mk_trait_with_assoc("Producer", "Item", ""), mk_named_struct("Tag"), mk_unused_decl(), mk_widget_assoc_impl("Producer", "Item", "Tag"))
    assert_eq(diags.size(), 0, "an unbounded associated type accepts anything")
}

@test fun an_impl_must_bind_every_declared_assoc_type(): void {
    val diags = check_five(mk_marker_trait("Marker"), mk_trait_with_assoc("Producer", "Item", ""), mk_named_struct("Tag"), mk_unused_decl(), mk_widget_assoc_impl("Producer", "", ""))
    assert_eq(diags.size() >= 1, true, "an impl owes a choice for every declared associated type")
}

// An impl may not bind an undeclared associated type.
@test fun an_impl_may_not_bind_an_undeclared_assoc_type(): void {
    val diags = check_five(mk_marker_trait("Marker"), mk_trait_with_assoc("Producer", "Item", ""), mk_named_struct("Tag"), mk_unused_decl(), mk_widget_assoc_impl("Producer", "Nope", "Tag"))
    assert_eq(diags.size() >= 1, true, "binding an associated type the trait never declared is an error")
}

/// `probe`'s return TypeRef after checking, which Mono and Codegen see.
fun return_tref_name_after_check(ret: Ptr<TypeRef>, chosen: str): String {
    val probe_td = new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false))
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_producer_trait("Producer", "Out"))
    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl("Producer", "Out", chosen))
    m.decls.push(probe_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val _diags = m.typecheck_module(&var table)
    return decl_return_tref_name(m.decls.at(3))
}

/// "<projection>" if still one.
fun TopDecl.decl_return_tref_name(): String {
    when (self.kind) {
        Function(_ps, ret, _b, _p, _u, _m, _s) => return tref_head_name(unsafe { &*ret })
        _ => return String.from("<not a function>")
    }
}

fun TypeRef.tref_head_name(): String {
    when (self.kind) {
        Named(n, _args) => return n.as_string()
        Projection(_o, _m) => return String.from("<projection>")
        _ => return String.from("<other>")
    }
}

// After typecheck no projection is left: the spelling is asserted.
@test fun a_resolved_projection_is_substituted_away(): void {
    val name = return_tref_name_after_check(tref_proj("Widget", "Out"), "int32")
    assert_eq(name.as_str(), "int32", "Widget.Out is replaced by the impl's choice")
}

@test fun substitution_keeps_a_non_primitive_choice(): void {
    val name = return_tref_name_after_check(tref_proj("Widget", "Out"), "Tag")
    assert_eq(name.as_str(), "Tag", "a declared type is spliced in the same way")
}

// A nested projection is substituted too.
@test fun substitution_reaches_a_nested_projection(): void {
    var args = List.new<TypeRef>()
    args.push(unsafe { *tref_proj("Widget", "Out") })
    val boxed: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *boxed = new_type_ref(no_span(), TypeRefKind.Named(intern("Box"), args)) }
    val probe_td = new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), boxed, List.new<Stmt>(), true, false, false, false))
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_producer_trait("Producer", "Out"))
    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl("Producer", "Out", "int32"))
    m.decls.push(probe_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val _diags = m.typecheck_module(&var table)
    assert_eq(nested_arg_name(m.decls.at(3)).as_str(), "int32", "Box<Widget.Out> becomes Box<int32>")
}

fun TopDecl.nested_arg_name(): String {
    when (self.kind) {
        Function(_ps, ret, _b, _p, _u, _m, _s) => return first_type_arg_name(unsafe { &*ret })
        _ => return String.from("<not a function>")
    }
}

fun TypeRef.first_type_arg_name(): String {
    when (self.kind) {
        Named(_n, args) => {
            if args.size() == 0 { return String.from("<no args>") }
            return tref_head_name(args.at(0))
        }
        _ => return String.from("<other>")
    }
}

// An unresolvable projection is left for Mono, not poisoned.
@test fun an_unresolvable_projection_survives_substitution(): void {
    var probe_td = new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), tref_proj("C", "Out"), List.new<Stmt>(), true, false, false, false))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("C")))
    probe_td.generics = tps
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_producer_trait("Producer", "Out"))
    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl("Producer", "Out", "int32"))
    m.decls.push(probe_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val _diags = m.typecheck_module(&var table)
    assert_eq(decl_return_tref_name(m.decls.at(3)).as_str(), "<projection>", "C.Out is kept intact for Mono")
}

// `Self.Out` in an impl resolves through the target.
@test fun self_in_an_impl_resolves_to_the_target(): void {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocTypeBinding(tref_p("int32"))))
    // `Self.Out` is a real type, so the method owes a return.
    var make_body = List.new<Stmt>()
    make_body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(7))))))
    members.push(new_top_decl(no_span(), String.from("make"), TopDeclKind.Function(List.new<Param>(), tref_proj("Self", "Out"), make_body, true, false, false, false)))
    val impl_td = new_top_decl(no_span(), String.from("Widget"), TopDeclKind.TraitImpl(tref_p("Producer"), members))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    // The trait declares `make` too.
    var trait_members = List.new<TopDecl>()
    trait_members.push(new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocType(List.new<TypeRef>())))
    trait_members.push(new_top_decl(no_span(), String.from("make"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), List.new<Stmt>(), true, false, false, false)))
    m.decls.push(new_top_decl(no_span(), String.from("Producer"), TopDeclKind.TraitDecl(trait_members, true, List.new<TypeRef>())))
    m.decls.push(mk_widget())
    m.decls.push(impl_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "Self.Out inside impl Producer for Widget is not an error")
    assert_eq(impl_member_return_name(m.decls.at(2), 1).as_str(), "int32", "Self.Out is substituted to the impl's choice")
}

fun TopDecl.impl_member_return_name(index: uint64): String {
    when (self.kind) {
        TraitImpl(_tref, members) => return decl_return_tref_name(members.at(index))
        _ => return String.from("<not a trait impl>")
    }
}

// `Wrap<int32>.Out` keys the instance, not the template: the template's
// `type Out = T` would splice a bare `T`. Before materialization it defers.

fun tref_p_generic(name: str, arg: str): Ptr<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(unsafe { *tref_p(arg) })
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = new_type_ref(no_span(), TypeRefKind.Named(intern(name), args)) }
    return p
}

fun tref_proj_generic(owner: str, arg: str, member: str): Ptr<TypeRef> {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = new_type_ref(no_span(), TypeRefKind.Projection(tref_p_generic(owner, arg), intern(member))) }
    return p
}

/// A template: its choice is its own parameter.
fun mk_wrap_template_impl(trait_name: str, assoc: str): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocTypeBinding(tref_p("T"))))
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.TraitImpl(tref_p(trait_name), members))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    return td
}

fun check_projection_return(impl_td: TopDecl, ret: Ptr<TypeRef>): String {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_producer_trait("Producer", "Out"))
    m.decls.push(mk_named_struct("Wrap"))
    m.decls.push(impl_td)
    m.decls.push(new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val _diags = m.typecheck_module(&var table)
    return decl_return_tref_name(m.decls.at(3))
}

// The template's row is not used for an instance.
@test fun a_projection_on_an_instantiated_owner_does_not_read_the_template(): void {
    val ret = check_projection_return(mk_wrap_template_impl("Producer", "Out"), tref_proj_generic("Wrap", "int32", "Out"))
    assert_eq(ret.as_str() == "T", false, "the template's own parameter is never spliced into a concrete signature")
    assert_eq(ret.as_str(), "<projection>", "with no instance registered yet, the projection defers to Mono")
}

// A plain owner still resolves.
@test fun a_projection_on_a_plain_owner_still_resolves(): void {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocTypeBinding(tref_p("int32"))))
    val impl_td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.TraitImpl(tref_p("Producer"), members))
    val ret = check_projection_return(impl_td, tref_proj("Wrap", "Out"))
    assert_eq(ret.as_str(), "int32", "an owner with no type arguments keys its own name")
}

// `c.make()` through `C: Producer` is typed `C.Out`, carried as a projection
// until Mono pins the owner.

fun mk_trait_with_assoc_method(name: str, assoc: str, method: str): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocType(List.new<TypeRef>())))
    members.push(new_top_decl(no_span(), String.from(method), TopDeclKind.Function(List.new<Param>(), tref_proj("Self", assoc), List.new<Stmt>(), true, false, false, false)))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.TraitDecl(members, true, List.new<TypeRef>()))
}

/// With the trait's method too, so the diagnostic count is about the case.
fun mk_widget_impl_with_method(trait_name: str, assoc: str, chosen: str, method: str): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocTypeBinding(tref_p(chosen))))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    members.push(new_top_decl(no_span(), String.from(method), TopDeclKind.Function(List.new<Param>(), tref_proj("Self", assoc), body, true, false, false, false)))
    return new_top_decl(no_span(), String.from("Widget"), TopDeclKind.TraitImpl(tref_p(trait_name), members))
}

/// `fun probe<C: <trait>>(c: C): int32 { val x = c.<method>()  return 0 }`
fun mk_bound_probe(trait_name: str, method: str): TopDecl {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("c"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern(method), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("x"), null, call)))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("c"), tref_p("C")))
    var td = new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(params, tref_p("int32"), body, true, false, false, false))
    var tp = new_type_param(no_span(), String.from("C"))
    tp.bounds.push(unsafe { *tref_p(trait_name) })
    td.generics.push(tp)
    return td
}

// A bound method returning a projection is not an error.
@test fun a_bound_method_returning_a_projection_is_not_an_error(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_trait_with_assoc_method("Producer", "Out", "make"))
    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl_with_method("Producer", "Out", "int32", "make"))
    m.decls.push(mk_bound_probe("Producer", "make"))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "`C.Out` through a bound is deferred, not rejected")
    // Typed as the projection, not poisoned.
    assert_eq(let_init_type_name(m.decls.at(3)).as_str(), "<projection>", "the call is typed `C.Out`, not poisoned")
}

/// A coarse name for the first statement's initializer type.
fun TopDecl.let_init_type_name(): String {
    when (self.kind) {
        Function(_ps, _r, body, _p, _u, _m, _s) => {
            val first = *body.at(0)
            when (first.kind) {
                LetVal(_n, _ty, init) => return type_kind_name(unsafe { &(init!!).ty })
                _ => return String.from("<not a let>")
            }
        }
        _ => return String.from("<not a function>")
    }
}

fun Type.type_kind_name(): String {
    when (self.kind) {
        Projection(_o, _m) => return String.from("<projection>")
        Poison => return String.from("<poison>")
        Int32 => return String.from("int32")
        Struct(n) => return n.as_string()
        _ => return String.from("<other>")
    }
}

// A method on an unbounded associated type is an error that says so.

fun mk_chained_probe(trait_name: str, m: str, m2: str): TopDecl {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("c"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern(m), List.new<Expr>())) }
    val inner: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *inner = new_expr(no_span(), ExprKind.Variable(intern("x"))) }
    val call2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call2 = new_expr(no_span(), ExprKind.MethodCall(inner, intern(m2), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("x"), null, call)))
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("y"), null, call2)))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("c"), tref_p("C")))
    var td = new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(params, tref_p("int32"), body, true, false, false, false))
    var tp = new_type_param(no_span(), String.from("C"))
    tp.bounds.push(unsafe { *tref_p(trait_name) })
    td.generics.push(tp)
    return td
}

@test fun a_method_on_an_unbounded_assoc_type_is_reported(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_trait_with_assoc_method("Producer", "Out", "make"))
    m.decls.push(mk_widget())
    m.decls.push(mk_widget_impl_with_method("Producer", "Out", "int32", "make"))
    m.decls.push(mk_chained_probe("Producer", "make", "step"))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "`Out` promises nothing, so `step()` on it is an error")
    assert_eq(diag_mentions(&diags, "associated type"), true, "the error names the associated type, not an unknown type")
}

fun diag_mentions(diags: &List<Diagnostic>, needle: str): bool {
    while diag in &diags {
        if (diag.primary.message.as_str()).contains(needle) { return true }
    }
    return false
}

pub fun ret_op(p: Ptr<Expr>): Box<Expr>? {
    return p
}

/// Names the impl target with template parameters and the operand in full.
@test fun a_missing_operator_impl_names_the_instance_and_the_target(): void {
    var diags = List.new<Diagnostic>()
    val dp: Ptr<List<Diagnostic>> = unsafe { &var diags }
    val sigs: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sigs = new_sig_table() }
    var params = List.new<String>()
    params.push(String.from("T"))
    unsafe { sigs.insert_generic_info(GenericInfo { name: String.from("Wrap"), type_params: params, owner_crate: crate_id_poison() }) }
    var args = List.new<TypeRef>()
    args.push(tref_v("int32"))
    unsafe { sigs.insert_inst(GenericInst { mangled: String.from("Wrap__int32"), base: String.from("Wrap"), args: args }) }

    var ctx = new_type_ctx(void_ty(no_span()), dp, Option.None, sigs)
    val ty = Type { kind: TypeKind.Struct(intern("Wrap__int32")), provenance: Provenance.Inferred(no_span()) }
    emit_missing_operator_impl(ty, "Equal", no_span(), &var ctx)

    assert_eq(diags.size(), 1, "one diagnostic")
    val msg = diags.at(0).primary.message.clone()
    assert_eq(msg.as_str().contains("impl Equal for Wrap<T>"), true, "the target carries the template's parameters")
    assert_eq(msg.as_str().contains("`Wrap<int32>` has none"), true, "the operand carries its argument")
}

/// A non-generic type's message is unchanged.
@test fun a_missing_operator_impl_on_a_plain_type_is_unchanged(): void {
    var diags = List.new<Diagnostic>()
    val dp: Ptr<List<Diagnostic>> = unsafe { &var diags }
    val sigs: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sigs = new_sig_table() }
    var ctx = new_type_ctx(void_ty(no_span()), dp, Option.None, sigs)
    val ty = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Inferred(no_span()) }
    emit_missing_operator_impl(ty, "Equal", no_span(), &var ctx)

    assert_eq(diags.size(), 1, "one diagnostic")
    val msg = diags.at(0).primary.message.clone()
    assert_eq(msg.as_str().contains("impl Equal for Point"), true, "the plain name is the whole message")
    assert_eq(msg.as_str().contains("has none"), false, "nothing to add when there is no argument")
}
