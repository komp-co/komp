    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_add_decl())
    m.decls.push(caller_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "call with correct arity → no error")
}

// struct Pair<A,B> { pub val a: A  pub val b: B }
// fun main(): int32 { val p = Pair<int32,int32>{a:2,b:3}  return p.a }
// The layout instantiates, so `p.a` is int32.
fun mk_pair_decl(): TopDecl {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("a"), tref_p("A"), false, true))
    fields.push(new_field(no_span(), String.from("b"), tref_p("B"), false, true))
    var pair_td = new_top_decl(no_span(), String.from("Pair"), TopDeclKind.Struct(fields, true))
    var ptps = List.new<TypeParam>()
    ptps.push(new_type_param(no_span(), String.from("A")))
    ptps.push(new_type_param(no_span(), String.from("B")))
    pair_td.generics = ptps
    return pair_td
}

@test fun generic_struct_field_access_types_concretely(): void {
    val pair_td = mk_pair_decl()

    var finits = List.new<FieldInit>()
    finits.push(new_field_init(no_span(), String.from("a"), ep(ExprKind.LitInt(2))))
    finits.push(new_field_init(no_span(), String.from("b"), ep(ExprKind.LitInt(3))))
    var slit = new_expr(no_span(), ExprKind.StructLit(intern("Pair"), finits))
    var sl_targs = List.new<TypeRef>()
    sl_targs.push(tref_v("int32"))
    sl_targs.push(tref_v("int32"))
    slit.type_args = sl_targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }

    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("p"), null, slit_p)))
    val pa = ep(ExprKind.FieldAccess(ep(ExprKind.Variable(intern("p"))), intern("a")))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(pa))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(pair_td)
    m.decls.push(main_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() == 0, true, "generic Pair field access → no errors")
}

// struct Wrap<T> { pub val v: T }  +  impl Wrap<T> { pub fun get(): T { return self.v } }
fun mk_wrap_decl_tc(): TopDecl {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("v"), tref_p("T"), false, true))
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.Struct(fields, true))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

fun mk_wrap_impl_tc(): TopDecl {
    val selfv = ep(ExprKind.Variable(intern("self")))
    val fa = ep(ExprKind.FieldAccess(selfv, intern("v")))
    var mbody = List.new<Stmt>()
    mbody.push(new_stmt(no_span(), StmtKind.Return(ret_op(fa))))
    val getm = new_top_decl(no_span(), String.from("get"), TopDeclKind.Function(List.new<Param>(), tref_p("T"), mbody, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(getm)
    var td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.ImplBlock(methods))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    td.generics = tps
    return td
}

// `Wrap<int32>.get()` types as int32.
@test fun generic_inherent_impl_method_dispatches(): void {
    val wrap_td = mk_wrap_decl_tc()
    val wrap_impl = mk_wrap_impl_tc()
    var finits = List.new<FieldInit>()
    finits.push(new_field_init(no_span(), String.from("v"), ep(ExprKind.LitInt(7))))
    var slit = new_expr(no_span(), ExprKind.StructLit(intern("Wrap"), finits))
    var sl_targs = List.new<TypeRef>()
    sl_targs.push(tref_v("int32"))
    slit.type_args = sl_targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("b"), null, slit_p)))
    val getcall = ep(ExprKind.MethodCall(ep(ExprKind.Variable(intern("b"))), intern("get"), List.new<Expr>()))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(getcall))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(wrap_td)
    m.decls.push(wrap_impl)
    m.decls.push(main_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() == 0, true, "b.get() resolves to int32, no errors")
}

// struct Two<A, B> { pub val a: A  pub val b: B }
