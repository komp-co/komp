// An unbounded `U` into a bounded parameter is an error.
@test fun unbounded_param_into_bounded_callee_errors(): void {
    // fun needs_eq<T: Eq>(v: T): void {}
    var nparams = List.new<Param>()
    nparams.push(new_param(no_span(), String.from("v"), tref_p("T")))
    var need_td = new_top_decl(no_span(), String.from("needs_eq"), TopDeclKind.Function(nparams, tref_p("void"), List.new<Stmt>(), true, false, false, false))
    var ntps = List.new<TypeParam>()
    var ntp = new_type_param(no_span(), String.from("T"))
    ntp.bounds.push(tref_v("Eq"))
    ntps.push(ntp)
    need_td.generics = ntps

    // fun launder<U>(a: U): void { needs_eq(a) }
    var lparams = List.new<Param>()
    lparams.push(new_param(no_span(), String.from("a"), tref_p("U")))
    var cargs = List.new<Expr>()
    cargs.push(new_expr(no_span(), ExprKind.Variable(intern("a"))))
    val call = ep(ExprKind.Call(intern("needs_eq"), cargs))
    var lbody = List.new<Stmt>()
    lbody.push(new_stmt(no_span(), StmtKind.Expression(call)))
    var launder_td = new_top_decl(no_span(), String.from("launder"), TopDeclKind.Function(lparams, tref_p("void"), lbody, true, false, false, false))
    var ltps = List.new<TypeParam>()
    ltps.push(new_type_param(no_span(), String.from("U")))
    launder_td.generics = ltps

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_eq_trait())
    m.decls.push(need_td)
    m.decls.push(launder_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "unbounded U into bounded T → propagation error")
}

fun tref_proj(owner: str, member: str): Ptr<TypeRef> {
    val inner: Ptr<TypeRef> = tref_p(owner)
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = new_type_ref(no_span(), TypeRefKind.Projection(inner, intern(member))) }
    return p
}

fun mk_producer_trait(name: str, assoc: str): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocType(List.new<TypeRef>())))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.TraitDecl(members, true, List.new<TypeRef>()))
}

fun mk_widget(): TopDecl {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("v"), tref_p("int32"), false, true))
    return new_top_decl(no_span(), String.from("Widget"), TopDeclKind.Struct(fields, true))
}

fun mk_widget_impl(trait_name: str, assoc: str, chosen: str): TopDecl {
    var members = List.new<TopDecl>()
    members.push(new_top_decl(no_span(), String.from(assoc), TopDeclKind.AssocTypeBinding(tref_p(chosen))))
    return new_top_decl(no_span(), String.from("Widget"), TopDeclKind.TraitImpl(tref_p(trait_name), members))
}

/// `fun probe(): int32 { val x: <ann> = <init>  return 0 }`: the annotation
/// makes a resolved type observable.
fun mk_probe_fn(ann: Ptr<TypeRef>, init: Ptr<Expr>): TopDecl {
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("x"), ann, init)))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    return new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false))
}

fun check_decls(a: TopDecl, b: TopDecl, c: TopDecl, d: TopDecl): List<Diagnostic> {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(a)
    m.decls.push(b)
    m.decls.push(c)
    m.decls.push(d)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    return m.typecheck_module(&var table)
}

// `type Out = int32` makes `Widget.Out` int32.
@test fun a_projection_resolves_to_the_impls_choice(): void {
    val diags = check_decls(mk_producer_trait("Producer", "Out"), mk_widget(), mk_widget_impl("Producer", "Out", "int32"), mk_probe_fn(tref_proj("Widget", "Out"), ep(ExprKind.LitInt(7))))
    assert_eq(diags.size(), 0, "Widget.Out resolves to int32 and accepts an int")
}

// Specifically int32, not poison, which would accept anything.
@test fun a_resolved_projection_rejects_the_wrong_type(): void {
    val diags = check_decls(mk_producer_trait("Producer", "Out"), mk_widget(), mk_widget_impl("Producer", "Out", "int32"), mk_probe_fn(tref_proj("Widget", "Out"), ep(ExprKind.LitBool(true))))
    assert_eq(diags.size() >= 1, true, "a bool does not fit Widget.Out = int32")
}

// An unbound projection is an error.
@test fun an_unbound_projection_is_an_error(): void {
    val diags = check_decls(mk_producer_trait("Producer", "Out"), mk_widget(), mk_widget_impl("Producer", "Out", "int32"), mk_probe_fn(tref_proj("Widget", "Nope"), ep(ExprKind.LitInt(7))))
    assert_eq(diags.size() >= 1, true, "Widget.Nope names no associated type")
}

// Two traits each binding `Item` make the projection ambiguous.
