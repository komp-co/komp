    tps.push(new_type_param(no_span(), String.from("B")))
    td.generics = tps
    return td
}

// impl Two<A, B> { pub fun second(): B { return self.b } }
fun mk_two_impl_tc(): TopDecl {
    val selfv = ep(ExprKind.Variable(intern("self")))
    val fa = ep(ExprKind.FieldAccess(selfv, intern("b")))
    var mbody = List.new<Stmt>()
    mbody.push(new_stmt(no_span(), StmtKind.Return(ret_op(fa))))
    val secondm = new_top_decl(no_span(), String.from("second"), TopDeclKind.Function(List.new<Param>(), tref_p("B"), mbody, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(secondm)
    var td = new_top_decl(no_span(), String.from("Two"), TopDeclKind.ImplBlock(methods))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("A")))
    tps.push(new_type_param(no_span(), String.from("B")))
    td.generics = tps
    return td
}

// `Two<bool, int32>.second()` is int32: arguments are read positionally.
@test fun generic_impl_method_reads_the_second_type_param(): void {
    var finits = List.new<FieldInit>()
    finits.push(new_field_init(no_span(), String.from("a"), ep(ExprKind.LitBool(true))))
    finits.push(new_field_init(no_span(), String.from("b"), ep(ExprKind.LitInt(7))))
    var slit = new_expr(no_span(), ExprKind.StructLit(intern("Two"), finits))
    var sl_targs = List.new<TypeRef>()
    sl_targs.push(tref_v("bool"))
    sl_targs.push(tref_v("int32"))
    slit.type_args = sl_targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("t"), null, slit_p)))
    val call = ep(ExprKind.MethodCall(ep(ExprKind.Variable(intern("t"))), intern("second"), List.new<Expr>()))
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(call))))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_two_decl_tc())
    m.decls.push(mk_two_impl_tc())
    m.decls.push(main_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "t.second() resolves to int32, no errors")
}

// trait Show { fun show(): int32 }
fun mk_show_trait_decl(): TopDecl {
    val showk = TopDeclKind.Function(List.new<Param>(), tref_p("int32"), List.new<Stmt>(), true, false, false, false)
    val showm = new_top_decl(no_span(), String.from("show"), showk)
    var methods = List.new<TopDecl>()
    methods.push(showm)
    val k = TopDeclKind.TraitDecl(methods, true, List.new<TypeRef>())
    return new_top_decl(no_span(), String.from("Show"), k)
}

// impl Show for Point { [fun show(): int32 { return 0 }] }
fun mk_show_impl(with_method: bool): TopDecl {
    var methods = List.new<TopDecl>()
    if with_method {
        var body = List.new<Stmt>()
        body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
        val showk = TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false)
        methods.push(new_top_decl(no_span(), String.from("show"), showk))
    }
    val tref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tref = new_type_ref(no_span(), TypeRefKind.Named(intern("Show"), List.new<TypeRef>())) }
    val k = TopDeclKind.TraitImpl(tref, methods)
    return new_top_decl(no_span(), String.from("Point"), k)
}

@test fun trait_impl_satisfies_ok(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_named_struct("Point"))
    m.decls.push(mk_show_trait_decl())
    m.decls.push(mk_show_impl(true))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() == 0, true, "Point satisfies Show → no errors")
}

@test fun trait_impl_missing_method_errors(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_named_struct("Point"))
    m.decls.push(mk_show_trait_decl())
    m.decls.push(mk_show_impl(false))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() > 0, true, "impl Show for Point missing show() is rejected")
}

@test fun empty_module_no_diagnostics(): void {
    var m = Module {
        crate: crate_id_poison(),
