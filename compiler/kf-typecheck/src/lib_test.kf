// `fun need_show<T: Display>(): void { }`
fun mk_bounded_fn(): TopDecl {
    val fn_kind = TopDeclKind.Function(List.new<Param>(), tref_p("void"), List.new<Stmt>(), true, false, false, false)
    var fn_td = new_top_decl(no_span(), String.from("need_show"), fn_kind)
    var tps = List.new<TypeParam>()
    var tp = new_type_param(no_span(), String.from("T"))
    tp.bounds.push(tref_v("Display"))
    tps.push(tp)
    fn_td.generics = tps
    return fn_td
}

// `fun main(): void { need_show<ARG>() }`
fun mk_main_calling(targ: str): TopDecl {
    var call = new_expr(no_span(), ExprKind.Call(intern("need_show"), List.new<Expr>()))
    var ctargs = List.new<TypeRef>()
    ctargs.push(tref_v(targ))
    call.type_args = ctargs
    val call_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_p = call }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call_p)))
    val main_kind = TopDeclKind.Function(List.new<Param>(), tref_p("void"), body, true, false, false, false)
    return new_top_decl(no_span(), String.from("main"), main_kind)
}

// need_show<int32>() without `impl Display for int32` is an error.
@test fun bound_violation_at_instantiation_errors(): void {
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
