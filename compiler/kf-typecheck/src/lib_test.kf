fun mk_add_decl(): TopDecl {
    var add_params = List.new<Param>()
    add_params.push(new_param(no_span(), String.from("a"), tref_p("int32")))
    add_params.push(new_param(no_span(), String.from("b"), tref_p("int32")))
    var add_body = List.new<Stmt>()
    add_body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(0))))))
    return new_top_decl(no_span(), String.from("add"), TopDeclKind.Function(add_params, tref_p("int32"), add_body, true, false, false, false))
}

// add(1): too few arguments.
@test fun call_with_wrong_arity_is_error(): void {
    var call_args = List.new<Expr>()
    call_args.push(new_expr(no_span(), ExprKind.LitInt(1)))
    val call = ep(ExprKind.Call(intern("add"), call_args))
    var caller_body = List.new<Stmt>()
    caller_body.push(new_stmt(no_span(), StmtKind.Return(ret_op(call))))
    val caller_td = new_top_decl(no_span(), String.from("caller"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), caller_body, true, false, false, false))
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_add_decl())
    m.decls.push(caller_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "call with wrong arity → error")
}

// add(1, 2): correct.
