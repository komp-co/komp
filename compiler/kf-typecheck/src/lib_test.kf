import core.assert.*
import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_resolve.*
import kf_typecheck.types.recv_type_bindings
import kf_typecheck.types.recv_is_instance
import kf_typecheck.types.mangle_type
import kf_core.span.no_span

pub fun tref_p(n: str): Ptr<TypeRef> {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = new_type_ref(no_span(), TypeRefKind.Named(intern(n), List.new<TypeRef>())) }
    return p
}

fun tref_v(n: str): TypeRef {
    return new_type_ref(no_span(), TypeRefKind.Named(intern(n), List.new<TypeRef>()))
}

pub fun ep(k: ExprKind): Ptr<Expr> {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = new_expr(no_span(), k) }
    return p
}

// A method on an unbounded type parameter is an error.
@test fun member_access_on_unbounded_type_var_is_error(): void {
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("x"), tref_p("T")))
    val recv = ep(ExprKind.Variable(intern("x")))
    val call = ep(ExprKind.MethodCall(recv, intern("size"), List.new<Expr>()))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(call))))
    val fn_kind = TopDeclKind.Function(params, tref_p("int32"), body, true, false, false, false)
    var fn_td = new_top_decl(no_span(), String.from("bad"), fn_kind)
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    fn_td.generics = tps

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "method on unbounded T → error")
}

// fun missing(): int32 { val y = 1 } falls off the end.
@test fun non_void_fn_falling_off_end_is_error(): void {
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("y"), null, ep(ExprKind.LitInt(1)))))
    val fn_kind = TopDeclKind.Function(List.new<Param>(), tref_p("int32"), body, true, false, false, false)
    val fn_td = new_top_decl(no_span(), String.from("missing"), fn_kind)
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "non-void fn falling off the end → missing-return error")
}

// enum Color { Red  Green  Blue }
pub fun color_enum_decl(): TopDecl {
    var variants = List.new<Variant>()
    variants.push(new_variant(no_span(), String.from("Red"), List.new<TypeRef>()))
    variants.push(new_variant(no_span(), String.from("Green"), List.new<TypeRef>()))
    variants.push(new_variant(no_span(), String.from("Blue"), List.new<TypeRef>()))
    return new_top_decl(no_span(), String.from("Color"), TopDeclKind.EnumDecl(variants, true))
}

// `Name => return n`
fun returning_arm(name: str, n: int64): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Variant(intern(name), List.new<Pattern>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(n))))))
    return new_arm(no_span(), pp, null, body)
}

// fun code(c: Color): int32 { when (c) { <arms> } }, the `when` its only exit.
fun diags_for_when_over_color(arms: List<Arm>): List<Diagnostic> {
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("c"), tref_p("Color")))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.When(ep(ExprKind.Variable(intern("c"))), arms)))
    val fn_kind = TopDeclKind.Function(params, tref_p("int32"), body, true, false, false, false)
    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(color_enum_decl())
    m.decls.push(new_top_decl(no_span(), String.from("code"), fn_kind))
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    return m.typecheck_module(&var table)
}

@test fun when_missing_a_variant_does_not_cover_all_paths(): void {
    var arms = List.new<Arm>()
    arms.push(returning_arm("Red", 1))
    arms.push(returning_arm("Green", 2))
    val diags = diags_for_when_over_color(arms)
    assert_eq(diags.size() >= 1, true, "Blue unhandled → the fn can fall off the end")
}

@test fun exhaustive_when_does_cover_all_paths(): void {
    var arms = List.new<Arm>()
    arms.push(returning_arm("Red", 1))
    arms.push(returning_arm("Green", 2))
    arms.push(returning_arm("Blue", 3))
    val diags = diags_for_when_over_color(arms)
    assert_eq(diags.size(), 0, "every variant returns → no missing-return error")
}

