// `w.show()` on `Wrap<int32>` reads the trait impl's signature from the
// template.
@test fun trait_impl_on_a_generic_struct_dispatches(): void {
    var mbody = List.new<Stmt>()
    mbody.push(new_stmt(no_span(), StmtKind.Return(ret_op(ep(ExprKind.LitInt(7))))))
    val showm = new_top_decl(no_span(), String.from("show"), TopDeclKind.Function(List.new<Param>(), tref_p("int32"), mbody, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(showm)
    var impl_td = new_top_decl(no_span(), String.from("Wrap"), TopDeclKind.TraitImpl(tref_p("Show"), methods))
    var tps = List.new<TypeParam>()
    tps.push(new_type_param(no_span(), String.from("T")))
    impl_td.generics = tps

    var finits = List.new<FieldInit>()
    finits.push(new_field_init(no_span(), String.from("v"), ep(ExprKind.LitInt(7))))
    var slit = new_expr(no_span(), ExprKind.StructLit(intern("Wrap"), finits))
    var sl_targs = List.new<TypeRef>()
    sl_targs.push(tref_v("int32"))
    slit.type_args = sl_targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.LetVal(intern("w"), null, slit_p)))
    val call = ep(ExprKind.MethodCall(ep(ExprKind.Variable(intern("w"))), intern("show"), List.new<Expr>()))
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    val main_td = new_top_decl(no_span(), String.from("main"), TopDeclKind.Function(List.new<Param>(), tref_p("void"), body, true, false, false, false))

    var m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_show_trait())
    m.decls.push(mk_wrap_decl_tc())
    m.decls.push(impl_td)
    m.decls.push(main_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "w.show() finds the trait impl registered on the template")
}

// `Wrap__T` read from a scope where `T` is not a parameter binds and reports
// nothing.
@test fun a_foreign_scope_instance_binds_nothing(): void {
    var diags = List.new<Diagnostic>()
    val dp: Ptr<List<Diagnostic>> = unsafe { &var diags }
    val sigs: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sigs = new_sig_table() }
    var params = List.new<String>()
    params.push(String.from("T"))
    unsafe { sigs.insert_generic_info(GenericInfo { name: String.from("Wrap"), type_params: params, owner_crate: crate_id_poison() }) }
    var args = List.new<TypeRef>()
    args.push(tref_v("T"))
    unsafe { sigs.insert_inst(GenericInst { mangled: String.from("Wrap__T"), base: String.from("Wrap"), args: args }) }

    var ctx = new_type_ctx(void_ty(no_span()), dp, Option.None, sigs)
    val binding = recv_type_bindings(String.from("Wrap__T"), no_span(), &var ctx)
    assert_eq(binding.recv_is_instance(), false, "an out-of-scope argument binds nothing")
}

