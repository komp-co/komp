// A checked Type written back as a TypeRef, for declarations synthesized from
// inferred types. A projection or poison has no spelling and comes back
// Poison.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*

pub fun Type.type_to_type_ref(span: Span): TypeRef {
    when (self.kind) {
        Int8 => return named_ref("int8", span)
        Int16 => return named_ref("int16", span)
        Int32 => return named_ref("int32", span)
        Int64 => return named_ref("int64", span)
        UInt8 => return named_ref("uint8", span)
        UInt16 => return named_ref("uint16", span)
        UInt32 => return named_ref("uint32", span)
        UInt64 => return named_ref("uint64", span)
        Float32 => return named_ref("float32", span)
        Float64 => return named_ref("float64", span)
        Bool => return named_ref("bool", span)
        Char => return named_ref("char", span)
        StrTy => return named_ref("str", span)
        Void => return named_ref("void", span)
        // An instance's mangled name is its layout's name.
        Struct(n) => return named_ref(n.as_str(), span)
        EnumTy(n) => return named_ref(n.as_str(), span)
        Generic(n) => return named_ref(n.as_str(), span)
        PtrTo(inner) => return wrapped_ref("Ptr", unsafe { &*inner }, span)
        BoxOf(inner) => return wrapped_ref("Box", unsafe { &*inner }, span)
        RefTo(mutable, inner) => {
            val within = type_to_type_ref(unsafe { &*inner }, span)
            if within.type_ref_is_poison() { return poison_ref(span) }
            val inner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *inner_ptr = within }
            return new_type_ref(span, TypeRefKind.Reference(mutable, inner_ptr))
        }
        _ => return poison_ref(span)
    }
}

pub fun TypeRef.type_ref_is_poison(): bool {
    return when (self.kind) {
        Poison => true
        _ => false
    }
}

fun named_ref(name: str, span: Span): TypeRef {
    return new_type_ref(span, TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun poison_ref(span: Span): TypeRef {
    return new_type_ref(span, TypeRefKind.Poison)
}

fun wrapped_ref(head: str, inner: &Type, span: Span): TypeRef {
    val within = inner.type_to_type_ref(span)
    if within.type_ref_is_poison() { return poison_ref(span) }
    var args = List.new<TypeRef>()
    args.push(within)
    return new_type_ref(span, TypeRefKind.Named(intern(head), args))
}
