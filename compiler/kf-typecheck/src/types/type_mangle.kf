import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.subst.mangle_tyref

pub fun mangle_type_name(name: str, args: &List<TypeRef>, ctx: &var TypeCtx): String {
    var result = String.from(name)
    while arg in &args {
        val suffix = mangle_type_ref(arg, ctx)
        result.append("__")
        result.append(suffix.as_str())
    }
    return result
}

/// As it appears inside a struct name.
fun mangle_type_ref(tr: TypeRef, ctx: &var TypeCtx): String {
    // `&dyn Trait` is a fat value, mangled `Dyn__Trait`; resolving first would
    // lose that.
    when (tr.kind) {
        Reference(_mutable, inner_ref) => {
            val inner_syntax = unsafe { *inner_ref }
            when (inner_syntax.kind) {
                DynTrait(_principal, _args) => return mangle_tyref(&tr)
                _ => { }
            }
        }
        _ => { }
    }
    return tr.resolve_type_ref(ctx).mangle_frag()
}

/// Also backs the checker's type identity, so it distinguishes everything the
/// type system does; kf-core owns the spelling.
pub fun mangle_type(t: Type): String {
    return t.mangle_frag()
}
