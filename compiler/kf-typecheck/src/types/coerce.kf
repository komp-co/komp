import kf_core.ast.*
import kf_typecheck.traits.key_segments
import kf_typecheck.check.mangle_base_name
import kf_typecheck.check.ty_from_frag_in_scope
import kf_core.span.no_span
import kf_core.ast.dyn_meta.dyn_trait_type

/// Binds `gname` from one param/argument pair through reference layers:
/// a `&A` param routinely faces a bare `A` argument, and must bind so the
/// argument gets `coerce_addr_of`. Poison when the pair says nothing.
pub fun Type.bind_generic_from_param(arg: &Type, gname: str, ctx: &var TypeCtx): Type {
    val pk: TypeKind = self.kind
    val ptag: uint64 = pk.kind_tag()
    if ptag == TAG_GENERIC() {
        if pk.generic_name().as_str().equals(gname) { return (*arg) }
        return poison_ty()
    }
    val ak: TypeKind = arg.kind
    val atag: uint64 = ak.kind_tag()
    if ptag == TAG_REF() {
        val pinner = pk.ref_inner()
        // A `&A` self takes a bare `A` or a reference-shaped `A`; one layer is
        // peeled when present.
        if atag == TAG_REF() {
            val ainner = ak.ref_inner()
            return pinner.bind_generic_from_param(&ainner, gname, ctx)
        }
        if atag == TAG_PTR() {
            val ainner = ak.ptr_inner()
            return pinner.bind_generic_from_param(&ainner, gname, ctx)
        }
        if atag == TAG_BOX() {
            val ainner = ak.box_inner()
            return pinner.bind_generic_from_param(&ainner, gname, ctx)
        }
        return pinner.bind_generic_from_param(arg, gname, ctx)
    }
    if ptag == TAG_PTR() && atag == TAG_PTR() {
        val pinner = pk.ptr_inner()
        val ainner = ak.ptr_inner()
        return pinner.bind_generic_from_param(&ainner, gname, ctx)
    }
    if ptag == TAG_BOX() && atag == TAG_BOX() {
        val pinner = pk.box_inner()
        val ainner = ak.box_inner()
        return pinner.bind_generic_from_param(&ainner, gname, ctx)
    }
    if ptag == TAG_FN() && atag == TAG_FN() { return self.bind_generic_through_fn(arg, gname, ctx) }
    if ptag == TAG_ARRAY() && atag == TAG_ARRAY() {
        if pk.array_length() != ak.array_length() { return poison_ty() }
        return self.array_element().bind_generic_from_param(&arg.array_element(), gname, ctx)
    }
    // `List__T` against `List__int32` binds T. Otherwise one unbound self
    // voids check_call's all-or-nothing write-back.
    if ptag == TAG_STRUCT() || ptag == TAG_ENUM() {
        if atag == TAG_STRUCT() || atag == TAG_ENUM() {
            return bind_generic_from_instance(pk.struct_name(), ak.struct_name(), gname, ctx)
        }
    }
    return poison_ty()
}

/// `(T) -> T` against `(int32) -> int32`: the first parameter, then the
/// result, that binds.
fun Type.bind_generic_through_fn(arg: &Type, gname: str, ctx: &var TypeCtx): Type {
    val want = self.fn_parts() ?: return poison_ty()
    val have = arg.fn_parts() ?: return poison_ty()
    if want.params.size() != have.params.size() { return poison_ty() }
    while i in 0..want.params.size() {
        val bound = want.params.at(i).bind_generic_from_param(have.params.at(i), gname, ctx)
        if !bound.is_poison() { return bound }
    }
    return want.ret.bind_generic_from_param(&have.ret, gname, ctx)
}

/// Two same-shape instances of one template, segment by segment. A nested
/// instance splits ambiguously and fails to bind rather than binding wrongly.
fun bind_generic_from_instance(pname: String, aname: String, gname: str, ctx: &var TypeCtx): Type {
    if !mangle_base_name(pname.clone()).as_str().equals(mangle_base_name(aname.clone()).as_str()) {
        return poison_ty()
    }
    val psegs = key_segments(pname.as_str())
    val asegs = key_segments(aname.as_str())
    if psegs.size() != asegs.size() { return poison_ty() }
    var i = 1
    while i < psegs.size() {
        if psegs.at(i).as_str().equals(gname) {
            // Decoded in scope: the argument's names belong to this body, so
            // the caller's own `T` stays Generic and its bound is checked.
            // `psegs` are the callee's names and are only matched as text.
            return ty_from_frag_in_scope(*asegs.at(i), no_span(), ctx)
        }
        i = i + 1
    }
    return poison_ty()
}

// `name` -> `with_ty`, also inside mangled names (`Buffer__T` ->
// `Buffer__int32`) and through wrappers.
pub fun Type.subst_generic(name: String, with_ty: Type): Type {
    if name.as_str().equals("") { return (*self) }
    when (self.kind) {
        Generic(tn) => {
            if tn.as_str().equals(name.as_str()) { return with_ty }
            return (*self)
        }
        Struct(n) => {
            val repl = mangle_type(with_ty)
            val nn = subst_name_segments(n.as_str(), name.as_str(), repl.as_str())
            return Type { kind: TypeKind.Struct(intern(nn.as_str())), provenance: self.provenance }
        }
        EnumTy(n) => {
            val repl = mangle_type(with_ty)
            val nn = subst_name_segments(n.as_str(), name.as_str(), repl.as_str())
            return Type { kind: TypeKind.EnumTy(intern(nn.as_str())), provenance: self.provenance }
        }
        DynTraitTy(object) => {
            var args = new_type_vec()
            val source_args = unsafe { object.args }
            var i = 0
            while i < unsafe { source_args.size() } {
                val argument = unsafe { source_args.get(i) }
                args.push(argument.subst_generic(name.clone(), with_ty.clone()))
                i = i + 1
            }
            val rebuilt = dyn_trait_type(unsafe { object.principal }, args, no_span())
            return Type { kind: rebuilt.kind, provenance: self.provenance }
        }
        PtrTo(p) => {
            val inner = subst_generic(unsafe { *p }, name, with_ty)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.PtrTo(np), provenance: self.provenance }
        }
        BoxOf(p) => {
            val inner = subst_generic(unsafe { *p }, name, with_ty)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.BoxOf(np), provenance: self.provenance }
        }
        ArrayOf(_p, length) => {
            val element = self.array_element().subst_generic(name, with_ty)
            return Type { kind: array_ty(element, length, no_span()).kind, provenance: self.provenance }
        }
        RefTo(m, p) => {
            val inner = subst_generic(unsafe { *p }, name, with_ty)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.RefTo(m, np), provenance: self.provenance }
        }
        FnTy(_) => {
            val parts = self.fn_parts() ?: return (*self)
            var params = new_type_vec()
            while param in &parts.params {
                params.push(param.subst_generic(name.clone(), with_ty.clone()))
            }
            return fn_ty(params, parts.ret.subst_generic(name, with_ty), self.provenance)
        }
        // `Self.Out` read through `C: Producer` means `C.Out` here.
        Projection(owner, member) => {
            val inner = subst_generic(unsafe { *owner }, name, with_ty)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.Projection(np, member), provenance: self.provenance }
        }
        _ => return (*self)
    }
}

// Each `__` segment equal to `param` becomes `repl`: `Buffer__T` ->
// `Buffer__int32`. A single `_` inside a name is kept.
fun subst_name_segments(mangled: str, param: str, repl: str): String {
    val n = mangled.byte_len()
    var out = ""
    var seg_start: uint64 = 0
    var emitted_any = false
    var i: uint64 = 0
    while i + 1 < n {
        val d0 = mangled.byte_at(i)
        val d1 = mangled.byte_at(i + 1)
        if d0 == 95 && d1 == 95 {
            val seg = mangled.substring(seg_start, i)
            if emitted_any { out.append("__") }
            if seg.as_str().equals(param) { out.append(repl) } else { out.append(seg.as_str()) }
            emitted_any = true
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    val tail = mangled.substring(seg_start, n)
    if emitted_any { out.append("__") }
    if tail.as_str().equals(param) { out.append(repl) } else { out.append(tail.as_str()) }
    return out
}

fun is_int_tag(t: uint64): bool {
    if t == TAG_INT8() { return true }
    if t == TAG_INT16() { return true }
    if t == TAG_INT32() { return true }
    if t == TAG_INT64() { return true }
    if t == TAG_UINT8() { return true }
    if t == TAG_UINT16() { return true }
    if t == TAG_UINT32() { return true }
    if t == TAG_UINT64() { return true }
    return false
}

/// 0 for a non-integer.
fun int_tag_width(t: uint64): uint64 {
    if t == TAG_INT8() { return 8 }
    if t == TAG_UINT8() { return 8 }
    if t == TAG_INT16() { return 16 }
    if t == TAG_UINT16() { return 16 }
    if t == TAG_INT32() { return 32 }
    if t == TAG_UINT32() { return 32 }
    if t == TAG_INT64() { return 64 }
    if t == TAG_UINT64() { return 64 }
    return 0
}

/// The type a conditional value yields from two arms; poison when they do
/// not reconcile. Integers join to the wider, since first-arm-wins would
/// truncate:
///
///     val v = if c { 0 } else { big }        // big: uint64
///
/// Equal widths keep the first arm's type, leaving signedness permissive.
pub fun Type.join_arm_types(b: &Type, string_name: Sym): Type {
    if self.type_eq(b) { return self.clone() }
    val at = self.kind.kind_tag()
    val bt = b.kind.kind_tag()
    if is_int_tag(at) {
        if is_int_tag(bt) {
            if int_tag_width(bt) > int_tag_width(at) { return b.clone() }
            return self.clone()
        }
    }
    if b.can_coerce(self, string_name) { return self.clone() }
    if self.can_coerce(b, string_name) { return b.clone() }
    return poison_ty()
}

/// `string_name` is the type a `str` converts up into.
pub fun Type.can_coerce(to: &Type, string_name: Sym): bool {
    if self.type_eq(to) { return true }
    if self.is_poison() || to.is_poison() { return true }
    val fk: TypeKind = self.kind
    val tk: TypeKind = to.kind
    // A deferred projection is settled at mono and accepted here.
    if fk.kind_tag() == TAG_PROJECTION() { return true }
    if tk.kind_tag() == TAG_PROJECTION() { return true }
    if fk.kind_tag() == TAG_STR() && to.is_lang_struct(string_name) { return true }
    // Any integer fits any integer slot; C converts.
    if is_int_tag(fk.kind_tag()) {
        if is_int_tag(tk.kind_tag()) { return true }
    }
    // Box<T> and Ptr<T> are both `T*` and interconvert.
    if fk.kind_tag() == TAG_BOX() {
        if tk.kind_tag() == TAG_PTR() {
            val bi = fk.box_inner()
            val pi = tk.ptr_inner()
            return bi.type_eq(pi)
        }
    }
    if fk.kind_tag() == TAG_PTR() {
        if tk.kind_tag() == TAG_BOX() {
            val pi = fk.ptr_inner()
            val bi = tk.box_inner()
            return pi.type_eq(bi)
        }
    }
    // A value in a `Ptr<T>`/`&T` slot is auto-borrowed.
    if tk.kind_tag() == TAG_PTR() {
        val inner_t = tk.ptr_inner()
        if self.type_eq(inner_t) { return true }
    }
    if tk.kind_tag() == TAG_REF() {
        val inner_t = tk.ref_inner()
        if self.type_eq(inner_t) { return true }
        // `&var T` fits `&T`, not the reverse.
        if fk.kind_tag() == TAG_REF() {
            if !type_eq(fk.ref_inner(), inner_t) { return false }
            if tk.ref_is_mut() { return fk.ref_is_mut() }
            return true
        }
    }
    // A reference and a `Ptr` are the same `T*`.
    if fk.kind_tag() == TAG_REF() {
        if tk.kind_tag() == TAG_PTR() {
            return type_eq(fk.ref_inner(), tk.ptr_inner())
        }
    }
    return false
}

/// "" when the owner is not a bare parameter.
pub fun TypeKind.projection_owner_param(): String {
    when (self) {
        Projection(owner, _member) => {
            val inner: Type = unsafe { *owner }
            return inner.kind.generic_name()
        }
        _ => return ""
    }
}

pub fun TypeKind.projection_member(): Sym {
    return when (self) {
        Projection(_owner, member) => member
        _ => intern("")
    }
}
