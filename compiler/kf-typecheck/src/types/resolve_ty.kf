// TypeRef to Type. Primitives are name-keyed; user names look up the decl
// table.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_resolve.*
import kf_typecheck.traits.assoc_owner_key
import kf_typecheck.check.mangle_base_name
import kf_typecheck.check.check_generic_bounds
import kf_core.ast.dyn_meta.dyn_trait_type
import kf_typecheck.note_import_use

// Declared per file: the shim is in every translation unit.

pub fun TypeRef.resolve_type_ref(ctx: &var TypeCtx): Type {
    when (self.kind) {
        Named(name, args) => {
            // A function type written back through its mangle fragment.
            if args.size() == 0 && name.as_str().starts_with("kf__fn") {
                val function = ctx.fn_type_for(name.as_str())
                if function != null { return function!! }
            }
            var s = name.as_str()
            // A local annotation may still name the `?` placeholder.
            if name.lang_placeholder_key().as_str().equals(lang_option_key()) {
                s = ctx.option_name().as_str()
            }
            // A builtin name a crate also declares (the lang string) still
            // counts as a use of that crate's import.
            val is_lang_string = is_lang_name(s, ctx.string_name())
            if is_lang_string || s.equals("str") {
                val bi = unsafe { (*ctx.sigs).lookup_unique_type_identity(s) }
                if !bi.crate.is_poison() { note_import_use(ctx.sigs, ctx.owner_file, bi.module) }
            }

            when s {
                "int8" => return Type { kind: TypeKind.Int8, provenance: Provenance.Declared(self.span) }
                "int16" => return Type { kind: TypeKind.Int16, provenance: Provenance.Declared(self.span) }
                "int32" => return int32_ty(self.span)
                "int64" => return Type { kind: TypeKind.Int64, provenance: Provenance.Declared(self.span) }
                "uint8" => return Type { kind: TypeKind.UInt8, provenance: Provenance.Declared(self.span) }
                "uint16" => return Type { kind: TypeKind.UInt16, provenance: Provenance.Declared(self.span) }
                "uint32" => return Type { kind: TypeKind.UInt32, provenance: Provenance.Declared(self.span) }
                "uint64" => return Type { kind: TypeKind.UInt64, provenance: Provenance.Declared(self.span) }
                "float32" => return Type { kind: TypeKind.Float32, provenance: Provenance.Declared(self.span) }
                "float64" => return Type { kind: TypeKind.Float64, provenance: Provenance.Declared(self.span) }
                "bool" => return bool_ty(self.span)
                "char" => return Type { kind: TypeKind.Char, provenance: Provenance.Declared(self.span) }
                "str" => return str_ty(self.span)
                _ => { }
            }
            if is_lang_string { return ctx.string_name().lang_struct_ty(self.span) }
            if s.equals("void") { return void_ty(self.span) }
            if s.equals("Self") && !ctx.self_ty.is_poison() { return ctx.self_ty.clone() }

            // `Ptr<T>` is `PtrTo(T)`, emitted `T*`, not a container.
            if s.equals("Ptr") {
                if args.size() == 1 {
                    val arg0 = *args.at(0)
                    val inner = arg0.resolve_type_ref(ctx)
                    return ptr_ty(inner, self.span)
                }
            }

            // `Box<T>` is `BoxOf(T)`, emitted `T*`.
            if s.equals("Box") {
                if args.size() == 1 {
                    val arg0 = *args.at(0)
                    val inner = arg0.resolve_type_ref(ctx)
                    return box_ty(inner, self.span)
                }
            }

            // A generic parameter in scope?
            while g in &ctx.generics {
                if g.as_str().equals(s) {
                    return generic_ty(g, self.span)
                }
            }

            // A user type, through the decl table. The pre-passes have no table
            // and skip the lookup.
            when (ctx.table) {
                Some(tab) => {
                    val d = (unsafe { *tab }).lookup(s)
                    if d.is_none() {
                        val lab = new_label(self.span, "unknown type `${name.as_string()}`")
                        ctx.emit(new_diagnostic(Severity.Error, lab))
                        return poison_ty()
                    }
                }
                None => { }
            }
            when (unsafe { (*ctx.sigs).find_generic_info(s, ctx.owner_crate) }) {
                Some(info) => {
                    if info.type_params.size() != args.size() {
                        val message = "type `${s}` expects ${info.type_params.size()} type arguments, found ${args.size()}"
                        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                        return poison_ty()
                    }
                }
                None => { }
            }
            if args.size() == 0 {
                val identity = unsafe { (*ctx.sigs).lookup_type_identity(s, ctx.owner_crate, ctx.owner_module) }
                if !identity.crate.is_poison() {
                    note_import_use(ctx.sigs, ctx.owner_file, identity.module)
                    return named_struct_ty(identity, self.span)
                }
                val imported = unsafe { (*ctx.sigs).lookup_unique_type_identity(s) }
                if !imported.crate.is_poison() {
                    // Writing the name is a use of its module's import, even though
                    // types resolve globally.
                    note_import_use(ctx.sigs, ctx.owner_file, imported.module)
                    return named_struct_ty(imported, self.span)
                }
            }
            // Generic arguments fold into the name: `List__String`.
            val mangled = mangle_type_name(s, args, ctx)
            // The concrete layout is materialized on demand
            // (`Pair<int32,int32>` -> `Pair__int32__int32`).
            if args.size() > 0 {
                // A generic instance names its template too, which is a use of
                // its import.
                val gi = unsafe { (*ctx.sigs).lookup_unique_type_identity(s) }
                if !gi.crate.is_poison() { note_import_use(ctx.sigs, ctx.owner_file, gi.module) }
                instantiate_generic_layout(String.from(s), args, String.from(mangled.as_str()), ctx)
            }
            return Type { kind: TypeKind.Struct(intern(mangled.as_str())), provenance: Provenance.Declared(self.span) }
        }
        DynTrait(name, args) => {
            var resolved_args = new_type_vec()
            while argument in &args {
                resolved_args.push(argument.resolve_type_ref(ctx))
            }
            val sigs = ctx.sigs
            val count = unsafe { sigs.count_traits_named(name.as_str()) }
            if count == 0 {
                val is_type = unsafe { sigs.find_struct(name.as_str(), ctx.owner_crate).is_some() || sigs.find_enum(name.as_str(), ctx.owner_crate).is_some() }
                val message = if is_type {
                    "`${name.as_string()}` is not a trait"
                } else {
                    "unknown trait `${name.as_string()}` in dynamic trait type"
                }
                ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                return poison_ty()
            }
            if count > 1 {
                val message = "trait name `${name.as_string()}` is ambiguous in this scope"
                ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                return poison_ty()
            }
            when (unsafe { sigs.find_unique_trait(name.as_str()) }) {
                Some(info) => {
                    if info.type_params.size() != args.size() {
                        val message = "trait `${name.as_string()}` expects ${info.type_params.size()} type arguments, found ${args.size()}"
                        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                        return poison_ty()
                    }
                    return dyn_trait_type(info.identity, resolved_args, self.span)
                }
                None => return poison_ty()
            }
        }
        Function(params, ret_ptr) => {
            var values = new_type_vec()
            while param in &params {
                values.push(param.resolve_type_ref(ctx))
            }
            val ret = ret_ptr.resolve_type_ref(ctx)
            val function = fn_ty(values, ret, Provenance.Declared(self.span))
            ctx.note_fn_type(&function)
            return function
        }
        Reference(mutable, inner_ptr) => {
            val inner = (unsafe { *inner_ptr }).resolve_type_ref(ctx)
            val p: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *p = inner }
            return Type {
                kind: TypeKind.RefTo(mutable, p),
                provenance: Provenance.Declared(self.span)
            }
        }
        Array(element, length) => {
            val inner = element.resolve_type_ref(ctx)
            if length == null {
                val why = "`T[]` is for a `val` or `var` initialized with an array"
                val message = "an array type needs its length here, `T[N]`: ${why}"
                ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                return poison_ty()
            }
            if length == 0 {
                ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, "an array holds at least one element")))
                return poison_ty()
            }
            if inner.is_poison() { return poison_ty() }
            return Type { kind: array_ty(inner, length ?: 0, self.span).kind, provenance: Provenance.Declared(self.span) }
        }
        Projection(owner_ptr, member) => {
            val owner_tr: TypeRef = unsafe { *owner_ptr }
            val owner_ty = owner_tr.resolve_type_ref(ctx)
            return resolve_projection(owner_ty, member, self.span, ctx)
        }
        Poison => return poison_ty()
    }
}

/// Generic user types stay at their template identity; builtin targets keep
/// their builtin kind.
pub fun impl_target_ty(name: str, span: Span, string_name: Sym): Type {
    when name {
        "int8" => return Type { kind: TypeKind.Int8, provenance: Provenance.Inferred(span) }
        "int16" => return Type { kind: TypeKind.Int16, provenance: Provenance.Inferred(span) }
        "int32" => return int32_ty(span)
        "int64" => return Type { kind: TypeKind.Int64, provenance: Provenance.Inferred(span) }
        "uint8" => return Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(span) }
        "uint16" => return Type { kind: TypeKind.UInt16, provenance: Provenance.Inferred(span) }
        "uint32" => return Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(span) }
        "uint64" => return Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(span) }
        "float32" => return Type { kind: TypeKind.Float32, provenance: Provenance.Inferred(span) }
        "float64" => return Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(span) }
        "bool" => return bool_ty(span)
        "char" => return Type { kind: TypeKind.Char, provenance: Provenance.Inferred(span) }
        "str" => return str_ty(span)
        _ => { }
    }
    if is_lang_name(name, string_name) { return string_name.lang_struct_ty(span) }
    return Type { kind: TypeKind.Struct(intern(name)), provenance: Provenance.Inferred(span) }
}

/// `Owner.Member` for a concrete owner. On a generic parameter or `Self`
/// inside a trait it is deferred, not an error.
fun resolve_projection(owner_ty: Type, member: Sym, span: Span, ctx: &var TypeCtx): Type {
    // Already reported.
    if owner_ty.is_poison() { return poison_ty() }
    // "" for a generic parameter or `Self`: deferred as a projection type until
    // Mono pins the owner.
    val owner_key = owner_ty.assoc_owner_key()
    if owner_key.as_str().equals("") { return projection_ty(owner_ty, member, span) }
    if owner_key.as_str().equals("Self") { return projection_ty(owner_ty, member, span) }

    val found = unsafe { (*ctx.sigs).count_assoc_bindings(owner_key.as_str(), member.as_str()) }
    // A mono-suffixed owner is an instance Mono has not materialized: defer.
    if found == 0 && !mangle_base_name(owner_key.clone()).as_str().equals(owner_key.as_str()) {
        return projection_ty(owner_ty, member, span)
    }
    if found == 0 {
        val message = "no associated type `${member.as_str()}` on `${owner_key.as_str()}`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
        return poison_ty()
    }
    if found > 1 {
        // Inside an impl, the impl says which instantiation `Self.Out` means;
        // elsewhere two bindings are genuinely ambiguous.
        if !ctx.impl_trait.as_str().equals("") {
            val tn = ctx.impl_trait.as_str()
            val ta = ctx.impl_trait_args.as_str()
            val here = unsafe { (*ctx.sigs).count_assoc_bindings_in(owner_key.as_str(), tn, ta, member.as_str()) }
            if here == 1 {
                return unsafe { (*ctx.sigs).lookup_assoc_binding_in(owner_key.as_str(), tn, ta, member.as_str()) }
            }
        }
        // Two traits may each declare `Item`; the projection is what is
        // reported.
        val message = "`${owner_key.as_str()}.${member.as_str()}` is ambiguous: more than one trait binds `${member.as_str()}` for `${owner_key.as_str()}`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
        return poison_ty()
    }
    return unsafe { (*ctx.sigs).lookup_assoc_binding(owner_key.as_str(), member.as_str()) }
}

/// Top-level only: `a: T`, not `List<T>`.
pub fun subst_all_generics(t: Type, names: &List<String>, args: &List<Type>): Type {
    var cur = t
    while i in 0..names.size() {
        if i < args.size() {
            cur = cur.subst_generic(*names.at(i), *args.at(i))
        }
    }
    return cur
}

/// Shallow copies of the TypeRefs.
pub fun clone_type_args(args: &List<TypeRef>): List<TypeRef> {
    var out = List.new<TypeRef>()
    while arg in &args {
        out.push(arg)
    }
    return out
}

pub fun instantiate_generic_layout(name: String, args: &List<TypeRef>, mangled: String, ctx: &var TypeCtx): void {
    val sp = ctx.sigs
    val sp_raw: uint64 = unsafe { sp as uint64 }
    if sp_raw == 0 { return }
    // Only a generic template.
    val gi = unsafe { sp.find_generic_info(name.as_str(), ctx.owner_crate) } ?: return
    if gi.type_params.size() != args.size() { return }
    // The instance is recorded before the already-instantiated check: the
    // registry says what a name means, the layout what it costs, and both are
    // needed.
    val have_i = unsafe { sp.find_inst(mangled.as_str()) }
    if have_i.is_none() {
        unsafe { sp.insert_inst(GenericInst { mangled: mangled.clone(), base: name.clone(), args: clone_type_args(args) }) }
    }
    val have_s = unsafe { sp.find_struct(mangled.as_str(), ctx.owner_crate) }
    if have_s.is_some() { return }
    val have_e = unsafe { sp.find_enum(mangled.as_str(), ctx.owner_crate) }
    if have_e.is_some() { return }
    var argtys = List.new<Type>()
    while targ in &args {
        argtys.push(targ.resolve_type_ref(ctx))
    }
    // Each argument must meet the template parameter's bounds, reported once
    // per instantiation.
    while bi in 0..gi.type_params.size() {
        if bi < argtys.size() {
            val bspan = args.at(bi).span
            check_generic_bounds(name.clone(), *gi.type_params.at(bi), *argtys.at(bi), bspan, ctx)
        }
    }
    when (unsafe { sp.find_struct(name.as_str(), ctx.owner_crate) }) {
        Some(tmpl) => {
            var fs = List.new<StructFieldInfo>()
            while f in &tmpl.fields {
                val cty = subst_all_generics(f.ty, gi.type_params, argtys)
                fs.push(StructFieldInfo { name: f.name, ty: cty, is_var: f.is_var })
            }
            unsafe { sp.insert_struct(StructLayout { name: mangled, fields: fs, is_refcounted: false, owner_crate: tmpl.owner_crate }) }
            return
        }
        None => { }
    }
    when (unsafe { sp.find_enum(name.as_str(), ctx.owner_crate) }) {
        Some(etmpl) => {
            var vs = List.new<VariantInfo>()
            while v in &etmpl.variants {
                var ptys = List.new<Type>()
                while item in &v.payloads {
                    val pty = subst_all_generics(item, gi.type_params, argtys)
                    // A `void` payload keeps its slot, so `Ok =>` and `Ok(u)` both
                    // work. CONSTRAINT: must agree with `clone_subst`, which builds
                    // the layout codegen emits.
                    ptys.push(pty)
                }
                vs.push(VariantInfo { name: v.name, payloads: ptys })
            }
            unsafe { sp.insert_enum(EnumLayout { name: mangled, variants: vs, owner_crate: etmpl.owner_crate }) }
            return
        }
        None => { }
    }
}
