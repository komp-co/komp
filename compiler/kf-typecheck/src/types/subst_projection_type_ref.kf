import kf_core.ast.types.TypeRef
import kf_core.ast.subst.monomorphized_type_name

fun subst_proj_tref_ptr_opt(popt: Ptr<TypeRef>?, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    val p = popt ?: return
    subst_proj_tref_ptr(p, self_name, trait_name, trait_args, sigs)
}

/// In place, nested positions included.
fun subst_proj_tref_ptr(p: Ptr<TypeRef>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    if unsafe { p as uint64 } == 0 { return }
    val tr = unsafe { *p }
    when (tr.kind) {
        Named(_n, args) => {
            while i in 0..args.size() {
                subst_proj_tref_ptr(unsafe { args.at_mut(i) as Ptr<TypeRef> }, self_name, trait_name, trait_args, sigs)
            }
        }
        DynTrait(_n, args) => {
            while i in 0..args.size() {
                subst_proj_tref_ptr(unsafe { args.at_mut(i) as Ptr<TypeRef> }, self_name, trait_name, trait_args, sigs)
            }
        }
        Reference(_is_mut, inner) => subst_proj_tref_ptr(inner, self_name, trait_name, trait_args, sigs)
        Array(elem, _n) => subst_proj_tref_ptr(elem, self_name, trait_name, trait_args, sigs)
        Function(ps, ret) => {
            while i in 0..ps.size() {
                subst_proj_tref_ptr(unsafe { ps.at_mut(i) as Ptr<TypeRef> }, self_name, trait_name, trait_args, sigs)
            }
            subst_proj_tref_ptr(ret, self_name, trait_name, trait_args, sigs)
        }
        Projection(owner, member) => {
            // Inside the owner first, so nested projections are reached.
            subst_proj_tref_ptr(owner, self_name, trait_name, trait_args, sigs)
            val key = projection_owner_key(unsafe { *owner }, self_name)
            if key.as_str().equals("") { return }
            // Qualified by the enclosing impl's instantiation where there is
            // one; unqualified, two `Index` impls leave it standing as `void*`.
            var n = unsafe { sigs.count_assoc_bindings_in(key.as_str(), trait_name, trait_args, member.as_str()) }
            var tn = trait_name
            var ta = trait_args
            if n != 1 {
                n = unsafe { sigs.count_assoc_bindings(key.as_str(), member.as_str()) }
                tn = ""
                ta = ""
            }
            if n != 1 { return }
            val chosen = unsafe { sigs.lookup_assoc_binding_tref_in(key.as_str(), tn, ta, member.as_str()) }
            when (chosen.kind) {
                // Already reported; splicing poison would lose the span.
                Poison => return
                _ => unsafe { *p = chosen }
            }
        }
        Value(_v) => return
        Poison => return
    }
}

/// The owner's registry key read from the syntax, since this runs without a
/// TypeCtx. Only a plain named owner resolves; anything else is "". Type
/// arguments are mangled in, keying the instance (`Box__int32`), not the
/// template, whose `type Out = T` would splice a bare `T`.
fun projection_owner_key(owner: TypeRef, self_name: str): String {
    when (owner.kind) {
        Named(n, args) => {
            // `Self` names the impl target, known only through `self_name`.
            if n.as_str().equals("Self") { return String.from(self_name) }
            return monomorphized_type_name(n.as_string(), &args)
        }
        _ => return ""
    }
}
