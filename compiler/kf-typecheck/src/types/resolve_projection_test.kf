// `Bag.Out` with two impls binding `Out`. First-match-wins would make the
// second impl's body fail for a different reason, which a `build: fail` case
// cannot tell apart; these assert the diagnostic itself.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.diagnostic.*
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx

fun projection_ref(owner_name: str, member: str): TypeRef {
    val owner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *owner = TypeRef.new(no_span(), TypeRefKind.Named(intern(owner_name), List.new<TypeRef>())) }
    return TypeRef.new(no_span(), TypeRefKind.Projection(owner, intern(member)))
}

fun sibling_binding(trait_name: str, chosen: Type, written: str): AssocBindingInfo {
    return AssocBindingInfo {
        type_name: String.from("Bag"),
        trait_name: String.from(trait_name),
        trait_args: "",
        assoc_name: String.from("Out"),
        chosen: chosen,
        chosen_tref: TypeRef.new(no_span(), TypeRefKind.Named(intern(written), List.new<TypeRef>()))
    }
}

pub struct ProjOutcome {
    pub val mangled: String
    pub val diags: uint64
    pub val message: String
}

/// `impl Left for Bag { type Out = int32 }` beside
/// `impl Right for Bag { type Out = bool }`, `Bag.Out` resolved inside
/// `enclosing_trait` ("" for neither). Only the enclosing impl separates them.
fun resolve_bag_out(enclosing_trait: str): ProjOutcome {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_assoc_binding(sibling_binding("Left", Type.new_int32(no_span()), "int32")) }
    unsafe { signatures.insert_assoc_binding(sibling_binding("Right", Type.new_bool(no_span()), "bool")) }

    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.impl_trait = String.from(enclosing_trait)
    val resolved = (projection_ref("Bag", "Out")).resolve_type_ref(&var ctx)

    var message = String.from("")
    val emitted = unsafe { diagnostics.size() }
    if emitted > 0 { message = unsafe { diagnostics.at(0).primary.message.clone() } }
    return ProjOutcome { mangled: mangle_type(resolved), diags: emitted, message: message }
}

@test
fun a_projection_outside_every_impl_is_reported_ambiguous(): void {
    val out = resolve_bag_out("")
    assert_eq(out.diags, 1, "an unqualifiable projection is diagnosed")
    // The message, not just that something was reported.
    assert_eq(out.message.as_str().contains("is ambiguous"), true, "and diagnosed as ambiguous")
    assert_eq(out.mangled.as_str(), "poison", "an ambiguous projection resolves to nothing")
}

@test
fun a_projection_inside_an_impl_reads_that_impls_choice(): void {
    val left = resolve_bag_out("Left")
    assert_eq(left.diags, 0, "the enclosing impl settles it, so nothing is reported")
    assert_eq(left.mangled.as_str(), "int32", "Left's own choice")
    // The other direction too.
    val right = resolve_bag_out("Right")
    assert_eq(right.diags, 0, "likewise from the other impl")
    assert_eq(right.mangled.as_str(), "bool", "Right's own choice")
}
