import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TypeParam

pub fun type_param_names(tps: &List<TypeParam>): List<String> {
    var out = List.new<String>()
    while tp in &tps {
        out.push(tp.name.as_string())
    }
    return out
}

pub mutating fun TypeCtx.seed_generics(names: List<String>): void {
    while name in &names {
        self.generics.push(name)
    }
}

pub fun TypeRef.tref_name_key(): String {
    when (self.kind) {
        Named(n, args) => {
            var text = n.as_string()
            while arg in &args {
                text = text + String.from("__") + (arg).tref_name_key()
            }
            return text
        }
        // The projection is in the dispatch suffix key, or two impls at
        // different members would share a name.
        Projection(owner, member) => {
            val inner = (unsafe { &*owner }).tref_name_key()
            return projection_mangle_frag(inner.as_str(), member.as_str())
        }
        // `Call1<&T>` keys as `kf__ref__T`; otherwise it would key as "",
        // the same as no arguments.
        Reference(is_mut, inner) => {
            return borrow_frag(is_mut, (unsafe { &*inner }).tref_name_key().as_str())
        }
        // `Make<T[2]>` keys its length as an instance name does.
        Value(v) => return value_frag(v)
        _ => return ""
    }
}

/// What a borrow key borrows, or "". The inverse of the `Reference` arm,
/// both spelled through `c_names.kf`. `ref_key_is_mut` answers mutability.
pub fun ref_key_inner(key: str): String {
    return borrow_frag_inner(key)
}

/// Only meaningful where `ref_key_inner` answered.
pub fun ref_key_is_mut(key: str): bool {
    return borrow_frag_is_mut(key)
}

/// Positional, so an argument can be matched to its parameter.
fun tref_arg_names(args: &List<TypeRef>): List<String> {
    var out = List.new<String>()
    while arg in &args {
        out.push((arg).tref_name_key())
    }
    return out
}

pub fun trait_args_key(args: &List<TypeRef>): String {
    var text = ""
    while i in 0..args.size() {
        if i > 0 { text = text + String.from("__") }
        text = text + (args.at(i)).tref_name_key()
    }
    return text
}

/// `type Iter: Iterator<T> + Clone` as (trait, args) pairs. A bound that is not
/// a named trait is dropped.
pub fun assoc_bound_reqs(bounds: &List<TypeRef>): List<AssocBoundReq> {
    var out = List.new<AssocBoundReq>()
    while bound in &bounds {
        when (bound.kind) {
            Named(name, args) => out.push(AssocBoundReq { trait_name: name.as_string(), trait_args: trait_args_key(&args), arg_names: tref_arg_names(&args) })
            _ => { }
        }
    }
    return out
}

pub fun trait_method_suffix(trait_ref: TypeRef, sigs: Ptr<SigTable>): String {
    when (trait_ref.kind) {
        Named(name, args) => {
            if args.size() == 0 && unsafe { (*sigs).is_auto_trait(name.as_str()) } { return "" }
            var suffix = name.as_string()
            val args_key = trait_args_key(&args)
            if !args_key.as_str().equals("") {
                suffix = suffix + String.from("__") + args_key
            }
            return suffix
        }
        _ => return ""
    }
}

/// A value parameter's bound is its type, not a trait; `register_value_params`
/// records it instead.
pub fun register_bounds(owner: String, tps: &List<TypeParam>, sig_ptr: Ptr<SigTable>): void {
    while tp in &tps {
        if tp.value_type(tps) != null { continue }
        while bound in &tp.bounds {
            when (bound.kind) {
                Named(name, args) => {
                    unsafe { sig_ptr.insert_bound(BoundInfo {
                        owner: owner.clone(),
                        param: tp.name.as_string(),
                        trait_name: name.as_string(),
                        trait_args: trait_args_key(&args),
                        arg_names: tref_arg_names(&args),
                        span: bound.span
                    }) }
                }
                _ => {}
            }
        }
    }
}

pub fun register_value_params(owner: String, tps: &List<TypeParam>, sig_ptr: Ptr<SigTable>): void {
    while tp in &tps {
        val value_type = tp.value_type(tps) ?: continue
        val info = ValueParamInfo { owner: owner.clone(), param: tp.name.as_string(), ty: value_type }
        unsafe { sig_ptr.value_params.push(info) }
    }
}
