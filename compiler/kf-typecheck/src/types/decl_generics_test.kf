// `tref_name_key` and `ref_key_inner` must agree; a wrong key matches nothing
// silently.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind

fun key_test_named(name: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun key_test_ref(inner: TypeRef, mutable: bool): TypeRef {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = inner }
    return TypeRef.new(no_span(), TypeRefKind.Reference(mutable, p))
}

@test fun a_borrow_keys_with_the_reserved_borrow_marker(): void {
    val key = (&key_test_ref(key_test_named("String"), false)).tref_name_key()
    assert_eq(key.as_str(), "kf__ref__String", "`&String` keys as `kf__ref__String`")
}

// Reserved-prefixed, so `struct Ref<T>` cannot collide.
@test fun a_borrow_does_not_key_as_a_declared_generic(): void {
    val borrowed = (&key_test_ref(key_test_named("String"), false)).tref_name_key()
    var args = List.new<TypeRef>()
    args.push(key_test_named("String"))
    val declared = (&TypeRef.new(no_span(), TypeRefKind.Named(intern("Ref"), args))).tref_name_key()
    assert_eq(borrowed.as_str().equals(declared.as_str()), false, "`&String` and `Ref<String>` are different keys")
}

// A borrow and the bare type key differently.
@test fun a_borrow_does_not_key_as_the_bare_type(): void {
    val borrowed = (&key_test_ref(key_test_named("String"), false)).tref_name_key()
    val bare = (&key_test_named("String")).tref_name_key()
    assert_eq(borrowed.as_str().equals(bare.as_str()), false, "`&String` and `String` are different keys")
    assert_eq(borrowed.as_str().equals(""), false, "`&String` does not key as the empty string")
}

// `&T` and `&var T` key differently.
@test fun mutability_is_in_the_key(): void {
    val shared = (&key_test_ref(key_test_named("Point"), false)).tref_name_key()
    val mutable = (&key_test_ref(key_test_named("Point"), true)).tref_name_key()
    assert_eq(shared.as_str(), "kf__ref__Point", "`&Point` keys shared")
    assert_eq(mutable.as_str(), "kf__mut__Point", "`&var Point` keys mutable")
    assert_eq(shared.as_str().equals(mutable.as_str()), false, "the two do not collapse onto one name")
}

@test fun a_borrowed_generic_argument_keys_through(): void {
    val key = (&key_test_ref(key_test_named("T"), false)).tref_name_key()
    assert_eq(key.as_str(), "kf__ref__T", "`&T` keys as `kf__ref__T`")
}

@test fun ref_key_inner_reads_back_what_tref_name_key_wrote(): void {
    val key = (&key_test_ref(key_test_named("String"), false)).tref_name_key()
    assert_eq(ref_key_inner(key.as_str()).as_str(), "String", "`kf__ref__String` borrows `String`")
    assert_eq(ref_key_is_mut(key.as_str()), false, "and borrows it shared")
}

// The decode reports mutability.
@test fun ref_key_reads_back_a_mutable_borrow(): void {
    val key = (&key_test_ref(key_test_named("String"), true)).tref_name_key()
    assert_eq(ref_key_inner(key.as_str()).as_str(), "String", "`kf__mut__String` borrows `String`")
    assert_eq(ref_key_is_mut(key.as_str()), true, "and borrows it mutably")
}

@test fun ref_key_inner_ignores_a_key_that_is_not_a_borrow(): void {
    assert_eq(ref_key_inner("String").as_str(), "", "a bare name is not a borrow")
    assert_eq(ref_key_inner("").as_str(), "", "the empty key is not a borrow")
    assert_eq(ref_key_inner("kf__reference").as_str(), "", "`kf__reference` is a name, not a borrow")
    assert_eq(ref_key_inner("kf__ref__").as_str(), "", "the marker with nothing after it borrows nothing")
    assert_eq(ref_key_inner("Ref__String").as_str(), "", "`Ref__String` is a declared generic's name now")
}

// An array's length is part of its key, so `T[2]` and `T[3]` differ.
@test fun a_value_argument_keys_as_its_value(): void {
    var args = List.new<TypeRef>()
    args.push(key_test_named("T"))
    args.push(TypeRef.new(no_span(), TypeRefKind.Value(2)))
    val key = (&TypeRef.new(no_span(), TypeRefKind.Named(intern("Array"), args))).tref_name_key()
    assert_eq(key.as_str(), "Array__T__2", "`Array<T, 2>` keys its length")
}
