// Names the checker could not resolve, reported here rather than surfacing as
// a cc error on the mangled name. Poison is still returned, so nothing
// reports the name twice.

import alloc.list.*

import kf_core.ast.*
import kf_core.span.*
import kf_core.diagnostic.error_at
import kf_core.diagnostic.with_fix

/// Names the generated C declares in every TU, which link with nothing in the
/// sig table.
/// CONSTRAINT: mirrors `emit_runtime_header` in kf-codegen, which this crate
/// cannot import; keep them in sync by hand. `runtime_intrinsic_ret` is the
/// smaller subset whose result types are modelled.
pub fun runtime_prelude_declares(name: str): bool {
    return when name {
        "kf_sym_intern" => true
        "kf_file_hash" => true
        "kf_sym_resolve" => true
        "kf_fs_dir_open" => true
        "kf_fs_dir_next" => true
        "kf_fs_dir_close" => true
        "str_equals" => true
        "str_as_str" => true
        "int64_display" => true
        "uint64_display" => true
        "runtime_print" => true
        "runtime_println" => true
        "is_dir" => true
        "join" => true
        "kf_arg_init" => true
        "kf_arg_count" => true
        "kf_arg_get" => true
        "kf_current_dir" => true
        "kf_self_dir" => true
        "kf_create_dir_all" => true
        "kf_temp_dir" => true
        "kf_remove_dir_all" => true
        "kf_process_status" => true
        "exit" => true
        _ => false
    }
}

/// Reported apart from undeclared variables: a missing function is usually a
/// typo or a missing import.
pub fun report_unknown_callee(name: str, span: Span, ctx: &var TypeCtx): void {
    if runtime_prelude_declares(name) { return }
    var msg = String.from("cannot find function `")
    msg = msg + String.from(name)
    msg = msg + String.from("` in this scope")
    val diag = error_at(span, msg)
    val home = sole_declaring_module(name, ctx)
    if home.as_str() == "" || span.is_none() {
        ctx.emit(diag)
        return
    }
    ctx.emit(with_fix(diag, import_insert_span(span.file_id, ctx), import_text(home.as_str(), span.file_id, ctx), import_title(home.as_str())))
}

/// "" when none or several declare it: one fix can name only one import, and
/// guessing may bind the wrong function.
fun sole_declaring_module(name: str, ctx: &var TypeCtx): String {
    var found = ""
    var seen = false
    val sigs = unsafe { (*ctx.sigs).sigs }
    while sg in &sigs {
        if sg.name.as_str().equals(name) {
            val owner = String.from(sg.owner_module.as_str())
            if owner.as_str() == "" { return "" }
            if seen {
                if !owner.as_str().equals(found.as_str()) { return "" }
            } else {
                found = owner
                seen = true
            }
        }
    }
    return found
}

/// Zero-width: replacing nothing inserts.
fun import_insert_span(file: uint32, ctx: &var TypeCtx): Span {
    val at = import_insert_at(ctx.sigs, file)
    return Span { file_id: file, start: at, end: at }
}

/// After an existing block it opens with a newline; at the top of a file it
/// closes with a blank line.
fun import_text(module_path: str, file: uint32, ctx: &var TypeCtx): String {
    var out = ""
    if import_insert_at(ctx.sigs, file) == 0 {
        out.append("import ")
        out.append(module_path)
        out.append(".*\n\n")
        return out
    }
    out.append("\nimport ")
    out.append(module_path)
    out.append(".*")
    return out
}

fun import_title(module_path: str): String {
    val t = "add `import ${module_path}.*`"
    return t
}

/// Consults only locals (params, bindings, pattern binders). Type-name
/// receivers are peeked before walking, so one arriving here is a gap in
/// receiver recognition, not a false alarm.
pub fun report_undeclared_variable(name: str, span: Span, ctx: &var TypeCtx): void {
    // `null` parses as a Variable and is judged at the end of the body, once
    // its slot has had a chance to type it.
    if name.equals("null") {
        note_null_seen(span, ctx)
        return
    }
    var msg = String.from("cannot find value `")
    msg = msg + String.from(name)
    msg = msg + String.from("` in this scope")
    ctx.emit(error_at(span, msg))
}

// `null` takes its type from a slot applied after it is walked, so it is
// remembered here; one no Option slot claimed by the end of the body is
// reported. Two append-only lists, since List has no remove.

pub fun note_null_seen(span: Span, ctx: &var TypeCtx): void {
    if span_list_contains(&ctx.nulls_seen, span) { return }
    ctx.nulls_seen.push(span)
}

/// Claimed by an Option slot: it is `Option.None` now.
pub fun note_null_typed(span: Span, ctx: &var TypeCtx): void {
    if span_list_contains(&ctx.nulls_typed, span) { return }
    ctx.nulls_typed.push(span)
}

/// Once, at the end of the body.
pub mutating fun TypeCtx.report_untyped_nulls(): void {
    var i = 0
    while i < self.nulls_seen.size() {
        val span = self.nulls_seen.get(i)
        if !span_list_contains(&self.nulls_typed, span) {
            self.emit(error_at(span, String.from("`null` has no type here — annotate the binding, or use it where an optional type is expected")))
        }
        i = i + 1
    }
}

/// An integer literal `int32` cannot hold, which only a slot may still size.
pub fun note_wide_literal_seen(span: Span, ctx: &var TypeCtx): void {
    if span_list_contains(&ctx.wide_literals_seen, span) { return }
    ctx.wide_literals_seen.push(span)
}

/// Given a type, converted by a cast, or already reported.
pub fun note_literal_sized(span: Span, ctx: &var TypeCtx): void {
    if span_list_contains(&ctx.wide_literals_sized, span) { return }
    ctx.wide_literals_sized.push(span)
}

/// Once, at the end of the body: a wide literal nothing sized is an `int32`.
pub mutating fun TypeCtx.report_unsized_wide_literals(): void {
    while span in &self.wide_literals_seen {
        if !span_list_contains(&self.wide_literals_sized, span) {
            self.emit(error_at(span, String.from("integer literal is out of range for `int32`")))
        }
    }
}

fun span_list_contains(spans: &List<Span>, span: Span): bool {
    while s in &spans {
        if s.file_id == span.file_id && s.start == span.start && s.end == span.end { return true }
    }
    return false
}

// `List.new()` is the same shape as `null`: its type arguments can only come
// from a slot applied later, and unclaimed it would reach cc as the
// unsubstituted `List__T`.

pub struct OpenGenericCall {
    pub var span: Span
    pub var base: String
    pub var method: String
}

pub fun note_open_call(span: Span, base: String, method: String, ctx: &var TypeCtx): void {
    if open_call_recorded(&ctx.open_calls, span) { return }
    ctx.open_calls.push(OpenGenericCall { span: span, base: base, method: method })
}

fun open_call_recorded(calls: &List<OpenGenericCall>, span: Span): bool {
    while c in &calls {
        if c.span.file_id == span.file_id && c.span.start == span.start && c.span.end == span.end { return true }
    }
    return false
}

/// Recorded as open and not typed since.
pub fun open_call_pending(span: Span, ctx: &TypeCtx): bool {
    return open_call_recorded(&ctx.open_calls, span) && !span_list_contains(&ctx.open_typed, span)
}

pub fun note_open_call_typed(span: Span, ctx: &var TypeCtx): void {
    if span_list_contains(&ctx.open_typed, span) { return }
    ctx.open_typed.push(span)
}

/// Once, at the end of the body.
pub mutating fun TypeCtx.report_open_calls(): void {
    var i = 0
    while i < self.open_calls.size() {
        val open = self.open_calls.at(i)
        if !span_list_contains(&self.open_typed, open.span) && span_list_contains(&self.list_literals, open.span) {
            val what = "cannot tell what `[]` holds"
            val repair = "annotate the binding (`val xs: List<int32> = []`), or push to it first"
            self.emit(error_at(open.span, "${what} — ${repair}"))
        } else if !span_list_contains(&self.open_typed, open.span) {
            var msg = String.from("cannot tell what `")
            msg.append(open.base.as_str())
            msg.append(".")
            msg.append(open.method.as_str())
            msg.append("()` is over — write the type argument (`")
            msg.append(open.base.as_str())
            msg.append(".")
            msg.append(open.method.as_str())
            msg.append("<...>()`), or annotate the binding")
            self.emit(error_at(open.span, msg))
        }
        i = i + 1
    }
}
