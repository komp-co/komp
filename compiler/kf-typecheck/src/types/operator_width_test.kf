import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.*
import kf_core.diagnostic.*
import kf_resolve.*
import kf_typecheck.*
import kf_typecheck.check.check_expr
import kf_typecheck.leaked_diagnostics

fun operator_width_ctx(): TypeCtx {
    val declarations: Ptr<DeclTable> = unsafe { alloc<DeclTable>() }
    unsafe { *declarations = new_decl_table() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("uint8"), receiver_identity: intern("uint8"), trait_name: String.from("Equal"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("uint64"), receiver_identity: intern("uint64"), trait_name: String.from("Equal"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("uint8"), receiver_identity: intern("uint8"), trait_name: String.from("Compare"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("uint64"), receiver_identity: intern("uint64"), trait_name: String.from("Compare"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("int64"), receiver_identity: intern("int64"), trait_name: String.from("Equal"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { (*signatures).note_lang_trait("equal", intern("Equal")) }
    unsafe { (*signatures).note_lang_trait("compare", intern("Compare")) }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, declarations, signatures)
}

fun operator_width_var(name: str, kind: TypeKind): Ptr<Expr> {
    val expression: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *expression = Expr.new(no_span(), ExprKind.Variable(intern(name))) }
    unsafe { expression.ty = Type { kind: kind, provenance: Provenance.Declared(no_span()) } }
    return expression
}

fun check_mixed_width(op: BinOp, left_kind: TypeKind, right_kind: TypeKind): bool {
    var ctx = operator_width_ctx()
    val left = operator_width_var("left", left_kind)
    val right = operator_width_var("right", right_kind)
    ctx.declare(String.from("left"), unsafe { left.ty.clone() })
    ctx.declare(String.from("right"), unsafe { right.ty.clone() })
    var expression = Expr.new(no_span(), ExprKind.Binary(left, op, right))
    check_expr(&var expression, &var ctx)
    return expression.ty.is_poison()
}

fun mixed_width_diagnostic_count(op: BinOp): uint64 {
    var ctx = operator_width_ctx()
    val left = operator_width_var("left", TypeKind.UInt8)
    val right = operator_width_var("right", TypeKind.UInt64)
    ctx.declare(String.from("left"), unsafe { left.ty.clone() })
    ctx.declare(String.from("right"), unsafe { right.ty.clone() })
    var expression = Expr.new(no_span(), ExprKind.Binary(left, op, right))
    check_expr(&var expression, &var ctx)
    return ctx.diags.items.size()
}

fun check_wide_value_with_literal(op: BinOp, literal_left: bool): bool {
    var ctx = operator_width_ctx()
    val value = operator_width_var("value", TypeKind.UInt64)
    ctx.declare(String.from("value"), unsafe { value.ty.clone() })
    var left = value
    var right = ep(ExprKind.LitInt(0))
    if literal_left {
        left = ep(ExprKind.LitInt(0))
        right = value
    }
    var expression = Expr.new(no_span(), ExprKind.Binary(left, op, right))
    check_expr(&var expression, &var ctx)
    return !expression.ty.is_poison()
}

fun check_int64_with_negative_literal(literal_left: bool): bool {
    var ctx = operator_width_ctx()
    val value = operator_width_var("value", TypeKind.Int64)
    ctx.declare(String.from("value"), unsafe { value.ty.clone() })
    val negative = ep(ExprKind.Unary(UnaryOp.Neg, ep(ExprKind.LitInt(1))))
    var left = value
    var right = negative
    if literal_left {
        left = negative
        right = value
    }
    var expression = Expr.new(no_span(), ExprKind.Binary(left, BinOp.Eq, right))
    check_expr(&var expression, &var ctx)
    return !expression.ty.is_poison()
}

fun out_of_range_uint8_literal_is_rejected(): bool {
    var ctx = operator_width_ctx()
    val value = operator_width_var("value", TypeKind.UInt8)
    ctx.declare(String.from("value"), unsafe { value.ty.clone() })
    val literal = ep(ExprKind.LitInt(511))
    var expression = Expr.new(no_span(), ExprKind.Binary(value, BinOp.Eq, literal))
    check_expr(&var expression, &var ctx)
    return expression.ty.is_poison()
}

@test fun mixed_width_equality_rejects_narrow_left(): void {
    assert_eq(check_mixed_width(BinOp.Eq, TypeKind.UInt8, TypeKind.UInt64), true, "mixed-width equality is rejected")
}

@test fun mixed_width_equality_rejects_wide_left(): void {
    assert_eq(check_mixed_width(BinOp.Eq, TypeKind.UInt64, TypeKind.UInt8), true, "reversed mixed-width equality is rejected")
}

@test fun mixed_width_ordering_rejects_narrow_left(): void {
    assert_eq(check_mixed_width(BinOp.Lt, TypeKind.UInt8, TypeKind.UInt64), true, "mixed-width ordering is rejected")
}

@test fun mixed_width_ordering_rejects_wide_left(): void {
    assert_eq(check_mixed_width(BinOp.Lt, TypeKind.UInt64, TypeKind.UInt8), true, "reversed mixed-width ordering is rejected")
}

@test fun mixed_width_operator_emits_a_diagnostic(): void {
    assert_eq(mixed_width_diagnostic_count(BinOp.Eq), 1, "mixed-width operator reports one error")
}

@test fun equality_coerces_a_literal_to_the_left_width(): void {
    assert_eq(check_wide_value_with_literal(BinOp.Eq, false), true, "right literal equality uses the value width")
}

@test fun ordering_coerces_a_literal_to_the_left_width(): void {
    assert_eq(check_wide_value_with_literal(BinOp.Gt, false), true, "right literal ordering uses the value width")
}

@test fun equality_coerces_a_left_literal_to_the_value_width(): void {
    assert_eq(check_wide_value_with_literal(BinOp.Eq, true), true, "left literal equality uses the value width")
}

@test fun negative_literal_uses_the_right_value_width(): void {
    assert_eq(check_int64_with_negative_literal(true), true, "left negative literal uses the value width")
}

@test fun negative_literal_uses_the_left_value_width(): void {
    assert_eq(check_int64_with_negative_literal(false), true, "right negative literal uses the value width")
}

@test fun uint8_rejects_an_out_of_range_literal(): void {
    assert_eq(out_of_range_uint8_literal_is_rejected(), true, "uint8 rejects 511")
}

@test fun mixed_width_add_rejects_narrow_left(): void {
    assert_eq(check_mixed_width(BinOp.Add, TypeKind.UInt8, TypeKind.UInt64), true, "mixed-width addition is rejected")
}

@test fun mixed_width_add_rejects_wide_left(): void {
    assert_eq(check_mixed_width(BinOp.Add, TypeKind.UInt64, TypeKind.UInt8), true, "reversed mixed-width addition is rejected")
}

@test fun mixed_width_bit_and_rejects_narrow_left(): void {
    assert_eq(check_mixed_width(BinOp.BitAnd, TypeKind.UInt8, TypeKind.UInt64), true, "mixed-width bitwise is rejected")
}

@test fun mixed_width_bit_and_rejects_wide_left(): void {
    assert_eq(check_mixed_width(BinOp.BitAnd, TypeKind.UInt64, TypeKind.UInt8), true, "reversed mixed-width bitwise is rejected")
}

@test fun mixed_width_shift_rejects_narrow_left(): void {
    assert_eq(check_mixed_width(BinOp.Shl, TypeKind.UInt8, TypeKind.UInt64), true, "mixed-width shift is rejected")
}

@test fun mixed_width_shift_rejects_wide_left(): void {
    assert_eq(check_mixed_width(BinOp.Shl, TypeKind.UInt64, TypeKind.UInt8), true, "reversed mixed-width shift is rejected")
}

@test fun mixed_width_add_emits_a_diagnostic(): void {
    assert_eq(mixed_width_diagnostic_count(BinOp.Add), 1, "mixed-width addition reports one error")
}

@test fun mixed_width_bitwise_emits_a_diagnostic(): void {
    assert_eq(mixed_width_diagnostic_count(BinOp.BitAnd), 1, "mixed-width bitwise reports one error")
}

@test fun mixed_width_shift_emits_a_diagnostic(): void {
    assert_eq(mixed_width_diagnostic_count(BinOp.Shl), 1, "mixed-width shift reports one error")
}
