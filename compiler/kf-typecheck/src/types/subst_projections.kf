// Replaces resolved associated-type projections with the impl's choice, since
// neither Mono nor Codegen can resolve one: a signature keeping one emits
// `/* poison */ void`. A projection as a type argument is folded into a
// mangled name (`List__Proj__F__Out__EndProj`), so the name and the dispatch
// symbols built from it are rewritten instead.
//
// Runs at the end of typecheck and again in Mono after materialization, when
// generic owners become concrete. What neither resolves is left as written.
//
// CONSTRAINT: every List travels by borrow. A by-value List is auto-cloned,
// so the walk would rewrite a copy, silently for everything but impl methods.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_typecheck.traits.trait_ref_head_name
import kf_typecheck.traits.trait_ref_args_key
import kf_typecheck.traits.assoc_owner_key
import kf_typecheck.check.autoderef_ty
import kf_core.ast.dyn_meta.dyn_trait_type

pub mutating fun Module.subst_projections_module(sigs: Ptr<SigTable>): void {
    while i in 0..self.decls.size() {
        subst_projections_decl(self.decls.at_mut(i), "", "", "", sigs)
    }
}

/// One declaration, for Mono: a projection still standing when Mono scans a
/// clone would be folded into an instance name before the module pass runs.
pub mutating fun TopDecl.subst_projections_in_decl(sigs: Ptr<SigTable>): void {
    subst_projections_decl(unsafe { self as Ptr<TopDecl> }, "", "", "", sigs)
}

fun subst_projections_decl(tp: Ptr<TopDecl>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    val td = unsafe { *tp }
    when (td.kind) {
        Function(params, ret_ptr, body, _p, _u, _mut, _s) => {
            subst_proj_params(params, self_name, trait_name, trait_args, sigs)
            subst_proj_tref_ptr(ret_ptr, self_name, trait_name, trait_args, sigs)
            subst_proj_stmts(&body, self_name, trait_name, trait_args, sigs)
        }
        Extern(params, ret_ptr, _p, _u) => {
            subst_proj_params(params, self_name, trait_name, trait_args, sigs)
            subst_proj_tref_ptr(ret_ptr, self_name, trait_name, trait_args, sigs)
        }
        Struct(fields, _is_pub) => {
            while field in &fields {
                subst_proj_tref_ptr(field.ty, self_name, trait_name, trait_args, sigs)
            }
        }
        EnumDecl(variants, _is_pub) => {
            while i in 0..variants.size() {
                val v = variants.at_mut(i)
                var j = 0
                while j < v.payloads.size() {
                    subst_proj_tref_ptr(unsafe { v.payloads.at_mut(j) as Ptr<TypeRef> }, self_name, trait_name, trait_args, sigs)
                    j = j + 1
                }
            }
        }
        // Inside an impl, `Self` is the target.
        ImplBlock(methods) => subst_proj_members(methods, td.name.as_str(), "", "", sigs)
        TraitImpl(tref, methods) => {
            // The trait's arguments too, which the dispatch suffix is mangled
            // from.
            subst_proj_tref_ptr(tref, td.name.as_str(), "", "", sigs)
            // Which instantiation, or a type with two binds a name twice and
            // the projection reaches codegen as `void*`.
            subst_proj_members(methods, td.name.as_str(), trait_ref_head_name(unsafe { *tref }).as_str(), trait_ref_args_key(unsafe { *tref }).as_str(), sigs)
        }
        // Inside a trait, `Self` is unknown: left for Mono.
        TraitDecl(methods, _is_pub, _) => subst_proj_members(methods, "", "", "", sigs)
        _ => { }
    }
}

fun subst_proj_members(members: &var List<TopDecl>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    while i in 0..members.size() {
        subst_projections_decl(unsafe { members.at_mut(i) as Ptr<TopDecl> }, self_name, trait_name, trait_args, sigs)
    }
}

fun subst_proj_params(params: &List<Param>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    while param in &params {
        subst_proj_tref_ptr(param.ty, self_name, trait_name, trait_args, sigs)
    }
}

// Only the positions holding a TypeRef: let annotations, casts, and call type
// arguments.

fun subst_proj_stmts(stmts: &var List<Stmt>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    while i in 0..stmts.size() {
        // In place, so the module keeps the rewrite.
        (stmts.at_mut(i)).subst_proj_stmt(self_name, trait_name, trait_args, sigs)
    }
}

mutating fun Stmt.subst_proj_stmt(self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    when (self.kind) {
        LetVal(_n, ty_p, init_p) => {
            subst_proj_tref_ptr_opt(ty_p.view(), self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(init_p.view(), self_name, trait_name, trait_args, sigs)
        }
        LetVar(_n, ty_p, init_p) => {
            subst_proj_tref_ptr_opt(ty_p.view(), self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(init_p.view(), self_name, trait_name, trait_args, sigs)
        }
        Assign(_n, ep) => subst_proj_expr_ptr_opt(ep, self_name, trait_name, trait_args, sigs)
        AssignTo(pp, ep) => {
            subst_proj_expr_ptr_opt(pp, self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(ep, self_name, trait_name, trait_args, sigs)
        }
        Return(ep) => {
            val p = ep ?: return
            subst_proj_expr_ptr_opt(p, self_name, trait_name, trait_args, sigs)
        }
        If(cp, then_body, else_body) => {
            subst_proj_expr_ptr_opt(cp, self_name, trait_name, trait_args, sigs)
            subst_proj_stmts(then_body, self_name, trait_name, trait_args, sigs)
            subst_proj_stmts(else_body, self_name, trait_name, trait_args, sigs)
        }
        While(cp, body) => {
            subst_proj_expr_ptr_opt(cp, self_name, trait_name, trait_args, sigs)
            subst_proj_stmts(body, self_name, trait_name, trait_args, sigs)
        }
        When(subj, arms) => {
            subst_proj_expr_ptr_opt(subj, self_name, trait_name, trait_args, sigs)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                subst_proj_expr_ptr_opt(a.guard.view(), self_name, trait_name, trait_args, sigs)
                subst_proj_stmts(&var a.body, self_name, trait_name, trait_args, sigs)
            }
        }
        Switch(subj, sarms) => {
            subst_proj_expr_ptr_opt(subj, self_name, trait_name, trait_args, sigs)
            while i in 0..sarms.size() {
                subst_proj_expr_ptr_opt(sarms.at(i).guard.view(), self_name, trait_name, trait_args, sigs)
                subst_proj_stmts(&var sarms.at_mut(i).body, self_name, trait_name, trait_args, sigs)
            }
        }
        Expression(ep) => subst_proj_expr_ptr_opt(ep, self_name, trait_name, trait_args, sigs)
        _ => return
    }
}

fun subst_proj_expr_ptr_opt(p_opt: Ptr<Expr>?, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    val p = p_opt ?: return
    val e = unsafe { *p }
    while i in 0..e.type_args.size() {
        subst_proj_tref_ptr(unsafe { p.type_args.at_mut(i) as Ptr<TypeRef> }, self_name, trait_name, trait_args, sigs)
    }
    // The expression's inferred type, which has no TypeRef: `c.make()` through
    // `C: Producer` is typed `C.Out`.
    unsafe { p.ty = e.ty.resolved_projection_type(self_name, sigs) }
    // The dispatch symbol folds the projection too.
    unsafe { p.mangled_callee = e.mangled_callee.resolved_proj_name(self_name, sigs) }
    complete_pending_callee(p, self_name, sigs)
    when (e.kind) {
        Cast(ip, tp) => {
            subst_proj_expr_ptr_opt(ip, self_name, trait_name, trait_args, sigs)
            subst_proj_tref_ptr(tp, self_name, trait_name, trait_args, sigs)
        }
        Binary(lp, _op, rp) => {
            subst_proj_expr_ptr_opt(lp, self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(rp, self_name, trait_name, trait_args, sigs)
        }
        Unary(_o, ip) => subst_proj_expr_ptr_opt(ip, self_name, trait_name, trait_args, sigs)
        Deref(ip) => subst_proj_expr_ptr_opt(ip, self_name, trait_name, trait_args, sigs)
        DynCoerce(ip, _vtable) => subst_proj_expr_ptr_opt(ip, self_name, trait_name, trait_args, sigs)
        Retain(ip) => subst_proj_expr_ptr_opt(ip, self_name, trait_name, trait_args, sigs)
        FieldAccess(rp, _f) => subst_proj_expr_ptr_opt(rp, self_name, trait_name, trait_args, sigs)
        Call(_n, args) => subst_proj_expr_list(args, self_name, trait_name, trait_args, sigs)
        Intrinsic(_i, args) => subst_proj_expr_list(args, self_name, trait_name, trait_args, sigs)
        CallValue(_callee, args) => subst_proj_expr_list(args, self_name, trait_name, trait_args, sigs)
        MethodCall(rp, _mn, args) => {
            subst_proj_expr_ptr_opt(rp, self_name, trait_name, trait_args, sigs)
            subst_proj_expr_list(args, self_name, trait_name, trait_args, sigs)
        }
        IfExpr(cp, tp2, ep2) => {
            subst_proj_expr_ptr_opt(cp, self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(tp2, self_name, trait_name, trait_args, sigs)
            subst_proj_expr_ptr_opt(ep2, self_name, trait_name, trait_args, sigs)
        }
        StructLit(_sn, finits) => {
            while finit in &finits {
                subst_proj_expr_ptr_opt(finit.value, self_name, trait_name, trait_args, sigs)
            }
        }
        _ => return
    }
}

fun subst_proj_expr_list(args: &var List<Expr>, self_name: str, trait_name: str, trait_args: str, sigs: Ptr<SigTable>): void {
    while i in 0..args.size() {
        subst_proj_expr_ptr_opt(unsafe { args.at_mut(i) as Ptr<Expr> }, self_name, trait_name, trait_args, sigs)
    }
}

pub fun Type.resolved_projection_type(self_name: str, sigs: Ptr<SigTable>): Type {
    when (self.kind) {
        Projection(owner, member) => {
            val inner = resolved_projection_type(unsafe { &*owner }, self_name, sigs)
            val key = inner.projection_type_owner_key(self_name)
            if key.as_str().equals("") { return self.rebuilt_projection(inner, member) }
            if unsafe { sigs.count_assoc_bindings(key.as_str(), member.as_str()) } != 1 {
                return self.rebuilt_projection(inner, member)
            }
            val chosen = unsafe { sigs.lookup_assoc_binding(key.as_str(), member.as_str()) }
            // A poison choice was already reported; the projection is kept for
            // a later run.
            if chosen.is_poison() { return self.rebuilt_projection(inner, member) }
            return chosen
        }
        DynTraitTy(object) => {
            var args = List.new<Type>()
            val source_args = unsafe { object.args }
            var i = 0
            while i < unsafe { source_args.size() } {
                val argument = unsafe { source_args.get(i) }
                args.push(argument.resolved_projection_type(self_name, sigs))
                i = i + 1
            }
            val rebuilt = dyn_trait_type(unsafe { object.principal }, args, no_span())
            return Type { kind: rebuilt.kind, provenance: self.provenance }
        }
        PtrTo(p) => {
            val inner = resolved_projection_type(unsafe { &*p }, self_name, sigs)
            val np = type_node(inner)
            return Type { kind: TypeKind.PtrTo(np), provenance: self.provenance }
        }
        BoxOf(p) => {
            val inner = resolved_projection_type(unsafe { &*p }, self_name, sigs)
            val np = type_node(inner)
            return Type { kind: TypeKind.BoxOf(np), provenance: self.provenance }
        }
        RefTo(m, p) => {
            val inner = resolved_projection_type(unsafe { &*p }, self_name, sigs)
            val np = type_node(inner)
            return Type { kind: TypeKind.RefTo(m, np), provenance: self.provenance }
        }
        // As a type argument the projection lives in the instance name.
        Struct(n) => {
            if !name_has_projection_marker(n.as_str()) { return (*self) }
            val nn = resolved_proj_segments(n.as_str(), self_name, sigs)
            return Type { kind: TypeKind.Struct(intern(nn.as_str())), provenance: self.provenance }
        }
        EnumTy(n) => {
            if !name_has_projection_marker(n.as_str()) { return (*self) }
            val nn = resolved_proj_segments(n.as_str(), self_name, sigs)
            return Type { kind: TypeKind.EnumTy(intern(nn.as_str())), provenance: self.provenance }
        }
        _ => return (*self)
    }
}

/// Every resolvable `Proj__<owner>__<member>__EndProj` replaced by the impl's
/// choice (`List__Proj__Inc__Out__EndProj` -> `List__int32`); others copied
/// through. A projection nested in another's owner resolves on a later pass.
fun resolved_proj_segments(mangled: str, self_name: str, sigs: Ptr<SigTable>): String {
    val segs = mangle_segments(mangled)
    var out = ""
    var emitted = false
    var i = 0
    while i < segs.size() {
        var seg = *segs.at(i)
        var step = 1
        if is_projection_open(seg.as_str()) {
            val close = projection_close_index(&segs, i)
            // `Proj__<owner segments>__<member>__EndProj`.
            if close > i + 2 {
                var owner = joined_segments(&segs, i + 1, close - 1)
                // Inside an impl, `Self` names the target.
                if owner.as_str().equals("Self") { owner = String.from(self_name) }
                val member = *segs.at(close - 1)
                if unsafe { sigs.count_assoc_bindings(owner.as_str(), member.as_str()) } == 1 {
                    val chosen = unsafe { sigs.lookup_assoc_binding(owner.as_str(), member.as_str()) }
                    // A poison choice was already reported; kept for later.
                    if !chosen.is_poison() {
                        seg = mangle_type(chosen)
                        seg.append(projection_close_tail(segs.at(close).as_str()).as_str())
                        step = close + 1 - i
                    }
                }
            }
        }
        if emitted { out.append("__") }
        out.append(seg.as_str())
        emitted = true
        i = i + step
    }
    return out
}

/// Unchanged when it holds none.
fun Sym.resolved_proj_name(self_name: str, sigs: Ptr<SigTable>): Sym {
    if !name_has_projection_marker(self.as_str()) { return Sym { id: self.id } }
    return intern(resolved_proj_segments(self.as_str(), self_name, sigs).as_str())
}

/// For a mangled name being built rather than rewritten.
pub fun resolved_proj_mangle(name: str, sigs: Ptr<SigTable>): String {
    if !name_has_projection_marker(name) { return String.from(name) }
    return resolved_proj_segments(name, "", sigs)
}

/// Segments `[start, end)` joined with `__`.
fun joined_segments(segs: &List<String>, start: uint64, end: uint64): String {
    var out = ""
    var i = start
    while i < end {
        if i > start { out.append("__") }
        out.append(segs.at(i).as_str())
        i = i + 1
    }
    return out
}

/// A fresh owner node: the caller's Type is dropped independently.
fun Type.rebuilt_projection(owner: Type, member: Sym): Type {
    val np = type_node(owner)
    return Type { kind: TypeKind.Projection(np, member), provenance: self.provenance }
}

/// `Self` keys as the impl target; a generic parameter keys nothing.
fun Type.projection_type_owner_key(self_name: str): String {
    when (self.kind) {
        Generic(n) => {
            if n.as_str().equals("Self") { return String.from(self_name) }
            return ""
        }
        Struct(n) => {
            val display = type_identity_display(n)
            if display.as_str().equals("Self") { return String.from(self_name) }
            return self.assoc_owner_key()
        }
        EnumTy(_n) => return self.assoc_owner_key()
        _ => return ""
    }
}

// A trait-impl method called on a projection receiver was recorded with its
// type half pending behind a `.`; once the receiver resolves, the name is
// finished.

fun complete_pending_callee(p: Ptr<Expr>, self_name: str, sigs: Ptr<SigTable>): void {
    val e = unsafe { *p }
    val callee = e.mangled_callee.as_str()
    if callee.byte_len() == 0 { return }
    if callee.byte_at(0) != 46 { return }
    when (e.kind) {
        MethodCall(rp, _mn, _args) => {
            if unsafe { rp as uint64 } == 0 { return }
            val recv_ty = resolved_projection_type(unsafe { &rp.ty }, self_name, sigs)
            val owner = recv_ty.dispatch_owner_name()
            // Still abstract: left for a later run.
            if owner.as_str().equals("") { return }
            val n = callee.byte_len()
            val tail = callee.substring(1, n)
            var full = owner
            full.append(tail.as_str())
            unsafe { p.mangled_callee = intern(full.as_str()) }
        }
        _ => return
    }
}

/// "" while not a concrete named type.
fun Type.dispatch_owner_name(): String {
    val inner = autoderef_ty(self.clone())
    return when (inner.kind) {
        Struct(n) => type_identity_display(n)
        EnumTy(n) => type_identity_display(n)
        _ => ""
    }
}
