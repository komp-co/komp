// Type equality (structural) and tags.

import kf_core.ast.*
import kf_core.span.no_span

fun TAG_INT8(): uint64 { return 0 }
fun TAG_INT16(): uint64 { return 1 }
fun TAG_INT32(): uint64 { return 2 }
pub fun TAG_INT64(): uint64 { return 3 }
fun TAG_UINT8(): uint64 { return 4 }
fun TAG_UINT16(): uint64 { return 5 }
fun TAG_UINT32(): uint64 { return 6 }
fun TAG_UINT64(): uint64 { return 7 }
fun TAG_FLOAT32(): uint64 { return 8 }
fun TAG_FLOAT64(): uint64 { return 9 }
fun TAG_BOOL(): uint64 { return 10 }
fun TAG_CHAR(): uint64 { return 11 }
pub fun TAG_STR(): uint64 { return 12 }
pub fun TAG_VOID(): uint64 { return 14 }
fun TAG_NEVER(): uint64 { return 15 }
pub fun TAG_STRUCT(): uint64 { return 16 }
pub fun TAG_ENUM(): uint64 { return 17 }
fun TAG_TRAIT(): uint64 { return 18 }
pub fun TAG_GENERIC(): uint64 { return 19 }
pub fun TAG_PTR(): uint64 { return 20 }
pub fun TAG_REF(): uint64 { return 22 }
fun TAG_FN(): uint64 { return 23 }
fun TAG_POISON(): uint64 { return 24 }
fun TAG_BOX(): uint64 { return 25 }
pub fun TAG_PROJECTION(): uint64 { return 26 }
fun TAG_DYN_TRAIT(): uint64 { return 27 }
pub fun TAG_ARRAY(): uint64 { return 28 }

pub fun Type.type_eq(b: &Type): bool {
    if self.is_poison() || b.is_poison() {
        return true
    }
    val ak: TypeKind = self.kind
    val bk: TypeKind = b.kind
    return ak.kind_eq_flat(bk)
}

fun TypeKind.kind_eq_flat(b: TypeKind): bool {
    if self.kind_tag() == TAG_NEVER() { return true }
    if b.kind_tag() == TAG_NEVER() { return true }
    // A Struct and an EnumTy of one name are equal: types resolve enums to
    // Struct while variant construction yields EnumTy.
    if self.kind_tag() == TAG_STRUCT() && b.kind_tag() == TAG_ENUM() {
        return self.coerce_struct_name().as_str().equals(b.coerce_enum_name().as_str())
    }
    if self.kind_tag() == TAG_ENUM() && b.kind_tag() == TAG_STRUCT() {
        return self.coerce_enum_name().as_str().equals(b.coerce_struct_name().as_str())
    }
    if self.kind_tag() != b.kind_tag() { return false }
    val tag: uint64 = self.kind_tag()
    if tag == TAG_STRUCT() {
        val an: String = self.coerce_struct_name()
        val bn: String = b.coerce_struct_name()
        return an.as_str().equals(bn.as_str())
    }
    if tag == TAG_ENUM() {
        val an: String = self.coerce_enum_name()
        val bn: String = b.coerce_enum_name()
        return an.as_str().equals(bn.as_str())
    }
    if tag == TAG_TRAIT() {
        val an: String = self.coerce_trait_name()
        val bn: String = b.coerce_trait_name()
        return an.as_str().equals(bn.as_str())
    }
    if tag == TAG_DYN_TRAIT() { return self.dyn_kind_eq(b) }
    if tag == TAG_GENERIC() {
        val an: String = self.generic_name()
        val bn: String = b.generic_name()
        return an.equals(bn)
    }
    if tag == TAG_PTR() {
        val ai: Type = self.ptr_inner()
        val bi: Type = b.ptr_inner()
        return ai.type_eq(bi)
    }
    if tag == TAG_BOX() {
        val ai: Type = self.box_inner()
        val bi: Type = b.box_inner()
        return ai.type_eq(bi)
    }
    if tag == TAG_ARRAY() {
        return self.array_length() == b.array_length() && self.array_item().type_eq(b.array_item())
    }
    if tag == TAG_FN() { return fn_types_eq(*self, b) }
    if tag == TAG_REF() {
        val am: bool = self.ref_mut()
        val bm: bool = b.ref_mut()
        val ai: Type = self.ref_inner()
        val bi: Type = b.ref_inner()
        return am == bm && ai.type_eq(bi)
    }
    return true
}

/// Same parameter types in order, and the same result.
fun fn_types_eq(a: TypeKind, b: TypeKind): bool {
    val left = Type { kind: a, provenance: Provenance.Inferred(no_span()) }.fn_parts() ?: return false
    val right = Type { kind: b, provenance: Provenance.Inferred(no_span()) }.fn_parts() ?: return false
    if left.params.size() != right.params.size() { return false }
    while i in 0..left.params.size() {
        if !left.params.at(i).type_eq(right.params.at(i)) { return false }
    }
    return left.ret.type_eq(&right.ret)
}

pub fun TypeKind.kind_tag(): uint64 {
    when (self) {
        Int8 => return TAG_INT8()
        Int16 => return TAG_INT16()
        Int32 => return TAG_INT32()
        Int64 => return TAG_INT64()
        UInt8 => return TAG_UINT8()
        UInt16 => return TAG_UINT16()
        UInt32 => return TAG_UINT32()
        UInt64 => return TAG_UINT64()
        Float32 => return TAG_FLOAT32()
        Float64 => return TAG_FLOAT64()
        Bool => return TAG_BOOL()
        Char => return TAG_CHAR()
        StrTy => return TAG_STR()
        Void => return TAG_VOID()
        Never => return TAG_NEVER()
        Struct(_) => return TAG_STRUCT()
        EnumTy(_) => return TAG_ENUM()
        TraitTy(_) => return TAG_TRAIT()
        DynTraitTy(_) => return TAG_DYN_TRAIT()
        Generic(_) => return TAG_GENERIC()
        PtrTo(_) => return TAG_PTR()
        BoxOf(_) => return TAG_BOX()
        ArrayOf(_, _) => return TAG_ARRAY()
        RefTo(_, _) => return TAG_REF()
        FnTy(_) => return TAG_FN()
        Projection(_, _) => return TAG_PROJECTION()
        Poison => return TAG_POISON()
    }
}

fun TypeKind.dyn_kind_eq(b: TypeKind): bool {
    when (self) {
        DynTraitTy(ap) => {
            when (b) {
                DynTraitTy(bp) => {
                    if unsafe { ap.principal.id } != unsafe { bp.principal.id } { return false }
                    val aa = unsafe { ap.args }
                    val ba = unsafe { bp.args }
                    if unsafe { aa.size() } != unsafe { ba.size() } { return false }
                    var i = 0
                    while i < unsafe { aa.size() } {
                        val av = unsafe { aa.get(i) }
                        val bv = unsafe { ba.get(i) }
                        if !av.type_eq(&bv) { return false }
                        i = i + 1
                    }
                    return true
                }
                _ => return false
            }
        }
        _ => return false
    }
}

fun TypeKind.coerce_struct_name(): String {
    return when (self) {
        Struct(n) => type_identity_display(n)
        _ => ""
    }
}
pub fun TypeKind.coerce_enum_name(): String {
    return when (self) {
        EnumTy(n) => type_identity_display(n)
        _ => ""
    }
}
fun TypeKind.coerce_trait_name(): String {
    return when (self) {
        TraitTy(n) => type_identity_display(n)
        _ => ""
    }
}

pub fun TypeKind.struct_name(): String {
    return String.from(self.coerce_struct_name().as_str())
}
// A Struct's or EnumTy's name alike: impls register under either.
pub fun TypeKind.nominal_name(): String {
    val s = self.coerce_struct_name()
    if !s.as_str().equals("") { return s }
    return self.coerce_enum_name()
}
pub fun TypeKind.generic_name(): String {
    return when (self) {
        Generic(n) => n.as_string()
        _ => ""
    }
}
fun TypeKind.ptr_inner(): Type {
    return when (self) {
        PtrTo(p) => unsafe { *p }
        _ => poison_ty()
    }
}
fun TypeKind.box_inner(): Type {
    return when (self) {
        BoxOf(p) => unsafe { *p }
        _ => poison_ty()
    }
}
fun TypeKind.array_item(): Type {
    return Type { kind: *self, provenance: Provenance.Inferred(no_span()) }.array_element()
}
pub fun TypeKind.array_length(): uint64 {
    return when (self) {
        ArrayOf(_p, length) => length
        _ => 0
    }
}
fun TypeKind.ref_mut(): bool {
    return when (self) {
        RefTo(m, _) => m
        _ => false
    }
}
pub fun TypeKind.ref_is_mut(): bool {
    return when (self) {
        RefTo(m, _p) => m
        _ => false
    }
}

fun TypeKind.ref_inner(): Type {
    return when (self) {
        RefTo(_, p) => unsafe { *p }
        _ => poison_ty()
    }
}
