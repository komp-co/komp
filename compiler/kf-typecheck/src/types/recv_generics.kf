// A generic struct's methods are registered under the template (`Pair_first`)
// while a call-site receiver is mangled (`Pair__int32__bool`); this pairs the
// template's parameters with the receiver's arguments.

import kf_core.span.*
import kf_core.ast.mangle_segments
import kf_core.ast.types.Type
import kf_typecheck.traits.str_list_has
import kf_typecheck.check.mangle_base_name
import kf_typecheck.check.mangle_suffix
import kf_typecheck.check.ty_from_mangle_frag

/// Parallel lists, consumed one name and type at a time.
pub struct RecvBinding {
    pub val names: List<String>
    pub val types: List<Type>
}

/// A function type is found among those met; its fragment does not decode.
fun recv_arg_from_frag(frag: String, span: Span, ctx: &var TypeCtx): Type {
    val function = ctx.fn_type_for(frag.as_str())
    if function != null { return function!! }
    return ty_from_mangle_frag(frag, span, ctx.string_name())
}

/// Empty for a non-instance, making every substitution the identity.
pub fun recv_type_bindings(sname: String, span: Span, ctx: &var TypeCtx): RecvBinding {
    var names = List.new<String>()
    var types = List.new<Type>()
    val base = mangle_base_name(sname.clone())
    when (unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) }) {
        Some(gi) => {
            when (unsafe { (*ctx.sigs).find_inst(sname.as_str()) }) {
                Some(inst) => {
                    // The registry holds the arguments as written, so nested receivers
                    // need no name splitting. Read quietly: the refs belong to another
                    // scope. A row mangling back to the template (`Wrap__T`) or poison
                    // carries nothing.
                    val was_quiet = ctx.quiet
                    ctx.quiet = true
                    var concrete = true
                    // Only a row whose every argument is its own parameter is
                    // the template; `Pair<int32, B>` in a scope with its own
                    // `B` is an instance.
                    var own_names: uint64 = 0
                    while i in 0..gi.type_params.size() {
                        if i < inst.args.size() {
                            val arg = (*inst.args.at(i)).resolve_type_ref(ctx)
                            val frag = mangle_type(arg.clone())
                            if frag.as_str().equals("poison") { concrete = false }
                            if frag.as_str().equals(gi.type_params.at(i).as_str()) { own_names = own_names + 1 }
                            names.push(*gi.type_params.at(i))
                            types.push(arg)
                        }
                    }
                    if own_names == gi.type_params.size() { concrete = false }
                    ctx.quiet = was_quiet
                    if !concrete {
                        return RecvBinding { names: List.new<String>(), types: List.new<Type>() }
                    }
                }
                None => {
                    // No registered instance: a name reached by substitution never was,
                    // so the name is all there is.
                    val base_len = base.as_str().byte_len()
                    val name_len = sname.as_str().byte_len()
                    if base_len + 2 < name_len {
                        val suffix = mangle_suffix(sname, base_len + 2)
                        if gi.type_params.size() == 1 {
                            // One parameter takes the whole suffix.
                            names.push(*gi.type_params.at(0))
                            types.push(recv_arg_from_frag(suffix, span, ctx))
                        } else {
                            // Otherwise split by segment, only when the counts agree.
                            val segs = mangle_segments(suffix.as_str())
                            if segs.size() == gi.type_params.size() {
                                while s in 0..segs.size() {
                                    names.push(*gi.type_params.at(s))
                                    types.push(recv_arg_from_frag(*segs.at(s), span, ctx))
                                }
                            }
                        }
                    }
                }
            }
        }
        None => { }
    }
    return RecvBinding { names: names, types: types }
}

/// The receiver as this scope's own instance: `Option<T>` inside a generic
/// whose parameter is also `T` records `Option__T`, indistinguishable from the
/// template row. Kept separate from `recv_type_bindings`, whose other callers
/// mangle trait suffixes where an abstract argument is not interchangeable.
/// Empty unless every argument is both the template's parameter name and a
/// parameter in scope here.
pub fun identity_recv_binding(sname: String, span: Span, ctx: &var TypeCtx): RecvBinding {
    val base = mangle_base_name(sname.clone())
    val gi = unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) } ?: return empty_recv_binding()
    val inst = unsafe { (*ctx.sigs).find_inst(sname.as_str()) } ?: return empty_recv_binding()
    if inst.args.size() != gi.type_params.size() { return empty_recv_binding() }
    var names = List.new<String>()
    var types = List.new<Type>()
    val was_quiet = ctx.quiet
    ctx.quiet = true
    var ok = true
    while i in 0..gi.type_params.size() {
        val want = *gi.type_params.at(i)
        val arg = (*inst.args.at(i)).resolve_type_ref(ctx)
        val frag = mangle_type(arg.clone())
        if !frag.as_str().equals(want.as_str()) { ok = false }
        if !str_list_has(&ctx.generics, frag.as_str()) { ok = false }
        names.push(want)
        types.push(arg)
    }
    ctx.quiet = was_quiet
    if !ok { return empty_recv_binding() }
    return RecvBinding { names: names, types: types }
}

/// The recorded instance where there is one, otherwise this scope's own
/// parameters.
pub fun recv_bindings_for_method(sname: String, span: Span, ctx: &var TypeCtx): RecvBinding {
    val binding = recv_type_bindings(sname.clone(), span, ctx)
    if binding.recv_is_instance() { return binding }
    return identity_recv_binding(sname, span, ctx)
}

pub fun subst_recv(t: Type, binding: &RecvBinding): Type {
    return subst_all_generics(t, &binding.names, &binding.types)
}

/// A caller with no bindings must not claim the template's signature.
pub fun RecvBinding.recv_is_instance(): bool {
    return self.names.size() > 0
}

/// Every substitution through it is the identity.
pub fun empty_recv_binding(): RecvBinding {
    return RecvBinding { names: List.new<String>(), types: List.new<Type>() }
}
