import kf_core.ast.Sym
import kf_core.ast.projection_mangle_display
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.type_identity_display
import kf_core.ast.dyn_meta.dyn_trait_name
import kf_core.ast.dyn_meta.dyn_trait_args
import kf_typecheck.check.bound_shown

/// A checked type as a KFlat programmer writes it. Generic instances recover
/// their argument tree from the SigTable rather than parsing the ambiguous
/// flattened name. Public for tooling such as the editor answers.
pub fun Type.display_type(ctx: &TypeCtx): String {
    when (self.kind) {
        Int8 => return String.from("int8")
        Int16 => return String.from("int16")
        Int32 => return String.from("int32")
        Int64 => return String.from("int64")
        UInt8 => return String.from("uint8")
        UInt16 => return String.from("uint16")
        UInt32 => return String.from("uint32")
        UInt64 => return String.from("uint64")
        Float32 => return String.from("float32")
        Float64 => return String.from("float64")
        Bool => return String.from("bool")
        Char => return String.from("char")
        StrTy => return String.from("str")
        Void => return String.from("void")
        Never => return String.from("never")
        Struct(name) => return name.display_named_type(ctx)
        EnumTy(name) => return name.display_named_type(ctx)
        TraitTy(name) => return name.display_named_type(ctx)
        DynTraitTy(_) => {
            var result = String.from("dyn ")
            result.append(type_identity_display(dyn_trait_name(self)).as_str())
            val args = dyn_trait_args(self)
            if unsafe { args.size() } == 0 { return result }
            result.append("<")
            var i = 0
            while i < unsafe { args.size() } {
                if i > 0 { result.append(", ") }
                val arg = unsafe { args.get(i) }
                result.append(arg.display_type(ctx).as_str())
                i = i + 1
            }
            result.append(">")
            return result
        }
        Generic(name) => return name.generic_shown(ctx)
        PtrTo(inner) => return display_wrapped_type("Ptr<", unsafe { &*inner }, ">", ctx)
        BoxOf(inner) => return display_wrapped_type("Box<", unsafe { &*inner }, ">", ctx)
        RefTo(mutable, inner) => {
            if mutable {
                return display_wrapped_type("&var ", unsafe { &*inner }, "", ctx)
            }
            return display_wrapped_type("&", unsafe { &*inner }, "", ctx)
        }
        FnTy(_) => {
            val parts = self.fn_parts() ?: return String.from("<error>")
            var result = String.from("(")
            while i in 0..parts.params.size() {
                if i > 0 { result.append(", ") }
                result.append(parts.params.at(i).display_type(ctx).as_str())
            }
            result.append(") -> ")
            result.append(parts.ret.display_type(ctx).as_str())
            return result
        }
        Projection(owner, member) => {
            var result = display_type(unsafe { &*owner }, ctx)
            result.append(".")
            result.append(member.as_str())
            return result
        }
        Value(v) => return "${v}"
        Poison => return String.from("<error>")
    }
}

fun display_wrapped_type(prefix: str, inner: &Type, suffix: str, ctx: &TypeCtx): String {
    var result = String.from(prefix)
    val inner_display = inner.display_type(ctx)
    result.append(inner_display.as_str())
    result.append(suffix)
    return result
}

fun Sym.display_named_type(ctx: &TypeCtx): String {
    val sigs = ctx.sigs
    return when (unsafe { sigs.find_inst(self.as_str()) }) {
        Some(inst) => inst.display_instance(ctx)
        // A deferred projection's bracketed spelling is internal; shown as
        // `Owner.Member`.
        None => projection_mangle_display(type_identity_display(Sym { id: self.id }).as_str())
    }
}

/// Arrays and slices as written: `int32[3]`, `&int32[]`, `&var int32[]`.
fun GenericInst.display_instance(ctx: &TypeCtx): String {
    val base = self.base.as_str()
    if base == ctx.array_name().as_str() && self.args.size() == 2 {
        return "${self.args.at(0).display_type_ref()}[${self.args.at(1).display_type_ref()}]"
    }
    if self.args.size() == 1 {
        if base == ctx.slice_name().as_str() { return "&${self.args.at(0).display_type_ref()}[]" }
        if base == ctx.slice_mut_name().as_str() { return "&var ${self.args.at(0).display_type_ref()}[]" }
    }
    return self.display_generic_inst()
}

fun GenericInst.display_generic_inst(): String {
    var result = self.base.clone()
    result.append("<")
    while i in 0..self.args.size() {
        if i > 0 { result.append(", ") }
        val arg = *self.args.at(i)
        val rendered = arg.display_type_ref()
        result.append(rendered.as_str())
    }
    result.append(">")
    return result
}

pub fun TypeRef.display_type_ref(): String {
    when (self.kind) {
        Named(name, args) => {
            var result = name.as_string()
            if args.size() == 0 { return result }
            result.append("<")
            while i in 0..args.size() {
                if i > 0 { result.append(", ") }
                val arg = *args.at(i)
                val rendered = arg.display_type_ref()
                result.append(rendered.as_str())
            }
            result.append(">")
            return result
        }
        DynTrait(name, args) => {
            var result = String.from("dyn ")
            result.append(name.as_str())
            if args.size() == 0 { return result }
            result.append("<")
            while i in 0..args.size() {
                if i > 0 { result.append(", ") }
                val arg = *args.at(i)
                val rendered = arg.display_type_ref()
                result.append(rendered.as_str())
            }
            result.append(">")
            return result
        }
        Function(params, ret) => {
            var result = String.from("(")
            while i in 0..params.size() {
                if i > 0 { result.append(", ") }
                val param = *params.at(i)
                val rendered = param.display_type_ref()
                result.append(rendered.as_str())
            }
            result.append(") -> ")
            val rendered_ret = (unsafe { &*ret }).display_type_ref()
            result.append(rendered_ret.as_str())
            return result
        }
        Reference(mutable, inner) => {
            var result = String.from("&")
            if mutable { result.append("var ") }
            val rendered = (unsafe { &*inner }).display_type_ref()
            result.append(rendered.as_str())
            return result
        }
        Array(_, _) => return String.from("array")
        Value(v) => return "${v}"
        Projection(owner, member) => {
            var result = (unsafe { &*owner }).display_type_ref()
            result.append(".")
            result.append(member.as_str())
            return result
        }
        Poison => return String.from("<error>")
    }
}

/// A trait receiver's parameter is shown as the trait the author wrote.
fun Sym.generic_shown(ctx: &TypeCtx): String {
    val sigs = ctx.sigs
    if unsafe { sigs as uint64 } == 0 { return self.as_string() }
    val param = unsafe { (*sigs).receiver_trait_param(ctx.fn_owner.as_str()) }
    if !param.as_str().equals(self.as_str()) { return self.as_string() }
    val bounds = unsafe { (*sigs).bounds }
    while b in &bounds {
        if b.owner.as_str().equals(ctx.fn_owner.as_str()) && b.param.as_str().equals(param.as_str()) {
            return b.bound_shown()
        }
    }
    return self.as_string()
}
