import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.*
import kf_typecheck.types.mangle_type
import kf_typecheck.types.display_type_ref

fun imported_signature(is_pub: bool): FnSignature {
    return FnSignature {
        name: String.from("helper"),
        params: List.new<Type>(),
        ret: Type.new_int32(no_span()),
        generics: List.new<String>(),
        is_static: false,
        is_mutating: false,
        owner_module: intern("library"),
        owner_crate: new_crate_id("library"),
        is_pub: is_pub,
        borrows: 0 - 1,
        is_prelude: false,
        is_extern: false
    }
}

fun visibility_checked_signatures(is_pub: bool): SigTable {
    var sigs = new_sig_table()
    sigs.gate_visibility = true
    sigs.caller_files.push(7)
    sigs.imported_targets.push(intern("library"))
    sigs.insert(imported_signature(is_pub))
    return sigs
}

@test
fun imported_private_function_is_not_visible(): void {
    val sigs = visibility_checked_signatures(false)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("application"), intern("application")).is_none(), true, "an import does not expose a private function")
}

@test
fun imported_public_function_is_visible(): void {
    val sigs = visibility_checked_signatures(true)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("application"), intern("application")).is_some(), true, "an import exposes a public function")
}

// A non-pub function is hidden from other modules of its own crate.
@test
fun a_private_function_is_not_visible_to_another_module_of_its_crate(): void {
    val sigs = visibility_checked_signatures(false)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("library"), intern("consumer")).is_none(), true, "another module of the same crate does not see a private function")
}

// Its own module still reaches it.
@test
fun a_private_function_is_visible_within_its_own_module(): void {
    val sigs = visibility_checked_signatures(false)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("library"), intern("library")).is_some(), true, "a module may call its own private functions")
}

// `pub` carries it across, inside the crate as well.
@test
fun a_public_function_crosses_a_module_boundary_in_its_crate(): void {
    val sigs = visibility_checked_signatures(true)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("library"), intern("consumer")).is_some(), true, "pub carries a function to another module of its crate")
}

@test
fun runtime_signature_is_globally_visible(): void {
    var sigs = new_sig_table()
    sigs.gate_visibility = true
    sigs.caller_files.push(7)
    sigs.imported_targets.push(intern("library"))
    sigs.insert(FnSignature { name: String.from("runtime_println"), params: List.new<Type>(), ret: Type.new_void(no_span()), generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern("core.assert"), owner_crate: new_crate_id("core"), is_pub: false, borrows: 0 - 1, is_prelude: false, is_extern: false })
    assert_eq(sigs.find_imported_signature("runtime_println", 7, new_crate_id("application"), intern("application")).is_some(), true, "runtime signatures have no visibility boundary")
}

@test
fun a_siblings_import_does_not_lend_visibility(): void {
    // File 7 imports `library`; file 8, in the same directory, does not.
    val sigs = visibility_checked_signatures(true)
    assert_eq(sigs.find_imported_signature("helper", 7, new_crate_id("application"), intern("application")).is_some(), true, "the importing file sees it")
    assert_eq(sigs.find_imported_signature("helper", 8, new_crate_id("application"), intern("application")).is_none(), true, "its sibling does not")
}

fun index_binding(trait_args: str, chosen: Type, written: str): AssocBindingInfo {
    return AssocBindingInfo {
        type_name: String.from("Bag"),
        trait_name: String.from("Index"),
        trait_args: String.from(trait_args),
        assoc_name: String.from("Out"),
        chosen: chosen,
        chosen_tref: TypeRef.new(no_span(), TypeRefKind.Named(intern(written), List.new<TypeRef>()))
    }
}

/// Two `Index` impls on `Bag` binding `Out` differently, so reading the wrong
/// one shows.
fun two_instantiations_of_index(): SigTable {
    var sigs = new_sig_table()
    sigs.insert_assoc_binding(index_binding("uint64", Type.new_int32(no_span()), "int32"))
    sigs.insert_assoc_binding(index_binding("Range", Type.new_bool(no_span()), "bool"))
    return sigs
}

@test
fun an_unqualified_count_still_sees_every_instantiation(): void {
    val sigs = two_instantiations_of_index()
    // The unqualified count stays 2: outside both impls it is ambiguous.
    assert_eq(sigs.count_assoc_bindings("Bag", "Out"), 2, "both instantiations bind Out")
}

@test
fun a_trait_qualified_count_narrows_to_one_instantiation(): void {
    val sigs = two_instantiations_of_index()
    assert_eq(sigs.count_assoc_bindings_in("Bag", "Index", "uint64", "Out"), 1, "Index<uint64> binds Out once")
    assert_eq(sigs.count_assoc_bindings_in("Bag", "Index", "Range", "Out"), 1, "Index<Range> binds Out once")
}

@test
fun a_qualified_lookup_reads_its_own_instantiations_choice(): void {
    val sigs = two_instantiations_of_index()
    // A lookup ignoring the qualifier would return the first match.
    assert_eq(mangle_type(sigs.lookup_assoc_binding_in("Bag", "Index", "uint64", "Out")).as_str(), "int32", "the uint64 impl chose int32")
    assert_eq(mangle_type(sigs.lookup_assoc_binding_in("Bag", "Index", "Range", "Out")).as_str(), "bool", "the range impl chose bool")
}

@test
fun the_written_form_follows_the_same_qualifier(): void {
    val sigs = two_instantiations_of_index()
    // The TypeRef lookup, which codegen uses, agrees.
    assert_eq((&sigs.lookup_assoc_binding_tref_in("Bag", "Index", "Range", "Out")).display_type_ref().as_str(), "bool", "the written choice tracks the qualifier")
}

@test
fun arguments_separate_instantiations_and_the_name_separates_traits(): void {
    val sigs = two_instantiations_of_index()
    assert_eq(sigs.count_assoc_bindings_in("Bag", "Index", "int32", "Out"), 0, "a third instantiation binds nothing")
    // Another trait's same-shaped instantiation answers nothing.
    assert_eq(sigs.count_assoc_bindings_in("Bag", "Other", "uint64", "Out"), 0, "another trait binds nothing")
}

fun stdout_layout(crate: str, field_count: uint64): StructLayout {
    var fs = List.new<StructFieldInfo>()
    var i: uint64 = 0
    while i < field_count {
        fs.push(StructFieldInfo { name: String.from("f"), ty: Type.new_int32(no_span()), is_var: true })
        i = i + 1
    }
    return StructLayout { name: String.from("Stdout"), fields: fs, is_refcounted: false, owner_crate: new_crate_id(crate) }
}

/// Core registers a field-less `Stdout` first; the program declares its own.
fun core_then_program_stdout(): SigTable {
    var sigs = new_sig_table()
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("core"), intern("core.display"), intern("Stdout")))
    sigs.insert_struct(stdout_layout("core", 0))
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("program"), intern("program"), intern("Stdout")))
    sigs.insert_struct(stdout_layout("program", 1))
    return sigs
}

fun SigTable.stdout_field_count(caller: str): uint64 {
    val layout = self.find_struct("Stdout", new_crate_id(caller)) ?: return 99
    return layout.fields.size()
}

@test
fun a_crate_finds_its_own_struct_before_an_earlier_one(): void {
    val sigs = core_then_program_stdout()
    assert_eq(sigs.stdout_field_count("program"), 1, "the program's own Stdout")
    assert_eq(sigs.stdout_field_count("core"), 0, "core's own Stdout")
}

@test
fun a_crate_declaring_no_such_type_takes_the_first(): void {
    val sigs = core_then_program_stdout()
    assert_eq(sigs.stdout_field_count("elsewhere"), 0, "nothing of its own: the first registered")
}

@test
fun a_crates_own_enum_hides_another_crates_struct(): void {
    var sigs = new_sig_table()
    sigs.insert_struct(StructLayout { name: String.from("Duration"), fields: List.new<StructFieldInfo>(), is_refcounted: false, owner_crate: new_crate_id("core") })
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("program"), intern("program"), intern("Duration")))
    sigs.insert_enum(EnumLayout { name: String.from("Duration"), variants: List.new<VariantInfo>(), owner_crate: new_crate_id("program") })
    assert_eq(sigs.find_struct("Duration", new_crate_id("program")).is_none(), true, "the program's enum is not core's struct")
    assert_eq(sigs.find_enum("Duration", new_crate_id("program")).is_some(), true, "the program's enum is found")
}

@test
fun a_crates_plain_type_hides_another_crates_generic(): void {
    var sigs = new_sig_table()
    var params = List.new<String>()
    params.push(String.from("T"))
    sigs.insert_generic_info(GenericInfo { name: String.from("Range"), type_params: params, owner_crate: new_crate_id("core") })
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("program"), intern("program"), intern("Range")))
    assert_eq(sigs.find_generic_info("Range", new_crate_id("program")).is_none(), true, "the program's plain Range takes no type arguments")
    assert_eq(sigs.find_generic_info("Range", new_crate_id("core")).is_some(), true, "core's Range is still generic to core")
}

fun SigTable.variant_count(name: str, caller: str): uint64 {
    val layout = self.find_enum(name, new_crate_id(caller)) ?: return 99
    return layout.variants.size()
}

@test
fun a_crates_own_enum_hides_another_crates_enum(): void {
    var sigs = new_sig_table()
    var core_variants = List.new<VariantInfo>()
    core_variants.push(VariantInfo { name: String.from("Less"), payloads: List.new<Type>() })
    core_variants.push(VariantInfo { name: String.from("More"), payloads: List.new<Type>() })
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("core"), intern("core"), intern("Ordering")))
    sigs.insert_enum(EnumLayout { name: String.from("Ordering"), variants: core_variants, owner_crate: new_crate_id("core") })
    sigs.insert_type_identity(TypeIdentity.new(new_crate_id("program"), intern("program"), intern("Ordering")))
    sigs.insert_enum(EnumLayout { name: String.from("Ordering"), variants: List.new<VariantInfo>(), owner_crate: new_crate_id("program") })
    assert_eq(sigs.variant_count("Ordering", "program"), 0, "the program's own Ordering")
    assert_eq(sigs.variant_count("Ordering", "core"), 2, "core's own Ordering")
}
