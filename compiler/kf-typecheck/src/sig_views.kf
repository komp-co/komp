// Which types are views, asked of the table that recorded them.

import kf_core.ast.intern
import kf_core.ast.names_view
import kf_core.ast.types.Type

impl SigTable {
    /// A value of a view type, or of an instance of a generic one.
    pub fun holds_view(t: &Type): bool {
        val name = when (t.kind) {
            Struct(n) => n
            EnumTy(n) => n
            _ => intern("")
        }
        if name.as_str() == "" { return false }
        if self.declares_view(name.as_str()) { return true }
        val inst = self.find_inst(name.as_str()) ?: return false
        return self.declares_view(inst.base.as_str())
    }

    /// `name` as written, or as an identity, names a view type.
    pub fun declares_view(name: str): bool {
        return names_view(&self.views, name)
    }
}
