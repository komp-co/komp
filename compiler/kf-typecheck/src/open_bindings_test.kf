import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_resolve.*

fun open_ctx(): TypeCtx {
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, Option.None, signatures)
}

fun at(offset: uint32): Span {
    return Span { file_id: 1, start: offset, end: offset + 1 }
}

fun open_literal(): Ptr<Expr> {
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = Expr.new(at(4), ExprKind.LitInt(5)) }
    return init
}

@test fun a_node_checked_twice_is_one_use(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), Type.new_int32(no_span()), false, open_literal())
    ctx.note_use("n", at(10))
    ctx.note_use("n", at(10))
    assert_eq(ctx.binding_uses("n"), 1 as uint64, "the same place read twice")
}

@test fun a_decided_binding_is_no_longer_open(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), Type.new_int32(no_span()), false, open_literal())
    ctx.decide_binding("n", Type.new_int32(no_span()), at(10))
    assert_eq(ctx.open_init("n") == null, true, "closed once decided")
}

@test fun a_decision_after_earlier_uses_is_kept_for_the_next_check(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), Type.new_int32(no_span()), false, open_literal())
    ctx.decide_binding_on_recheck("n", at(4), Type.new_bool(no_span()), at(20))
    var next = open_ctx()
    next.presets = ctx.decisions.clone()
    assert_eq(next.preset_for(at(4)) != null, true, "found by its initializer")
}

@test fun no_decision_is_kept_for_another_initializer(): void {
    var ctx = open_ctx()
    ctx.decide_binding_on_recheck("n", at(4), Type.new_bool(no_span()), at(20))
    var next = open_ctx()
    next.presets = ctx.decisions.clone()
    assert_eq(next.preset_for(at(8)) == null, true, "another binding's initializer")
}

@test fun the_first_narrowing_use_is_kept(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("s"), Type.new_str(no_span()), false, open_literal())
    ctx.narrow_binding("s", at(10))
    ctx.narrow_binding("s", at(20))
    assert_eq(ctx.binding_narrowed_at("s").start, 10 as uint32, "the earlier str use")
}

@test fun an_unnarrowed_binding_has_no_narrowing_use(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("s"), Type.new_str(no_span()), false, open_literal())
    assert_eq(ctx.binding_narrowed_at("s").is_none(), true, "no use yet")
}
