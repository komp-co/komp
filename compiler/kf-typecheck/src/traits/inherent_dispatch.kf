import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_typecheck.types.nominal_name
import kf_typecheck.check.autoderef_ty

/// An exact `<Type>_<method>` signature, or "". A monomorphized receiver's
/// methods are retargeted by Mono and are not answered here.
pub fun inherent_method_symbol(recv_ty: Type, method_name: String, arg_count: uint64, sigs: Ptr<SigTable>): String {
    val recv = autoderef_ty(recv_ty)
    val type_name = recv.kind.nominal_name()
    if type_name.as_str().equals("") { return "" }
    val candidate = type_name + String.from("_") + method_name
    when (unsafe { (*sigs).find_signature(candidate.as_str()) }) {
        Some(sig) => {
            // A static takes no receiver.
            if sig.is_static { return "" }
            // Self plus the arguments; another arity may be the trait's.
            if sig.params.size() != arg_count + 1 { return "" }
            return candidate
        }
        None => { }
    }
    return ""
}

fun receiver_declares_it(recv_ty: Type, method_name: String, arg_count: uint64, ctx: &var TypeCtx): bool {
    val own = inherent_method_symbol(recv_ty, method_name, arg_count, ctx.sigs)
    return !own.as_str().equals("")
}

/// The trait callee, unless the receiver's own type declares the method, in
/// which case the call keeps its symbol. Suppressing, not stamping: the
/// existing stamp carries crate qualification and a mono suffix.
pub fun trait_callee_unless_inherent(recv_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): String {
    if receiver_declares_it(recv_ty.clone(), method_name.clone(), args.size(), ctx) { return "" }
    return instance_trait_method_callee(recv_ty, method_name, args, ctx)
}

/// Only asked when no inherent method settles the call.
pub fun ambiguous_trait_method(recv_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): bool {
    if receiver_declares_it(recv_ty.clone(), method_name.clone(), args.size(), ctx) { return false }
    return instance_trait_method_is_ambiguous(recv_ty, method_name, args, ctx)
}
