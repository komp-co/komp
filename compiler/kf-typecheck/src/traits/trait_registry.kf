import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TypeParam
import kf_core.diagnostic.*
import kf_typecheck.types.*
import kf_typecheck.*
import kf_core.span.no_span
import kf_core.ast.subst.clone_type_ref
import kf_core.ast.dyn_meta.*
import kf_typecheck.check.decl.no_mangle_type_recorded
import kf_typecheck.check.decl.trait_arg_params

mutating fun TopDecl.register_trait_impl(trait_ref: &TypeRef, sigs: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (trait_ref.kind) {
        Named(trait_sym, trait_args) => {
            var receiver = self.name
            if !self.crate.is_poison() {
                receiver = canonical_type_identity(TypeIdentity.new(self.crate, self.module_path, self.name))
            }
            val type_name = self.name.as_string()
            val trait_name = trait_sym.as_string()
            val args_key = trait_args_key(&trait_args)
            // Runtime and `@no_mangle` types are never crate-qualified, so
            // `impl Equal for int32` in any crate is one symbol. The empty key
            // matches by name; the stored identity stays canonical for
            // supertrait obligations.
            var coherence_key = receiver
            val unmangled = no_mangle_type_recorded(sigs, self.name.as_str())
            val is_container = is_container_type_name(self.name.as_str(),
                unsafe { (*sigs).lang_list }, unsafe { (*sigs).lang_option })
            if is_runtime_type_name(self.name.as_str()) || is_container || unmangled { coherence_key = intern("") }
            when (unsafe { sigs.find_trait_impl(coherence_key, type_name.as_str(), trait_name.as_str(), args_key.as_str()) }) {
                Some(first) => {
                    val where_first = first.where_the_first_impl_is(self)
                    val message = "duplicate impl ${trait_name.as_str()} for ${type_name.as_str()}${where_first.as_str()}"
                    diags.emit(new_diagnostic(Severity.Error, new_label(self.decl_name_span(), message)))
                }
                None => {
                    unsafe { sigs.note_impl_param_bounds(type_name.clone(), trait_name.clone(), &self.generics) }
                    unsafe { sigs.insert_trait_impl(TraitImplInfo {
                        type_name: type_name,
                        receiver_identity: receiver,
                        trait_name: trait_name,
                        trait_args: args_key,
                        generics: type_param_key(&self.generics_with_trait_arg_params()),
                        arg_count: trait_args.size()
                    }) }
                }
            }
        }
        _ => {}
    }
}

/// The crate of the impl this one duplicates, recovered from the stored
/// receiver identity, since the reader may have written neither impl.
fun TraitImplInfo.where_the_first_impl_is(td: &TopDecl): String {
    val owner = self.receiver_identity.identity_crate_name()
    if owner.as_str() == "" { return String.from(" across source or compiled artifacts") }
    if !td.crate.is_poison() {
        val here = Sym { id: td.crate.raw }
        if owner.as_str() == here.as_str() { return String.from(": it is already implemented in this crate") }
    }
    return ": it is already implemented in crate `${owner}`"
}

/// "" when recorded without one.
fun Sym.identity_crate_name(): String {
    val text = self.as_str()
    val n = text.byte_len()
    var i: uint64 = 0
    while i + 1 < n {
        if text.byte_at(i) == 58 && text.byte_at(i + 1) == 58 {
            return text.substring(0, i)
        }
        i = i + 1
    }
    return String.from("")
}

pub mutating fun TopDecl.register_dyn_vtable_decl(sigs: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (self.kind) {
        TraitImpl(trait_ref, members) => self.register_concrete_dyn_vtable(unsafe { *trait_ref }, &members, sigs, diags)
        _ => { }
    }
}

mutating fun TopDecl.register_concrete_dyn_vtable(trait_ref: TypeRef, members: &List<TopDecl>, sigs: Ptr<SigTable>, diags: &var Diagnostics): void {
    // One vtable per length, which the impl does not have until a call names it.
    if self.trait_arg_params().size() > 0 { return }
    when (trait_ref.kind) {
        Named(trait_name, type_refs) => {
            when (unsafe { sigs.find_unique_trait(trait_name.as_str()) }) {
                None => return
                Some(info) => {
                    if !info.trait_info_is_object_safe() { return }
                    var ctx = new_type_ctx(Type.new_void(no_span()), diags, Option.None, sigs)
                    ctx.owner_crate = self.crate
                    ctx.owner_module = self.module_path
                    ctx.owner_file = self.span.file_id
                    ctx.metadata_owner = self
                    // Trait args are in the impl's scope: its parameters must be
                    // visible, or `F` in `impl Iterator<F.Out> for MapIter<I, F>`
                    // resolves as a nominal type.
                    ctx.seed_generics(type_param_names(self.generics))
                    var args = List.new<Type>()
                    while argument in &type_refs {
                        args.push(argument.resolve_type_ref(&var ctx))
                    }
                    val dynamic_type = dyn_trait_type(info.identity, args, trait_ref.span)
                    when (dynamic_type.validate_dyn_trait(trait_ref.span, &var ctx)) {
                        None => return
                        Some(layout) => insert_dyn_vtable(self, trait_ref, members, &layout, sigs)
                    }
                }
            }
        }
        _ => { }
    }
}

fun insert_dyn_vtable(td: &var TopDecl, trait_ref: TypeRef, members: &List<TopDecl>, layout: &DynTraitLayout,
    sigs: Ptr<SigTable>): void {
    var receiver_identity = td.name
    if !td.crate.is_poison() {
        receiver_identity = canonical_type_identity(TypeIdentity.new(td.crate, td.module_path, td.name))
    }
    val receiver = Type { kind: TypeKind.Struct(receiver_identity), provenance: Provenance.Declared(td.span) }
    val symbol = receiver.dyn_vtable_symbol(layout)
    while dyn_vtable in &td.dyn_vtables {
        if dyn_vtable.symbol.id == symbol.id { return }
    }
    var adapters = List.new<Sym>()
    val suffix = trait_method_suffix(trait_ref, sigs)
    while method in &layout.methods {
        adapters.push(td.dyn_adapter_symbol(members, &receiver, method.name, &suffix))
    }
    td.dyn_vtables.push(DynVTableInstance {
        layout: layout.identity,
        receiver: receiver,
        receiver_identity: receiver_identity,
        symbol: symbol,
        adapters: adapters,
        owner: td.crate,
        linkage: td.linkage
    })
}

/// The function a dynamic adapter forwards to, recorded so codegen never
/// rebuilds it:
///
///   * the receiver is spelled via `mangle_type_frag`: `int32`, `str`,
///     `dyn_lib__Token`;
///   * the `__<Trait>` suffix from `trait_method_suffix`, empty for Clone,
///     Drop and Equal;
///   * `drop` and `clone` become `_user` where that suffix is empty, since the
///     glue owns the bare name.
///
/// The emitted name, from the resolved type: `dyn_lib__Token_score__Score`,
/// not `Token_score__Score`.
fun TopDecl.dyn_adapter_symbol(members: &List<TopDecl>, receiver: &Type, method: Sym, suffix: &String): Sym {
    if self.linkage.is_imported() {
        while member in &members {
            if member.name.id == method.id && member.link_name.as_str() != "" { return member.link_name }
        }
    }
    var adapter = (*receiver).mangle_frag()
    adapter.append("_")
    val tail = emitted_method_tail(method.as_str(), suffix.as_str())
    adapter.append(tail.as_str())
    return intern(adapter.as_str())
}

/// `type Out = int32` in `impl Producer for Widget` makes `Widget.Out` int32.
/// Resolved in the impl's own scope, where its parameters mean something. A
/// second binding of the same name is not an error here: two traits may each
/// declare `Item`; resolution reports the ambiguity.
pub fun TopDecl.register_assoc_bindings_decl(sigs: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (self.kind) {
        TraitImpl(tref, members) => {
            self.register_assoc_bindings(unsafe { *tref }, members, type_param_names(self.generics), sigs, diags)
        }
        _ => { }
    }
}

fun TopDecl.register_assoc_bindings(trait_ref: TypeRef, members: List<TopDecl>, impl_generics: List<String>, sigs: Ptr<SigTable>, diags: &var Diagnostics): void {
    val trait_name = trait_ref_head_name(trait_ref)
    val trait_args = trait_ref_args_key(trait_ref)
    while member in &members {
        when (member.kind) {
            AssocTypeBinding(chosen_ptr) => {
                var ctx0 = new_type_ctx(Type.new_void(no_span()), diags, Option.None, sigs)
                ctx0.owner_crate = self.crate
                ctx0.owner_module = self.module_path
                ctx0.owner_file = self.span.file_id
                ctx0.seed_generics(impl_generics)
                val chosen_tr: TypeRef = unsafe { *chosen_ptr }
                val chosen = chosen_tr.resolve_type_ref(&var ctx0)
                unsafe { sigs.insert_assoc_binding(AssocBindingInfo {
                    type_name: self.name.as_string(),
                    trait_name: trait_name.clone(),
                    trait_args: trait_args.clone(),
                    assoc_name: member.name.as_string(),
                    chosen: chosen,
                    chosen_tref: clone_type_ref(&chosen_tr)
                }) }
            }
            _ => { }
        }
    }
}

/// `Producer` from `Iterable<T>`-style refs: the head, half a binding's key.
pub fun trait_ref_head_name(trait_ref: TypeRef): String {
    return when (trait_ref.kind) {
        Named(name, _args) => name.as_string()
        _ => ""
    }
}

/// `uint64` from `Index<uint64>`, "" from `Producer`: a binding belongs to one
/// instantiation of a trait.
pub fun trait_ref_args_key(trait_ref: TypeRef): String {
    return when (trait_ref.kind) {
        Named(_name, args) => trait_args_key(&args)
        _ => ""
    }
}

/// "__"-joined, like `trait_args_key`.
pub fun type_param_key(tps: &List<TypeParam>): String {
    var text = ""
    while i in 0..tps.size() {
        if i > 0 { text.append("__") }
        text.append(tps.at(i).name.as_str())
    }
    return text
}

/// The impl's own parameters and those its trait's arguments supplied: both
/// match whatever a use instantiates them to.
fun TopDecl.generics_with_trait_arg_params(): List<TypeParam> {
    var all = self.generics.clone()
    while tp in &self.trait_arg_params() { all.push(tp.clone()) }
    return all
}
