// A trait's transitive supertraits, derived on demand rather than stored, so
// diagnostics can name what was written. Worklists over growing lists with a
// visited check, which makes a cycle terminate. Names are copied out before
// the list grows.

import alloc.list.*

import kf_core.span.no_span

/// Each once, in first-reached order, never the starting trait. An
/// unregistered trait requires nothing; name resolution reports it.
pub fun SigTable.supertrait_closure(name: str): List<String> {
    var found = List.new<String>()
    var queue = List.new<String>()
    self.push_declared_supers(name, &var queue)
    var qi = 0
    while qi < queue.size() {
        val head = *queue.at(qi)
        qi = qi + 1
        if head.as_str() == name { continue }
        if super_name_listed(&found, head.as_str()) { continue }
        found.push(String.from(head.as_str()))
        self.push_declared_supers(head.as_str(), &var queue)
    }
    return found
}

/// A separate walk, since it treats the starting trait oppositely.
pub fun SigTable.supertrait_cycle_from(name: str): bool {
    var seen = List.new<String>()
    var queue = List.new<String>()
    self.push_declared_supers(name, &var queue)
    var qi = 0
    while qi < queue.size() {
        val head = *queue.at(qi)
        qi = qi + 1
        if head.as_str() == name { return true }
        if super_name_listed(&seen, head.as_str()) { continue }
        seen.push(String.from(head.as_str()))
        self.push_declared_supers(head.as_str(), &var queue)
    }
    return false
}

fun SigTable.push_declared_supers(name: str, out: &var List<String>): void {
    when (self.find_unique_trait(name)) {
        None => return
        Some(info) => {
            while supertrait in &info.supertraits {
                // CONSTRAINT: copied via `as_str()`: `info` dies with this arm,
                // and a bit-copied String would read freed memory.
                out.push(String.from(supertrait.name.as_str()))
            }
        }
    }
}

/// `super_` prefixed: `name_listed` exists in the same flat-merged crate.
fun super_name_listed(names: &List<String>, needle: str): bool {
    while name in &names {
        if name.as_str() == needle { return true }
    }
    return false
}

/// With each requirement's type arguments, rewritten per hop into `name`'s
/// vocabulary at `args`: `trait A<T>: B<T>`, `trait B<U>: C<U>`.
pub fun SigTable.supertrait_closure_reqs(name: str, args: str): List<SuperTraitReq> {
    var found = List.new<SuperTraitReq>()
    var qname = List.new<String>()
    var qargs = List.new<String>()
    self.push_super_reqs(name, args, &var qname, &var qargs)
    var qi = 0
    while qi < qname.size() {
        val hname = *qname.at(qi)
        val hargs = *qargs.at(qi)
        qi = qi + 1
        if hname.as_str() == name { continue }
        if super_req_listed(&found, hname.as_str(), hargs.as_str()) { continue }
        found.push(SuperTraitReq { name: String.from(hname.as_str()), args: String.from(hargs.as_str()), span: no_span() })
        self.push_super_reqs(hname.as_str(), hargs.as_str(), &var qname, &var qargs)
    }
    return found
}

fun SigTable.push_super_reqs(name: str, args: str, outn: &var List<String>, outa: &var List<String>): void {
    when (self.find_unique_trait(name)) {
        None => return
        Some(info) => {
            while supertrait in &info.supertraits {
                outn.push(String.from(supertrait.name.as_str()))
                outa.push(subst_key_by_params(supertrait.args.as_str(), &info.type_params, args))
            }
        }
    }
}

/// The n-th declared parameter becomes the n-th actual segment; concrete types
/// pass through.
fun subst_key_by_params(key: str, params: &List<String>, actual: str): String {
    if key.byte_len() == 0 { return "" }
    if params.size() == 0 { return String.from(key) }
    val segs = key_segments(key)
    val acts = key_segments(actual)
    var out = ""
    while i in 0..segs.size() {
        if i > 0 { out.append("__") }
        var replaced = false
        var pi = 0
        while pi < params.size() {
            if params.at(pi).as_str().equals(segs.at(i).as_str()) {
                if pi < acts.size() {
                    out.append(acts.at(pi).as_str())
                    replaced = true
                }
                break
            }
            pi = pi + 1
        }
        if !replaced { out.append(segs.at(i).as_str()) }
    }
    return out
}

fun super_req_listed(reqs: &List<SuperTraitReq>, name: str, args: str): bool {
    while req in &reqs {
        if req.name.as_str() == name {
            if req.args.as_str() == args { return true }
        }
    }
    return false
}
