import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.linkage_source
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.coerce_addr_of
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.mangle_type
import kf_typecheck.types.display_type
import kf_typecheck.check.place_is_mutable
import kf_core.ast.dyn_meta.*
import kf_typecheck.check.borrow.borrow_place_is_stable
import kf_typecheck.check.borrow.emit_immutable_borrow_error
import kf_typecheck.check.borrow.emit_mutable_borrow_place_error

struct DynCoerceSource {
    val valid: bool
    val concrete: Type
    val needs_borrow: bool
}

pub fun Type.expected_is_dyn_ref(): bool {
    when (self.kind) {
        RefTo(_, inner) => {
            when (unsafe { inner.kind }) {
                DynTraitTy(_) => return true
                _ => return false
            }
        }
        _ => return false
    }
}

/// Asked during dispatch, which must not report or rewrite; `try_dyn_coerce`
/// rewrites once the impl is chosen.
pub fun Type.could_dyn_coerce(expected: &Type, ctx: &var TypeCtx): bool {
    if !expected.expected_is_dyn_ref() { return false }
    val dynamic_type = expected.dyn_target_type()
    if dynamic_type.is_poison() || self.is_poison() { return false }
    var concrete = self.clone()
    when (self.kind) {
        RefTo(source_mutable, inner) => {
            if expected.dyn_target_is_mutable() && !source_mutable { return false }
            concrete = unsafe { inner.clone() }
        }
        _ => { }
    }
    when (concrete.kind) {
        DynTraitTy(_) => return false
        _ => { }
    }
    val trait_info = unsafe { (*ctx.sigs).find_trait_identity(dyn_trait_name(&dynamic_type)) } ?: return false
    val trait_args = dynamic_type.dyn_trait_args_key()
    return unsafe { (*ctx.sigs).identity_implements(concrete.dyn_receiver_identity(), trait_info.name.as_str(), trait_args.as_str()) }
}

pub fun try_dyn_coerce(e: &var Expr, expected: Type, ctx: &var TypeCtx): bool {
    if !expected.expected_is_dyn_ref() { return false }
    val dynamic_type = expected.dyn_target_type()
    if dynamic_type.is_poison() || e.ty.is_poison() { return false }
    val target_mutable = expected.dyn_target_is_mutable()
    val source = e.dyn_coerce_source(target_mutable, ctx)
    if !source.valid { return false }
    when (source.concrete.kind) {
        DynTraitTy(_) => return false
        _ => { }
    }
    val trait_info = unsafe { (*ctx.sigs).find_trait_identity(dyn_trait_name(&dynamic_type)) } ?: return false
    val trait_args = dynamic_type.dyn_trait_args_key()
    val receiver_identity = source.concrete.dyn_receiver_identity()
    if !unsafe { (*ctx.sigs).identity_implements(receiver_identity, trait_info.name.as_str(), trait_args.as_str()) } {
        source.concrete.emit_missing_dyn_impl(&dynamic_type, e.span, ctx)
        return false
    }
    val layout = dynamic_type.validate_dyn_trait(e.span, ctx) ?: return false
    val symbol = source.concrete.dyn_vtable_symbol(&layout)
    register_dyn_coercion_vtable(&source.concrete, receiver_identity, symbol, &layout, ctx)

    var inner = *e
    if source.needs_borrow { inner.coerce = coerce_addr_of() }
    val inner_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *inner_ptr = inner }
    var replacement = Expr.new(e.span, ExprKind.DynCoerce(inner_ptr, symbol))
    replacement.ty = expected
    *e = replacement
    return true
}

pub fun Type.dyn_vtable_symbol(layout: &DynTraitLayout): Sym {
    val result = "DynVTableInstance__${self.dyn_receiver_identity().as_str()}__${layout.identity.as_str()}"
    return intern(result.as_str())
}

fun Type.dyn_target_type(): Type {
    return when (self.kind) {
        RefTo(_, inner) => unsafe { inner.clone() }
        _ => Type.new_poison()
    }
}

fun Type.dyn_target_is_mutable(): bool {
    return when (self.kind) {
        RefTo(mutable, _) => mutable
        _ => false
    }
}

fun Expr.dyn_coerce_source(target_mutable: bool, ctx: &var TypeCtx): DynCoerceSource {
    when (self.ty.kind) {
        RefTo(source_mutable, inner) => {
            if target_mutable && !source_mutable {
                val label = new_label(self.span, String.from("cannot convert a shared concrete borrow to a mutable trait object"))
                ctx.emit(new_diagnostic(Severity.Error, label))
                return invalid_dyn_source()
            }
            return DynCoerceSource { valid: true, concrete: unsafe { inner.clone() }, needs_borrow: false }
        }
        _ => {
            if target_mutable && !self.borrow_place_is_stable() {
                self.emit_mutable_borrow_place_error(ctx)
                return invalid_dyn_source()
            }
            if target_mutable && !self.place_is_mutable(ctx) {
                self.emit_immutable_borrow_error(ctx)
                return invalid_dyn_source()
            }
            return DynCoerceSource { valid: true, concrete: self.ty.clone(), needs_borrow: true }
        }
    }
}

fun invalid_dyn_source(): DynCoerceSource {
    return DynCoerceSource { valid: false, concrete: Type.new_poison(), needs_borrow: false }
}

fun Type.dyn_trait_args_key(): String {
    val args = dyn_trait_args(self)
    if unsafe { args as uint64 } == 0 { return "" }
    var result = ""
    var i = 0
    while i < unsafe { args.size() } {
        if i > 0 { result.append("__") }
        val argument = unsafe { args.get(i) }
        result.append(mangle_type(argument).as_str())
        i = i + 1
    }
    return result
}

fun Type.dyn_receiver_identity(): Sym {
    return when (self.kind) {
        Struct(identity) => identity
        EnumTy(identity) => identity
        _ => intern(self.type_registry_key().as_str())
    }
}

fun Type.emit_missing_dyn_impl(dynamic_type: &Type, span: Span, ctx: &var TypeCtx): void {
    val message = "cannot convert `${self.display_type(ctx)}` to `&${dynamic_type.display_type(ctx)}`: no exact trait implementation exists"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

fun register_dyn_coercion_vtable(receiver: &Type, receiver_identity: Sym, symbol: Sym, layout: &DynTraitLayout, ctx: &var TypeCtx): void {
    val owner = ctx.metadata_owner
    if unsafe { owner as uint64 } == 0 { return }
    var i = 0
    while i < unsafe { owner.dyn_vtables.size() } {
        val existing = unsafe { *owner.dyn_vtables.at(i) }
        if existing.layout.id == layout.identity.id && existing.receiver_identity.id == receiver_identity.id { return }
        i = i + 1
    }
    var linkage = linkage_source()
    if unsafe { owner.linkage.is_imported() } { linkage = unsafe { owner.linkage } }
    unsafe { owner.dyn_vtables.push(DynVTableInstance {
        layout: layout.identity,
        receiver: receiver.clone(),
        receiver_identity: receiver_identity,
        symbol: symbol,
        adapters: List.new<Sym>(),
        owner: ctx.owner_crate,
        linkage: linkage
    }) }
}
