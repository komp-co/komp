import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.value_frag
import kf_core.ast.types.*
import kf_typecheck.types.*
import kf_typecheck.check.ty_base_name
import kf_typecheck.check.mangle_base_name
import kf_typecheck.check.ARITY_NOT_FOUND

pub fun str_list_has(xs: &List<String>, needle: str): bool {
    while item in &xs {
        if item.as_str().equals(needle) { return true }
    }
    return false
}

// A bound and an impl spell trait arguments in their own vocabularies:
//
//     fun first<T, I: Iterator<T>, C: Iterable<T, I>>(items: C)
//         -> the bound on C keys as "T__I"
//     impl Iterable<T, ListIter<T>> for List<T>
//         -> the impl keys as "T__ListIter__T", T the impl's param
//
// Matching substitutes the caller's bindings into the bound's key, then treats
// the impl's params as consistent placeholders. Nested arguments flatten with
// `__`, so only a tracked count (`TraitImplInfo.arg_count`) can split a key.

pub fun key_segments(key: str): List<String> {
    var out = List.new<String>()
    val n = key.byte_len()
    if n == 0 { return out }
    var start: uint64 = 0
    var i = 0
    while i < n {
        val c0 = key.byte_at(i)
        if c0 == 95 && i + 1 < n && key.byte_at(i + 1) == 95 {
            out.push(key.substring(start, i))
            i = i + 2
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(key.substring(start, n))
    return out
}

fun key_list_has(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str().equals(name) { return true }
    }
    return false
}

/// With the true argument count: `Entry__K__V` may be one argument.
pub fun trait_arg_segments(key: str, arg_count: uint64): List<String> {
    if arg_count == 1 {
        var out = List.new<String>()
        out.push(String.from(key))
        return out
    }
    return key_segments(key)
}

/// An impl segment naming its own parameter matches any bound segment, but
/// the same one wherever it appears. A bound segment naming one of `free` (the
/// caller's own unbound parameters) matches anything. `impl_arg_count` splits
/// `impl_args`; see `trait_arg_segments`.
pub fun trait_args_satisfy(bound_args: str, impl_args: str, impl_generics: str, impl_arg_count: uint64, free: &List<String>): bool {
    if bound_args.equals(impl_args) { return true }
    val bound_segs = key_segments(bound_args)
    val impl_segs = trait_arg_segments(impl_args, impl_arg_count)
    if bound_segs.size() != impl_segs.size() { return false }
    val params = key_segments(impl_generics)
    var seen_names = List.new<String>()
    var seen_values = List.new<String>()
    while i in 0..impl_segs.size() {
        val is = *impl_segs.at(i)
        val bs = *bound_segs.at(i)
        if key_list_has(&params, is.as_str()) {
            // Bind the placeholder, or require the same binding.
            var j = 0
            var bound_before = false
            while j < seen_names.size() {
                if seen_names.at(j).as_str().equals(is.as_str()) {
                    if !seen_values.at(j).as_str().equals(bs.as_str()) { return false }
                    bound_before = true
                }
                j = j + 1
            }
            if !bound_before {
                seen_names.push(is.clone())
                seen_values.push(bs.clone())
            }
        } else if str_list_has(free, bs.as_str()) {
            // An unbound free parameter matches anything.
        } else if !is.as_str().equals(bs.as_str()) {
            return false
        }
    }
    return true
}

/// A bound's argument key with the caller's parameters replaced by their
/// bindings: `From<S>` with `S = int32` is "int32". An unresolved argument is
/// "" for a bound check, which must not accept it, but its own name when
/// `for_mangle`, so Mono can substitute it in the callee later.
pub fun subst_trait_args(key: str, gnames: &List<String>, bound_tys: &List<Type>, for_mangle: bool): String {
    if key.byte_len() == 0 { return "" }
    if gnames.size() == 0 { return String.from(key) }
    val segs = key_segments(key)
    var out = ""
    while i in 0..segs.size() {
        if i > 0 { out.append("__") }
        val seg = *segs.at(i)
        var replaced = false
        var g = 0
        while g < gnames.size() {
            if gnames.at(g).as_str().equals(seg.as_str()) {
                if g < bound_tys.size() {
                    val bt = *bound_tys.at(g)
                    if !bt.is_poison() {
                        out.append(bt.trait_arg_key(for_mangle).as_str())
                        replaced = true
                    }
                }
            }
            g = g + 1
        }
        if !replaced { out.append(seg.as_str()) }
    }
    return out
}

/// `ty_arg_key`, but a mangling caller keeps an abstract argument's name.
fun Type.trait_arg_key(for_mangle: bool): String {
    if for_mangle {
        when (self.kind) {
            Generic(name) => return name.as_string()
            _ => { }
        }
    }
    return self.ty_arg_key()
}

/// Keeps the mono suffix: `ListIter__int32` splits into the same two segments
/// as `ListIter<T>`.
fun Type.ty_arg_key(): String {
    return when (self.kind) {
        Struct(n) => type_identity_display(n)
        EnumTy(n) => type_identity_display(n)
        // A length, as an instance name spells it.
        Value(v) => value_frag(v)
        _ => self.ty_base_name()
    }
}

/// The trait-impl registry key: no canonical prefix, no mono suffix. "" for a
/// generic parameter or poison, meaning not yet known.
pub fun Type.type_registry_key(): String {
    return mangle_base_name(self.ty_arg_key())
}

/// The associated-binding key keeps the mono suffix: a specialized impl is
/// named for its instance, and the template's `type Out = T` would splice a
/// bare `T`.
pub fun Type.assoc_owner_key(): String {
    return self.ty_arg_key()
}

// A trait body is written in its own parameters; a use site
// (`C: Iterable<int32>`) supplies arguments, mapped positionally.

/// Substitutions one at a time are safe: a substituted argument is not
/// scanned again.
fun subst_trait_params(t: Type, trait_name: str, args: &List<String>, ctx: &var TypeCtx): Type {
    val tinfo = (*ctx.sigs).find_trait(trait_name) ?: return t
    val params = tinfo.type_params
    var out = t
    while i in 0..params.size() {
        if i >= args.size() { return out }
        val param = *params.at(i)
        val arg = *args.at(i)
        // A parameter standing for itself is skipped.
        if !param.as_str().equals(arg.as_str()) {
            out = out.subst_generic(param.clone(), named_or_generic_ty(arg.as_str(), ctx))
        }
    }
    return out
}

/// A borrow key (`kf__ref__T` / `kf__mut__T`) reads back as a borrow, with its
/// mutability.
fun named_or_generic_ty(name: str, ctx: &var TypeCtx): Type {
    val borrowed = ref_key_inner(name)
    if !borrowed.as_str().equals("") {
        val inner = type_node(named_or_generic_ty(borrowed.as_str(), ctx))
        return Type { kind: TypeKind.RefTo(ref_key_is_mut(name), inner), provenance: Provenance.Inferred(no_span()) }
    }
    while generic in &ctx.generics {
        if generic.as_str().equals(name) {
            return Type.new_generic(String.from(name), no_span())
        }
    }
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
    return tr.resolve_type_ref(ctx)
}

/// `type Iter: Iterator<T>` in `trait Iterable<T>`, through
/// `C: Iterable<int32>`, is `Iterator<int32>`.
fun AssocBoundReq.assoc_bound_args_at_use_site(owner_trait: str, owner_args: &List<String>, ctx: &var TypeCtx): List<String> {
    val tinfo = (*ctx.sigs).find_trait(owner_trait) ?: return self.arg_names
    val params = tinfo.type_params
    var out = List.new<String>()
    while arg_name in &self.arg_names {
        out.push(mapped_param_name(arg_name, &params, owner_args))
    }
    return out
}

/// Unchanged when it names no parameter.
fun mapped_param_name(name: String, params: &List<String>, args: &List<String>): String {
    while i in 0..params.size() {
        if params.at(i).as_str().equals(name.as_str()) {
            if i < args.size() { return *args.at(i) }
            return name
        }
    }
    return name
}

/// A method on a projection receiver (`C.Iter`), from the associated type's
/// bounds: `type Iter: Iterator<T>` promises `next`. Without a bound, an
/// error.
pub struct ProjectionMethod {
    pub val req: TraitMethodReq
    /// `Stepper`, or `Iterator__int32` with args: the known half of
    /// `<Type>_<method>__<suffix>` while the owner is abstract.
    pub val trait_suffix: String
}

pub fun trait_method_for_projection(owner_param: String, member: str, method_name: String, recv_ty: Type, ctx: &var TypeCtx): ProjectionMethod {
    val sp = ctx.sigs
    var i = 0
    while i < unsafe { sp.bounds.size() } {
        val b = unsafe { *sp.bounds.at(i) }
        if b.owner.as_str().equals(ctx.fn_owner.as_str()) && b.param.as_str().equals(owner_param.as_str()) {
            val direct = projection_method_in(b.trait_name.as_str(), &b.arg_names, member, method_name.clone(), recv_ty.clone(), ctx)
            if direct.req.arity != ARITY_NOT_FOUND() { return direct }
            // The associated type may belong to a supertrait
            // (`trait Collection: Iterable`); its arguments already arrive in
            // this bound's vocabulary.
            val required = supertrait_closure_reqs(unsafe { &*sp }, b.trait_name.as_str(), b.trait_args.as_str())
            while sreq in &required {
                val sargs = key_segments(sreq.args.as_str())
                val found = projection_method_in(sreq.name.as_str(), &sargs, member, method_name.clone(), recv_ty.clone(), ctx)
                if found.req.arity != ARITY_NOT_FOUND() { return found }
            }
        }
        i = i + 1
    }
    return ProjectionMethod { req: not_found_req(), trait_suffix: "" }
}

/// `owner_args` makes `type It: Iterator<T>` read `Iterator<int32>`.
fun projection_method_in(owner_trait: str, owner_args: &List<String>, member: str, method_name: String, recv_ty: Type, ctx: &var TypeCtx): ProjectionMethod {
    when (unsafe { (*ctx.sigs).find_trait(owner_trait) }) {
        Some(tinfo) => {
            val assoc_i = trait_assoc_index(tinfo, member)
            if assoc_i >= 0 {
                val assoc = *tinfo.assoc_types.at(assoc_i as uint64)
                while req in &assoc.bounds {
                    val args = req.assoc_bound_args_at_use_site(owner_trait, owner_args, ctx)
                    val found = trait_method_in(req.trait_name.as_str(), method_name.clone(), &args,
                        recv_ty.clone(), ctx)
                    if found.arity != ARITY_NOT_FOUND() {
                        val suffix = dispatch_suffix(req.trait_name.clone(), &args, ctx)
                        return ProjectionMethod { req: found, trait_suffix: suffix }
                    }
                }
            }
        }
        None => { }
    }
    return ProjectionMethod { req: not_found_req(), trait_suffix: "" }
}

/// Mirrors `generic_instance_trait_callee`, including traits without a suffix.
fun dispatch_suffix(trait_name: String, args: &List<String>, ctx: &var TypeCtx): String {
    val n = trait_name.as_str()
    if ctx.is_auto_trait(n) { return "" }
    var out = trait_name.clone()
    while arg in &args {
        out = out + String.from("__") + arg
    }
    return out
}

/// With the trait's parameters substituted and `Self` as the receiver. `args`
/// is borrowed: both callers use it afterwards.
pub fun trait_method_in(trait_name: str, method_name: String, args: &List<String>, recv_ty: Type, ctx: &var TypeCtx): TraitMethodReq {
    val tinfo = (*ctx.sigs).find_trait(trait_name) ?: return not_found_req()
    while req in &tinfo.methods {
        if req.name.as_str().equals(method_name.as_str()) {
            var sparams = List.new<Type>()
            while param in &req.params {
                val mapped = subst_trait_params(param, trait_name, args, ctx)
                sparams.push(mapped.subst_generic(String.from("Self"), recv_ty.clone()))
            }
            val mapped_ret = subst_trait_params(req.ret, trait_name, args, ctx)
            val sret = mapped_ret.subst_generic(String.from("Self"), recv_ty.clone())
            return TraitMethodReq { name: req.name.clone(), span: req.span, arity: req.arity, has_default: req.has_default, has_method_generics: req.has_method_generics, is_static: req.is_static, params: sparams, ret: sret, is_mutating: req.is_mutating }
        }
    }
    return not_found_req()
}

fun not_found_req(): TraitMethodReq {
    return TraitMethodReq { name: "", span: no_span(), arity: ARITY_NOT_FOUND(), has_default: false, has_method_generics: false, is_static: false, params: List.new<Type>(), ret: Type.new_poison(), is_mutating: false }
}
