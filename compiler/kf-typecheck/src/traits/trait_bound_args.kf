import alloc.list.*

import kf_core.ast.*

fun Type.trait_arg_type_key(): String {
    return when (self.kind) {
        Int8 => String.from("int8")
        Int16 => String.from("int16")
        Int32 => String.from("int32")
        Int64 => String.from("int64")
        UInt8 => String.from("uint8")
        UInt16 => String.from("uint16")
        UInt32 => String.from("uint32")
        UInt64 => String.from("uint64")
        Float32 => String.from("float32")
        Float64 => String.from("float64")
        Bool => String.from("bool")
        Char => String.from("char")
        StrTy => String.from("str")
        Struct(n) => n.as_string()
        EnumTy(n) => n.as_string()
        Generic(n) => n.as_string()
        PtrTo(p) => "Ptr__${trait_arg_type_key(unsafe { &*p })}"
        BoxOf(p) => "Box__${trait_arg_type_key(unsafe { &*p })}"
        RefTo(is_mut, p) => borrow_frag(is_mut, trait_arg_type_key(unsafe { &*p }).as_str())
        ArrayOf(_p, length) => array_mangle_frag(self.array_element().trait_arg_type_key().as_str(), length)
        _ => ""
    }
}
