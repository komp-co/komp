import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.canonical_identity_crate
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type
import kf_typecheck.types.subst_all_generics
import kf_core.ast.dyn_meta.*

pub fun Type.validate_dyn_trait(span: Span, ctx: &var TypeCtx): DynTraitLayout? {
    val principal = dyn_trait_name(self)
    when (unsafe { (*ctx.sigs).find_trait_identity(principal) }) {
        None => return Option.None
        Some(info) => {
            // A trait with supertraits cannot be an object: their methods and
            // upcasting would need a layout.
            if info.supertraits.size() > 0 {
                val required = *info.supertraits.at(0)
                val message = "trait `${info.name}` cannot be used as dyn because it requires `${required.name}` — supertrait vtables are not implemented yet"
                ctx.emit(new_diagnostic(Severity.Error, new_label(required.span, message)))
                return Option.None
            }
            if info.assoc_types.size() > 0 {
                val associated = *info.assoc_types.at(0)
                val member = associated.name
                val message = "trait `${info.name}` cannot be used as dyn because it declares associated type `${member}`"
                ctx.emit(new_diagnostic(Severity.Error, new_label(associated.span, message)))
                return Option.None
            }
            while method in &info.methods {
                if method.has_method_generics {
                    val message = "trait method `${method.name}` cannot be used through dyn because it is generic"
                    ctx.emit(new_diagnostic(Severity.Error, new_label(method.span, message)))
                    return Option.None
                }
                if method.is_static {
                    val message = "static trait method `${method.name}` has no dynamic receiver"
                    ctx.emit(new_diagnostic(Severity.Error, new_label(method.span, message)))
                    return Option.None
                }
                if method.method_exposes_self() {
                    val message = "trait method `${method.name}` exposes `Self` outside its receiver"
                    ctx.emit(new_diagnostic(Severity.Error, new_label(method.span, message)))
                    return Option.None
                }
            }
            val layout = self.build_dyn_layout(info, ctx)
            decl_insert_dyn_layout(ctx.metadata_owner, clone_dyn_trait_layout(&layout))
            return Option.Some(layout)
        }
    }
}

fun TraitInfo.trait_info_is_object_safe(): bool {
    if self.supertraits.size() > 0 { return false }
    if self.assoc_types.size() > 0 { return false }
    while method in &self.methods {
        if method.has_method_generics || method.is_static || method.method_exposes_self() { return false }
    }
    return true
}

pub fun Type.dyn_layout_for(ctx: &var TypeCtx): DynTraitLayout? {
    val identity = dyn_trait_identity(self)
    val owner = ctx.metadata_owner
    if unsafe { owner as uint64 } != 0 {
        var i = 0
        while i < unsafe { owner.dyn_layouts.size() } {
            val layout = unsafe { *owner.dyn_layouts.at(i) }
            if layout.identity.id == identity.id { return Option.Some(layout) }
            i = i + 1
        }
    }
    return self.validate_dyn_trait(no_span(), ctx)
}

pub fun Type.validate_dyn_placement(span: Span, ctx: &var TypeCtx): void {
    self.validate_dyn_position(span, false, ctx)
}

fun Type.validate_dyn_position(span: Span, directly_borrowed: bool, ctx: &var TypeCtx): void {
    when (self.kind) {
        DynTraitTy(_) => {
            if !directly_borrowed {
                val message = "`${self.display_type(ctx)}` is unsized and must be used directly behind `&` or `&var`"
                ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
                return
            }
            val _layout = self.validate_dyn_trait(span, ctx)
        }
        RefTo(_, inner) => validate_dyn_position(unsafe { &*inner }, span, true, ctx)
        PtrTo(inner) => validate_dyn_position(unsafe { &*inner }, span, false, ctx)
        BoxOf(inner) => validate_dyn_position(unsafe { &*inner }, span, false, ctx)
        Projection(owner, _) => validate_dyn_position(unsafe { &*owner }, span, false, ctx)
        FnTy(signature) => {
            var i = 0
            while i < unsafe { (*signature.params).size() } {
                val parameter = unsafe { (*signature.params).get(i) }
                parameter.validate_dyn_position(span, false, ctx)
                i = i + 1
            }
            validate_dyn_position(unsafe { &*signature.ret }, span, false, ctx)
        }
        _ => { }
    }
}

pub fun decl_insert_dyn_layout(owner: Ptr<TopDecl>, layout: DynTraitLayout): void {
    if unsafe { owner as uint64 } == 0 { return }
    var i = 0
    while i < unsafe { owner.dyn_layouts.size() } {
        if unsafe { owner.dyn_layouts.at(i).identity.id } == layout.identity.id { return }
        i = i + 1
    }
    unsafe { owner.dyn_layouts.push(layout) }
}

fun Type.build_dyn_layout(info: TraitInfo, ctx: &TypeCtx): DynTraitLayout {
    val args = self.dyn_args_as_list()
    var imported = false
    val metadata_owner = ctx.metadata_owner
    if unsafe { metadata_owner as uint64 } != 0 {
        imported = unsafe { metadata_owner.linkage.is_imported() }
    }
    var methods = List.new<DynMethodSlot>()
    while i in 0..info.methods.size() {
        val method = *info.methods.at(i)
        var params = List.new<Type>()
        while param in &method.params {
            params.push(subst_all_generics(param, &info.type_params, &args))
        }
        methods.push(DynMethodSlot {
            name: intern(method.name.as_str()),
            params: params,
            ret: subst_all_generics(method.ret, &info.type_params, &args),
            is_mutating: method.is_mutating,
            slot: i
        })
    }
    var layout_owner = canonical_identity_crate(info.identity)
    if layout_owner.is_poison() { layout_owner = ctx.owner_crate }
    return DynTraitLayout {
        identity: dyn_trait_identity(self),
        principal: dyn_trait_name(self),
        args: args,
        methods: methods,
        owner: layout_owner,
        imported: imported
    }
}

fun Type.dyn_args_as_list(): List<Type> {
    var result = List.new<Type>()
    val args = dyn_trait_args(self)
    if unsafe { args as uint64 } == 0 { return result }
    var i = 0
    while i < unsafe { args.size() } {
        result.push(unsafe { args.get(i) })
        i = i + 1
    }
    return result
}

fun TraitMethodReq.method_exposes_self(): bool {
    if self.ret.type_contains_self() { return true }
    while param in &self.params {
        if param.type_contains_self() { return true }
    }
    return false
}

fun Type.type_contains_self(): bool {
    when (self.kind) {
        Generic(name) => return name.as_str() == "Self"
        PtrTo(inner) => return type_contains_self(unsafe { &*inner })
        BoxOf(inner) => return type_contains_self(unsafe { &*inner })
        RefTo(_, inner) => return type_contains_self(unsafe { &*inner })
        Projection(owner, _) => return type_contains_self(unsafe { &*owner })
        DynTraitTy(_) => {
            val args = dyn_trait_args(self)
            var i = 0
            while i < unsafe { args.size() } {
                val argument = unsafe { args.get(i) }
                if argument.type_contains_self() { return true }
                i = i + 1
            }
            return false
        }
        FnTy(signature) => {
            var i = 0
            while i < unsafe { (*signature.params).size() } {
                val parameter = unsafe { (*signature.params).get(i) }
                if parameter.type_contains_self() { return true }
                i = i + 1
            }
            return type_contains_self(unsafe { &*signature.ret })
        }
        _ => return false
    }
}
