import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.*

fun registry_type_ptr(name: str): Ptr<TypeRef> {
    val out: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *out = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>())) }
    return out
}

fun owned_registry_decl(td: TopDecl): TopDecl {
    var owned = td
    owned.crate = new_crate_id("sample")
    owned.module_path = intern("sample.api")
    return owned
}

@test
fun same_named_receivers_do_not_share_trait_impls(): void {
    val left = canonical_type_identity(TypeIdentity.new(new_crate_id("left"), intern("models"), intern("Point")))
    val right = canonical_type_identity(TypeIdentity.new(new_crate_id("right"), intern("models"), intern("Point")))
    var table = new_sig_table()
    table.insert_trait_impl(TraitImplInfo {
        type_name: String.from("Point"),
        receiver_identity: left,
        trait_name: String.from("Show"),
        trait_args: "",
        generics: "",
        arg_count: 0
    })
    assert_eq(table.identity_implements(right, "Show", ""), false, "crate identity separates same-named receivers")
}

@test
fun bare_reconstructed_receiver_uses_display_name_fallback(): void {
    var table = new_sig_table()
    table.insert_trait_impl(TraitImplInfo {
        type_name: String.from("Sym"),
        receiver_identity: canonical_type_identity(TypeIdentity.new(new_crate_id("kf_core"), intern("ast"), intern("Sym"))),
        trait_name: String.from("Equal"),
        trait_args: "",
        generics: "",
        arg_count: 0
    })
    assert_eq(table.identity_implements(intern("Sym"), "Equal", ""), true, "bare reconstructed types retain trait behavior")
}

@test
fun duplicate_source_and_imported_trait_impl_is_diagnosed(): void {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))))
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    var imported = owned_registry_decl(new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(registry_type_ptr("Show"), List.new<TopDecl>())))
    imported.linkage = Linkage.ImportedCompiled
    module.decls.push(imported)
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(registry_type_ptr("Show"), List.new<TopDecl>()))))
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val diagnostics = module.typecheck_module(&var declarations)
    assert_eq(diagnostics.size() > 0, true, "duplicate source and compiled implementations are rejected")
}

@test
fun imported_trait_method_uses_exact_link_name(): void {
    val dependency = new_crate_id("dep")
    var module = Module { crate: dependency, path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    var point = new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))
    point.crate = dependency
    point.module_path = intern("dep.api")
    point.linkage = Linkage.ImportedCompiled
    module.decls.push(point)
    var show = new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))
    show.crate = dependency
    show.module_path = intern("dep.api")
    show.linkage = Linkage.ImportedCompiled
    module.decls.push(show)
    var method = new_top_decl(no_span(), String.from("show"), TopDeclKind.Function(List.new<Param>(), registry_type_ptr("int32"), List.new<Stmt>(), true, false, false, false))
    method.crate = dependency
    method.module_path = intern("dep.api")
    method.linkage = Linkage.ImportedCompiled
    method.link_name = intern("dep__Point_show_exact")
    var methods = List.new<TopDecl>()
    methods.push(method)
    var implementation = new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(registry_type_ptr("Show"), methods))
    implementation.crate = dependency
    implementation.module_path = intern("dep.api")
    implementation.linkage = Linkage.ImportedCompiled
    module.decls.push(implementation)
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("point"), registry_type_ptr("Point")))
    val call = ep(ExprKind.MethodCall(ep(ExprKind.Variable(intern("point"))), intern("show"), List.new<Expr>()))
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Return(ret_op(call))))
    module.decls.push(new_top_decl(no_span(), String.from("consume"), TopDeclKind.Function(params, registry_type_ptr("int32"), body, true, false, false, false)))
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val _diagnostics = module.typecheck_module(&var declarations)
    assert_eq(unsafe { call.mangled_callee.as_str() }, "dep__Point_show_exact", "method call uses interface link symbol")
}

// A generic impl registers under its template (`Box2`); a bound checks the
// monomorphized identity (`Box2__int32`).
fun shout_registry(): SigTable {
    var table = new_sig_table()
    table.insert_trait_impl(TraitImplInfo {
        type_name: String.from("Box2"),
        receiver_identity: canonical_type_identity(TypeIdentity.new(new_crate_id("app"), intern("shapes"), intern("Box2"))),
        trait_name: String.from("Shout"),
        trait_args: String.from("T"),
        generics: "",
        arg_count: 1
    })
    return table
}

@test
fun a_generic_instance_matches_its_template_impl(): void {
    val table = shout_registry()
    assert_eq(table.identity_implements(intern("Box2__int32"), "Shout", "T"), true, "Box2__int32 satisfies the impl registered for Box2")
}

@test
fun a_different_template_still_does_not_match(): void {
    val table = shout_registry()
    assert_eq(table.identity_implements(intern("Other__int32"), "Shout", "T"), false, "stripping the mono suffix does not make unrelated types match")
}

// A canonical identity from another crate gets no name fallback.
@test
fun a_canonical_identity_from_another_crate_does_not_match(): void {
    val table = shout_registry()
    val other = canonical_type_identity(TypeIdentity.new(new_crate_id("other"), intern("shapes"), intern("Box2")))
    assert_eq(table.identity_implements(other, "Shout", "T"), false, "another crate's Box2 does not borrow this crate's impl")
}

// Impl params are placeholders that must bind consistently.
@test
fun trait_args_match_when_spellings_agree(): void {
    assert_eq(trait_args_satisfy("int32", "int32", "", 1, &List.new<String>()), true, "identical concrete args match")
}

@test
fun trait_args_reject_a_different_concrete_arg(): void {
    assert_eq(trait_args_satisfy("str", "int32", "", 1, &List.new<String>()), false, "From<str> does not satisfy a From<int32> impl")
}

@test
fun an_impl_type_param_matches_any_argument(): void {
    assert_eq(trait_args_satisfy("int32__ListIter__int32", "T__ListIter__T", "T", 2, &List.new<String>()), true, "the impl's T binds to int32 in both positions")
}

@test
fun an_impl_type_param_must_bind_consistently(): void {
    assert_eq(trait_args_satisfy("int32__ListIter__str", "T__ListIter__T", "T", 2, &List.new<String>()), false, "T cannot be int32 and str at once")
}

@test
fun a_concrete_impl_segment_still_has_to_match(): void {
    assert_eq(trait_args_satisfy("int32__VecIter__int32", "T__ListIter__T", "T", 2, &List.new<String>()), false, "a concrete segment is not a placeholder")
}

@test
fun differing_arities_do_not_match(): void {
    assert_eq(trait_args_satisfy("int32", "T__ListIter__T", "T", 2, &List.new<String>()), false, "segment counts must agree")
}

@test
fun argless_traits_match(): void {
    assert_eq(trait_args_satisfy("", "", "", 0, &List.new<String>()), true, "an arg-less trait like Equal matches on empty keys")
}

// `Iterable<Entry<K, V>>` mangles to `Entry__K__V`: `arg_count` says it is one
// argument.
@test
fun a_compound_single_argument_is_not_split(): void {
    assert_eq(trait_args_satisfy("Entry__int32__int32", "Entry__int32__int32", "", 1, &List.new<String>()), true, "identical compound args match")
    assert_eq(trait_args_satisfy("Entry__int32__str", "Entry__int32__int32", "", 1, &List.new<String>()), false, "a different compound arg does not match")
}

// An extension's free parameter binds a compound impl argument as a whole:
// `T` over `Iterable<T>` matches `Entry<K, V>` for `HashMap<K, V>`.
@test
fun a_free_bound_parameter_matches_a_compound_impl_argument(): void {
    var free = List.new<String>()
    free.push(String.from("T"))
    assert_eq(trait_args_satisfy("T", "Entry__int32__int32", "K__V", 1, &free), true, "the caller's own free T binds to the whole compound argument")
}

/// A runtime type has one C identity, so two crates' impls collide.
@test
fun duplicate_impl_for_a_runtime_type_across_crates_is_diagnosed(): void {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))))
    var imported = new_top_decl(no_span(), String.from("int32"), TopDeclKind.TraitImpl(registry_type_ptr("Show"), List.new<TopDecl>()))
    imported.crate = new_crate_id("core")
    imported.module_path = intern("core.primitives.int32")
    imported.linkage = Linkage.ImportedCompiled
    module.decls.push(imported)
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("int32"), TopDeclKind.TraitImpl(registry_type_ptr("Show"), List.new<TopDecl>()))))
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val diagnostics = module.typecheck_module(&var declarations)
    assert_eq(diagnostics.size() > 0, true, "a second impl for a primitive is rejected whatever crate declares it")
}

// The duplicate message names the first impl's crate.

fun registry_impl_in(crate: str, target: str, trait_name: str, linkage: Linkage): TopDecl {
    var td = new_top_decl(no_span(), String.from(target), TopDeclKind.TraitImpl(registry_type_ptr(trait_name), List.new<TopDecl>()))
    td.crate = new_crate_id(crate)
    td.module_path = intern("sample.api")
    td.linkage = linkage
    return td
}

mutating fun Module.registry_message(): String {
    var declarations = new_decl_table()
    resolve_module(self, &var declarations)
    val diagnostics = self.typecheck_module(&var declarations)
    while diagnostic in &diagnostics {
        val text = diagnostic.primary.message
        if text.as_str().contains("duplicate impl") { return text.clone() }
    }
    return String.from("")
}

// `impl Show for int32` in two crates is one symbol, and the reader can least
// guess the other crate.
@test
fun a_duplicate_impl_from_a_dependency_names_that_crate(): void {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))))
    module.decls.push(registry_impl_in("dep", "int32", "Show", Linkage.ImportedCompiled))
    module.decls.push(registry_impl_in("sample", "int32", "Show", linkage_source()))
    val message = module.registry_message()
    assert_eq(message.as_str().contains("crate `dep`"), true, "for a dependency's impl of a runtime type, naming the crate is the whole of the hint")
}

@test
fun a_duplicate_impl_in_this_crate_says_so(): void {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))))
    module.decls.push(owned_registry_decl(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    module.decls.push(registry_impl_in("sample", "Point", "Show", linkage_source()))
    module.decls.push(registry_impl_in("sample", "Point", "Show", linkage_source()))
    val message = module.registry_message()
    assert_eq(message.as_str().contains("already implemented in this crate"), true, "naming `sample` would tell the reader nothing they did not know")
}
