// What a `Copy` impl promises, checked where it is made: every field is Copy
// and the type has no destructor.

import alloc.list.*

import kf_core.diagnostic.*
import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.declaration.TopDecl
import kf_core.span.no_span
import kf_typecheck.*
import kf_typecheck.check.type_is_copy

/// CONSTRAINT: runs after struct and trait registration, since a field's type
/// and its Copy impl may both be declared below the impl being checked.
pub fun Module.check_copy_impls(sigs: Ptr<SigTable>, table: Ptr<DeclTable>?, diags: &var Diagnostics): void {
    val copy_name = unsafe { sigs.lang_trait_name(lang_copy_key()) }
    if copy_name.as_str().equals("") { return }
    val drop_name = unsafe { sigs.lang_trait_name(lang_drop_key()) }
    var ctx = new_type_ctx(Type.new_void(no_span()), diags, table, sigs)
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                when (unsafe { tref.kind }) {
                    Named(trait_sym, _args) => {
                        if trait_sym.id == copy_name.id {
                            check_one_copy_impl(&td, copy_name.as_str(), drop_name.as_str(), &var ctx, diags)
                        }
                    }
                    _ => { }
                }
            }
            _ => { }
        }
    }
}

fun check_one_copy_impl(td: &TopDecl, copy_name: str, drop_name: str, ctx: &var TypeCtx,
    diags: &var Diagnostics): void {
    val sigs = ctx.sigs
    if !drop_name.equals("") && td.receiver_implements(drop_name, "", unsafe { &*sigs }) {
        td.report_unsound_copy("it implements Drop, and a bitwise copy would run the destructor twice", diags)
        return
    }
    val layout = unsafe { sigs.find_struct(td.name.as_str(), td.crate) }
    if layout.is_some() {
        val found = layout ?: return
        while field in &found.fields {
            if !field.ty.field_is_copy(td, copy_name, ctx) {
                td.report_unsound_copy("field `${field.name.as_str()}` is not Copy", diags)
                return
            }
        }
        return
    }
    val enum_layout = unsafe { sigs.find_enum(td.name.as_str(), td.crate) }
    if enum_layout.is_some() {
        val found = enum_layout ?: return
        while variant in &found.variants {
            while payload in &variant.payloads {
                if !payload.field_is_copy(td, copy_name, ctx) {
                    val why = "variant `${variant.name.as_str()}` carries a value that is not Copy"
                    td.report_unsound_copy(why.as_str(), diags)
                    return
                }
            }
        }
    }
}

/// Whether a field of type `ty` keeps the impl sound. A type parameter is
/// Copy only where this impl bounds it so; everything else is `type_is_copy`.
pub fun Type.field_is_copy(td: &TopDecl, copy_name: str, ctx: &var TypeCtx): bool {
    return when (self.kind) {
        Generic(name) => td.type_param_bounded_by(name, copy_name)
        _ => self.type_is_copy(ctx)
    }
}

fun TopDecl.type_param_bounded_by(param: Sym, trait_name: str): bool {
    while tp in &self.generics {
        if tp.name.id == param.id {
            while bound in &tp.bounds {
                when (bound.kind) {
                    Named(name, _args) => { if name.as_str().equals(trait_name) { return true } }
                    _ => { }
                }
            }
        }
    }
    return false
}

fun TopDecl.report_unsound_copy(why: str, diags: &var Diagnostics): void {
    val message = "`${self.name.as_str()}` cannot be Copy: ${why}"
    diags.emit(new_diagnostic(Severity.Error, new_label(self.decl_name_span(), message)))
}
