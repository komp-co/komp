import kf_typecheck.typecheck_module
import kf_typecheck.types.type_eq

fun safety_method(name: str, ret: Type, generic: bool, static_method: bool, mutating_method: bool, has_default: bool): TraitMethodReq {
    return TraitMethodReq {
        name: String.from(name),
        span: no_span(),
        arity: 0,
        has_default: has_default,
        has_method_generics: generic,
        is_static: static_method,
        params: List.new<Type>(),
        ret: ret,
        is_mutating: mutating_method
    }
}

fun safety_trait(name: str, methods: List<TraitMethodReq>, associated: List<TraitAssocReq>, parameters: List<String>): TraitInfo {
    return TraitInfo {
        name: String.from(name),
        identity: intern(name), module: intern(""),
        span: no_span(),
        type_params: parameters,
        methods: methods,
        assoc_types: associated,
        supertraits: List.new<SuperTraitReq>()
    }
}

fun safety_validate(info: TraitInfo, args: List<Type>): DynTraitLayout? {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(info) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    var object_args = List.new<Type>()
    while arg in &args {
        object_args.push(arg)
    }
    val object = dyn_trait_type(info.identity, object_args, no_span())
    return object.validate_dyn_trait(no_span(), &var ctx)
}

fun safety_message(info: TraitInfo): String {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(info) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    val object = dyn_trait_type(info.identity, List.new<Type>(), no_span())
    val _layout = object.validate_dyn_trait(no_span(), &var ctx)
    return unsafe { diagnostics.at(0).primary.message }
}

struct PlacementOutcome {
    val diagnostics: List<Diagnostic>
    val layout_count: uint64
}

fun safety_placement(wrapper: uint8): PlacementOutcome {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("show", Type.new_int32(no_span()), false, false, false, false))
    val info = safety_trait("Show", methods, List.new<TraitAssocReq>(), List.new<String>())
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(info) }
    val owner: Ptr<TopDecl> = unsafe { alloc<TopDecl>() }
    unsafe { *owner = new_top_decl(no_span(), String.from("use_show"), TopDeclKind.Poison) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.metadata_owner = owner
    val dynamic = dyn_trait_type(info.identity, List.new<Type>(), no_span())
    var checked = dynamic
    if wrapper == 1 {
        val inner: Ptr<Type> = unsafe { alloc<Type>() }
        unsafe { *inner = dynamic }
        checked = Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Declared(no_span()) }
    }
    if wrapper == 3 {
        val inner: Ptr<Type> = unsafe { alloc<Type>() }
        unsafe { *inner = dynamic }
        checked = Type { kind: TypeKind.RefTo(true, inner), provenance: Provenance.Declared(no_span()) }
    }
    if wrapper == 2 { checked = Type.new_box(dynamic, no_span()) }
    checked.validate_dyn_placement(no_span(), &var ctx)
    return PlacementOutcome {
        diagnostics: unsafe { (*diagnostics).items.clone() },
        layout_count: unsafe { owner.dyn_layouts.size() }
    }
}

@test fun dyn_object_safety_rejects_associated_type(): void {
    var associated = List.new<TraitAssocReq>()
    associated.push(TraitAssocReq { name: String.from("Item"), span: no_span(), bounds: List.new<AssocBoundReq>() })
    val info = safety_trait("HasType", List.new<TraitMethodReq>(), associated, List.new<String>())
    assert_eq(safety_message(info).as_str(), "trait `HasType` cannot be used as dyn because it declares associated type `Item`", "associated types prevent object use")
}

@test fun dyn_object_safety_rejects_generic_method(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("map", Type.new_int32(no_span()), true, false, false, false))
    val info = safety_trait("GenericMethod", methods, List.new<TraitAssocReq>(), List.new<String>())
    assert_eq(safety_message(info).as_str(), "trait method `map` cannot be used through dyn because it is generic", "generic methods have no fixed slot")
}

@test fun dyn_object_safety_rejects_static_method(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("make", Type.new_int32(no_span()), false, true, false, false))
    val info = safety_trait("Factory", methods, List.new<TraitAssocReq>(), List.new<String>())
    assert_eq(safety_message(info).as_str(), "static trait method `make` has no dynamic receiver", "static methods cannot dispatch through an object")
}

@test fun dyn_object_safety_rejects_self_return(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("clone", Type.new_generic(String.from("Self"), no_span()), false, false, false, false))
    val info = safety_trait("Cloner", methods, List.new<TraitAssocReq>(), List.new<String>())
    assert_eq(safety_message(info).as_str(), "trait method `clone` exposes `Self` outside its receiver", "Self cannot escape a dynamic call")
}

@test fun dyn_object_safety_accepts_normal_method(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("show", Type.new_int32(no_span()), false, false, false, false))
    val info = safety_trait("Show", methods, List.new<TraitAssocReq>(), List.new<String>())
    assert_eq(safety_validate(info, List.new<Type>()).is_some(), true, "ordinary receiver methods are object-safe")
}

@test fun dyn_object_safety_keeps_mutating_slot(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("clear", Type.new_void(no_span()), false, false, true, false))
    val info = safety_trait("Clear", methods, List.new<TraitAssocReq>(), List.new<String>())
    when (safety_validate(info, List.new<Type>())) {
        Some(layout) => assert_eq(layout.methods.at(0).is_mutating, true, "mutating dispatch is recorded in its slot")
        None => assert_eq(false, true, "mutating methods should be object-safe")
    }
}

@test fun dyn_object_safety_accepts_default_method(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("show", Type.new_int32(no_span()), false, false, false, true))
    val info = safety_trait("DefaultShow", methods, List.new<TraitAssocReq>(), List.new<String>())
    assert_eq(safety_validate(info, List.new<Type>()).is_some(), true, "a default body does not change object safety")
}

@test fun dyn_object_safety_substitutes_trait_parameter(): void {
    var parameters = List.new<String>()
    parameters.push(String.from("T"))
    var method_parameters = List.new<Type>()
    method_parameters.push(Type.new_generic(String.from("T"), no_span()))
    var methods = List.new<TraitMethodReq>()
    methods.push(TraitMethodReq {
        name: String.from("send"),
        span: no_span(),
        arity: 1,
        has_default: false,
        has_method_generics: false,
        is_static: false,
        params: method_parameters,
        ret: Type.new_void(no_span()),
        is_mutating: false
    })
    val info = safety_trait("Sink", methods, List.new<TraitAssocReq>(), parameters)
    var args = List.new<Type>()
    args.push(Type.new_int32(no_span()))
    when (safety_validate(info, args)) {
        Some(layout) => assert_eq(type_eq(layout.methods.at(0).params.at(0), &Type.new_int32(no_span())), true, "trait parameters become object arguments")
        None => assert_eq(false, true, "generic traits can be object-safe")
    }
}

@test fun dyn_object_safety_rejects_bare_placement(): void {
    val outcome = safety_placement(0)
    assert_eq(outcome.diagnostics.at(0).primary.message.as_str(), "`dyn Show` is unsized and must be used directly behind `&` or `&var`", "bare dynamic types name their required placement")
}

@test fun dyn_object_safety_accepts_direct_borrowed_placement(): void {
    val outcome = safety_placement(1)
    assert_eq(outcome.layout_count, 1, "a borrowed dynamic type records its layout on the declaration")
}

@test fun dyn_object_safety_rejects_boxed_placement(): void {
    val outcome = safety_placement(2)
    assert_eq(outcome.diagnostics.size(), 1, "Box does not make a dynamic type sized in v1")
}

@test fun dyn_object_safety_accepts_direct_mutable_placement(): void {
    val outcome = safety_placement(3)
    assert_eq(outcome.layout_count, 1, "a mutable borrowed dynamic type records its layout")
}

fun dyn_vtable_type_ref(name: str): Ptr<TypeRef> {
    val result: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *result = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>())) }
    return result
}

fun borrowed_dyn_type_ref(name: str): Ptr<TypeRef> {
    val args = List.new<TypeRef>()
    val dynamic: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *dynamic = TypeRef.new(no_span(), TypeRefKind.DynTrait(intern(name), args)) }
    val borrowed: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *borrowed = TypeRef.new(no_span(), TypeRefKind.Reference(false, dynamic)) }
    return borrowed
}

fun dyn_vtable_trait_decl(): TopDecl {
    val method = new_top_decl(no_span(), String.from("show"), TopDeclKind.Function(List.new<Param>(), dyn_vtable_type_ref("int32"), List.new<Stmt>(), true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(method)
    return new_top_decl(no_span(), String.from("Show"), TopDeclKind.TraitDecl(methods, true, List.new<TypeRef>()))
}

fun dyn_vtable_impl_decl(): TopDecl {
    var body = List.new<Stmt>()
    val value: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *value = Expr.new(no_span(), ExprKind.LitInt(1)) }
    body.push(Stmt.new(no_span(), StmtKind.Return(Option.Some(value))))
    val method = new_top_decl(no_span(), String.from("show"), TopDeclKind.Function(List.new<Param>(), dyn_vtable_type_ref("int32"), body, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(method)
    return new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(dyn_vtable_type_ref("Show"), methods))
}

fun dyn_vtable_imported_impl_decl(): TopDecl {
    var method = new_top_decl(no_span(), String.from("show"), TopDeclKind.Function(List.new<Param>(), dyn_vtable_type_ref("int32"), List.new<Stmt>(), true, false, false, false))
    method.linkage = Linkage.ImportedCompiled
    method.link_name = intern("dep_exact_show")
    var methods = List.new<TopDecl>()
    methods.push(method)
    var implementation = new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(dyn_vtable_type_ref("Show"), methods))
    implementation.linkage = Linkage.ImportedCompiled
    return implementation
}

fun TopDecl.first_dyn_adapter(): String {
    if self.dyn_vtables.size() == 0 { return String.from("missing vtable") }
    val vtable = self.dyn_vtables.at(0)
    if vtable.adapters.size() == 0 { return String.from("missing adapter") }
    return vtable.adapters.get(0).as_string()
}

@test fun dyn_object_safety_records_non_generic_impl_vtable(): void {
    var module = new_module(List.new<String>())
    module.decls.push(dyn_vtable_trait_decl())
    module.decls.push(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true)))
    module.decls.push(dyn_vtable_impl_decl())
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val _diagnostics = module.typecheck_module(&var declarations)
    assert_eq(module.decls.at(2).dyn_vtables.size(), 1, "a concrete trait impl owns one dynamic vtable record")
}

@test fun dyn_object_safety_keeps_imported_adapter_symbol(): void {
    var methods = List.new<TraitMethodReq>()
    methods.push(safety_method("show", Type.new_int32(no_span()), false, false, false, false))
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(safety_trait("Show", methods, List.new<TraitAssocReq>(), List.new<String>())) }
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    var implementation = dyn_vtable_imported_impl_decl()
    implementation.register_dyn_vtable_decl(signatures, unsafe { &var *diagnostics })
    val adapter = implementation.first_dyn_adapter()
    assert_eq(adapter.as_str(), "dep_exact_show", "imported vtables preserve the archive symbol")
}

@test fun dyn_object_safety_records_function_signature_layout(): void {
    var module = new_module(List.new<String>())
    module.decls.push(new_top_decl(no_span(), String.from("make"), TopDeclKind.Function(List.new<Param>(), borrowed_dyn_type_ref("Show"), List.new<Stmt>(), true, false, false, false)))
    module.decls.push(dyn_vtable_trait_decl())
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val _diagnostics = module.typecheck_module(&var declarations)
    assert_eq(module.decls.at(0).dyn_layouts.size(), 1, "function signatures own their dynamic layouts")
}

@test fun dyn_object_safety_records_field_layout_before_later_trait(): void {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("shown"), borrowed_dyn_type_ref("Show"), false, true))
    var module = new_module(List.new<String>())
    module.decls.push(new_top_decl(no_span(), String.from("View"), TopDeclKind.Struct(fields, true)))
    module.decls.push(dyn_vtable_trait_decl())
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val _diagnostics = module.typecheck_module(&var declarations)
    assert_eq(module.decls.at(0).dyn_layouts.size(), 1, "field layout registration does not depend on trait order")
}

@test fun dyn_object_safety_records_local_annotation_layout(): void {
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = Expr.new(no_span(), ExprKind.LitInt(1)) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("shown"), borrowed_dyn_type_ref("Show"), init)))
    var module = new_module(List.new<String>())
    module.decls.push(new_top_decl(no_span(), String.from("use_show"), TopDeclKind.Function(List.new<Param>(), dyn_vtable_type_ref("void"), body, true, false, false, false)))
    module.decls.push(dyn_vtable_trait_decl())
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val _diagnostics = module.typecheck_module(&var declarations)
    assert_eq(module.decls.at(0).dyn_layouts.size(), 1, "local annotations attach dynamic layouts to their function")
}
