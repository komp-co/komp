import core.assert.assert_eq

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.crate_id_poison
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_typecheck.new_sig_table

// `Holder` stands in for alloc's `String`, which declares `byte_len` both
// inherently and through `impl Text`.

fun holder_ty(): Type {
    return Type { kind: TypeKind.Struct(intern("Holder")), provenance: Provenance.Inferred(no_span()) }
}

fun insert_size_method(sp: Ptr<SigTable>, name: str, is_static: bool, params: uint64): void {
    var ps = List.new<Type>()
    var i: uint64 = 0
    while i < params {
        ps.push(holder_ty())
        i = i + 1
    }
    val ret = Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
    unsafe { sp.insert(FnSignature { name: String.from(name), params: ps, ret: ret,
        generics: List.new<String>(), is_static: is_static, is_mutating: false,
        owner_module: intern(""), owner_crate: crate_id_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false,
        is_extern: false }) }
}

/// With the `Text` impl, and its own `size` when `inherent`.
fun holder_table(inherent: bool): Ptr<SigTable> {
    val sp: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sp = new_sig_table() }
    unsafe { sp.insert_struct(StructLayout { name: String.from("Holder"), fields: List.new<StructFieldInfo>(),
        is_refcounted: false, owner_crate: crate_id_poison() }) }
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("Holder"), receiver_identity: intern("Holder"),
        trait_name: String.from("Text"), trait_args: "", generics: "", arg_count: 0 }) }
    insert_size_method(sp, "Holder_size__Text", false, 1)
    if inherent { insert_size_method(sp, "Holder_size", false, 1) }
    return sp
}

@test
fun an_inherent_method_answers_for_the_call(): void {
    val sp = holder_table(true)
    val symbol = inherent_method_symbol(holder_ty(), String.from("size"), 0, sp)
    assert_eq(symbol.as_str(), "Holder_size", "the type's own method is the one the author declared")
}

@test
fun a_trait_only_method_leaves_the_call_to_trait_dispatch(): void {
    val sp = holder_table(false)
    val symbol = inherent_method_symbol(holder_ty(), String.from("size"), 0, sp)
    assert_eq(symbol.as_str(), "", "with no inherent method there is nothing to prefer")
}

// An inherent method of another arity does not claim the call.
@test
fun an_inherent_method_of_another_arity_does_not_claim_the_call(): void {
    val sp = holder_table(true)
    val symbol = inherent_method_symbol(holder_ty(), String.from("size"), 1, sp)
    assert_eq(symbol.as_str(), "", "self plus one argument is a different method")
}

@test
fun a_static_method_is_not_an_instance_callee(): void {
    val sp = holder_table(false)
    insert_size_method(sp, "Holder_size", true, 1)
    val symbol = inherent_method_symbol(holder_ty(), String.from("size"), 0, sp)
    assert_eq(symbol.as_str(), "", "a static takes no receiver, so it answers no instance call")
}

// A borrowed receiver dispatches the same.
@test
fun a_borrowed_receiver_finds_its_own_method(): void {
    val sp = holder_table(true)
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = holder_ty() }
    val borrowed = Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Inferred(no_span()) }
    val symbol = inherent_method_symbol(borrowed, String.from("size"), 0, sp)
    assert_eq(symbol.as_str(), "Holder_size", "a borrow dispatches to the same method a value does")
}
