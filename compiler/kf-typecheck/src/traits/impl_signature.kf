// An impl method must have the trait's signature, not just its name and
// arity: the dyn adapter uses the trait's signature, and C converts silently
// where they differ. The trait's types are read with its parameters taking
// the impl's arguments and `Self` as the implementing type.

import alloc.list.*

import kf_core.ast.intern
import kf_core.ast.types.*
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.span.*
import kf_typecheck.types.*

/// Arity is checked by the caller.
pub fun TraitMethodReq.check_impl_method_types(tname: &String, trait_ref: &TypeRef, target: str, self_ty: &Type, impl_method: &TopDecl, diags: &var Diagnostics, ctx: &var TypeCtx): void {
    when (impl_method.kind) {
        Function(params, ret_ptr, _b, _p, _u, _mut, _s) => {
            if params.size() != self.params.size() { return }
            val targs = trait_ref_arg_names(unsafe { *trait_ref })
            while i in 0..params.size() {
                val want = expected_trait_type(*self.params.at(i), tname.as_str(), &targs, target, self_ty, ctx)
                val got = impl_written_type(unsafe { *(params.at(i).ty) }, target, ctx)
                if !want.impl_type_matches(&got) {
                    emit_signature_err(diags, params.at(i).span, "parameter", &want, &got, self, tname, ctx)
                }
            }
            val want_ret = expected_trait_type(self.ret, tname.as_str(), &targs, target, self_ty, ctx)
            val got_ret = impl_written_type(unsafe { *ret_ptr }, target, ctx)
            if !want_ret.impl_type_matches(&got_ret) {
                emit_signature_err(diags, impl_method.span, "return type", &want_ret, &got_ret, self, tname, ctx)
            }
        }
        _ => { }
    }
}

/// The trait's parameters take the impl's arguments, `Self` becomes the
/// target, and associated types this impl's bindings.
fun expected_trait_type(declared: Type, tname: str, targs: &List<String>, target: str, self_ty: &Type, ctx: &var TypeCtx): Type {
    val mapped = subst_trait_params(declared, tname, targs, ctx)
    // CONSTRAINT: projections first, while the owner is still `Self`;
    // substituting `Self` first gives an owner no binding is keyed by.
    val unprojected = mapped.resolve_impl_projection(target, ctx)
    return unprojected.subst_generic(String.from("Self"), unsafe { *self_ty })
}

/// Normalised the same way: an impl may write `ListIter<T>` or `Self.Iter`.
fun impl_written_type(tr: TypeRef, target: str, ctx: &var TypeCtx): Type {
    val resolved = tr.resolve_type_ref(ctx)
    return resolved.resolve_impl_projection(target, ctx)
}

/// Follows the impl's own `type Iter = ...`.
fun Type.resolve_impl_projection(target: str, ctx: &var TypeCtx): Type {
    when (self.kind) {
        Projection(_owner, member) => {
            // Qualified by the impl's trait instantiation; unqualified, both
            // sides would get the same wrong first binding and agree.
            val tn = ctx.impl_trait.as_str()
            val ta = ctx.impl_trait_args.as_str()
            val chosen = unsafe { (*ctx.sigs).lookup_assoc_binding_in(target, tn, ta, member.as_str()) }
            // Already reported as a missing associated type.
            if chosen.is_poison() { return unsafe { *self } }
            return chosen
        }
        // A projection behind a borrow (`&Self.Out`, the natural index
        // signature) is resolved qualified here; the catch-all below resolves
        // unqualified and would find two bindings on a type with two
        // instantiations.
        RefTo(m, p) => {
            val inner = resolve_impl_projection(unsafe { &*p }, target, ctx)
            val np = type_node(inner)
            return Type { kind: TypeKind.RefTo(m, np), provenance: self.provenance }
        }
        PtrTo(p) => {
            val inner = resolve_impl_projection(unsafe { &*p }, target, ctx)
            val np = type_node(inner)
            return Type { kind: TypeKind.PtrTo(np), provenance: self.provenance }
        }
        BoxOf(p) => {
            val inner = resolve_impl_projection(unsafe { &*p }, target, ctx)
            val np = type_node(inner)
            return Type { kind: TypeKind.BoxOf(np), provenance: self.provenance }
        }
        // Elsewhere the projection is folded into an instance name
        // (`Wrap__Proj__Self__Out__EndProj`) and read back out of it.
        _ => return self.resolved_projection_type(target, ctx.sigs)
    }
}

/// Poison on either side is already reported.
fun Type.impl_type_matches(got: &Type): bool {
    if self.is_poison() { return true }
    if got.is_poison() { return true }
    return type_eq(unsafe { *self }, unsafe { *got })
}

fun emit_signature_err(diags: &var Diagnostics, span: Span, what: str, want: &Type, got: &Type, req: &TraitMethodReq, tname: &String, ctx: &TypeCtx): void {
    val wanted = want.display_type(ctx)
    val actual = got.display_type(ctx)
    val message = "`${req.name.as_str()}` declares ${what} `${actual.as_str()}` where trait `${tname.as_str()}` requires `${wanted.as_str()}`"
    diags.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// Generic impls carry their parameters: `impl Compare for Pair<A, B>` reads
/// `cmp(other: Pair<A, B>)`.
pub fun impl_self_type(target: str, gnames: &List<String>, span: Span, ctx: &var TypeCtx): Type {
    var args = List.new<TypeRef>()
    while gname in &gnames {
        args.push(TypeRef.new(span, TypeRefKind.Named(intern(gname.as_str()), List.new<TypeRef>())))
    }
    return (TypeRef.new(span, TypeRefKind.Named(intern(target), args))).resolve_type_ref(ctx)
}
