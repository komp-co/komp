import core.assert.assert_eq

import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.TypeIdentity
import kf_core.ast.types.TypeKind
import kf_core.ast.types.canonical_type_identity

// A receiver type may carry the declared name (from a literal) or the
// canonical identity (from an annotation); both answer with the declared
// name impls are registered under.

@test
fun identity_typed_receiver_answers_with_its_declared_name(): void {
    val identity = canonical_type_identity(TypeIdentity.new(new_crate_id("app"), intern("models"), intern("Point")))
    val name: String = TypeKind.Struct(identity).trait_impl_owner_name()
    assert_eq(name.as_str(), "Point", "a canonical identity looks up impls under the declared name")
}

@test
fun bare_receiver_answers_with_its_own_name(): void {
    val name: String = TypeKind.Struct(intern("Point")).trait_impl_owner_name()
    assert_eq(name.as_str(), "Point", "a bare receiver name is already the impl spelling")
}

@test
fun monomorphized_instance_keeps_its_mangled_name(): void {
    val name: String = TypeKind.Struct(intern("List__int32")).trait_impl_owner_name()
    assert_eq(name.as_str(), "List__int32", "an instance keeps the mangled name its impls are keyed on")
}

@test
fun a_primitive_answers_with_its_spelling(): void {
    val name: String = TypeKind.Int32.trait_impl_owner_name()
    assert_eq(name.as_str(), "int32", "primitives carry impls under their spelling")
}
