// The traits whose impls for one type both provide a method a call names.

import alloc.list.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_typecheck.types.type_eq
import kf_typecheck.check.mangle_base_name
import kf_typecheck.check.autoderef_ty

pub fun instance_trait_method_is_ambiguous(receiver_ty: Type, method_name: String, args: &List<Expr>,
    ctx: &var TypeCtx): bool {
    return providing_traits(receiver_ty, method_name, args, ctx).size() > 1
}

/// The traits whose impl for the receiver's type has an instance method
/// `method_name` these arguments fit, in impl order.
pub fun providing_traits(receiver_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): List<String> {
    var traits = List.new<String>()
    val recv = autoderef_ty(receiver_ty)
    val type_name = recv.kind.trait_impl_owner_name()
    if type_name.is_empty() { return traits }
    val base = mangle_base_name(type_name.clone())
    var i = 0
    while i < unsafe { (*ctx.sigs).trait_impls.size() } {
        val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
        i = i + 1
        if !trait_impl.type_name.as_str().equals(base.as_str()) { continue }
        if ctx.is_auto_trait(trait_impl.trait_name.as_str()) { continue }
        var suffix = trait_impl.trait_name.clone()
        if !trait_impl.trait_args.as_str().equals("") {
            suffix = suffix + String.from("__") + trait_impl.trait_args.clone()
        }
        val candidate = type_name.clone() + String.from("_") + method_name.clone() + String.from("__") + suffix
        val sig = unsafe { (*ctx.sigs).find_signature(candidate.as_str()) } ?: continue
        if sig.is_static || sig.params.size() != args.size() + 1 { continue }
        var fits = true
        while j in 0..args.size() {
            val arg = *args.at(j)
            val expected = *sig.params.at(j + 1)
            // The same applicability rule as selection, so two applicable
            // impls are seen as ambiguous.
            if !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) && !arg.ty.could_dyn_coerce(&expected, ctx) {
                fits = false
            }
        }
        if fits { traits.push(trait_impl.trait_name.clone()) }
    }
    return traits
}
