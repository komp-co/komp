// The checks that read supertraits, run after registration: a supertrait may
// be declared below its subtrait and an impl above its supertrait's.

import alloc.list.*

import kf_core.diagnostic.*
import kf_core.ast.*

/// Every implementor of a trait implements what it requires. Walks this
/// module's own impls (for spans; dependencies were checked in their crate);
/// the satisfying impl may come from anywhere. Arguments must match:
/// `impl Sink<int32>` owes `Drain<int32>`.
pub fun Module.check_supertrait_obligations(sigs: &SigTable, diags: Ptr<List<Diagnostic>>): void {
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                val trait_ref = unsafe { *tref }
                when (trait_ref.kind) {
                    Named(trait_sym, targs) => td.check_one_impl(trait_sym.as_str(), trait_args_key(&targs).as_str(), sigs, diags)
                    _ => { }
                }
            }
            _ => { }
        }
    }
}

fun TopDecl.check_one_impl(trait_name: str, impl_args: str, sigs: &SigTable, diags: Ptr<List<Diagnostic>>): void {
    // A cycle is left to check_supertrait_cycles.
    if sigs.supertrait_cycle_from(trait_name) { return }
    val required = sigs.supertrait_closure_reqs(trait_name, impl_args)
    while needed in &required {
        if !self.receiver_implements(needed.name.as_str(), needed.args.as_str(), sigs) {
            val shown = render_trait_ref(needed.name.as_str(), needed.args.as_str())
            var message = ""
            message.append(self.name.as_str())
            message.append(" implements ")
            message.append(render_trait_ref(trait_name, impl_args).as_str())
            message.append(", which requires ")
            message.append(shown.as_str())
            message.append(" — add impl ")
            message.append(shown.as_str())
            message.append(" for ")
            message.append(self.name.as_str())
            unsafe { diags.push(new_diagnostic(Severity.Error, new_label(self.decl_name_span(), message))) }
        }
    }
}

/// `CallMut1<int32>`, so a wrong-argument requirement is not mistaken for a
/// missing trait.
fun render_trait_ref(name: str, args: str): String {
    var out = String.from(name)
    if args.byte_len() == 0 { return out }
    out.append("<")
    val segs = key_segments(args)
    while i in 0..segs.size() {
        if i > 0 { out.append(", ") }
        out.append(segs.at(i).as_str())
    }
    out.append(">")
    return out
}

/// `find_trait_impl`'s receiver rule, then `trait_args_satisfy`.
fun TopDecl.receiver_implements(trait_name: str, needed_args: str, sigs: &SigTable): bool {
    var identity = self.name
    if !self.crate.is_poison() {
        identity = canonical_type_identity(new_type_identity(self.crate, self.module_path, self.name))
    }
    // Runtime and `@no_mangle` types belong to no crate: core's
    // `impl Add for int32` and a program's `impl Num for int32` name one type
    // under two identities, so they match by name.
    var has_identity = !identity.as_str().equals("")
    if shares_one_namespace(self.name.as_str(), sigs) { has_identity = false }
    while fact in &sigs.trait_impls {
        if fact.trait_name.as_str().equals(trait_name) {
            var receiver_matches = false
            if has_identity {
                receiver_matches = fact.receiver_identity.id == identity.id
            } else {
                receiver_matches = fact.type_name.as_str().equals(self.name.as_str())
            }
            if receiver_matches {
                // The impl's own params are placeholders:
                // `impl CallMut1<T> for L<T>` satisfies `CallMut1<int32>`.
                if trait_args_satisfy(needed_args, fact.trait_args.as_str(), fact.generics.as_str(), fact.arg_count, &List.new<String>()) { return true }
            }
        }
    }
    return false
}

/// Runtime types and `@no_mangle` types.
fun shares_one_namespace(name: str, sigs: &SigTable): bool {
    if is_runtime_type_name(name) { return true }
    if is_container_type_name(name, sigs.lang_list, sigs.lang_option) { return true }
    while recorded in &sigs.no_mangle_types {
        if recorded.as_str().equals(name) { return true }
    }
    return false
}

/// An associated type may be declared once across a trait and its
/// supertraits; a redeclaration would make `T.Out` name two things. This
/// module's own traits only.
pub fun Module.check_supertrait_assoc_shadowing(sigs: &SigTable, diags: Ptr<List<Diagnostic>>): void {
    while td in &self.decls {
        when (td.kind) {
            TraitDecl(_methods, _is_pub, _supers) => check_trait_assoc_shadowing(td.name.as_str(), sigs, diags)
            _ => { }
        }
    }
}

/// Public: the walk above only picks which traits to check, and a table is
/// cheaper to build in a test than a Module.
pub fun check_trait_assoc_shadowing(name: str, sigs: &SigTable, diags: Ptr<List<Diagnostic>>): void {
    // A cycle is left to check_supertrait_cycles.
    if sigs.supertrait_cycle_from(name) { return }
    when (sigs.find_unique_trait(name)) {
        None => return
        Some(info) => {
            val required = sigs.supertrait_closure(name)
            while own in &info.assoc_types {
                while item in &required {
                    if sigs.trait_declares_assoc(item.as_str(), own.name.as_str()) {
                        val message = "trait ${name} redeclares associated type ${own.name.as_str()}, already declared by ${item.as_str()}"
                        unsafe { diags.push(new_diagnostic(Severity.Error, new_label(own.span, message))) }
                    }
                }
            }
        }
    }
}

fun SigTable.trait_declares_assoc(trait_name: str, assoc: str): bool {
    when (self.find_unique_trait(trait_name)) {
        None => return false
        Some(info) => {
            while assoc_type in &info.assoc_types {
                if assoc_type.name.as_str().equals(assoc) { return true }
            }
        }
    }
    return false
}

/// Runs before the obligation check, whose answer is meaningless on a cycle.
pub fun SigTable.check_supertrait_cycles(diags: Ptr<List<Diagnostic>>): void {
    while info in &self.traits {
        if self.supertrait_cycle_from(info.name.as_str()) {
            val message = "trait ${info.name.as_str()}'s supertraits form a cycle"
            unsafe { diags.push(new_diagnostic(Severity.Error, new_label(info.span, message))) }
        }
    }
}
