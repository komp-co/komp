// `N` in `impl<N: uint64> Absorb<int64[N]> for Tally`: a parameter the
// impl's trait arguments supply, bound per call from what is passed.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.span.Span
import kf_typecheck.types.subst_generic
import kf_typecheck.types.type_to_type_ref
import kf_typecheck.check.static_recv_arity

impl TraitCallee {
    /// A parameter type of the selected method, with the lifted parameters
    /// bound.
    pub fun bind_lifted(t: Type): Type {
        var out = t
        while i in 0..self.lifted_names.size() {
            out = out.subst_generic(self.lifted_names.at(i).clone(), self.lifted.at(i).clone())
        }
        return out
    }

    /// The lifted parameters as the call's type arguments, which mono reads.
    pub fun lifted_args(span: Span): List<TypeRef> {
        var out = List.new<TypeRef>()
        while t in &self.lifted { out.push(t.type_to_type_ref(span)) }
        return out
    }
}

/// The impl's parameters its trait's arguments supplied. The registry keys
/// the target's parameters first, as many as the type declares, and these
/// after them.
fun TraitImplInfo.lifted_names(ctx: &var TypeCtx): List<String> {
    var out = List.new<String>()
    if self.generics.as_str() == "" { return out }
    val own = self.type_name.static_recv_arity(ctx)
    val names = self.generics.as_str().split("__")
    while i in own..names.size() { out.push(names.at(i).clone()) }
    return out
}
