import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.types.Type

// An abstract trait argument: a bound check defers (""), a mangling caller
// keeps the parameter's name for Mono to substitute.

@test
fun mangling_keeps_the_parameter_name_for_an_abstract_argument(): void {
    var gnames = List.new<String>()
    gnames.push(String.from("T"))
    var bound_tys = List.new<Type>()
    bound_tys.push(Type.new_generic(String.from("K"), no_span()))
    val out = subst_trait_args("T", &gnames, &bound_tys, true)
    assert_eq(out.as_str(), "K", "a mangled suffix keeps the abstract parameter's own name")
}

@test
fun bound_checking_still_defers_on_an_abstract_argument(): void {
    var gnames = List.new<String>()
    gnames.push(String.from("T"))
    var bound_tys = List.new<Type>()
    bound_tys.push(Type.new_generic(String.from("K"), no_span()))
    val out = subst_trait_args("T", &gnames, &bound_tys, false)
    assert_eq(out.as_str(), "", "a bound that cannot yet be judged is not silently accepted")
}

@test
fun both_callers_agree_on_a_concrete_argument(): void {
    var gnames = List.new<String>()
    gnames.push(String.from("T"))
    var bound_tys = List.new<Type>()
    bound_tys.push(Type.new_int32(no_span()))
    assert_eq(subst_trait_args("T", &gnames, &bound_tys, true).as_str(), "int32", "mangling a concrete argument")
    assert_eq(subst_trait_args("T", &gnames, &bound_tys, false).as_str(), "int32", "bound-checking a concrete argument")
}
