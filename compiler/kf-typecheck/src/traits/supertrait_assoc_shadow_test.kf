// An associated type is declared once across a trait and its supertraits:
// names two hops up, and cases that must stay quiet.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.diagnostic.*
import kf_typecheck.new_sig_table

fun shadow_trait(name: str, supers: List<String>, assocs: List<String>): TraitInfo {
    var reqs = List.new<SuperTraitReq>()
    while super in &supers {
        reqs.push(SuperTraitReq { name: String.from(super.as_str()), args: "", span: no_span() })
    }
    var assoc_reqs = List.new<TraitAssocReq>()
    while assoc in &assocs {
        assoc_reqs.push(TraitAssocReq { name: String.from(assoc.as_str()), span: no_span(), bounds: List.new<AssocBoundReq>() })
    }
    return TraitInfo {
        name: String.from(name),
        identity: intern(name), module: intern(""),
        span: no_span(),
        type_params: List.new<String>(),
        methods: List.new<TraitMethodReq>(),
        assoc_types: assoc_reqs,
        supertraits: reqs
    }
}

fun shadow_names(one: str): List<String> {
    var out = List.new<String>()
    out.push(String.from(one))
    return out
}

fun no_shadow_names(): List<String> {
    return List.new<String>()
}

fun SigTable.shadow_diag_count(name: str): uint64 {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    check_trait_assoc_shadowing(name, self, unsafe { &var *diagnostics })
    return unsafe { (*diagnostics).size() }
}

@test fun redeclaring_a_direct_supertraits_assoc_is_reported(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(shadow_trait("Producer", no_shadow_names(), shadow_names("Out")))
    sigs.insert_trait(shadow_trait("Doubler", shadow_names("Producer"), shadow_names("Out")))
    assert_eq(sigs.shadow_diag_count("Doubler"), 1, "Doubler redeclares Producer's Out")
}

@test fun redeclaring_across_a_chain_is_reported(): void {
    // Transitive: two hops up still collides.
    var sigs = new_sig_table()
    sigs.insert_trait(shadow_trait("Producer", no_shadow_names(), shadow_names("Out")))
    sigs.insert_trait(shadow_trait("Doubler", shadow_names("Producer"), no_shadow_names()))
    sigs.insert_trait(shadow_trait("Tripler", shadow_names("Doubler"), shadow_names("Out")))
    assert_eq(sigs.shadow_diag_count("Tripler"), 1, "Tripler redeclares Producer's Out")
}

@test fun declaring_an_assoc_no_supertrait_has_is_quiet(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(shadow_trait("Producer", no_shadow_names(), shadow_names("Out")))
    sigs.insert_trait(shadow_trait("Doubler", shadow_names("Producer"), shadow_names("Item")))
    assert_eq(sigs.shadow_diag_count("Doubler"), 0, "a different name is not a redeclaration")
}

@test fun inheriting_an_assoc_without_redeclaring_is_quiet(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(shadow_trait("Producer", no_shadow_names(), shadow_names("Out")))
    sigs.insert_trait(shadow_trait("Doubler", shadow_names("Producer"), no_shadow_names()))
    assert_eq(sigs.shadow_diag_count("Doubler"), 0, "inheriting Out is the point of the feature")
}

@test fun a_cycle_reports_nothing_here(): void {
    // A cycle is left to check_supertrait_cycles.
    var sigs = new_sig_table()
    sigs.insert_trait(shadow_trait("Alpha", shadow_names("Beta"), shadow_names("Out")))
    sigs.insert_trait(shadow_trait("Beta", shadow_names("Alpha"), shadow_names("Out")))
    assert_eq(sigs.shadow_diag_count("Alpha"), 0, "the cycle error stands alone")
}
