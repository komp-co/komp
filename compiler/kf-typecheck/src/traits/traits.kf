// Trait impls checked against their trait: every required method present
// with matching arity and types, nothing undeclared, and the associated-type
// contract.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.span.*
import kf_typecheck.types.tref_name_key

pub fun check_satisfies(trait_ref: TypeRef, target: str, gnames: List<String>, methods: List<TopDecl>, span: Span, diags: &var Diagnostics, sigs: Ptr<SigTable>, ctx: &var TypeCtx): void {
    if impl_has_parse_poison(&methods) { return }
    val tname = trait_ref_name(trait_ref)
    when (unsafe { sigs.find_trait(tname.as_str()) }) {
        Some(ti) => check_impl_contract(ti, tname.clone(), trait_ref, target, gnames, methods, span, diags, sigs, ctx)
        None => emit_trait_err(diags, span, "unknown trait `${tname}`")
    }
}

fun impl_has_parse_poison(methods: &List<TopDecl>): bool {
    while method in &methods {
        when (method.kind) {
            Poison => return true
            _ => { }
        }
    }
    return false
}

fun check_impl_contract(ti: TraitInfo, tname: String, trait_ref: TypeRef, target: str, gnames: List<String>, methods: List<TopDecl>, span: Span, diags: &var Diagnostics, sigs: Ptr<SigTable>, ctx: &var TypeCtx): void {
    val self_ty = impl_self_type(target, &gnames, span, ctx)
    while req in &ti.methods {
        if !req.has_default {
            val found = find_method_arity(methods, req.name.as_str())
            if found < 0 {
                emit_trait_err(diags, span, "impl of trait `${tname}` is missing method `${req.name}`")
            } else {
                if (found as uint64) != req.arity {
                    emit_trait_err(diags, span, "method `${req.name}` has wrong arity in impl of `${tname}`")
                } else {
                    req.check_named_method_types(&tname, &trait_ref, target, &self_ty, methods, diags, ctx)
                }
            }
        }
    }
    while mm in &methods {
        // Associated-type bindings are checked against associated types below.
        if !decl_is_assoc_type(mm) {
            if !trait_has_method(ti, mm.name.as_str()) {
                emit_trait_err(diags, span, "method `${mm.name.as_string()}` is not a member of trait `${tname}`")
            }
        }
    }
    check_assoc_types(ti, tname, target, &trait_ref_arg_names(trait_ref), trait_ref_args_key(trait_ref).as_str(), methods, span, diags, sigs)
}

/// Every declared associated type bound exactly once, nothing extra, and each
/// choice within its bounds.
fun check_assoc_types(ti: TraitInfo, tname: String, target: str, trait_args: &List<String>, trait_args_k: str, methods: List<TopDecl>, span: Span, diags: &var Diagnostics, sigs: Ptr<SigTable>): void {
    while req in &ti.assoc_types {
        if !impl_binds_assoc(methods, req.name.as_str()) {
            emit_trait_err(diags, span, "impl of trait `${tname}` is missing associated type `${req.name}`")
        }
    }
    // Undeclared bindings and bounds share one walk.
    while mm in &methods {
        when (mm.kind) {
            AssocTypeBinding(_chosen) => {
                val idx = trait_assoc_index(ti, mm.name.as_str())
                if idx < 0 {
                    emit_trait_err(diags, span, "associated type `${mm.name.as_string()}` is not a member of trait `${tname}`")
                } else {
                    check_assoc_bounds(*ti.assoc_types.at(idx as uint64), tname.clone(), target, &ti.type_params, trait_args, trait_args_k, mm.name.as_str(), span, diags, sigs)
                }
            }
            _ => { }
        }
    }
}

/// The choice is read back from the sig table, resolved in the impl's scope.
fun check_assoc_bounds(req: TraitAssocReq, tname: String, target: str, trait_params: &List<String>, trait_args: &List<String>, trait_args_k: str, assoc_name: str, span: Span, diags: &var Diagnostics, sigs: Ptr<SigTable>): void {
    if req.bounds.size() == 0 { return }
    // This impl's own instantiation's choice.
    val chosen = unsafe { sigs.lookup_assoc_binding_in(target, tname.as_str(), trait_args_k, assoc_name) }
    val chosen_key = chosen.type_registry_key()
    // "" for an unpinned parameter or an already-reported failure.
    if chosen_key.as_str().equals("") { return }
    while bound in &req.bounds {
        // The bound is in the trait's parameters: `type Out: Sink<P>` in
        // `trait Producer<P>` means `Sink<int32>` for `impl Producer<int32>`.
        val want_args = mapped_args_key(&bound.arg_names, trait_params, trait_args)
        if !unsafe { sigs.type_implements(chosen_key.as_str(), bound.trait_name.as_str(), want_args.as_str()) } {
            var message = String.from("associated type `")
            message.append(assoc_name)
            message.append("` of trait `")
            message.append(tname.as_str())
            message.append("` is bound to `")
            message.append(chosen_key.as_str())
            message.append("`, which does not implement `")
            message.append(bound.trait_name.as_str())
            message.append("`")
            emit_trait_err(diags, span, message)
        }
    }
}

fun impl_binds_assoc(methods: List<TopDecl>, name: str): bool {
    while mm in &methods {
        when (mm.kind) {
            AssocTypeBinding(_chosen) => {
                if mm.name.as_str().equals(name) { return true }
            }
            _ => { }
        }
    }
    return false
}

/// -1 when absent.
fun trait_assoc_index(ti: TraitInfo, name: str): int64 {
    while i in 0..ti.assoc_types.size() {
        if ti.assoc_types.at(i).name.as_str().equals(name) { return i as int64 }
    }
    return 0 - 1
}

fun trait_ref_name(tr: TypeRef): String {
    return when (tr.kind) {
        Named(n, _a) => n.as_string()
        _ => ""
    }
}

/// -1 when absent.
fun find_method_arity(methods: List<TopDecl>, name: str): int64 {
    while mm in &methods {
        if mm.name.as_str().equals(name) {
            return when (mm.kind) {
                Function(params, _r, _b, _p, _u, _mut, _s) => params.size() as int64
                _ => 0 - 1
            }
        }
    }
    return 0 - 1
}

fun trait_has_method(ti: TraitInfo, name: str): bool {
    while method in &ti.methods {
        if method.name.as_str().equals(name) { return true }
    }
    return false
}

fun emit_trait_err(diags: &var Diagnostics, span: Span, msg: String): void {
    val lab = new_label(span, msg)
    diags.emit(new_diagnostic(Severity.Error, lab))
}

/// `type Item` / `type Item = T`, which share the member list.
fun decl_is_assoc_type(td: TopDecl): bool {
    return when (td.kind) {
        AssocType(_bounds) => true
        AssocTypeBinding(_chosen) => true
        _ => false
    }
}

/// Translated positionally into the impl's arguments.
fun mapped_args_key(arg_names: &List<String>, trait_params: &List<String>, trait_args: &List<String>): String {
    var out = ""
    while i in 0..arg_names.size() {
        if i > 0 { out = out + String.from("__") }
        out = out + mapped_param_name(*arg_names.at(i), trait_params, trait_args)
    }
    return out
}

fun trait_ref_arg_names(trait_ref: TypeRef): List<String> {
    when (trait_ref.kind) {
        Named(_n, args) => {
            var out = List.new<String>()
            while arg in &args {
                out.push((arg).tref_name_key())
            }
            return out
        }
        _ => return List.new<String>()
    }
}

/// Arity already matches.
fun TraitMethodReq.check_named_method_types(tname: &String, trait_ref: &TypeRef, target: str, self_ty: &Type, methods: List<TopDecl>, diags: &var Diagnostics, ctx: &var TypeCtx): void {
    while method in &methods {
        if method.name.as_str().equals(self.name.as_str()) {
            // The method's own parameters, `N` lifted from the trait's
            // arguments among them, are in scope for its signature.
            val outer_owner = ctx.fn_owner.clone()
            val outer_generics = ctx.generics.clone()
            ctx.fn_owner = "${target}_${method.name.as_str()}"
            while tp in &method.generics { ctx.generics.push(tp.name.as_string()) }
            self.check_impl_method_types(tname, trait_ref, target, self_ty, method, diags, ctx)
            ctx.fn_owner = outer_owner
            ctx.generics = outer_generics
            return
        }
    }
}
