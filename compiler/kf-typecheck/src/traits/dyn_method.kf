import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type
import kf_typecheck.types.type_eq
import kf_typecheck.types.can_coerce
import kf_typecheck.check.check_expr
import kf_typecheck.check.apply_expected

struct DynReceiverInfo {
    val dynamic: bool
    val mutable: bool
    val object_type: Type
}

pub mutating fun Expr.check_dyn_method_call(receiver: &Expr, method: Sym, args: &var List<Expr>, ctx: &var TypeCtx): bool {
    val receiver_info = receiver.ty.dyn_receiver_info()
    if !receiver_info.dynamic { return false }
    val layout = receiver_info.object_type.dyn_layout_for(ctx) ?: {
        self.ty = Type.new_poison()
        return true
    }
    val selected = layout.dyn_layout_method(method)
    when (selected) {
        None => {
            val message = "no method `${method.as_string()}` on trait object `${receiver.ty.display_type(ctx)}`"
            ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
            self.ty = Type.new_poison()
            return true
        }
        Some(slot) => {
            if slot.is_mutating && !receiver_info.mutable {
                val message = "cannot self mutating method `${method.as_string()}` through shared trait object `${receiver.ty.display_type(ctx)}`"
                ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
                self.ty = Type.new_poison()
                return true
            }
            if !check_dyn_method_args(method, args, &slot.params, self, ctx) {
                self.ty = Type.new_poison()
                return true
            }
            self.ty = slot.ret.clone()
            self.is_dynamic_call = true
            self.dynamic_slot = slot.slot
            self.dynamic_layout = layout.identity
            return true
        }
    }
}

fun Type.dyn_receiver_info(): DynReceiverInfo {
    when (self.kind) {
        RefTo(mutable, inner) => {
            val pointee = unsafe { inner.clone() }
            when (pointee.kind) {
                DynTraitTy(_) => return DynReceiverInfo { dynamic: true, mutable: mutable, object_type: pointee }
                _ => { }
            }
        }
        _ => { }
    }
    return DynReceiverInfo { dynamic: false, mutable: false, object_type: Type.new_poison() }
}

fun DynTraitLayout.dyn_layout_method(method: Sym): DynMethodSlot? {
    while slot in &self.methods {
        if slot.name.id == method.id { return Option.Some(slot) }
    }
    return Option.None
}

fun check_dyn_method_args(method: Sym, args: &var List<Expr>, expected: &List<Type>, call: &Expr, ctx: &var TypeCtx): bool {
    if args.size() != expected.size() {
        val message = "dynamic method `${method.as_string()}` called with the wrong number of arguments"
        ctx.emit(new_diagnostic(Severity.Error, new_label(call.span, message)))
        return false
    }
    var valid = true
    while i in 0..args.size() {
        val argument = args.at_mut(i)
        check_expr(argument, ctx)
        val target = *expected.at(i)
        val actual = argument.ty.clone()
        val coerced = argument.apply_expected(target.clone(), ctx)
        if !coerced && !actual.type_eq(target.clone()) && !ctx.fits(actual, target) {
            val message = "argument type does not match dynamic method `${method.as_string()}`"
            ctx.emit(new_diagnostic(Severity.Error, new_label(argument.span, message)))
            valid = false
        }
    }
    return valid
}
