import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.coerce_addr_of
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.declaration.new_top_decl
import kf_core.diagnostic.*
import kf_core.ast.dyn_meta.*
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.check.apply_expected
import kf_typecheck.check.check_expr

struct DynCoerceOutcome {
    val converted: bool
    val inner_borrowed: bool
    val diagnostics: uint64
    val vtables: uint64
}

fun coerce_trait_info(name: str): TraitInfo {
    return TraitInfo {
        name: String.from(name),
        identity: intern(name), module: intern(""),
        span: no_span(),
        type_params: List.new<String>(),
        methods: List.new<TraitMethodReq>(),
        assoc_types: List.new<TraitAssocReq>(),
        supertraits: List.new<SuperTraitReq>()
    }
}

fun coerce_ref_type(inner: Type, mutable: bool): Type {
    val inner_ptr: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner_ptr = inner }
    return Type { kind: TypeKind.RefTo(mutable, inner_ptr), provenance: Provenance.Declared(no_span()) }
}

fun coerce_target(mutable: bool): Type {
    return coerce_ref_type(dyn_trait_type(intern("Show"), List.new<Type>(), no_span()), mutable)
}

fun generic_coerce_target(argument: Type): Type {
    var args = List.new<Type>()
    args.push(argument)
    return coerce_ref_type(dyn_trait_type(intern("Show"), args, no_span()), false)
}

fun run_dyn_coerce(source_kind: uint8, target_mutable: bool, has_impl: bool, binding_mutable: bool): DynCoerceOutcome {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(coerce_trait_info("Show")) }
    if has_impl {
        unsafe { signatures.insert_trait_impl(TraitImplInfo {
            type_name: String.from("Point"),
            receiver_identity: intern("Point"),
            trait_name: String.from("Show"),
            trait_args: "",
            generics: "",
            arg_count: 0
        }) }
    }
    val owner: Ptr<TopDecl> = unsafe { alloc<TopDecl>() }
    unsafe { *owner = new_top_decl(no_span(), String.from("render"), TopDeclKind.Poison) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.metadata_owner = owner
    val point = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) }
    var source = point
    if source_kind == 1 { source = coerce_ref_type(point, false) }
    if source_kind == 2 { source = coerce_ref_type(point, true) }
    if binding_mutable {
        ctx.declare(String.from("point"), source)
    } else {
        ctx.declare_val(String.from("point"), source)
    }
    var expression = Expr.new(no_span(), ExprKind.Variable(intern("point")))
    check_expr(&var expression, &var ctx)
    val converted = expression.apply_expected(coerce_target(target_mutable), &var ctx)
    var inner_borrowed = false
    when (expression.kind) {
        DynCoerce(inner, _) => inner_borrowed = unsafe { inner.coerce == coerce_addr_of() }
        _ => { }
    }
    return DynCoerceOutcome {
        converted: converted,
        inner_borrowed: inner_borrowed,
        diagnostics: unsafe { diagnostics.size() },
        vtables: unsafe { owner.dyn_vtables.size() }
    }
}

/// The same question `try_dyn_coerce` guards on, asked silently.
fun run_could_coerce(source_kind: uint8, target_mutable: bool, has_impl: bool): DynCoerceOutcome {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(coerce_trait_info("Show")) }
    if has_impl {
        unsafe { signatures.insert_trait_impl(TraitImplInfo {
            type_name: String.from("Point"),
            receiver_identity: intern("Point"),
            trait_name: String.from("Show"),
            trait_args: "",
            generics: "",
            arg_count: 0
        }) }
    }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    val point = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) }
    var source = point
    if source_kind == 1 { source = coerce_ref_type(point, false) }
    if source_kind == 2 { source = coerce_ref_type(point, true) }
    val fits = source.could_dyn_coerce(&coerce_target(target_mutable), &var ctx)
    return DynCoerceOutcome {
        converted: fits,
        inner_borrowed: false,
        diagnostics: unsafe { diagnostics.size() },
        vtables: 0
    }
}

@test fun could_coerce_accepts_a_shared_borrow_of_an_implementor(): void {
    val outcome = run_could_coerce(1, false, true)
    assert_eq(outcome.converted, true, "`&Point` fits a `&dyn Show` parameter")
}

@test fun could_coerce_accepts_a_mutable_borrow_for_a_mutable_target(): void {
    val outcome = run_could_coerce(2, true, true)
    assert_eq(outcome.converted, true, "`&var Point` fits a `&var dyn Show` parameter")
}

@test fun could_coerce_refuses_a_shared_borrow_for_a_mutable_target(): void {
    val outcome = run_could_coerce(1, true, true)
    assert_eq(outcome.converted, false, "a shared borrow cannot become a mutable trait object")
}

@test fun could_coerce_refuses_a_type_that_does_not_implement(): void {
    val outcome = run_could_coerce(1, false, false)
    assert_eq(outcome.converted, false, "no implementation, no coercion")
}

@test fun could_coerce_reports_nothing(): void {
    // A rejection here is not a diagnosis.
    val outcome = run_could_coerce(1, false, false)
    assert_eq(outcome.diagnostics, 0, "a refusal emits no diagnostic")
}

@test fun dyn_coerce_borrows_a_concrete_place(): void {
    val outcome = run_dyn_coerce(0, false, true, false)
    assert_eq(outcome.converted && outcome.inner_borrowed, true, "a concrete place becomes a shared trait object borrow")
}

@test fun dyn_coerce_records_required_vtable(): void {
    val outcome = run_dyn_coerce(0, false, true, false)
    assert_eq(outcome.vtables, 1, "the consuming declaration records its concrete vtable requirement")
}

@test fun dyn_coerce_rejects_missing_impl(): void {
    val outcome = run_dyn_coerce(0, false, false, false)
    assert_eq(!outcome.converted && outcome.diagnostics == 1, true, "a missing exact implementation is diagnosed")
}

@test fun dyn_coerce_requires_exact_trait_arguments(): void {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    var parameters = List.new<String>()
    parameters.push(String.from("T"))
    unsafe { signatures.insert_trait(TraitInfo { name: String.from("Show"), identity: intern("Show"), module: intern(""), span: no_span(), type_params: parameters, methods: List.new<TraitMethodReq>(), assoc_types: List.new<TraitAssocReq>(), supertraits: List.new<SuperTraitReq>() }) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("Point"), receiver_identity: intern("Point"), trait_name: String.from("Show"), trait_args: String.from("int32"), generics: "", arg_count: 1 }) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.declare_val(String.from("point"), Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) })
    var expression = Expr.new(no_span(), ExprKind.Variable(intern("point")))
    check_expr(&var expression, &var ctx)
    val converted = expression.apply_expected(generic_coerce_target(Type.new_str(no_span())), &var ctx)
    assert_eq(!converted && unsafe { diagnostics.size() } == 1, true, "Show<int32> does not satisfy dyn Show<str>")
}

@test fun dyn_coerce_rejects_shared_to_mutable(): void {
    val outcome = run_dyn_coerce(1, true, true, true)
    assert_eq(!outcome.converted && outcome.diagnostics == 1, true, "a shared concrete borrow cannot become a mutable object")
}

@test fun dyn_coerce_mutable_to_shared(): void {
    val outcome = run_dyn_coerce(2, false, true, true)
    assert_eq(outcome.converted, true, "a mutable concrete borrow may become a shared object")
}

@test fun dyn_coerce_mutable_to_mutable(): void {
    val outcome = run_dyn_coerce(2, true, true, true)
    assert_eq(outcome.converted, true, "a mutable concrete borrow may become a mutable object")
}

@test fun dyn_coerce_rejects_immutable_place_for_mutable_target(): void {
    val outcome = run_dyn_coerce(0, true, true, false)
    assert_eq(!outcome.converted && outcome.diagnostics == 1, true, "mutable object borrowing respects place mutability")
}

@test fun dyn_coerce_is_not_inferred_without_expected_type(): void {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.declare_val(String.from("point"), Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) })
    var expression = Expr.new(no_span(), ExprKind.Variable(intern("point")))
    check_expr(&var expression, &var ctx)
    when (expression.kind) {
        Variable(_) => assert_eq(true, true, "bottom-up checking keeps the concrete expression")
        _ => assert_eq(false, true, "no expected type means no dynamic coercion")
    }
}

@test fun dyn_coerce_reaches_both_expected_if_branches(): void {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = new_diagnostics() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(coerce_trait_info("Show")) }
    unsafe { signatures.insert_trait_impl(TraitImplInfo { type_name: String.from("Point"), receiver_identity: intern("Point"), trait_name: String.from("Show"), trait_args: "", generics: "", arg_count: 0 }) }
    val owner: Ptr<TopDecl> = unsafe { alloc<TopDecl>() }
    unsafe { *owner = new_top_decl(no_span(), String.from("choose"), TopDeclKind.Poison) }
    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.metadata_owner = owner
    val point = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) }
    ctx.declare_val(String.from("left"), point.clone())
    ctx.declare_val(String.from("right"), point)
    val condition = Box.new(Expr.new(no_span(), ExprKind.LitBool(true)))
    val left = Box.new(Expr.new(no_span(), ExprKind.Variable(intern("left"))))
    val right = Box.new(Expr.new(no_span(), ExprKind.Variable(intern("right"))))
    var expression = Expr.new(no_span(), ExprKind.IfExpr(condition, left, right))
    check_expr(&var expression, &var ctx)
    expression.apply_expected(coerce_target(false), &var ctx)
    when (expression.kind) {
        IfExpr(_, then_branch, else_branch) => {
            val both = unsafe { dyn_coerce_kind(then_branch.kind) && dyn_coerce_kind(else_branch.kind) }
            assert_eq(both, true, "an expected dynamic type reaches both branches")
        }
        _ => assert_eq(false, true, "the if expression remains an if")
    }
}

fun dyn_coerce_kind(kind: ExprKind): bool {
    when (kind) {
        DynCoerce(_, _) => return true
        _ => return false
    }
}
