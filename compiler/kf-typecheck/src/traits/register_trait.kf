import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.types.*
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_resolve.*
import kf_typecheck.types.*
import kf_typecheck.*
import kf_core.span.no_span
import kf_typecheck.check.decl.*

pub fun register_struct(td: &var TopDecl, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics,
    table: Ptr<DeclTable>?): void {
    if td.reject_reserved_type_name(diags) { return }
    if td.rejects_lang_type_name(unsafe { (*sig_ptr).lang_string }, diags) { return }
    // An imported declaration's fields may name hidden types, so they are
    // not judged unknown.
    var eff_table: Ptr<DeclTable>? = table
    if td.linkage.is_imported() { eff_table = Option.None }
    when (td.kind) {
        EnumDecl(variants, _is_pub) => {
            var ctx0 = new_type_ctx(Type.new_void(no_span()), diags, eff_table, sig_ptr)
            ctx0.owner_crate = td.crate
            ctx0.owner_module = td.module_path
            ctx0.owner_file = td.span.file_id
            ctx0.metadata_owner = td
            ctx0.fn_owner = td.name.as_string()
            // Bounds first: a payload naming a bounded type checks its
            // arguments against them.
            register_bounds(td.name.as_string(), td.generics, sig_ptr)
            val gnames = type_param_names(td.generics)
            ctx0.seed_generics(gnames)
            var vs = List.new<VariantInfo>()
            while v in &variants {
                var ptys = List.new<Type>()
                while ptr in &v.payloads {
                    if !td.is_view_type() { ptr.validate_borrow_storage("an enum payload", &var ctx0) }
                    val payload_ty = ptr.resolve_type_ref(&var ctx0)
                    payload_ty.validate_dyn_placement(ptr.span, &var ctx0)
                    ptys.push(payload_ty)
                }
                vs.push(VariantInfo { name: v.name.as_string(), payloads: ptys })
            }
            val sp = sig_ptr
            unsafe { sp.insert_enum(EnumLayout { name: td.name.as_string(), variants: vs, owner_crate: td.crate }) }
        }
        Struct(fields, _is_pub) => {
            var ctx0 = new_type_ctx(Type.new_void(no_span()), diags, eff_table, sig_ptr)
            ctx0.owner_crate = td.crate
            ctx0.owner_module = td.module_path
            ctx0.owner_file = td.span.file_id
            ctx0.metadata_owner = td
            ctx0.fn_owner = td.name.as_string()
            // Bounds first, as for an enum.
            register_bounds(td.name.as_string(), td.generics, sig_ptr)
            val gnames = type_param_names(td.generics)
            ctx0.seed_generics(gnames)
            var fs = List.new<StructFieldInfo>()
            while f in &fields {
                val ty_ptr: Ptr<TypeRef> = f.ty
                val f_tr: TypeRef = unsafe { *ty_ptr }
                if !td.is_view_type() { f_tr.validate_borrow_storage("a struct field", &var ctx0) }
                val fty = f_tr.resolve_type_ref(&var ctx0)
                fty.validate_dyn_placement(f_tr.span, &var ctx0)
                fs.push(StructFieldInfo { name: f.name.as_string(), ty: fty, is_var: f.is_var })
            }
            val sp = sig_ptr
            unsafe { sp.insert_struct(StructLayout { name: td.name.as_string(), fields: fs, is_refcounted: false, owner_crate: td.crate }) }
        }
        TraitImpl(tref, _methods) => {
            // Recorded in the first pre-pass, before any generic layout
            // instantiates, since bound checks read this registry.
            val tr = unsafe { *tref }
            td.register_trait_impl(&tr, sig_ptr, diags)
        }
        TraitDecl(_methods, _is_pub, _) => { }
        _ => { }
    }
}

/// A trait's name only, nothing resolved: the first of two passes, so a
/// method naming `dyn OtherTrait` does not depend on order.
pub fun TopDecl.register_trait_name(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (self.kind) {
        TraitDecl(_methods, _is_pub, _supers) => {
            if unsafe { (*sig_ptr).find_trait(self.name.as_str()).is_some() } {
                val message = "trait `${self.name.as_str()}` conflicts with an existing trait of the same name"
                diags.emit(new_diagnostic(Severity.Error, new_label(self.decl_name_span(), message)))
                return
            }
            unsafe { sig_ptr.insert_trait(TraitInfo {
                name: self.name.as_string(), identity: self.trait_identity_of(), module: self.module_path,
                span: self.span, type_params: type_param_names(self.generics),
                methods: List.new<TraitMethodReq>(), assoc_types: List.new<TraitAssocReq>(),
                supertraits: List.new<SuperTraitReq>() }) }
        }
        _ => { }
    }
}

fun TopDecl.trait_identity_of(): Sym {
    if self.crate.is_poison() { return self.name }
    return canonical_type_identity(TypeIdentity.new(self.crate, self.module_path, self.name))
}

pub fun register_trait_decl(td: &var TopDecl, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics,
    table: Ptr<DeclTable>?): void {
    when (td.kind) {
        TraitDecl(methods, _is_pub, declared_supers) => {
            // A rejected duplicate got no entry; the one here is the first
            // declaration's.
            when (unsafe { (*sig_ptr).find_trait(td.name.as_str()) }) {
                Some(existing) => {
                    if existing.span.file_id != td.span.file_id || existing.span.start != td.span.start { return }
                }
                None => return
            }
            // Required methods and full signatures, resolved with the trait's
            // generics and `Self` (Generic("Self"), substituted at each use:
            // `cmp(other: Self)` on `T: Compare` reads `cmp(other: T)`).
            var eff_table: Ptr<DeclTable>? = table
            if td.linkage.is_imported() { eff_table = Option.None }
            var ctx_t = new_type_ctx(Type.new_void(no_span()), diags, eff_table, sig_ptr)
            ctx_t.seed_generics(type_param_names(td.generics))
            ctx_t.generics.push(String.from("Self"))
            val assoc_names = assoc_type_names(&methods)
            var reqs = List.new<TraitMethodReq>()
            var assocs = List.new<TraitAssocReq>()
            while ti in 0..methods.size() {
                val method_owner = methods.at_mut(ti)
                val mm = unsafe { *method_owner }
                ctx_t.metadata_owner = method_owner
                when (mm.kind) {
                    Function(params, ret_ptr, body, _p, _u, is_mut, is_static) => {
                        // The method's own `<T>` is in scope too.
                        val method_generics = type_param_names(mm.generics)
                        ctx_t.seed_generics(method_generics)
                        var ptys = List.new<Type>()
                        while pp in &params {
                            val p_tr: TypeRef = unsafe { *pp.ty }
                            val param_ty = (assoc_names_as_projections(p_tr, &assoc_names)).resolve_type_ref(&var ctx_t)
                            param_ty.validate_dyn_placement(p_tr.span, &var ctx_t)
                            ptys.push(param_ty)
                        }
                        val r_tr: TypeRef = unsafe { *ret_ptr }
                        val rty = (assoc_names_as_projections(r_tr, &assoc_names)).resolve_type_ref(&var ctx_t)
                        rty.validate_dyn_placement(r_tr.span, &var ctx_t)
                        reqs.push(TraitMethodReq { name: mm.name.as_string(), span: mm.span, arity: params.size(), has_default: body.size() > 0, has_method_generics: mm.generics.size() > 0, is_static: is_static, params: ptys, ret: rty, is_mutating: is_mut })
                        while _ in &method_generics {
                            ctx_t.generics.pop()
                        }
                    }
                    // An associated type, not a method.
                    AssocType(bounds) => assocs.push(TraitAssocReq { name: mm.name.as_string(), span: mm.span, bounds: assoc_bound_reqs(&bounds) })
                    _ => { }
                }
            }
            val sp = sig_ptr
            val identity = td.trait_identity_of()
            // Supertraits as written: head name and argument key, spelled like
            // TraitImplInfo so obligations compare directly.
            var supers = List.new<SuperTraitReq>()
            while sref in &declared_supers {
                when (sref.kind) {
                    Named(super_sym, super_args) => supers.push(SuperTraitReq { name: super_sym.as_string(), args: trait_args_key(&super_args), span: sref.span })
                    _ => { }
                }
            }
            unsafe { sp.replace_trait(TraitInfo { name: td.name.as_string(), identity: identity, module: td.module_path, span: td.span, type_params: type_param_names(td.generics), methods: reqs, assoc_types: assocs, supertraits: supers }) }
        }
        _ => { }
    }
}
