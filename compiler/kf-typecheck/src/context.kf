// Per-function type-checking state: locals, return type, generics in scope,
// diagnostics.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.span.*
import kf_resolve.*
import kf_typecheck.types.can_coerce

pub struct LocalBinding {
    pub val name: String
    pub var ty: Type
    // Mutability through a reference comes from its type, not this.
    pub val is_var: bool
    /// An unannotated binding's initializer while its type is still open, which
    /// a use may retype; null otherwise.
    pub var flexible_init: Ptr<Expr>?
    /// How many places read the binding, and the latest.
    pub var uses: uint64
    pub var last_use: Span
    /// The use that decided an open binding's type; `no_span()` otherwise.
    pub var decided_at: Span
    /// The first use that narrowed it without deciding: a `str` slot rules out
    /// every other type a string literal converts to.
    pub var narrowed_at: Span
}

pub view struct TypeCtx {
    pub var locals: List<LocalBinding>
    pub var return_ty: Type
    /// The impl's target, which `Self` means.
    pub var self_ty: Type
    pub var generics: List<String>
    pub var diags: &var Diagnostics
    /// None during the pre-passes, which run before a table exists.
    pub var table: Ptr<DeclTable>?
    pub var sigs: Ptr<SigTable>
    // The key the enclosing function's bounds are registered under; "" outside
    // a body.
    pub var fn_owner: String
    pub var owner_crate: CrateId
    pub var owner_module: Sym
    /// The file whose imports gate lookups; several files share a directory.
    pub var owner_file: uint32
    /// Owns dynamic layouts requested here; null for lookup-only contexts.
    pub var metadata_owner: Ptr<TopDecl>
    /// Parameter names, `self` included: a returned borrow may read out of
    /// these, not out of the body's own bindings.
    pub var params: List<String>
    /// The trait and method this body implements, "" otherwise; see
    /// check/self_recursion.kf.
    pub var impl_trait: String
    /// The trait's arguments, so `impl_trait` names one instantiation:
    /// `Self.Out` inside `impl Index<Range<uint64>> for Bag` is unambiguous.
    pub var impl_trait_args: String
    pub var impl_method: String
    /// Suppresses `emit`, for lookups that only read a type ref from another
    /// scope.
    pub var quiet: bool
    /// >0 while checking a call argument, where borrowed captures are allowed.
    pub var in_call_arg: uint64
    /// A lambda initializing a local, which owns its captures.
    pub var in_local_lambda_binding: uint64
    /// Every `null` walked, and those an Option slot claimed. Judged at the end
    /// of the body, since the slot arrives after the node.
    pub var nulls_seen: List<Span>
    pub var nulls_typed: List<Span>
    /// Integer literals too wide for `int32`, their default, and those a slot,
    /// a cast or a negation sized. Judged at the end of the body, like `null`.
    pub var wide_literals_seen: List<Span>
    pub var wide_literals_sized: List<Span>
    /// `when` binders in scope that are references to their payload.
    pub var ref_binders: List<String>
    /// Static calls on a generic type with no type arguments yet, and those a
    /// slot later completed.
    pub var open_calls: List<OpenGenericCall>
    pub var open_typed: List<Span>
    /// Where each empty `[]` is, once named: its open call is the literal.
    pub var list_literals: List<Span>
    /// Leading arguments of the next call already typed (an extension's
    /// receiver); checking twice is not harmless.
    pub var pretyped_args: uint64
    /// Set by `check_call` when the callee is a generic whose name another
    /// crate's generic shares: the crate-qualified name the call must carry.
    pub var qualified_callee: String
    /// The link name `check_call` fixed for its callee, or "".
    pub var pinned_callee: String
    /// The admission of the alias a call goes through, for the next
    /// `check_call`.
    pub var through_module: Sym
    /// Types uses decided after earlier uses, for the body's next check, and
    /// those a previous check decided.
    pub var decisions: List<OpenDecision>
    pub var presets: List<OpenDecision>
    /// Element mismatches in literals no slot has typed yet.
    pub var deferred_literals: List<DeferredLiteral>
}

pub fun new_type_ctx(return_ty: Type, diags: &var Diagnostics, table: Ptr<DeclTable>?, sigs: Ptr<SigTable>): TypeCtx {
    return TypeCtx {
        locals: List.new<LocalBinding>(),
        return_ty: return_ty,
        self_ty: Type.new_poison(),
        generics: List.new<String>(),
        diags: diags,
        table: table,
        sigs: sigs,
        fn_owner: "",
        owner_crate: crate_id_poison(),
        owner_module: intern(""),
        owner_file: 0,
        metadata_owner: unsafe { 0 as Ptr<TopDecl> },
        params: List.new<String>(),
        impl_trait: "",
        impl_trait_args: "",
        impl_method: "",
        quiet: false,
        in_call_arg: 0,
        in_local_lambda_binding: 0,
        nulls_seen: List.new<Span>(),
        nulls_typed: List.new<Span>(),
        wide_literals_seen: List.new<Span>(),
        wide_literals_sized: List.new<Span>(),
        ref_binders: List.new<String>(),
        open_calls: List.new<OpenGenericCall>(),
        open_typed: List.new<Span>(),
        list_literals: List.new<Span>(),
        pretyped_args: 0,
        qualified_callee: String.from(""),
        pinned_callee: String.from(""),
        through_module: Sym { id: 0 },
        decisions: List.new<OpenDecision>(),
        presets: List.new<OpenDecision>(),
        deferred_literals: List.new<DeferredLiteral>()
    }
}

impl TypeCtx {
    /// The table every check reads, which outlives the context.
    pub fun sig_table(): &SigTable {
        return unsafe { &*self.sigs }
    }

    pub fun string_name(): Sym {
        return self.sig_table().lang_string
    }

    pub fun option_name(): Sym {
        return self.sig_table().lang_option
    }

    pub fun list_name(): Sym {
        return self.sig_table().lang_list
    }

    pub fun array_name(): Sym {
        return self.sig_table().lang_array
    }

    pub fun slice_name(): Sym {
        return self.sig_table().lang_slice
    }

    pub fun slice_mut_name(): Sym {
        return self.sig_table().lang_slice_mut
    }

    pub fun lang_trait_name(key: str): Sym {
        return self.sig_table().lang_trait_name(key)
    }

    /// Clone, Drop or Equal, by key.
    pub fun is_auto_trait(name: str): bool {
        return self.sig_table().is_auto_trait(name)
    }

    pub fun fits(from: &Type, to: &Type): bool {
        return from.can_coerce(to, self.string_name())
    }

    // A mutable binding. Only `declare_val` sites are enforced.
    pub mutating fun declare(name: String, ty: Type): void {
        self.locals.push(LocalBinding { name: name, ty: ty, is_var: true, flexible_init: null, uses: 0, last_use: no_span(), decided_at: no_span(), narrowed_at: no_span() })
    }

    // An immutable binding: `val`, params, `self` in a non-mutating method.
    pub mutating fun declare_val(name: String, ty: Type): void {
        self.locals.push(LocalBinding { name: name, ty: ty, is_var: false, flexible_init: null, uses: 0, last_use: no_span(), decided_at: no_span(), narrowed_at: no_span() })
    }

    pub mutating fun declare_flexible(name: String, ty: Type, is_var: bool, init: Ptr<Expr>): void {
        self.locals.push(LocalBinding { name: name, ty: ty, is_var: is_var, flexible_init: init, uses: 0, last_use: no_span(), decided_at: no_span(), narrowed_at: no_span() })
    }

    /// A node checked again is not a second use.
    pub mutating fun note_use(name: str, span: Span): void {
        if span.is_none() { return }
        var i: uint64 = self.locals.size()
        while i > 0 {
            i = i - 1
            if self.locals.at(i).name.as_str().equals(name) {
                val binding = self.locals.at_mut(i)
                if !binding.last_use.same_as(span) {
                    binding.uses = binding.uses + 1
                    binding.last_use = span
                }
                return
            }
        }
    }

    /// Unknown names answer true, so no mutability error cascades.
    pub fun lookup_is_var(name: str): bool {
        var i: uint64 = self.locals.size()
        while i > 0 {
            i = i - 1
            val b = *self.locals.at(i)
            if b.name.as_str().equals(name) {
                return b.is_var
            }
        }
        return true
    }

    /// Whether a local, parameter or binder named `name` is in scope.
    pub fun has_local(name: str): bool {
        while b in &self.locals {
            if b.name.as_str() == name { return true }
        }
        return false
    }

    /// A parameter's mutability fix is `&var` in its type.
    pub fun is_param(name: str): bool {
        while param in &self.params {
            if param.as_str().equals(name) { return true }
        }
        return false
    }

    /// Unlike `lookup(name).is_poison()`: a binding whose initializer failed is
    /// declared, holding poison.
    pub fun is_declared(name: str): bool {
        var i: uint64 = self.locals.size()
        while i > 0 {
            i = i - 1
            val b = *self.locals.at(i)
            if b.name.as_str().equals(name) {
                return true
            }
        }
        return false
    }

    /// Drops every binding since `depth`, so a `when` arm's binders do not
    /// leak into the next arm.
    pub mutating fun truncate_locals(depth: uint64): void {
        while self.locals.size() > depth {
            self.locals.pop()
        }
    }

    /// Poison when absent.
    pub fun lookup(name: str): Type {
        var i: uint64 = self.locals.size()
        while i > 0 {
            i = i - 1
            val b = *self.locals.at(i)
            if b.name.as_str().equals(name) {
                // A deep copy: the result outlives this scope's locals.
                return b.ty.clone()
            }
        }
        return Type.new_poison()
    }

    pub mutating fun emit(diag: Diagnostic): void {
        if self.quiet { return }
        self.diags.emit(diag)
    }
}
