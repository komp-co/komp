// A `@prelude` function needs no import, and everything closer answers first.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.Type

/// A public or private `clamp` taking `arity` parameters, so a test can tell
/// which of several same-named functions answered.
fun ambient_clamp(crate: str, module: str, is_pub: bool, is_prelude: bool, arity: uint64): FnSignature {
    var params = List.new<Type>()
    var i: uint64 = 0
    while i < arity {
        params.push(Type.new_int32(no_span()))
        i = i + 1
    }
    return FnSignature { name: String.from("clamp"), params: params, ret: Type.new_int32(no_span()), generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern(module), owner_crate: new_crate_id(crate), is_pub: is_pub, borrows: 0 - 1, is_prelude: is_prelude, is_extern: false }
}

/// Visibility checked for file 7, which imports `imports` or nothing.
fun ambient_table(imports: str): SigTable {
    var sigs = new_sig_table()
    sigs.gate_visibility = true
    if imports != "" {
        sigs.caller_files.push(7)
        sigs.imported_targets.push(intern(imports))
    }
    return sigs
}

/// The arity of the `clamp` file 7 of `program` sees, or 99 for none.
fun SigTable.ambient_arity(): uint64 {
    val found = self.find_imported_signature("clamp", 7, new_crate_id("program"), intern("program")) ?: return 99
    return found.params.size()
}

@test
fun a_prelude_core_function_needs_no_import(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("core", "core.math", true, true, 3))
    assert_eq(sigs.ambient_arity(), 3, "a marked core function, unimported")
}

@test
fun a_private_core_function_stays_hidden(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("core", "core.math", false, false, 3))
    assert_eq(sigs.ambient_arity(), 99, "a private function is not the prelude")
}

@test
fun a_public_but_unmarked_core_function_needs_an_import(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("core", "core.math", true, false, 3))
    assert_eq(sigs.ambient_arity(), 99, "the prelude is a mark, not a crate name")
}

@test
fun a_prelude_alloc_function_needs_no_import(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("alloc", "alloc.text_split", true, true, 2))
    assert_eq(sigs.ambient_arity(), 2, "a marked alloc function, unimported")
}

@test
fun a_private_alloc_function_stays_hidden(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("alloc", "alloc.text_split", false, false, 2))
    assert_eq(sigs.ambient_arity(), 99, "a private function is not the prelude")
}

@test
fun another_crates_function_still_needs_an_import(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("geometry", "geometry", true, false, 2))
    assert_eq(sigs.ambient_arity(), 99, "only the prelude is ambient")
}

@test
fun an_imported_function_answers_before_the_prelude(): void {
    var sigs = ambient_table("geometry")
    sigs.insert(ambient_clamp("core", "core.math", true, true, 3))
    sigs.insert(ambient_clamp("geometry", "geometry", true, false, 2))
    assert_eq(sigs.ambient_arity(), 2, "the import names a module on purpose")
}

@test
fun the_programs_own_function_answers_before_the_prelude(): void {
    var sigs = ambient_table("")
    sigs.insert(ambient_clamp("core", "core.math", true, true, 3))
    sigs.insert(ambient_clamp("program", "program", false, false, 1))
    assert_eq(sigs.ambient_arity(), 1, "a local definition shadows the prelude")
}
