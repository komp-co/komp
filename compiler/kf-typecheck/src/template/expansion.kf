// What a template's names stand for while it adds to one struct: `T`, the
// use's arguments, and the field a member loop is on.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.Annotation
import kf_core.diagnostic.*

/// A field, as a template reads it.
struct FieldFacts {
    val name: Sym
    val index: uint64
    val ty: TypeRef
    val annotations: List<Annotation>
    val span: Span
}

/// An annotation's parameter names in order, for `args` and `get<A>()`.
struct AnnotationShape {
    val name: Sym
    val params: List<Sym>
}

struct Expansion {
    /// The template's annotation, as `@name` writes it.
    val annotation: Sym
    /// `T`.
    val marked: Sym
    val type_name: Sym
    /// The struct's module, which owns what the template adds.
    val home: Sym
    val fields: List<FieldFacts>
    /// `args.p`: each parameter's value at this use.
    val args: List<FieldInit>
    val shapes: List<AnnotationShape>
    /// The member loop's binder, or "" outside one.
    var binder: Sym
    var member: uint64
    var diags: List<Diagnostic>
}

impl Expansion {
    fun in_member(): bool { return self.binder.as_str().byte_len() > 0 }

    fun field(): &FieldFacts { return self.fields.at(self.member) }

    mutating fun report(at: Span, message: String): void {
        self.diags.push(error_at(at, message))
    }

    /// `field.get<A>()`: `A`'s arguments on this field as a literal of its
    /// argument struct, or null without `@A` there.
    fun member_arguments(annotation: Sym, span: Span): Expr? {
        val params = self.params_of(annotation)
        while use in &self.field().annotations {
            if use.name.id == annotation.id {
                val inits = arguments_by_name(use, &params, span)
                return Expr.new(span, ExprKind.StructLit(annotation, inits))
            }
        }
        return null
    }

    fun has_member_annotation(annotation: Sym): bool {
        while use in &self.field().annotations {
            if use.name.id == annotation.id { return true }
        }
        return false
    }

    fun params_of(annotation: Sym): List<Sym> {
        while shape in &self.shapes {
            if shape.name.id == annotation.id { return shape.params.clone() }
        }
        return List.new<Sym>()
    }

    /// `args.name`'s value, or null when the annotation has no such
    /// parameter.
    fun argument(name: Sym): Expr? {
        while arg in &self.args {
            if arg.name.id == name.id { return (*arg.value).clone() }
        }
        return null
    }
}

/// `use`'s arguments as `name: value`, positional ones by place. A mismatch
/// is left out: checking the use reports it.
fun arguments_by_name(use: &Annotation, params: &List<Sym>, span: Span): List<FieldInit> {
    var inits = List.new<FieldInit>()
    while i in 0..use.args.size() {
        val arg = use.args.at(i)
        val named = arg.name.as_str().byte_len() > 0
        if !named && i >= params.size() { continue }
        val name = if named { arg.name } else { *params.at(i) }
        inits.push(FieldInit { span: span, name: name, value: Box.new((*arg.value).clone()) })
    }
    return inits
}
