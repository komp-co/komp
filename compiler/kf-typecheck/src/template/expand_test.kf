import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.Annotation
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

fun named(name: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun variable(name: str): Expr {
    return Expr.new(no_span(), ExprKind.Variable(intern(name)))
}

fun access(owner: Expr, member: str): Expr {
    return Expr.new(no_span(), ExprKind.FieldAccess(Box.new(owner), intern(member)))
}

/// `Point { x: int32, label: String }`, the loop on `label`.
fun point_expansion(): Expansion {
    var fields = List.new<FieldFacts>()
    fields.push(FieldFacts {
        name: intern("x"), index: 0, ty: named("int32"), annotations: List.new<Annotation>(), span: no_span()
    })
    fields.push(FieldFacts {
        name: intern("label"), index: 1, ty: named("String"), annotations: List.new<Annotation>(), span: no_span()
    })
    return Expansion {
        annotation: intern("shown"), marked: intern("T"), type_name: intern("Point"), home: intern("app"),
        fields: fields, args: List.new<FieldInit>(), shapes: List.new<AnnotationShape>(), binder: intern("field"),
        member: 1, diags: List.new<Diagnostic>()
    }
}

fun ExprKind.text(): String {
    return when (self) {
        LitStr(s) => "\"${s.as_str()}\""
        LitInt(n) => "${n}"
        LitBool(b) => if b { String.from("true") } else { String.from("false") }
        Variable(name) => name.as_string()
        FieldAccess(owner, member) => "${owner.kind.text().as_str()}.${member.as_str()}"
        Poison => String.from("poison")
        _ => String.from("?")
    }
}

@test fun t_names_the_marked_struct(): void {
    var x = point_expansion()
    val ty = named("T").expanded_type(&var x)
    assert_eq(ty.bare_type_name().as_str(), "Point", "`T` in a type")
}

@test fun field_type_is_the_fields_type(): void {
    var x = point_expansion()
    val written = TypeRef.new(no_span(), TypeRefKind.Projection(Box.new(named("field")), intern("type")))
    assert_eq(written.expanded_type(&var x).bare_type_name().as_str(), "String", "`field.type` on `label`")
}

@test fun a_splice_names_the_field(): void {
    var x = point_expansion()
    val out = access(variable("self"), "$field").expanded(&var x)
    assert_eq(out.kind.text().as_str(), "self.label", "`self.$field`")
}

@test fun a_field_fact_is_a_literal(): void {
    var x = point_expansion()
    val out = access(variable("field"), "index").expanded(&var x)
    assert_eq(out.kind.text().as_str(), "1", "`field.index`")
}

@test fun the_type_name_is_a_literal(): void {
    var x = point_expansion()
    val out = access(variable("T"), "name").expanded(&var x)
    assert_eq(out.kind.text().as_str(), "\"Point\"", "`T.name`")
}

@test fun an_unknown_fact_is_reported(): void {
    var x = point_expansion()
    val _out = access(variable("field"), "width").expanded(&var x)
    assert_eq(x.diags.size(), 1, "`field.width`")
}

@test fun a_splice_outside_a_loop_is_reported(): void {
    var x = point_expansion()
    x.binder = intern("")
    val _out = access(variable("self"), "$field").expanded(&var x)
    assert_eq(x.diags.size(), 1, "no loop binds `field`")
}

@test fun a_member_loop_unrolls_once_per_field(): void {
    var x = point_expansion()
    x.binder = intern("")
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Expression(Box.new(access(variable("field"), "name")))))
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(no_span(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    assert_eq(expand_stmts(&stmts, &var x).size(), 2, "one block per field")
}

@test fun a_decided_if_keeps_only_its_branch(): void {
    var x = point_expansion()
    var then_body = List.new<Stmt>()
    then_body.push(Stmt.new(no_span(), StmtKind.Break))
    var stmts = List.new<Stmt>()
    val condition = Expr.new(no_span(), ExprKind.LitBool(false))
    stmts.push(Stmt.new(no_span(), StmtKind.If(Box.new(condition), then_body, List.new<Stmt>())))
    val out = expand_stmts(&stmts, &var x)
    val kept = when (out.at(0).kind) {
        If(_c, taken, _other) => taken.size()
        _ => 9
    }
    assert_eq(kept, 0, "the empty `else` is taken")
}

fun TypeRef.bare_type_name(): String {
    return when (self.kind) {
        Named(name, _args) => name.as_string()
        _ => String.from("")
    }
}

@test fun a_break_in_a_member_loop_is_reported(): void {
    var x = point_expansion()
    x.binder = intern("")
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.Break))
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(no_span(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    val _out = expand_stmts(&stmts, &var x)
    assert_eq(x.diags.size(), 1, "the loop is written out, so `break` has nowhere to go")
}

@test fun a_break_in_an_inner_loop_stays(): void {
    var x = point_expansion()
    x.binder = intern("")
    var inner = List.new<Stmt>()
    inner.push(Stmt.new(no_span(), StmtKind.Break))
    var body = List.new<Stmt>()
    val always = Expr.new(no_span(), ExprKind.LitBool(true))
    body.push(Stmt.new(no_span(), StmtKind.While(Box.new(always), inner)))
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(no_span(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    val _out = expand_stmts(&stmts, &var x)
    assert_eq(x.diags.size(), 0, "`break` leaves its own loop")
}
