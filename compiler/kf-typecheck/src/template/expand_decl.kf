// One template's declarations for one marked struct: `T` renamed in every
// header, each body expanded, and a clash with a declaration written by hand
// reported with both.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.*
import kf_core.diagnostic.*

fun Module.expand_for(template: &TopDecl, marked: &TopDecl, annotation: uint64, diags: &var List<Diagnostic>,
    sites: &var List<ExpansionSite>): List<TopDecl> {
    var out = List.new<TopDecl>()
    val name = template.name.as_str()
    if marked.generics.size() > 0 {
        val why = "it has type parameters"
        val message = "`@${name}`'s template cannot add to `${marked.name.as_str()}`: ${why}"
        diags.push(error_at(marked.decl_name_span(), message))
        return out
    }
    var x = Expansion {
        annotation: template.name,
        marked: template.template_param(),
        type_name: marked.name,
        home: marked.module_path,
        fields: marked.field_facts(),
        args: self.use_arguments(marked, annotation),
        shapes: self.annotation_shapes(),
        binder: intern(""),
        member: 0,
        diags: List.new<Diagnostic>()
    }
    when (template.kind) {
        Template(_kind, _param, body) => {
            while decl in &body {
                out.push(decl.expanded_decl(&var x))
            }
        }
        _ => {}
    }
    while diag in &x.diags {
        diags.push(diag.clone())
    }
    sites.record(template, marked, &x.fields)
    return self.without_clashes(&out, template, diags)
}

fun TopDecl.template_param(): Sym {
    return when (self.kind) {
        Template(_kind, param, _body) => param
        _ => intern("")
    }
}

fun TopDecl.field_facts(): List<FieldFacts> {
    var out = List.new<FieldFacts>()
    when (self.kind) {
        Struct(fields, _pub) => {
            while i in 0..fields.size() {
                val field = fields.at(i)
                out.push(FieldFacts {
                    name: field.name, index: i, ty: (*field.ty).clone(), annotations: field.annotations.clone(),
                    span: field.span
                })
            }
        }
        _ => {}
    }
    return out
}

/// `@NAME(...)`'s values on `marked`, by parameter.
fun Module.use_arguments(marked: &TopDecl, annotation: uint64): List<FieldInit> {
    val declared = self.decls.at(annotation)
    val params = declared.param_names()
    while use in &marked.annotations {
        if use.name.id == declared.name.id { return arguments_by_name(use, &params, use.span) }
    }
    return List.new<FieldInit>()
}

fun TopDecl.param_names(): List<Sym> {
    var names = List.new<Sym>()
    when (self.kind) {
        AnnotationDecl(params, _target, _pub) => {
            while param in &params {
                names.push(param.name)
            }
        }
        _ => {}
    }
    return names
}

/// Every annotation's parameters, this crate's first, so `get<A>()` finds
/// the one a use in this crate means.
fun Module.annotation_shapes(): List<AnnotationShape> {
    var shapes = List.new<AnnotationShape>()
    while td in &self.decls {
        if td.crate.raw == self.crate.raw && td.is_annotation() {
            shapes.push(AnnotationShape { name: td.name, params: td.param_names() })
        }
    }
    while td in &self.decls {
        if td.crate.raw != self.crate.raw && td.is_annotation() {
            shapes.push(AnnotationShape { name: td.name, params: td.param_names() })
        }
    }
    return shapes
}

fun TopDecl.expanded_decl(x: &var Expansion): TopDecl {
    var out = self.clone()
    if self.name.id == x.marked.id { out.name = x.type_name }
    out.module_path = x.home
    out.resolves_in = self.module_path
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            val expanded = expanded_params(&params, x)
            if self.ext_name.as_str().byte_len() > 0 && expanded.size() > 0 {
                val receiver = expanded.at(0).ty.through_reference()
                out.name = intern(extension_link_name(self.ext_name.as_str(), &receiver).as_str())
            }
            out.kind = TopDeclKind.Function(expanded, Box.new(ret.expanded_type(x)), expand_stmts(&body, x), is_pub,
                is_unsafe, is_mutating, is_static)
        }
        ImplBlock(methods) => out.kind = TopDeclKind.ImplBlock(expanded_decls(&methods, x))
        TraitImpl(trait_ref, methods) => {
            out.kind = TopDeclKind.TraitImpl(Box.new(trait_ref.expanded_type(x)), expanded_decls(&methods, x))
        }
        Struct(fields, is_pub) => {
            var expanded = List.new<Field>()
            while field in &fields {
                val ty = Box.new(field.ty.expanded_type(x))
                var copy = new_field(field.span, field.name.as_string(), ty, field.is_var, field.is_pub)
                copy.annotations = field.annotations.clone()
                expanded.push(copy)
            }
            out.kind = TopDeclKind.Struct(expanded, is_pub)
        }
        _ => {}
    }
    return out
}

fun expanded_decls(decls: &List<TopDecl>, x: &var Expansion): List<TopDecl> {
    var out = List.new<TopDecl>()
    while decl in &decls {
        out.push(decl.expanded_decl(x))
    }
    return out
}

fun TypeRef.through_reference(): TypeRef {
    return when (self.kind) {
        Reference(_mutable, inner) => (*inner).clone()
        _ => self.clone()
    }
}

/// What the template adds, less a trait impl or an inherent method this
/// crate also writes by hand, each reported with both.
fun Module.without_clashes(added: &List<TopDecl>, template: &TopDecl, diags: &var List<Diagnostic>): List<TopDecl> {
    var kept = List.new<TopDecl>()
    while item in &added {
        var clashes = false
        while written in &self.decls {
            if written.crate.raw != self.crate.raw || written.name.id != item.name.id { continue }
            val clash = item.clash_with(written)
            if clash.byte_len() == 0 { continue }
            val by = "`@${template.name.as_str()}`'s template"
            var diag = error_at(written.decl_name_span(), "${clash.as_str()} is written here and added by ${by}")
            diag.secondary.push(new_label(template.decl_name_span(), "the template adding it"))
            diags.push(diag)
            clashes = true
        }
        if !clashes { kept.push(item.clone()) }
    }
    return kept
}

/// What `self`, added by a template, and `written` both declare, or "".
fun TopDecl.clash_with(written: &TopDecl): String {
    when (self.kind) {
        TraitImpl(trait_ref, _methods) => {
            val same = when (written.kind) {
                TraitImpl(other, _written_methods) => (*trait_ref).impl_trait_name() == (*other).impl_trait_name()
                _ => false
            }
            if same { return "`impl ${(*trait_ref).impl_trait_name().as_str()} for ${self.name.as_str()}`" }
        }
        ImplBlock(methods) => {
            val mine = when (written.kind) {
                ImplBlock(written_methods) => written_methods.clone()
                _ => List.new<TopDecl>()
            }
            while method in &methods {
                while other in &mine {
                    if other.name.id == method.name.id {
                        return "method `${self.name.as_str()}.${method.name.as_str()}`"
                    }
                }
            }
        }
        _ => {}
    }
    return String.from("")
}

fun TypeRef.impl_trait_name(): String {
    return when (self.kind) {
        Named(name, _args) => name.as_string()
        _ => String.from("")
    }
}
