// Where a template expanded, so a diagnostic in the code it added says so:
// at a field, with a note at the template; in the template, with a note at
// the struct it added to.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

pub struct ExpansionSite {
    /// The field a member loop's copy was checked at, or the template's
    /// whole text when `exact` is false.
    val span: Span
    val exact: bool
    val note_at: Span
    val note: String
    /// The struct added to, for a note naming every one.
    val type_name: Sym
}

mutating fun List<ExpansionSite>.record(template: &TopDecl, marked: &TopDecl, fields: &List<FieldFacts>): void {
    val name = template.name.as_str()
    val type_name = marked.name.as_str()
    val whole = Span { file_id: template.span.file_id, start: template.span.start, end: template.decl_end }
    val note = "`@${name}` adds this to"
    val at = marked.decl_name_span()
    self.push(ExpansionSite { span: whole, exact: false, note_at: at, note: note, type_name: marked.name })
    while field in &fields {
        val note = "in what `@${name}`'s template adds for field `${type_name}.${field.name.as_str()}`"
        self.push(ExpansionSite {
            span: field.span, exact: true, note_at: template.decl_name_span(), note: note, type_name: marked.name
        })
    }
}

/// Each diagnostic in expanded code, with its note.
pub fun with_expansion_notes(diags: List<Diagnostic>, sites: &List<ExpansionSite>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    while diag in &diags {
        var noted = diag.clone()
        val site = sites.site_of(diag.primary.span)
        if site != null {
            val found = site ?: 0
            val chosen = sites.at(found)
            val structs = sites.structs_holding(diag.primary.span)
            val note = if chosen.exact { chosen.note.clone() } else { "${chosen.note.as_str()} ${structs.as_str()}" }
            noted.secondary.push(new_label(chosen.note_at, note))
        }
        out.push(noted)
    }
    return out
}

/// "`A`", "`A` and `B`": each struct a template added code at `at` to.
fun List<ExpansionSite>.structs_holding(at: Span): String {
    var names = List.new<String>()
    while site in &self {
        if !site.exact && site.span.holds(at) { names.push("`${site.type_name.as_str()}`") }
    }
    var out = String.from("")
    while i in 0..names.size() {
        if i > 0 { out.append(if i + 1 == names.size() { " and " } else { ", " }) }
        out.append(names.at(i).as_str())
    }
    return out
}

/// The site `at` lies in; an exact one first, since a field lies outside
/// the template's text.
fun List<ExpansionSite>.site_of(at: Span): uint64? {
    while i in 0..self.size() {
        val site = self.at(i)
        if site.exact && site.span.same_as(at) { return i }
    }
    while i in 0..self.size() {
        val site = self.at(i)
        if !site.exact && site.span.holds(at) { return i }
    }
    return null
}

fun Span.holds(other: Span): bool {
    return self.file_id == other.file_id && self.start <= other.start && other.end <= self.end
}
