// Deciding a condition or a `when` once facts are literals: an expression of
// literals alone has one value, known before the program runs.

import alloc.list.*

import kf_core.ast.Arm
import kf_core.ast.Pattern
import kf_core.ast.expression.BinOp
import kf_core.ast.expression.Expr

/// A literal's value, as a template compares it.
enum Known {
    Flag(bool)
    Number(int64)
    Text(String)
}

/// The condition's value, or null when anything in it is decided at run
/// time.
fun Expr.decided_bool(): bool? {
    val known = self.known() ?: return null
    return when (known) {
        Flag(b) => b
        _ => null
    }
}

fun Expr.known(): Known? {
    when (self.kind) {
        LitBool(b) => return Known.Flag(b)
        LitInt(n) => return Known.Number(n)
        LitStr(text) => return Known.Text(text.clone())
        Unary(op, inner) => {
            val value = inner.known() ?: return null
            when (op) {
                Not => {
                    val b = value.flag() ?: return null
                    return Known.Flag(!b)
                }
                Neg => {
                    val n = value.number() ?: return null
                    return Known.Number(-n)
                }
            }
        }
        Binary(left, op, right) => {
            val a = left.known() ?: return null
            val b = right.known() ?: return null
            return combined(&a, op, &b)
        }
        _ => return null
    }
}

fun combined(a: &Known, op: BinOp, b: &Known): Known? {
    when (op) {
        Eq => {
            val same = a.same(b) ?: return null
            return Known.Flag(same)
        }
        NotEq => {
            val same = a.same(b) ?: return null
            return Known.Flag(!same)
        }
        AndAnd => {
            val left = a.flag() ?: return null
            val right = b.flag() ?: return null
            return Known.Flag(left && right)
        }
        OrOr => {
            val left = a.flag() ?: return null
            val right = b.flag() ?: return null
            return Known.Flag(left || right)
        }
        _ => {}
    }
    val left = a.number() ?: return null
    val right = b.number() ?: return null
    return when (op) {
        Lt => Known.Flag(left < right)
        LtEq => Known.Flag(left <= right)
        Gt => Known.Flag(left > right)
        GtEq => Known.Flag(left >= right)
        _ => null
    }
}

impl Known {
    /// Null for values of different kinds, which the checker reports.
    fun same(other: &Known): bool? {
        when (self) {
            Flag(a) => {
                val b = other.flag() ?: return null
                return a == b
            }
            Number(a) => {
                val b = other.number() ?: return null
                return a == b
            }
            Text(a) => {
                val b = other.text() ?: return null
                return a.as_str() == b.as_str()
            }
        }
    }

    fun text(): String? {
        return when (self) {
            Text(t) => t.clone()
            _ => null
        }
    }

    fun flag(): bool? {
        return when (self) {
            Flag(b) => b
            _ => null
        }
    }

    fun number(): int64? {
        return when (self) {
            Number(n) => n
            _ => null
        }
    }
}

/// The index of the first arm a literal subject takes, or null when it is
/// decided at run time: a subject or pattern that is not a literal, a
/// binding, or a guard.
fun Expr.decided_arm(arms: &List<Arm>): uint64? {
    val subject = self.known() ?: return null
    while i in 0..arms.size() {
        val arm = arms.at(i)
        val guarded = when (arm.guard) {
            Some(_guard) => true
            None => false
        }
        if guarded { return null }
        val takes = arm.pattern.takes(&subject) ?: return null
        if takes { return i }
    }
    return null
}

fun Pattern.takes(subject: &Known): bool? {
    when (self.kind) {
        Wildcard => return true
        Identifier(name) => return if name.as_str() == "_" { true } else { null }
        LitBool(b) => return subject.same(&Known.Flag(b))
        LitInt(n) => return subject.same(&Known.Number(n))
        LitStr(text) => return subject.same(&Known.Text(text.clone()))
        Or(alternatives) => {
            while alternative in &alternatives {
                val takes = alternative.takes(subject) ?: return null
                if takes { return true }
            }
            return false
        }
        _ => return null
    }
}
