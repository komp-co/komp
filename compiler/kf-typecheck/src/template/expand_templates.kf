// `template NAME on struct T { ... }`: its declarations, expanded for each
// struct of this crate marked `@NAME`, join the module, and the template
// leaves it. Runs before anything registers, so what it adds is checked
// like code written by hand.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.duplicate
import kf_core.ast.declaration.MarkKind
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

/// A checked template and the annotation it belongs to, by index into the
/// module's declarations.
struct TemplateAt {
    val template: uint64
    val annotation: uint64
}

pub mutating fun Module.expand_templates(diags: &var List<Diagnostic>): List<ExpansionSite> {
    var sites = List.new<ExpansionSite>()
    if !self.has_templates() { return sites }
    var added = List.new<TopDecl>()
    val templates = self.checked_templates(diags)
    while found in &templates {
        val template = self.decls.at(found.template)
        while td in &self.decls {
            if !self.is_marked_by(td, found.annotation) { continue }
            val expanded = self.expand_for(template, td, found.annotation, diags, &var sites)
            while item in &expanded {
                added.push(item.clone())
            }
        }
    }
    var kept = List.new<TopDecl>()
    while td in &self.decls {
        if !td.is_template() { kept.push(td.clone()) }
    }
    while item in &added {
        kept.push(item.clone())
    }
    self.decls = kept
    return sites
}

fun Module.has_templates(): bool {
    while td in &self.decls {
        if td.is_template() { return true }
    }
    return false
}

fun TopDecl.is_template(): bool {
    return when (self.kind) {
        Template(_kind, _marked, _body) => true
        _ => false
    }
}

/// This crate's templates that can expand, each other one reported.
fun Module.checked_templates(diags: &var List<Diagnostic>): List<TemplateAt> {
    var out = List.new<TemplateAt>()
    while i in 0..self.decls.size() {
        val td = self.decls.at(i)
        if td.crate.raw != self.crate.raw || !td.is_template() { continue }
        val at = td.decl_name_span()
        val annotation = self.template_annotation(td, diags) ?: continue
        var duplicate = false
        while earlier in &out {
            if earlier.annotation == annotation {
                var diag = error_at(at, "`@${td.name.as_str()}` already has a template on `struct`")
                diag.secondary.push(new_label(self.decls.at(earlier.template).decl_name_span(), "the first"))
                diags.push(diag)
                duplicate = true
            }
        }
        if !duplicate && td.body_is_expandable(diags) { out.push(TemplateAt { template: i, annotation: annotation }) }
    }
    return out
}

/// The annotation a template belongs to: one of this crate, in the
/// template's module if several share the name, marking structs.
fun Module.template_annotation(template: &TopDecl, diags: &var List<Diagnostic>): uint64? {
    val at = template.decl_name_span()
    val name = template.name.as_str()
    val kind = template.template_kind()
    if kind != MarkKind.Struct {
        diags.push(error_at(at, "a template cannot add to `${kind.word()}`: it adds to a `struct`"))
        return null
    }
    val found = self.own_annotation(template.name, template.module_path)
    if found == null {
        diags.push(error_at(at, "no annotation `${name}` in this crate: a template belongs to one"))
        return null
    }
    val index = found ?: return null
    if !self.decls.at(index).marks(MarkKind.Struct) {
        diags.push(error_at(at, "`@${name}` does not mark structs: declare it `on struct` for a template on `struct`"))
        return null
    }
    return index
}

fun TopDecl.template_kind(): MarkKind {
    return when (self.kind) {
        Template(kind, _marked, _body) => kind
        _ => MarkKind.Struct
    }
}

/// An annotation declared in this crate: the one in `module` if several
/// share the name.
fun Module.own_annotation(name: Sym, module: Sym): uint64? {
    var found: uint64? = null
    var count = 0
    while i in 0..self.decls.size() {
        val td = self.decls.at(i)
        if td.crate.raw != self.crate.raw || td.name.id != name.id || !td.is_annotation() { continue }
        if td.module_path.id == module.id { return i }
        count = count + 1
        found = i
    }
    return if count == 1 { found } else { null }
}

fun TopDecl.is_annotation(): bool {
    return when (self.kind) {
        AnnotationDecl(_params, _target, _pub) => true
        _ => false
    }
}

fun TopDecl.marks(kind: MarkKind): bool {
    return when (self.kind) {
        AnnotationDecl(_params, target, _pub) => {
            val kinds = target.kinds()
            var found = false
            while listed in &kinds {
                if listed.kind == kind { found = true }
            }
            found
        }
        _ => false
    }
}

/// A template holds declarations to add, but no annotation or template.
fun TopDecl.body_is_expandable(diags: &var List<Diagnostic>): bool {
    var fits = true
    when (self.kind) {
        Template(_kind, _marked, body) => {
            while item in &body {
                if item.is_template() || item.is_annotation() {
                    val message = "a template adds declarations beside a struct, not annotations or templates"
                    diags.push(error_at(item.decl_name_span(), message))
                    fits = false
                }
            }
        }
        _ => {}
    }
    return fits
}

/// Whether `td` is a struct of this crate carrying `@NAME` for this
/// annotation.
fun Module.is_marked_by(td: &TopDecl, annotation: uint64): bool {
    if td.crate.raw != self.crate.raw { return false }
    val is_struct = when (td.kind) {
        Struct(_fields, _pub) => true
        _ => false
    }
    if !is_struct { return false }
    val declared = self.decls.at(annotation)
    if !td.has_annotation(declared.name.as_str()) { return false }
    val resolved = self.own_annotation(declared.name, td.module_path) ?: return false
    return resolved == annotation
}
