import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.CrateId
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeIdentity
import kf_core.ast.types.TypeRef
import kf_typecheck.types.runtime_prelude_declares
import kf_core.span.no_span
import kf_core.ast.subst.clone_type_ref

/// The trait fields are optional filters: an empty `trait_name` means any
/// trait, as an unqualified projection asks; a name narrows to one
/// instantiation. `trait_args` is compared only with a trait name, or it would
/// match another trait's same-shaped instantiation.
fun AssocBindingInfo.assoc_binding_matches(type_name: str, assoc_name: str, trait_name: str, trait_args: str): bool {
    if !self.type_name.as_str().equals(type_name) { return false }
    if !self.assoc_name.as_str().equals(assoc_name) { return false }
    if trait_name.equals("") { return true }
    if !self.trait_name.as_str().equals(trait_name) { return false }
    return self.trait_args.as_str().equals(trait_args)
}

impl SigTable {
    pub mutating fun insert(sig: FnSignature): void {
        // Only a name's first registration is indexed; duplicates are still
        // pushed to the list.
        val key = String.from(sig.name.as_str())
        if !self.sig_index.contains(&key) {
            self.sig_index.insert(key, self.sigs.size())
        }
        self.sigs.push(sig)
    }

    pub mutating fun insert_struct(s: StructLayout): void {
        self.structs.push(s)
    }

    /// The registered signature of that name, if any.
    pub fun find_signature(name: str): FnSignature? {
        val key = String.from(name)
        when (self.sig_index.get(&key)) {
            Some(at) => { return Option.Some(*self.sigs.at(*at)) }
            None => { return Option.None }
        }
    }

    /// Whether another crate declares a generic of the same name as `sig`, so
    /// the two would be instantiated under one C name.
    pub fun has_generic_twin(sig: &FnSignature): bool {
        if sig.generics.size() == 0 { return false }
        while other in &self.sigs {
            if other.name.as_str().equals(sig.name.as_str()) && other.generics.size() > 0 &&
                other.owner_crate.raw != sig.owner_crate.raw {
                return true
            }
        }
        return false
    }

    /// `find_signature` with visibility when `gate_visibility` is set: visible
    /// to its own module always, to any other module, in this crate or
    /// another, only if `pub` and imported. The caller's own crate shadows
    /// other crates; `@prelude` functions need no import.
    pub fun find_imported_signature(name: str, caller_file: uint32, caller_crate: CrateId, caller_module: Sym): FnSignature? {
        // The caller's own crate shadows an imported definition, or every
        // library addition could break a program using that name. The runtime
        // prelude is exempt: its names are reserved and in every TU.
        if !runtime_prelude_declares(name) {
            while mine in &self.sigs {
                if mine.name.as_str().equals(name) && mine.owner_crate.raw == caller_crate.raw {
                    // Own module: unrestricted. Same crate, other module: only
                    // `pub` and imported; keep scanning, since a later or
                    // imported definition may still answer.
                    if mine.owner_module.id == caller_module.id { return Option.Some(mine) }
                    if mine.is_pub && self.imports_admit(caller_file, &mine) { return Option.Some(mine) }
                }
            }
        }
        // `gate_visibility` alone decides; guarding on the import list too
        // would let a file with no imports call every private function.
        if !self.gate_visibility {
            return self.find_signature(name)
        }
        var ambient: uint64 = 0
        var has_ambient = false
        var i = 0
        while i < self.sigs.size() {
            val s = *self.sigs.at(i)
            if s.name.as_str().equals(name) {
                // In every generated translation unit.
                if runtime_prelude_declares(name) {
                    return Option.Some(s)
                }
                if s.owner_crate.raw == caller_crate.raw {
                    if s.owner_module.id == caller_module.id { return Option.Some(s) }
                    if !s.is_pub { return Option.None }
                }
                if s.is_pub && self.imports_admit(caller_file, &s) { return Option.Some(s) }
                if s.is_pub && s.is_prelude && !has_ambient {
                    ambient = i
                    has_ambient = true
                }
            }
            i = i + 1
        }
        when (self.find_renamed(name, caller_file)) {
            Some(renamed) => return Option.Some(renamed)
            None => { }
        }
        if has_ambient { return Option.Some(*self.sigs.at(ambient)) }
        return Option.None
    }

    /// Ungated, everything is admitted; gated, the caller's imports decide.
    pub fun imports_admit(caller_file: uint32, sig: &FnSignature): bool {
        if !self.gate_visibility { return true }
        return self.file_admits(caller_file, sig.owner_module, self.surface_name(sig.name.as_str()).as_str())
    }

    /// The link name a call to `sig` keeps when another crate declares a
    /// function of the same name, which a rename by bare name could pick
    /// instead; "" when the bare name is unambiguous.
    pub fun pinned_link_name(sig: &FnSignature): String {
        if sig.is_extern || sig.generics.size() > 0 { return "" }
        while other in &self.sigs {
            if other.owner_crate.raw != sig.owner_crate.raw && other.name.as_str().equals(sig.name.as_str()) {
                return "${sig.owner_crate.symbol_prefix().as_str()}${sig.name.as_str()}"
            }
        }
        return ""
    }

    /// The file's own imports admit `name` from `target`; a sibling's do not.
    /// CONSTRAINT: keep scanning on a miss, since one file may name several
    /// imports of one module.
    pub fun file_admits(caller: uint32, target: Sym, name: str): bool {
        var i = 0
        while i < self.caller_files.size() {
            if self.caller_files.get(i) == caller {
                if self.imported_targets.get(i).id == target.id {
                    // No names recorded means the whole module.
                    if i >= self.imported_names.size() { return true }
                    val admitted = self.imported_names.get(i)
                    // Poison is `.*`.
                    if admitted.id == 0 { return true }
                    if admitted.as_str().equals(name) { return true }
                }
            }
            i = i + 1
        }
        return false
    }

    // Types resolve globally, whatever the imports say; gating them would be a
    // language decision, not a filter here.

    pub mutating fun insert_type_identity(identity: TypeIdentity): void {
        self.type_identities.push(identity)
    }

    pub fun lookup_type_identity(name: str, crate: CrateId, module: Sym): TypeIdentity {
        while identity in &self.type_identities {
            if identity.name.as_str().equals(name) {
                if identity.crate.raw == crate.raw && identity.module.id == module.id { return identity }
            }
        }
        return TypeIdentity.new_poison()
    }

    /// Only when exactly one declaration exports the name.
    pub fun lookup_unique_type_identity(name: str): TypeIdentity {
        var found = TypeIdentity.new_poison()
        var count: uint64 = 0
        while identity in &self.type_identities {
            if identity.name.as_str().equals(name) {
                found = identity
                count = count + 1
            }
        }
        if count == 1 { return found }
        return TypeIdentity.new_poison()
    }

    /// A lookup from that crate answers only with its own declaration.
    /// CONSTRAINT: reads type identities, which exist before layouts: a
    /// program's plain `Range` must hide core's before either is laid out.
    fun crate_declares_type(name: str, crate: CrateId): bool {
        if crate.is_poison() { return false }
        while identity in &self.type_identities {
            if identity.crate.raw == crate.raw && identity.name.as_str().equals(name) { return true }
        }
        return false
    }

    /// As `caller` sees it.
    pub fun find_struct(name: str, caller: CrateId): StructLayout? {
        val own_only = self.crate_declares_type(name, caller)
        while s in &self.structs {
            if s.name.as_str().equals(name) && (!own_only || s.owner_crate.raw == caller.raw) {
                return Option.Some(s)
            }
        }
        return Option.None
    }

    pub mutating fun insert_enum(e: EnumLayout): void {
        self.enums.push(e)
    }

    pub mutating fun insert_generic_info(g: GenericInfo): void {
        self.generic_infos.push(g)
    }

    pub mutating fun insert_trait(t: TraitInfo): void {
        self.traits.push(t)
    }

    /// Fills the entry sharing `t`'s name, inserting when none exists. Traits
    /// register in two passes (names, then signatures), so a method naming
    /// `dyn OtherTrait` does not depend on declaration or file order.
    pub mutating fun replace_trait(t: TraitInfo): void {
        var i = 0
        while i < self.traits.size() {
            if self.traits.at(i).name.as_str().equals(t.name.as_str()) {
                self.traits.set(i, t)
                return
            }
            i = i + 1
        }
        self.traits.push(t)
    }

    pub mutating fun insert_trait_impl(ti: TraitImplInfo): void {
        self.trait_impls.push(ti)
    }

    pub mutating fun insert_assoc_binding(ab: AssocBindingInfo): void {
        self.assoc_bindings.push(ab)
    }

    /// Impls on `type_name` binding `assoc_name`, checked before a lookup:
    /// two traits may each bind `Item`, and the count says "ambiguous".
    pub fun count_assoc_bindings(type_name: str, assoc_name: str): uint64 {
        var found: uint64 = 0
        while ab in &self.assoc_bindings {
            if ab.assoc_binding_matches(type_name, assoc_name, "", "") { found = found + 1 }
        }
        return found
    }

    /// Narrowed to one trait instantiation: inside an impl the instantiation
    /// is known, so `Index<uint64>` and `Index<Range<uint64>>` do not collide.
    pub fun count_assoc_bindings_in(type_name: str, trait_name: str, trait_args: str, assoc_name: str): uint64 {
        var found: uint64 = 0
        while ab in &self.assoc_bindings {
            if ab.assoc_binding_matches(type_name, assoc_name, trait_name, trait_args) { found = found + 1 }
        }
        return found
    }

    /// Poison when unbound. First match wins; call after confirming a count
    /// of one.
    pub fun lookup_assoc_binding(type_name: str, assoc_name: str): Type {
        return self.lookup_assoc_binding_in(type_name, "", "", assoc_name)
    }

    /// An empty `trait_name` means any.
    pub fun lookup_assoc_binding_in(type_name: str, trait_name: str, trait_args: str, assoc_name: str): Type {
        while ab in &self.assoc_bindings {
            if ab.assoc_binding_matches(type_name, assoc_name, trait_name, trait_args) { return ab.chosen }
        }
        return Type.new_poison()
    }

    /// An independent copy, since it is spliced into the AST and dropped
    /// with it.
    pub fun lookup_assoc_binding_tref(type_name: str, assoc_name: str): TypeRef {
        return self.lookup_assoc_binding_tref_in(type_name, "", "", assoc_name)
    }

    pub fun lookup_assoc_binding_tref_in(type_name: str, trait_name: str, trait_args: str, assoc_name: str): TypeRef {
        while ab in &self.assoc_bindings {
            if ab.assoc_binding_matches(type_name, assoc_name, trait_name, trait_args) {
                return clone_type_ref(&ab.chosen_tref)
            }
        }
        return TypeRef.new_poison(no_span())
    }

    pub mutating fun insert_method_link(link: MethodLink): void {
        self.method_links.push(link)
    }

    pub fun lookup_method_link(receiver_identity: Sym, method_name: str): Sym {
        while link in &self.method_links {
            if link.receiver_identity.id == receiver_identity.id {
                if link.method_name.as_str().equals(method_name) {
                    return link.link_name
                }
            }
        }
        return intern("")
    }

    pub fun find_trait(name: str): TraitInfo? {
        while t in &self.traits {
            if t.name.as_str().equals(name) {
                return Option.Some(t)
            }
        }
        return Option.None
    }

    pub fun count_traits_named(name: str): uint64 {
        var count: uint64 = 0
        while i in 0..self.traits.size() {
            if self.traits.at(i).name.as_str().equals(name) { count = count + 1 }
        }
        return count
    }

    pub fun find_unique_trait(name: str): TraitInfo? {
        if self.count_traits_named(name) != 1 { return Option.None }
        return self.find_trait(name)
    }

    pub fun find_trait_identity(identity: Sym): TraitInfo? {
        while i in 0..self.traits.size() {
            val trait_info = *self.traits.at(i)
            if trait_info.identity.id == identity.id { return Option.Some(trait_info) }
        }
        return Option.None
    }

    /// As `caller` sees it.
    /// A generic struct's layout, written in its own parameters, and those
    /// parameters.
    pub fun generic_struct(name: str, caller: CrateId): GenericStruct? {
        val info = self.find_generic_info(name, caller) ?: return null
        val layout = self.find_struct(name, caller) ?: return null
        return GenericStruct { layout: layout, type_params: info.type_params }
    }

    pub fun find_generic_info(name: str, caller: CrateId): GenericInfo? {
        val own_only = self.crate_declares_type(name, caller)
        while i in 0..self.generic_infos.size() {
            val g = *self.generic_infos.at(i)
            if g.name.as_str().equals(name) && (!own_only || g.owner_crate.raw == caller.raw) {
                return Option.Some(g)
            }
        }
        return Option.None
    }

    /// As `caller` sees it.
    pub fun find_enum(name: str, caller: CrateId): EnumLayout? {
        val own_only = self.crate_declares_type(name, caller)
        while i in 0..self.enums.size() {
            val e = *self.enums.at(i)
            if e.name.as_str().equals(name) && (!own_only || e.owner_crate.raw == caller.raw) {
                return Option.Some(e)
            }
        }
        return Option.None
    }

    pub mutating fun insert_inst(gi: GenericInst): void {
        self.insts.push(gi)
    }

    pub fun find_inst(name: str): GenericInst? {
        while g in &self.insts {
            if g.mangled.as_str().equals(name) {
                return Option.Some(g)
            }
        }
        return Option.None
    }
}
