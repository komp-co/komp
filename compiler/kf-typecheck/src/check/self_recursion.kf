// An operator on a user type calls its trait method, so writing that operator
// inside the method recurses until the stack runs out. Only the syntactic
// shape that can never terminate is caught: the receiver against the receiver
// or a parameter, nothing in between. `self.x == other.x` is fine.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.lang_display_key
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic

/// Checking the body of `<trait>.<method>`.
fun TypeCtx.defining_trait_method(trait_name: str, method_name: str): bool {
    if !self.impl_trait.as_str().equals(trait_name) { return false }
    return self.impl_method.as_str().equals(method_name)
}

/// "" for a field access, call or literal.
fun Expr.bare_variable_name(): String {
    return when (self.kind) {
        Variable(name) => name.as_string()
        _ => ""
    }
}

fun is_bare_self(e: &Expr): bool {
    return e.bare_variable_name().as_str().equals("self")
}

/// The receiver or a parameter: values that arrive unchanged.
fun is_self_or_param(e: &Expr, ctx: &TypeCtx): bool {
    // Through the deref typecheck inserts for a borrowed parameter.
    when (e.kind) {
        Deref(inner) => return is_self_or_param(unsafe { &*inner }, ctx)
        _ => {}
    }
    val name = e.bare_variable_name()
    if name.as_str() == "" { return false }
    if name.as_str().equals("self") { return true }
    while param in &ctx.params {
        if param.as_str().equals(name.as_str()) { return true }
    }
    return false
}

fun Expr.operands_reenter_method(rhs: &Expr, ctx: &TypeCtx): bool {
    if is_bare_self(self) && is_self_or_param(rhs, ctx) { return true }
    return is_bare_self(rhs) && is_self_or_param(self, ctx)
}

/// Names the operator as written and says to compare or render the fields.
fun emit_self_recursive_operator(op: str, method_name: str, instead: str, span: Span, ctx: &var TypeCtx): void {
    var msg = String.from("`")
    msg.append(op)
    msg.append("` here calls `")
    msg.append(method_name)
    msg.append("` — the method it is being written inside, on the same receiver — so it recurses until the stack runs out (")
    msg.append(instead)
    msg.append(")")
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

/// `${self}` lowers to `<lang string>.of(&(...))`, reaching `display` through
/// the trait object, which the method-call check cannot see.
fun reject_self_recursive_render(recv: &Expr, method_name: &String, args: &List<Expr>, span: Span, ctx: &var TypeCtx): bool {
    if !ctx.defining_trait_method(ctx.lang_trait_name(lang_display_key()).as_str(), "display") { return false }
    if !method_name.as_str().equals("of") { return false }
    if !recv.bare_variable_name().as_str().equals(ctx.string_name().as_str()) { return false }
    if args.size() != 1 { return false }
    if !is_bare_self(args.at(0)) { return false }
    emit_self_recursive_operator("\${self}", "display", "render the fields", span, ctx)
    return true
}
