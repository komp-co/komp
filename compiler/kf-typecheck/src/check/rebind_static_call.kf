// Re-binds a zero-argument static call on a generic type to its slot's
// instance.

import alloc.list.*

import kf_core.ast.intern
import kf_core.ast.expression.Expr
import kf_typecheck.types.*

/// `List.new()` in a `List<int32>` slot.
/// CONSTRAINT: zero value arguments only; with arguments the list may alias a
/// statement buffer (see rebind_call.kf).
mutating fun Expr.rebind_static_call(inst: &GenericInst, ctx: &var TypeCtx): bool {
    if self.type_args.size() > 0 || self.type_args_written { return false }
    val base = inst.base.clone()
    when (self.kind) {
        MethodCall(recv_ptr, mname, margs) => {
            if margs.size() > 0 { return false }
            val recv_raw = unsafe { *recv_ptr }
            if !kind_is_variable_named(recv_raw.kind, base.as_str()) { return false }
            var tmpl = base.clone()
            tmpl.append("_")
            tmpl.append(mname.as_str())
            val found = unsafe { (*ctx.sigs).find_signature(tmpl.as_str()) }
            if found.is_none() { return false }
            val ssig = found ?: return false
            if !ssig.is_static { return false }
            // The slot supplies only the type's arguments.
            val n_recv = base.static_recv_arity(ctx)
            if n_recv == 0 || ssig.generics.size() != n_recv { return false }
            if inst.args.size() != n_recv { return false }

            val recv_mono = mangle_type_name(base.as_str(), &inst.args, ctx)
            instantiate_generic_layout(base.clone(), &inst.args, String.from(recv_mono.as_str()), ctx)
            var ret = ssig.ret
            var gi = 0
            while gi < n_recv {
                val gname = *ssig.generics.at(gi)
                val gty = (*inst.args.at(gi)).resolve_type_ref(ctx)
                check_generic_bounds(tmpl.clone(), gname.clone(), gty, self.span, ctx)
                ret = ret.subst_generic(gname, gty)
                gi = gi + 1
            }
            var callee = recv_mono.clone()
            callee.append("_")
            callee.append(mname.as_str())
            self.type_args = clone_type_args(&inst.args)
            self.ty = ret
            self.mangled_callee = intern(callee.as_str())
            self.is_static_call = true
            note_open_call_typed(self.span, ctx)
            return true
        }
        _ => return false
    }
}
