import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_typecheck.types.*
import kf_core.ast.subst.subst_tref_list
import kf_core.ast.subst.monomorphized_type_name

// A call's return type is synthesized from the callee's template, so it never
// passes the written-type path that registers an instance. Registered here:
//
//   the ROW      its meaning, base plus arguments, for display
//   the LAYOUT   its shape, so a `when` can type an enum payload
//
// Without a layout a payload types as poison. Dropping a typed payload is
// safe because a container returning a view answers `Option<&V>`.

/// So `Option__Vertex` reads back as `Option<Vertex>`. The arguments are read
/// off `ret`'s own suffix, not the template's parameter names.
fun Type.register_returned_instance(span: Span, ctx: &var TypeCtx): void {
    var name = ""
    when (self.kind) {
        Struct(n) => { name = n.as_string() }
        EnumTy(n) => { name = n.as_string() }
        _ => { return }
    }
    val base = mangle_base_name(name.clone())
    if base.as_str().equals(name.as_str()) { return }
    val sp = ctx.sigs
    val known = unsafe { sp.find_inst(name.as_str()) }
    if known.is_some() { return }
    val info = unsafe { sp.find_generic_info(base.as_str(), ctx.owner_crate) } ?: return
    val base_len = base.as_str().byte_len()
    val name_len = name.as_str().byte_len()
    if base_len + 2 >= name_len { return }
    val suffix = mangle_suffix(name.clone(), base_len + 2)
    // One parameter takes the whole suffix; several split only when the
    // segment counts agree.
    var frags = List.new<String>()
    if info.type_params.size() == 1 {
        frags.push(suffix)
    } else {
        frags = mangle_segments(suffix.as_str())
        if frags.size() != info.type_params.size() { return }
    }
    var args = List.new<TypeRef>()
    while frag in &frags {
        if !frag.frag_names_a_type(ctx) { return }
        args.push(frag.tref_from_frag(span, ctx))
    }
    unsafe { sp.insert_inst(GenericInst { mangled: name.clone(), base: base.clone(), args: args.clone() }) }
    instantiate_generic_layout(base, &args, name, ctx)
}

/// The TypeRef a mangle fragment denotes as a generic argument. Declared
/// names spell themselves; `kf__ref__String` is the structural mangle of
/// `&String`, decoded with `ref_key_inner`, the inverse of `mangle_type_frag`.
/// The marker is reserved-prefixed and carries mutability, so `&var T` reads
/// back as one. `Ptr__X` and `Box__X` resolve as builtins, and
/// `kf__array__N__X` is `X[N]`.
fun String.tref_from_frag(span: Span, ctx: &var TypeCtx): TypeRef {
    val function = ctx.fn_type_for(self.as_str())
    if function != null { return function!!.type_to_type_ref(span) }
    val array = array_frag_parts(self.as_str())
    if array != null {
        val element = Box.new(array!!.element.tref_from_frag(span, ctx))
        return new_type_ref(span, TypeRefKind.Array(element, array!!.length))
    }
    val named = new_type_ref(span, TypeRefKind.Named(intern(self.as_str()), List.new<TypeRef>()))
    if unsafe { (*ctx.sigs).find_struct(self.as_str(), ctx.owner_crate) }.is_some() { return named }
    if unsafe { (*ctx.sigs).find_enum(self.as_str(), ctx.owner_crate) }.is_some() { return named }
    val inner = ref_key_inner(self.as_str())
    if inner.as_str().byte_len() == 0 { return named }
    val is_mut = ref_key_is_mut(self.as_str())
    val inner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner_ptr = inner.tref_from_frag(span, ctx) }
    return new_type_ref(span, TypeRefKind.Reference(is_mut, inner_ptr))
}

/// A fragment naming a concrete type. An unpinned parameter (`T`) spells
/// itself, and an instance around it would claim arguments nobody supplied.
fun String.frag_names_a_type(ctx: &var TypeCtx): bool {
    if ctx.fn_type_for(self.as_str()) != null { return true }
    val t = ty_from_mangle_frag(self.clone(), no_span(), ctx.string_name())
    if t.kind.kind_tag() != TAG_STRUCT() { return true }
    val as_struct = unsafe { (*ctx.sigs).find_struct(self.as_str(), ctx.owner_crate) }
    if as_struct.is_some() { return true }
    val as_enum = unsafe { (*ctx.sigs).find_enum(self.as_str(), ctx.owner_crate) }
    if as_enum.is_some() { return true }
    // A borrow is never declared, so ask about what it borrows; otherwise
    // `Option<&T>` decodes to nothing and its payload binder goes untyped.
    val inner = ref_key_inner(self.as_str())
    if inner.as_str().byte_len() > 0 { return inner.frag_names_a_type(ctx) }
    return false
}

// The layout behind a generic method's return type, from the receiver's
// bindings: `List<T>.iter(): ListIter<T>` on `List__int32` needs
// `ListIter__int32` before `while x in xs` can bind through it. Covers only
// instances whose parameter names match the receiver's;
// `register_returned_instance` catches the rest.
fun materialize_method_return_instance(ret: Type, binding: &RecvBinding, method_names: &List<String>, method_types: &List<Type>, span: Span, ctx: &var TypeCtx): void {
    var name = ""
    when (ret.kind) {
        Struct(n) => { name = n.as_string() }
        EnumTy(n) => { name = n.as_string() }
        _ => { return }
    }
    val base = mangle_base_name(name.clone())
    if base.as_str().equals(name.as_str()) { return }
    val info = unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) } ?: return
    var args = List.new<TypeRef>()
    while param in &info.type_params {
        var found = false
        var j = 0
        while j < binding.names.size() {
            if binding.names.at(j).as_str().equals(param.as_str()) {
                args.push(binding.types.at(j).type_arg_ref(span))
                found = true
                break
            }
            j = j + 1
        }
        j = 0
        while !found && j < method_names.size() {
            if method_names.at(j).as_str().equals(param.as_str()) {
                args.push(method_types.at(j).type_arg_ref(span))
                found = true
                break
            }
            j = j + 1
        }
        if !found { return }
    }
    instantiate_generic_layout(base, &args, name, ctx)
}

// A row for a substituted return type the receiver's parameter names cannot
// supply: `Option<T>.branch(): Branch<T, Option<Never>>` names `O` and `R`,
// and `Branch__int32__Option__Never` cannot be split by name. The row already
// registered for `Branch__T__Option__Never` records `[T, Option<Never>]`;
// pushing the receiver's bindings through it makes them concrete.
//
// A row only: a layout would mean guessing the split and giving the instance
// glue Mono emits again. `instance_variant_payloads` reads binders through it.
fun Type.register_substituted_return_row(post: &Type, binding: &RecvBinding, span: Span, ctx: &var TypeCtx): void {
    val pre_name = self.instance_name_of()
    val post_name = post.instance_name_of()
    if pre_name.as_str().byte_len() == 0 { return }
    if pre_name.as_str().equals(post_name.as_str()) { return }
    if binding.names.size() == 0 { return }
    // Only where the name cannot carry the arguments; otherwise
    // `register_returned_instance` already does better.
    if !mangled_name_is_ambiguous(post_name.as_str(), ctx) { return }
    val sp = ctx.sigs
    if unsafe { sp.find_inst(post_name.as_str()) }.is_some() { return }
    val row = unsafe { sp.find_inst(pre_name.as_str()) } ?: return
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    var i = 0
    while i < binding.names.size() {
        val flat = mangle_type(*binding.types.at(i))
        if flat.as_str().byte_len() == 0 { return }
        names.push(*binding.names.at(i))
        repls.push(binding.types.at(i).type_arg_ref(span))
        i = i + 1
    }
    val args = subst_tref_list(&row.args, &var names, &var repls)
    // Only when the rebuilt name is exactly the substituted one.
    if !monomorphized_type_name(row.base.clone(), &args).as_str().equals(post_name.as_str()) { return }
    unsafe { sp.insert_inst(GenericInst { mangled: post_name.clone(), base: row.base.clone(), args: args }) }
}

fun Type.instance_name_of(): String {
    return when (self.kind) {
        Struct(n) => n.as_string()
        EnumTy(n) => n.as_string()
        _ => ""
    }
}

/// A variant's payload types on an instance with no layout, read from the
/// template through its row. Empty when any link is missing.
pub fun instance_variant_payloads(inst_name: str, variant_name: str, ctx: &var TypeCtx): List<Type> {
    val empty = List.new<Type>()
    // Decodable names have layouts; only ambiguous ones need a row.
    if !mangled_name_is_ambiguous(inst_name, ctx) { return empty }
    val row = unsafe { (*ctx.sigs).find_inst(inst_name) } ?: return empty
    val info = unsafe { (*ctx.sigs).find_generic_info(row.base.as_str(), ctx.owner_crate) } ?: return empty
    if info.type_params.size() != row.args.size() { return empty }
    val tpl = unsafe { (*ctx.sigs).find_enum(row.base.as_str(), ctx.owner_crate) } ?: return empty
    while v in &tpl.variants {
        if v.name.as_str().equals(variant_name) {
            var out = List.new<Type>()
            while pi in 0..v.payloads.size() {
                var pty = *v.payloads.at(pi)
                var ai = 0
                while ai < info.type_params.size() {
                    pty = pty.subst_generic(*info.type_params.at(ai), (*row.args.at(ai)).resolve_type_ref(ctx))
                    ai = ai + 1
                }
                out.push(pty)
            }
            return out
        }
    }
    return empty
}

/// `Option__String` decodes; `Branch__int32__Option__Never` (two parameters,
/// three segments) does not.
fun mangled_name_is_ambiguous(name: str, ctx: &var TypeCtx): bool {
    val owned = String.from(name)
    val base = mangle_base_name(owned.clone())
    if base.as_str().equals(name) { return false }
    val info = unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) } ?: return false
    if info.type_params.size() < 2 { return false }
    val base_len = base.as_str().byte_len()
    val name_len = name.byte_len()
    if base_len + 2 >= name_len { return false }
    val frags = mangle_segments(mangle_suffix(owned, base_len + 2).as_str())
    return frags.size() != info.type_params.size()
}

/// A bound type as a type argument: by its mangled name, which a declared
/// type resolves back from, and an array by its element and length, which
/// no declaration answers to.
fun Type.type_arg_ref(span: Span): TypeRef {
    if self.kind.kind_tag() == TAG_ARRAY() { return self.type_to_type_ref(span) }
    return new_type_ref(span, TypeRefKind.Named(intern(mangle_type(*self).as_str()), List.new<TypeRef>()))
}
