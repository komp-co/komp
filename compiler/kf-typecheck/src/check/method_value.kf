// `Type.method` where a value is wanted: the method as a function whose first
// parameter is its receiver, `&Type`, or `&var Type` for a mutating method. A
// static method takes no receiver.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.note_import_use

/// True when `receiver` names a type with a method `method`, which makes
/// `self` a `FnRef` to it. A variant of the same name is the variant.
pub mutating fun Expr.name_method_value(receiver: &Expr, method: Sym, ctx: &var TypeCtx): bool {
    val type_name = static_recv_type_name(receiver.kind, ctx)
    if type_name.byte_len() == 0 || enum_name_has_variant(type_name.clone(), method.as_string(), ctx) { return false }
    val sigs = unsafe { &*ctx.sigs }
    val sig = sigs.method_signature(type_name.as_str(), method.as_str()) ?: return false
    note_import_use(ctx.sigs, ctx.owner_file, sig.owner_module)
    if sig.generics.size() > 0 {
        val what = "`${type_name.as_str()}.${method.as_str()}`"
        val message = "generic method ${what} cannot be used as a value: a function value has one type"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        self.ty = Type.new_poison()
        return true
    }
    val owner_ref = TypeRef.new(self.span, TypeRefKind.Named(intern(type_name.as_str()), List.new<TypeRef>()))
    val owner = owner_ref.resolve_type_ref(ctx)
    self.kind = ExprKind.FnRef(intern(sig.name.as_str()))
    val link = sigs.receiver_method_link(&owner, method.as_str())
    if link.as_str().byte_len() > 0 { self.mangled_callee = link }
    var params = List.new<Type>()
    var is_receiver = !sig.is_static
    while param in &sig.params {
        params.push(if is_receiver { owner.borrowed(sig.is_mutating, self.span) } else { param })
        is_receiver = false
    }
    self.ty = Type.new_fn(params, sig.ret, Provenance.Inferred(self.span))
    ctx.note_fn_type(&self.ty)
    return true
}

/// `Type_method`, or the one trait impl's `Type_method__Trait`; null when
/// there is none, or more than one trait provides it.
fun SigTable.method_signature(type_name: str, method: str): FnSignature? {
    val inherent = "${type_name}_${method}"
    val direct = self.find_signature(inherent.as_str())
    if direct != null { return direct }
    val prefix = "${inherent}__"
    var found: FnSignature? = null
    while sig in &self.sigs {
        if sig.name.as_str().starts_with(prefix.as_str()) {
            if found != null { return null }
            found = Option.Some(sig)
        }
    }
    return found
}

/// An imported method's symbol, "" for one of this crate.
fun SigTable.receiver_method_link(owner: &Type, method: str): Sym {
    return when (owner.kind) {
        Struct(identity) => self.lookup_method_link(identity, method)
        EnumTy(identity) => self.lookup_method_link(identity, method)
        _ => intern("")
    }
}
