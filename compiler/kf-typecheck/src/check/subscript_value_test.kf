import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

fun call_on_bits(method: str): Expr {
    val receiver = Box.new(Expr.new(no_span(), ExprKind.Variable(intern("bits"))))
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(3)))
    return Expr.new(no_span(), ExprKind.MethodCall(receiver, intern(method), args))
}

@test fun an_index_value_call_is_a_computed_subscript(): void {
    assert_eq(call_on_bits("index_value").is_computed_subscript(), true, "bits[3] through IndexValue")
}

@test fun an_index_call_is_not_a_computed_subscript(): void {
    assert_eq(call_on_bits("index").is_computed_subscript(), false, "bits[3] through Index lends a place")
}
