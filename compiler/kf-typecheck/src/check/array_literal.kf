// `[a, b, c]` where an `Array<T, N>` is expected: the elements in place, as
// many as the array holds.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.Sym
import kf_core.ast.array_literal_callee
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.check.borrow.coerce_call_arg
import kf_typecheck.types.display_type
import kf_typecheck.types.type_eq
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.type_to_type_ref
import kf_typecheck.types.clone_type_args
import kf_core.ast.subst.subst_expr
import kf_typecheck.types.note_open_call_typed

/// What an `Array<T, N>` instance holds.
struct ArrayShape {
    val element: Type
    val length: uint64
}

/// None unless `self` is an instance of core's `Array`.
fun Type.array_shape(ctx: &var TypeCtx): ArrayShape? {
    val inst = self.expected_inst(ctx) ?: return null
    if inst.base.as_str() != ctx.array_name().as_str() || inst.args.size() != 2 { return null }
    val length = inst.args.at(1).written_length() ?: return null
    return ArrayShape { element: inst.args.at(0).resolve_type_ref(ctx), length: length }
}

/// An instance as its template and arguments, the form mono collects:
/// `Array<int32, 3>`, not its mangled name. Any other type as written.
fun Type.written_instance(span: Span, ctx: &var TypeCtx): TypeRef {
    val inst = self.expected_inst(ctx) ?: return self.type_to_type_ref(span)
    return TypeRef.new(span, TypeRefKind.Named(intern(inst.base.as_str()), clone_type_args(&inst.args)))
}

fun TypeRef.written_length(): uint64? {
    when (self.kind) {
        Value(v) => return v as uint64
        _ => return null
    }
}

/// True when `self` is a literal and `expected` an array, whether or not
/// the literal fits.
mutating fun Expr.retarget_array_literal(expected: Type, ctx: &var TypeCtx): bool {
    if !self.is_empty_list_literal(ctx) && !self.is_array_literal() { return false }
    if expected.type_is_option(ctx) { return self.retarget_optional_array_literal(expected, ctx) }
    val shape = expected.array_shape(ctx) ?: return false
    if self.is_array_literal() && self.ty.type_eq(expected) { return true }
    ctx.settle_literal(self.span)
    // `[]` was an open `new()`; the array it becomes needs no use to type it.
    if self.is_empty_list_literal(ctx) { note_open_call_typed(self.span, ctx) }
    var elements = self.literal_elements()
    if elements.size() != shape.length {
        val shown = expected.display_type(ctx)
        val message = "this literal has ${elements.size()} elements, but `${shown}` holds ${shape.length}"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        self.ty = Type.new_poison()
        return true
    }
    self.become_array_literal(elements, expected, &shape, ctx)
    return true
}

/// The array literal of `elements`, each checked against the element type.
mutating fun Expr.become_array_literal(
    elements: List<Expr>,
    expected: Type,
    shape: &ArrayShape,
    ctx: &var TypeCtx
): void {
    var checked = elements
    var fits = true
    while i in 0..checked.size() {
        if !check_array_element(&var checked, i, shape.element.clone(), ctx) { fits = false }
    }
    val span = self.span
    *self = Expr.new(span, ExprKind.Call(intern(array_literal_callee()), checked))
    self.type_args.push(expected.written_instance(span, ctx))
    self.ty = if fits { expected } else { Type.new_poison() }
}

/// `[a, b]` where `Array<T, N>?` is expected: the array, in `Some`.
mutating fun Expr.retarget_optional_array_literal(expected: Type, ctx: &var TypeCtx): bool {
    val option = expected.expected_inst(ctx) ?: return false
    if option.args.size() != 1 { return false }
    val payload = option.args.at(0).resolve_type_ref(ctx)
    if payload.array_shape(ctx) == null || !self.retarget_array_literal(payload, ctx) { return false }
    if !self.ty.is_poison() { self.wrap_in_some(&option, ctx) }
    return true
}

fun check_array_element(elements: &var List<Expr>, i: uint64, expected: Type, ctx: &var TypeCtx): bool {
    val before = elements.at(i).ty.clone()
    val outcome = coerce_call_arg(elements, i, expected.clone(), ctx)
    if !outcome.valid { return false }
    val actual = if before.is_poison() { Type.new_poison() } else { elements.at(i).ty.clone() }
    if outcome.coerced || actual.type_eq(expected) || ctx.fits(actual, expected) { return true }
    // Checked first as a list's, whose elements must agree too.
    if ctx.reported_at(elements.at(i).span) { return false }
    val message = "this element is `${actual.display_type(ctx)}`, but the array holds `${expected.display_type(ctx)}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(elements.at(i).span, message)))
    return false
}

fun TypeCtx.reported_at(span: Span): bool {
    while diag in &self.diags.items {
        val at = diag.primary.span
        if at.file_id == span.file_id && at.start == span.start && at.end == span.end { return true }
    }
    return false
}

fun Expr.is_array_literal(): bool {
    return when (self.kind) {
        Call(name, _args) => name.as_str() == array_literal_callee()
        _ => false
    }
}

/// An array literal's elements; none for the empty literal.
fun Expr.literal_elements(): List<Expr> {
    return when (self.kind) {
        Call(_name, args) => args.clone()
        _ => List.new<Expr>()
    }
}

/// An array literal no slot has typed yet is an array of its first element's
/// type; a slot may still retarget it. Typed already once it names its array.
mutating fun Expr.type_array_literal(ctx: &var TypeCtx): void {
    if self.type_args.size() > 0 { return }
    var elements = self.literal_elements()
    while i in 0..elements.size() {
        check_expr(elements.at_mut(i), ctx)
    }
    val first = elements.at(0).ty.clone()
    val span = self.span
    if !first.is_poison() { elements = agreeing_elements(&elements, first.clone(), span, ctx) }
    val array = array_type_ref(first.written_instance(span, ctx), elements.size(), ctx.array_name(), span)
    *self = Expr.new(span, ExprKind.Call(intern(array_literal_callee()), elements))
    self.type_args.push(array.clone())
    self.ty = if first.is_poison() { Type.new_poison() } else { array.resolve_type_ref(ctx) }
}

/// The elements checked against the first's type, or, when one does not fit,
/// as they were: a slot may still ask another type of them all, so the
/// mismatch waits for one.
fun agreeing_elements(elements: &List<Expr>, first: Type, literal: Span, ctx: &var TypeCtx): List<Expr> {
    var no_names = List.new<String>()
    var no_types = List.new<TypeRef>()
    var trial = List.new<Expr>()
    while element in elements { trial.push(element.subst_expr(&var no_names, &var no_types)) }
    // A nested literal reports its own mismatch and still claims the slot.
    val mark = ctx.reported()
    var fits = true
    while i in 1..trial.size() {
        if !check_array_element(&var trial, i, first.clone(), ctx) { fits = false }
    }
    if fits && ctx.reported() == mark { return trial }
    ctx.defer_since(mark, literal)
    return elements.clone()
}

/// `Array<element, length>`, as written.
fun array_type_ref(element: TypeRef, length: uint64, array_name: Sym, span: Span): TypeRef {
    var args = List.new<TypeRef>()
    args.push(element)
    args.push(TypeRef.new(span, TypeRefKind.Value(length as int64)))
    return TypeRef.new(span, TypeRefKind.Named(array_name, args))
}

/// `T[]` given the length of what initializes it: a literal's element count
/// (a string's bytes or characters), or the length of the array it copies. Left as written otherwise, for the
/// argument check to report.
fun TypeRef.with_initializer_length(init: &Expr, ctx: &var TypeCtx): TypeRef {
    when (self.kind) {
        Named(head, args) => {
            if head.id != ctx.array_name().id || args.size() != 2 || !args.at(1).is_wildcard() { return self.clone() }
            val length = init.initializer_length(&args.at(0).resolve_type_ref(ctx), ctx) ?: return self.clone()
            return array_type_ref(args.at(0).clone(), length, head, self.span)
        }
        _ => return self.clone()
    }
}

fun Expr.initializer_length(element: &Type, ctx: &var TypeCtx): uint64? {
    val text_length = self.text_literal_length(element)
    if text_length != null { return text_length }
    if self.is_empty_list_literal(ctx) || self.is_array_literal() { return self.literal_elements().size() }
    val shape = self.ty.array_shape(ctx) ?: return null
    return shape.length
}
