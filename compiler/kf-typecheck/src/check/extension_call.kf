// Calling an extension as `ps.area()` or `area(&ps)`: rewritten into a plain
// call to its hidden name with the receiver first. A type's own methods and
// trait methods come first; among extensions a specific receiver
// (`List<Point>`) beats a generic one (`List<T>`), which beats a bare
// parameter (`T`).

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.span.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.check_dyn_method_call
import kf_typecheck.traits.receiver_declares_trait_method
import kf_typecheck.traits.str_list_has
import kf_typecheck.note_import_use_named

/// True when either took the call.
pub fun dyn_or_extension_call(e: &var Expr, recv_ptr: Ptr<Expr>, recv: &Expr, name: Sym, args: &var List<Expr>,
    ctx: &var TypeCtx): bool {
    if e.check_dyn_method_call(recv, name, args, ctx) { return true }
    if !has_extension_named(name.as_str(), ctx) || recv.ty.is_poison() { return false }
    val renders = renders_through_display(recv.ty.clone(), name.as_str(), args.size(), ctx)
    if !renders && receiver_has_own_method(recv.ty.clone(), name.as_string(), ctx) { return false }
    val link = chosen_extension(name.as_str(), &recv.ty, e.span, ctx)
    if link.byte_len() == 0 { return e.report_blocked_extension(name.as_str(), &recv.ty, ctx) }
    if link.as_str().equals(".") || !extension_arity_fits(link.as_str(), name.as_str(), args.size(), e.span, ctx) {
        e.ty = Type.new_poison()
        return true
    }
    if recv.cannot_lend_to(link.as_str(), ctx) {
        emit_immutable_recv_err(name.as_string(), recv, e.span, ctx)
        e.ty = Type.new_poison()
        return true
    }
    var call_args = List.new<Expr>()
    // Owned copies: the store below frees the method call they came from.
    call_args.push(recv.clone())
    while arg in &args {
        call_args.push(arg)
    }
    e.kind = ExprKind.Call(intern(link.as_str()), call_args)
    ctx.pretyped_args = 1
    check_expr(e, ctx)
    return true
}

/// False when an ordinary function has the name or no extension accepts the
/// first argument; the caller then checks the call as usual.
pub mutating fun Expr.extension_function_call(name: Sym, args: &var List<Expr>, ctx: &var TypeCtx): bool {
    if args.size() == 0 || !has_extension_named(name.as_str(), ctx) { return false }
    val sigs = ctx.sigs
    val ordinary = unsafe { (*sigs).find_imported_signature(name.as_str(), ctx.owner_file,
        ctx.owner_crate, ctx.owner_module) }
    if ordinary.is_some() { return false }
    check_call_argument(args.at_mut(0), ctx)
    val link = chosen_extension(name.as_str(), &args.at(0).ty, self.span, ctx)
    ctx.pretyped_args = 1
    if link.byte_len() == 0 { return false }
    if link.as_str().equals(".") {
        ctx.pretyped_args = 0
        self.ty = Type.new_poison()
        return true
    }
    self.ty = check_call(link.clone(), args, self.type_args, self.span, ctx)
    // After the check, which coerced the arguments in place.
    val callee = if ctx.qualified_callee.byte_len() > 0 { ctx.qualified_callee.clone() } else { link.clone() }
    ctx.qualified_callee = String.from("")
    self.kind = ExprKind.Call(intern(callee.as_str()), args.clone())
    return true
}

/// Reported in method-call terms when it does not fit.
fun extension_arity_fits(link: str, name: str, written: uint64, span: Span, ctx: &var TypeCtx): bool {
    val sig = unsafe { (*ctx.sigs).find_signature(link) } ?: return true
    val wanted = sig.params.size() - 1
    if written == wanted { return true }
    val message = "wrong number of arguments to `${name}`: expected ${wanted}, found ${written}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
    return false
}

pub mutating fun TypeCtx.take_pretyped_args(): uint64 {
    val n = self.pretyped_args
    self.pretyped_args = 0
    return n
}

/// An extension's own name rather than its hidden one.
pub fun callee_surface_name(name: str, sigs: Ptr<SigTable>): String {
    return unsafe { (*sigs).surface_name(name) }
}

fun has_extension_named(name: str, ctx: &var TypeCtx): bool {
    val names = unsafe { (*ctx.sigs).ext_names }
    while n in &names {
        if n.as_str().equals(name) { return true }
    }
    return false
}

/// `Display.display` takes a sink, so `v.display()` is alloc's rendering as a
/// `String`, unless the type declares a `display` of its own.
fun renders_through_display(recv_ty: Type, name: str, arg_count: uint64, ctx: &var TypeCtx): bool {
    if name != "display" || arg_count != 0 { return false }
    val recv = autoderef_ty(recv_ty)
    val tag = recv.kind.kind_tag()
    if tag != TAG_STRUCT() && tag != TAG_ENUM() { return true }
    val sname = recv.kind.nominal_name()
    val base = mangle_base_name(sname.clone())
    val table = unsafe { &*ctx.sigs }
    val on_instance = "${sname}_${name}"
    val on_template = "${base}_${name}"
    return table.find_signature(on_instance.as_str()).is_none() && table.find_signature(on_template.as_str()).is_none()
}

/// A type or trait method, or one komp supplies; a type parameter has its
/// bounds' methods. Projections and trait objects keep their own path.
fun receiver_has_own_method(recv_ty: Type, name: String, ctx: &var TypeCtx): bool {
    val recv = autoderef_ty(recv_ty)
    val tag = recv.kind.kind_tag()
    val n = name.as_str()
    if tag == TAG_GENERIC() {
        return trait_method_for_generic(recv.kind.generic_name(), name.clone(), ctx).arity != ARITY_NOT_FOUND()
    }
    if tag == TAG_STR() {
        if n == "equals" || n == "as_str" { return true }
        return receiver_declares_trait_method(recv, name.clone(), ctx)
    }
    if recv.kind.is_primitive_kind() {
        return primitive_intrinsic_method(n) || receiver_declares_trait_method(recv, name.clone(), ctx)
    }
    if tag != TAG_STRUCT() && tag != TAG_ENUM() { return true }
    if n == "clone" { return true }
    val sname = recv.kind.nominal_name()
    val is_list = name_starts_with(sname.clone(), "List__")
    val list_method = n == "get" || n == "at" || n == "at_mut" || n == "size" || n == "is_empty" || n == "push" ||
        n == "set"
    if is_list && list_method { return true }
    val identity = intern(sname.as_str())
    if unsafe { (*ctx.sigs).lookup_method_link(identity, n) }.as_str().byte_len() > 0 { return true }
    if type_has_method_named(sname.as_str(), n, ctx) { return true }
    return receiver_declares_trait_method(recv, name.clone(), ctx)
}

struct ExtensionFit {
    val link: String
    val rank: uint64
    val receiver: Type
}

/// "" when none applies, "." when several tie (reported here).
fun chosen_extension(name: str, recv: &Type, span: Span, ctx: &var TypeCtx): String {
    val fits = fitting_extensions(name, recv, ctx)
    var best: uint64 = 0
    while fit in &fits {
        if fit.rank > best { best = fit.rank }
    }
    var winners = List.new<ExtensionFit>()
    while fit in &fits {
        if fit.rank == best { winners.push(fit.clone()) }
    }
    if winners.size() == 0 { return "" }
    if winners.size() == 1 { return winners.at(0).link }
    var which = ""
    while w in &winners {
        if which.byte_len() > 0 { which.append(", ") }
        which.append("`${extension_receiver_shown(w.link.as_str(), &w.receiver, ctx).as_str()}.${name}`")
    }
    val shown = recv.display_type(ctx)
    val fix = "import only the one you mean"
    val message = "ambiguous extension `${name}` on `${shown.as_str()}`: ${which.as_str()} all apply; ${fix}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
    return String.from(".")
}

fun fitting_extensions(name: str, recv: &Type, ctx: &var TypeCtx): List<ExtensionFit> {
    var out = List.new<ExtensionFit>()
    val names = unsafe { (*ctx.sigs).ext_names }
    val links = unsafe { (*ctx.sigs).ext_links }
    while i in 0..names.size() {
        val link = links.get(i)
        if names.get(i).as_str().equals(name) && !fits_contain(&out, link.as_str()) {
            when (unsafe { (*ctx.sigs).find_signature(link.as_str()) }) {
                Some(sig) => {
                    val rank = sig.receiver_fit(recv, ctx)
                    if rank > 0 && sig.extension_visible(ctx) {
                        note_import_use_named(ctx.sigs, ctx.owner_file, sig.owner_module, intern(name))
                        val receiver = autoderef_ty(*sig.params.at(0))
                        out.push(ExtensionFit { link: link.as_string(), rank: rank, receiver: receiver })
                    }
                }
                None => { }
            }
        }
    }
    return out
}

/// For each extension name, the hidden name of the one a call on `recv`
/// would pick; a name no extension fits, or several tie for, is left out.
pub fun extensions_callable_on(recv: &Type, ctx: &var TypeCtx): List<String> {
    var out = List.new<String>()
    var asked = List.new<String>()
    val names = unsafe { (*ctx.sigs).ext_names }
    while name in &names {
        if !str_list_has(&asked, name.as_str()) {
            asked.push(name.as_string())
            val fits = fitting_extensions(name.as_str(), recv, ctx)
            var best: uint64 = 0
            var winners = List.new<String>()
            while fit in &fits {
                if fit.rank > best {
                    best = fit.rank
                    winners = List.new<String>()
                }
                if fit.rank == best { winners.push(fit.link.clone()) }
            }
            if winners.size() == 1 { out.push(winners.at(0).clone()) }
        }
    }
    return out
}

fun fits_contain(fits: &List<ExtensionFit>, link: str): bool {
    while fit in &fits {
        if fit.link.as_str().equals(link) { return true }
    }
    return false
}

/// 0 when the receiver does not accept `recv`; otherwise 12 for no type
/// parameter, 8 for parameters in arguments, 4 for a bare parameter, plus one
/// for a bound and one more when the bound's arguments are all types.
fun FnSignature.receiver_fit(recv: &Type, ctx: &var TypeCtx): uint64 {
    if self.params.size() == 0 { return 0 }
    val want = autoderef_ty(*self.params.at(0))
    val have = autoderef_ty(recv.clone())
    var bound = want.clone()
    var generic = false
    var narrowed: uint64 = 0
    while g in &self.generics {
        val binding = want.bind_generic_from_param(&have, g.as_str(), ctx)
        if !binding.is_poison() {
            if self.unmet_bound(g.as_str(), &binding, ctx).byte_len() > 0 { return 0 }
            val by_bounds = self.bound_narrowing(g.as_str(), ctx)
            if by_bounds > narrowed { narrowed = by_bounds }
            generic = true
            bound = bound.subst_generic(g.clone(), binding)
        }
    }
    if !bound.type_eq(&have) { return 0 }
    if !generic { return 12 }
    if want.kind.kind_tag() == TAG_GENERIC() { return 4 + narrowed }
    return 8 + narrowed
}

/// Visible as a same-named function would be.
fun FnSignature.extension_visible(ctx: &var TypeCtx): bool {
    if self.owner_crate.raw == ctx.owner_crate.raw && self.owner_module.id == ctx.owner_module.id { return true }
    if !self.is_pub { return false }
    if unsafe { (*ctx.sigs).imports_admit(ctx.owner_file, &self) } { return true }
    return self.is_prelude
}

/// Extensions count once the type's own methods offer nothing close.
fun nearest_with_extensions(type_name: str, wanted: str, budget: uint64, ctx: &var TypeCtx): NearMethod {
    val own = nearest_method_of(type_name, wanted, budget, ctx)
    if own.name.byte_len() > 0 { return own }
    var best = ""
    var best_distance = budget + 1
    val names = unsafe { (*ctx.sigs).ext_names }
    val links = unsafe { (*ctx.sigs).ext_links }
    while i in 0..names.size() {
        val name = names.get(i).as_string()
        when (unsafe { (*ctx.sigs).find_signature(links.get(i).as_str()) }) {
            Some(sig) => {
                val on = autoderef_ty(*sig.params.at(0)).kind.nominal_name()
                val candidate = on.as_str().equals(type_name) && !name.as_str().equals(wanted)
                if candidate && sig.extension_visible(ctx) {
                    val distance = edit_distance(wanted, name.as_str(), best_distance)
                    if distance < best_distance {
                        best = name.clone()
                        best_distance = distance
                    }
                }
            }
            None => { }
        }
    }
    return NearMethod { name: best, tied: false }
}

/// ": `M` declares an extension `name`, ..." when exactly one module declares a
/// `pub` extension of that name the caller's imports hide; "" otherwise.
pub fun unimported_extension_note(wanted: str, ctx: &var TypeCtx): String {
    var found = ""
    val sigs = unsafe { &*ctx.sigs }
    while i in 0..sigs.ext_names.size() {
        if sigs.ext_names.get(i).as_str().equals(wanted) {
            when (sigs.find_signature(sigs.ext_links.get(i).as_str())) {
                Some(sig) => {
                    if sig.is_pub && !sig.extension_visible(ctx) {
                        val owner = sig.owner_module.as_str()
                        if found.as_str() != "" && !found.as_str().equals(owner) { return "" }
                        found = String.from(owner)
                    }
                }
                None => { }
            }
        }
    }
    if found.as_str() == "" { return "" }
    return ": `${found.as_str()}` declares an extension `${wanted}`, and this file does not import it"
}

/// A `mutating` extension's `&var` receiver, asked of a place that cannot
/// lend one: reported in method terms, as an impl's method is.
fun Expr.cannot_lend_to(link: str, ctx: &var TypeCtx): bool {
    val sig = unsafe { (*ctx.sigs).find_signature(link) } ?: return false
    if sig.params.is_empty() { return false }
    val wants_var = when (sig.params.at(0).kind) {
        RefTo(v, _) => v
        _ => false
    }
    if !wants_var || self.place_root_name().is_empty() { return false }
    return !self.place_is_mutable(ctx) && !self.lends_through_its_borrow(&self.ty, ctx)
}
