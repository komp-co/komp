import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.*
import kf_core.ast.expression.*
import kf_core.diagnostic.*
import kf_typecheck.check.check_expr
import kf_typecheck.check.mk_ctx
import kf_typecheck.types.type_eq

mutating fun TypeCtx.invalid_deref_option_type(): Type {
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    val sigs = self.sigs
    unsafe { sigs.insert_inst(GenericInst { mangled: String.from("Option__int32"), base: String.from("Option"), args: args }) }
    return Type { kind: TypeKind.Struct(intern("Option__int32")), provenance: Provenance.Inferred(no_span()) }
}

fun deref_test_check_in(ty: Type, ctx: &var TypeCtx): Type {
    ctx.declare_val(String.from("value"), ty)
    val inner: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *inner = Expr.new(no_span(), ExprKind.Variable(intern("value"))) }
    var expr = Expr.new(no_span(), ExprKind.Deref(inner))
    check_expr(&var expr, ctx)
    return expr.ty
}

fun invalid_deref_check(ty: Type): TypeCtx {
    var ctx = mk_ctx()
    val _result = deref_test_check_in(ty, &var ctx)
    return ctx
}

fun TypeCtx.invalid_deref_count(): uint64 {
    return unsafe { (*self.diags).size() }
}

fun TypeCtx.invalid_deref_first_message(): String {
    val diagnostic = unsafe { *(*self.diags).at(0) }
    return diagnostic.primary.message
}

@test fun test_invalid_deref_option_emits_one_diagnostic(): void {
    var setup = mk_ctx()
    val ty = setup.invalid_deref_option_type()
    val _result = deref_test_check_in(ty, &var setup)
    assert_eq(setup.invalid_deref_count(), 1, "Option dereference is rejected")
}

@test fun test_invalid_deref_struct_emits_one_diagnostic(): void {
    val ty = Type { kind: TypeKind.Struct(intern("Widget")), provenance: Provenance.Inferred(no_span()) }
    val ctx = invalid_deref_check(ty)
    assert_eq(ctx.invalid_deref_count(), 1, "struct dereference is rejected")
}

@test fun test_invalid_deref_names_the_source_type(): void {
    var setup = mk_ctx()
    val ty = setup.invalid_deref_option_type()
    val _result = deref_test_check_in(ty, &var setup)
    val expected = "cannot dereference `int32?`: `*` applies only to a pointer, box, or borrow"
    assert_eq(setup.invalid_deref_first_message().as_str(), expected, "the diagnostic uses source type syntax")
}

@test fun test_invalid_deref_keeps_poison_silent(): void {
    val ctx = invalid_deref_check(Type.new_poison())
    assert_eq(ctx.invalid_deref_count(), 0, "an earlier type error does not cascade")
}

@test fun test_valid_deref_pointer_returns_pointee(): void {
    var ctx = mk_ctx()
    val result = deref_test_check_in(Type.new_ptr(Type.new_int32(no_span()), no_span()), &var ctx)
    assert_eq(result.type_eq(Type.new_int32(no_span())), true, "raw-pointer dereference returns its pointee type")
}

// `&*p` and `&var *p` become references.

fun int_ty(): Type {
    return Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) }
}

fun ptr_to_int(): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = int_ty() }
    return Type { kind: TypeKind.PtrTo(p), provenance: Provenance.Inferred(no_span()) }
}

mutating fun Expr.borrow_written_deref_in(written: uint8): void {
    var ctx = mk_ctx()
    self.borrow_written_deref(written, &var ctx)
}

fun checked_deref_of_p(): Expr {
    var p = Expr.new(no_span(), ExprKind.Variable(intern("p")))
    p.ty = ptr_to_int()
    val pp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *pp = p }
    var e = Expr.new(no_span(), ExprKind.Deref(pp))
    e.ty = int_ty()
    return e
}

fun Type.ref_mutability(): int32 {
    return when (self.kind) {
        RefTo(is_mut, _) => if is_mut { 1 } else { 0 }
        _ => 0 - 1
    }
}

@test fun a_written_borrow_of_a_deref_is_the_pointer_as_a_reference(): void {
    var e = checked_deref_of_p()
    e.borrow_written_deref_in(coerce_written_amp_var())
    var is_p = false
    when (e.kind) {
        Variable(name) => { is_p = name.as_str() == "p" }
        _ => { }
    }
    assert_eq(is_p, true, "the node is the pointer again")
    assert_eq(e.ty.ref_mutability(), 1, "typed `&var int32`, as written")
    assert_eq(e.coerce, coerce_none(), "and needs no address taken")
}

@test fun a_shared_borrow_stays_shared(): void {
    var e = checked_deref_of_p()
    e.borrow_written_deref_in(coerce_written_amp())
    assert_eq(e.ty.ref_mutability(), 0, "`&*p` is `&int32`")
}

@test fun a_plain_deref_is_left_alone(): void {
    var e = checked_deref_of_p()
    e.borrow_written_deref_in(coerce_none())
    var still_deref = false
    when (e.kind) {
        Deref(_) => { still_deref = true }
        _ => { }
    }
    assert_eq(still_deref, true, "`*p` reads the value")
    assert_eq(e.ty.ref_mutability(), 0 - 1, "and is typed as the value")
}
