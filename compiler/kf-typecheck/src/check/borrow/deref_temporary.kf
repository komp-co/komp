// `*` through a `Box` a call's result owns. The result is a temporary, freed
// when the statement ends, so a value read out of its box dangles after that.

import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.diagnostic.lint_at
import kf_core.span.*

/// Reports `*f().b` and `*f()` where the operand is a `Box` owned by the call.
pub fun lint_deref_through_temporary(operand: &Expr, span: Span, ctx: &var TypeCtx): void {
    when (operand.ty.kind) {
        BoxOf(_) => { }
        _ => return
    }
    if !is_owned_by_a_call_result(operand) { return }
    var message = String.from("`*` reads through a `Box` owned by a temporary, which is freed at the end of ")
    message.append("this statement; bind the call's result to a local first")
    ctx.emit(lint_at("deref_through_temporary", span, message))
}

/// A call's result held by value, or a field of one: a borrow or a pointer
/// result owns nothing, so reading through it is not reading a temporary.
fun is_owned_by_a_call_result(e: &Expr): bool {
    when (e.kind) {
        Call(_, _) => return type_is_held_by_value(&e.ty)
        Intrinsic(_, _) => return type_is_held_by_value(&e.ty)
        CallValue(_callee, _) => return type_is_held_by_value(&e.ty)
        MethodCall(_, _, _) => return type_is_held_by_value(&e.ty)
        FieldAccess(obj_ptr, _) => return is_owned_by_a_call_result(unsafe { &*obj_ptr })
        _ => return false
    }
}

fun type_is_held_by_value(t: &Type): bool {
    when (t.kind) {
        RefTo(_, _) => return false
        PtrTo(_) => return false
        StrTy => return false
        Poison => return false
        _ => return true
    }
}
