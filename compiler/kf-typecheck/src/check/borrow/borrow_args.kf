import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.type_eq
import kf_typecheck.check.place_is_mutable
import kf_typecheck.check.immutable_val_field
import kf_typecheck.check.expect_arg
import kf_typecheck.check.promote_subscript_to_mut
import kf_typecheck.check.pin_open_binding

pub struct ArgCoerceResult {
    pub val coerced: bool
    pub val valid: bool
}

pub fun Expr.borrow_place_is_stable(): bool {
    when (self.kind) {
        Variable(_) => return true
        Deref(_) => return true
        FieldAccess(base, _) => return borrow_place_is_stable(unsafe { *base })
        DynCoerce(inner, _) => return borrow_place_is_stable(unsafe { *inner })
        MethodCall(_, _, _) => {
            when (self.ty.kind) {
                RefTo(_, _) => return true
                PtrTo(_) => return true
                _ => return false
            }
        }
        Call(_, _) => {
            when (self.ty.kind) {
                RefTo(_, _) => return true
                PtrTo(_) => return true
                _ => return false
            }
        }
        _ => return false
    }
}

pub fun Expr.emit_mutable_borrow_place_error(ctx: &var TypeCtx): void {
    val label = new_label(self.span, String.from("automatic mutable borrowing requires a place expression"))
    ctx.emit(new_diagnostic(Severity.Error, label))
}

pub fun Expr.emit_immutable_borrow_error(ctx: &var TypeCtx): void {
    // A `val` field is named first: advising `var` on an already-`var` root
    // would fix nothing.
    val field = self.immutable_val_field(ctx)
    if !field.as_str().equals("") {
        val label = new_label(self.span, "cannot mutably borrow field `${field}"
            + String.from("`: it is declared `val`; declare it `var`"))
        ctx.emit(new_diagnostic(Severity.Error, label))
        return
    }
    val label = new_label(self.span, String.from("cannot mutably borrow an immutable place; declare its root with `var` or use `&T`"))
    ctx.emit(new_diagnostic(Severity.Error, label))
}

fun Expr.emit_pointer_is_not_a_reference(mutable: bool, ctx: &var TypeCtx): void {
    val want = if mutable { "&var " } else { "&" }
    val how = "write `${want}*p` inside `unsafe` to vouch that it points at a live value"
    val message = "a raw pointer is not a reference: ${how}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
}

pub fun coerce_call_arg(args: &var List<Expr>, idx: uint64, to: Type, ctx: &var TypeCtx): ArgCoerceResult {
    if idx >= args.size() {
        return ArgCoerceResult { coerced: false, valid: false }
    }
    // An open binding at its first use takes the parameter's type first.
    val _typed_by_slot = args.at_mut(idx).pin_open_binding(to.clone(), ctx)
    // Read through a borrow; the one mutation goes through `at_mut`.
    val arg = args.at(idx)
    when (to.kind) {
        RefTo(mutable, inner) => {
            val pointee = unsafe { *inner }
            // A raw pointer has the reference ABI but not its promise of a live
            // value, and a store through a reference drops what it overwrites,
            // so the caller must say which it holds.
            when (arg.ty.kind) {
                PtrTo(actual) => {
                    if type_eq(unsafe { *actual }, pointee) {
                        arg.emit_pointer_is_not_a_reference(mutable, ctx)
                        return ArgCoerceResult { coerced: true, valid: true }
                    }
                }
                BoxOf(actual) => {
                    if type_eq(unsafe { *actual }, pointee) {
                        return ArgCoerceResult { coerced: true, valid: true }
                    }
                }
                RefTo(actual_mutable, actual) => {
                    if type_eq(unsafe { *actual }, pointee) {
                        if !mutable || actual_mutable {
                            return ArgCoerceResult { coerced: true, valid: true }
                        }
                    }
                }
                _ => {}
            }
            if arg.ty.type_eq(pointee) {
                if mutable && !arg.borrow_place_is_stable() {
                    arg.emit_mutable_borrow_place_error(ctx)
                    return ArgCoerceResult { coerced: false, valid: false }
                }
                if mutable && !arg.place_is_mutable(ctx) && !promote_subscript_to_mut(args.at_mut(idx), ctx) {
                    arg.emit_immutable_borrow_error(ctx)
                    return ArgCoerceResult { coerced: false, valid: false }
                }
                args.at_mut(idx).coerce = coerce_addr_of()
                return ArgCoerceResult { coerced: true, valid: true }
            }
        }
        _ => {}
    }
    val applied = expect_arg(args, idx, to, ctx)
    return ArgCoerceResult { coerced: applied, valid: true }
}
