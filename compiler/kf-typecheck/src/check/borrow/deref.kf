import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_core.span.*
import kf_core.ast.types.type_node
import kf_typecheck.types.display_type
import kf_typecheck.check.promote_subscript_to_mut

/// Raw pointer, box or borrow only. Poison propagates silently.
pub fun check_deref(inner: Expr, span: Span, ctx: &var TypeCtx): Type {
    if inner.ty.is_poison() { return Type.new_poison() }
    when (inner.ty.kind) {
        PtrTo(inner_ptr) => return unsafe { *inner_ptr }
        BoxOf(inner_ptr) => return unsafe { *inner_ptr }
        RefTo(_, inner_ptr) => return unsafe { *inner_ptr }
        _ => {
            val rendered = inner.ty.display_type(ctx)
            val message = "cannot dereference `${rendered.as_str()}`: `*` applies only to a pointer, box, or borrow"
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
            return Type.new_poison()
        }
    }
}

/// `&*p` / `&var *p`: the author vouches `p` points at a live value. The node
/// becomes the pointer again, typed as the written reference; a shared borrow
/// never becomes mutable. `written` is the parser's tag.
pub mutating fun Expr.borrow_written_deref(written: uint8, ctx: &var TypeCtx): void {
    if written != coerce_written_amp() && written != coerce_written_amp_var() { return }
    // `&var xs[i]` borrows through `IndexMut`.
    if written == coerce_written_amp_var() { val _ = self.promote_subscript_to_mut(ctx) }
    var operand = Expr.new_poison(self.span)
    when (self.kind) {
        Deref(inner_ptr) => { operand = unsafe { *inner_ptr } }
        _ => return
    }
    // A non-int32 offset types as poison, so the pointee type is supplied here.
    if self.ty.is_poison() { self.ty = operand.offset_pointee() }
    if self.ty.is_poison() { return }
    var mutable = written == coerce_written_amp_var()
    when (operand.ty.kind) {
        RefTo(is_mut, _) => { mutable = mutable && is_mut }
        _ => { }
    }
    val pointee = type_node(self.ty)
    operand.ty = Type { kind: TypeKind.RefTo(mutable, pointee), provenance: Provenance.Inferred(self.span) }
    operand.coerce = coerce_none()
    (*self) = operand
}

/// The pointee of `ptr + n` / `ptr - n`, or poison.
fun Expr.offset_pointee(): Type {
    when (self.kind) {
        Binary(l, op, _r) => {
            when (op) {
                Add => { }
                Sub => { }
                _ => return Type.new_poison()
            }
            when (unsafe { l.ty.kind }) {
                PtrTo(pointee) => return unsafe { *pointee }
                _ => return Type.new_poison()
            }
        }
        _ => return Type.new_poison()
    }
}
