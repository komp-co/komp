// Place mutability and trait-bound helpers.

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.traits.trait_method_in

// Unknown or poison shapes answer true, so a type error never cascades into
// a mutability error.
pub fun Expr.place_is_mutable(ctx: &var TypeCtx): bool {
    val k = self.kind
    when (k) {
        Variable(name) => {
            val ty = ctx.lookup(name.as_str())
            if ty.is_poison() { return true }
            when (ty.kind) {
                RefTo(v, _) => return v
                PtrTo(_) => return true
                _ => {}
            }
            return ctx.lookup_is_var(name.as_str())
        }
        Deref(ip) => {
            val ity = unsafe { ip.ty }
            if ity.is_poison() { return true }
            when (ity.kind) {
                RefTo(v, _) => return v
                // Raw pointer and Box derefs are permissive: they back unsafe
                // in-place mutation. A computed pointer is too.
                PtrTo(_) => return true
                BoxOf(_) => return true
                _ => return true
            }
        }
        FieldAccess(bp, fname) => {
            // A `val` field is never writable, whatever its owner.
            if !field_is_var(place_type(unsafe { *bp }, ctx), fname, ctx) { return false }
            // Through a reference base, mutability is the reference's.
            val bty = unsafe { bp.ty }
            if bty.is_poison() { return true }
            when (bty.kind) {
                RefTo(v, _) => return v
                PtrTo(_) => return true
                BoxOf(_) => return true
                _ => {}
            }
            return place_is_mutable(unsafe { *bp }, ctx)
        }
        MethodCall(_, _, _) => return self.ty.result_is_mutable_place()
        Call(_, _) => return self.ty.result_is_mutable_place()
        DynCoerce(_, _) => return self.ty.result_is_mutable_place()
        _ => return false
    }
}

/// `name` is declared `var` on the struct `base` names. True whenever this
/// cannot be answered.
///
/// CONSTRAINT: the base is followed through reference, pointer or box first.
fun Type.field_is_var(name: Sym, ctx: &var TypeCtx): bool {
    var t = self
    when (t.kind) {
        RefTo(_, inner) => t = unsafe { *inner }
        PtrTo(inner) => t = unsafe { *inner }
        BoxOf(inner) => t = unsafe { *inner }
        _ => {}
    }
    if t.is_poison() { return true }
    val is_struct = when (t.kind) {
        Struct(_) => true
        _ => false
    }
    if !is_struct { return true }
    // By its declared name, as a field read finds it: a call's result carries
    // the canonical identity.
    val sname = t.kind.struct_name()
    val layout = unsafe { (*ctx.sigs).find_struct(sname.as_str(), ctx.owner_crate) } ?: return true
    while f in &layout.fields {
        if f.name.as_str().equals(name.as_str()) { return f.is_var }
    }
    return true
}

/// CONSTRAINT: prefers the binding over the node: a Variable's `ty` is not
/// reliably set (`var s = make()` leaves it poison).
fun Expr.place_type(ctx: &var TypeCtx): Type {
    val t = self.ty
    if !t.is_poison() { return t }
    val k = self.kind
    when (k) {
        Variable(name) => return ctx.lookup(name.as_str())
        _ => {}
    }
    return t
}

/// The `val` field making this place immutable, or "".
/// CONSTRAINT: the outermost one, which is the write being attempted.
pub fun Expr.immutable_val_field(ctx: &var TypeCtx): String {
    val k = self.kind
    when (k) {
        FieldAccess(bp, fname) => {
            if !field_is_var(place_type(unsafe { *bp }, ctx), fname, ctx) { return fname.as_string() }
            return immutable_val_field(unsafe { *bp }, ctx)
        }
        Deref(ip) => return immutable_val_field(unsafe { *ip }, ctx)
        _ => return ""
    }
}

// A call result is a place only as a reference: `at_mut`'s `&var` is
// writable, `at`'s `&` is not, and a by-value result is a temporary.
fun Type.result_is_mutable_place(): bool {
    return when (self.kind) {
        RefTo(v, _) => v
        PtrTo(_) => true
        _ => false
    }
}

// "" when the root is not a variable. A `self` root's fix is `mutating`.
fun Expr.place_root_name(): String {
    val k = self.kind
    return when (k) {
        Variable(name) => name.as_string()
        Deref(ip) => place_root_name(unsafe { *ip })
        FieldAccess(bp, _) => place_root_name(unsafe { *bp })
        _ => ""
    }
}

fun emit_immutable_recv_err(method_name: String, recv: &Expr, span: Span, ctx: &var TypeCtx): void {
    // A `val` field first: neither `var` nor `mutating` would fix it.
    val field = recv.immutable_val_field(ctx)
    if !field.as_str().equals("") {
        val lab = new_label(span, "mutating method `${method_name}"
            + String.from("` needs a mutable receiver, and field `") + field.clone()
            + String.from("` is declared `val`; declare it `var`"))
        ctx.emit(new_diagnostic(Severity.Error, lab))
        return
    }
    val root = recv.place_root_name()
    // `self` before the parameter branch: its fix is `mutating`.
    if root.as_str().equals("self") {
        val lab = new_label(span, "cannot call mutating method `${method_name}` on `self` here; mark the enclosing method `mutating`")
        ctx.emit(new_diagnostic(Severity.Error, lab))
        return
    }
    // A parameter's fix is in its type, not `var`.
    if ctx.is_param(root.as_str()) {
        val plab = new_label(span, "mutating method `${method_name}"
            + String.from("` needs a mutable receiver, and `") + root.clone()
            + String.from("` is a by-value parameter; take it as `&var`"))
        ctx.emit(new_diagnostic(Severity.Error, plab))
        return
    }
    val lab = new_label(span, "mutating method `${method_name}` needs a mutable receiver; declare `${root}` with `var` (or borrow with `&var`)")
    ctx.emit(new_diagnostic(Severity.Error, lab))
}

// Mirrors check_method_call's dispatch; false when unresolvable, since the
// dispatch reports that itself.
fun Type.method_is_mutating(method_name: String, arity: uint64, ctx: &var TypeCtx): bool {
    if self.is_poison() { return false }
    val m = method_name.as_str()
    when (self.kind) {
        // Named against the pointee.
        PtrTo(p) => return method_is_mutating(unsafe { *p }, method_name.clone(), arity, ctx)
        BoxOf(p) => return method_is_mutating(unsafe { *p }, method_name.clone(), arity, ctx)
        RefTo(_, p) => return method_is_mutating(unsafe { *p }, method_name.clone(), arity, ctx)
        Struct(n) => {
            // By its declared name: a field's type carries the canonical identity.
            val sname = self.kind.struct_name()
            if name_starts_with(sname.clone(), "List__") {
                // Synthesized container methods are not in the sig table.
                // `at_mut` hands out `&var`, so it needs a mutable receiver.
                return when m {
                    "push" => true
                    "set" => true
                    "pop" => true
                    "at_mut" => true
                    _ => false
                }
            }
            if m.equals("call") {
                val trait_name = call_trait_name(arity, true)
                if unsafe { (*ctx.sigs).identity_implements_any(n, trait_name.as_str()) } { return true }
            }
            val mangled = sname + String.from("_") + method_name
            val direct = unsafe { (*ctx.sigs).find_signature(mangled.as_str()) }
            if direct.is_some() {
                val sig = direct ?: return false
                return sig.is_mutating
            }
            val base = mangle_base_name(sname)
            if base.as_str().equals("") { return false }
            val sig = unsafe { (*ctx.sigs).find_signature((base + String.from("_") + method_name).as_str()) } ?: return false
            return sig.is_mutating
        }
        _ => return false
    }
}

// For the trait-impl registry: `Pair__int32` is `Pair`; "" (poison, generic
// parameter, reference) means bound checks skip.
pub fun Type.ty_base_name(): String {
    return when (self.kind) {
        Struct(n) => mangle_base_name(n.as_string())
        EnumTy(n) => mangle_base_name(n.as_string())
        StrTy => String.from("str")
        Int8 => String.from("int8")
        Int16 => String.from("int16")
        Int32 => String.from("int32")
        Int64 => String.from("int64")
        UInt8 => String.from("uint8")
        UInt16 => String.from("uint16")
        UInt32 => String.from("uint32")
        UInt64 => String.from("uint64")
        Float32 => String.from("float32")
        Float64 => String.from("float64")
        Bool => String.from("bool")
        Char => String.from("char")
        _ => ""
    }
}

// `Pair__int32__String` is `Pair`.
pub fun mangle_base_name(n: String): String {
    val s = n.as_str()
    val len = s.byte_len()
    var i: uint64 = 0
    while i + 1 < len {
        val d0 = s.byte_at(i)
        val d1 = s.byte_at(i + 1)
        if d0 == 95 && d1 == 95 {
            return s.substring(0, i)
        }
        i = i + 1
    }
    return n
}

// Raw `str` equality is a runtime comparison, not a method call; other
// primitives use core's trait impls.
fun ty_satisfies_intrinsically(base: str, trait_name: str, ctx: &var TypeCtx): bool {
    return base == "str" && trait_name == ctx.lang_trait_name(lang_equal_key()).as_str()
}

pub fun check_generic_bounds(owner: String, param: String, bound_ty: &Type, span: Span, ctx: &var TypeCtx): void {
    val no_names = List.new<String>()
    val no_tys = List.new<Type>()
    check_generic_bounds_env(owner, param, bound_ty, &no_names, &no_tys, span, ctx)
}

/// With the caller's other bindings, so a bound's trait arguments can be
/// substituted first.
fun check_generic_bounds_env(owner: String, param: String, bound_ty: &Type, gnames: &List<String>, bound_tys: &List<Type>, span: Span, ctx: &var TypeCtx): void {
    val base = bound_ty.ty_base_name()
    // A generic binding propagates: the caller's `U` must carry the bound
    // itself.
    var gbind = ""
    when (bound_ty.kind) {
        Generic(gn) => { gbind = gn.as_string() }
        _ => {}
    }
    // A type with no base name cannot be judged by name, so only Copy — which
    // answers for the builtin wrappers itself — is checked on one.
    val unjudged = base.as_str().equals("") && gbind.as_str().equals("")
    val copy_name = ctx.lang_trait_name(lang_copy_key())
    val sp = ctx.sigs
    val nb = unsafe { sp.bounds.size() }
    var i = 0
    while i < nb {
        val b = unsafe { *sp.bounds.at(i) }
        if b.owner.as_str().equals(owner.as_str()) {
            if b.param.as_str().equals(param.as_str()) {
                if !gbind.as_str().equals("") {
                    if !owner_has_bound(ctx.fn_owner.clone(), gbind.clone(), b.trait_name.clone(), ctx) {
                        val lab = new_label(span, String.from("type parameter `") + gbind.clone() + String.from("` does not carry bound `") + b.trait_name.clone() + String.from("` (required by `") + param.clone() + String.from(": ") + b.trait_name.clone() + String.from("` on `") + unsafe { (*sp).surface_name(owner.as_str()) } + String.from("`); add it: `") + gbind.clone() + String.from(": ") + b.trait_name.clone() + String.from("`"))
                        ctx.emit(new_diagnostic(Severity.Error, lab))
                    }
                } else if unjudged && !b.trait_name.as_str().equals(copy_name.as_str()) {
                } else if !bound_type_implements_here(bound_ty, b.trait_name.as_str(), subst_trait_args(b.trait_args.as_str(), gnames, bound_tys, false), gnames, span, ctx) {
                    // A nonexistent trait is reported at the declaration, not
                    // at every call.
                    val trait_exists = !unsafe { sp.find_trait(b.trait_name.as_str()) }.is_none()
                    if trait_exists && !ty_satisfies_intrinsically(base.as_str(), b.trait_name.as_str(), ctx) {
                        // Rendered with its arguments (`From<str>`).
                        var tshow = b.trait_name.clone()
                        if !b.trait_args.as_str().equals("") {
                            tshow = tshow + String.from("<") + projection_mangle_display(b.trait_args.as_str()) + String.from(">")
                        }
                        val lab = new_label(span, String.from("type `") + bound_ty.display_type(ctx) + String.from("` does not implement trait `") + tshow.clone() + String.from("` (required by bound `") + param.clone() + String.from(": ") + tshow.clone() + String.from("` on `") + unsafe { (*sp).surface_name(owner.as_str()) } + String.from("`)"))
                        ctx.emit(new_diagnostic(Severity.Error, lab))
                    }
                }
            }
        }
        i = i + 1
    }
}

// Delegates to the single-binding check; substituting the whole environment
// is not done yet.
fun check_generic_bounds_with_bindings(owner: String, param: String, bound_ty: Type, gnames: &List<String>, bound_tys: &List<Type>, span: Span, ctx: &var TypeCtx): void {
    check_generic_bounds_env(owner, param, &bound_ty, gnames, bound_tys, span, ctx)
}

/// Only whether some impl exists; `impl_args_agree` checks the arguments.
pub fun Type.bound_type_implements(trait_name: str, sigs: Ptr<SigTable>): bool {
    return when (self.kind) {
        Struct(identity) => unsafe { sigs.identity_implements_any(identity, trait_name) }
        _ => unsafe { sigs.type_implements_any(self.ty_base_name().as_str(), trait_name) }
    }
}

// "No trait method found".
pub fun ARITY_NOT_FOUND(): uint64 { return 999999 }
