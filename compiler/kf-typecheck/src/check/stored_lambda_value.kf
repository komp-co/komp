import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic

fun Type.type_is_stored_lambda(ctx: &var TypeCtx): bool {
    when (self.kind) {
        Struct(identity) => {
            var i = 0
            while i < unsafe { (*ctx.sigs).stored_lambda_types.size() } {
                if unsafe { (*ctx.sigs).stored_lambda_types.get(i).id == identity.id } { return true }
                i = i + 1
            }
        }
        _ => { }
    }
    return false
}

fun Expr.reject_stored_lambda_transfer(position: str, ctx: &var TypeCtx): bool {
    if !self.ty.type_is_stored_lambda(ctx) { return false }
    val lab = new_label(self.span, "a stored lambda cannot be moved into ${position} yet; invoke the local directly")
    ctx.emit(new_diagnostic(Severity.Error, lab))
    return true
}
