// Free-function calls and enum-variant construction.

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.str_list_has
import kf_typecheck.check.borrow.coerce_call_arg
import kf_typecheck.check.borrow.may_keep_argument
import kf_typecheck.check.borrow.reject_kept_temporary
import kf_typecheck.note_import_use_named
import kf_typecheck.check.control.yield_ref_binder_value

/// `annotated<a>()` is replaced by the list it queries.
mutating fun Expr.check_intrinsic(intrinsic: Intrinsic, args: &var List<Expr>, ctx: &var TypeCtx): void {
    when (intrinsic) {
        Annotated => self.expand_annotated(args, ctx)
        _ => self.ty = intrinsic.call_type(args, self.type_args, self.span, ctx)
    }
}

/// `alloc<T>()`, `sizeof<T>()`, `take<T>(x)` and friends.
fun Intrinsic.call_type(args: &var List<Expr>, type_args: &var List<TypeRef>, span: Span, ctx: &var TypeCtx): Type {
    if self.report_arity(args.size(), span, ctx) { return Type.new_poison() }
    val type_argument = self.type_argument(type_args, span, ctx)
    if type_args.size() != 1 { return Type.new_poison() }
    return when (self.result()) {
        PointerToTypeArgument => Type.new_ptr(type_argument, span)
        TypeArgument => {
            // `ptr_read<T>(p)`: the pointee, moved out bitwise and owned by
            // the caller.
            when (self) {
                PtrRead => check_expr(args.at_mut(0), ctx)
                _ => { }
            }
            type_argument
        }
        FirstArgument => {
            val ta = args.at_mut(0)
            check_expr(ta, ctx)
            // `take<List<Stmt>>(body)` on a reference binder moves the payload.
            val _read = ta.yield_ref_binder_value(&type_argument, ctx)
            ta.ty.clone()
        }
        SizeInBytes => Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(span) }
        Nothing => Type.new_void(span)
        Query => Type.new_poison()
    }
}

fun check_call(name: String, args: &var List<Expr>, type_args: &var List<TypeRef>, span: Span, ctx: &var TypeCtx): Type {
    // Taken before the arguments, whose own calls are not through the alias.
    val through = ctx.through_module
    ctx.through_module = Sym { id: 0 }
    // Arguments first, in place: a nested receiver needs its type even when
    // the callee does not resolve.
    report_annotated_lambda_call_args(String.from(name.as_str()), args, span, ctx)
    var arg_tys = type_call_arguments(args, ctx)
    // Runtime intrinsics are not in the sig table.
    val rt = runtime_intrinsic_ret(name, span, ctx.string_name())
    val rt_poison = rt.is_poison() || through.id != 0
    if !rt_poison {
        // `read_file(path: str)` is often given a String; coerced here since the
        // sig-table path is skipped.
        when name.as_str() {
            "read_file" => expect_arg(args, 0, Type.new_str(span), ctx)
            "kf_file_hash" => expect_arg(args, 0, Type.new_str(span), ctx)
            "write_file" => {
                expect_arg(args, 0, Type.new_str(span), ctx)
                expect_arg(args, 1, Type.new_str(span), ctx)
            }
            "panic" => expect_arg(args, 0, Type.new_str(span), ctx)
            _ => { }
        }
        return rt
    }
    val found_sig = unsafe { (*ctx.sigs).lookup_callee(name.as_str(), through, ctx.owner_file, ctx.owner_crate, ctx.owner_module) }
    if found_sig.is_none() {
        if through.id != 0 {
            report_not_in_module(name.as_str(), through, false, span, ctx)
        } else {
            report_unknown_callee(name.as_str(), span, ctx)
        }
        return Type.new_poison()
    }
    val sig = found_sig ?: return Type.new_poison()
    if through.id != 0 && !sig.is_pub && sig.owner_module.id != ctx.owner_module.id {
        report_not_in_module(name.as_str(), through, true, span, ctx)
        return Type.new_poison()
    }
    val sigs = unsafe { &*ctx.sigs }
    // A renamed export is called by the name its file writes; the call
    // names the function itself.
    val qualified = if sigs.has_generic_twin(&sig) {
        crate_qualified_generic(sig.owner_crate, sig.name.as_str())
    } else if !sig.name.as_str().equals(name.as_str()) {
        sig.name.clone()
    } else {
        String.from("")
    }
    val pinned = sigs.pinned_link_name(&sig)
    ctx.qualified_callee = qualified
    ctx.pinned_callee = pinned
    // Marks the import used, outside the lookup so the lookup stays pure. The
    // written name lets the import be suggested narrower.
    val written_name = callee_surface_name(name.as_str(), ctx.sigs)
    note_import_use_named(ctx.sigs, ctx.owner_file, sig.owner_module, intern(written_name.as_str()))
    if args.size() != sig.params.size() {
        ctx.emit(new_diagnostic(Severity.Error, new_label(span, "wrong number of arguments to `${callee_surface_name(name.as_str(), ctx.sigs)}`: expected ${sig.params.size()}, found ${args.size()}")))
        return Type.new_poison()
    }
    expect_lambda_call_args(String.from(name.as_str()), &sig, args, &var arg_tys, span, ctx)
    // Every declared generic binds from the argument at a matching parameter
    // position (poison: unbound). Sigs without declared generics fall back to
    // the names in the params.
    var gnames = List.new<String>()
    while item in &sig.generics {
        gnames.push(item)
    }
    if gnames.size() == 0 {
        while sp0 in &sig.params {
            if sp0.kind.kind_tag() == TAG_GENERIC() {
                val gn0 = sp0.kind.generic_name()
                if !str_list_has(gnames, gn0.as_str()) {
                    gnames.push(gn0)
                }
            }
        }
    }
    if !check_generic_arg_kinds(sig.name.as_str(), &gnames, type_args, ctx) { return Type.new_poison() }
    var inf_tys = List.new<Type>()
    // The argument each inferred parameter was read from, for the message
    // when another argument disagrees.
    var inf_from = List.new<uint64>()
    var g0 = 0
    while g0 < gnames.size() {
        val gname = *gnames.at(g0)
        var bound = Type.new_poison()
        // An explicit type argument wins, and must substitute before
        // coerce_call_arg so the argument is auto-borrowed.
        if g0 < type_args.size() {
            bound = (*type_args.at(g0)).resolve_type_ref(ctx)
        }
        var from = arg_tys.size()
        if bound.is_poison() {
            while k in 0..sig.params.size() {
                if k >= arg_tys.size() { break }
                val sp = *sig.params.at(k)
                val at0 = *arg_tys.at(k)
                // Through `&`, `Ptr` and `Box`; see bind_generic_from_param.
                val cand = sp.bind_generic_from_param(&at0, gname.as_str(), ctx)
                if !cand.is_poison() {
                    bound = cand
                    from = k
                    break
                }
            }
        }
        inf_tys.push(bound)
        inf_from.push(from)
        g0 = g0 + 1
    }
    if type_args.size() == 0 { infer_from_bounds(name.as_str(), &gnames, &var inf_tys, span, ctx) }
    var saw_error = false
    while j in 0..arg_tys.size() {
        var expected = *sig.params.at(j)
        var s0 = 0
        while s0 < gnames.size() {
            val ity = *inf_tys.at(s0)
            if !ity.is_poison() {
                expected = expected.subst_generic(*gnames.at(s0), ity.clone())
            }
            s0 = s0 + 1
        }
        val kept = sig.may_keep_argument(j)
        if kept && args.at(j).reject_kept_temporary(&expected, name.as_str(), ctx) {
            saw_error = true
            continue
        }
        val outcome = coerce_call_arg(args, j, expected.clone(), ctx)
        // After the coercion, which may have typed an open binding; a lambda
        // still waiting on its bound stays poison.
        val at = if arg_tys.at(j).is_poison() { Type.new_poison() } else { args.at(j).ty.clone() }
        if !outcome.valid {
            saw_error = true
        } else if !outcome.coerced && !at.type_eq(expected) && !ctx.fits(at, expected) {
            saw_error = true
            val decided = decided_by_argument(sig.params.at(j), &gnames, &inf_from, j, arg_tys.size())
            var message = "wrong type for argument ${j + 1} of `${name.as_str()}`: expected `${expected.display_type(ctx)}`"
            if decided != null { message.append(", as argument ${(decided ?: 0) + 1} decided") }
            message.append(", found `${at.display_type(ctx)}`")
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
        }
    }
    if saw_error { return Type.new_poison() }
    // Resolved together, so bounds can substitute the whole environment.
    var bound_tys = List.new<Type>()
    while bi in 0..gnames.size() {
        if bi < type_args.size() {
            bound_tys.push((*type_args.at(bi)).resolve_type_ref(ctx))
        } else {
            bound_tys.push(*inf_tys.at(bi))
        }
    }
    // The return type is substituted from explicit type args (the only source
    // for a parameter used just in the return), then from inference.
    while gi in 0..gnames.size() {
        val binding = *bound_tys.at(gi)
        if !binding.is_poison() {
            check_generic_bounds_with_bindings(name.clone(), *gnames.at(gi), binding, &gnames, &bound_tys, span, ctx)
        }
    }
    var ret = subst_all_generics(sig.ret, &gnames, &bound_or_left(&gnames, &bound_tys))
    // Projections in the return type are resolved now, since this body uses
    // the result; a still-generic owner is left for the post-pass.
    ret = ret.resolved_projection_type("", ctx.sigs)
    // A generic function's return type is never written at the call site.
    ret.register_returned_instance(span, ctx)
    // CONSTRAINT: inferred bindings are written back as explicit type args,
    // since Mono materializes only from those. All-or-nothing, as they zip
    // positionally.
    if sig.generics.size() > 0 {
        if type_args.size() == 0 {
            var written = List.new<TypeRef>()
            var ok = true
            while inf_ty in &inf_tys {
                val tr = inf_ty.ty_written_ref(span, ctx.sigs)
                if tr.type_ref_is_poison() { ok = false }
                written.push(tr)
            }
            if ok {
                while item in &written {
                    type_args.push(item)
                }
            }
        }
    }
    return ret
}

/// The enum's name when `kind` names a registered enum and no local, or "".
fun try_get_enum_recv_name(kind: ExprKind, ctx: &var TypeCtx): String {
    when (kind) {
        Variable(written) => {
            if ctx.is_declared(written.as_str()) { return "" }
            val n = written.receiver_type_name(ctx)
            val ep = unsafe { (*ctx.sigs).find_enum(n.as_str(), ctx.owner_crate) }
            if ep.is_none() { return "" }
            return n.as_string()
        }
        _ => return ""
    }
}

fun check_variant_construction(enum_name: String, type_args: &var List<TypeRef>, variant_name: String, args: &var List<Expr>, span: Span, ctx: &var TypeCtx): Type {
    // Payloads are typed first so `Option.Some(value)` can infer from them.
    while ai in 0..args.size() {
        check_expr(args.at_mut(ai), ctx)
    }
    var use_args = clone_type_args(type_args)
    var inferred = false
    if use_args.size() == 0 {
        use_args = infer_enum_type_args(enum_name.clone(), variant_name.clone(), args, ctx)
        inferred = use_args.size() > 0
    }
    var concrete_name = enum_name.clone()
    if use_args.size() > 0 {
        val mangled = mangle_type_name(enum_name.as_str(), &use_args, ctx)
        concrete_name = String.from(mangled.as_str())
        instantiate_generic_layout(enum_name.clone(), &use_args, concrete_name.clone(), ctx)
        // Inferred args are written back as for a generic call;
        // Mono materializes only from explicit ones.
        if inferred {
            while use_arg in &use_args {
                type_args.push(use_arg)
            }
        }
    }
    val sp = ctx.sigs
    val layout = unsafe { sp.find_enum(concrete_name.as_str(), ctx.owner_crate) } ?: return Type.new_poison()
    // Uninferred: checked against the template, whose `Generic(T)` payloads
    // are not errors. rebind_template_ctor finishes once a slot is known.
    val against_template = use_args.size() == 0 && enum_is_generic(enum_name.clone(), ctx)
    while v in &layout.variants {
        if v.name.as_str().equals(variant_name.as_str()) {
            if args.size() != v.payloads.size() {
                // Against the template the count is an upper bound. A `void`
                // payload may be omitted (`Result<void, E>.Ok()`).
                val omitted_are_units = v.trailing_payloads_are_unit(args.size())
                if (!against_template || args.size() > v.payloads.size()) && !omitted_are_units {
                    emit_ctor_arity_err(enum_name.clone(), variant_name.clone(), v.payloads.size(), args.size(), span, ctx)
                    return Type.new_poison()
                }
            }
            var j = 0
            var saw_error = false
            while j < args.size() && j < v.payloads.size() {
                check_expr(args.at_mut(j), ctx)
                // A payload is a slot like any other: a bare `Option.None`
                // needs the expectation.
                if !expect_or_reject(args.at_mut(j), *v.payloads.at(j), ctx) {
                    saw_error = true
                    if !against_template {
                        emit_ctor_payload_err(enum_name.clone(), variant_name.clone(), j, *v.payloads.at(j), args.at(j).ty, span, ctx)
                    }
                }
                j = j + 1
            }
            if saw_error { return Type.new_poison() }
            return Type { kind: TypeKind.EnumTy(intern(concrete_name.as_str())), provenance: Provenance.Inferred(no_span()) }
        }
    }
    emit_ctor_variant_err(enum_name.clone(), variant_name.clone(), span, ctx)
    return Type.new_poison()
}

fun enum_is_generic(enum_name: String, ctx: &var TypeCtx): bool {
    val gi = unsafe { (*ctx.sigs).find_generic_info(enum_name.as_str(), ctx.owner_crate) } ?: return false
    return gi.type_params.size() > 0
}

fun emit_ctor_arity_err(enum_name: String, variant: String, want: uint64, got: uint64, span: Span, ctx: &var TypeCtx): void {
    val want_s = "${want}"
    val got_s = "${got}"
    val msg = "variant `${enum_name.as_str()}.${variant.as_str()}` takes ${want_s.as_str()} payload(s), found ${got_s.as_str()}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

fun emit_ctor_payload_err(enum_name: String, variant: String, idx: uint64, want: Type, got: Type, span: Span, ctx: &var TypeCtx): void {
    val idx_s = "${idx}"
    // A deferred projection's mangle must never reach a reader.
    val want_s = want.display_type(ctx)
    val got_s = got.display_type(ctx)
    val msg = "payload ${idx_s.as_str()} of `${enum_name.as_str()}.${variant.as_str()}` expects `${want_s.as_str()}`, found `${got_s.as_str()}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

fun emit_ctor_variant_err(enum_name: String, variant: String, span: Span, ctx: &var TypeCtx): void {
    val msg = "no variant `${variant.as_str()}` on `${enum_name.as_str()}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

// From payloads directly of a generic type (`Option<T>.Some(T)`), not nested
// ones.
fun infer_enum_type_args(enum_name: String, variant_name: String, args: &List<Expr>, ctx: &var TypeCtx): List<TypeRef> {
    var out = List.new<TypeRef>()
    val gi = unsafe { (*ctx.sigs).find_generic_info(enum_name.as_str(), ctx.owner_crate) } ?: return out
    val layout = unsafe { (*ctx.sigs).find_enum(enum_name.as_str(), ctx.owner_crate) } ?: return out
    while variant in &layout.variants {
        if variant.name.as_str().equals(variant_name.as_str()) {
            while param in &gi.type_params {
                var found = ""
                while ai in 0..variant.payloads.size() {
                    val payload = *variant.payloads.at(ai)
                    when (payload.kind) {
                        Generic(name) => {
                            if name.as_str().equals(param.as_str()) && ai < args.size() {
                                found = ty_flat_ref_name(args.at(ai).ty)
                            }
                        }
                        _ => { }
                    }
                }
                if found.as_str().equals("") { return List.new<TypeRef>() }
                out.push(TypeRef.new(no_span(), TypeRefKind.Named(intern(found.as_str()), List.new<TypeRef>())))
            }
            return out
        }
    }
    return out
}

/// Every remaining payload is `void`, which has no written form.
fun VariantInfo.trailing_payloads_are_unit(from: uint64): bool {
    if from > self.payloads.size() { return false }
    var i = from
    while i < self.payloads.size() {
        if self.payloads.at(i).kind.kind_tag() != TAG_VOID() { return false }
        i = i + 1
    }
    return true
}
