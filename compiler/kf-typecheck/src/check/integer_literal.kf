import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.check.control.yields_only_numeric_literals
import kf_typecheck.types.type_eq

fun is_integer_literal(e: &Expr): bool {
    when (e.kind) {
        LitInt(_) => return true
        Unary(op, inner) => {
            when (op) {
                Neg => {
                    val value = unsafe { *inner }
                    when (value.kind) {
                        LitInt(_) => return true
                        _ => return false
                    }
                }
                _ => return false
            }
        }
        _ => return false
    }
}

fun negative_integer_literal_magnitude(e: Expr): int64 {
    when (e.kind) {
        Unary(op, inner) => {
            when (op) {
                Neg => {
                    val value = unsafe { *inner }
                    when (value.kind) {
                        LitInt(magnitude) => return magnitude
                        _ => return -1
                    }
                }
                _ => return -1
            }
        }
        _ => return -1
    }
}

fun positive_integer_literal_fits(value: int64, expected: Type): bool {
    return when (expected.kind) {
        Int8 => value <= 127
        Int16 => value <= 32767
        Int32 => value <= 2147483647
        Int64 => true
        UInt8 => value <= 255
        UInt16 => value <= 65535
        UInt32 => value <= 4294967295
        UInt64 => true
        Float32 => true
        Float64 => true
        _ => false
    }
}

fun negative_integer_literal_fits(magnitude: int64, expected: Type): bool {
    return when (expected.kind) {
        Int8 => magnitude <= 128
        Int16 => magnitude <= 32768
        Int32 => magnitude <= 2147483648
        Int64 => true
        Float32 => true
        Float64 => true
        _ => false
    }
}

mutating fun Expr.reject_integer_literal(expected: Type, ctx: &var TypeCtx): void {
    val target = expected.ty_base_name()
    val message = "integer literal is out of range for `${target}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = Type.new_poison()
}

/// Its first use may choose its width.
pub fun is_numeric_literal(e: &Expr): bool {
    if is_integer_literal(e) { return true }
    return when (e.kind) {
        LitFloat(_) => true
        _ => false
    }
}

/// Takes the other operand's type.
fun Expr.operand_takes_other_type(ctx: &var TypeCtx): bool {
    if is_integer_literal(self) || self.yields_only_numeric_literals() { return true }
    when (self.kind) {
        // A literal's binding, not an open call's or a `null`'s.
        Variable(name) => {
            return ctx.open_init(name.as_str()).is_some() && is_numeric(self.ty)
        }
        _ => return false
    }
}

/// A numeric slot decides a number literal's binding: in place at its first
/// use, otherwise on the body's next check. True when it did, or when the
/// slot conflicts with what an earlier use decided.
mutating fun Expr.narrow_open_number(expected: Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    if name.byte_len() == 0 || !is_numeric(expected) { return false }
    val init_ptr = ctx.open_init(name.as_str()) ?: return self.conflicts_with_decision(expected, ctx)
    val init: &var Expr = unsafe { &var *init_ptr }
    if !is_numeric(self.ty) { return false }
    if self.decides_on_recheck(init.span, expected.clone(), ctx) { return true }
    if !self.ty.type_eq(expected) && !init.apply_expected(expected.clone(), ctx) { return false }
    ctx.decide_binding(name.as_str(), expected.clone(), self.span)
    self.ty = expected
    return true
}
