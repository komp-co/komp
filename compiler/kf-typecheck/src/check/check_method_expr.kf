import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.*
import kf_typecheck.check.borrow.coerce_call_arg
import kf_core.ast.subst.monomorphized_type_name

fun check_method_expr(e: &var Expr, recv_ptr: Ptr<Expr>, method_name_sym: Sym, args: &var List<Expr>, ctx: &var TypeCtx): void {
    val method_name = method_name_sym.as_string()
    // `String.of(&(self))` inside `Display.display` would recurse; this also
    // catches a `{self}` interpolation slot, which lowers to the same call.
    if ctx.defining_trait_method(ctx.lang_trait_name(lang_display_key()).as_str(), "display") {
        if method_name.as_str().equals("display") {
            if is_bare_self(&unsafe { *recv_ptr }) {
                emit_self_recursive_operator("\${self}", "display", "render the fields", e.span, ctx)
                e.ty = poison_ty()
                return
            }
        }
    }
    // `EnumName.VariantName(args)` parses as a MethodCall; checked before the
    // receiver is walked as a value.
    val recv_raw = receiver_naming_lang_types(recv_ptr, &method_name, ctx)
    if reject_self_recursive_render(&recv_raw, &method_name, args, e.span, ctx) {
        e.ty = poison_ty()
        return
    }
    // `Box.new(x)`: before the value-receiver path, so `Box` is not checked as
    // a Variable.
    if is_box_new_recv(recv_raw.kind, method_name) {
        if args.size() > 0 {
            val a0 = args.at_mut(0)
            check_expr(a0, ctx)
            a0.reject_stored_lambda_transfer("a box", ctx)
            e.ty = box_ty(a0.ty.clone(), e.span)
        } else {
            e.ty = poison_ty()
        }
    } else {
        // `Type.method(args)` for a `static fun` of the named type.
        var handled: bool = false
        // A variant wins a name it shares with a static, but only a real
        // variant: claiming every `Enum.name(...)` would make statics on enums
        // uncallable.
        val direct_enum = try_get_enum_recv_name(recv_raw.kind, ctx)
        if !direct_enum.as_str().equals("") {
            if enum_name_has_variant(direct_enum.clone(), method_name.clone(), ctx) {
                e.ty = check_variant_construction(direct_enum, &var e.type_args, method_name, args, e.span, ctx)
                e.is_variant_ctor = true
                handled = true
            }
        }
        val qualified_trait = trait_recv_name(recv_raw.kind, ctx)
        if !handled && !qualified_trait.as_str().equals("") {
            while ai in 0..args.size() {
                check_call_argument(args.at_mut(ai), ctx)
            }
            if args.size() > 0 && expected_is_dyn_ref(&(*args.at(0)).ty) {
                val lab = new_label(e.span, String.from("qualified calls on dynamic trait objects are not supported; call the method on the object value"))
                ctx.emit(new_diagnostic(Severity.Error, lab))
                e.ty = poison_ty()
                handled = true
            }
            val selected = qualified_trait_method_callee(qualified_trait.clone(), method_name.clone(), args, ctx)
            if !handled && !selected.as_str().equals("") {
                when (unsafe { (*ctx.sigs).find_signature(selected.as_str()) }) {
                    Some(sig) => {
                        var valid = sig.params.size() == args.size()
                        while qi in 0..args.size() {
                            val arg = args.at(qi)
                            val expected = *sig.params.at(qi)
                            if qi == 0 {
                                if !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) { valid = false }
                            } else {
                                val outcome = coerce_call_arg(args, qi, expected.clone(), ctx)
                                if !outcome.valid {
                                    valid = false
                                } else if !outcome.coerced && !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) {
                                    valid = false
                                }
                            }
                        }
                        if valid {
                            val receiver_arg = args.at_mut(0)
                            receiver_arg.coerce = coerce_addr_of()
                            e.ty = sig.ret
                            note_import_use(ctx.sigs, ctx.owner_file, sig.owner_module)
                            e.mangled_callee = intern(selected.as_str())
                            e.is_static_call = true
                            handled = true
                        }
                    }
                    None => { }
                }
            }
            if !handled {
                val lab = new_label(e.span, "no matching `${qualified_trait}.${method_name}(receiver, ...)` implementation")
                ctx.emit(new_diagnostic(Severity.Error, lab))
                e.ty = poison_ty()
                handled = true
            }
        }
        val rname = static_recv_type_name(recv_raw.kind, ctx)
        if !handled && !rname.as_str().equals("") {
            if !enum_name_has_variant(rname, method_name, ctx) {
                // A type-argument list shorter than the type's parameters is
                // reported here; mono would otherwise crash passes later on a
                // missing replacement. Empty means inference; longer may carry
                // the method's own arguments.
                if e.type_args.size() > 0 {
                    val arity_base = mangle_base_name(rname.clone())
                    when (unsafe { (*ctx.sigs).find_generic_info(arity_base.as_str(), ctx.owner_crate) }) {
                        Some(ginfo) => {
                            if e.type_args.size() < ginfo.type_params.size() {
                                emit_type_arg_arity(arity_base.clone(), ginfo.type_params.size(), e.type_args.size(), e.span, ctx)
                                e.ty = poison_ty()
                                return
                            }
                        }
                        None => { }
                    }
                }
                val tmpl = rname + String.from("_") + method_name
                // Arguments are typed first: they select a `From<S>`-style impl.
                while ai in 0..args.size() {
                    check_call_argument(args.at_mut(ai), ctx)
                }
                var selected = tmpl.clone()
                var sigp = unsafe { (*ctx.sigs).find_signature(selected.as_str()) }
                if sigp.is_none() {
                    selected = static_trait_method_callee(rname.clone(), method_name.clone(), args, e.type_args, ctx)
                    if !selected.as_str().equals("") {
                        sigp = unsafe { (*ctx.sigs).find_signature(selected.as_str()) }
                    }
                }
                if sigp.is_some() {
                    val ssig = sigp ?: return
                    note_import_use(ctx.sigs, ctx.owner_file, ssig.owner_module)
                    if ssig.is_static {
                        // Each argument against its parameter (no `self`), with the
                        // call's explicit type args substituted into the impl's
                        // parameters first. The receiver's and the method's own
                        // type args share one list; `static_recv_arity` splits it.
                        val n_recv = rname.static_recv_arity(ctx)
                        var n_meth = 0
                        if ssig.generics.size() > n_recv { n_meth = ssig.generics.size() - n_recv }
                        infer_static_method_type_args(&ssig, n_recv, &var e.type_args, args, e.span, ctx)
                        var split: uint64 = e.type_args.size()
                        if n_meth < split { split = split - n_meth } else { split = 0 }
                        val recv_targs = type_args_head(&e.type_args, split)
                        // `List.new()` gives nothing to infer from: remembered,
                        // not reported, since rebind_static_call may supply it
                        // from the slot.
                        if recv_targs.size() < n_recv {
                            note_open_call(e.span, rname.clone(), method_name.clone(), ctx)
                        }
                        val meth_targs = type_args_tail(&e.type_args, split)
                        val sparams = ssig.static_call_params(e.type_args, ctx)
                        // Matched and well-formed are separate: once matched, a
                        // failure must be reported, or codegen emits an instance
                        // call with a type as receiver. Arity is checked; argument
                        // types are not, since `can_coerce` would reject valid code.
                        var call_valid = true
                        if args.size() != sparams.size() {
                            emit_static_call_arity(rname.clone(), method_name.clone(), sparams.size(), args.size(), e.span, ctx)
                            call_valid = false
                        }
                        while ci in 0..args.size() {
                            if ci < sparams.size() {
                                val actual = args.at(ci)
                                val expected = *sparams.at(ci)
                                val outcome = coerce_call_arg(args, ci, expected.clone(), ctx)
                                if !outcome.valid {
                                    call_valid = false
                                } else if !outcome.coerced && !actual.ty.type_eq(expected) && !ctx.fits(actual.ty, expected) {
                                    call_valid = false
                                }
                            }
                        }
                        if !call_valid {
                            e.ty = poison_ty()
                            handled = true
                        }
                        // `Type[__Targs]_method`, the receiver layout
                        // materialized, the return type substituted.
                        val recv_mono = mangle_type_name(rname.as_str(), &recv_targs, ctx)
                        if recv_targs.size() > 0 {
                            instantiate_generic_layout(rname.clone(), &recv_targs, String.from(recv_mono.as_str()), ctx)
                        }
                        var ret = ssig.ret
                        while gi in 0..ssig.generics.size() {
                            if gi < e.type_args.size() {
                                val gname = *ssig.generics.at(gi)
                                val targ = *e.type_args.at(gi)
                                val gty = targ.resolve_type_ref(ctx)
                                // The owner is the mangled method name.
                                check_generic_bounds(selected.clone(), gname.clone(), gty, e.span, ctx)
                                ret = ret.subst_generic(gname, gty)
                            }
                        }
                        if call_valid {
                            e.ty = ret
                            if selected.as_str().equals(tmpl.as_str()) {
                                var callee = recv_mono.clone()
                                callee.append("_")
                                callee.append(monomorphized_type_name(method_name.clone(), &meth_targs).as_str())
                                e.mangled_callee = intern(callee.as_str())
                            } else {
                                val prefix_len = tmpl.as_str().byte_len()
                                val suffix = selected.as_str().substring(prefix_len, selected.as_str().byte_len())
                                // The suffix comes from the template, spelled with
                                // the impl's parameters
                                // (`impl Absorb<Wrap<T>> for Holder<T>` registers
                                // `__Absorb__Wrap__T`); substituted here to match
                                // the monomorphized definition.
                                val mono_suffix = suffix.subst_static_trait_suffix(&ssig, e.type_args, ctx)
                                var callee = recv_mono.clone()
                                callee.append("_")
                                callee.append(method_name.as_str())
                                callee.append(mono_suffix.as_str())
                                e.mangled_callee = intern(callee.as_str())
                            }
                            e.is_static_call = true
                            handled = true
                        }
                    } else {
                        // An instance method called as `Type.method(...)`. The
                        // message names the fix at the declaration, since one
                        // missing `static` fires at every call site.
                        var m = String.from("`")
                        m.append(method_name.as_str())
                        m.append("` is an instance method, so it needs a receiver — declare it `static fun` to call it on the type, or call it on a value")
                        val lab = new_label(e.span, m)
                        ctx.emit(new_diagnostic(Severity.Error, lab))
                        e.ty = poison_ty()
                        handled = true
                    }
                }
            }
        }
        // `T.method(args)` with `T` a type parameter: marked static with a
        // placeholder callee `T_method` that materialize rewrites. Types as `T`.
        if !handled {
            val gsr = generic_static_recv_name(recv_raw.kind, ctx)
            if !gsr.as_str().equals("") {
                while gai in 0..args.size() {
                    check_call_argument(args.at_mut(gai), ctx)
                }
                val trait_callee = generic_static_trait_callee(gsr.clone(), method_name.clone(), ctx)
                if trait_callee.as_str().equals("") {
                    e.mangled_callee = intern((gsr.clone() + String.from("_") + method_name.clone()).as_str())
                } else {
                    e.mangled_callee = intern(trait_callee.as_str())
                }
                e.is_static_call = true
                e.ty = generic_ty(gsr.clone(), e.span)
                handled = true
            }
        }
        if !handled {
            val enum_name = try_get_enum_recv_name(recv_raw.kind, ctx)
            val name_str = enum_name.as_str()
            val is_empty = name_str.equals("")
            if !is_empty {
                e.ty = check_variant_construction(enum_name, &var e.type_args, method_name, args, e.span, ctx)
                e.is_variant_ctor = true
            } else {
                val receiver: &var Expr = unsafe { &var *recv_ptr }
                check_expr(receiver, ctx)
                val pretyped = receiver.pin_open_receiver(method_name.as_str(), args, ctx)
                val recv = unsafe { *recv_ptr }
                if dyn_or_extension_call(e, recv_ptr, &recv, method_name_sym, args, ctx) { return }
                // A `mutating` method needs a writable receiver.
                check_receiver_is_writable(recv_ptr, &recv.ty, method_name.clone(), args.size(), e.span, ctx)
                // Projections in the return type are resolved now, since the
                // result is used in this body.
                ctx.pretyped_args = pretyped
                val called = check_method_call(recv.ty, method_name.clone(), args, e.span, ctx, e)
                e.ty = called.resolved_projection_type("", ctx.sigs)
                val trait_callee = trait_callee_unless_inherent(recv.ty, method_name, args, ctx)
                if !trait_callee.as_str().equals("") {
                    e.mangled_callee = intern(trait_callee.as_str())
                } else {
                    if ambiguous_trait_method(recv.ty, method_name_sym.as_string(), args, ctx) {
                        val lab = new_label(e.span, "ambiguous method `${method_name_sym.as_string()}`: qualify it as `Trait.${method_name_sym.as_string()}(value, ...)`")
                        ctx.emit(new_diagnostic(Severity.Error, lab))
                    }
                    // Through the borrow: `fun emit<W: Sink>(out: &W)` arrives
                    // as `RefTo(Generic("W"))`.
                    val recv_base = autoderef_ty(recv.ty.clone())
                    when (recv_base.kind) {
                        Generic(_gname) => {
                            val generic_trait_callee = generic_instance_trait_callee(recv_base.kind.generic_name(), method_name_sym.as_string(), ctx)
                            if !generic_trait_callee.as_str().equals("") {
                                e.mangled_callee = intern(generic_trait_callee.as_str())
                            }
                        }
                        _ => {}
                    }
                }
            }
        }
    }
}

/// The impl's parameters with the call's explicit type arguments substituted:
/// `Holder.of<int32>(5)` against a signature registered with `T`.
pub fun FnSignature.static_call_params(type_args: &List<TypeRef>, ctx: &var TypeCtx): List<Type> {
    var out = List.new<Type>()
    var i = 0
    while i < self.params.size() {
        var pt = *self.params.at(i)
        while g in 0..self.generics.size() {
            if g < type_args.size() {
                val gty = (*type_args.at(g)).resolve_type_ref(ctx)
                pt = pt.subst_generic(*self.generics.at(g), gty)
            }
        }
        out.push(pt)
        i = i + 1
    }
    return out
}

/// The template's trait suffix `__<Trait>[__<args>]` with the call's type
/// arguments substituted. A suffix naming no impl parameter is untouched.
fun String.subst_static_trait_suffix(sig: &FnSignature, type_args: &List<TypeRef>, ctx: &var TypeCtx): String {
    val raw = self.as_str()
    val n = raw.byte_len()
    if n <= 2 { return self.clone() }
    var names = List.new<String>()
    var types = List.new<Type>()
    while i in 0..sig.generics.size() {
        if i < type_args.size() {
            names.push(*sig.generics.at(i))
            types.push((*type_args.at(i)).resolve_type_ref(ctx))
        }
    }
    if names.size() == 0 { return self.clone() }
    // Past the leading `__`.
    val body = raw.substring(2, n)
    return "__${subst_trait_args(body.as_str(), &names, &types, true)}"
}

/// Names both counts.
fun emit_type_arg_arity(base: String, expected: uint64, got: uint64, span: Span, ctx: &var TypeCtx): void {
    var message = String.from("`")
    message.append(base.as_str())
    message.append("` takes ")
    message.append(String.of(&((expected as int64))).as_str())
    message.append(" type arguments, but ")
    message.append(String.of(&((got as int64))).as_str())
    message.append(" was supplied")
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// Names the type as well as the method, as the call is written.
fun emit_static_call_arity(type_name: String, method_name: String, expected: uint64, found: uint64, span: Span, ctx: &var TypeCtx): void {
    var msg = String.from("wrong number of arguments to `")
    msg.append(type_name.as_str())
    msg.append(".")
    msg.append(method_name.as_str())
    msg.append("`: expected ")
    msg.append(String.of(&((expected as int64))).as_str())
    msg.append(", found ")
    msg.append(String.of(&((found as int64))).as_str())
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}
