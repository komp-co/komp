// `f(args)` on a local value means `f.call(args)`. Functions and unknown
// names stay on the free-call path.

import kf_core.ast.Sym

// Only a local proven callable through a `Call` bound, so a same-named local
// does not steal a function call.
pub fun Sym.local_is_callable(arity: uint64, ctx: &var TypeCtx): bool {
    if !ctx.is_declared(self.as_str()) { return false }
    val local_ty = ctx.lookup(self.as_str())
    when (local_ty.kind) {
        Generic(name) => {
            val req = trait_method_for_generic(name.as_string(), String.from("call"), ctx)
            return req.arity == arity
        }
        Struct(identity) => {
            val shared = call_trait_name(arity, false)
            if unsafe { (*ctx.sigs).identity_implements_any(identity, shared.as_str()) } { return true }
            val mutable = call_trait_name(arity, true)
            return unsafe { (*ctx.sigs).identity_implements_any(identity, mutable.as_str()) }
        }
        _ => return false
    }
}
