// An array literal bound without a type is an array until a use needs more: a
// method only `List` has, a `List` slot or one of another type converting from
// an array, or a store of such a value. A slice use decides nothing, since a
// list lends one too; an array slot rules out the rest.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_typecheck.types.type_eq
import kf_typecheck.types.resolve_type_ref

/// What a slot asks of an open array binding; None when the array serves it.
fun Type.list_target(ctx: &var TypeCtx): Type? {
    val target = autoderef_ty(self.clone())
    if !target.is_nominal() || target.type_is_option(ctx) { return null }
    if target.array_shape(ctx) != null || target.slice_lend(ctx) != null { return null }
    if target.from_array_element(ctx) == null { return null }
    return target
}

/// A slot deciding an open array binding. True only when it conflicts with an
/// earlier use; otherwise the caller's coercions run on.
mutating fun Expr.narrow_open_array(expected: Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    if name.byte_len() == 0 { return false }
    val init_ptr = ctx.open_init(name.as_str()) ?: return self.conflicts_with_list_decision(expected, ctx)
    if autoderef_ty(expected.clone()).array_shape(ctx) != null {
        ctx.narrow_binding(name.as_str(), self.span)
        return false
    }
    val target = expected.list_target(ctx) ?: return false
    if self.conflicts_with_narrowing(&target, "an array", ctx) { return true }
    self.settle_open_array(init_ptr, target, ctx)
    return false
}

/// `xs.push(...)` on an open array binding: a method a `List` has and an
/// array does not decides it, as a list of the array's elements.
mutating fun Expr.narrow_open_array_receiver(method: str, ctx: &var TypeCtx): void {
    val name = self.variable_name()
    if name.byte_len() == 0 || ctx.list_name().as_str() == "" { return }
    val init_ptr = ctx.open_init(name.as_str()) ?: return
    val shape = self.ty.array_shape(ctx) ?: return
    val array_name = ctx.array_name()
    val list_name = ctx.list_name()
    if type_has_method_named(array_name.as_str(), method, ctx) { return }
    if !type_has_method_named(list_name.as_str(), method, ctx) { return }
    var args = List.new<TypeRef>()
    args.push(shape.element.written_instance(self.span, ctx))
    val list = TypeRef.new(self.span, TypeRefKind.Named(ctx.list_name(), args)).resolve_type_ref(ctx)
    if self.conflicts_with_narrowing(&list, "an array", ctx) { return }
    self.settle_open_array(init_ptr, list, ctx)
}

mutating fun Expr.settle_open_array(init_ptr: Ptr<Expr>, target: Type, ctx: &var TypeCtx): void {
    val init: &var Expr = unsafe { &var *init_ptr }
    if !init.is_array_literal() || self.ty.type_eq(target) { return }
    if self.decides_on_recheck(init.span, target.clone(), ctx) { return }
    if !init.apply_expected(target.clone(), ctx) || !init.ty.type_eq(target) { return }
    ctx.decide_binding(self.variable_name().as_str(), target.clone(), self.span)
    self.ty = target
}

/// A slot asking another collection than the one an earlier use decided.
mutating fun Expr.conflicts_with_list_decision(expected: Type, ctx: &var TypeCtx): bool {
    if self.ty.list_target(ctx) == null { return false }
    val target = expected.list_target(ctx) ?: return false
    return self.conflicts_with_decision(target, ctx)
}
