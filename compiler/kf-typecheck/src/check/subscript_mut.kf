// `xs[i]` is `*(xs.index(i))`, a shared borrow. Written through (a store, a
// `mutating` method, `&var`), it becomes `index_mut` and is checked again.

import kf_core.ast.*
import kf_core.span.Span
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.check.borrow.check_deref

/// Only the root counts: `xs[i].f` writes into `xs[i]`.
pub mutating fun Expr.promote_subscript_to_mut(ctx: &var TypeCtx): bool {
    when (self.kind) {
        FieldAccess(base, _field) => return promote_subscript_to_mut(unsafe { &var *base }, ctx)
        Deref(call) => {
            if !is_shared_subscript(unsafe { &*call }) { return false }
            when (unsafe { call.kind }) {
                MethodCall(recv, _name, args) => {
                    if !place_is_mutable(unsafe { *recv }, ctx) {
                        emit_immutable_container(unsafe { &*recv }, self.span, ctx)
                        return true
                    }
                    unsafe { call.kind = ExprKind.MethodCall(recv, intern("index_mut"), args) }
                }
                _ => return false
            }
            reset_call_annotations(unsafe { &var *call })
            check_expr(unsafe { &var *call }, ctx)
            self.ty = check_deref(unsafe { *call }, self.span, ctx)
            return true
        }
        _ => return false
    }
}

pub fun Expr.is_shared_subscript(): bool {
    return when (self.kind) {
        MethodCall(_recv, name, args) => name.as_str() == "index" && args.size() == 1
        _ => false
    }
}

fun Expr.emit_immutable_container(span: Span, ctx: &var TypeCtx): void {
    val root = self.place_root_name()
    val subject = if root.as_str().equals("") { String.from("the self") } else { "`${root.as_str()}`" }
    val fix = "declare it with `var` (or borrow it with `&var`)"
    val message = "cannot borrow an element of ${subject.as_str()} mutably; ${fix}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// Borrowing a root subscript through `IndexMut` when that makes it writable.
pub fun writable_place(place: Ptr<Expr>, ctx: &var TypeCtx): bool {
    if place_is_mutable(unsafe { *place }, ctx) { return true }
    return promote_subscript_to_mut(unsafe { &var *place }, ctx)
}

/// A subscript receiver borrows through `IndexMut`; anything else is
/// reported.
pub fun check_receiver_is_writable(recv: Ptr<Expr>, recv_ty: &Type, method_name: String, arity: uint64, span: Span,
    ctx: &var TypeCtx): void {
    if place_is_mutable(unsafe { *recv }, ctx) { return }
    if !recv_ty.method_is_mutating(method_name.clone(), arity, ctx) { return }
    if promote_subscript_to_mut(unsafe { &var *recv }, ctx) { return }
    emit_immutable_recv_err(method_name, unsafe { *recv }, span, ctx)
}
