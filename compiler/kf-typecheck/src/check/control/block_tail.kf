// The value a block yields: its last statement, walked through every branch
// of a trailing `if` or `when`:
//
//   tail_yields_value   every path produces something (in pattern.kf; the
//                       parser asks too)
//   tail_ty             the type they join to
//   apply_tail_ty       each path adapted to it
//
// Two type passes, since the joined type is known only once every path is
// seen; joining early truncates a literal later widened. A missing `else`
// yields nothing.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt
import kf_typecheck.types.join_arm_types
import kf_typecheck.types.type_eq
import kf_typecheck.types.type_is_uninhabited
import kf_typecheck.check.expect_or_reject
import kf_typecheck.check.is_numeric_literal

/// Only called after `tail_yields_value` said yes. A failed join keeps the
/// type so far; `apply_tail_ty` may still adapt the path.
pub fun Stmt.tail_ty(string_name: Sym): Type {
    when (self.kind) {
        Expression(ep) => return unsafe { ep.ty }
        Return(_) => return Type.new_never(self.span)
        Break => return Type.new_never(self.span)
        Continue => return Type.new_never(self.span)
        If(_c, then_body, else_body) => {
            val t = list_tail_ty(&then_body, string_name)
            if t.is_poison() { return t }
            val e = list_tail_ty(&else_body, string_name)
            if e.is_poison() { return e }
            val joined = t.join_arm_types(&e, string_name)
            if joined.is_poison() { return t }
            return joined
        }
        When(_subj, arms) => {
            if arms.size() == 0 { return Type.new_poison() }
            val first = *arms.at(0)
            var result = list_tail_ty(&first.body, string_name)
            if result.is_poison() { return result }
            var i = 1
            while i < arms.size() {
                val arm = *arms.at(i)
                val arm_ty = list_tail_ty(&arm.body, string_name)
                if !arm_ty.is_poison() {
                    val joined = result.join_arm_types(&arm_ty, string_name)
                    if !joined.is_poison() { result = joined }
                }
                i = i + 1
            }
            return result
        }
        _ => return Type.new_poison()
    }
    return Type.new_poison()
}

pub fun list_tail_ty(stmts: &List<Stmt>, string_name: Sym): Type {
    if stmts.size() == 0 { return Type.new_poison() }
    return (stmts.at(stmts.size() - 1)).tail_ty(string_name)
}

/// Every path ends in a bare number, whose width a slot may still choose.
pub fun list_tail_is_numeric_literal(stmts: &List<Stmt>): bool {
    if stmts.size() == 0 { return false }
    return when (stmts.at(stmts.size() - 1).kind) {
        Expression(ep) => is_numeric_literal(&*ep)
        _ => false
    }
}

/// Rewrites the tail expressions through the pointers the list holds.
/// `report` is false where the caller already reported mismatches.
pub fun Stmt.apply_tail_ty(want: &Type, report: bool, ctx: &var TypeCtx): void {
    when (self.kind) {
        Expression(ep) => {
            if !expect_unless_never(unsafe { &var *ep }, want.clone(), ctx) {
                if report {
                    val got = unsafe { ep.ty }
                    if !got.type_eq(unsafe { *want }) {
                        emit_if_arm_mismatch(want.clone(), got, unsafe { ep.span }, ctx)
                    }
                }
            }
        }
        If(_c, then_body, else_body) => {
            apply_list_tail_ty(&then_body, want, report, ctx)
            apply_list_tail_ty(&else_body, want, report, ctx)
        }
        When(_subj, arms) => {
            while arm in &arms {
                apply_list_tail_ty(&arm.body, want, report, ctx)
            }
        }
        _ => return
    }
}

/// `expect_or_reject`, except that a value which is never produced takes the
/// bottom type, which fits any slot.
pub fun expect_unless_never(e: &var Expr, want: Type, ctx: &var TypeCtx): bool {
    if !e.ty.type_is_uninhabited(ctx) { return expect_or_reject(e, want, ctx) }
    e.ty = Type.new_never(e.span)
    return true
}

pub fun apply_list_tail_ty(stmts: &List<Stmt>, want: &Type, report: bool, ctx: &var TypeCtx): void {
    if stmts.size() == 0 { return }
    (stmts.at(stmts.size() - 1)).apply_tail_ty(want, report, ctx)
}

/// Names the path that lacks a value, typically an `if` missing its `else`.
pub fun tail_no_value_msg(stmts: &List<Stmt>): String {
    if stmts.size() == 0 {
        return String.from("this block is empty, so it produces no value — a block used as an expression must end with one")
    }
    if (stmts.at(stmts.size() - 1)).tail_is_elseless_if() {
        return String.from("this `if` has no `else`, so one path produces no value — an `if` used as a value must yield on both paths")
    }
    return String.from("this block ends with a statement, so it produces no value — a block used as an expression must end with one")
}

/// Looks through branches as `tail_yields_value` does.
fun Stmt.tail_is_elseless_if(): bool {
    when (self.kind) {
        If(_c, then_body, else_body) => {
            if else_body.size() == 0 { return true }
            if list_tail_is_elseless_if(&then_body) { return true }
            return list_tail_is_elseless_if(&else_body)
        }
        When(_subj, arms) => {
            while arm in &arms {
                if list_tail_is_elseless_if(&arm.body) { return true }
            }
            return false
        }
        _ => return false
    }
    return false
}

fun list_tail_is_elseless_if(stmts: &List<Stmt>): bool {
    if stmts.size() == 0 { return false }
    return (stmts.at(stmts.size() - 1)).tail_is_elseless_if()
}

/// A missing `else` arrives as an empty block.
pub fun Expr.expr_is_empty_block(): bool {
    when (self.kind) {
        Block(stmts) => return stmts.size() == 0
        _ => return false
    }
    return false
}
