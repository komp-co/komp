import core.assert.*
import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.span.*
import kf_resolve.new_decl_table
import kf_resolve.resolve_module

fun coverage_arm(kind: PatternKind, guarded: bool): Arm {
    return coverage_arm_at(kind, guarded, no_span())
}

fun coverage_arm_at(kind: PatternKind, guarded: bool, span: Span): Arm {
    val pattern: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pattern = new_pattern(span, kind) }
    var guard: Box<Expr>? = null
    if guarded {
        val gp: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *gp = new_expr(no_span(), ExprKind.LitBool(true)) }
        guard = Option.Some<Box<Expr>>(gp)
    }
    return new_arm(no_span(), pattern, guard, List.new<Stmt>())
}

fun coverage_diags(subject_name: str, arms: List<Arm>, include_color: bool): List<Diagnostic> {
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("subject"), tref_p(subject_name)))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.When(ep(ExprKind.Variable(intern("subject"))), arms)))
    val kind = TopDeclKind.Function(params, tref_p("void"), body, true, false, false, false)
    var module = Module {
        crate: crate_id_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    if include_color { module.decls.push(color_enum_decl()) }
    module.decls.push(new_top_decl(no_span(), String.from("inspect"), kind))
    var table = new_decl_table()
    resolve_module(&var module, &var table)
    return module.typecheck_module(&var table)
}

fun color_variant(name: str, guarded: bool): Arm {
    return coverage_arm(PatternKind.Variant(intern(name), List.new<Pattern>()), guarded)
}

fun color_variant_at(name: str, span: Span): Arm {
    return coverage_arm_at(PatternKind.Variant(intern(name), List.new<Pattern>()), false, span)
}

@test fun duplicate_variant_when_arm_is_rejected(): void {
    var arms = List.new<Arm>()
    arms.push(color_variant("Red", false))
    arms.push(color_variant("Red", false))
    arms.push(color_variant("Green", false))
    arms.push(color_variant("Blue", false))
    val diags = coverage_diags("Color", arms, true)
    assert_eq(diags.size(), 1, "the second Red arm is unreachable")
}

@test fun duplicate_variant_when_arm_names_the_pattern(): void {
    var arms = List.new<Arm>()
    arms.push(color_variant("Red", false))
    arms.push(color_variant("Red", false))
    arms.push(color_variant("Green", false))
    arms.push(color_variant("Blue", false))
    val diags = coverage_diags("Color", arms, true)
    val expected = "`Red` is already covered by an earlier arm"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the duplicate arm is named")
}

@test fun duplicate_when_diagnostic_points_to_later_arm(): void {
    val earlier = Span { file_id: 1, start: 10, end: 13 }
    val later = Span { file_id: 1, start: 20, end: 23 }
    var arms = List.new<Arm>()
    arms.push(color_variant_at("Red", earlier))
    arms.push(color_variant_at("Red", later))
    arms.push(color_variant("Green", false))
    arms.push(color_variant("Blue", false))
    val diags = coverage_diags("Color", arms, true)
    assert_eq(diags.at(0).primary.span.start, 20, "the later pattern owns the error")
}

@test fun duplicate_integer_when_arm_is_rejected(): void {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.LitInt(0), false))
    arms.push(coverage_arm(PatternKind.LitInt(0), false))
    arms.push(coverage_arm(PatternKind.Wildcard, false))
    val diags = coverage_diags("int32", arms, false)
    assert_eq(diags.size(), 1, "the second zero arm is unreachable")
}

@test fun duplicate_bool_when_arm_is_rejected(): void {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.LitBool(true), false))
    arms.push(coverage_arm(PatternKind.LitBool(true), false))
    arms.push(coverage_arm(PatternKind.LitBool(false), false))
    val diags = coverage_diags("bool", arms, false)
    assert_eq(diags.size(), 1, "the second true arm is unreachable")
}

@test fun arm_after_wildcard_is_rejected(): void {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.Wildcard, false))
    arms.push(color_variant("Red", false))
    val diags = coverage_diags("Color", arms, true)
    assert_eq(diags.size(), 1, "a wildcard makes every later arm unreachable")
}

@test fun arm_after_bare_binding_is_rejected(): void {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.Identifier(intern("value")), false))
    arms.push(color_variant("Red", false))
    val diags = coverage_diags("Color", arms, true)
    assert_eq(diags.size(), 1, "a binding makes every later arm unreachable")
}

@test fun guarded_variant_does_not_cover_later_arm(): void {
    var arms = List.new<Arm>()
    arms.push(color_variant("Red", true))
    arms.push(color_variant("Red", false))
    arms.push(color_variant("Green", false))
    arms.push(color_variant("Blue", false))
    val diags = coverage_diags("Color", arms, true)
    assert_eq(diags.size(), 0, "a guard may fail, so the later Red arm is reachable")
}
