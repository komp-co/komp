// A string literal arm is matched by comparing `str`s, which allocates
// nothing: `"a" | "b" => body` becomes
// `__when_text if __when_text == "a" || __when_text == "b"`, with `.as_str()`
// on a `String` binder. As a guarded arm it covers nothing for exhaustiveness.

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.BinOp
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_core.span.Span
import kf_typecheck.types.display_type

/// CONSTRAINT: before the arm's pattern and guard are checked, so the
/// synthesized binder and comparison are typed like written ones.
pub mutating fun Arm.desugar_string_pattern(texts: List<String>, subject_ty: Type, ctx: &var TypeCtx): void {
    val span = unsafe { self.pattern.span }
    if !subject_ty.is_text(ctx) {
        val message = "this pattern is a string, but the subject is `${subject_ty.display_type(ctx)}`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
        unsafe { *self.pattern = pattern_poison(span) }
        return
    }
    val binder = intern("__when_text")
    unsafe { *self.pattern = new_pattern(span, PatternKind.Identifier(binder)) }
    var condition: Ptr<Expr> = text_equals(binder, texts.at(0).clone(), subject_ty, span, ctx)
    while i in 1..texts.size() {
        val next = text_equals(binder, texts.at(i).clone(), subject_ty, span, ctx)
        val either: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *either = Expr.new(span, ExprKind.Binary(condition, BinOp.OrOr, next)) }
        condition = either
    }
    when (self.guard) {
        Some(written) => {
            val both: Ptr<Expr> = unsafe { alloc<Expr>() }
            // The store below drops the written guard, so the condition keeps a copy.
            unsafe { *both = Expr.new(span, ExprKind.Binary(condition, BinOp.AndAnd, Box.new(written.clone()))) }
            condition = both
        }
        None => { }
    }
    self.guard = Option.Some<Box<Expr>>(condition)
}

/// `binder == "text"`, through `.as_str()` unless the subject is a `str`.
fun text_equals(binder: Sym, text: String, subject_ty: Type, span: Span, ctx: &TypeCtx): Ptr<Expr> {
    var left: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *left = Expr.new(span, ExprKind.Variable(binder)) }
    if !subject_ty.is_str(ctx) {
        val view: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *view = Expr.new(span, ExprKind.MethodCall(left, intern("as_str"), List.new<Expr>())) }
        left = view
    }
    val right: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *right = Expr.new(span, ExprKind.LitStr(text)) }
    val equal: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *equal = Expr.new(span, ExprKind.Binary(left, BinOp.Eq, right)) }
    return equal
}

/// `str` or the lang `String`, directly or through a borrow.
fun Type.is_text(ctx: &TypeCtx): bool {
    return when (self.kind) {
        Struct(name) => name.as_str().equals(ctx.string_name().as_str())
        RefTo(_, pointee) => unsafe { (&*pointee).is_text(ctx) }
        _ => self.is_str(ctx)
    }
}

fun Type.is_str(ctx: &TypeCtx): bool {
    return when (self.kind) {
        StrTy => true
        Poison => true
        RefTo(_, pointee) => unsafe { (&*pointee).is_str(ctx) }
        _ => false
    }
}
