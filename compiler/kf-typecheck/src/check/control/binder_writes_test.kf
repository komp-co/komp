import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.span.no_span

fun payload_pattern(binders: List<Pattern>): Pattern {
    return new_pattern(no_span(), PatternKind.Variant(intern("Some"), binders))
}

@test fun a_variant_pattern_binds_its_payload_names(): void {
    var payloads = List.new<Pattern>()
    payloads.push(new_pattern(no_span(), PatternKind.Identifier(intern("c"))))
    val names = payload_pattern(payloads).direct_binders()
    assert_eq(names.size(), 1, "one payload binder")
}

@test fun a_bare_name_binds_the_whole_subject(): void {
    val names = new_pattern(no_span(), PatternKind.Identifier(intern("other"))).direct_binders()
    assert_eq(names.size(), 1, "the subject binder")
}

@test fun a_wildcard_binds_nothing(): void {
    val names = new_pattern(no_span(), PatternKind.Wildcard).direct_binders()
    assert_eq(names.size(), 0, "no binder")
}

@test fun a_field_path_is_rooted_at_its_variable(): void {
    val root = Box.new(Expr.new(no_span(), ExprKind.Variable(intern("c"))))
    val place = Expr.new(no_span(), ExprKind.FieldAccess(root, intern("n")))
    assert_eq(place.rooted_at("c"), true, "`c.n` is inside `c`")
}

@test fun a_deref_leaves_the_binder(): void {
    val root = Box.new(Expr.new(no_span(), ExprKind.Variable(intern("p"))))
    val place = Expr.new(no_span(), ExprKind.Deref(root))
    assert_eq(place.rooted_at("p"), false, "`*p` is what `p` points at")
}
