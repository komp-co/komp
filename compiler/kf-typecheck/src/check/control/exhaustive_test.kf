import core.assert.assert_eq
import core.assert.assert
import core.assert.fail
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*
import kf_typecheck.check.mk_stmt_ctx

// `enum Color { Red  Green  Blue }`, registered, and a subject naming it.
fun mk_color_ctx(): TypeCtx {
    val ctx = mk_stmt_ctx()
    var variants = List.new<VariantInfo>()
    variants.push(VariantInfo { name: String.from("Red"), payloads: List.new<Type>() })
    variants.push(VariantInfo { name: String.from("Green"), payloads: List.new<Type>() })
    variants.push(VariantInfo { name: String.from("Blue"), payloads: List.new<Type>() })
    unsafe { (*ctx.sigs).insert_enum(EnumLayout { name: String.from("Color"), variants: variants, owner_crate: crate_id_poison() }) }
    return ctx
}

fun color_ty(): Type {
    return Type { kind: TypeKind.EnumTy(intern("Color")), provenance: Provenance.Inferred(no_span()) }
}

fun variant_arm(name: str): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Variant(intern(name), List.new<Pattern>())) }
    return new_arm(no_span(), pp, null, List.new<Stmt>())
}

fun wildcard_arm(): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Wildcard) }
    return new_arm(no_span(), pp, null, List.new<Stmt>())
}

fun lit_bool_arm(value: bool): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.LitBool(value)) }
    return new_arm(no_span(), pp, null, List.new<Stmt>())
}

fun lit_int_arm(value: int64): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.LitInt(value)) }
    return new_arm(no_span(), pp, null, List.new<Stmt>())
}

// lower_snake_case survives reclassification, so it binds.
fun binding_arm(name: str): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Identifier(intern(name))) }
    return new_arm(no_span(), pp, null, List.new<Stmt>())
}

fun guarded_wildcard_arm(): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Wildcard) }
    val guard: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *guard = Expr.new(no_span(), ExprKind.LitBool(true)) }
    return new_arm(no_span(), pp, guard, List.new<Stmt>())
}

fun guarded_lit_bool_arm(value: bool): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.LitBool(value)) }
    val guard: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *guard = Expr.new(no_span(), ExprKind.LitBool(true)) }
    return new_arm(no_span(), pp, guard, List.new<Stmt>())
}

fun guarded_variant_arm(name: str): Arm {
    val pp: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = new_pattern(no_span(), PatternKind.Variant(intern(name), List.new<Pattern>())) }
    val guard: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *guard = Expr.new(no_span(), ExprKind.LitBool(true)) }
    return new_arm(no_span(), pp, guard, List.new<Stmt>())
}

@test fun omitted_variant_is_reported_missing(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(variant_arm("Green"))
    val missing = when_missing_variants(color_ty(), &arms, &var ctx)
    assert_eq(missing.size(), 1, "Blue is uncovered")
}

@test fun omitted_variant_is_named(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(variant_arm("Green"))
    val missing = when_missing_variants(color_ty(), &arms, &var ctx)
    assert_eq(missing.at(0).as_str(), "Blue", "the diagnostic can name the gap")
}

@test fun all_variants_covered_is_exhaustive(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(variant_arm("Green"))
    arms.push(variant_arm("Blue"))
    assert_eq(when_is_exhaustive(color_ty(), &arms, &var ctx), true, "every variant has an arm")
}

@test fun wildcard_arm_closes_the_when(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(wildcard_arm())
    assert_eq(when_is_exhaustive(color_ty(), &arms, &var ctx), true, "`_` covers the rest")
}

@test fun every_variant_missing_when_no_arms_match(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    val missing = when_missing_variants(color_ty(), &arms, &var ctx)
    assert_eq(missing.size(), 3, "an empty when covers nothing")
}

@test fun guarded_arm_does_not_cover_its_variant(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(guarded_variant_arm("Red"))
    arms.push(variant_arm("Green"))
    arms.push(variant_arm("Blue"))
    val missing = when_missing_variants(color_ty(), &arms, &var ctx)
    assert_eq(missing.size(), 1, "a guard may be false at runtime, so Red is still open")
}

@test fun guarded_wildcard_does_not_close_the_when(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(guarded_wildcard_arm())
    val missing = when_missing_variants(color_ty(), &arms, &var ctx)
    assert_eq(missing.size(), 3, "a guarded `_` closes nothing")
}

@test fun bool_when_missing_an_arm_is_reported(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    val missing = when_missing_variants(Type.new_bool(no_span()), &arms, &var ctx)
    assert_eq(missing.size(), 1, "`false` reaches no arm")
}

@test fun bool_when_names_the_missing_value(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    val missing = when_missing_variants(Type.new_bool(no_span()), &arms, &var ctx)
    assert_eq(missing.at(0).as_str(), "false", "the gap is spelled as a source writes it")
}

@test fun both_bool_arms_are_exhaustive(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    arms.push(lit_bool_arm(false))
    assert_eq(when_is_exhaustive(Type.new_bool(no_span()), &arms, &var ctx), true, "two values, two arms")
}

@test fun bool_wildcard_closes_the_when(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    arms.push(wildcard_arm())
    assert_eq(when_is_exhaustive(Type.new_bool(no_span()), &arms, &var ctx), true, "`_` covers `false`")
}

@test fun empty_bool_when_misses_both_values(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    val missing = when_missing_variants(Type.new_bool(no_span()), &arms, &var ctx)
    assert_eq(missing.size(), 2, "no arm covers either value")
}

@test fun guarded_bool_arm_does_not_cover_its_value(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(guarded_lit_bool_arm(true))
    arms.push(lit_bool_arm(false))
    val missing = when_missing_variants(Type.new_bool(no_span()), &arms, &var ctx)
    assert_eq(missing.size(), 1, "a guard may be false at runtime, so `true` is still open")
}

@test fun bool_report_names_the_missing_value(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    report_non_exhaustive_when(Type.new_bool(no_span()), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    val expected = "non-exhaustive `when`: `false` is not covered — add an arm for it, or `_ =>` to ignore the rest"
    assert_eq(d.primary.message.as_str(), expected, "the bool gap reads like the enum one")
}

@test fun non_enum_subject_has_no_variants_to_miss(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    val missing = when_missing_variants(Type.new_int32(no_span()), &arms, &var ctx)
    assert_eq(missing.size(), 0, "an int32 subject has no finite variant set")
}

// A scalar needs an irrefutable arm.

@test fun scalar_when_without_an_irrefutable_arm_is_not_exhaustive(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_int_arm(113))
    arms.push(lit_int_arm(119))
    assert_eq(when_is_exhaustive(Type.new_int32(no_span()), &arms, &var ctx), false, "any other integer reaches no arm")
}

@test fun scalar_when_with_a_wildcard_is_exhaustive(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_int_arm(113))
    arms.push(wildcard_arm())
    assert_eq(when_is_exhaustive(Type.new_int32(no_span()), &arms, &var ctx), true, "`_` covers every other integer")
}

@test fun scalar_when_with_a_binding_is_exhaustive(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_int_arm(113))
    arms.push(binding_arm("other"))
    assert_eq(when_is_exhaustive(Type.new_int32(no_span()), &arms, &var ctx), true, "a bare binding matches anything")
}

@test fun a_guarded_wildcard_does_not_close_a_scalar_when(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(guarded_wildcard_arm())
    assert_eq(when_is_exhaustive(Type.new_int32(no_span()), &arms, &var ctx), false, "a guard may be false at runtime")
}

@test fun a_str_subject_needs_an_irrefutable_arm(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    assert_eq(when_is_exhaustive(Type.new_str(no_span()), &arms, &var ctx), false, "a `str` cannot be listed either")
}

@test fun a_char_subject_needs_an_irrefutable_arm(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    assert_eq(when_is_exhaustive(Type.new_char(no_span()), &arms, &var ctx), false, "a `char` cannot be listed either")
}

@test fun scalar_report_asks_for_a_wildcard(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_int_arm(113))
    report_non_exhaustive_when(Type.new_int32(no_span()), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    val expected = "non-exhaustive `when`: `int32` has more values than arms can list — add a `_ =>` arm"
    assert_eq(d.primary.message.as_str(), expected, "naming a missing value is impossible, so ask for the arm")
}

@test fun scalar_report_names_the_subject_type(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    report_non_exhaustive_when(Type.new_str(no_span()), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    val expected = "non-exhaustive `when`: `str` has more values than arms can list — add a `_ =>` arm"
    assert_eq(d.primary.message.as_str(), expected, "the message says which subject it is about")
}

@test fun scalar_report_is_silent_with_a_wildcard(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_int_arm(113))
    arms.push(wildcard_arm())
    report_non_exhaustive_when(Type.new_int32(no_span()), &arms, no_span(), &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "nothing to say about a closed `when`")
}

// `bool` is judged by its two values, not asked for `_`.
@test fun a_bool_subject_is_not_asked_for_a_wildcard(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(lit_bool_arm(true))
    arms.push(lit_bool_arm(false))
    report_non_exhaustive_when(Type.new_bool(no_span()), &arms, no_span(), &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "listing both values closes a bool `when`")
}

@test fun poison_subject_is_never_reported(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    val missing = when_missing_variants(Type.new_poison(), &arms, &var ctx)
    assert_eq(missing.size(), 0, "an earlier error already fired; don't pile on")
}

@test fun report_emits_an_error(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    report_non_exhaustive_when(color_ty(), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    when (d.severity) {
        Error => assert(true, "an unmatched variant has no defined behaviour")
        _ => fail("expected Error severity")
    }
}

@test fun report_names_the_missing_variant(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(variant_arm("Green"))
    report_non_exhaustive_when(color_ty(), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    val expected = "non-exhaustive `when`: `Blue` is not covered — add an arm for it, or `_ =>` to ignore the rest"
    assert_eq(d.primary.message.as_str(), expected, "the gap is named, not just counted")
}

@test fun report_lists_every_missing_variant(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    report_non_exhaustive_when(color_ty(), &arms, no_span(), &var ctx)
    val d = unsafe { *(*ctx.diags).at(0) }
    val expected = "non-exhaustive `when`: `Green`, `Blue` are not covered — add an arm for each, or `_ =>` to ignore the rest"
    assert_eq(d.primary.message.as_str(), expected, "two gaps are both named, and the plural reads correctly")
}

@test fun report_is_silent_on_an_exhaustive_when(): void {
    var ctx = mk_color_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Red"))
    arms.push(variant_arm("Green"))
    arms.push(variant_arm("Blue"))
    report_non_exhaustive_when(color_ty(), &arms, no_span(), &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "nothing to say about a total `when`")
}

@test fun unregistered_enum_name_is_not_judged(): void {
    var ctx = mk_color_ctx()
    val arms = List.new<Arm>()
    val unknown = Type { kind: TypeKind.EnumTy(intern("Nope")), provenance: Provenance.Inferred(no_span()) }
    val missing = when_missing_variants(unknown, &arms, &var ctx)
    assert_eq(missing.size(), 0, "nothing known about the subject means nothing to report")
}

// `enum Halt { }` and `enum Shape { Circle(int32)  Stuck(Halt) }`.
fun mk_shape_ctx(): TypeCtx {
    val ctx = mk_stmt_ctx()
    val halt = EnumLayout {
        name: String.from("Halt"),
        variants: List.new<VariantInfo>(),
        owner_crate: crate_id_poison()
    }
    unsafe { (*ctx.sigs).insert_enum(halt) }
    var circle = List.new<Type>()
    circle.push(Type.new_int32(no_span()))
    var stuck = List.new<Type>()
    val halt_ty = Type { kind: TypeKind.EnumTy(intern("Halt")), provenance: Provenance.Inferred(no_span()) }
    stuck.push(halt_ty)
    var variants = List.new<VariantInfo>()
    variants.push(VariantInfo { name: String.from("Circle"), payloads: circle })
    variants.push(VariantInfo { name: String.from("Stuck"), payloads: stuck })
    val shape = EnumLayout {
        name: String.from("Shape"),
        variants: variants,
        owner_crate: crate_id_poison()
    }
    unsafe { (*ctx.sigs).insert_enum(shape) }
    return ctx
}

fun shape_ty(): Type {
    return Type { kind: TypeKind.EnumTy(intern("Shape")), provenance: Provenance.Inferred(no_span()) }
}

@test
fun a_variant_holding_an_empty_enum_needs_no_arm(): void {
    var ctx = mk_shape_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Circle"))
    assert_eq(when_missing_variants(shape_ty(), &arms, &var ctx).size(), 0, "Stuck cannot be built")
}

@test
fun a_variant_holding_a_value_still_needs_its_arm(): void {
    var ctx = mk_shape_ctx()
    var arms = List.new<Arm>()
    arms.push(variant_arm("Stuck"))
    val missing = when_missing_variants(shape_ty(), &arms, &var ctx)
    assert_eq(missing.size(), 1, "Circle is still missing")
}
