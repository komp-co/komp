import kf_typecheck.types.as_branch_type

pub fun check_when_arms(subject: &Expr, arms: &var List<Arm>, span: Span, ctx: &var TypeCtx): void {
    val subject_ty = subject.ty.clone()
    val access = subject.subject_access(ctx)
    // Each arm's binders and locals are its own; the scope is wound back
    // after each.
    val outer_locals = ctx.locals.size()
    val outer_ref_binders = ctx.ref_binders.size()
    while i in 0..arms.size() {
        val arm = arms.at_mut(i)
        val pattern_ptr = arm.pattern
        // A bare identifier naming a variant is a payload-less variant match,
        // rewritten in place. Stored back only when it changes.
        when ((unsafe { &*pattern_ptr }).reclassify_ident_variant()) {
            Some(rewritten) => { unsafe { *pattern_ptr = rewritten } }
            None => { }
        }
        when ((unsafe { &*pattern_ptr }).string_texts()) {
            Some(texts) => arm.desugar_string_pattern(texts, subject_ty, ctx)
            None => { }
        }
        (unsafe { &*pattern_ptr }).report_shadowing_pattern(ctx)
        (unsafe { &*pattern_ptr }).check_pattern(subject_ty, ctx)
        arm.bind_written_binders(access, ctx)
        // CONSTRAINT: after check_pattern, so the guard sees the arm's binders.
        when (arm.guard) {
            Some(guard) => check_when_guard(guard, ctx)
            None => { }
        }
        while j in 0..arm.body.size() {
            (arm.body.at_mut(j)).check_stmt(ctx)
        }
        ctx.truncate_locals(outer_locals)
        while ctx.ref_binders.size() > outer_ref_binders { ctx.ref_binders.pop() }
    }
    // After reclassification.
    report_non_exhaustive_when(subject_ty, arms, span, ctx)
    report_covered_when_arms(arms, ctx)
}

fun check_when_guard(guard: Ptr<Expr>, ctx: &var TypeCtx): void {
    check_expr(unsafe { &var *guard }, ctx)
    val ty = unsafe { guard.ty }
    val is_bool = when (ty.kind) {
        Bool => true
        Never => true
        Poison => true
        _ => false
    }
    if is_bool { return }
    val message = "a `when` guard must be a `bool`, found `${ty.display_type(ctx)}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(unsafe { guard.span }, message)))
}

/// The join of every arm's type, then every arm made to carry it. Two passes,
/// since reconciling against the first arm narrowed a later, wider one.
/// An `if` or `when` whose every value is a bare number, left open for a slot.
pub fun Expr.yields_only_numeric_literals(): bool {
    return when (self.kind) {
        IfExpr(_c, then_value, else_value) => is_numeric_literal(&*then_value) && is_numeric_literal(&*else_value)
        WhenExpr(_s, arms) => arms_yield_only_numeric_literals(&arms)
        _ => false
    }
}

fun arms_yield_only_numeric_literals(arms: &List<Arm>): bool {
    while arm in &arms {
        if !list_tail_is_numeric_literal(&arm.body) { return false }
    }
    return true
}

pub fun check_when_expr_value(arms: &List<Arm>, ctx: &var TypeCtx): Type {
    if arms.size() == 0 { return Type.new_poison() }
    // Each arm's value is its walked tail.
    val first = arms.at(0)
    var result = list_tail_ty(&first.body, ctx.string_name()).as_branch_type(ctx)
    if result.is_poison() { return result }
    var i = 1
    while i < arms.size() {
        val arm = arms.at(i)
        val arm_ty = list_tail_ty(&arm.body, ctx.string_name()).as_branch_type(ctx)
        if !arm_ty.is_poison() {
            val joined = result.join_arm_types(&arm_ty, ctx.string_name())
            if joined.is_poison() {
                // Expected-type application gets a second chance before a
                // mismatch is reported.
                apply_list_tail_ty(&arm.body, &result, false, ctx)
                val after = list_tail_ty(&arm.body, ctx.string_name())
                if !after.type_eq(result) {
                    emit_when_arm_mismatch(result.clone(), after, arm.span, ctx)
                }
            } else {
                result = joined
            }
        }
        i = i + 1
    }
    // Bare numbers stay open, so the slot the `when` fills picks their width.
    if arms_yield_only_numeric_literals(arms) { return result }
    // Every arm gets the joined type, so codegen emits one C type. Mismatches
    // were already reported.
    while arm_k in &arms {
        apply_list_tail_ty(&arm_k.body, &result, false, ctx)
    }
    return result
}

/// An `if` used as a value. The missing-`else` error is reported here, before
/// the empty else branch is checked.
pub fun check_if_expr(cond_ptr: Ptr<Expr>, then_ptr: Ptr<Expr>, else_ptr: Ptr<Expr>, span: Span, ctx: &var TypeCtx): Type {
    check_expr(unsafe { &var *cond_ptr }, ctx)
    check_expr(unsafe { &var *then_ptr }, ctx)
    if expr_is_empty_block(unsafe { &*else_ptr }) {
        ctx.emit(new_diagnostic(Severity.Error, new_label(span, String.from("this `if` is used as a value, so it needs an `else` branch that produces one (both paths must)"))))
        return Type.new_poison()
    }
    check_expr(unsafe { &var *else_ptr }, ctx)
    return check_if_expr_value(then_ptr, else_ptr, ctx)
}

fun check_if_expr_value(then_ptr: Ptr<Expr>, else_ptr: Ptr<Expr>, ctx: &var TypeCtx): Type {
    val then_value = unsafe { &*then_ptr }
    val else_value = unsafe { &*else_ptr }
    val then_ty = then_value.ty.as_branch_type(ctx)
    val else_ty = else_value.ty.as_branch_type(ctx)
    if then_ty.is_poison() { return then_ty }
    if else_ty.is_poison() { return else_ty }
    val joined = then_ty.join_arm_types(&else_ty, ctx.string_name())
    // Two bare numbers stay open, so the slot the `if` fills picks their width.
    if is_numeric_literal(then_value) && is_numeric_literal(else_value) && !joined.is_poison() { return joined }
    if joined.is_poison() {
        // A second chance, as in the `when` form.
        if expect_or_reject(unsafe { &var *else_ptr }, then_ty.clone(), ctx) { return then_ty }
        emit_if_arm_mismatch(then_ty.clone(), unsafe { else_ptr.ty }, unsafe { else_ptr.span }, ctx)
        return then_ty
    }
    val _a = expect_unless_never(unsafe { &var *then_ptr }, joined.clone(), ctx)
    val _b = expect_unless_never(unsafe { &var *else_ptr }, joined.clone(), ctx)
    return joined
}

fun emit_if_arm_mismatch(want: Type, got: Type, span: Span, ctx: &var TypeCtx): void {
    if want.is_poison() { return }
    if got.is_poison() { return }
    var msg = String.from("this branch yields `")
    msg.append(mangle_type(got).as_str())
    msg.append("`, but the other yields `")
    msg.append(mangle_type(want).as_str())
    msg.append("` — both branches of an `if` used as a value have one type")
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

fun emit_when_arm_mismatch(want: Type, got: Type, span: Span, ctx: &var TypeCtx): void {
    if want.is_poison() { return }
    if got.is_poison() { return }
    var msg = String.from("this arm yields `")
    msg.append(mangle_type(got).as_str())
    msg.append("`, but an earlier arm yields `")
    msg.append(mangle_type(want).as_str())
    msg.append("` — every arm of a `when` expression has one type")
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

/// A bare identifier as a whole arm pattern binds; it never compares.
/// When the name already names something in scope, that is reported, since
/// the author often meant the comparison. Top level only: `Err(a)` capturing
/// a payload may shadow freely. Runs after `reclassify_ident_variant`.
fun Pattern.report_shadowing_pattern(ctx: &var TypeCtx): void {
    when (self.kind) {
        Identifier(name) => {
            val text = name.as_string()
            // A leading `_` marks a deliberate binding.
            if !text.as_str().starts_with("_") {
                if ctx.is_declared(text.as_str()) {
                    var msg = String.from("`")
                    msg.append(text.as_str())
                    msg.append("` is already a binding here, and a bare name in a pattern BINDS rather than compares — this arm matches everything. Compare with a guard or an `if`, or rename the pattern to bind a new value")
                    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, msg)))
                }
            }
        }
        _ => { }
    }
}

pub fun Pattern.check_pattern(subject_ty: Type, ctx: &var TypeCtx): void {
    when (self.kind) {
        Wildcard => return
        LitInt(_) => self.check_literal_pattern(subject_ty, "an integer", ctx)
        LitBool(_) => self.check_literal_pattern(subject_ty, "a `bool`", ctx)
        LitChar(_) => self.check_literal_pattern(subject_ty, "a `char`", ctx)
        Range(_, _, is_char) => {
            val literal = if is_char { "a `char` range" } else { "an integer range" }
            self.check_literal_pattern(subject_ty, literal, ctx)
        }
        // Rewritten to a binder and a guard before this runs.
        LitStr(_) => return
        Or(alternatives) => check_alternatives(&alternatives, subject_ty, ctx)
        Identifier(name) => ctx.declare(name.as_string(), subject_ty)
        Variant(name, payloads) => {
            check_variant_pattern(name.as_string(), payloads, subject_ty, self.span, ctx)
        }
        StructPat(_, _, _) => return
        Poison => return
    }
}

/// A literal pattern compares by value, so the subject must be of the
/// literal's own kind. A borrow is matched through.
fun Pattern.check_literal_pattern(subject_ty: Type, literal: str, ctx: &var TypeCtx): void {
    val subject = when (subject_ty.kind) {
        RefTo(_, pointee) => unsafe { *pointee }
        _ => subject_ty
    }
    val fits = when (subject.kind) {
        Poison => true
        Generic(_) => true
        Projection(_, _) => true
        Bool => self.kind.is_bool_literal()
        Char => self.kind.is_char_literal()
        _ => is_integer_type(subject) && self.kind.is_int_literal()
    }
    if fits { return }
    val message = "this pattern is ${literal}, but the subject is `${subject_ty.display_type(ctx)}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
}

fun PatternKind.is_int_literal(): bool {
    return when (self) {
        LitInt(_) => true
        Range(_, _, is_char) => !is_char
        _ => false
    }
}

fun PatternKind.is_bool_literal(): bool {
    return when (self) {
        LitBool(_) => true
        _ => false
    }
}

fun PatternKind.is_char_literal(): bool {
    return when (self) {
        LitChar(_) => true
        Range(_, _, is_char) => is_char
        _ => false
    }
}

// UpperCamelCase identifiers are variants; lower_snake_case ones bind.
/// Each alternative of an `A | B` is rewritten the same way.
fun Pattern.reclassify_ident_variant(): Pattern? {
    when (self.kind) {
        Identifier(name) => {
            if !is_variant_spelling(name.as_str()) { return null }
            return new_pattern(self.span, PatternKind.Variant(name, List.new<Pattern>()))
        }
        Or(alternatives) => {
            var rewritten = List.new<Pattern>()
            while alternative in &alternatives {
                rewritten.push(alternative.reclassify_ident_variant() ?: alternative.clone())
            }
            return new_pattern(self.span, PatternKind.Or(rewritten))
        }
        _ => return null
    }
}

fun is_variant_spelling(name: str): bool {
    if name.byte_len() == 0 { return false }
    val first = name.byte_at(0)
    if first < 65 { return false }
    return first <= 90
}

/// Through a borrow, so borrowed subjects use their layout.
pub fun TypeKind.enum_or_struct_name(): String {
    return when (self) {
        Struct(name) => type_identity_display(name)
        EnumTy(name) => type_identity_display(name)
        RefTo(_mutable, pointee) => unsafe { pointee.kind.enum_or_struct_name() }
        _ => ""
    }
}

/// Binders are scoped even without a layout.
fun declare_payload_binders_untyped(payloads: &List<Pattern>, ctx: &var TypeCtx): void {
    while payload in &payloads {
        (payload).check_pattern(Type.new_poison(), ctx)
    }
}

fun check_variant_pattern(variant_name: String, payloads: &List<Pattern>, subject_ty: Type, span: Span, ctx: &var TypeCtx): void {
    if subject_ty.is_poison() {
        declare_payload_binders_untyped(payloads, ctx)
        return
    }
    val enum_name = subject_ty.kind.enum_or_struct_name()
    if enum_name.as_str().byte_len() == 0 {
        declare_payload_binders_untyped(payloads, ctx)
        return
    }
    val found_layout = unsafe { (*ctx.sigs).find_enum(enum_name.as_str(), ctx.owner_crate) }
    if found_layout.is_none() {
        // An instance may be registered as a row without a layout; with the
        // template, that is enough to type binders.
        val via_row = instance_variant_payloads(enum_name.as_str(), variant_name.as_str(), ctx)
        if via_row.size() > 0 {
            while k in 0..payloads.size() {
                if k < via_row.size() {
                    (payloads.at(k)).check_pattern(*via_row.at(k), ctx)
                } else {
                    (payloads.at(k)).check_pattern(Type.new_poison(), ctx)
                }
            }
            return
        }
        declare_payload_binders_untyped(payloads, ctx)
        return
    }
    val layout = found_layout ?: return
    while variant in &layout.variants {
        if variant.name.as_str().equals(variant_name.as_str()) {
            while j in 0..payloads.size() {
                val pattern = payloads.at(j)
                if j < variant.payloads.size() {
                    pattern.check_pattern(*variant.payloads.at(j), ctx)
                } else {
                    pattern.check_pattern(Type.new_poison(), ctx)
                }
            }
            return
        }
    }
    // `?:` names `Some` and `None` at one place; one error says it.
    if ctx.reported_a_missing_variant_at(span) {
        declare_payload_binders_untyped(payloads, ctx)
        return
    }
    val shown = subject_ty.display_type(ctx)
    var message = "no variant `${variant_name.as_str()}` on `${shown}`"
    if variant_name.as_str() == "Some" || variant_name.as_str() == "None" {
        message.append(" — `Some`, `None` and `?:` take an optional (`T?`)")
    }
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
    declare_payload_binders_untyped(payloads, ctx)
}

fun TypeCtx.reported_a_missing_variant_at(span: Span): bool {
    while d in &self.diags.items {
        val at = d.primary.span
        if at.file_id == span.file_id && at.start == span.start && d.primary.message.starts_with("no variant") {
            return true
        }
    }
    return false
}
