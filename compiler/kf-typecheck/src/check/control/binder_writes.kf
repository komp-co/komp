// Whether a `when` arm writes through one of its binders, decided before the
// body is checked, since the answer sets the binder's type.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.coerce_written_amp_var
import kf_core.ast.statement.Stmt
import kf_core.span.no_span
import kf_typecheck.check.*
import kf_typecheck.types.TAG_REF
import kf_typecheck.types.kind_tag
import kf_typecheck.types.type_eq

/// How an arm may reach its subject: not at all when it is a temporary, else
/// through a shared or a mutable borrow.
pub enum SubjectAccess {
    Temporary
    Shared
    Mutable
}

pub fun Expr.subject_access(ctx: &var TypeCtx): SubjectAccess {
    when (self.ty.kind) {
        RefTo(mutable, _) => return if mutable { SubjectAccess.Mutable } else { SubjectAccess.Shared }
        _ => {}
    }
    if self.place_root_name().as_str() == "" { return SubjectAccess.Temporary }
    return if self.place_is_mutable(ctx) { SubjectAccess.Mutable } else { SubjectAccess.Shared }
}

/// A binder the body writes through is a reference to its payload, so the
/// write reaches the subject. Over a temporary, or a subject the arm may not
/// write, it stays a copy.
pub mutating fun Arm.bind_written_binders(access: SubjectAccess, ctx: &var TypeCtx): void {
    val mutable = when (access) {
        Mutable => true
        _ => false
    }
    if !mutable { return }
    val names = self.pattern.direct_binders()
    while b in &names {
        if b.as_str() == "_" { continue }
        val ty = ctx.lookup(b.as_str())
        if ty.is_poison() || ty.reaches_its_pointee() { continue }
        if !self.body.writes_through(b.as_str(), &ty, ctx) { continue }
        ctx.declare(b.as_string(), borrow_of(ty.clone(), true, self.span))
        ctx.ref_binders.push(b.as_string())
        self.ref_binders.push(b)
    }
}

/// A pointer, box or borrow reaches what it points at from a copy.
fun Type.reaches_its_pointee(): bool {
    return when (self.kind) {
        RefTo(_, _) => true
        PtrTo(_) => true
        BoxOf(_) => true
        _ => false
    }
}

/// The names a pattern binds directly: the whole subject, or a variant's
/// payloads.
pub fun Pattern.direct_binders(): List<Sym> {
    var out = List.new<Sym>()
    when (self.kind) {
        Identifier(name) => out.push(name)
        Variant(_, payloads) => {
            while sub in &payloads {
                when (sub.kind) {
                    Identifier(name) => out.push(name)
                    _ => {}
                }
            }
        }
        _ => {}
    }
    return out
}

/// A mutating call on `name` or a field path under it, a store into a place
/// rooted at it, or a written `&var` of one. `ty` is the binder's type.
pub fun List<Stmt>.writes_through(name: str, ty: &Type, ctx: &var TypeCtx): bool {
    while s in &self {
        if s.stmt_writes_through(name, ty, ctx) { return true }
    }
    return false
}

fun Stmt.stmt_writes_through(name: str, ty: &Type, ctx: &var TypeCtx): bool {
    return when (self.kind) {
        LetVal(_n, _t, init) => opt_writes_through(&init, name, ty, ctx)
        LetVar(_n, _t, init) => opt_writes_through(&init, name, ty, ctx)
        Assign(_n, value) => value.expr_writes_through(name, ty, ctx)
        AssignTo(place, value) => place.rooted_at(name) || value.expr_writes_through(name, ty, ctx)
        Return(value) => opt_writes_through(&value, name, ty, ctx)
        If(c, then_body, else_body) => {
            c.expr_writes_through(name, ty, ctx) || then_body.writes_through(name, ty, ctx) ||
                else_body.writes_through(name, ty, ctx)
        }
        While(c, body) => c.expr_writes_through(name, ty, ctx) || body.writes_through(name, ty, ctx)
        ForEach(_b, subject, body) => subject.expr_writes_through(name, ty, ctx) || body.writes_through(name, ty, ctx)
        When(subject, arms) => subject.expr_writes_through(name, ty, ctx) || arms.arms_write_through(name, ty, ctx)
        Expression(e) => e.expr_writes_through(name, ty, ctx)
        _ => false
    }
}

fun opt_writes_through(e: &Box<Expr>?, name: str, ty: &Type, ctx: &var TypeCtx): bool {
    return when (e) {
        Some(value) => value.expr_writes_through(name, ty, ctx)
        None => false
    }
}

fun List<Arm>.arms_write_through(name: str, ty: &Type, ctx: &var TypeCtx): bool {
    while arm in &self {
        if opt_writes_through(&arm.guard, name, ty, ctx) { return true }
        if arm.body.writes_through(name, ty, ctx) { return true }
    }
    return false
}

fun List<Expr>.args_write_through(name: str, ty: &Type, ctx: &var TypeCtx): bool {
    while a in &self {
        if a.expr_writes_through(name, ty, ctx) { return true }
    }
    return false
}

fun Expr.expr_writes_through(name: str, ty: &Type, ctx: &var TypeCtx): bool {
    if self.coerce == coerce_written_amp_var() && self.rooted_at(name) { return true }
    return when (self.kind) {
        MethodCall(recv, method, args) => {
            recv.receiver_is_mutated(method, args.size(), name, ty, ctx) || recv.expr_writes_through(name, ty, ctx) ||
                args.args_write_through(name, ty, ctx)
        }
        Call(_f, args) => args.args_write_through(name, ty, ctx)
        Intrinsic(_i, args) => args.args_write_through(name, ty, ctx)
        CallValue(_callee, args) => args.args_write_through(name, ty, ctx)
        Binary(l, _op, r) => l.expr_writes_through(name, ty, ctx) || r.expr_writes_through(name, ty, ctx)
        Unary(_op, inner) => inner.expr_writes_through(name, ty, ctx)
        Deref(inner) => inner.expr_writes_through(name, ty, ctx)
        FieldAccess(obj, _f) => obj.expr_writes_through(name, ty, ctx)
        IfExpr(c, t, e) => {
            c.expr_writes_through(name, ty, ctx) || t.expr_writes_through(name, ty, ctx) ||
                e.expr_writes_through(name, ty, ctx)
        }
        WhenExpr(subject, arms) => subject.expr_writes_through(name, ty, ctx) || arms.arms_write_through(name, ty, ctx)
        Cast(inner, _t) => inner.expr_writes_through(name, ty, ctx)
        Block(stmts) => stmts.writes_through(name, ty, ctx)
        _ => false
    }
}

/// `name.m()` or `name.f.g.m()` with `m` mutating on the receiver's type.
fun Expr.receiver_is_mutated(method: Sym, arity: uint64, name: str, ty: &Type, ctx: &var TypeCtx): bool {
    if !self.rooted_at(name) { return false }
    val recv_ty = self.path_type(name, ty, ctx) ?: return false
    return recv_ty.method_is_mutating(method.as_string(), arity, ctx)
}

/// The type at the end of a field path from `name`; None when a step cannot
/// be followed, which counts as no write.
fun Expr.path_type(name: str, ty: &Type, ctx: &var TypeCtx): Type? {
    when (self.kind) {
        Variable(_n) => return Option.Some(ty.clone())
        FieldAccess(obj, field) => {
            val base = obj.path_type(name, ty, ctx) ?: return null
            return base.field_type(field, ctx)
        }
        _ => return null
    }
}

/// Asked quietly: a field the body gets wrong is reported when it is checked.
fun Type.field_type(field: Sym, ctx: &var TypeCtx): Type? {
    val was_quiet = ctx.quiet
    ctx.quiet = true
    val found = check_field_access(self.clone(), field.as_string(), no_span(), ctx)
    ctx.quiet = was_quiet
    if found.is_poison() { return null }
    return Option.Some(found)
}

/// A place inside the value of the variable `name`: a field path from it. A
/// `*` leaves the value for what it points at.
fun Expr.rooted_at(name: str): bool {
    return when (self.kind) {
        Variable(n) => n.as_str() == name
        FieldAccess(obj, _f) => obj.rooted_at(name)
        _ => false
    }
}

/// A reference binder where its payload's type is wanted is read through:
/// `Full(c) => rebuild(c)` passes the payload, as when the binder was a copy.
pub mutating fun Expr.yield_ref_binder_value(expected: &Type, ctx: &var TypeCtx): bool {
    val name = when (self.kind) {
        Variable(n) => n.as_string()
        _ => String.from("")
    }
    if name.as_str() == "" || self.ty.kind.kind_tag() != TAG_REF() { return false }
    if !ctx.ref_binders.contains(&name) { return false }
    val payload = autoderef_ty(self.ty.clone())
    if !payload.type_eq(expected.clone()) { return false }
    var binder = Expr.new(self.span, ExprKind.Variable(intern(name.as_str())))
    binder.ty = self.ty.clone()
    binder.decl = self.decl
    self.kind = ExprKind.Deref(Box.new(binder))
    self.ty = payload
    return true
}
