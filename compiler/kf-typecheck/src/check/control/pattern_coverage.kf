// Whether an earlier arm's pattern matches every value a later one does, which
// makes the later arm unreachable.

import alloc.list.*

import kf_core.ast.Pattern

/// An alternation covers what any of its alternatives covers, and is covered
/// when each of its alternatives is.
fun Pattern.pattern_covers_pattern(later: &Pattern): bool {
    when (later.kind) {
        Or(alternatives) => {
            if alternatives.size() == 0 { return false }
            while alternative in &alternatives {
                if !self.pattern_covers_pattern(alternative) { return false }
            }
            return true
        }
        _ => { }
    }
    when (self.kind) {
        Or(alternatives) => {
            while alternative in &alternatives {
                if alternative.pattern_covers_pattern(later) { return true }
            }
            return false
        }
        Range(low, high, is_char) => return later.value_span_within(low, high, is_char)
        Wildcard => return !later.pattern_is_poison()
        Identifier(_) => return !later.pattern_is_poison()
        Variant(name, _) => return later.pattern_is_variant(name.as_str())
        LitInt(value) => return later.value_span_within(value, value, false)
        LitBool(value) => return later.pattern_is_bool(value)
        LitChar(value) => return later.value_span_within(value as int64, value as int64, true)
        LitStr(_) => return false
        StructPat(_, _, _) => return false
        Poison => return false
    }
}

/// An integer or char literal, or range, whose values all lie in
/// `low..=high` of the same kind.
fun Pattern.value_span_within(low: int64, high: int64, is_char: bool): bool {
    return when (self.kind) {
        LitInt(value) => !is_char && low <= value && value <= high
        LitChar(value) => is_char && low <= (value as int64) && (value as int64) <= high
        Range(first, last, char_range) => char_range == is_char && low <= first && last <= high
        _ => false
    }
}

fun Pattern.pattern_is_poison(): bool {
    return when (self.kind) {
        Poison => true
        _ => false
    }
}

fun Pattern.pattern_is_variant(name: str): bool {
    return when (self.kind) {
        Variant(other, _) => other.as_str().equals(name)
        _ => false
    }
}

fun Pattern.pattern_is_bool(value: bool): bool {
    return when (self.kind) {
        LitBool(other) => other == value
        _ => false
    }
}
