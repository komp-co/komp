// The variants no arm of a `when` covers. An uncovered value falls past the
// C switch, so this feeds both the missing-return analysis and the
// per-`when` error. A payload pattern (`Some(5)`) counts as covering its
// variant: a gap may be missed, but valid code is never rejected.

import alloc.list.*

import kf_core.ast.Arm
import kf_core.ast.Pattern
import kf_core.ast.types.Type
import kf_core.span.*
import kf_core.diagnostic.error_at
import kf_typecheck.types.type_is_uninhabited

/// In declaration order. Empty when exhaustive, when an arm is irrefutable,
/// or when the subject has no finite value set (see
/// `subject_needs_irrefutable_arm`). `bool` has two values and is judged here.
pub fun when_missing_variants(subject_ty: Type, arms: &List<Arm>, ctx: &var TypeCtx): List<String> {
    var missing = List.new<String>()
    if subject_ty.is_poison() { return missing }

    when (subject_ty.kind) {
        Bool => return missing_bool_values(arms)
        _ => {}
    }

    // Enums resolve to Struct(name); the sig table decides.
    val ename = subject_ty.kind.enum_or_struct_name()
    val layout = unsafe { (*ctx.sigs).find_enum(ename.as_str(), ctx.owner_crate) } ?: return missing

    if arms_have_irrefutable(arms) { return missing }
    // An arm naming a variant the enum lacks is already reported; what it
    // leaves uncovered follows from that.
    if arms_name_a_foreign_variant(arms, &layout) { return missing }

    while v in &layout.variants {
        if !variant_is_covered(v.name.as_str(), arms) && !v.cannot_be_built(ctx) {
            missing.push(String.from(v.name.as_str()))
        }
    }
    return missing
}

/// A variant holding a value of a type with no values, `Ok` of a
/// `Result<Never, E>`: no value of the enum is that variant, so no arm needs
/// to name it.
fun VariantInfo.cannot_be_built(ctx: &var TypeCtx): bool {
    while payload in &self.payloads {
        if payload.type_is_uninhabited(ctx) { return true }
    }
    return false
}

pub fun when_is_exhaustive(subject_ty: Type, arms: &List<Arm>, ctx: &var TypeCtx): bool {
    if subject_needs_irrefutable_arm(subject_ty) { return arms_have_irrefutable(arms) }
    return when_missing_variants(subject_ty, arms, ctx).size() == 0
}

/// Only an irrefutable arm covers it. Not `bool` or an enum.
fun subject_needs_irrefutable_arm(t: Type): bool {
    when (t.kind) {
        Bool => return false
        _ => {
            val frag = t.scalar_frag()
            return !frag.as_str().equals("")
        }
    }
}

/// An error at the `when`, naming what it leaves open; `_ =>` makes an
/// omission deliberate.
pub fun report_non_exhaustive_when(subject_ty: Type, arms: &List<Arm>, span: Span, ctx: &var TypeCtx): void {
    if subject_needs_irrefutable_arm(subject_ty) {
        if arms_have_irrefutable(arms) { return }
        var scalar_msg = String.from("non-exhaustive `when`: `")
        scalar_msg = scalar_msg + subject_ty.scalar_frag()
        scalar_msg = scalar_msg + String.from("` has more values than arms can list — add a `_ =>` arm")
        ctx.emit(error_at(span, scalar_msg))
        return
    }
    val missing = when_missing_variants(subject_ty, arms, ctx)
    if missing.size() == 0 { return }
    var msg = String.from("non-exhaustive `when`: ")
    msg = msg + quoted_variant_list(&missing)
    if missing.size() == 1 {
        msg = msg + String.from(" is not covered — add an arm for it")
    } else {
        msg = msg + String.from(" are not covered — add an arm for each")
    }
    msg = msg + String.from(", or `_ =>` to ignore the rest")
    ctx.emit(error_at(span, msg))
}

/// Arms fully covered by an earlier unguarded arm.
pub fun report_covered_when_arms(arms: &List<Arm>, ctx: &var TypeCtx): void {
    var i = 1
    while i < arms.size() {
        val arm = arms.at(i)
        val pattern = unsafe { &*arm.pattern }
        var j = 0
        while j < i {
            val earlier = arms.at(j)
            if !earlier.arm_has_guard() {
                val earlier_pattern = unsafe { &*earlier.pattern }
                if earlier_pattern.pattern_covers_pattern(pattern) {
                    ctx.emit(error_at(pattern.span, pattern.covered_arm_message()))
                    break
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

fun Pattern.covered_arm_message(): String {
    when (self.kind) {
        Variant(name, _) => return "`${name.as_str()}` is already covered by an earlier arm"
        LitBool(value) => {
            if value { return String.from("`true` is already covered by an earlier arm") }
            return String.from("`false` is already covered by an earlier arm")
        }
        _ => return String.from("this arm is already covered by an earlier arm")
    }
}

fun quoted_variant_list(names: &List<String>): String {
    var out = ""
    while i in 0..names.size() {
        if i > 0 { out = out + String.from(", ") }
        out = out + String.from("`") + *names.at(i) + String.from("`")
    }
    return out
}

/// A guard may be false, so the arm covers nothing.
fun Arm.arm_has_guard(): bool {
    return self.guard.is_some()
}

fun arms_have_irrefutable(arms: &List<Arm>): bool {
    while a in &arms {
        if !a.arm_has_guard() {
            if (unsafe { *a.pattern }).pattern_is_irrefutable() { return true }
        }
    }
    return false
}

/// `_`, or a binding: a variant-naming identifier was already rewritten.
fun Pattern.pattern_is_irrefutable(): bool {
    return when (self.kind) {
        Wildcard => true
        Identifier(_) => true
        Or(alts) => any_alt_is_irrefutable(&alts)
        LitInt(_) => false
        LitStr(_) => false
        LitBool(_) => false
        LitChar(_) => false
        Range(_, _, _) => false
        Variant(_, _) => false
        StructPat(_, _, _) => false
        Poison => false
    }
}

fun any_alt_is_irrefutable(alts: &List<Pattern>): bool {
    while alt in &alts {
        if (alt).pattern_is_irrefutable() { return true }
    }
    return false
}

fun arms_name_a_foreign_variant(arms: &List<Arm>, layout: &EnumLayout): bool {
    while a in &arms {
        val named = when ((unsafe { *a.pattern }).kind) {
            Variant(vname, _) => vname.as_string()
            _ => String.from("")
        }
        if !named.is_empty() && !layout.has_variant(named.as_str()) { return true }
    }
    return false
}

fun EnumLayout.has_variant(name: str): bool {
    while v in &self.variants {
        if v.name.as_str() == name { return true }
    }
    return false
}

fun variant_is_covered(name: str, arms: &List<Arm>): bool {
    while a in &arms {
        if !a.arm_has_guard() {
            if (unsafe { *a.pattern }).pattern_covers_variant(name) { return true }
        }
    }
    return false
}

fun Pattern.pattern_covers_variant(name: str): bool {
    return when (self.kind) {
        Variant(vname, _) => vname.as_str().equals(name)
        Or(alts) => any_alt_covers_variant(&alts, name)
        Wildcard => true
        Identifier(_) => true
        LitInt(_) => false
        LitStr(_) => false
        LitBool(_) => false
        LitChar(_) => false
        Range(_, _, _) => false
        StructPat(_, _, _) => false
        Poison => false
    }
}

fun any_alt_covers_variant(alts: &List<Pattern>, name: str): bool {
    while alt in &alts {
        if (alt).pattern_covers_variant(name) { return true }
    }
    return false
}

/// `true =>` alone is as incomplete as a missing variant.
fun missing_bool_values(arms: &List<Arm>): List<String> {
    var missing = List.new<String>()
    if !bool_value_is_covered(true, arms) { missing.push(String.from("true")) }
    if !bool_value_is_covered(false, arms) { missing.push(String.from("false")) }
    return missing
}

fun bool_value_is_covered(value: bool, arms: &List<Arm>): bool {
    while a in &arms {
        if !a.arm_has_guard() {
            if (unsafe { *a.pattern }).pattern_covers_bool(value) { return true }
        }
    }
    return false
}

fun Pattern.pattern_covers_bool(value: bool): bool {
    when (self.kind) {
        LitBool(b) => {
            if value { return b }
            return !b
        }
        Or(alts) => return any_alt_covers_bool(&alts, value)
        Wildcard => return true
        Identifier(_) => return true
        LitInt(_) => return false
        LitStr(_) => return false
        LitChar(_) => return false
        Range(_, _, _) => return false
        Variant(_, _) => return false
        StructPat(_, _, _) => return false
        Poison => return false
    }
}

fun any_alt_covers_bool(alts: &List<Pattern>, value: bool): bool {
    while alt in &alts {
        if (alt).pattern_covers_bool(value) { return true }
    }
    return false
}
