// `A | B =>`: each alternative is checked against the subject on its own, and
// none may bind, since a name bound by one would be unset when another
// matched.

import alloc.list.*

import kf_core.ast.Pattern
import kf_core.ast.types.Type
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic

pub fun check_alternatives(alternatives: &List<Pattern>, subject_ty: Type, ctx: &var TypeCtx): void {
    while alternative in &alternatives {
        if alternative.binds_a_name() {
            ctx.emit(new_diagnostic(Severity.Error, new_label(alternative.span, binding_alternative_message())))
        } else if alternative.is_string_literal() {
            val message = "a string alternative can only sit beside other strings"
            ctx.emit(new_diagnostic(Severity.Error, new_label(alternative.span, message)))
        } else {
            alternative.check_pattern(subject_ty, ctx)
        }
    }
}

fun binding_alternative_message(): String {
    return "an alternative in `A | B` cannot bind a name; split the arm, or bind the whole subject with a guard"
}

/// `x`, or a payload that binds one. `_` binds nothing.
fun Pattern.binds_a_name(): bool {
    when (self.kind) {
        Identifier(_) => return true
        Variant(_, payloads) => {
            while payload in &payloads {
                if payload.binds_a_name() { return true }
            }
            return false
        }
        StructPat(_, names, _) => return names.size() > 0
        Or(alternatives) => {
            while alternative in &alternatives {
                if alternative.binds_a_name() { return true }
            }
            return false
        }
        Wildcard => return false
        LitInt(_) => return false
        LitStr(_) => return false
        LitBool(_) => return false
        LitChar(_) => return false
        Range(_, _, _) => return false
        Poison => return false
    }
}

fun Pattern.is_string_literal(): bool {
    return when (self.kind) {
        LitStr(_) => true
        _ => false
    }
}

/// `"a"`, or `"a" | "b"` with every alternative a string: the texts a string
/// arm compares against. Null for anything else.
pub fun Pattern.string_texts(): List<String>? {
    when (self.kind) {
        LitStr(text) => {
            var texts = List.new<String>()
            texts.push(text.clone())
            return texts
        }
        Or(alternatives) => {
            var texts = List.new<String>()
            while alternative in &alternatives {
                when (alternative.kind) {
                    LitStr(text) => texts.push(text.clone())
                    _ => return null
                }
            }
            return texts
        }
        _ => return null
    }
}
