import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.span.no_span

fun guarded_arm(kind: PatternKind, guard: ExprKind): Arm {
    val pattern: Box<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pattern = new_pattern(no_span(), kind) }
    val guard_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *guard_ptr = new_expr(no_span(), guard) }
    return new_arm(no_span(), pattern, Option.Some<Box<Expr>>(guard_ptr), List.new<Stmt>())
}

fun guard_diags(subject_name: str, guard: ExprKind): List<Diagnostic> {
    var arms = List.new<Arm>()
    arms.push(guarded_arm(PatternKind.Identifier(intern("v")), guard))
    arms.push(coverage_arm(PatternKind.Wildcard, false))
    return coverage_diags(subject_name, arms, false)
}

@test fun a_bool_guard_is_accepted(): void {
    val diags = guard_diags("int32", ExprKind.LitBool(true))
    assert_eq(diags.size(), 0, "a bool guard needs no diagnostic")
}

@test fun a_guard_that_is_not_bool_is_rejected(): void {
    val diags = guard_diags("int32", ExprKind.LitInt(1))
    assert_eq(diags.size(), 1, "an integer guard is an error")
}

@test fun a_guard_reads_the_binder_at_the_subject_type(): void {
    val diags = guard_diags("int64", ExprKind.Variable(intern("v")))
    val expected = "a `when` guard must be a `bool`, found `int64`"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the binder is typed")
}

@test fun a_guard_reading_a_bool_binder_is_accepted(): void {
    val diags = guard_diags("bool", ExprKind.Variable(intern("v")))
    assert_eq(diags.size(), 0, "the binder is a bool")
}

fun literal_diags(subject_name: str, kind: PatternKind): List<Diagnostic> {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(kind, false))
    arms.push(coverage_arm(PatternKind.Wildcard, false))
    return coverage_diags(subject_name, arms, false)
}

@test fun an_integer_pattern_on_an_integer_is_accepted(): void {
    assert_eq(literal_diags("uint8", PatternKind.LitInt(3)).size(), 0, "3 fits a uint8")
}

@test fun an_integer_pattern_on_a_str_is_rejected(): void {
    val diags = literal_diags("str", PatternKind.LitInt(1))
    val expected = "this pattern is an integer, but the subject is `str`"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the mismatch is named")
}

@test fun a_char_pattern_on_an_integer_is_rejected(): void {
    assert_eq(literal_diags("int32", PatternKind.LitChar(97)).size(), 1, "'a' is not an int32")
}

@test fun a_bool_pattern_on_a_char_is_rejected(): void {
    assert_eq(literal_diags("char", PatternKind.LitBool(true)).size(), 1, "true is not a char")
}

@test fun a_char_pattern_on_a_char_is_accepted(): void {
    assert_eq(literal_diags("char", PatternKind.LitChar(97)).size(), 0, "'a' is a char")
}

@test fun a_string_pattern_on_an_integer_is_rejected(): void {
    val diags = literal_diags("int32", PatternKind.LitStr(String.from("three")))
    val expected = "this pattern is a string, but the subject is `int32`"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the mismatch is named")
}

@test fun a_string_pattern_on_a_str_is_accepted(): void {
    assert_eq(literal_diags("str", PatternKind.LitStr(String.from("get"))).size(), 0, "\"get\" is a str")
}

@test fun a_string_arm_does_not_close_the_when(): void {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.LitStr(String.from("get")), false))
    assert_eq(coverage_diags("str", arms, false).size(), 1, "a string arm covers nothing")
}

fun alternatives_of(first: PatternKind, second: PatternKind): PatternKind {
    var alternatives = List.new<Pattern>()
    alternatives.push(new_pattern(no_span(), first))
    alternatives.push(new_pattern(no_span(), second))
    return PatternKind.Or(alternatives)
}

@test fun a_binding_alternative_is_rejected(): void {
    val kind = alternatives_of(PatternKind.LitInt(1), PatternKind.Identifier(intern("x")))
    val diags = literal_diags("int32", kind)
    val expected = "an alternative in `A | B` cannot bind a name; split the arm, or bind the whole subject with a guard"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the binding alternative is named")
}

@test fun a_string_beside_an_integer_is_rejected(): void {
    val kind = alternatives_of(PatternKind.LitInt(1), PatternKind.LitStr(String.from("one")))
    assert_eq(literal_diags("int32", kind).size(), 1, "strings cannot mix with integers")
}

@test fun each_alternative_is_checked_against_the_subject(): void {
    val kind = alternatives_of(PatternKind.LitInt(1), PatternKind.LitChar(97))
    assert_eq(literal_diags("int32", kind).size(), 1, "'a' is not an int32")
}

@test fun string_alternatives_are_accepted(): void {
    val kind = alternatives_of(PatternKind.LitStr(String.from("a")), PatternKind.LitStr(String.from("b")))
    assert_eq(literal_diags("str", kind).size(), 0, "\"a\" | \"b\" over a str")
}

@test fun an_integer_range_on_a_char_is_rejected(): void {
    val diags = literal_diags("char", PatternKind.Range(97, 122, false))
    val expected = "this pattern is an integer range, but the subject is `char`"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "the range kind is named")
}

@test fun a_char_range_on_a_char_is_accepted(): void {
    assert_eq(literal_diags("char", PatternKind.Range(97, 122, true)).size(), 0, "'a'..='z' over a char")
}

@test fun alternatives_naming_every_variant_close_the_when(): void {
    var alternatives = List.new<Pattern>()
    alternatives.push(new_pattern(no_span(), PatternKind.Identifier(intern("Red"))))
    alternatives.push(new_pattern(no_span(), PatternKind.Identifier(intern("Green"))))
    alternatives.push(new_pattern(no_span(), PatternKind.Identifier(intern("Blue"))))
    var arms = List.new<Arm>()
    arms.push(coverage_arm(PatternKind.Or(alternatives), false))
    assert_eq(coverage_diags("Color", arms, true).size(), 0, "Red | Green | Blue is exhaustive")
}

fun covered_diags(first: PatternKind, second: PatternKind): List<Diagnostic> {
    var arms = List.new<Arm>()
    arms.push(coverage_arm(first, false))
    arms.push(coverage_arm(second, false))
    arms.push(coverage_arm(PatternKind.Wildcard, false))
    return coverage_diags("int32", arms, false)
}

@test fun a_value_inside_an_earlier_range_is_covered(): void {
    val diags = covered_diags(PatternKind.Range(0, 9, false), PatternKind.LitInt(5))
    val expected = "this arm is already covered by an earlier arm"
    assert_eq(diags.at(0).primary.message.as_str(), expected, "5 is inside 0..10")
}

@test fun a_range_inside_an_earlier_range_is_covered(): void {
    val diags = covered_diags(PatternKind.Range(0, 9, false), PatternKind.Range(2, 4, false))
    assert_eq(diags.size(), 1, "2..5 is inside 0..10")
}

@test fun an_overlapping_range_is_not_covered(): void {
    val diags = covered_diags(PatternKind.Range(0, 9, false), PatternKind.Range(5, 20, false))
    assert_eq(diags.size(), 0, "5..21 reaches past 0..10")
}

@test fun an_alternative_already_listed_is_covered(): void {
    val first = alternatives_of(PatternKind.LitInt(1), PatternKind.LitInt(2))
    assert_eq(covered_diags(first, PatternKind.LitInt(2)).size(), 1, "2 was an earlier alternative")
}

@test fun alternatives_each_covered_earlier_are_covered(): void {
    val later = alternatives_of(PatternKind.LitInt(3), PatternKind.LitInt(7))
    assert_eq(covered_diags(PatternKind.Range(0, 9, false), later).size(), 1, "3 | 7 lies inside 0..10")
}
