// `xs.m()` where `xs`, an array or a list, has no `m` but its slice does,
// declared or by extension: the receiver lends itself, so `xs.sort()` reads as
// `xs.as_slice_mut().sort()`.

import alloc.list.*

import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_typecheck.types.resolve_type_ref

/// Lends the shared slice when it has `method`, else the mutable one.
mutating fun Expr.lend_receiver_as_slice(method: str, ctx: &var TypeCtx): void {
    if self.ty.is_poison() { return }
    val source = self.ty.deref_one()
    val shared = source.sliceable_element("as_slice", ctx) ?: return
    if self.ty.has_method_named(method, ctx) { return }
    val slice_name = ctx.slice_name()
    val slice = shared.slice_of(slice_name.as_str(), self, ctx)
    if slice.has_method_named(method, ctx) {
        self.become_lend_call("as_slice", ctx)
        return
    }
    val element = source.sliceable_element("as_slice_mut", ctx) ?: return
    val slice_mut_name = ctx.slice_mut_name()
    val slice_mut = element.slice_of(slice_mut_name.as_str(), self, ctx)
    if !slice_mut.has_method_named(method, ctx) { return }
    if !self.lends_mutably(&slice_mut, ctx) {
        self.ty = Type.new_poison()
        return
    }
    self.become_lend_call("as_slice_mut", ctx)
}

/// `base<self>`, a slice of `self`.
fun Type.slice_of(base: str, at: &Expr, ctx: &var TypeCtx): Type {
    var args = List.new<TypeRef>()
    args.push(self.written_instance(at.span, ctx))
    return TypeRef.new(at.span, TypeRefKind.Named(intern(base), args)).resolve_type_ref(ctx)
}

fun Type.has_method_named(method: str, ctx: &var TypeCtx): bool {
    if receiver_has_own_method(self.clone(), String.from(method), ctx) { return true }
    return has_extension_named(method, ctx) && fitting_extensions(method, self, ctx).size() > 0
}
