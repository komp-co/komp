// The inferred-type-argument write-back: the name written must re-resolve and
// mangle to a C identifier.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.*
import kf_typecheck.types.type_ref_is_poison

// A canonical identity `crate::module::Name` is not a C identifier and must
// not be written back. Twin of kf-mono's ty_to_mangle_hides_canonical_identity.
@test fun flat_ref_name_hides_canonical_identity(): void {
    val identity = TypeIdentity.new(new_crate_id("kf_core"), intern("span"), intern("SourceMap"))
    val n: String = ty_flat_ref_name(&named_struct_ty(identity, no_span()))
    assert_eq(n.as_str(), "SourceMap", "the write-back name omits the semantic identity")
}

// `List__int32` cannot be written back flat; the guard survives stripping.
@test fun flat_ref_name_declines_a_monomorphized_instance(): void {
    val identity = TypeIdentity.new(new_crate_id("alloc"), intern("list"), intern("List__int32"))
    val n: String = ty_flat_ref_name(&named_struct_ty(identity, no_span()))
    assert_eq(n.as_str(), "", "a mono-suffixed instance is not writable flat")
}

// A borrow has a structural spelling, not a flat one; without it every type
// arg on the call was dropped.
@test fun written_ref_spells_a_borrow_structurally(): void {
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = Type.new_int32(no_span()) }
    val borrowed = Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Inferred(no_span()) }

    val flat: String = borrowed.ty_flat_ref_name()
    assert_eq(flat.as_str(), "", "a borrow still has no flat name")

    val tr: TypeRef = borrowed.ty_written_ref(no_span(), unsafe { 0 as Ptr<SigTable> })
    assert_eq(tr.type_ref_is_poison(), false, "and is written back anyway")
    var is_reference = false
    when (tr.kind) {
        Reference(_mutable, _inner) => is_reference = true
        _ => { }
    }
    assert_eq(is_reference, true, "as a Reference, not a Named")
}

// `&T` and `&var T` stamp differently.
@test fun written_ref_carries_mutability(): void {
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = Type.new_int32(no_span()) }
    val mutable = Type { kind: TypeKind.RefTo(true, inner), provenance: Provenance.Inferred(no_span()) }

    val tr: TypeRef = mutable.ty_written_ref(no_span(), unsafe { 0 as Ptr<SigTable> })
    var saw_mutable = false
    when (tr.kind) {
        Reference(m, _inner) => saw_mutable = m
        _ => { }
    }
    assert_eq(saw_mutable, true, "a `&var` binding stamps as mutable")
}

// A generic instance is spelled as its template and arguments.
@test fun written_ref_spells_an_instance_as_its_template(): void {
    var ctx = mk_ctx()
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    val inst = GenericInst { mangled: String.from("Wrap__int32"), base: String.from("Wrap"), args: args }
    unsafe { ctx.sigs.insert_inst(inst) }
    val wrapped = Type { kind: TypeKind.Struct(intern("Wrap__int32")), provenance: Provenance.Inferred(no_span()) }

    val tr: TypeRef = wrapped.ty_written_ref(no_span(), ctx.sigs)
    var spelled = ""
    var arity: uint64 = 0
    when (tr.kind) {
        Named(name, written) => {
            spelled = name.as_string()
            arity = written.size()
        }
        _ => { }
    }
    assert_eq(spelled.as_str(), "Wrap", "the template, not the mangled instance")
    assert_eq(arity, 1, "with its argument")

    val pair = TypeKind.Struct(intern("Pair__int32__bool"))
    val unknown = Type { kind: pair, provenance: Provenance.Inferred(no_span()) }
    val unspelled = (&unknown.ty_written_ref(no_span(), ctx.sigs)).type_ref_is_poison()
    assert_eq(unspelled, true, "an unregistered instance has no spelling")
}
