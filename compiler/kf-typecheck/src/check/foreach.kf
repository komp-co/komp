// `while name in subject { body }`, the general path; integer ranges use
// foreach_counted.kf.

import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_core.span.Span
import kf_typecheck.types.display_type
import kf_typecheck.types.kind_tag
import kf_typecheck.types.TAG_ARRAY

/// The subject must implement `Iterable`, or it reaches cc as an undeclared
/// call. Expanded here, not in Lower, because the synthesized `iter()` and
/// `next()` calls must be resolved and typed.
mutating fun Stmt.check_foreach(binder: Sym, subj_ptr: Ptr<Expr>, body: List<Stmt>, span: Span, ctx: &var TypeCtx): void {
    // The written `&` tells `while x in &xs` from `while x in xs`.
    val borrowed = is_written_borrow(unsafe { subj_ptr.coerce })
    // The parser's shape, before the callee is rewritten.
    val counted = is_counted_range(unsafe { &*subj_ptr })
    check_expr(unsafe { &var *subj_ptr }, ctx)
    val subj = unsafe { *subj_ptr }
    if counted && !borrowed {
        val bounds = subj.counted_range_bounds()
        if bounds.size() == 2 {
            val lo = *bounds.at(0)
            if lo.counted_range_is_integer() {
                unsafe { self.kind = expand_foreach_counted(binder, lo, *bounds.at(1), body, span) }
                self.check_stmt(ctx)
                return
            }
        }
    }
    if !subj.ty.is_poison() {
        val subject = subj.ty.iterable_subject_ty()
        val base = subject.ty_base_name()
        val sp = ctx.sigs
        val iterable = ctx.lang_trait_name(lang_iterable_key()).as_str()
        // An array's `iter()` is its own.
        val is_array = subject.kind.kind_tag() == TAG_ARRAY()
        val implements = is_array || unsafe { sp.type_implements_any(base.as_str(), iterable) }
        if !implements && !subject.bounded_by_iterable(ctx) {
            // Names the type as written: `&List<int32>`, not `List__int32`.
            var msg = String.from("type `")
            msg.append(subj.ty.display_type(ctx).as_str())
            msg.append("` cannot be iterated: `while ")
            msg.append(binder.as_string().as_str())
            msg.append(" in ...` needs `impl Iterable` for it")
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
            return
        }
    }
    if borrowed {
        if !subj.ty.is_poison() {
            if !subj.ty.borrowing_iterator_exists(ctx) {
                subj.ty.report_no_borrowing_iterator(binder, span, ctx)
                return
            }
        }
        unsafe { self.kind = expand_foreach_ref(binder, subj_ptr, body, span) }
    } else {
        unsafe { self.kind = expand_foreach(binder, subj_ptr, body, span) }
    }
    self.check_stmt(ctx)
}

/// The subject without borrow layers, as method calls see it.
fun Type.iterable_subject_ty(): Type {
    return when (self.kind) {
        RefTo(_m, p) => iterable_subject_ty(unsafe { &*p })
        _ => (*self)
    }
}

/// `while name in subject { body }` becomes:
///
///     if true {
///         var __forit_N = (subject).iter()
///         while true {
///             val __foropt_N = __forit_N.next()
///             when (__foropt_N) { Some(name) => body   None => break }
///         }
///     }
///
/// Temps are named from the loop's span, so nested loops do not collide.
fun expand_foreach(binder: Sym, subj_ptr: Ptr<Expr>, body: List<Stmt>, span: Span): StmtKind {
    val tag = foreach_tag(span)
    val itname = "__forit_${tag}"
    val optname = "__foropt_${tag}"

    val iter_call = new_expr(span, ExprKind.MethodCall(subj_ptr, intern("iter"), List.new<Expr>()))
    val iter_call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *iter_call_ptr = iter_call }
    val let_it = new_stmt(span, StmtKind.LetVar(intern(itname.as_str()), null, iter_call_ptr))

    val it_var_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *it_var_box = new_expr(span, ExprKind.Variable(intern(itname.as_str()))) }
    val next_call = new_expr(span, ExprKind.MethodCall(it_var_box, intern("next"), List.new<Expr>()))
    val next_call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *next_call_ptr = next_call }
    val let_opt = new_stmt(span, StmtKind.LetVal(intern(optname.as_str()), null, next_call_ptr))

    var some_payloads = List.new<Pattern>()
    some_payloads.push(new_pattern(span, PatternKind.Identifier(binder)))
    val some_pat_box: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *some_pat_box = new_pattern(span, PatternKind.Variant(intern("Some"), some_payloads)) }
    val some_arm = new_arm(span, some_pat_box, null, body)

    var none_body = List.new<Stmt>()
    none_body.push(new_stmt(span, StmtKind.Break))
    val none_pat_box: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *none_pat_box = new_pattern(span, PatternKind.Variant(intern("None"), List.new<Pattern>())) }
    val none_arm = new_arm(span, none_pat_box, null, none_body)

    var arms = List.new<Arm>()
    arms.push(some_arm)
    arms.push(none_arm)
    val opt_subj_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *opt_subj_box = new_expr(span, ExprKind.Variable(intern(optname.as_str()))) }
    val when_stmt = new_stmt(span, StmtKind.When(opt_subj_box, arms))

    var while_body = List.new<Stmt>()
    while_body.push(let_opt)
    while_body.push(when_stmt)
    val while_cond_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *while_cond_box = new_expr(span, ExprKind.LitBool(true)) }
    val while_stmt = new_stmt(span, StmtKind.While(while_cond_box, while_body))

    var if_body = List.new<Stmt>()
    if_body.push(let_it)
    if_body.push(while_stmt)
    val if_cond_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *if_cond_box = new_expr(span, ExprKind.LitBool(true)) }
    return StmtKind.If(if_cond_box, if_body, List.new<Stmt>())
}
