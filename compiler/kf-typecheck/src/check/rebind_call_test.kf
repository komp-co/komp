// Which type arguments a slot can read back out of a generic call. The rule's
// failure mode is a call silently stamped with the wrong instance, so it is
// pinned here.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.types.mangle_type
import kf_typecheck.leaked_diagnostics

/// `fun range<T>(start: T, end: T, step: T): Range<T>`.
fun range_signature(): FnSignature {
    var params = List.new<Type>()
    params.push(Type.new_generic(String.from("T"), no_span()))
    params.push(Type.new_generic(String.from("T"), no_span()))
    params.push(Type.new_generic(String.from("T"), no_span()))
    var generics = List.new<String>()
    generics.push(String.from("T"))
    return FnSignature {
        name: String.from("range"),
        params: params,
        ret: Type { kind: TypeKind.Struct(intern("Range__T")), provenance: Provenance.Declared(no_span()) },
        generics: generics,
        is_static: false,
        is_mutating: false,
        owner_module: intern("core.range"),
        owner_crate: new_crate_id("core"),
        is_pub: true,
        borrows: 0 - 1,
        is_prelude: false,
        is_extern: false
    }
}

fun range_literal_call(): Expr {
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(0)))
    args.push(Expr.new(no_span(), ExprKind.LitInt(2)))
    args.push(Expr.new(no_span(), ExprKind.LitInt(1)))
    var call = Expr.new(no_span(), ExprKind.Call(intern("range"), args))
    // What bottom-up inference settled on and stamped.
    call.ty = Type { kind: TypeKind.Struct(intern("Range__int32")), provenance: Provenance.Inferred(no_span()) }
    var written = List.new<TypeRef>()
    written.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    call.type_args = written
    return call
}

fun named_ty(n: str): Type {
    return Type { kind: TypeKind.Struct(intern(n)), provenance: Provenance.Declared(no_span()) }
}

/// As mangled names; empty means the call cannot be that type.
fun bindings_for(want: Type, mark_written: bool): List<String> {
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert(range_signature()) }

    var ctx = new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, Option.None, signatures)
    ctx.owner_crate = new_crate_id("core")
    ctx.owner_module = intern("core.range")

    var call = range_literal_call()
    call.type_args_written = mark_written
    val bound = call.rebound_call_bindings(&want, &var ctx)

    var out = List.new<String>()
    while item in &bound {
        out.push(mangle_type(item))
    }
    return out
}

@test
fun a_slot_reads_its_own_type_argument_out_of_a_range_literal(): void {
    val bound = bindings_for(named_ty("Range__uint64"), false)
    assert_eq(bound.size(), 1, "the one declared generic is bound")
    assert_eq(bound.at(0).as_str(), "uint64", "and bound to what the slot asked for, not what the literals said")
}

// A binding is usable only when the substituted return reproduces the slot.
@test
fun an_unrelated_slot_reads_nothing_out_of_a_range_literal(): void {
    assert_eq(bindings_for(named_ty("List__uint64"), false).size(), 0, "a different template binds nothing")
    assert_eq(bindings_for(Type.new_int32(no_span()), false).size(), 0, "and neither does a type that is not an instance at all")
}

// A slot matching the call already has nothing to say.
@test
fun the_slot_the_call_already_matches_is_still_answered(): void {
    val bound = bindings_for(named_ty("Range__int32"), false)
    assert_eq(bound.size(), 1, "the binding is readable")
    assert_eq(bound.at(0).as_str(), "int32", "and is the one already in force")
}

// A written annotation outranks the slot: a mismatch to report.
@test
fun a_written_type_argument_is_not_second_guessed(): void {
    assert_eq(bindings_for(named_ty("Range__uint64"), true).size(), 0, "a written annotation is left alone")
}
