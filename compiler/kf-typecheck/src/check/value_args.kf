// A generic's arguments against its parameters: a value parameter takes an
// integer that fits its type, and a type parameter takes a type.

import alloc.list.*

import kf_core.ast.is_integer_type_name
import kf_core.ast.value_type
import kf_core.ast.types.TypeRef
import kf_core.diagnostic.error_at
import kf_typecheck.types.display_type_ref
import kf_typecheck.check.decl.bare_name

/// False, having reported, when an argument is the wrong kind or does not fit.
pub fun check_generic_arg_kinds(owner: str, params: &List<String>, args: &List<TypeRef>, ctx: &var TypeCtx): bool {
    var ok = true
    var i: uint64 = 0
    while i < params.size() && i < args.size() {
        val param = params.at(i)
        val arg = args.at(i)
        val value_type = ctx.value_param_type(owner, param.as_str())
        if value_type != null {
            val written = value_type!!
            if !arg.fits_value_param(owner, param.as_str(), &written, params, args, ctx) { ok = false }
        } else if arg.is_value_argument(ctx) {
            val shown = arg.shown_argument()
            val message = "`${shown}` is a value, but `${param}` on `${ctx.shown_owner(owner)}` takes a type"
            ctx.emit(error_at(arg.span, message))
            ok = false
        }
        i = i + 1
    }
    return ok
}

/// The type `owner`'s parameter `param` holds, or None for a type parameter.
pub fun TypeCtx.value_param_type(owner: str, param: str): TypeRef? {
    val found = self.value_params_of(owner)
    while info in &found {
        if info.param.as_str() == param { return info.ty.clone() }
    }
    return null
}

pub fun TypeCtx.value_params_of(owner: str): List<ValueParamInfo> {
    var out = List.new<ValueParamInfo>()
    val all = unsafe { &(*self.sigs).value_params }
    while info in &all {
        if info.owner.as_str() == owner { out.push(info.clone()) }
    }
    return out
}

/// A literal value, or the name of the enclosing function's value parameter.
fun TypeRef.is_value_argument(ctx: &TypeCtx): bool {
    return when (self.kind) {
        Value(_v) => true
        Named(name, args) => args.size() == 0 && ctx.value_param_type(ctx.fn_owner.as_str(), name.as_str()) != null
        _ => false
    }
}

fun TypeRef.names_generic_in_scope(ctx: &TypeCtx): bool {
    val name = self.bare_name()
    while g in &ctx.generics {
        if g.as_str() == name.as_str() { return true }
    }
    return false
}

fun TypeRef.fits_value_param(owner: str, param: str, written: &TypeRef, params: &List<String>, args: &List<TypeRef>,
    ctx: &var TypeCtx): bool {
    val value = self.value_argument()
    if self.is_wildcard() {
        val message = String.from("the array's length is left out here; only a binding initialized by a literal ") +
            String.from("or another array can leave it out, and any length is taken as a slice, `&T[]`")
        ctx.emit(error_at(self.span, message))
        return false
    }
    if value == null {
        // A parameter of the enclosing scope; its instances are checked.
        if self.names_generic_in_scope(ctx) { return true }
        val found = self.shown_argument()
        val message = "`${param}` on `${ctx.shown_owner(owner)}` takes a value, found the type `${found}`"
        ctx.emit(error_at(self.span, message))
        return false
    }
    val holder = written.integer_type_among(params, args) ?: return true
    val v = value ?: 0
    if !is_integer_type_name(holder.as_str()) {
        val message = "`${param}` on `${ctx.shown_owner(owner)}` is a value of type `${written.shown_argument()}`, " +
            "which must be a primitive integer type, not `${holder}`"
        ctx.emit(error_at(self.span, message))
        return false
    }
    if !fits_integer_type(v, holder.as_str()) {
        val message = "`${v}` does not fit in `${holder}`, the type of `${param}` on `${ctx.shown_owner(owner)}`"
        ctx.emit(error_at(self.span, message))
        return false
    }
    return true
}

/// The type name a value parameter's `written` type stands for here: itself,
/// or the argument given for the sibling parameter it names. None when that
/// argument is still a parameter of the enclosing scope.
fun TypeRef.integer_type_among(params: &List<String>, args: &List<TypeRef>): String? {
    val name = self.bare_name()
    if name.byte_len() == 0 { return null }
    if is_integer_type_name(name.as_str()) { return name }
    while j in 0..params.size() {
        if params.at(j).as_str() == name.as_str() && j < args.size() {
            val given = args.at(j).bare_name()
            if given.byte_len() > 0 { return given }
            return args.at(j).shown_argument()
        }
    }
    return null
}

pub fun fits_integer_type(v: int64, name: str): bool {
    val int32_min: int64 = -2147483648
    val uint32_max: int64 = 4294967295
    return when name {
        "int8" => v >= -128 && v <= 127
        "int16" => v >= -32768 && v <= 32767
        "int32" => v >= int32_min && v <= 2147483647
        "uint8" => v >= 0 && v <= 255
        "uint16" => v >= 0 && v <= 65535
        "uint32" => v >= 0 && v <= uint32_max
        "uint64" => v >= 0
        _ => true
    }
}

fun TypeRef.value_argument(): int64? {
    return when (self.kind) {
        Value(v) => v
        _ => null
    }
}

fun TypeRef.shown_argument(): String {
    return when (self.kind) {
        Value(v) => "${v}"
        _ => self.display_type_ref()
    }
}

fun TypeCtx.shown_owner(owner: str): String {
    return unsafe { (*self.sigs).surface_name(owner) }
}
