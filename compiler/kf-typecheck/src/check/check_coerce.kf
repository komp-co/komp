// Coercion codes, mangled-name helpers and call-argument preparation.

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.str_list_has
import kf_core.runtime.runtime_function_returns

fun is_box_new_recv(recv_kind: ExprKind, method_name: String): bool {
    val is_new = method_name.as_str().equals("new")
    if !is_new { return false }
    return when (recv_kind) {
        Variable(vn) => vn.as_str().equals("Box")
        _ => false
    }
}

// The type a Variable receiver names, or "": the sign of `Type.method(...)`.
fun static_recv_type_name(recv_kind: ExprKind, ctx: &var TypeCtx): String {
    when (recv_kind) {
        Variable(n) => {
            // A local shadows a type of its name.
            if ctx.is_declared(n.as_str()) { return "" }
            val sp = ctx.sigs
            val sptr = unsafe { sp.find_struct(n.as_str(), ctx.owner_crate) }
            if sptr.is_some() { return n.as_string() }
            val eptr = unsafe { sp.find_enum(n.as_str(), ctx.owner_crate) }
            if eptr.is_some() { return n.as_string() }
            // A primitive (`int32.max_value()`) is in neither registry.
            if is_runtime_type_name(n.as_str()) { return n.as_string() }
            if is_container_type_name(n.as_str(), ctx.list_name(), ctx.option_name()) { return n.as_string() }
            return ""
        }
        _ => return ""
    }
}

/// `Trait.method(value, ...)`: trait-qualified dispatch, looked up among
/// traits.
fun trait_recv_name(recv_kind: ExprKind, ctx: &var TypeCtx): String {
    when (recv_kind) {
        Variable(n) => {
            if ctx.is_declared(n.as_str()) { return "" }
            val tp = unsafe { (*ctx.sigs).find_trait(n.as_str()) }
            if tp.is_some() { return n.as_string() }
            return ""
        }
        _ => return ""
    }
}

// A generic parameter in scope as a static receiver (`T.from(v)`): marked
// static with a placeholder callee Mono rewrites once `T` is known.
fun generic_static_recv_name(recv_kind: ExprKind, ctx: &var TypeCtx): String {
    when (recv_kind) {
        Variable(n) => {
            if str_list_has(&ctx.generics, n.as_str()) { return n.as_string() }
            return ""
        }
        _ => return ""
    }
}

// `Enum.method(...)` naming a variant is a constructor, not a static call.
fun enum_name_has_variant(ename: String, method: String, ctx: &var TypeCtx): bool {
    val sp = ctx.sigs
    val layout = unsafe { sp.find_enum(ename.as_str(), ctx.owner_crate) } ?: return false
    while variant in &layout.variants {
        if variant.name.as_str().equals(method.as_str()) { return true }
    }
    return false
}

fun name_starts_with(name: String, prefix: str): bool {
    val s = name.as_str()
    val n = s.byte_len()
    val pn = prefix.byte_len()
    if n < pn { return false }
    var i = 0
    while i < pn {
        val a = s.byte_at(i)
        val b = prefix.byte_at(i)
        if a != b { return false }
        i = i + 1
    }
    return true
}

pub fun mangle_suffix(name: String, cut: uint64): String {
    val s = name.as_str()
    val n = s.byte_len()
    return s.substring(cut, n)
}

/// A mangle fragment back to a Type, resolved against the enclosing generic
/// scope first: inside `fun pick<T>`, the `T` in `List__T` is the parameter,
/// not `Struct("T")`. Primitive names map to primitives; anything else is a
/// struct whose C name is the fragment.
pub fun ty_from_frag_in_scope(frag: String, span: Span, ctx: &var TypeCtx): Type {
    if str_list_has(&ctx.generics, frag.as_str()) { return generic_ty(frag, span) }
    val borrowed = borrow_frag_inner(frag.as_str())
    if borrowed.byte_len() > 0 {
        return borrow_of(ty_from_frag_in_scope(borrowed, span, ctx), borrow_frag_is_mut(frag.as_str()), span)
    }
    val function = ctx.fn_type_for(frag.as_str())
    if function != null { return function!! }
    val array = array_frag_parts(frag.as_str())
    if array != null { return array_ty(ty_from_frag_in_scope(array!!.element, span, ctx), array!!.length, span) }
    return ty_from_mangle_frag(frag, span, ctx.string_name())
}

pub fun ty_from_mangle_frag(frag: String, span: Span, string_name: Sym): Type {
    val s = frag.as_str()
    val borrowed = borrow_frag_inner(s)
    if borrowed.byte_len() > 0 {
        return borrow_of(ty_from_mangle_frag(borrowed, span, string_name), borrow_frag_is_mut(s), span)
    }
    val array = array_frag_parts(s)
    if array != null { return array_ty(ty_from_mangle_frag(array!!.element, span, string_name), array!!.length, span) }
    when s {
        "int8" => return Type { kind: TypeKind.Int8, provenance: Provenance.Inferred(span) }
        "int16" => return Type { kind: TypeKind.Int16, provenance: Provenance.Inferred(span) }
        "int32" => return int32_ty(span)
        "int64" => return Type { kind: TypeKind.Int64, provenance: Provenance.Inferred(span) }
        "uint8" => return Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(span) }
        "uint16" => return Type { kind: TypeKind.UInt16, provenance: Provenance.Inferred(span) }
        "uint32" => return Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(span) }
        "uint64" => return Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(span) }
        "float32" => return Type { kind: TypeKind.Float32, provenance: Provenance.Inferred(span) }
        "float64" => return Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(span) }
        "bool" => return bool_ty(span)
        _ => { }
    }
    // `List__String` elements dispatch through String; `List__str` elements
    // are `StrTy`.
    if is_lang_name(s, string_name) { return string_name.lang_struct_ty(span) }
    if s.equals("str") { return str_ty(span) }
    return Type { kind: TypeKind.Struct(intern(frag.as_str())), provenance: Provenance.Inferred(span) }
}

fun expr_is_lit_str(e: Expr): bool {
    return when (e.kind) {
        LitStr(_) => true
        _ => false
    }
}

fun Type.str_slot_wants_string(string_name: Sym): bool {
    if self.is_lang_struct(string_name) { return true }
    return self.shared_borrow_of_string(string_name)
}

/// A `str` value in a `String` slot copies onto the heap, so it must be
/// written out. A literal is not a conversion: the slot picks its type.
mutating fun Expr.reject_str_value_to_string(ctx: &var TypeCtx): void {
    val message = String.from("a `str` value does not become a `String` on its own") +
        String.from(" — the conversion copies the text onto the heap, so write") +
        String.from(" `String.from(...)`")
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = poison_ty()
}

// The coercion a value of `from` needs in a slot of `to`. A `String` or
// literal in a `str` slot renders as a `const char*`.
fun coerce_code_for(from: Type, is_lit: bool, to: Type, string_name: Sym): uint8 {
    val to_tag = to.kind.kind_tag()
    // A poison `from` is never coerced: type_eq would match it to anything.
    if from.is_poison() { return coerce_none() }
    if to_tag == TAG_STR() {
        if (&from).is_lang_struct(string_name) { return coerce_to_cstr() }
        if is_lit { return coerce_to_cstr() }
        return coerce_none()
    }
    if to_tag == TAG_PTR() || to_tag == TAG_REF() {
        // Borrow by default: a value in a pointer or reference slot takes its
        // address. `&T`, `&var T` and `Ptr<T>` all resolve to PtrTo.
        val pointee = deref_target(to)
        if from.type_eq(pointee) { return coerce_addr_of() }
        return coerce_none()
    }
    return coerce_none()
}

// `null` parses as a Variable and means None in an Option slot.
fun is_null_var(e: &Expr): bool {
    return when (e.kind) {
        Variable(name) => name.as_str().equals("null")
        _ => false
    }
}

/// A shared borrow of a `String`, which a string literal can fill.
pub fun Type.shared_borrow_of_string(string_name: Sym): bool {
    val shared = when (self.kind) {
        PtrTo(_) => true
        RefTo(is_mut, _) => !is_mut
        _ => false
    }
    val target = deref_target(self.clone())
    return shared && (&target).is_lang_struct(string_name)
}

pub fun deref_target(t: Type): Type {
    return when (t.kind) {
        PtrTo(p) => unsafe { *p }
        BoxOf(p) => unsafe { *p }
        RefTo(_, p) => unsafe { *p }
        _ => t
    }
}

// Poison when `name` is not a runtime function the table types; test
// assertions are declared extern and resolve through the sig table, which
// coerces literals to `str`.
fun runtime_intrinsic_ret(name: String, span: Span, string_name: Sym): Type {
    return when runtime_function_returns(name.as_str()).as_str() {
        "String" => string_name.lang_struct_ty(span)
        "str" => str_ty(span)
        "bool" => bool_ty(span)
        "void" => void_ty(span)
        "never" => never_ty(span)
        "int32" => int32_ty(span)
        "uint8" => Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(span) }
        "uint32" => Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(span) }
        "uint64" => Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(span) }
        _ => poison_ty()
    }
}
