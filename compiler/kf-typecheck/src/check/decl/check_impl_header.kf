// The impl header: the target name and the `<...>` after it. Checked for two
// holes that would otherwise surface in cc or ld:
//
//   * an unresolved target: `impl Default { }` (a trait), `impl NoSuchThing`,
//     or an inherent impl for another crate's type, which emits into that
//     crate's namespace;
//   * `Pair<int32, bool>` after the target declares two parameters named
//     `int32` and `bool`.
//
// Runs after identities and traits are registered, which tell the cases apart.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TypeParam
import kf_core.diagnostic.*
import kf_core.span.*
import kf_typecheck.*

/// Before anything reads an impl as a fact about its target.
pub fun Module.check_impl_headers(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    while decl in &self.decls {
        decl.check_impl_header(sig_ptr, diags)
    }
}

/// A non-impl is left alone.
pub fun TopDecl.check_impl_header(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (self.kind) {
        ImplBlock(_methods) => self.check_inherent_target(sig_ptr, diags)
        TraitImpl(tref, _members) => {
            self.check_trait_impl_target(sig_ptr, diags)
            self.check_trait_impl_args(unsafe { *tref }, sig_ptr, diags)
        }
        _ => return
    }
    self.reject_arguments_as_parameters(sig_ptr, diags)
}

/// `Iterator<T>` in `impl Iterator<T> for Rev<...>`: each name must be
/// declared by the impl or be a real type.
fun TopDecl.check_trait_impl_args(tref: TypeRef, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (tref.kind) {
        Named(_name, args) => {
            while arg in &args {
                arg.report_undeclared_trait_arg(self, sig_ptr, diags)
            }
        }
        _ => { }
    }
}

fun TypeRef.report_undeclared_trait_arg(td: &TopDecl, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    when (self.kind) {
        Named(name, sub_args) => {
            if sub_args.size() == 0 {
                if !trait_arg_is_declared(name.as_str(), td, sig_ptr) {
                    var m = String.from("unknown type `")
                    m.append(name.as_str())
                    m.append("` in an impl's trait arguments — declare it as an impl type parameter")
                    report_at(self.span, diags, m)
                }
            } else {
                while sub in &sub_args {
                    sub.report_undeclared_trait_arg(td, sig_ptr, diags)
                }
            }
        }
        Reference(_mutable, inner) => (unsafe { &*inner }).report_undeclared_trait_arg(td, sig_ptr, diags)
        _ => { }
    }
}

/// An impl type parameter, one its methods took from the trait's arguments,
/// a builtin, or a visible type.
fun trait_arg_is_declared(name: str, td: &TopDecl, sig_ptr: Ptr<SigTable>): bool {
    while tp in &td.generics {
        if tp.name.as_str().equals(name) { return true }
    }
    if td.lifts_trait_arg_param(name) { return true }
    if is_builtin_type_name(name) { return true }
    val identities = unsafe { &sig_ptr.type_identities }
    while identity in &identities {
        if identity.name.as_str().equals(name) { return true }
    }
    return unsafe { sig_ptr.find_generic_info(name, td.crate) }.is_some()
}

/// The target must be a type of this crate.
fun TopDecl.check_inherent_target(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    val name = self.name.as_str()
    if !self.target_names_a_type("an inherent impl needs a struct or enum declared in this crate", sig_ptr, diags) { return }
    // The owner decides: `String` is a builtin name core declares.
    val owner = target_owner(name, self, sig_ptr)
    if owner.local { return }
    if owner.found {
        self.report_header(diags, "`${name}` is declared in crate `${owner.crate_name.as_str()}`, so its methods are emitted under that crate's namespace and collide there; a method on a type this crate does not declare has to come from a trait or an extension (write `impl <Trait> for ${name}`, or `fun ${name}.method()`)")
        return
    }
    if is_builtin_type_name(name) {
        self.report_header(diags, "`${name}` is a builtin type, which no crate declares; a method on it has to come from a trait or an extension (write `impl <Trait> for ${name}`, or `fun ${name}.method()`)")
    }
}

/// A foreign trait for a foreign type is allowed; coherence prevents
/// collisions.
fun TopDecl.check_trait_impl_target(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    if is_builtin_type_name(self.name.as_str()) { return }
    self.target_names_a_type("a trait is implemented FOR a type, and this names none", sig_ptr, diags)
}

/// False once something is reported. A blanket `impl Trait for T` lands here
/// too and is reported, since it currently applies to nothing.
fun TopDecl.target_names_a_type(hint: str, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): bool {
    val name = self.name.as_str()
    when (unsafe { sig_ptr.find_trait(name) }) {
        Some(_info) => {
            self.report_header(diags, "`${name}` is a trait, not a type; to implement it write `impl ${name} for <Type>`")
            return false
        }
        None => { }
    }
    if is_builtin_type_name(name) { return true }
    val owner = target_owner(name, self, sig_ptr)
    if owner.found { return true }
    self.report_header(diags, "no type named `${name}` (${hint})")
    return false
}

struct TargetOwner {
    val found: bool
    /// One of the declarations is this crate's; the impl attaches to it.
    val local: bool
    /// The first foreign owner, for the message. Empty when `local`.
    val crate_name: String
}

fun target_owner(name: str, td: &TopDecl, sig_ptr: Ptr<SigTable>): TargetOwner {
    var found = false
    var owner = String.from("")
    val identities = unsafe { &sig_ptr.type_identities }
    while identity in &identities {
        if identity.name.as_str().equals(name) {
            if identity.crate.raw == td.crate.raw {
                return TargetOwner { found: true, local: true, crate_name: String.from("") }
            }
            if !found { owner = Sym { id: identity.crate.raw }.as_string() }
            found = true
        }
    }
    return TargetOwner { found: found, local: false, crate_name: owner }
}

/// `impl Show for Pair<int32, bool>` parses like `Pair<A, B>` with parameters
/// named `int32` and `bool`; only the header can still tell.
fun TopDecl.reject_arguments_as_parameters(sig_ptr: Ptr<SigTable>, diags: &var Diagnostics): void {
    while tp in &self.generics {
        val pname = tp.name.as_str()
        if name_is_a_declared_type(pname, self, sig_ptr) {
            var at = tp.span
            if at.is_none() { at = self.decl_name_span() }
            report_at(at, diags, "`${pname}` names a type, but an impl target declares type PARAMETERS, not arguments — written here it is a fresh parameter that shadows the type it spells (write the impl for the template, as `impl ... <T>`)")
        }
    }
}

/// Scoped to this impl's crate, since every crate shares one identity table.
/// A dependency's type as a target argument is therefore missed, the safe
/// direction.
fun name_is_a_declared_type(name: str, td: &TopDecl, sig_ptr: Ptr<SigTable>): bool {
    if is_builtin_type_name(name) { return true }
    val identities = unsafe { &sig_ptr.type_identities }
    while identity in &identities {
        if identity.crate.raw == td.crate.raw && identity.name.as_str().equals(name) { return true }
    }
    return false
}

fun TopDecl.report_header(diags: &var Diagnostics, message: String): void {
    report_at(self.decl_name_span(), diags, message)
}

fun report_at(at: Span, diags: &var Diagnostics, message: String): void {
    diags.emit(new_diagnostic(Severity.Error, new_label(at, message)))
}

/// `N` in `impl<T, N: uint64> From<T[N]> for List<T>`: the parameters only
/// the trait's arguments name, which the parser handed to every method.
pub fun TopDecl.trait_arg_params(): List<TypeParam> {
    var lifted = List.new<TypeParam>()
    when (self.kind) {
        TraitImpl(tref, members) => {
            while member in &members {
                when (member.kind) {
                    Function(_params, _ret, _body, _pub, _unsafe, _mutating, _static) => {
                        while tp in &member.generics {
                            if tref.names_type_param(tp.name) { lifted.push(tp.clone()) }
                        }
                        return lifted
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    return lifted
}

pub fun TopDecl.lifts_trait_arg_param(name: str): bool {
    while tp in &self.trait_arg_params() {
        if tp.name.as_str() == name { return true }
    }
    return false
}

fun TypeRef.names_type_param(name: Sym): bool {
    when (self.kind) {
        Named(head, args) => {
            if head.id == name.id && args.size() == 0 { return true }
            while arg in &args {
                if arg.names_type_param(name) { return true }
            }
            return false
        }
        Reference(_mutable, inner) => return inner.names_type_param(name)
        _ => return false
    }
}
