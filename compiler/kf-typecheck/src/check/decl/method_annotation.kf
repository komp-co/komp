// An annotation on a method of an impl, a trait impl or a trait. `@allow` is
// honoured there, and any other built-in is an error. A declared annotation
// marks an impl's method as a function whose first parameter is its receiver;
// a trait's method has no body to mark.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.declaration.TopDecl
import kf_core.ast.annotation.annotation_is_known
import kf_core.diagnostic.*
import kf_typecheck.*
import kf_typecheck.types.trait_method_suffix

/// The impl a method is declared in; `type_name` is empty for a top-level
/// declaration.
pub struct MethodOwner {
    pub val type_name: Sym
    /// A trait impl's symbol suffix; "" for an inherent impl.
    pub val suffix: String
    pub val is_generic: bool
}

pub fun top_level_owner(): MethodOwner {
    return MethodOwner { type_name: intern(""), suffix: String.from(""), is_generic: false }
}

impl MethodOwner {
    pub fun is_method(): bool { return self.type_name.as_str().byte_len() > 0 }
}

/// The symbol a value of `member` names: `Counter_get`, `Counter_show__Shown`.
pub fun TopDecl.value_symbol(owner: &MethodOwner): Sym {
    if !owner.is_method() { return self.name }
    val suffix = if owner.suffix.byte_len() > 0 { "__${owner.suffix.as_str()}" } else { String.from("") }
    return intern("${owner.type_name.as_str()}_${self.name.as_str()}${suffix.as_str()}")
}

/// `Counter.get` for a method, the name alone otherwise.
pub fun TopDecl.listed_name(owner: &MethodOwner): String {
    if !owner.is_method() { return self.name.as_string() }
    return "${owner.type_name.as_str()}.${self.name.as_str()}"
}

pub fun TopDecl.validate_member_annotations(diags: &var Diagnostics): void {
    when (self.kind) {
        ImplBlock(methods) => validate_members(&methods, diags)
        TraitImpl(_trait, methods) => validate_members(&methods, diags)
        TraitDecl(members, _pub, _supers) => validate_members(&members, diags)
        _ => {}
    }
}

fun validate_members(members: &List<TopDecl>, diags: &var Diagnostics): void {
    while member in &members {
        while annotation in &member.annotations {
            val kind = annotation.name.as_str()
            if kind.equals("") || !annotation_is_known(kind) { continue }
            if kind == "allow" {
                member.validate_allow_names(&annotation.words(), diags)
            } else {
                val message = "`@${kind}` cannot annotate a method"
                diags.emit(new_diagnostic(Severity.Error, new_label(member.decl_name_span(), message)))
            }
        }
    }
}

/// Each declared annotation on this declaration's members: registered for an
/// impl's method, reported for a trait's, checked on a field or a variant.
pub fun TopDecl.register_member_annotations(sigs: Ptr<SigTable>, pass_diags: &var Diagnostics,
    table: &var SigTable, diags: &var List<Diagnostic>): void {
    val is_generic = self.generics.size() > 0
    when (self.kind) {
        ImplBlock(methods) => {
            val owner = MethodOwner { type_name: self.name, suffix: String.from(""), is_generic: is_generic }
            register_members(&methods, &owner, sigs, pass_diags, table, diags)
        }
        TraitImpl(tref, methods) => {
            val suffix = trait_method_suffix(unsafe { *tref }, sigs)
            val owner = MethodOwner { type_name: self.name, suffix: suffix, is_generic: is_generic }
            register_members(&methods, &owner, sigs, pass_diags, table, diags)
        }
        TraitDecl(members, _pub, _supers) => reject_on_trait_members(&members, sigs, table, diags)
        Struct(_fields, _pub) => self.check_member_uses(sigs, table, diags)
        EnumDecl(_variants, _pub) => self.check_member_uses(sigs, table, diags)
        _ => {}
    }
}

fun register_members(members: &List<TopDecl>, owner: &MethodOwner, sigs: Ptr<SigTable>,
    pass_diags: &var Diagnostics, table: &var SigTable, diags: &var List<Diagnostic>): void {
    while member in &members {
        while annotation in &member.annotations {
            val kind = annotation.name.as_str()
            if kind.equals("") || annotation_is_known(kind) { continue }
            member.register_annotation_use(annotation, owner, sigs, pass_diags, table, diags)
        }
    }
}

fun reject_on_trait_members(members: &List<TopDecl>, sigs: Ptr<SigTable>, table: &SigTable,
    diags: &var List<Diagnostic>): void {
    while member in &members {
        while annotation in &member.annotations {
            val kind = annotation.name.as_str()
            if kind.equals("") || annotation_is_known(kind) { continue }
            val at = member.decl_name_span()
            val found = table.find_annotation(kind, member.span.file_id, member.crate, member.module_path)
            if found == null {
                diags.push(unknown_annotation(kind, at))
                continue
            }
            val index = found ?: continue
            val declared = table.annotations.at(index)
            note_import_use_named(sigs, member.span.file_id, declared.module, declared.name)
            val message = "`@${kind}` cannot annotate a trait's method: it has no body to name"
            diags.push(new_diagnostic(Severity.Error, new_label(at, message)))
        }
    }
}
