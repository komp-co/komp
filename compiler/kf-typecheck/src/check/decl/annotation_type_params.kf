// An annotation's type parameters. As in an extension's receiver, a name in
// the target that is not a type in scope is a parameter, appended in order of
// first appearance after the ones declared, with their bounds, before the
// annotation's name. The verdict is kept in the declaration's generics, which
// its interface record carries, so an importing crate reads it back.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TypeParam
import kf_core.ast.declaration.new_type_param
import kf_core.diagnostic.*
import kf_typecheck.*

pub mutating fun Module.prepare_annotation_params(diags: &var Diagnostics): void {
    val types = self.declared_type_names()
    while i in 0..self.decls.size() {
        val td = self.decls.at_mut(i)
        if td.crate.raw == self.crate.raw && !td.linkage.is_imported() {
            td.add_target_params(&types, diags)
        }
    }
}

mutating fun TopDecl.add_target_params(types: &List<String>, diags: &var Diagnostics): void {
    val slots = self.target_slots()
    var found = ReceiverParams { names: List.new<String>(), spans: List.new<Span>() }
    while slot in &slots {
        slot.collect_target_params(self, types, &var found)
    }
    found.warn_near_annotation_types(types, diags)
    while i in 0..found.names.size() {
        self.generics.push(new_type_param(found.spans.get(i), *found.names.at(i)))
    }
}

/// A target's parameters and its result; empty for a kind target or any
/// other declaration.
fun TopDecl.target_slots(): List<TypeRef> {
    var slots = List.new<TypeRef>()
    when (self.kind) {
        AnnotationDecl(_params, target, _is_pub) => {
            when (target) {
                Function(ty) => {
                    when (ty.kind) {
                        Function(params, ret) => {
                            slots = params.clone()
                            slots.push((*ret).clone())
                        }
                        _ => {}
                    }
                }
                Signature(params, _has_rest, ret) => {
                    slots = params.clone()
                    slots.push((*ret).clone())
                }
                _ => {}
            }
        }
        _ => {}
    }
    return slots
}

/// Argument-less names that are neither types, `_`, nor parameters already,
/// in order.
fun TypeRef.collect_target_params(td: &TopDecl, types: &List<String>, out: &var ReceiverParams): void {
    when (self.kind) {
        Named(name, args) => {
            val n = name.as_str()
            val is_param = args.size() == 0 && n != "_" && !is_type_name(n, types) && !td.declares_generic(n)
            if is_param && !names_contain(&out.names, n) {
                out.names.push(name.as_string())
                out.spans.push(self.span)
            }
            while arg in &args {
                arg.collect_target_params(td, types, out)
            }
        }
        Reference(_is_mutable, inner) => inner.collect_target_params(td, types, out)
        Function(params, ret) => {
            while param in &params {
                param.collect_target_params(td, types, out)
            }
            ret.collect_target_params(td, types, out)
        }
        Array(element, _size) => element.collect_target_params(td, types, out)
        _ => {}
    }
}

/// `(Pont) -> bool` with `Point` in scope is likelier a typo than a parameter.
fun ReceiverParams.warn_near_annotation_types(types: &List<String>, diags: &var Diagnostics): void {
    while i in 0..self.names.size() {
        val name = self.names.at(i).as_str()
        val near = nearest_type_name(name, types)
        if near.byte_len() > 0 {
            val why = "`${name}` is not a type in scope, so it makes this annotation generic over a parameter"
            val message = "${why} named `${name}`; did you mean `${near.as_str()}`?"
            diags.emit(new_diagnostic(Severity.Warning, new_label(self.spans.get(i), message)))
        }
    }
}

/// Each of this crate's type parameters names a trait in its bounds and
/// stands for a whole parameter or result of the target, or one behind `&`.
pub fun TopDecl.check_type_params(table: &SigTable, diags: &var List<Diagnostic>): void {
    if self.generics.size() == 0 { return }
    val slots = self.target_slots()
    if slots.size() == 0 {
        val message = "`@${self.name.as_str()}` marks by kind, so it has no signature to name a type parameter in"
        diags.push(error_at(self.generics.at(0).span, message))
        return
    }
    while param in &self.generics {
        param.check_bounds_name_traits(table, diags)
        var uses = ParamUses { whole: 0, nested: 0 }
        while slot in &slots {
            slot.count_uses(param.name, true, &var uses)
        }
        val name = param.name.as_str()
        if uses.nested > 0 {
            diags.push(error_at(param.span, "`${name}` stands for a whole parameter or result, or for one behind `&`"))
        } else if uses.whole == 0 {
            diags.push(error_at(param.span, "type parameter `${name}` is not named in the target"))
        }
    }
}

fun TypeParam.check_bounds_name_traits(table: &SigTable, diags: &var List<Diagnostic>): void {
    while bound in &self.bounds {
        val trait_name = bound.bare_name()
        if trait_name.as_str().equals("") {
            diags.push(error_at(bound.span, "an annotation's bound names a trait without type arguments"))
        } else if table.find_trait(trait_name.as_str()) == null {
            diags.push(error_at(bound.span, "cannot find trait `${trait_name.as_str()}` for this bound"))
        }
    }
}

struct ParamUses {
    var whole: uint64
    var nested: uint64
}

/// `whole` counts `name` as a slot or behind a slot's `&`; `nested` anywhere
/// deeper.
fun TypeRef.count_uses(name: Sym, is_slot: bool, uses: &var ParamUses): void {
    when (self.kind) {
        Named(own, args) => {
            if own.id == name.id {
                if is_slot { uses.whole = uses.whole + 1 } else { uses.nested = uses.nested + 1 }
            }
            while arg in &args {
                arg.count_uses(name, false, uses)
            }
        }
        Reference(_is_mutable, inner) => inner.count_uses(name, is_slot, uses)
        Function(params, ret) => {
            while param in &params {
                param.count_uses(name, false, uses)
            }
            ret.count_uses(name, false, uses)
        }
        Array(element, _size) => element.count_uses(name, false, uses)
        _ => {}
    }
}
