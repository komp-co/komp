import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

fun TopDecl.is_source_function(): bool {
    if self.linkage.is_imported() { return false }
    return when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => true
        _ => false
    }
}

/// One free function name defined twice in a crate, which would be one C
/// symbol twice, even from two modules. Reported at the second definition.
/// CONSTRAINT: externs are not definitions; files redeclare them freely.
fun Module.reject_duplicate_functions(diags: &var Diagnostics): void {
    var seen = HashMap.new<String, uint64>()
    while i in 0..self.decls.size() {
        val td = self.decls.at(i)
        if td.is_source_function() {
            val key = "${td.crate.raw}:${td.name.id}"
            when (seen.get(&key)) {
                Some(first) => {
                    val message = td.duplicate_function_message(self.decls.at(*first))
                    val lab = new_label(td.decl_name_span(), message)
                    diags.emit(new_diagnostic(Severity.Error, lab))
                }
                None => seen.insert(key, i)
            }
        }
    }
}

/// Named by what an extension is called and extends, not its hidden name.
fun TopDecl.duplicate_function_message(first: &TopDecl): String {
    val place = if first.module_path.id == self.module_path.id {
        String.from("in this module")
    } else {
        "in module `${first.module_path.as_str()}`; a function name is unique within its crate"
    }
    if self.ext_name.as_str().equals("") { return "`${self.name.as_str()}` is already defined ${place.as_str()}" }
    return "an extension `${self.ext_name.as_str()}` for this receiver is already defined ${place.as_str()}"
}
