// `@derive(Copy)` supplies the Clone impl Copy requires, and only when nothing
// else does.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.annotation.new_annotation

fun lang_trait(name: str, key: str): TopDecl {
    val kind = TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>())
    var td = new_top_decl(no_span(), String.from(name), kind)
    td.annotations.push(lang_annotation(key))
    return td
}

fun copy_module(annotation: Annotation): Module {
    var m = new_module(List.new<String>())
    m.decls.push(lang_trait("Clone", "clone"))
    m.decls.push(lang_trait("Copy", "copy"))
    var point = new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))
    point.name_span = Span { file_id: 1, start: 40, end: 45 }
    point.annotations.push(annotation)
    m.decls.push(point)
    return m
}

fun hand_written_clone(): TopDecl {
    val trait_ref = Box.new(TypeRef.new(no_span(), TypeRefKind.Named(intern("Clone"), List.new<TypeRef>())))
    return new_top_decl(no_span(), String.from("Point"), TopDeclKind.TraitImpl(trait_ref, List.new<TopDecl>()))
}

fun Module.impls_of(trait_name: str): uint64 {
    var count: uint64 = 0
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                when (unsafe { tref.kind }) {
                    Named(name, _args) => { if name.as_str().equals(trait_name) { count = count + 1 } }
                    _ => { }
                }
            }
            _ => { }
        }
    }
    return count
}

fun Module.copy_impl_of(): TopDecl {
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                when (unsafe { tref.kind }) {
                    Named(name, _args) => { if name.as_str().equals("Copy") { return td } }
                    _ => { }
                }
            }
            _ => { }
        }
    }
    return new_top_decl(no_span(), "", TopDeclKind.Poison)
}

@test
fun derive_copy_synthesizes_a_copy_impl(): void {
    var m = copy_module(new_annotation(no_span(), "derive", [String.from("Copy")]))
    m.expand_derives()
    assert_eq(m.impls_of("Copy"), 1, "one Copy impl for the deriving type")
}

@test
fun derive_copy_alone_also_supplies_clone(): void {
    var m = copy_module(new_annotation(no_span(), "derive", [String.from("Copy")]))
    m.expand_derives()
    assert_eq(m.impls_of("Clone"), 1, "Copy requires Clone, so the derive supplies it")
}

@test
fun derive_clone_and_copy_supplies_clone_once(): void {
    var m = copy_module(new_annotation(no_span(), "derive", [String.from("Clone"), String.from("Copy")]))
    m.expand_derives()
    assert_eq(m.impls_of("Clone"), 1, "an explicit Clone derive is not duplicated")
}

@test
fun derive_copy_keeps_a_hand_written_clone(): void {
    var m = copy_module(new_annotation(no_span(), "derive", [String.from("Copy")]))
    m.decls.push(hand_written_clone())
    m.expand_derives()
    assert_eq(m.impls_of("Clone"), 1, "the written impl stands, and no second one is synthesized")
}

@test
fun derived_copy_impl_reports_at_the_type_name(): void {
    var m = copy_module(new_annotation(no_span(), "derive", [String.from("Copy")]))
    m.expand_derives()
    assert_eq(m.copy_impl_of().decl_name_span().start, 40, "an unsound derive names the type, not the keyword")
}
