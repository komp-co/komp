// An annotation on a struct's field or an enum's variant. A built-in is an
// error there; a declared one must list `field` or `variant` among its kinds.
// Nothing lists a member's uses: the arguments stay on the member, checked.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.declaration.Annotation
import kf_core.ast.declaration.MarkKind
import kf_core.ast.declaration.TopDecl
import kf_core.ast.annotation.annotation_is_known
import kf_core.diagnostic.*
import kf_typecheck.*

/// Each annotation on this type's fields or variants: a built-in reported,
/// a declared one checked against its parameters and target.
fun TopDecl.check_member_uses(sigs: Ptr<SigTable>, table: &SigTable, diags: &var List<Diagnostic>): void {
    when (self.kind) {
        Struct(fields, _pub) => {
            while field in &fields {
                self.check_uses_on(&field.annotations, MarkKind.Field, field.span, sigs, table, diags)
            }
        }
        EnumDecl(variants, _pub) => {
            while variant in &variants {
                self.check_uses_on(&variant.annotations, MarkKind.Variant, variant.span, sigs, table, diags)
            }
        }
        _ => {}
    }
}

fun TopDecl.check_uses_on(annotations: &List<Annotation>, member: MarkKind, at: Span, sigs: Ptr<SigTable>,
    table: &SigTable, diags: &var List<Diagnostic>): void {
    while annotation in &annotations {
        val kind = annotation.name.as_str()
        if kind.equals("") { continue }
        if annotation_is_known(kind) {
            diags.push(error_at(at, "`@${kind}` cannot annotate ${member.phrase()}"))
            continue
        }
        self.check_member_use(annotation, member, at, sigs, table, diags)
    }
}

fun TopDecl.check_member_use(annotation: &Annotation, member: MarkKind, at: Span, sigs: Ptr<SigTable>,
    table: &SigTable, diags: &var List<Diagnostic>): void {
    val kind = annotation.name.as_str()
    val file = self.span.file_id
    val found = table.find_annotation(kind, file, self.crate, self.module_path)
    if found == null {
        diags.push(unknown_annotation(kind, at))
        return
    }
    val index = found ?: return
    val declared = table.annotations.at(index)
    note_import_use_named(sigs, file, declared.module, declared.name)
    val arguments = annotation.arguments_in_order(&declared.params, table, self.crate, diags)
    if !arguments.ok { return }
    val kinds = declared.target.kinds()
    while listed in &kinds {
        if listed.kind == member { return }
    }
    val allowed = if kinds.size() == 0 { String.from("a function") } else { kinds.phrase() }
    diags.push(error_at(at, "`@${kind}` can only annotate ${allowed.as_str()}"))
}
