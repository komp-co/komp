import alloc.list.*

import kf_core.ast.Linkage
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

fun TopDecl.impl_member_is_method(): bool {
    return when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => true
        _ => false
    }
}

/// One name twice in a single impl block; only the first would be registered.
/// Per block: impls of different traits may share a method name, mangled
/// apart. Imported declarations are skipped.
fun reject_duplicate_methods(methods: &List<TopDecl>, type_name: str, linkage: Linkage, diags: &var Diagnostics): void {
    if linkage.is_imported() { return }
    while i in 0..methods.size() {
        val later = *methods.at(i)
        if later.impl_member_is_method() {
            var reported = false
            var j = 0
            while j < i {
                val earlier = *methods.at(j)
                if earlier.impl_member_is_method() {
                    if !reported {
                        if earlier.name.as_str().equals(later.name.as_str()) {
                            val message = "`${later.name.as_str()}` is already defined for `${type_name}`"
                            val lab = new_label((&later).decl_name_span(), message)
                            diags.emit(new_diagnostic(Severity.Error, lab))
                            reported = true
                        }
                    }
                }
                j = j + 1
            }
        }
    }
}
