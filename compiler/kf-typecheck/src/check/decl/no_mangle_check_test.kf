import core.assert.assert_eq
import alloc.list.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.annotation.new_annotation
import kf_resolve.new_decl_table
import kf_core.span.no_span
import kf_typecheck.typecheck_module

fun unmangled_decl(name: str, kind: TopDeclKind, crate: str): TopDecl {
    var declaration = new_top_decl(no_span(), String.from(name), kind)
    declaration.crate = new_crate_id(crate)
    declaration.annotations.push(new_annotation(no_span(), "no_mangle", List.new<String>()))
    return declaration
}

fun no_mangle_messages(decls: List<TopDecl>): uint64 {
    var module = Module { crate: new_crate_id("application"), path: List.new<String>(), decls: decls,
        imports: List.new<Import>() }
    var table = new_decl_table()
    val diagnostics = module.typecheck_module(&var table)
    var count: uint64 = 0
    while diagnostic in &diagnostics {
        if diagnostic.primary.message.as_str().contains("no_mangle") { count = count + 1 }
    }
    return count
}

@test
fun no_mangle_is_accepted_on_a_struct_and_an_enum(): void {
    var decls = List.new<TopDecl>()
    decls.push(unmangled_decl("Pair", TopDeclKind.Struct(List.new<Field>(), true), "application"))
    decls.push(unmangled_decl("Shade", TopDeclKind.EnumDecl(List.new<Variant>(), true), "application"))
    assert_eq(no_mangle_messages(decls), 0, "a struct and an enum may keep their C names")
}

@test
fun no_mangle_on_a_function_is_rejected(): void {
    var decls = List.new<TopDecl>()
    val ret = new_type_ref_ptr_void()
    val kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    decls.push(unmangled_decl("helper", kind, "application"))
    assert_eq(no_mangle_messages(decls) > 0, true, "only a type has a C name to keep")
}

@test
fun two_no_mangle_types_with_one_name_collide(): void {
    var decls = List.new<TopDecl>()
    decls.push(unmangled_decl("Pair", TopDeclKind.Struct(List.new<Field>(), true), "application"))
    decls.push(unmangled_decl("Pair", TopDeclKind.Struct(List.new<Field>(), true), "geometry"))
    assert_eq(no_mangle_messages(decls) > 0, true, "one C name cannot define two types")
}

fun new_type_ref_ptr_void(): Ptr<TypeRef> {
    val ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ptr = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    return ptr
}
