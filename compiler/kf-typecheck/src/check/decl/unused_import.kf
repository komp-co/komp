// An import no name came through. Runs after every body, when
// `note_import_use` has recorded which (file, module) pairs names resolved
// to. An import is used when the file writes a name its module declares,
// whether or not the checker could resolve that name without it.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_typecheck.import_was_used

/// The first `m.imports.size()` entries of `caller_files` and
/// `imported_targets` align with `m.imports`; any after are what exports forward.
pub fun Module.unused_import_diags(sp: Ptr<SigTable>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    // Only the crate being compiled is linted, not its dependencies' merged
    // source. Poison means the caller did not say which.
    if self.crate.is_poison() { return out }
    val targets = unsafe { sp.imported_targets.clone() }
    val files = unsafe { sp.caller_files.clone() }
    // Misalignment would delete the wrong line.
    if files.size() < self.imports.size() || targets.size() < self.imports.size() { return out }
    val own = self.own_files()
    while i in 0..self.imports.size() {
        val target = targets.get(i)
        val file = files.get(i)
        val imp = self.imports.at(i)
        // An unresolved import already has its own error; an export is
        // used by whoever imports its module.
        val lintable = target.id != 0 && !imp.is_pub && contains_file(&own, file)
        if lintable && !self.import_reaches_a_use(sp, &targets, file, target) {
            if import_is_written(imp) && !duplicate_span(&out, imp.span) {
                out.push(imp.unused_import_warning())
            }
        }
    }
    return out
}

/// A name from `target`, or from a module it exports, is used in `file`.
fun Module.import_reaches_a_use(sp: Ptr<SigTable>, targets: &List<Sym>, file: uint32, target: Sym): bool {
    val reached = self.reexport_closure(targets, target)
    while module in &reached {
        if import_was_used(sp, file, module) { return true }
    }
    return false
}

/// `target` and every module its exports reach, transitively.
pub fun Module.reexport_closure(targets: &List<Sym>, target: Sym): List<Sym> {
    var reached = List.new<Sym>()
    reached.push(target)
    var next = 0
    while next < reached.size() {
        val owner = reached.get(next).as_str()
        while k in 0..self.imports.size() {
            val imp = self.imports.at(k)
            val next_target = targets.get(k)
            if imp.is_pub && imp.owner.as_str() == owner && next_target.id != 0 && !sym_in(&reached, next_target) {
                reached.push(targets.get(k))
            }
        }
        next = next + 1
    }
    return reached
}

/// `target` exports from another module.
pub fun Module.target_reexports(targets: &List<Sym>, target: Sym): bool {
    val reached = self.reexport_closure(targets, target)
    return reached.size() > 1
}

fun sym_in(syms: &List<Sym>, s: Sym): bool {
    while item in &syms {
        if item.id == s.id { return true }
    }
    return false
}

/// A file holds one crate's declarations, so any declaration settles it.
fun Module.own_files(): List<uint32> {
    var out = List.new<uint32>()
    while d in &self.decls {
        if d.crate.raw == self.crate.raw {
            val f = d.span.file_id
            if f != 0 && !contains_file(&out, f) { out.push(f) }
        }
    }
    return out
}

fun contains_file(files: &List<uint32>, f: uint32): bool {
    while file in &files {
        if file == f { return true }
    }
    return false
}

/// The repair deletes the line, but is `MaybeIncorrect`: a name can reach a
/// module by a path this does not watch (a trait method), so `komp check --fix` does
/// not take it unattended.
fun Import.unused_import_warning(): Diagnostic {
    var msg = String.from("unused import `")
    msg.append(import_path_text(&self.path).as_str())
    if self.wildcard { msg.append(".*") }
    if self.alias.as_str() != "" { msg.append(" as ${self.alias.as_str()}") }
    msg.append("`: nothing in this file names anything it declares")
    val d = lint_at("unused_import", self.span, msg)
    return with_fix_applic(d, delete_line_span(self.span), "",
        String.from("remove this import"), Applicability.MaybeIncorrect)
}

/// Includes the newline, so no blank line is left.
fun delete_line_span(s: Span): Span {
    return Span { file_id: s.file_id, start: s.start, end: s.end + 1 }
}

fun import_path_text(path: &List<String>): String {
    var out = ""
    while i in 0..path.size() {
        if i > 0 { out.append(".") }
        out.append(path.at(i).as_str())
    }
    return out
}

/// Sibling files each carry every import, so one line can arrive twice.
fun duplicate_span(out: &List<Diagnostic>, s: Span): bool {
    while item in &out {
        val p = item.primary.span
        if p.file_id == s.file_id && p.start == s.start { return true }
    }
    return false
}
