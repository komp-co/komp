import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.diagnostic.*
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module

fun header_decl(td: TopDecl, crate: str): TopDecl {
    var owned = td
    owned.crate = new_crate_id(crate)
    owned.module_path = intern("sample.api")
    return owned
}

fun header_struct(name: str, crate: str): TopDecl {
    return header_decl(new_top_decl(no_span(), String.from(name), TopDeclKind.Struct(List.new<Field>(), true)), crate)
}

fun header_trait(name: str, crate: str): TopDecl {
    return header_decl(new_top_decl(no_span(), String.from(name), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>())), crate)
}

fun header_impl(target: str, crate: str, params: List<String>): TopDecl {
    var td = header_decl(new_top_decl(no_span(), String.from(target), TopDeclKind.ImplBlock(List.new<TopDecl>())), crate)
    var generics = List.new<TypeParam>()
    while param in &params {
        generics.push(new_type_param(no_span(), param))
    }
    td.generics = generics
    return td
}

fun no_params(): List<String> {
    return List.new<String>()
}

fun one_param(name: str): List<String> {
    var out = List.new<String>()
    out.push(String.from(name))
    return out
}

fun header_diagnostics(decls: List<TopDecl>): List<Diagnostic> {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    return module.typecheck_module(&var declarations)
}

fun header_reported(diagnostics: &List<Diagnostic>, needle: str): bool {
    while diagnostic in &diagnostics {
        if (diagnostic.primary.message.as_str()).contains(needle) { return true }
    }
    return false
}

@test
fun an_inherent_impl_naming_a_trait_says_it_is_a_trait(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_trait("Greet", "sample"))
    decls.push(header_impl("Greet", "sample", no_params()))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "`Greet` is a trait, not a type"), true, "the fix is `impl Greet for <Type>`, not a renamed target")
}

@test
fun an_inherent_impl_naming_nothing_says_no_such_type(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_impl("NoSuchThing", "sample", no_params()))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "no type named `NoSuchThing`"), true, "an unresolved target used to reach cc as an unknown C type name")
}

@test
fun an_inherent_impl_for_another_crates_type_names_the_owner(): void {
    // Methods would emit as `dlib__Foo_*`, in a namespace this crate does not
    // own.
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Foo", "dlib"))
    decls.push(header_impl("Foo", "sample", no_params()))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "is declared in crate `dlib`"), true, "naming the owner is what tells the reader why it is refused")
}

@test
fun an_inherent_impl_for_its_own_crates_type_is_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Foo", "sample"))
    decls.push(header_impl("Foo", "sample", no_params()))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "impl"), false, "the ordinary form stays silent")
}

@test
fun a_type_declared_here_and_elsewhere_is_still_implementable(): void {
    // A same-named type elsewhere does not make this crate's impl foreign.
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Foo", "dlib"))
    decls.push(header_struct("Foo", "sample"))
    decls.push(header_impl("Foo", "sample", no_params()))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "is declared in crate"), false, "an ambiguous name resolves in favour of the crate that can impl it")
}

@test
fun a_target_argument_that_names_a_type_is_rejected(): void {
    // `Pair<int32>` would declare a parameter named int32.
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Pair", "sample"))
    decls.push(header_impl("Pair", "sample", one_param("int32")))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "`int32` names a type"), true, "the shadowing is invisible until a body touches a field")
}

@test
fun a_target_argument_naming_a_declared_struct_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Widget", "sample"))
    decls.push(header_struct("Pair", "sample"))
    decls.push(header_impl("Pair", "sample", one_param("Widget")))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "`Widget` names a type"), true, "a user type shadows exactly as a primitive does")
}

@test
fun an_ordinary_type_parameter_is_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_struct("Pair", "sample"))
    decls.push(header_impl("Pair", "sample", one_param("T")))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "names a type"), false, "a name no declaration claims is what a parameter is")
}

fun header_trait_impl(trait_name: str, target: str, crate: str): TopDecl {
    val tref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tref = TypeRef.new(no_span(), TypeRefKind.Named(intern(trait_name), List.new<TypeRef>())) }
    return header_decl(new_top_decl(no_span(), String.from(target), TopDeclKind.TraitImpl(tref, List.new<TopDecl>())), crate)
}

// The `for` side is resolved too.

@test
fun a_trait_impl_for_an_undeclared_type_says_no_such_type(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_trait("Show", "sample"))
    decls.push(header_trait_impl("Show", "NoSuchThing", "sample"))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "no type named `NoSuchThing`"), true, "the `for` position is resolved like the inherent one")
}

@test
fun a_trait_impl_for_a_trait_says_it_is_a_trait(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_trait("Show", "sample"))
    decls.push(header_trait("Other", "sample"))
    decls.push(header_trait_impl("Show", "Other", "sample"))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "`Other` is a trait, not a type"), true, "a trait in the `for` position implements nothing")
}

// The inherent-impl crate rule does not apply to trait impls.
@test
fun a_trait_impl_for_another_crates_type_is_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_trait("Show", "sample"))
    decls.push(header_struct("Foo", "dlib"))
    decls.push(header_trait_impl("Show", "Foo", "sample"))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "is declared in crate"), false, "implementing a trait for a foreign type is the supported way to extend it")
}

@test
fun a_trait_impl_for_a_builtin_is_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(header_trait("Show", "sample"))
    decls.push(header_trait_impl("Show", "int32", "sample"))
    val diagnostics = header_diagnostics(decls)
    assert_eq(header_reported(&diagnostics, "int32"), false, "`impl Equal for int32` is written in every crate that needs it")
}
