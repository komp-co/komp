// `T?`, `T[N]` and `&T[]` desugar to placeholders naming the option, array
// and slice types by their `@lang` keys, which the parser cannot know. This
// rewrites them to the real names in every type position before any other
// pass reads them.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.SwitchArm

/// The names the library gave the types the placeholders stand for.
@derive(Copy)
pub struct LangHeads {
    pub val option: Sym
    pub val array: Sym
    pub val slice: Sym
    pub val slice_mut: Sym
}

/// Records the names the library gave its lang types, and returns the ones
/// placeholders stand for.
pub mutating fun SigTable.note_lang_types(m: &Module): LangHeads {
    self.lang_string = m.lang_type_name(lang_string_key())
    self.lang_option = m.lang_type_name(lang_option_key())
    self.lang_list = m.lang_type_name(lang_list_key())
    self.lang_array = m.lang_type_name(lang_array_key())
    self.lang_slice = m.lang_type_name(lang_slice_key())
    self.lang_slice_mut = m.lang_type_name(lang_slice_mut_key())
    return LangHeads {
        option: self.lang_option, array: self.lang_array, slice: self.lang_slice, slice_mut: self.lang_slice_mut
    }
}

/// The real name for a placeholder head, or `name` itself.
fun LangHeads.head_for(name: Sym): Sym {
    val key = name.lang_placeholder_key()
    if key.as_str() == lang_option_key() { return self.option }
    if key.as_str() == lang_array_key() { return self.array }
    if key.as_str() == lang_slice_key() { return self.slice }
    if key.as_str() == lang_slice_mut_key() { return self.slice_mut }
    return name
}

/// An independent copy with every placeholder head, nested ones included,
/// renamed.
fun TypeRef.rewrite_placeholder_tref(heads: LangHeads): TypeRef {
    when (self.kind) {
        Named(n, args) => {
            val rewritten = rewrite_placeholder_tref_list(&args, heads)
            return TypeRef.new(self.span, TypeRefKind.Named(heads.head_for(n), rewritten))
        }
        DynTrait(n, args) => {
            return TypeRef.new(self.span, TypeRefKind.DynTrait(n, rewrite_placeholder_tref_list(&args, heads)))
        }
        Reference(is_mut, inner) => {
            val sub = (unsafe { &*inner }).rewrite_placeholder_tref(heads)
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = sub }
            return TypeRef.new(self.span, TypeRefKind.Reference(is_mut, q))
        }
        Function(ps, ret) => {
            val new_ps = rewrite_placeholder_tref_list(&ps, heads)
            val rsub = (unsafe { &*ret }).rewrite_placeholder_tref(heads)
            val rq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *rq = rsub }
            return TypeRef.new(self.span, TypeRefKind.Function(new_ps, rq))
        }
        Array(elem, n) => {
            val esub = (unsafe { &*elem }).rewrite_placeholder_tref(heads)
            val eq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *eq = esub }
            return TypeRef.new(self.span, TypeRefKind.Array(eq, n))
        }
        Projection(owner, member) => {
            val osub = (unsafe { &*owner }).rewrite_placeholder_tref(heads)
            val oq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *oq = osub }
            return TypeRef.new(self.span, TypeRefKind.Projection(oq, member))
        }
        Value(v) => return TypeRef.new(self.span, TypeRefKind.Value(v))
        Poison => return TypeRef.new_poison(self.span)
    }
}

fun rewrite_placeholder_tref_list(items: &List<TypeRef>, heads: LangHeads): List<TypeRef> {
    var out = List.new<TypeRef>()
    while item in &items {
        out.push((item).rewrite_placeholder_tref(heads))
    }
    return out
}

/// A `let`/`var` annotation, in place.
fun rewrite_placeholder_ann(ty: Ptr<TypeRef>?, heads: LangHeads): void {
    when (ty) {
        Some(tp) => { unsafe { *tp = (unsafe { &*tp }).rewrite_placeholder_tref(heads) } }
        None => {}
    }
}

/// Rewrites the node in place, through a view of the Box that owns it.
fun rewrite_placeholder_box(b: Ptr<TypeRef>, heads: LangHeads): void {
    if (b as uint64) == 0 { return }
    unsafe { *b = (unsafe { &*b }).rewrite_placeholder_tref(heads) }
}

fun rewrite_placeholder_params(params: &List<Param>, heads: LangHeads): void {
    while p in &params {
        rewrite_placeholder_box(p.ty, heads)
    }
}

fun rewrite_placeholder_fields(fields: &List<Field>, heads: LangHeads): void {
    while f in &fields {
        rewrite_placeholder_box(f.ty, heads)
    }
}

fun rewrite_placeholder_stmt_list(stmts: &List<Stmt>, heads: LangHeads): void {
    while i in 0..stmts.size() {
        val sp: Ptr<Stmt> = unsafe { stmts.at(i) as Ptr<Stmt> }
        rewrite_placeholder_stmt(sp, heads)
    }
}

fun rewrite_placeholder_stmt(sp: Ptr<Stmt>, heads: LangHeads): void {
    when (unsafe { sp.kind }) {
        LetVal(_n, ty, init) => {
            rewrite_placeholder_ann(ty.view(), heads)
            rewrite_placeholder_expr(init.view(), heads)
        }
        LetVar(_n, ty, init) => {
            rewrite_placeholder_ann(ty.view(), heads)
            rewrite_placeholder_expr(init.view(), heads)
        }
        Assign(_n, expr_box) => rewrite_placeholder_expr(expr_box, heads)
        AssignTo(place_box, expr_box) => {
            rewrite_placeholder_expr(place_box, heads)
            rewrite_placeholder_expr(expr_box, heads)
        }
        Return(expr_ptr) => rewrite_placeholder_expr(expr_ptr.view(), heads)
        If(cond_box, then_body, else_body) => {
            rewrite_placeholder_expr(cond_box, heads)
            rewrite_placeholder_stmt_list(&then_body, heads)
            rewrite_placeholder_stmt_list(&else_body, heads)
        }
        While(cond_box, body) => {
            rewrite_placeholder_expr(cond_box, heads)
            rewrite_placeholder_stmt_list(&body, heads)
        }
        ForEach(_binder, subj_box, body) => {
            rewrite_placeholder_expr(subj_box, heads)
            rewrite_placeholder_stmt_list(&body, heads)
        }
        When(subj_box, arms) => {
            rewrite_placeholder_expr(subj_box, heads)
            rewrite_placeholder_arms(&arms, heads)
        }
        Expression(expr_box) => rewrite_placeholder_expr(expr_box, heads)
        Switch(subj_box, arms) => {
            rewrite_placeholder_expr(subj_box, heads)
            rewrite_placeholder_switch_arms(&arms, heads)
        }
        Break => {}
        Continue => {}
        Drop(_) => {}
        Release(_) => {}
        Poison => {}
    }
}

fun rewrite_placeholder_arms(arms: &List<Arm>, heads: LangHeads): void {
    while a in &arms {
        rewrite_placeholder_expr(a.guard.view(), heads)
        rewrite_placeholder_stmt_list(&a.body, heads)
    }
}

fun rewrite_placeholder_switch_arms(arms: &List<SwitchArm>, heads: LangHeads): void {
    while a in &arms {
        rewrite_placeholder_expr(a.guard.view(), heads)
        rewrite_placeholder_stmt_list(&a.body, heads)
    }
}

fun rewrite_placeholder_expr(p_opt: Ptr<Expr>?, heads: LangHeads): void {
    val p = p_opt ?: return
    if unsafe { p.type_args.size() } > 0 {
        unsafe { p.type_args = rewrite_placeholder_tref_list(unsafe { &p.type_args }, heads) }
    }
    when (unsafe { p.kind }) {
        LitInt(_) => {}
        LitFloat(_) => {}
        LitChar(_) => {}
        LitStr(_) => {}
        LitBool(_) => {}
        Variable(_) => {}
        Binary(lp, _op, rp) => {
            rewrite_placeholder_expr(lp, heads)
            rewrite_placeholder_expr(rp, heads)
        }
        Unary(_op, ip) => rewrite_placeholder_expr(ip, heads)
        Deref(ip) => rewrite_placeholder_expr(ip, heads)
        Call(_nm, args) => rewrite_placeholder_expr_list(&args, heads)
        Intrinsic(_i, args) => rewrite_placeholder_expr_list(&args, heads)
        FnRef(_) => {}
        CallValue(callee_ptr, args) => {
            rewrite_placeholder_expr(callee_ptr, heads)
            rewrite_placeholder_expr_list(&args, heads)
        }
        MethodCall(recv_ptr, _m, args) => {
            rewrite_placeholder_expr(recv_ptr, heads)
            rewrite_placeholder_expr_list(&args, heads)
        }
        FieldAccess(obj_ptr, _f) => rewrite_placeholder_expr(obj_ptr, heads)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            rewrite_placeholder_expr(c_ptr, heads)
            rewrite_placeholder_expr(t_ptr, heads)
            rewrite_placeholder_expr(e_ptr, heads)
        }
        WhenExpr(subj_box, arms) => {
            rewrite_placeholder_expr(subj_box, heads)
            rewrite_placeholder_arms(&arms, heads)
        }
        StructLit(_nm, finits) => {
            while finit in &finits {
                rewrite_placeholder_expr(finit.value, heads)
            }
        }
        Cast(ip, tref) => {
            rewrite_placeholder_expr(ip, heads)
            rewrite_placeholder_box(tref, heads)
        }
        DynCoerce(ip, _vtable) => rewrite_placeholder_expr(ip, heads)
        Lambda(params, body) => {
            rewrite_placeholder_params(&params, heads)
            rewrite_placeholder_stmt_list(&body, heads)
        }
        Retain(ip) => rewrite_placeholder_expr(ip, heads)
        Release(_) => {}
        Block(stmts) => rewrite_placeholder_stmt_list(&stmts, heads)
        Poison => {}
    }
}

fun rewrite_placeholder_expr_list(args: &List<Expr>, heads: LangHeads): void {
    while i in 0..args.size() {
        val ep: Ptr<Expr> = unsafe { args.at(i) as Ptr<Expr> }
        rewrite_placeholder_expr(ep, heads)
    }
}

mutating fun TopDecl.rewrite_placeholder_decl(heads: LangHeads): void {
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            rewrite_placeholder_params(&params, heads)
            rewrite_placeholder_box(ret, heads)
            rewrite_placeholder_stmt_list(&body, heads)
            self.kind = TopDeclKind.Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static)
        }
        Struct(fields, is_pub) => {
            rewrite_placeholder_fields(&fields, heads)
            self.kind = TopDeclKind.Struct(fields, is_pub)
        }
        EnumDecl(variants, is_pub) => {
            while i in 0..variants.size() {
                val v = variants.at_mut(i)
                v.payloads = rewrite_placeholder_tref_list(&v.payloads, heads)
            }
            self.kind = TopDeclKind.EnumDecl(variants, is_pub)
        }
        Extern(params, ret, is_pub, is_unsafe) => {
            rewrite_placeholder_params(&params, heads)
            rewrite_placeholder_box(ret, heads)
            self.kind = TopDeclKind.Extern(params, ret, is_pub, is_unsafe)
        }
        ImplBlock(methods) => {
            rewrite_placeholder_methods(&var methods, heads)
            self.kind = TopDeclKind.ImplBlock(methods)
        }
        TraitDecl(methods, is_pub, supers) => {
            rewrite_placeholder_methods(&var methods, heads)
            self.kind = TopDeclKind.TraitDecl(methods, is_pub, rewrite_placeholder_tref_list(&supers, heads))
        }
        TraitImpl(trait_ref, methods) => {
            rewrite_placeholder_box(trait_ref, heads)
            rewrite_placeholder_methods(&var methods, heads)
            self.kind = TopDeclKind.TraitImpl(trait_ref, methods)
        }
        AssocType(bounds) => {
            self.kind = TopDeclKind.AssocType(rewrite_placeholder_tref_list(&bounds, heads))
        }
        AssocTypeBinding(boxed) => {
            rewrite_placeholder_box(boxed, heads)
            self.kind = TopDeclKind.AssocTypeBinding(boxed)
        }
        AnnotationDecl(_params, _target, _pub) => {}
        Template(_kind, _marked, _body) => {}
        Poison => {}
    }
}

fun rewrite_placeholder_methods(methods: &var List<TopDecl>, heads: LangHeads): void {
    while i in 0..methods.size() {
        rewrite_placeholder_decl(methods.at_mut(i), heads)
    }
}

pub mutating fun Module.rewrite_placeholder_module(heads: LangHeads): void {
    if heads.option.as_str() == "" && heads.array.as_str() == "" { return }
    while i in 0..self.decls.size() {
        rewrite_placeholder_decl(self.decls.at_mut(i), heads)
    }
}
