// Extension functions before registration. In `fun List<T>.second_or(...)`
// the receiver introduces `T`, as `impl List<T>` would: a receiver name is a
// type if one exists, else a new parameter, appended after the function's
// own. The verdict is recorded as `@receiver_params(T, ...)` so an importing
// crate reads it rather than guessing again.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.new_type_param
import kf_core.ast.annotation.new_annotation
import kf_core.span.*
import kf_core.diagnostic.*
import kf_typecheck.check.edit_distance

/// Also records an extension's called name.
pub fun insert_fn_sig(sigs: Ptr<SigTable>, owner: Ptr<TopDecl>, sig: FnSignature): void {
    if (owner as uint64) != 0 {
        val ext_name = unsafe { owner.ext_name }
        if !ext_name.as_str().equals("") {
            unsafe { (*sigs).ext_names.push(ext_name) }
            unsafe { (*sigs).ext_links.push(intern(sig.name.as_str())) }
            val trait_param = (unsafe { &*owner }).annotation_word("receiver_trait")
            unsafe { (*sigs).ext_trait_params.push(intern(trait_param.as_str())) }
        }
    }
    unsafe { sigs.insert(sig) }
}

pub mutating fun Module.prepare_extensions(diags: &var Diagnostics): void {
    val types = self.declared_type_names()
    val traits = self.declared_trait_names()
    while i in 0..self.decls.size() {
        val td = self.decls.at_mut(i)
        if !td.ext_name.as_str().equals("") {
            td.add_receiver_params(&types, diags)
            td.add_trait_receiver(&types, &traits)
        }
        td.reject_nested_extensions(diags)
    }
}

fun Module.declared_type_names(): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            Struct(_fields, _is_pub) => out.push(td.name.as_string())
            EnumDecl(_variants, _is_pub) => out.push(td.name.as_string())
            TraitDecl(_methods, _is_pub, _supers) => out.push(td.name.as_string())
            _ => { }
        }
    }
    return out
}

fun Module.declared_trait_names(): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            TraitDecl(_methods, _is_pub, _supers) => out.push(td.name.as_string())
            _ => { }
        }
    }
    return out
}

struct ReceiverParams {
    var names: List<String>
    var spans: List<Span>
}

mutating fun TopDecl.add_receiver_params(types: &List<String>, diags: &var Diagnostics): void {
    val receiver = self.receiver_type_ref() ?: return
    var found = ReceiverParams { names: List.new<String>(), spans: List.new<Span>() }
    val recorded = self.annotation_words("receiver_params")
    if recorded.size() == 0 {
        receiver.collect_receiver_params(self, types, &var found)
        if found.names.size() > 0 {
            self.annotations.push(new_annotation(receiver.span, "receiver_params", found.names.clone()))
        }
    } else {
        while name in &recorded {
            found.names.push(name.clone())
            found.spans.push(receiver.span)
        }
    }
    // An imported declaration was checked in its own crate.
    if !self.linkage.is_imported() && !self.linkage.is_template() {
        found.warn_near_type_names(types, diags)
    }
    var i: uint64 = 0
    while i < found.names.size() {
        if !self.declares_generic(found.names.at(i).as_str()) {
            self.generics.push(new_type_param(found.spans.get(i), *found.names.at(i)))
        }
        i = i + 1
    }
}

/// `fun Iterable<Point>.total_x()` extends every implementor: it is
/// `fun Receiver.total_x<Receiver: Iterable<Point>>()`, recorded as
/// `@receiver_trait(Receiver)`.
mutating fun TopDecl.add_trait_receiver(types: &List<String>, traits: &List<String>): void {
    val receiver = self.receiver_type_ref() ?: return
    var param = self.annotation_word("receiver_trait")
    if param.byte_len() == 0 {
        val head = when (receiver.kind) {
            Named(name, _args) => name.as_string()
            _ => String.from("")
        }
        if !names_contain(traits, head.as_str()) || self.declares_generic(head.as_str()) { return }
        param = self.fresh_receiver_name(types)
        self.annotations.push(new_annotation(receiver.span, "receiver_trait", [param.clone()]))
    }
    if self.declares_generic(param.as_str()) { return }
    var tp = new_type_param(receiver.span, param.clone())
    tp.bounds.push(receiver.clone())
    self.generics.push(tp)
    self.point_self_at(TypeRef.new(receiver.span, TypeRefKind.Named(intern(param.as_str()), List.new<TypeRef>())))
}

fun TopDecl.fresh_receiver_name(types: &List<String>): String {
    var name = String.from("Receiver")
    var n: uint64 = 2
    while is_type_name(name.as_str(), types) || self.declares_generic(name.as_str()) {
        name = "Receiver${n}"
        n = n + 1
    }
    return name
}

fun TopDecl.point_self_at(receiver: TypeRef): void {
    when (self.kind) {
        Function(params, _ret, _body, _is_pub, _is_unsafe, _is_mutating, _is_static) => {
            val slot: Ptr<TypeRef> = params.at(0).ty
            when (unsafe { (*slot).kind }) {
                Reference(_mutable, inner) => unsafe { *inner = receiver }
                _ => unsafe { *slot = receiver }
            }
        }
        _ => { }
    }
}

/// The one word of `@key(word)`, or "".
fun TopDecl.annotation_word(key: str): String {
    val words = self.annotation_words(key)
    if words.size() == 0 { return "" }
    return words.at(0).clone()
}

/// `self`'s type without the parser's reference.
fun TopDecl.receiver_type_ref(): TypeRef? {
    when (self.kind) {
        Function(params, _ret, _body, _is_pub, _is_unsafe, _is_mutating, _is_static) => {
            if params.size() == 0 { return null }
            val written: TypeRef = unsafe { *params.at(0).ty }
            when (written.kind) {
                Reference(_mutable, inner) => return unsafe { *inner }
                _ => return written
            }
        }
        _ => return null
    }
}

/// Argument-less names that are neither types nor declared parameters, in
/// order.
fun TypeRef.collect_receiver_params(td: &TopDecl, types: &List<String>, out: &var ReceiverParams): void {
    when (self.kind) {
        Named(name, args) => {
            val n = name.as_str()
            val is_param = args.size() == 0 && !is_type_name(n, types) && !td.declares_generic(n)
            if is_param && !names_contain(&out.names, n) {
                out.names.push(name.as_string())
                out.spans.push(self.span)
            }
            while arg in &args {
                arg.collect_receiver_params(td, types, out)
            }
        }
        _ => { }
    }
}

fun is_type_name(name: str, types: &List<String>): bool {
    return is_builtin_type_name(name) || names_contain(types, name)
}

fun names_contain(names: &List<String>, wanted: str): bool {
    while n in &names {
        if n.as_str().equals(wanted) { return true }
    }
    return false
}

fun TopDecl.declares_generic(name: str): bool {
    while tp in &self.generics {
        if tp.name.as_str().equals(name) { return true }
    }
    return false
}

/// `List<Pont>` with `Point` in scope is likelier a typo than a parameter.
fun ReceiverParams.warn_near_type_names(types: &List<String>, diags: &var Diagnostics): void {
    var i: uint64 = 0
    while i < self.names.size() {
        val name = *self.names.at(i)
        val near = nearest_type_name(name.as_str(), types)
        if near.byte_len() > 0 {
            val why = "`${name.as_str()}` is not a type in scope, so it makes this extension generic over a parameter"
            val message = "${why} named `${name.as_str()}`; did you mean `${near.as_str()}`?"
            diags.emit(new_diagnostic(Severity.Warning, new_label(self.spans.get(i), message)))
        }
        i = i + 1
    }
}

fun nearest_type_name(name: str, types: &List<String>): String {
    val len = name.byte_len()
    if len < 3 { return "" }
    var cap: uint64 = 1
    if len > 4 { cap = 2 }
    var best = ""
    var best_distance = cap + 1
    while candidate in &types {
        val distance = edit_distance(name, candidate.as_str(), cap)
        if distance > 0 && distance < best_distance {
            best = candidate.clone()
            best_distance = distance
        }
    }
    return best
}

fun TopDecl.reject_nested_extensions(diags: &var Diagnostics): void {
    when (self.kind) {
        ImplBlock(methods) => reject_extension_methods(&methods, diags)
        TraitDecl(methods, _is_pub, _supers) => reject_extension_methods(&methods, diags)
        TraitImpl(_trait_ref, methods) => reject_extension_methods(&methods, diags)
        _ => { }
    }
}

fun reject_extension_methods(methods: &List<TopDecl>, diags: &var Diagnostics): void {
    while method in &methods {
        if !method.ext_name.as_str().equals("") {
            val message = "an extension function is declared at the top level, not inside `impl` or `trait`"
            diags.emit(new_diagnostic(Severity.Error, new_label((&method).decl_name_span(), message)))
        }
    }
}
