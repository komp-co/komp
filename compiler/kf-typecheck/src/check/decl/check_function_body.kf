import alloc.list.*

import kf_core.ast.CrateId
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*
import kf_resolve.*
import kf_typecheck.types.*
import kf_typecheck.*
import kf_core.span.*
import kf_core.ast.subst.subst_stmt_list
import kf_typecheck.check.check_stmt
import kf_typecheck.check.control.when_is_exhaustive
import kf_typecheck.check.value_params_of

/// Checked again from a fresh copy while uses decide a binding after earlier
/// uses saw its provisional type, each time with every decision so far.
fun check_fn_body(metadata_owner: Ptr<TopDecl>, owner: String, owner_crate: CrateId, owner_module: Sym,
    owner_file: uint32, self_name: String, impl_target: String, impl_trait: String, impl_trait_args: String,
    impl_method: String, self_mutable: bool, generics: List<String>, params: List<Param>, ret_ptr: Ptr<TypeRef>,
    body: &var List<Stmt>, diags: &var Diagnostics, sigs: Ptr<SigTable>): void {
    var no_names = List.new<String>()
    var no_types = List.new<TypeRef>()
    val pristine = subst_stmt_list(body, &var no_names, &var no_types)
    var presets = List.new<OpenDecision>()
    while attempt in 0..4 {
        val reported = (*diags).size()
        var ctx = new_type_ctx(Type.new_void(no_span()), diags, Option.None, sigs)
        ctx.presets = presets.clone()
        ctx.fn_owner = owner.clone()
        ctx.impl_trait = impl_trait.clone()
        ctx.impl_trait_args = impl_trait_args.clone()
        ctx.impl_method = impl_method.clone()
        ctx.seed_generics(generics.clone())
        ctx.owner_crate = owner_crate
        ctx.owner_module = owner_module
        ctx.owner_file = owner_file
        ctx.metadata_owner = metadata_owner
        ctx.declare_value_params()
        if !impl_target.as_str().equals("") {
            ctx.self_ty = impl_target_ty(impl_target.as_str(), no_span(), ctx.string_name())
        }
        val ret_tr: TypeRef = unsafe { *ret_ptr }
        ctx.return_ty = ret_tr.resolve_type_ref(&var ctx)
        val is_free = self_name.as_str().equals("")
        if !is_free {
            ctx.params.push(String.from("self"))
            // Resolved, not assumed a struct: `impl Display for str` has a
            // primitive target.
            var self_ty = Type.new_poison()
            if ctx.self_ty.is_poison() {
                val self_kind = TypeRefKind.Named(intern(self_name.as_str()), List.new<TypeRef>())
                val self_tr = TypeRef.new(no_span(), self_kind)
                self_ty = self_tr.resolve_type_ref(&var ctx)
            } else {
                self_ty = ctx.self_ty.clone()
            }
            if self_mutable {
                ctx.declare(String.from("self"), self_ty)
            } else {
                ctx.declare_val(String.from("self"), self_ty)
            }
        }
        // Parameters are immutable; mutating the caller's value needs `&var` in
        // the type.
        var i = 0
        while i < params.size() {
            val p = *params.at(i)
            val ty_ptr: Ptr<TypeRef> = p.ty
            val p_tr: TypeRef = unsafe { *ty_ptr }
            val pty = p_tr.resolve_type_ref(&var ctx)
            ctx.params.push(p.name.as_string())
            ctx.declare_val(p.name.as_string(), pty)
            i = i + 1
        }
        val decisions = ctx.check_fn_statements(body, ret_tr.span, owner.clone())
        if decisions.size() == 0 || attempt == 3 { return }
        while (*diags).size() > reported { (*diags).pop() }
        while decision in &decisions { presets.push(decision.clone()) }
        *body = subst_stmt_list(&pristine, &var no_names, &var no_types)
    }
}

/// The decisions uses made after earlier uses, which need another check.
mutating fun TypeCtx.check_fn_statements(body: &var List<Stmt>, ret_span: Span, owner: String): List<OpenDecision> {
    while j in 0..body.size() {
        (body.at_mut(j)).check_stmt(self)
    }
    // Every slot has been applied; a `null` still untyped never will be.
    self.report_untyped_nulls()
    // A wide literal no slot sized is left at `int32`, where it does not fit.
    self.report_unsized_wide_literals()
    // Likewise a static call on a generic type only a slot could complete,
    // and a literal whose elements only a slot could make agree.
    self.report_open_calls()
    self.report_unsettled_literals()
    // Non-void functions must return on every path. `Void`, `Never` and
    // `Poison` are exempt.
    when (self.return_ty.kind) {
        Void => { }
        Never => { }
        Poison => { }
        _ => {
            if !all_paths_return(body, self) {
                emit_missing_return_err(self.diags, ret_span, owner.clone())
            }
        }
    }
    return self.decisions.clone()
}

// Control leaves `stmts` only by return or divergence. Conservative: unsure
// answers "returns", so valid code is never flagged. `ctx` lets a `when`
// ask whether it is exhaustive.
fun all_paths_return(stmts: &List<Stmt>, ctx: &var TypeCtx): bool {
    while stmt in &stmts {
        if (stmt).all_paths_return_stmt(ctx) { return true }
    }
    return false
}

fun Stmt.all_paths_return_stmt(ctx: &var TypeCtx): bool {
    when (self.kind) {
        Return(_e) => return true
        If(_c, then_body, else_body) => {
            // Both branches must exist and return.
            if else_body.size() == 0 { return false }
            return all_paths_return(&then_body, ctx) && all_paths_return(&else_body, ctx)
        }
        When(subj_ptr, arms) => {
            // A `when` covers all paths only if exhaustive.
            if arms.size() == 0 { return false }
            if !when_is_exhaustive(unsafe { subj_ptr.ty }, &arms, ctx) { return false }
            while arm in &arms {
                if !all_paths_return(&arm.body, ctx) { return false }
            }
            return true
        }
        Switch(_subj, sarms) => {
            // Post-Lower only; Lower emits a default arm.
            if sarms.size() == 0 { return false }
            while sa in &sarms {
                if !all_paths_return(&sa.body, ctx) { return false }
            }
            return true
        }
        While(cond_ptr, _body) => {
            // `while true` without a `break` diverges; a `break` only causes a
            // missed error.
            return is_literal_true(unsafe { *cond_ptr })
        }
        Expression(e_ptr) => return tail_expr_diverges(unsafe { *e_ptr }, ctx)
        _ => return false
    }
}

// Typed Never, or a call to a function that cannot return.
fun tail_expr_diverges(e: Expr, ctx: &var TypeCtx): bool {
    when (e.ty.kind) {
        Never => return true
        _ => { }
    }
    return when (e.kind) {
        Call(name, _args) => callee_cannot_return(name.as_str(), ctx)
        _ => false
    }
}

/// The declared return type has no values, so the function cannot return.
fun callee_cannot_return(name: str, ctx: &var TypeCtx): bool {
    when (unsafe { (*ctx.sigs).find_signature(name) }) {
        Some(sig) => return sig.ret.type_is_uninhabited(ctx)
        None => return false
    }
}

fun is_literal_true(e: Expr): bool {
    return when (e.kind) {
        LitBool(v) => v
        _ => false
    }
}

fun emit_missing_return_err(diags: &var Diagnostics, span: Span, fn_name: String): void {
    val lab = new_label(span, "function `${fn_name}` does not return on all paths (a non-void function must return a value on every path)")
    diags.emit(new_diagnostic(Severity.Error, lab))
}

fun check_method_body(struct_name: String, generics: List<String>, impl_trait: String, impl_trait_args: String, td: &var TopDecl, diags: &var Diagnostics, sigs: Ptr<SigTable>): void {
    when (td.kind) {
        Function(params, ret_ptr, body, _pub, _unsafe, is_mutating, is_static) => {
            // An instance `clone` must return Self: the glue assumes it.
            if !is_static {
                if td.name.as_str() == "clone" {
                    if !ret_tref_is_self(unsafe { *ret_ptr }, struct_name) {
                        emit_clone_ret_err(diags, td.span, struct_name.clone())
                    }
                }
                // `drop` is keyed on the name after Mono, so an ordinary method
                // called `drop` would become the destructor. Allowed only in the
                // destructor's shape, `fun drop(): void`.
                if td.name.as_str() == "drop" {
                    if !(unsafe { &*ret_ptr }).is_void() || params.size() > 0 {
                        emit_drop_shape_err(diags, td.span, struct_name.clone())
                    }
                }
            }
            // A static method has no `self`.
            val owner = method_body_owner(struct_name.clone(), td.name.as_string())
            val self_name = if is_static { String.from("") } else { struct_name }
            // The impl's generics and the method's own, so a method-level `<A>`
            // reaches bounded dispatch.
            var body_generics = List.new<String>()
            while generic in &generics {
                body_generics.push(generic)
            }
            val own_body_generics = type_param_names(td.generics)
            while own_body_generic in &own_body_generics {
                body_generics.push(own_body_generic)
            }
            check_fn_body(td, owner, td.crate, td.scope_module(), td.span.file_id, self_name, struct_name, impl_trait, impl_trait_args, td.name.as_string(), is_mutating, body_generics, params, ret_ptr, &var body, diags, sigs)
        }
        _ => { }
    }
}

// `ret` names the impl's own struct: `Pair<A, B>` for
// `impl Clone for Pair<A,B>`.
fun ret_tref_is_self(ret: TypeRef, struct_name: String): bool {
    return when (ret.kind) {
        Named(n, _args) => n.as_str() == struct_name.as_str()
        _ => false
    }
}

fun emit_clone_ret_err(diags: &var Diagnostics, span: Span, struct_name: String): void {
    val msg = "`clone` must return Self (`${struct_name}`): the name is reserved for the deep-clone that returns the receiver's type"
    val lab = new_label(span, msg)
    diags.emit(new_diagnostic(Severity.Error, lab))
}

fun emit_drop_shape_err(diags: &var Diagnostics, span: Span, struct_name: String): void {
    val msg = "`drop` on `${struct_name}` must be `fun drop(): void` with no parameters: the name is reserved for the destructor komp calls at scope exit (rename it, or give it the destructor's signature)"
    val lab = new_label(span, msg)
    diags.emit(new_diagnostic(Severity.Error, lab))
}

fun emit_take_reserved_err(diags: &var Diagnostics, span: Span): void {
    // CONSTRAINT: the message is built inline; a `val msg` would be dropped
    // after the Label took it.
    val lab = new_label(span, String.from("`take` is a reserved intrinsic name; a free function cannot be named `take` (rename it, or make it a method on a type)"))
    diags.emit(new_diagnostic(Severity.Error, lab))
}

fun emit_builtin_type_name_reserved_err(diags: &var Diagnostics, span: Span, name: String): void {
    val message = "`${name}` is reserved for a builtin type; a free function cannot be named `" + name + "` (rename it)"
    diags.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// Each of the owner's value parameters is a constant of its type.
mutating fun TypeCtx.declare_value_params(): void {
    val found = self.value_params_of(self.fn_owner.as_str())
    while info in &found {
        val ty = info.ty.resolve_type_ref(self)
        self.declare_val(info.param.clone(), ty)
    }
}
