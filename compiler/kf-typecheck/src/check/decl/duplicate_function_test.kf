// The message is asserted, not just that something was reported.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module

fun dupfn_in(td: TopDecl, module_path: str): TopDecl {
    var owned = td
    owned.crate = new_crate_id("sample")
    owned.module_path = intern(module_path)
    return owned
}

fun dupfn_int32(): Ptr<TypeRef> {
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    return ret
}

fun dupfn_function(name: str): TopDecl {
    return dupfn_in(new_top_decl(no_span(), String.from(name), TopDeclKind.Function(List.new<Param>(), dupfn_int32(), List.new<Stmt>(), true, false, false, false)), "sample.api")
}

fun dupfn_extern(name: str): TopDecl {
    return dupfn_in(new_top_decl(no_span(), String.from(name), TopDeclKind.Extern(List.new<Param>(), dupfn_int32(), false, false)), "sample.api")
}

fun dupfn_reported(decls: List<TopDecl>, needle: str): bool {
    var module = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    var declarations = new_decl_table()
    resolve_module(&var module, &var declarations)
    val diagnostics = module.typecheck_module(&var declarations)
    while diagnostic in &diagnostics {
        if (diagnostic.primary.message.as_str()).contains(needle) { return true }
    }
    return false
}

@test
fun a_function_defined_twice_in_one_module_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(dupfn_function("twice"))
    decls.push(dupfn_function("twice"))
    assert_eq(dupfn_reported(decls, "`twice` is already defined in this module"), true, "the repeat is reported where it is written")
}

@test
fun distinct_function_names_in_one_module_are_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(dupfn_function("once"))
    decls.push(dupfn_function("twice"))
    // Guards against reporting every function.
    assert_eq(dupfn_reported(decls, "is already defined in this module"), false, "two different names are not a repeat")
}

@test
fun an_extern_declared_twice_in_one_module_is_accepted(): void {
    var decls = List.new<TopDecl>()
    decls.push(dupfn_extern("kf_str_byte_len"))
    decls.push(dupfn_extern("kf_str_byte_len"))
    assert_eq(dupfn_reported(decls, "is already defined in this module"), false, "each file declares the externs it calls")
}

@test
fun a_function_name_repeated_in_another_module_of_the_crate_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(dupfn_function("twice"))
    decls.push(dupfn_in(dupfn_function("twice"), "sample.other"))
    val expected = "`twice` is already defined in module `sample.api`; a function name is unique within its crate"
    assert_eq(dupfn_reported(decls, expected), true, "one crate is one C namespace")
}
