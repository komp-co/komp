// `@lang("key")`; see kf-core's lang_item.kf.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

/// Only the standard library declares lang items.
pub fun may_declare_lang_items(crate: CrateId): bool {
    if crate.raw == new_crate_id("core").raw { return true }
    if crate.raw == new_crate_id("alloc").raw { return true }
    return crate.raw == new_crate_id("std").raw
}

/// The registry already checked placement; this checks key and crate.
pub fun TopDecl.validate_lang_annotation(diags: &var Diagnostics): void {
    val key = self.lang_key_of()
    if !is_known_lang_key(key.as_str()) {
        self.report("unknown lang item `${key.as_str()}`: expected ${known_lang_keys_summary().as_str()}", diags)
    } else if !may_declare_lang_items(self.crate) {
        self.report(String.from("`@lang(...)` is reserved for the standard library (core, alloc and std)"), diags)
    }
}

/// The registry already checked placement; this checks the crate.
pub fun TopDecl.validate_prelude_annotation(diags: &var Diagnostics): void {
    if !may_declare_lang_items(self.crate) {
        self.report(String.from("`@prelude` is reserved for the standard library (core, alloc and std)"), diags)
    }
}

/// One declaration per key in the whole graph.
pub fun Module.reject_duplicate_lang_items(diags: &var Diagnostics): void {
    var seen = List.new<String>()
    while td in &self.decls {
        val key = (&td).lang_key_of()
        if !key.as_str().equals("") && may_declare_lang_items(td.crate) {
            if key_seen(&seen, key.as_str()) {
                td.report("`@lang(\"${key.as_str()}\")` is declared more than once", diags)
            } else {
                seen.push(key)
            }
        }
    }
}

/// A type named like the lang string would be shadowed by it, so it is
/// refused. Without a lang string the name is free.
pub fun TopDecl.rejects_lang_type_name(lang_string: Sym, diags: &var Diagnostics): bool {
    if lang_string.as_str().equals("") { return false }
    when (self.kind) {
        Struct(_fields, _is_pub) => { }
        EnumDecl(_variants, _is_pub) => { }
        _ => return false
    }
    if !self.name.as_str().equals(lang_string.as_str()) { return false }
    if self.lang_key_of().as_str().equals(lang_string_key()) { return false }
    val name = self.name.as_str()
    self.report("`${name}` is the language's string type; a type cannot be declared with that name (rename it)", diags)
    return true
}

fun key_seen(keys: &List<String>, key: str): bool {
    while k in keys {
        if k.as_str() == key { return true }
    }
    return false
}

fun TopDecl.report(message: String, diags: &var Diagnostics): void {
    diags.emit(new_diagnostic(Severity.Error, new_label(self.decl_name_span(), message)))
}
