// `@no_mangle`: a type whose C name has no crate prefix, for hand-written C.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

/// Two unmangled types of one name anywhere would define one C type twice.
pub fun Module.reject_colliding_no_mangle(diags: &var Diagnostics): void {
    var seen = List.new<String>()
    while td in &self.decls {
        if td.type_is_no_mangle_decl() {
            if list_has(&seen, td.name.as_str()) {
                val message = "two types named `${td.name.as_str()}` are `@no_mangle`, so their C names collide"
                diags.emit(new_diagnostic(Severity.Error, new_label((&td).decl_name_span(), message)))
            } else {
                seen.push(td.name.as_string())
            }
        }
    }
}

fun TopDecl.type_is_no_mangle_decl(): bool {
    if !self.has_annotation("no_mangle") { return false }
    return when (self.kind) {
        Struct(_fields, _is_pub) => true
        EnumDecl(_variants, _is_pub) => true
        _ => false
    }
}

fun list_has(names: &List<String>, name: str): bool {
    while n in names {
        if n.as_str() == name { return true }
    }
    return false
}

/// Before registration, so an impl ahead of its type sees it.
pub fun Module.record_no_mangle_types(sigs: Ptr<SigTable>): void {
    while td in &self.decls {
        if td.type_is_no_mangle_decl() { unsafe { (*sigs).no_mangle_types.push(td.name.as_string()) } }
    }
}

pub fun no_mangle_type_recorded(sigs: Ptr<SigTable>, name: str): bool {
    var i: uint64 = 0
    while i < unsafe { (*sigs).no_mangle_types.size() } {
        if unsafe { *(*sigs).no_mangle_types.at(i) }.as_str() == name { return true }
        i = i + 1
    }
    return false
}
