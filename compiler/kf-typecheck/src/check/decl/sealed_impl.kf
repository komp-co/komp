// A `sealed trait` is implemented only in its own crate; any crate may still
// bound by it and call its methods.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

/// Each impl of this crate for another crate's sealed trait, reported at the
/// trait it names.
pub fun Module.check_sealed_impls(diags: &var Diagnostics): void {
    while td in &self.decls {
        if td.crate.raw != self.crate.raw { continue }
        val implemented = td.implemented_trait() ?: continue
        val trait_name = implemented.named_trait()
        val sealed = self.sealed_trait_named(trait_name.as_str()) ?: continue
        if sealed.crate.raw == td.crate.raw { continue }
        val owner = Sym { id: sealed.crate.raw }.as_str()
        val message = "`${trait_name.as_str()}` is sealed: only its crate, `${owner}`, implements it"
        var diag = new_diagnostic(Severity.Error, new_label(implemented.span, message))
        // A trait read from an interface has no source to point at.
        val at = sealed.decl_name_span()
        if !at.is_none() { diag.secondary.push(new_label(at, "sealed here")) }
        diags.emit(diag)
    }
}

fun TopDecl.implemented_trait(): TypeRef? {
    when (self.kind) {
        TraitImpl(tref, _methods) => return (*tref).clone()
        _ => return null
    }
}

/// The trait's own name, without a module path.
fun TypeRef.named_trait(): String {
    return when (self.kind) {
        Named(name, _args) => {
            val parts = name.as_str().split(".")
            parts.at(parts.size() - 1).clone()
        }
        _ => String.from("")
    }
}

/// Trait names are unique across a program, so the name finds it.
fun Module.sealed_trait_named(name: str): TopDecl? {
    while td in &self.decls {
        if !td.is_sealed || td.name.as_str() != name { continue }
        when (td.kind) {
            TraitDecl(_methods, _is_pub, _supers) => return td.clone()
            _ => {}
        }
    }
    return null
}
