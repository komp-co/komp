import core.assert.assert_eq
import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.CrateId
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.span.no_span

fun edge_map(pairs: &List<String>): HashMap<String, List<String>> {
    var edges = HashMap.new<String, List<String>>()
    while pair in &pairs {
        val parts = pair.split(">")
        var held = List.new<String>()
        if parts.at(1).byte_len() > 0 { held.push(parts.at(1).clone()) }
        edges.insert(parts.at(0).clone(), held)
    }
    return edges
}

fun graph(text: str): HashMap<String, List<String>> {
    return edge_map(&text.split(" "))
}

@test fun a_type_holding_itself_is_found(): void {
    assert_eq(holds_itself("A", "*|A", &graph("A>A")), true, "a direct cycle")
}

@test fun a_cycle_through_another_type_is_found(): void {
    assert_eq(holds_itself("A", "*|A", &graph("A>B B>A")), true, "A holds B, which holds A")
}

@test fun a_type_holding_a_cycle_it_is_not_in_is_not(): void {
    assert_eq(holds_itself("A", "*|A", &graph("A>B B>B")), false, "B's cycle is B's")
}

@test fun a_chain_without_a_cycle_is_fine(): void {
    assert_eq(holds_itself("A", "*|A", &graph("A>B B>C C>")), false, "it ends")
}

@test fun a_field_names_its_declared_type_by_crate_and_name(): void {
    val t = Type { kind: TypeKind.Struct(intern("app::shapes::Point")), provenance: Provenance.Inferred(no_span()) }
    assert_eq(inline_key(&t), layout_key(new_crate_id("app"), "Point"), "the crate keeps two `Point`s apart")
}

@test fun a_field_names_an_instance_by_its_mangled_name(): void {
    val t = Type { kind: TypeKind.EnumTy(intern("Option__A")), provenance: Provenance.Inferred(no_span()) }
    assert_eq(inline_key(&t), "*|Option__A", "no crate is written")
}

@test fun a_field_behind_a_pointer_holds_nothing_inline(): void {
    val t = Type.new_box(Type.new_int32(no_span()), no_span())
    assert_eq(inline_key(&t), "", "a box is a pointer")
}

@test fun a_cycle_back_through_the_plain_name_is_found(): void {
    assert_eq(holds_itself("1|A", "*|A", &graph("1|A>*|Array__A__2 *|Array__A__2>*|A")), true, "an array's element")
}

@test fun a_plain_name_key_merges_what_each_crate_holds(): void {
    var edges = HashMap.new<String, List<String>>()
    var first = List.new<String>()
    first.push(String.from("1|B"))
    var second = List.new<String>()
    second.push(String.from("2|C"))
    insert_edges(&var edges, CrateId { raw: 1 }, "A", first)
    insert_edges(&var edges, CrateId { raw: 2 }, "A", second)
    assert_eq(edges.get(&String.from("*|A"))?.size() ?: 0, 2, "both crates' edges")
}
