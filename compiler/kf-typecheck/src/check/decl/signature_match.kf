// A function or method against a function-type target, or a signature
// pattern whose `_` stands for any one type and whose trailing `..` for any
// further parameters. A pattern's resolved type carries poison for each `_`.

import alloc.list.*

import kf_core.span.no_span

import kf_core.ast.Sym
import kf_core.ast.types.*
import kf_core.ast.declaration.MarkTarget
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_typecheck.*
import kf_typecheck.types.type_eq
import kf_typecheck.types.display_type_ref
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.seed_generics
import kf_typecheck.types.type_param_names
import kf_typecheck.traits.trait_impl_owner_name

/// A function target's type, or a pattern's with poison for each `_`,
/// resolved as `owner` sees it; poison for a kind target. Resolution errors,
/// an unknown type through `decls`, are reported only for this crate's
/// annotations, which pass it.
pub fun MarkTarget.function_type(owner: &TopDecl, decls: Ptr<DeclTable>?, sigs: Ptr<SigTable>,
    diags: &var Diagnostics): Type {
    var ctx = new_type_ctx(Type.new_void(no_span()), diags, Option.None, sigs)
    ctx.place_at(owner)
    ctx.table = decls
    ctx.quiet = decls == null
    ctx.seed_generics(type_param_names(owner.generics))
    when (self) {
        Function(ty) => return (*ty).resolve_type_ref(&var ctx)
        Signature(params, _has_rest, ret) => {
            var types = List.new<Type>()
            while param in &params {
                types.push(param.slot_type(&var ctx))
            }
            return Type.new_fn(types, (*ret).slot_type(&var ctx), Provenance.Inferred(owner.span))
        }
        _ => return Type.new_poison()
    }
}

/// Poison for `_`, a borrow of poison for `&_` or `&var _`.
fun TypeRef.slot_type(ctx: &var TypeCtx): Type {
    if self.is_wildcard() { return Type.new_poison() }
    when (self.kind) {
        Reference(is_mutable, inner) => {
            if inner.is_wildcard() { return Type.new_poison().borrowed(is_mutable, self.span) }
        }
        _ => {}
    }
    return self.resolve_type_ref(ctx)
}

/// Whether this function, a method of `owner` or top-level, matches the
/// target, reported when it does not. `bound` receives what each type
/// parameter stands for, in order.
fun TopDecl.fits_signature(kind: str, declared: &DeclaredAnnotation, owner: &MethodOwner, table: &SigTable,
    sigs: Ptr<SigTable>, pass_diags: &var Diagnostics, bound: &var List<Type>,
    diags: &var List<Diagnostic>): bool {
    val at = self.decl_name_span()
    if !self.is_plain_function() {
        diags.push(error_at(at, "`@${kind}` can only annotate a function"))
        return false
    }
    if owner.is_generic {
        val why = "a function value has one type"
        diags.push(error_at(at, "`@${kind}` cannot annotate a method of a generic type: ${why}"))
        return false
    }
    val own = self.own_function_type(owner, sigs, pass_diags)
    val has_rest = declared.target.has_rest()
    var bindings = no_bindings()
    if !own.matches_target(&declared.function_type, has_rest, &var bindings) {
        val wanted = declared.target.signature_display()
        val is_pattern = has_rest || declared.type_params.size() > 0 || declared.function_type.has_wildcard()
        val verb = if is_pattern { "match" } else { "have type" }
        diags.push(error_at(at, "a function marked `@${kind}` must ${verb} `${wanted.as_str()}`"))
        return false
    }
    var fits = true
    while param in &declared.type_params {
        val ty = bindings.of(param.name) ?: Type.new_poison()
        while trait_bound in &param.bounds {
            val trait_name = trait_bound.bare_name()
            val type_name = ty.kind.trait_impl_owner_name()
            if !table.type_implements(type_name.as_str(), trait_name.as_str(), "") {
                val stands = "to stand for `${param.name.as_str()}` in `@${kind}`"
                diags.push(error_at(at, "`${type_name.as_str()}` must implement `${trait_name.as_str()}` ${stands}"))
                fits = false
            }
        }
        bound.push(ty)
    }
    return fits
}

/// What each type parameter stands for, as a match binds them.
struct TypeBindings {
    var names: List<Sym>
    var types: List<Type>
}

fun no_bindings(): TypeBindings {
    return TypeBindings { names: List.new<Sym>(), types: List.new<Type>() }
}

impl TypeBindings {
    /// Binds `name` to `ty`, or holds `ty` to an earlier binding.
    mutating fun bind(name: Sym, ty: Type): bool {
        val earlier = self.of(name)
        if earlier != null {
            val held = earlier ?: return false
            return held.type_eq(ty)
        }
        self.names.push(name)
        self.types.push(ty)
        return true
    }

    fun of(name: Sym): Type? {
        while i in 0..self.names.size() {
            if self.names.at(i).id == name.id { return *self.types.at(i) }
        }
        return null
    }
}

fun MarkTarget.has_rest(): bool {
    return when (self) {
        Signature(_params, has_rest, _ret) => has_rest
        _ => false
    }
}

/// The target as written: `(Request) -> int32`, `(bool, ..) -> _`.
fun MarkTarget.signature_display(): String {
    when (self) {
        Function(ty) => return (*ty).display_type_ref()
        Signature(params, has_rest, ret) => {
            var out = String.from("(")
            while i in 0..params.size() {
                if i > 0 { out.append(", ") }
                out.append(params.at(i).display_type_ref().as_str())
            }
            if has_rest { out.append(if params.size() > 0 { ", .." } else { ".." }) }
            out.append(") -> ")
            out.append((*ret).display_type_ref().as_str())
            return out
        }
        _ => return String.from("")
    }
}

fun Type.has_wildcard(): bool {
    val parts = self.fn_parts() ?: return false
    if parts.ret.through_borrow().is_poison() { return true }
    while param in &parts.params {
        if param.through_borrow().is_poison() { return true }
    }
    return false
}

/// Whether a function of this type may be marked by a target of type
/// `target`: slot by slot, with a trailing `..` admitting further parameters
/// and each type parameter bound where it first appears.
fun Type.matches_target(target: &Type, has_rest: bool, bindings: &var TypeBindings): bool {
    val own = self.fn_parts() ?: return false
    val wanted = target.fn_parts() ?: return false
    val count = own.params.size()
    if count < wanted.params.size() || (!has_rest && count != wanted.params.size()) { return false }
    while i in 0..wanted.params.size() {
        if !own.params.at(i).fits_slot(wanted.params.at(i), true, bindings) { return false }
    }
    return own.ret.fits_slot(&wanted.ret, false, bindings)
}

/// `_` takes any type, `&_` any shared borrow and `&var _` a mutable one, and
/// a type parameter does the same while binding what it stands for. Any other
/// slot takes its own type. With `lends`, a `&T` also stands where the slot
/// is `&var T` or `&var _`, since a shared borrow can be lent from a mutable
/// one.
fun Type.fits_slot(slot: &Type, lends: bool, bindings: &var TypeBindings): bool {
    val pointee = slot.through_borrow()
    val param = pointee.type_param_name()
    if !pointee.is_poison() && param == null { return self.type_eq(*slot) || (lends && self.lends_from(slot)) }
    val is_slot_borrow = slot.is_borrow(false) || slot.is_borrow(true)
    if slot.is_borrow(false) && !self.is_borrow(false) { return false }
    if slot.is_borrow(true) && !self.is_borrow(true) && !(lends && self.is_borrow(false)) { return false }
    val name = param ?: return true
    return bindings.bind(name, if is_slot_borrow { self.through_borrow() } else { *self })
}

/// `T` for a type parameter, null otherwise.
pub fun Type.type_param_name(): Sym? {
    return when (self.kind) {
        Generic(name) => name
        _ => null
    }
}

/// `&T` where `target` is `&var T`.
fun Type.lends_from(target: &Type): bool {
    return self.is_borrow(false) && target.is_borrow(true) && self.through_borrow().type_eq(target.through_borrow())
}

pub fun Type.is_borrow(is_mutable: bool): bool {
    return when (self.kind) {
        RefTo(mutable, _inner) => mutable == is_mutable
        _ => false
    }
}

/// A free function or method with no type parameters: one a value can name.
fun TopDecl.is_plain_function(): bool {
    if self.generics.size() > 0 || !self.ext_name.as_str().equals("") { return false }
    return when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _mut, _st) => true
        _ => false
    }
}

/// `(A) -> R` from the declaration as written, resolved in its own module, a
/// method's receiver first. Quiet: the signature's own errors were reported
/// when it was registered.
fun TopDecl.own_function_type(owner: &MethodOwner, sigs: Ptr<SigTable>, diags: &var Diagnostics): Type {
    var ctx = new_type_ctx(Type.new_void(no_span()), diags, Option.None, sigs)
    ctx.place_at(self)
    ctx.quiet = true
    return when (self.kind) {
        Function(params, ret, _b, _pub, _u, is_mutating, is_static) => {
            var param_types = List.new<Type>()
            if owner.is_method() && !is_static {
                val receiver = TypeRef.new(self.span, TypeRefKind.Named(owner.type_name, List.new<TypeRef>()))
                param_types.push(receiver.resolve_type_ref(&var ctx).borrowed(is_mutating, self.span))
            }
            while param in &params {
                param_types.push((*param.ty).resolve_type_ref(&var ctx))
            }
            Type.new_fn(param_types, (*ret).resolve_type_ref(&var ctx), Provenance.Inferred(self.span))
        }
        _ => Type.new_poison()
    }
}
