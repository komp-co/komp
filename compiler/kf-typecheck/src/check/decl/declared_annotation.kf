// `annotation bench(...) on TARGET` declares `@bench(...)`. Registers every
// declaration, then resolves and checks each use in this crate for
// `annotated`.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.Module
import kf_core.ast.types.Type
import kf_core.ast.declaration.*
import kf_core.ast.annotation.annotation_is_known
import kf_core.ast.annotation.known_annotations_summary
import kf_core.diagnostic.*
import kf_typecheck.*

pub fun unknown_annotation(kind: str, at: Span): Diagnostic {
    val built_in = known_annotations_summary()
    val message = "unknown annotation `@${kind}`: declare it with `annotation ${kind}`, or use ${built_in.as_str()}"
    return new_diagnostic(Severity.Error, new_label(at, message))
}

/// `decls` reports a target naming an unknown type; a dependency's
/// annotations were checked in their own crate and resolve without it.
pub fun Module.register_declared_annotations(sigs: Ptr<SigTable>, diags: &var Diagnostics,
    decls: Ptr<DeclTable>?): void {
    val table = unsafe { &var *sigs }
    var found = List.new<Diagnostic>()
    while td in &self.decls {
        when (td.kind) {
            AnnotationDecl(own_params, own_target, is_pub) => {
                val own = td.crate.raw == self.crate.raw
                if annotation_is_known(td.name.as_str()) {
                    if own {
                        val message = "`@${td.name.as_str()}` is a built-in annotation and cannot be declared"
                        found.push(new_diagnostic(Severity.Error, new_label(td.decl_name_span(), message)))
                    }
                } else {
                    if own {
                        check_annotation_params(&own_params, table, self.crate, &var found)
                        own_target.check_bounds(table, &var found)
                        td.check_type_params(table, &var found)
                    }
                    val params = if own { own_params.clone() } else { self.argument_struct_params(&td) }
                    val function_type = own_target.function_type(&td, if own { decls } else { null }, sigs, diags)
                    val declared = DeclaredAnnotation {
                        name: td.name, crate: td.crate, module: td.module_path, is_pub: is_pub, params: params,
                        target: own_target.clone(), function_type: function_type, type_params: td.generics.clone()
                    }
                    table.annotations.push(declared)
                }
            }
            _ => {}
        }
    }
    while td in &self.decls {
        if td.crate.raw != self.crate.raw { continue }
        while annotation in &td.annotations {
            val kind = annotation.name.as_str()
            if kind.equals("") || annotation_is_known(kind) { continue }
            td.register_annotation_use(annotation, &top_level_owner(), sigs, diags, table, &var found)
        }
        td.register_member_annotations(sigs, diags, table, &var found)
    }
    while diag in &found {
        diags.emit(diag)
    }
}

/// `sigs` is `table`, for recording the import use; `pass_diags` is where
/// `diags` go once the pass ends.
fun TopDecl.register_annotation_use(annotation: &Annotation, owner: &MethodOwner, sigs: Ptr<SigTable>,
    pass_diags: &var Diagnostics, table: &var SigTable, diags: &var List<Diagnostic>): void {
    val kind = annotation.name.as_str()
    val file = self.span.file_id
    val found = table.find_annotation(kind, file, self.crate, self.module_path)
    if found == null {
        diags.push(unknown_annotation(kind, self.decl_name_span()))
        return
    }
    val index = found ?: return
    val declared = table.annotations.at(index)
    note_import_use_named(sigs, file, declared.module, declared.name)
    val arguments = annotation.arguments_in_order(&declared.params, table, self.crate, diags)
    if !arguments.ok { return }
    var bound = List.new<Type>()
    if !self.fits_target(kind, &declared, owner, table, sigs, pass_diags, &var bound, diags) { return }
    val symbol = self.value_symbol(owner)
    while listed in &table.annotated {
        if listed.annotation == index && listed.item.id == symbol.id { return }
    }
    val marked = self.mark_kind() ?: return
    table.annotated.push(AnnotatedItem {
        annotation: index, item: symbol, name: self.listed_name(owner), bindings: bound, kind: marked,
        module: self.module_path, args: arguments.values
    })
}

/// A dependency's annotation has no parameters of its own in the interface;
/// they are the fields of the argument struct beside it.
fun Module.argument_struct_params(annotation: &TopDecl): List<Param> {
    var params = List.new<Param>()
    while other in &self.decls {
        if other.crate.raw != annotation.crate.raw || other.module_path.id != annotation.module_path.id { continue }
        if other.name.id != annotation.name.id { continue }
        when (other.kind) {
            Struct(fields, _pub) => {
                while field in &fields {
                    params.push(new_param(field.span, field.name.as_string(), Box.new((*field.ty).clone())))
                }
                return params
            }
            _ => {}
        }
    }
    return params
}
