// The impls `@derive(...)` expands into. `Default`, `Equal` and `Hash` get a
// real body over the fields; `Clone` and `Copy` get markers so the type
// satisfies the bound, since codegen already emits a deep clone for every type.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.CrateId
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.*
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.annotation.new_annotation

fun synth_default_impl(name: String, fields: &List<Field>, span: Span, owner: CrateId, module_path: Sym,
    trait_sym: Sym): TopDecl {
    // return Name { field: <default>, ... }
    var inits = List.new<FieldInit>()
    while f in &fields {
        val dv: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *dv = default_value_expr(f.ty, span) }
        inits.push(FieldInit.new(span, f.name.as_string(), dv))
    }
    val slit_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_ptr = Expr.new(span, ExprKind.StructLit(intern(name.as_str()), inits)) }
    val ret_operand: Box<Expr>? = slit_ptr
    var body = List.new<Stmt>()
    body.push(Stmt.new(span, StmtKind.Return(ret_operand)))

    // static fun default(): Name { body }
    val ret_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ref = TypeRef.new(span, TypeRefKind.Named(intern(name.as_str()), List.new<TypeRef>())) }
    var default_fn = new_top_decl(span, String.from("default"),
        TopDeclKind.Function(List.new<Param>(), ret_ref, body, true, false, false, true))
    default_fn.crate = owner
    default_fn.module_path = module_path
    var methods = List.new<TopDecl>()
    methods.push(default_fn)

    // impl Default for Name
    val trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ref = TypeRef.new(span, TypeRefKind.Named(trait_sym, List.new<TypeRef>())) }
    var implementation = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ref, methods))
    implementation.crate = owner
    // Both crate and module path, or the impl's identity misses the struct's.
    implementation.module_path = module_path
    return implementation
}

fun synth_equal_impl(name: String, fields: &List<Field>, span: Span, owner: CrateId, module_path: Sym,
    trait_sym: Sym): TopDecl {
    var params = List.new<Param>()
    val other_named: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *other_named = TypeRef.new(span, TypeRefKind.Named(intern(name.as_str()), List.new<TypeRef>())) }
    val other_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *other_type = TypeRef.new(span, TypeRefKind.Reference(false, other_named)) }
    params.push(new_param(span, String.from("other"), other_type))

    var comparison: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *comparison = Expr.new(span, ExprKind.LitBool(true)) }
    while field in &fields {
        val self_receiver: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *self_receiver = Expr.new(span, ExprKind.Variable(intern("self"))) }
        val self_value: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *self_value = Expr.new(span, ExprKind.FieldAccess(self_receiver, field.name)) }
        val other_receiver: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *other_receiver = Expr.new(span, ExprKind.Variable(intern("other"))) }
        val other_value: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *other_value = Expr.new(span, ExprKind.FieldAccess(other_receiver, field.name)) }
        val field_equal: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *field_equal = Expr.new(span, ExprKind.Binary(self_value, BinOp.Eq, other_value)) }
        val prior = comparison
        comparison = unsafe { alloc<Expr>() }
        unsafe { *comparison = Expr.new(span, ExprKind.Binary(prior, BinOp.AndAnd, field_equal)) }
    }
    val operand: Box<Expr>? = comparison
    var body = List.new<Stmt>()
    body.push(Stmt.new(span, StmtKind.Return(operand)))
    return synth_equal_trait_impl(name, params, body, span, owner, module_path, trait_sym)
}

// `@derive(Hash)`, the mirror of derived equality, so equal values hash equal:
//
//     fun hash(): uint64 { return ((0 * 31 + self.a.hash()) * 31 + self.b.hash()) }
//
// The multiply makes position matter. A field-less struct hashes to 0.
fun synth_hash_impl(name: String, fields: &List<Field>, span: Span, owner: CrateId, module_path: Sym,
    trait_sym: Sym): TopDecl {
    // Seeded with the first field's hash: a literal 0 would be int32.
    var accumulator: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *accumulator = Expr.new(span, ExprKind.LitInt(0)) }
    while i in 0..fields.size() {
        val field = *fields.at(i)
        val self_receiver: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *self_receiver = Expr.new(span, ExprKind.Variable(intern("self"))) }
        val self_value: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *self_value = Expr.new(span, ExprKind.FieldAccess(self_receiver, field.name)) }
        val field_hash: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *field_hash = Expr.new(span, ExprKind.MethodCall(self_value, intern("hash"), List.new<Expr>())) }
        if i == 0 {
            accumulator = field_hash
        } else {
            val multiplier: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *multiplier = Expr.new(span, ExprKind.LitInt(31)) }
            val scaled: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *scaled = Expr.new(span, ExprKind.Binary(accumulator, BinOp.Mul, multiplier)) }
            accumulator = unsafe { alloc<Expr>() }
            unsafe { *accumulator = Expr.new(span, ExprKind.Binary(scaled, BinOp.Add, field_hash)) }
        }
    }
    val result: Box<Expr>? = accumulator
    var body = List.new<Stmt>()
    body.push(Stmt.new(span, StmtKind.Return(result)))

    val uint64_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *uint64_type = TypeRef.new(span, TypeRefKind.Named(intern("uint64"), List.new<TypeRef>())) }
    var hash_fn = new_top_decl(span, String.from("hash"),
        TopDeclKind.Function(List.new<Param>(), uint64_type, body, true, false, false, false))
    hash_fn.crate = owner
    hash_fn.module_path = module_path
    var methods = List.new<TopDecl>()
    methods.push(hash_fn)

    val trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ref = TypeRef.new(span, TypeRefKind.Named(trait_sym, List.new<TypeRef>())) }
    var implementation = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ref, methods))
    implementation.crate = owner
    implementation.module_path = module_path
    return implementation
}

fun synth_equal_trait_impl(name: String, params: List<Param>, body: List<Stmt>,
    span: Span, owner: CrateId, module_path: Sym, trait_sym: Sym): TopDecl {
    val bool_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *bool_type = TypeRef.new(span, TypeRefKind.Named(intern("bool"), List.new<TypeRef>())) }
    var equals_fn = new_top_decl(span, String.from("equals"),
        TopDeclKind.Function(params, bool_type, body, true, false, false, false))
    equals_fn.crate = owner
    equals_fn.module_path = module_path
    var methods = List.new<TopDecl>()
    methods.push(equals_fn)

    val trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ref = TypeRef.new(span, TypeRefKind.Named(trait_sym, List.new<TypeRef>())) }
    var implementation = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ref, methods))
    implementation.crate = owner
    implementation.module_path = module_path
    return implementation
}

// A marker: the struct's clone glue already deep-copies.
fun synth_clone_impl(name: String, span: Span, owner: CrateId, module_path: Sym, trait_sym: Sym): TopDecl {
    val result_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *result_type = TypeRef.new(span, TypeRefKind.Named(intern(name.as_str()), List.new<TypeRef>())) }
    val self_value: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *self_value = Expr.new(span, ExprKind.Variable(intern("self"))) }
    val operand: Box<Expr>? = self_value
    var body = List.new<Stmt>()
    body.push(Stmt.new(span, StmtKind.Return(operand)))
    var clone_fn = new_top_decl(span, String.from("clone"),
        TopDeclKind.Function(List.new<Param>(), result_type, body, true, false, false, false))
    clone_fn.annotations.push(new_annotation(span, "derive", [String.from("Clone")]))
    clone_fn.crate = owner
    clone_fn.module_path = module_path
    var methods = List.new<TopDecl>()
    methods.push(clone_fn)

    val trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ref = TypeRef.new(span, TypeRefKind.Named(trait_sym, List.new<TypeRef>())) }
    var implementation = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ref, methods))
    implementation.crate = owner
    implementation.module_path = module_path
    return implementation
}

// `impl Copy for X { }`, reported at `name_span` so a derived impl names the type.
fun synth_copy_impl(name: String, span: Span, name_span: Span, owner: CrateId, module_path: Sym,
    trait_sym: Sym): TopDecl {
    val trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ref = TypeRef.new(span, TypeRefKind.Named(trait_sym, List.new<TypeRef>())) }
    var implementation = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ref, List.new<TopDecl>()))
    implementation.name_span = name_span
    implementation.crate = owner
    implementation.module_path = module_path
    return implementation
}

fun default_value_expr(ty: Ptr<TypeRef>, span: Span): Expr {
    val tr = unsafe { *ty }
    when (tr.kind) {
        Named(n, _args) => {
            val s = n.as_str()
            if is_int_like(s) { return Expr.new(span, ExprKind.LitInt(0)) }
            when s {
                "bool" => return Expr.new(span, ExprKind.LitBool(false))
                "float32" => return Expr.new(span, ExprKind.LitInt(0))
                "float64" => return Expr.new(span, ExprKind.LitInt(0))
                "str" => return Expr.new(span, ExprKind.LitStr(""))
                _ => { }
            }
            if s == "Ptr" {
                // 0 as Ptr<...>
                val zero: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *zero = Expr.new(span, ExprKind.LitInt(0)) }
                val tref_box: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *tref_box = tr }
                return Expr.new(span, ExprKind.Cast(zero, tref_box))
            }
            // FieldType.default()
            val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *recv = Expr.new(span, ExprKind.Variable(n)) }
            return Expr.new(span, ExprKind.MethodCall(recv, intern("default"), List.new<Expr>()))
        }
        _ => return Expr.new(span, ExprKind.LitInt(0))
    }
}

fun is_int_like(s: str): bool {
    return when s {
        "int8" => true
        "int16" => true
        "int32" => true
        "int64" => true
        "uint8" => true
        "uint16" => true
        "uint32" => true
        "uint64" => true
        "char" => true
        _ => false
    }
}
