import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_resolve.*
import kf_typecheck.types.*
import kf_typecheck.traits.*
import kf_typecheck.*
import kf_core.span.no_span
import kf_typecheck.check.borrow.infer_borrow_origin
import kf_typecheck.check.borrow.reject_unsayable_origin

/// Returns the signature table too: rendering a checked type needs it. The
/// caller owns it; what the check hands out are views of it.
pub fun check_decl_module(m: &var Module,
                          table: &var DeclTable,
                          diags: Ptr<List<Diagnostic>>,
                          caller_files: Ptr<List<uint32>>,
                          imported_targets: Ptr<List<Sym>>,
                          imported_names: Ptr<List<Sym>>): Box<SigTable> {
    var sigs = new_sig_table()
    // Per-file import lists first; a null pointer leaves them empty.
    val null_files: Ptr<List<uint32>> = unsafe { 0 as Ptr<List<uint32>> }
    val null_ptr: Ptr<List<Sym>> = unsafe { 0 as Ptr<List<Sym>> }
    if unsafe { (caller_files as uint64) != (null_files as uint64) } {
        sigs.caller_files = unsafe { caller_files.clone() }
        sigs.gate_visibility = true
    }
    if unsafe { (imported_targets as uint64) != (null_ptr as uint64) } {
        sigs.imported_targets = unsafe { imported_targets.clone() }
    }
    if unsafe { (imported_names as uint64) != (null_ptr as uint64) } {
        sigs.imported_names = unsafe { imported_names.clone() }
    }
    var owner = Box.new(sigs)
    val sig_ptr: Ptr<SigTable> = &var *owner
    // Declaration types resolve against the names that exist.
    val table_ptr: Ptr<DeclTable>? = unsafe { table as Ptr<DeclTable> }

    // Import insertion points, recorded before bodies, where unresolved names
    // are reported without the module in reach.
    while imp in &m.imports {
        if !imp.span.is_none() { note_import_end(sig_ptr, imp.span.file_id, imp.span.end) }
    }

    // Every type's identity and `@no_mangle`, separately from layouts so
    // associated-type bindings can register in between: bindings need
    // identities, and fields may be written as projections.
    while decl in &m.decls {
        decl.register_type_identity(sig_ptr)
    }
    m.record_no_mangle_types(sig_ptr)
    unsafe { (*sig_ptr).lang_string = m.lang_type_name(lang_string_key()) }
    unsafe { (*sig_ptr).lang_option = m.lang_type_name(lang_option_key()) }
    unsafe { (*sig_ptr).lang_list = m.lang_type_name(lang_list_key()) }
    // The `?` placeholder becomes the real option name.
    m.rewrite_option_module(unsafe { (*sig_ptr).lang_option })
    while td in &m.decls {
        when (td.kind) {
            TraitDecl(_members, _is_pub, _supers) => {
                val lkey = (&td).lang_key_of()
                if !lkey.as_str().equals("") {
                    unsafe { (*sig_ptr).note_lang_trait(lkey.as_str(), td.name) }
                }
            }
            _ => {}
        }
    }

    // What each trait impl chose for its associated types.
    // CONSTRAINT: after identities (`type Out = Widget` needs Widget), before
    // layouts (a field may be `Widget.Out`) and before signatures
    // (`fun make(): Widget.Out`).
    while decl in &m.decls {
        // CONSTRAINT: `at`, not `get`: a by-value TopDecl is a shallow copy
        // whose drop frees a list the module still holds.
        decl.register_assoc_bindings_decl(sig_ptr, diags)
    }

    // Every trait's name, then every trait's signatures: a method may take
    // `&var dyn OtherTrait`, which must not depend on declaration or file order.
    while decl in &m.decls {
        decl.register_trait_name(sig_ptr, diags)
    }

    // Before any field, payload or signature requests a dynamic layout.
    while trait_i in 0..m.decls.size() {
        register_trait_decl(m.decls.at_mut(trait_i), sig_ptr, diags, table_ptr)
    }

    // Impl headers, once identities and traits are registered.
    m.check_impl_headers(sig_ptr, diags)

    // Struct layouts, generic templates first: resolving `Option<Ptr<Expr>>`
    // instantiates from the template's layout, and a missed instantiation is
    // never retried.
    while gi0 in 0..m.decls.size() {
        val td_g = m.decls.at_mut(gi0)
        if unsafe { td_g.generics.size() } > 0 { register_struct(td_g, sig_ptr, diags, table_ptr) }
    }
    while i in 0..m.decls.size() {
        val td = m.decls.at_mut(i)
        if unsafe { td.generics.size() } == 0 { register_struct(td, sig_ptr, diags, table_ptr) }
    }

    // CONSTRAINT: every trait, impl and struct is registered by here: what
    // these read may be declared below the declaration they check.
    check_supertrait_cycles(unsafe { &*sig_ptr }, diags)
    m.check_supertrait_obligations(unsafe { &*sig_ptr }, diags)
    m.check_supertrait_assoc_shadowing(unsafe { &*sig_ptr }, diags)
    m.check_copy_impls(sig_ptr, table_ptr, diags)

    // Every trait is known, so impls can attach complete vtable facts.
    while dyn_i in 0..m.decls.size() {
        register_dyn_vtable_decl(m.decls.at_mut(dyn_i), sig_ptr, diags)
    }

    m.reject_duplicate_functions(diags)

    // Signatures, so bodies can call forward and resolve methods.
    while ii in 0..m.decls.size() {
        register_sigs(m.decls.at_mut(ii), sig_ptr, diags, table_ptr)
    }

    // Bodies. A lambda parks a synthesized struct and impl on the table; the
    // loop bound is re-read, so appended declarations are checked too,
    // including ones from lambdas in synthesized bodies.
    while k in 0..m.decls.size() {
        check_top_decl(m.decls.at_mut(k), table, diags, sig_ptr)
        m.drain_synth_decls(sig_ptr)
    }

    // Every resolvable associated-type projection becomes the impl's choice.
    // CONSTRAINT: last, so the unbound and ambiguous projection diagnostics
    // above still fire; the rest are left for Mono.
    m.subst_projections_module(sig_ptr)
    return owner
}

pub fun assoc_type_names(members: &List<TopDecl>): List<String> {
    var out = List.new<String>()
    while mm in &members {
        when (mm.kind) {
            AssocType(_bounds) => out.push(mm.name.as_string())
            _ => { }
        }
    }
    return out
}

/// A bare associated-type name in a trait method's type becomes a projection
/// on `Self`: `fun call(a: A): Out` in `trait Call1<A>` returns `Self.Out`.
pub fun assoc_names_as_projections(tr: TypeRef, assocs: &List<String>): TypeRef {
    when (tr.kind) {
        Named(name, args) => {
            if args.size() == 0 {
                if str_list_has(assocs, name.as_str()) {
                    val owner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                    unsafe { *owner = new_type_ref(tr.span, TypeRefKind.Named(intern("Self"), List.new<TypeRef>())) }
                    return new_type_ref(tr.span, TypeRefKind.Projection(owner, name))
                }
                return tr
            }
            var nargs = List.new<TypeRef>()
            while arg in &args {
                nargs.push(assoc_names_as_projections(arg, assocs))
            }
            return new_type_ref(tr.span, TypeRefKind.Named(name, nargs))
        }
        Reference(is_mut, inner) => {
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = assoc_names_as_projections(unsafe { *inner }, assocs) }
            return new_type_ref(tr.span, TypeRefKind.Reference(is_mut, q))
        }
        Projection(owner, member) => {
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = assoc_names_as_projections(unsafe { *owner }, assocs) }
            return new_type_ref(tr.span, TypeRefKind.Projection(q, member))
        }
        _ => return tr
    }
}

/// Already registered when minted; this only hands them off.
mutating fun Module.drain_synth_decls(sig_ptr: Ptr<SigTable>): void {
    var i = 0
    while i < unsafe { sig_ptr.synth_decls.size() } {
        self.decls.push(unsafe { *sig_ptr.synth_decls.at(i) })
        i = i + 1
    }
    unsafe { sig_ptr.synth_decls = List.new<TopDecl>() }
}

/// Only type identities and associated-type bindings, for Mono to finish the
/// projections typecheck could not. Rebuilt from the module in hand, which no
/// longer matches the checked one. Registration diagnostics are discarded:
/// they were already reported against the source.
pub fun Module.assoc_projection_registry(): Ptr<SigTable> {
    val sigs = new_sig_table()
    val sig_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sig_ptr = sigs }
    val sink: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *sink = List.new<Diagnostic>() }

    while decl in &self.decls {
        decl.register_type_identity(sig_ptr)
    }
    while decl in &self.decls {
        decl.register_assoc_bindings_decl(sig_ptr, sink)
    }
    return sig_ptr
}

/// A declared type's name and type parameters, before anything resolves a
/// type; with layouts in one pass, instantiation would depend on order.
pub fun TopDecl.register_type_identity(sig_ptr: Ptr<SigTable>): void {
    when (self.kind) {
        Struct(_fields, _is_pub) => unsafe { sig_ptr.insert_type_identity(new_type_identity(self.crate, self.module_path, self.name)) }
        EnumDecl(_variants, _is_pub) => unsafe { sig_ptr.insert_type_identity(new_type_identity(self.crate, self.module_path, self.name)) }
        _ => return
    }
    val gnames = type_param_names(self.generics)
    if gnames.size() > 0 {
        unsafe { sig_ptr.insert_generic_info(GenericInfo { name: self.name.as_string(), type_params: gnames, owner_crate: self.crate }) }
    }
}

fun is_builtin_type_name(name: str): bool {
    if name == "int8" || name == "int16" || name == "int32" || name == "int64" { return true }
    if name == "uint8" || name == "uint16" || name == "uint32" || name == "uint64" { return true }
    if name == "float32" || name == "float64" || name == "bool" || name == "char" { return true }
    if name == "str" || name == "void" || name == "Box" || name == "Ptr" { return true }
    return false
}

/// A type named like a builtin `resolve_type_ref` claims is rejected.
pub fun TopDecl.reject_reserved_type_name(diags: Ptr<List<Diagnostic>>): bool {
    when (self.kind) {
        Struct(_fields, _is_pub) => { }
        EnumDecl(_variants, _is_pub) => { }
        _ => return false
    }
    if is_builtin_type_name(self.name.as_str()) {
        val message = "`${self.name.as_str()}` is reserved for a builtin type; a type cannot be declared with that name (rename it)"
        val lab = new_label(self.decl_name_span(), message)
        unsafe { diags.push(new_diagnostic(Severity.Error, lab)) }
        return true
    }
    return false
}

pub fun register_sigs(td: &var TopDecl, sig_ptr: Ptr<SigTable>, diags: Ptr<List<Diagnostic>>,
                      table: Ptr<DeclTable>?): void {
    when (td.kind) {
        Function(params, ret_ptr, _body, is_pub, _unsafe, _mutating, _static) => {
            // Test runners are a separate module calling @test functions by
            // name.
            val is_runner_visible = is_pub || (&td).has_annotation("test")
            register_fn_sig(td, td.name.as_string(), params, ret_ptr, type_param_names(td.generics), td.crate, td.module_path, td.span.file_id, is_runner_visible, sig_ptr, diags, table)
            register_bounds(td.name.as_string(), td.generics, sig_ptr)
        }
        Extern(params, ret_ptr, is_pub, _variadic) => {
            // An extern's signature types its calls.
            register_fn_sig(td, td.name.as_string(), params, ret_ptr, List.new<String>(), td.crate, td.module_path, td.span.file_id, is_pub, sig_ptr, diags, table)
        }
        ImplBlock(methods) => {
            val struct_name = td.name.as_string()
            reject_duplicate_methods(&methods, struct_name.as_str(), td.linkage, diags)
            while i in 0..methods.size() {
                var m = *methods.at(i)
                register_impl_method(struct_name.clone(), td.generics, &var m, "", "", "", sig_ptr, diags, table)
            }
        }
        TraitImpl(tref, methods) => {
            // Trait-impl methods register like inherent ones.
            val struct_name = td.name.as_string()
            reject_duplicate_methods(&methods, struct_name.as_str(), td.linkage, diags)
            val suffix = trait_method_suffix(unsafe { *tref }, sig_ptr)
            val trait_name = trait_ref_head_name(unsafe { *tref })
            val trait_args = trait_ref_args_key(unsafe { *tref })
            while i in 0..methods.size() {
                var m = *methods.at(i)
                register_impl_method(struct_name.clone(), td.generics, &var m, suffix.clone(), trait_name.clone(), trait_args.clone(), sig_ptr, diags, table)
            }
            register_omitted_defaults(struct_name, &methods, suffix, trait_name, &td, sig_ptr)
        }
        _ => { }
    }
}

/// Signatures for the default methods this impl omitted. Mono copies the
/// bodies in much later, so without this a call on a concrete receiver found
/// no method. Types come from the trait with `Self` as this impl's target.
fun register_omitted_defaults(struct_name: String, methods: &List<TopDecl>, suffix: String, trait_name: String, td: &TopDecl, sig_ptr: Ptr<SigTable>): void {
    if trait_name.as_str().equals("") { return }
    val self_ty = Type { kind: TypeKind.Struct(intern(struct_name.as_str())), provenance: Provenance.Inferred(no_span()) }
    when (unsafe { (*sig_ptr).find_trait(trait_name.as_str()) }) {
      Some(info) => {
        while req in &info.methods {
            if req.has_default && !impl_writes_method(methods, req.name.as_str()) {
                var mangled = struct_name.clone()
                mangled.append("_")
                mangled.append(req.name.as_str())
                if !suffix.as_str().equals("") {
                    mangled.append("__")
                    mangled.append(suffix.as_str())
                }
                if unsafe { (*sig_ptr).find_signature(mangled.as_str()).is_none() } {
                    var ptys = List.new<Type>()
                    if !req.is_static { ptys.push(self_ty.clone()) }
                    while pi in 0..req.params.size() {
                        ptys.push(subst_generic(req.params.at(pi), String.from("Self"), self_ty.clone()))
                    }
                    val ret_ty = req.ret.subst_generic(String.from("Self"), self_ty.clone())
                    val borrows = infer_borrow_origin(&ptys, &ret_ty, !req.is_static)
                    unsafe { sig_ptr.insert(FnSignature { name: mangled, params: ptys, ret: ret_ty, generics: List.new<String>(), is_static: req.is_static, is_mutating: req.is_mutating, owner_module: td.module_path, owner_crate: td.crate, is_pub: true, borrows: borrows, is_prelude: false }) }
                }
            }
        }
      }
      None => { }
    }
}

fun impl_writes_method(methods: &List<TopDecl>, name: str): bool {
    while method in &methods {
        if method.name.as_str().equals(name) { return true }
    }
    return false
}

fun register_fn_sig(metadata_owner: Ptr<TopDecl>, fn_name: String, params: List<Param>, ret_ptr: Ptr<TypeRef>, generics: List<String>, owner_crate: CrateId, owner_module: Sym, owner_file: uint32, is_pub: bool, sig_ptr: Ptr<SigTable>, diags: Ptr<List<Diagnostic>>, table: Ptr<DeclTable>?): void {
    var eff_table: Ptr<DeclTable>? = table
    if unsafe { (*metadata_owner).linkage.is_imported() } { eff_table = Option.None }
    var ctx0 = new_type_ctx(void_ty(no_span()), diags, eff_table, sig_ptr)
    ctx0.owner_crate = owner_crate
    ctx0.owner_module = owner_module
    ctx0.owner_file = owner_file
    ctx0.metadata_owner = metadata_owner
    ctx0.seed_generics(generics)
    val ret_tr: TypeRef = unsafe { *ret_ptr }
    val ret_ty = ret_tr.resolve_type_ref(&var ctx0)
    ret_ty.validate_dyn_placement(ret_tr.span, &var ctx0)
    var ptys = List.new<Type>()
    while p in &params {
        val ty_ptr: Ptr<TypeRef> = p.ty
        val p_tr: TypeRef = unsafe { *ty_ptr }
        val pty = p_tr.resolve_type_ref(&var ctx0)
        pty.validate_dyn_placement(p_tr.span, &var ctx0)
        ptys.push(pty)
    }
    val sp = sig_ptr
    reject_unsayable_origin(&ptys, &ret_ty, false, ret_tr.span, &var ctx0)
    val borrows = infer_borrow_origin(&ptys, &ret_ty, false)
    insert_fn_sig(sp, metadata_owner, FnSignature { name: fn_name, params: ptys, ret: ret_ty, generics: generics, is_static: false, is_mutating: false, owner_module: owner_module, owner_crate: owner_crate, is_pub: is_pub, borrows: borrows, is_prelude: unsafe { &*metadata_owner }.has_annotation("prelude") })
}

/// CONSTRAINT: bounds are keyed by this, so registration and body checking
/// must agree.
fun method_body_owner(struct_name: String, method_name: String): String {
    return struct_name + String.from("_") + method_name
}

fun register_impl_method(struct_name: String, impl_tps: List<TypeParam>, td: &var TopDecl, suffix: String, trait_name: String, trait_args: String, sig_ptr: Ptr<SigTable>, diags: Ptr<List<Diagnostic>>, table: Ptr<DeclTable>?): void {
    when (td.kind) {
        Function(params, ret_ptr, _body, _pub, _unsafe, is_mutating, is_static) => {
            val impl_generics = type_param_names(&impl_tps)
            var mangled = struct_name.clone()
            mangled.append("_")
            mangled.append(td.name.as_str())
            if !suffix.as_str().equals("") {
                mangled.append("__")
                mangled.append(suffix.as_str())
            }
            // An instance method gets an implicit `self` prepended, matching
            // how the receiver is passed; a `static fun` has none.
            var eff_table: Ptr<DeclTable>? = table
            if td.linkage.is_imported() { eff_table = Option.None }
            var ctx0 = new_type_ctx(void_ty(no_span()), diags, eff_table, sig_ptr)
            ctx0.owner_crate = td.crate
            ctx0.owner_module = td.module_path
            ctx0.owner_file = td.span.file_id
            ctx0.metadata_owner = td
            // The impl's generics and the method's own, so `&A` resolves to
            // `RefTo(Generic("A"))`, not a nominal `A`.
            var all_generics = List.new<String>()
            while impl_generic in &impl_generics {
                all_generics.push(impl_generic)
            }
            val own_generics = type_param_names(td.generics)
            while own_generic in &own_generics {
                all_generics.push(own_generic)
            }
            ctx0.seed_generics(all_generics.clone())
            ctx0.self_ty = impl_target_ty(struct_name.as_str(), no_span(), ctx0.string_name())
            // Which trait instantiation: a type implementing one trait at two
            // argument lists binds `Out` twice.
            ctx0.impl_trait = trait_name.clone()
            ctx0.impl_trait_args = trait_args.clone()
            val ret_tr: TypeRef = unsafe { *ret_ptr }
            val ret_ty = ret_tr.resolve_type_ref(&var ctx0)
            ret_ty.validate_dyn_placement(ret_tr.span, &var ctx0)
            var ptys = List.new<Type>()
            if !is_static {
                ptys.push(Type { kind: TypeKind.Struct(intern(struct_name.as_str())), provenance: Provenance.Inferred(no_span()) })
            }
            while p in &params {
                val ty_ptr: Ptr<TypeRef> = p.ty
                val p_tr: TypeRef = unsafe { *ty_ptr }
                val param_ty = p_tr.resolve_type_ref(&var ctx0)
                param_ty.validate_dyn_placement(p_tr.span, &var ctx0)
                ptys.push(param_ty)
            }
            // The method's own bounded params, then the impl's, under the
            // unsuffixed body key. Before the insert, which consumes `mangled`.
            val bound_owner = method_body_owner(struct_name.clone(), td.name.as_string())
            register_bounds(bound_owner.clone(), td.generics, sig_ptr)
            register_bounds(bound_owner, &impl_tps, sig_ptr)
            val sp = sig_ptr
            if td.linkage.is_imported() {
                val receiver = canonical_type_identity(new_type_identity(td.crate, td.module_path, intern(struct_name.as_str())))
                unsafe { sp.insert_method_link(MethodLink {
                    receiver_identity: receiver,
                    method_name: td.name.as_string(),
                    link_name: td.link_name
                }) }
            }
            reject_unsayable_origin(&ptys, &ret_ty, !is_static, ret_tr.span, &var ctx0)
            val borrows = infer_borrow_origin(&ptys, &ret_ty, !is_static)
            unsafe { sp.insert(FnSignature { name: mangled, params: ptys, ret: ret_ty, generics: all_generics, is_static: is_static, is_mutating: is_mutating, owner_module: td.module_path, owner_crate: td.crate, is_pub: true, borrows: borrows, is_prelude: (&td).has_annotation("prelude") }) }
        }
        _ => { }
    }
}

fun check_top_decl(td: &var TopDecl, _table: &var DeclTable, diags: Ptr<List<Diagnostic>>, sigs: Ptr<SigTable>): void {
    // An interface-loaded declaration has no body here.
    if td.linkage.is_imported() { return }
    when (td.kind) {
        Function(params, ret_ptr, body, _pub, _unsafe, _mutating, _static) => {
            // A free `fun take` is rejected: codegen dispatches the intrinsic
            // `take<T>` by raw name and would erase the call. Methods named
            // `take` mangle with their type and are fine.
            val nm = td.name.as_str()
            // Points at the name.
            val td_span = td.decl_name_span()
            if nm == "take" {
                emit_take_reserved_err(diags, td_span)
            }
            if is_builtin_type_name(nm) {
                emit_builtin_type_name_reserved_err(diags, td_span, td.name.as_string())
            }
            val no_self = ""
            check_fn_body(td, td.name.as_string(), td.crate, td.module_path, td.span.file_id, no_self, "", "", "", "", false, type_param_names(td.generics), params, ret_ptr, &var body, diags, sigs)
        }
        ImplBlock(methods) => {
            // Impl method bodies are walked like any function, with `self`
            // declared as the receiver.
            val struct_name = td.name.as_string()
            val gnames = type_param_names(td.generics)
            while i in 0..methods.size() {
                check_method_body(struct_name.clone(), gnames, "", "", methods.at_mut(i), diags, sigs)
            }
        }
        TraitImpl(tref, methods) => {
            // Bodies first, then the impl is checked against its trait.
            val struct_name = td.name.as_string()
            val gnames = type_param_names(td.generics)
            // The trait's name, for self-recursion through an operator, and its
            // arguments, so `Self.Out` names this instantiation's binding.
            val trait_name = trait_ref_head_name(unsafe { *tref })
            val trait_args = trait_ref_args_key(unsafe { *tref })
            while i in 0..methods.size() {
                check_method_body(struct_name.clone(), gnames, trait_name.clone(), trait_args.clone(), methods.at_mut(i), diags, sigs)
            }
            // Its own ctx, so the impl's generics are in scope.
            var sig_ctx = new_type_ctx(void_ty(no_span()), diags, Option.None, sigs)
            sig_ctx.owner_crate = td.crate
            sig_ctx.owner_module = td.module_path
            sig_ctx.owner_file = td.span.file_id
            sig_ctx.metadata_owner = unsafe { td as Ptr<TopDecl> }
            sig_ctx.seed_generics(gnames.clone())
            // Same instantiation answer as the bodies.
            sig_ctx.impl_trait = trait_name.clone()
            sig_ctx.impl_trait_args = trait_args.clone()
            check_satisfies(unsafe { *tref }, struct_name.as_str(), gnames, methods, td.span, diags, sigs, &var sig_ctx)
        }
        _ => { }
    }
}
