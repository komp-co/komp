import core.assert.assert_eq
import alloc.list.*
import kf_core.ast.*
import kf_core.ast.declaration.*
import kf_resolve.new_decl_table
import kf_core.span.no_span
import kf_typecheck.typecheck_module

// `Box` and `Ptr` win in every annotation, so declaring either is refused.
fun diags_for_type_named(name: str, kind: TopDeclKind): uint64 {
    var declaration = new_top_decl(no_span(), String.from(name), kind)
    declaration.crate = new_crate_id("application")
    var declarations = List.new<TopDecl>()
    declarations.push(declaration)
    var module = Module { crate: new_crate_id("application"), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
    var table = new_decl_table()
    return module.typecheck_module(&var table).size()
}

@test
fun a_struct_cannot_be_named_box(): void {
    val n = diags_for_type_named("Box", TopDeclKind.Struct(List.new<Field>(), false))
    assert_eq(n > 0, true, "struct Box collides with the builtin owning heap pointer")
}

@test
fun a_struct_cannot_be_named_ptr(): void {
    val n = diags_for_type_named("Ptr", TopDeclKind.Struct(List.new<Field>(), false))
    assert_eq(n > 0, true, "struct Ptr collides with the builtin raw pointer")
}

@test
fun an_enum_cannot_be_named_box(): void {
    val n = diags_for_type_named("Box", TopDeclKind.EnumDecl(List.new<Variant>(), false))
    assert_eq(n > 0, true, "enum Box is rejected the same way")
}

/// The first message, to tell which rule fired.
fun message_for_type_named(name: str, kind: TopDeclKind): String {
    var declaration = new_top_decl(no_span(), String.from(name), kind)
    declaration.crate = new_crate_id("application")
    var declarations = List.new<TopDecl>()
    declarations.push(declaration)
    var module = Module { crate: new_crate_id("application"), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
    var table = new_decl_table()
    val diagnostics = module.typecheck_module(&var table)
    if diagnostics.size() == 0 { return String.from("") }
    return diagnostics.at(0).primary.message.clone()
}

// Only type declarations reserve a name. `impl Box { }` is refused by the
// impl-header rule instead, with its own fix.
@test
fun a_non_type_declaration_is_not_refused_as_a_reserved_name(): void {
    val message = message_for_type_named("Box", TopDeclKind.ImplBlock(List.new<TopDecl>()))
    assert_eq(message.as_str().contains("is reserved for a builtin type"), false, "an impl block declares no type, so the reserved-name rule has nothing to say about it")
}

/// How many diagnostics say a type takes the lang string's name.
fun lang_name_messages(crate: str, with_lang: bool): uint64 {
    var declarations = List.new<TopDecl>()
    if with_lang {
        var lang = new_top_decl(no_span(), String.from("String"), TopDeclKind.Struct(List.new<Field>(), true))
        lang.crate = new_crate_id("alloc")
        lang.annotations.push(lang_annotation("string"))
        declarations.push(lang)
    }
    var declaration = new_top_decl(no_span(), String.from("String"), TopDeclKind.Struct(List.new<Field>(), true))
    declaration.crate = new_crate_id(crate)
    declarations.push(declaration)
    var module = Module { crate: new_crate_id(crate), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
    var table = new_decl_table()
    val diagnostics = module.typecheck_module(&var table)
    var count: uint64 = 0
    while diagnostic in &diagnostics {
        if diagnostic.primary.message.as_str().contains("the language's string type") { count = count + 1 }
    }
    return count
}

@test
fun the_lang_string_is_not_refused_its_own_name(): void {
    var declarations = List.new<TopDecl>()
    var lang = new_top_decl(no_span(), String.from("String"), TopDeclKind.Struct(List.new<Field>(), true))
    lang.crate = new_crate_id("alloc")
    lang.annotations.push(lang_annotation("string"))
    declarations.push(lang)
    var module = Module { crate: new_crate_id("alloc"), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
    var table = new_decl_table()
    assert_eq(module.typecheck_module(&var table).size(), 0, "alloc declares the language's string")
}

@test
fun a_program_cannot_take_the_lang_strings_name(): void {
    assert_eq(lang_name_messages("application", true), 1, "the lang string would shadow it wherever it is written")
}

@test
fun core_cannot_take_the_lang_strings_name_either(): void {
    assert_eq(lang_name_messages("core", true), 1, "the rule is about the name, not the crate")
}

// Without alloc there is no lang string.
@test
fun without_a_lang_string_the_name_is_free(): void {
    assert_eq(lang_name_messages("application", false), 0, "nothing claims it")
}
