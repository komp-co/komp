import core.assert.assert_eq
import alloc.list.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.annotation.new_annotation
import kf_resolve.new_decl_table
import kf_core.span.no_span
import kf_typecheck.typecheck_module

/// A struct owned by `crate`, carrying `annotations`.
fun lang_decl(name: str, crate: str, annotations: List<Annotation>): TopDecl {
    var declaration = new_top_decl(no_span(), String.from(name), TopDeclKind.Struct(List.new<Field>(), true))
    declaration.crate = new_crate_id(crate)
    declaration.annotations = annotations
    return declaration
}

fun lang_messages(decls: List<TopDecl>): uint64 {
    var module = Module { crate: new_crate_id("application"), path: List.new<String>(), decls: decls,
        imports: List.new<Import>() }
    var table = new_decl_table()
    val diagnostics = module.typecheck_module(&var table)
    var count: uint64 = 0
    while diagnostic in &diagnostics {
        if diagnostic.primary.message.as_str().contains("lang") { count = count + 1 }
    }
    return count
}

@test
fun the_standard_library_may_mark_its_string(): void {
    var decls = List.new<TopDecl>()
    decls.push(lang_decl("Text", "alloc", [lang_annotation("string")]))
    assert_eq(lang_messages(decls), 0, "alloc declares the language's string")
}

@test
fun a_program_may_not_declare_a_lang_item(): void {
    var decls = List.new<TopDecl>()
    decls.push(lang_decl("Text", "application", [lang_annotation("string")]))
    assert_eq(lang_messages(decls), 1, "the language's own types come from its standard library")
}

@test
fun an_unknown_lang_key_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(lang_decl("Text", "alloc", [lang_annotation("strnig")]))
    assert_eq(lang_messages(decls), 1, "a typo cannot leave the type quietly unmarked")
}

@test
fun a_lang_item_without_a_key_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(lang_decl("Text", "alloc", [new_annotation(no_span(), "lang", List.new<String>())]))
    assert_eq(lang_messages(decls), 1, "`@lang` alone names nothing")
}

@test
fun a_lang_key_declared_twice_is_rejected(): void {
    var decls = List.new<TopDecl>()
    decls.push(lang_decl("Text", "alloc", [lang_annotation("string")]))
    decls.push(lang_decl("Words", "core", [lang_annotation("string")]))
    assert_eq(lang_messages(decls), 1, "one key names one type")
}

@test
fun a_function_cannot_be_a_lang_item(): void {
    var decls = List.new<TopDecl>()
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    val kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    var helper = new_top_decl(no_span(), String.from("helper"), kind)
    helper.crate = new_crate_id("alloc")
    helper.annotations.push(lang_annotation("string"))
    decls.push(helper)
    assert_eq(lang_messages(decls), 1, "only a type can be the language's string")
}

@test
fun the_lang_key_is_read_from_the_annotation(): void {
    val marked = lang_decl("Text", "alloc", [lang_annotation("string")])
    val plain = lang_decl("Text", "alloc", List.new<Annotation>())
    assert_eq((&marked).lang_key_of().as_str(), "string", "the argument is the key")
    assert_eq((&plain).lang_key_of().as_str(), "", "no annotation, no key")
}

/// A function owned by `crate`, `@prelude` when `in_prelude`.
fun prelude_decl(crate: str, in_prelude: bool): TopDecl {
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    val kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    var helper = new_top_decl(no_span(), String.from("helper"), kind)
    helper.crate = new_crate_id(crate)
    if in_prelude { helper.annotations.push(new_annotation(no_span(), "prelude", List.new<String>())) }
    return helper
}

fun prelude_messages(decls: List<TopDecl>): uint64 {
    var module = Module { crate: new_crate_id("application"), path: List.new<String>(), decls: decls,
        imports: List.new<Import>() }
    var table = new_decl_table()
    val diagnostics = module.typecheck_module(&var table)
    var count: uint64 = 0
    while diagnostic in &diagnostics {
        if diagnostic.primary.message.as_str().contains("prelude") { count = count + 1 }
    }
    return count
}

@test
fun the_standard_library_may_mark_the_prelude(): void {
    var decls = List.new<TopDecl>()
    decls.push(prelude_decl("core", true))
    assert_eq(prelude_messages(decls), 0, "core declares the prelude")
}

@test
fun a_program_may_not_mark_the_prelude(): void {
    var decls = List.new<TopDecl>()
    decls.push(prelude_decl("application", true))
    assert_eq(prelude_messages(decls), 1, "the prelude comes from the standard library")
}
