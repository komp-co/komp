// `T?` desugars to a placeholder naming the option type by its `@lang` key,
// which the parser cannot know. This rewrites it to the real name in every
// type position before any other pass reads it.

import alloc.list.*

import kf_core.ast.*

/// An independent copy with every placeholder head, nested ones included,
/// renamed.
fun TypeRef.rewrite_option_tref(option_name: Sym): TypeRef {
    when (self.kind) {
        Named(n, args) => {
            var head = n
            if n.lang_placeholder_key().as_str().equals(lang_option_key()) { head = option_name }
            return new_type_ref(self.span, TypeRefKind.Named(head, rewrite_option_tref_list(&args, option_name)))
        }
        DynTrait(n, args) => {
            return new_type_ref(self.span, TypeRefKind.DynTrait(n, rewrite_option_tref_list(&args, option_name)))
        }
        Reference(is_mut, inner) => {
            val sub = (unsafe { &*inner }).rewrite_option_tref(option_name)
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = sub }
            return new_type_ref(self.span, TypeRefKind.Reference(is_mut, q))
        }
        Function(ps, ret) => {
            val new_ps = rewrite_option_tref_list(&ps, option_name)
            val rsub = (unsafe { &*ret }).rewrite_option_tref(option_name)
            val rq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *rq = rsub }
            return new_type_ref(self.span, TypeRefKind.Function(new_ps, rq))
        }
        Array(elem, n) => {
            val esub = (unsafe { &*elem }).rewrite_option_tref(option_name)
            val eq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *eq = esub }
            return new_type_ref(self.span, TypeRefKind.Array(eq, n))
        }
        Projection(owner, member) => {
            val osub = (unsafe { &*owner }).rewrite_option_tref(option_name)
            val oq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *oq = osub }
            return new_type_ref(self.span, TypeRefKind.Projection(oq, member))
        }
        Poison => return type_ref_poison(self.span)
    }
}

fun rewrite_option_tref_list(items: &List<TypeRef>, option_name: Sym): List<TypeRef> {
    var out = List.new<TypeRef>()
    while item in &items {
        out.push((item).rewrite_option_tref(option_name))
    }
    return out
}

/// A `let`/`var` annotation, in place.
fun rewrite_option_ann(ty: Ptr<TypeRef>?, option_name: Sym): void {
    when (ty) {
        Some(tp) => { unsafe { *tp = (unsafe { &*tp }).rewrite_option_tref(option_name) } }
        None => {}
    }
}

fun rewrite_option_box(b: Box<TypeRef>, option_name: Sym): void {
    if (b as uint64) == 0 { return }
    unsafe { *b = (unsafe { &*b }).rewrite_option_tref(option_name) }
}

fun rewrite_option_params(params: &List<Param>, option_name: Sym): void {
    while p in &params {
        rewrite_option_box(p.ty, option_name)
    }
}

fun rewrite_option_fields(fields: &List<Field>, option_name: Sym): void {
    while f in &fields {
        rewrite_option_box(f.ty, option_name)
    }
}

fun rewrite_option_stmt_list(stmts: &List<Stmt>, option_name: Sym): void {
    while i in 0..stmts.size() {
        val sp: Ptr<Stmt> = unsafe { stmts.at(i) as Ptr<Stmt> }
        rewrite_option_stmt(sp, option_name)
    }
}

fun rewrite_option_stmt(sp: Ptr<Stmt>, option_name: Sym): void {
    when (unsafe { sp.kind }) {
        LetVal(_n, ty, init) => {
            rewrite_option_ann(ty.view(), option_name)
            rewrite_option_expr(init.view(), option_name)
        }
        LetVar(_n, ty, init) => {
            rewrite_option_ann(ty.view(), option_name)
            rewrite_option_expr(init.view(), option_name)
        }
        Assign(_n, expr_box) => rewrite_option_expr(expr_box, option_name)
        AssignTo(place_box, expr_box) => {
            rewrite_option_expr(place_box, option_name)
            rewrite_option_expr(expr_box, option_name)
        }
        Return(expr_ptr) => rewrite_option_expr(expr_ptr.view(), option_name)
        If(cond_box, then_body, else_body) => {
            rewrite_option_expr(cond_box, option_name)
            rewrite_option_stmt_list(&then_body, option_name)
            rewrite_option_stmt_list(&else_body, option_name)
        }
        While(cond_box, body) => {
            rewrite_option_expr(cond_box, option_name)
            rewrite_option_stmt_list(&body, option_name)
        }
        ForEach(_binder, subj_box, body) => {
            rewrite_option_expr(subj_box, option_name)
            rewrite_option_stmt_list(&body, option_name)
        }
        When(subj_box, arms) => {
            rewrite_option_expr(subj_box, option_name)
            rewrite_option_arms(&arms, option_name)
        }
        Expression(expr_box) => rewrite_option_expr(expr_box, option_name)
        Switch(subj_box, arms) => {
            rewrite_option_expr(subj_box, option_name)
            rewrite_option_switch_arms(&arms, option_name)
        }
        Break => {}
        Continue => {}
        Drop(_) => {}
        Release(_) => {}
        Poison => {}
    }
}

fun rewrite_option_arms(arms: &List<Arm>, option_name: Sym): void {
    while a in &arms {
        rewrite_option_expr(a.guard.view(), option_name)
        rewrite_option_stmt_list(&a.body, option_name)
    }
}

fun rewrite_option_switch_arms(arms: &List<SwitchArm>, option_name: Sym): void {
    while a in &arms {
        rewrite_option_expr(a.guard.view(), option_name)
        rewrite_option_stmt_list(&a.body, option_name)
    }
}

fun rewrite_option_expr(p_opt: Ptr<Expr>?, option_name: Sym): void {
    val p = p_opt ?: return
    if unsafe { p.type_args.size() } > 0 {
        unsafe { p.type_args = rewrite_option_tref_list(unsafe { &p.type_args }, option_name) }
    }
    when (unsafe { p.kind }) {
        LitInt(_) => {}
        LitFloat(_) => {}
        LitChar(_) => {}
        LitStr(_) => {}
        LitBool(_) => {}
        Variable(_) => {}
        Binary(lp, _op, rp) => {
            rewrite_option_expr(lp, option_name)
            rewrite_option_expr(rp, option_name)
        }
        Unary(_op, ip) => rewrite_option_expr(ip, option_name)
        Deref(ip) => rewrite_option_expr(ip, option_name)
        Call(_nm, args) => rewrite_option_expr_list(&args, option_name)
        MethodCall(recv_ptr, _m, args) => {
            rewrite_option_expr(recv_ptr, option_name)
            rewrite_option_expr_list(&args, option_name)
        }
        FieldAccess(obj_ptr, _f) => rewrite_option_expr(obj_ptr, option_name)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            rewrite_option_expr(c_ptr, option_name)
            rewrite_option_expr(t_ptr, option_name)
            rewrite_option_expr(e_ptr, option_name)
        }
        WhenExpr(subj_box, arms) => {
            rewrite_option_expr(subj_box, option_name)
            rewrite_option_arms(&arms, option_name)
        }
        StructLit(_nm, finits) => {
            while finit in &finits {
                rewrite_option_expr(finit.value, option_name)
            }
        }
        Cast(ip, tref) => {
            rewrite_option_expr(ip, option_name)
            rewrite_option_box(tref, option_name)
        }
        DynCoerce(ip, _vtable) => rewrite_option_expr(ip, option_name)
        Lambda(params, body) => {
            rewrite_option_params(&params, option_name)
            rewrite_option_stmt_list(&body, option_name)
        }
        Retain(ip) => rewrite_option_expr(ip, option_name)
        Release(_) => {}
        Block(stmts) => rewrite_option_stmt_list(&stmts, option_name)
        Poison => {}
    }
}

fun rewrite_option_expr_list(args: &List<Expr>, option_name: Sym): void {
    while i in 0..args.size() {
        val ep: Ptr<Expr> = unsafe { args.at(i) as Ptr<Expr> }
        rewrite_option_expr(ep, option_name)
    }
}

mutating fun TopDecl.rewrite_option_decl(option_name: Sym): void {
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            rewrite_option_params(&params, option_name)
            rewrite_option_box(ret, option_name)
            rewrite_option_stmt_list(&body, option_name)
            self.kind = TopDeclKind.Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static)
        }
        Struct(fields, is_pub) => {
            rewrite_option_fields(&fields, option_name)
            self.kind = TopDeclKind.Struct(fields, is_pub)
        }
        EnumDecl(variants, is_pub) => {
            while i in 0..variants.size() {
                val v = variants.at_mut(i)
                v.payloads = rewrite_option_tref_list(&v.payloads, option_name)
            }
            self.kind = TopDeclKind.EnumDecl(variants, is_pub)
        }
        Extern(params, ret, is_pub, is_unsafe) => {
            rewrite_option_params(&params, option_name)
            rewrite_option_box(ret, option_name)
            self.kind = TopDeclKind.Extern(params, ret, is_pub, is_unsafe)
        }
        ImplBlock(methods) => {
            rewrite_option_methods(&var methods, option_name)
            self.kind = TopDeclKind.ImplBlock(methods)
        }
        TraitDecl(methods, is_pub, supers) => {
            rewrite_option_methods(&var methods, option_name)
            self.kind = TopDeclKind.TraitDecl(methods, is_pub, rewrite_option_tref_list(&supers, option_name))
        }
        TraitImpl(trait_ref, methods) => {
            rewrite_option_box(trait_ref, option_name)
            rewrite_option_methods(&var methods, option_name)
            self.kind = TopDeclKind.TraitImpl(trait_ref, methods)
        }
        AssocType(bounds) => {
            self.kind = TopDeclKind.AssocType(rewrite_option_tref_list(&bounds, option_name))
        }
        AssocTypeBinding(boxed) => {
            rewrite_option_box(boxed, option_name)
            self.kind = TopDeclKind.AssocTypeBinding(boxed)
        }
        Poison => {}
    }
}

fun rewrite_option_methods(methods: &var List<TopDecl>, option_name: Sym): void {
    while i in 0..methods.size() {
        rewrite_option_decl(methods.at_mut(i), option_name)
    }
}

pub mutating fun Module.rewrite_option_module(option_name: Sym): void {
    if option_name.as_str().equals("") { return }
    while i in 0..self.decls.size() {
        rewrite_option_decl(self.decls.at_mut(i), option_name)
    }
}
