import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.UnaryOp
import kf_core.ast.declaration.*
import kf_core.diagnostic.*
import kf_typecheck.*

fun typed_param(name: str, ty: str): Param {
    val tref = TypeRef.new(no_span(), TypeRefKind.Named(intern(ty), List.new<TypeRef>()))
    return new_param(no_span(), String.from(name), Box.new(tref))
}

/// `(iterations: int32, label: String)`.
fun bench_params(): List<Param> {
    var params = List.new<Param>()
    params.push(typed_param("iterations", "int32"))
    params.push(typed_param("label", "String"))
    return params
}

fun string_table(): SigTable {
    var table = new_sig_table()
    table.lang_string = intern("String")
    return table
}

fun arg(name: str, kind: ExprKind): AnnotationArg {
    return AnnotationArg { name: intern(name), value: Box.new(Expr.new(no_span(), kind)) }
}

fun bench_use(args: List<AnnotationArg>): Annotation {
    return Annotation { name: intern("bench"), args: args, has_parens: true, span: no_span() }
}

fun ordered(args: List<AnnotationArg>): OrderedArguments {
    var diags = List.new<Diagnostic>()
    return bench_use(args).arguments_in_order(&bench_params(), &string_table(), new_crate_id("app"), &var diags)
}

@test fun positional_arguments_fill_the_parameters_in_order(): void {
    val found = ordered([arg("", ExprKind.LitInt(3)), arg("", ExprKind.LitStr(String.from("sort")))])
    assert_eq(found.ok, true, "two literals of the right types")
}

@test fun named_arguments_are_put_in_parameter_order(): void {
    val found = ordered([arg("label", ExprKind.LitStr(String.from("sort"))), arg("iterations", ExprKind.LitInt(3))])
    val first_is_int = when (found.values.at(0).kind) {
        LitInt(_n) => true
        _ => false
    }
    assert_eq(first_is_int, true, "`iterations` comes first whatever order it was written in")
}

@test fun a_missing_argument_is_rejected(): void {
    assert_eq(ordered([arg("", ExprKind.LitInt(3))]).ok, false, "`label` has no value")
}

@test fun an_extra_argument_is_rejected(): void {
    val three = [arg("", ExprKind.LitInt(3)), arg("", ExprKind.LitStr(String.from("a"))), arg("", ExprKind.LitInt(4))]
    assert_eq(ordered(three).ok, false, "two parameters, three arguments")
}

@test fun an_argument_named_twice_is_rejected(): void {
    val twice = [arg("iterations", ExprKind.LitInt(3)), arg("iterations", ExprKind.LitInt(4))]
    assert_eq(ordered(twice).ok, false, "one value per parameter")
}

@test fun a_positional_argument_after_a_named_one_is_rejected(): void {
    val mixed = [arg("label", ExprKind.LitStr(String.from("a"))), arg("", ExprKind.LitInt(3))]
    assert_eq(ordered(mixed).ok, false, "positions stop meaning anything once a name is used")
}

@test fun an_unknown_parameter_name_is_rejected(): void {
    val unknown = [arg("", ExprKind.LitInt(3)), arg("title", ExprKind.LitStr(String.from("a")))]
    assert_eq(ordered(unknown).ok, false, "`bench` has no `title`")
}

@test fun a_string_for_a_number_is_rejected(): void {
    val swapped = [arg("", ExprKind.LitStr(String.from("a"))), arg("", ExprKind.LitStr(String.from("b")))]
    assert_eq(ordered(swapped).ok, false, "`iterations` is an int32")
}

@test fun a_negative_number_fits_a_signed_parameter(): void {
    val negative = ExprKind.Unary(UnaryOp.Neg, Box.new(Expr.new(no_span(), ExprKind.LitInt(3))))
    assert_eq(ordered([arg("", negative), arg("", ExprKind.LitStr(String.from("a")))]).ok, true, "-3 is an int32")
}

@test fun a_name_is_not_a_literal(): void {
    val variable = [arg("", ExprKind.Variable(intern("count"))), arg("", ExprKind.LitStr(String.from("a")))]
    assert_eq(ordered(variable).ok, false, "nothing evaluates `count` at compile time")
}

@test fun a_list_parameter_is_unsupported(): void {
    var diags = List.new<Diagnostic>()
    var params = List.new<Param>()
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    val list = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), args))
    params.push(new_param(no_span(), String.from("values"), Box.new(list)))
    check_annotation_params(&params, &string_table(), new_crate_id("app"), &var diags)
    assert_eq(diags.size(), 1, "no literal spells a list")
}

@test fun a_string_parameter_is_supported(): void {
    var diags = List.new<Diagnostic>()
    check_annotation_params(&bench_params(), &string_table(), new_crate_id("app"), &var diags)
    assert_eq(diags.size(), 0, "numbers and the lang string")
}
