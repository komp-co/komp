// A type that holds itself by value has no size: a field or payload of its own
// type, of a type that holds it, or of a by-value instance such as `A?`.
// Behind a pointer (`Box`, `List`, a borrow) the same cycle is fine.

import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.CrateId
import kf_core.ast.Module
import kf_core.ast.new_crate_id
import kf_core.ast.types.Type
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.ast.subst.mangle_tyref

/// A layout's key: its crate and name, since two crates may each declare
/// an `A`.
fun layout_key(owner: CrateId, name: str): String {
    return "${owner.raw}|${name}"
}

/// The key of the layout a field of type `t` stores inline, or "" for one
/// behind a pointer or of no layout. A declared type is named by its identity,
/// `crate::module::Name`; an instance only by its mangled name, keyed `*|`.
fun inline_key(t: &Type): String {
    val name = when (t.kind) {
        Struct(sym) => sym.as_string()
        EnumTy(sym) => sym.as_string()
        _ => String.from("")
    }
    if name.is_empty() { return name }
    val crate_end = name.index_of("::") ?: return "*|${name}"
    val leaf_start = name.last_index_of("::") ?: return "*|${name}"
    val owner = new_crate_id(name.substring(0, crate_end).as_str())
    return layout_key(owner, name.slice_from(leaf_start + 2).as_str())
}

fun push_inline(t: &Type, out: &var List<String>): void {
    val key = inline_key(t)
    if !key.is_empty() && !out.contains(&key) { out.push(key) }
}

/// Under its crate's key, and under `*|name` too: the only way a field names
/// an instance, and the way an array records its element, by name alone. Two
/// crates' types of one name share the second key, which can only report more.
fun insert_edges(edges: &var HashMap<String, List<String>>, owner: CrateId, name: str, held: List<String>): void {
    val plain = "*|${name}"
    var merged = held.clone()
    when (edges.get(&plain)) {
        Some(earlier) => { while key in &earlier { if !merged.contains(&key) { merged.push(key.clone()) } } }
        None => { }
    }
    edges.insert(plain, merged)
    edges.insert(layout_key(owner, name), held)
}

/// Every layout, instances included, to the layouts it stores inline. An
/// array has no fields; its element is its first type argument.
fun SigTable.inline_edges(): HashMap<String, List<String>> {
    var edges = HashMap.new<String, List<String>>()
    while s in &self.structs {
        var held = List.new<String>()
        while field in &s.fields { push_inline(&field.ty, &var held) }
        insert_edges(&var edges, s.owner_crate, s.name.as_str(), held)
    }
    while e in &self.enums {
        var held = List.new<String>()
        while variant in &e.variants {
            while payload in &variant.payloads { push_inline(&payload, &var held) }
        }
        insert_edges(&var edges, e.owner_crate, e.name.as_str(), held)
    }
    while inst in &self.insts {
        if inst.base.as_str() != self.lang_array.as_str() || inst.args.size() == 0 { continue }
        var held = List.new<String>()
        held.push("*|${inst.args.at(0).mangle_tyref()}")
        edges.insert("*|${inst.mangled}", held)
    }
    return edges
}

/// Whether the layout keyed `start`, also known as `alias`, reaches itself
/// along `edges`.
pub fun holds_itself(start: str, alias: str, edges: &HashMap<String, List<String>>): bool {
    var seen = List.new<String>()
    var todo = List.new<String>()
    todo.push(String.from(start))
    while true {
        val next = todo.take_last() ?: break
        val held = edges.get(&next) ?: continue
        while name in &held {
            if name.as_str() == start || name.as_str() == alias { return true }
            if !seen.contains(&name) {
                seen.push(name.clone())
                todo.push(name.clone())
            }
        }
    }
    return false
}

/// What a struct or enum holds its parts in; "" for any other declaration.
fun TopDecl.member_word(): str {
    return when (self.kind) {
        Struct(_fields, _is_pub) => "a field"
        EnumDecl(_variants, _is_pub) => "a payload"
        _ => ""
    }
}

/// CONSTRAINT: after every layout, instances included, is registered. A
/// generic template is judged through its instances' users, not alone.
pub fun Module.check_infinite_types(sigs: &SigTable, diags: &var Diagnostics): void {
    val edges = sigs.inline_edges()
    while td in &self.decls {
        if td.linkage.is_imported() || td.generics.size() > 0 { continue }
        val pointer = td.member_word()
        val start = layout_key(td.crate, td.name.as_str())
        if pointer.is_empty() || !holds_itself(start.as_str(), "*|${td.name.as_str()}".as_str(), &edges) { continue }
        val name = td.name.as_str()
        val repair = "put ${pointer} behind a pointer, such as `Box<${name}>`"
        val message = "`${name}` holds itself by value, so it has no size; ${repair}"
        diags.emit(new_diagnostic(Severity.Error, new_label(td.decl_name_span(), message)))
    }
}
