// A `pub` signature may only name `pub` types. The header carries what a
// `pub` signature reaches, while the source omits only `pub` types, so a
// private type in a public signature is defined twice in one TU: legal under
// C23, an error under C17. Only source declarations are checked.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.span.*

pub fun Module.pub_signature_diags(): List<Diagnostic> {
    var diags = List.new<Diagnostic>()
    var private_types = List.new<Sym>()
    self.collect_private_types(&var private_types)
    if private_types.size() == 0 { return diags }

    while td in &self.decls {
        if td.decl_is_source() {
            when (td.kind) {
                Function(params, ret_ptr, _body, is_pub, _u, _mu, _st) => {
                    if is_pub {
                        check_signature_types(&params, ret_ptr, td.name, &private_types, &var diags)
                    }
                }
                Extern(params, ret_ptr, is_pub, _variadic) => {
                    if is_pub {
                        check_signature_types(&params, ret_ptr, td.name, &private_types, &var diags)
                    }
                }
                _ => { }
            }
        }
    }
    return diags
}

fun TopDecl.decl_is_source(): bool {
    when (self.linkage) {
        Source => return true
        _ => return false
    }
}

fun Module.collect_private_types(out: &var List<Sym>): void {
    while td in &self.decls {
        if td.decl_is_source() {
            when (td.kind) {
                Struct(_fields, is_pub) => { if !is_pub { out.push(td.name) } }
                EnumDecl(_variants, is_pub) => { if !is_pub { out.push(td.name) } }
                _ => { }
            }
        }
    }
}

fun check_signature_types(params: &List<Param>, ret_ptr: Ptr<TypeRef>, fn_name: Sym, private_types: &List<Sym>, diags: &var List<Diagnostic>): void {
    while p in &params {
        report_private_type_refs(p.ty, fn_name, private_types, diags)
    }
    report_private_type_refs(ret_ptr, fn_name, private_types, diags)
}

/// Through `&T`, generic arguments, array elements and function types.
fun report_private_type_refs(tref_ptr: Ptr<TypeRef>, fn_name: Sym, private_types: &List<Sym>, diags: &var List<Diagnostic>): void {
    if unsafe { tref_ptr as uint64 } == 0 { return }
    val tref = unsafe { *tref_ptr }
    when (tref.kind) {
        Named(name, args) => {
            if sym_list_contains(private_types, name) {
                diags.push(private_type_in_pub_signature(name, fn_name, tref.span))
            }
            while i in 0..args.size() {
                report_private_type_refs(tref_arg_ptr(&args, i), fn_name, private_types, diags)
            }
        }
        DynTrait(_principal, args) => {
            while i in 0..args.size() {
                report_private_type_refs(tref_arg_ptr(&args, i), fn_name, private_types, diags)
            }
        }
        Function(fn_params, fn_ret) => {
            while i in 0..fn_params.size() {
                report_private_type_refs(tref_arg_ptr(&fn_params, i), fn_name, private_types, diags)
            }
            report_private_type_refs(fn_ret, fn_name, private_types, diags)
        }
        Reference(_is_var, inner) => report_private_type_refs(inner, fn_name, private_types, diags)
        Array(elem, _n) => report_private_type_refs(elem, fn_name, private_types, diags)
        Projection(_owner, _member) => return
        Value(_v) => return
        Poison => return
    }
}

/// A pointer to a borrowed element, to recurse without copying.
fun tref_arg_ptr(args: &List<TypeRef>, i: uint64): Ptr<TypeRef> {
    return unsafe { args.at(i) as Ptr<TypeRef> }
}

fun sym_list_contains(xs: &List<Sym>, target: Sym): bool {
    while item in &xs {
        if item.id == target.id { return true }
    }
    return false
}

fun private_type_in_pub_signature(type_name: Sym, fn_name: Sym, span: Span): Diagnostic {
    var msg = String.from("`")
    msg.append(fn_name.as_str())
    msg.append("` is `pub` but its signature names `")
    msg.append(type_name.as_str())
    msg.append("`, which is not — the crate header would carry a type the crate also defines itself, and the two definitions collide. Make `")
    msg.append(type_name.as_str())
    msg.append("` `pub`, or stop exporting the function")
    return error_at(span, msg)
}
