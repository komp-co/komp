import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.diagnostic.Diagnostics

fun slot_ref(name: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun mutable_slot_ref(name: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Reference(true, Box.new(slot_ref(name))))
}

/// `annotation NAME on (params) -> ret`.
fun targeted(params: List<TypeRef>, ret: TypeRef): TopDecl {
    val function = TypeRef.new(no_span(), TypeRefKind.Function(params, Box.new(ret)))
    val kind = TopDeclKind.AnnotationDecl(List.new<Param>(), MarkTarget.Function(Box.new(function)), true)
    return new_top_decl(no_span(), String.from("handler"), kind)
}

fun implicit_params(td: TopDecl): String {
    var types = List.new<String>()
    types.push(String.from("Request"))
    var decl = td
    decl.add_target_params(&types, 0 as &var Diagnostics)
    var out = String.from("")
    while param in &decl.generics {
        if out.byte_len() > 0 { out.append(",") }
        out.append(param.name.as_str())
    }
    return out
}

@test fun a_name_that_is_not_a_type_is_a_parameter(): void {
    var params = List.new<TypeRef>()
    params.push(mutable_slot_ref("S"))
    params.push(slot_ref("Request"))
    assert_eq(implicit_params(targeted(params, slot_ref("int32"))).as_str(), "S", "`Request` and `int32` are types")
}

@test fun parameters_come_in_order_of_first_appearance(): void {
    var params = List.new<TypeRef>()
    params.push(slot_ref("T"))
    params.push(slot_ref("S"))
    params.push(slot_ref("T"))
    assert_eq(implicit_params(targeted(params, slot_ref("S"))).as_str(), "T,S", "each once")
}

@test fun a_wildcard_is_not_a_parameter(): void {
    var params = List.new<TypeRef>()
    params.push(slot_ref("_"))
    assert_eq(implicit_params(targeted(params, slot_ref("_"))).as_str(), "", "`_` stays unnamed")
}

@test fun a_declared_parameter_is_not_added_again(): void {
    var params = List.new<TypeRef>()
    params.push(slot_ref("T"))
    var td = targeted(params, slot_ref("T"))
    td.generics.push(new_type_param(no_span(), String.from("T")))
    assert_eq(implicit_params(td).as_str(), "T", "the declared one")
}

fun uses_of(slot: TypeRef, name: str): String {
    var uses = ParamUses { whole: 0, nested: 0 }
    slot.count_uses(intern(name), true, &var uses)
    return "${uses.whole}/${uses.nested}"
}

@test fun a_borrowed_parameter_is_a_whole_use(): void {
    assert_eq(uses_of(mutable_slot_ref("S"), "S").as_str(), "1/0", "behind `&` is whole")
}

@test fun a_type_argument_is_a_nested_use(): void {
    var args = List.new<TypeRef>()
    args.push(slot_ref("T"))
    val listed = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), args))
    assert_eq(uses_of(listed, "T").as_str(), "0/1", "inside `List<T>`")
}
