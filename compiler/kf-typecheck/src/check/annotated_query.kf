// `annotated<bench>()`: every declaration of this crate marked `@bench`,
// private ones included, as a list literal the checker then types. An exact
// function target, with its type parameters pinned (`annotated<route<Req>>()`)
// if it has any, lists
//
//     AnnotatedFunction<bench, F> { name, module, args: bench { ... }, function: f }
//
// and any other target `AnnotatedItem<bench> { name, module, kind, args }`,
// `kind` an `AnnotatedKind` variant. Pins keep only the uses binding them.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.MarkKind
import kf_core.ast.declaration.MarkTarget
import kf_core.ast.declaration.TypeParam
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.note_import_use_named
import kf_typecheck.find_annotation
import kf_typecheck.types.type_eq
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.type_to_type_ref
import kf_typecheck.check.decl.is_borrow
import kf_typecheck.check.decl.type_param_name

/// What a query's entries are: callable `AnnotatedFunction`s of one function
/// type, or `AnnotatedItem`s naming each declaration.
struct EntryShape {
    val is_callable: bool
    /// The entries' function type, and as written for the entry's type.
    val function_type: Type
    val function_ref: TypeRef
}

/// `annotated<handler>()`, or `annotated<handler<Server>>()` pinning each of
/// the annotation's type parameters.
struct AnnotationQuery {
    val index: uint64
    val pins: List<Type>
}

pub mutating fun Expr.expand_annotated(args: &List<Expr>, ctx: &var TypeCtx): void {
    val sigs = unsafe { &*ctx.sigs }
    val query = self.queried_annotation(args, sigs, ctx) ?: return
    val declared = sigs.annotations.at(query.index)
    val shape = declared.entry_shape(&query.pins, self.span)
    var elements = List.new<Expr>()
    while listed in &sigs.annotated {
        if listed.annotation == query.index && listed.binds_as(&query.pins) {
            elements.push(annotated_entry(&listed, &declared, &shape, self.span, ctx))
        }
    }
    var built = if elements.size() == 0 {
        Expr.new_collection_new_call(self.span, ctx.list_name())
    } else {
        var array = List.new<Expr>()
        array.push(Expr.new_list_literal(self.span, &elements))
        val receiver = Box.new(Expr.new(self.span, ExprKind.Variable(ctx.list_name())))
        Expr.new(self.span, ExprKind.MethodCall(receiver, intern("from"), array))
    }
    built.type_args.push(TypeRef.new(self.span, TypeRefKind.Named(intern(shape.entry_type_name()),
        entry_type_args(&declared, &shape, self.span))))
    built.type_args_written = true
    *self = built
    check_expr(self, ctx)
}

/// CONSTRAINT: by name until a release's seed knows a lang key for them.
fun EntryShape.entry_type_name(): str {
    return if self.is_callable { "AnnotatedFunction" } else { "AnnotatedItem" }
}

/// Callable for an exact function type whose type parameters, if any, the
/// query pins; the pinned type is the target's with each parameter replaced.
fun DeclaredAnnotation.entry_shape(pins: &List<Type>, span: Span): EntryShape {
    val written = when (self.target) {
        Function(ty) => Option.Some((*ty).clone())
        _ => null
    }
    val is_callable = written != null && (self.type_params.size() == 0 || pins.size() > 0)
    if pins.size() == 0 {
        val function_ref = written ?: TypeRef.new_poison(span)
        return EntryShape {
            is_callable: is_callable, function_type: self.function_type.clone(), function_ref: function_ref
        }
    }
    val pinned = self.function_type.with_params(&self.type_params, pins)
    val function_ref = pinned.type_to_type_ref(span)
    return EntryShape { is_callable: is_callable, function_type: pinned, function_ref: function_ref }
}

/// Each parameter and the result with a type parameter, or a borrow of one,
/// replaced by its pin.
fun Type.with_params(params: &List<TypeParam>, pins: &List<Type>): Type {
    val parts = self.fn_parts() ?: return *self
    var types = List.new<Type>()
    while param in &parts.params {
        types.push(param.slot_with(params, pins))
    }
    return Type.new_fn(types, parts.ret.slot_with(params, pins), self.provenance)
}

fun Type.slot_with(params: &List<TypeParam>, pins: &List<Type>): Type {
    val name = self.through_borrow().type_param_name() ?: return *self
    while i in 0..params.size() {
        if params.at(i).name.id == name.id {
            val pin = *pins.at(i)
            if self.is_borrow(false) || self.is_borrow(true) { return pin.borrowed(self.is_borrow(true), no_span()) }
            return pin
        }
    }
    return *self
}

/// Whether this use's type parameters stand for the pins; any use when there
/// are none.
fun AnnotatedItem.binds_as(pins: &List<Type>): bool {
    if pins.size() == 0 { return true }
    if self.bindings.size() != pins.size() { return false }
    while i in 0..pins.size() {
        if !self.bindings.at(i).type_eq(*pins.at(i)) { return false }
    }
    return true
}

/// The queried annotation and its pins; null, reported and typed poison,
/// when the query names none this file sees or pins some parameters but not
/// all.
mutating fun Expr.queried_annotation(args: &List<Expr>, sigs: &SigTable, ctx: &var TypeCtx): AnnotationQuery? {
    val name = self.single_type_name()
    if name.as_str().equals("") {
        return self.query_error("`annotated` takes one annotation name: `annotated<bench>()`", ctx)
    }
    if args.size() > 0 { return self.query_error("`annotated` takes no arguments", ctx) }
    val found = sigs.find_annotation(name.as_str(), ctx.owner_file, ctx.owner_crate, ctx.owner_module)
    val index = found ?: return self.query_error("cannot find annotation `${name.as_str()}` in this scope", ctx)
    val declared = sigs.annotations.at(index)
    note_import_use_named(ctx.sigs, ctx.owner_file, declared.module, declared.name)
    if declared.target.marks_only_members() {
        val why = "`annotated` lists declarations, not fields or variants"
        return self.query_error("`@${name.as_str()}` marks only members: ${why}", ctx)
    }
    val pin_refs = self.queried_type_args()
    val wanted = declared.type_params.size()
    if wanted == 0 && pin_refs.size() > 0 {
        return self.query_error("`${name.as_str()}` has no type parameters to pin", ctx)
    }
    if pin_refs.size() > 0 && pin_refs.size() != wanted {
        val count = if wanted == 1 { String.from("1 type parameter") } else { "${wanted} type parameters" }
        return self.query_error("`${name.as_str()}` has ${count}: pin all of them or none", ctx)
    }
    var pins = List.new<Type>()
    while pin in &pin_refs {
        pins.push(pin.resolve_type_ref(ctx))
    }
    return AnnotationQuery { index: index, pins: pins }
}

mutating fun Expr.query_error(message: String, ctx: &var TypeCtx): AnnotationQuery? {
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = Type.new_poison()
    return null
}

/// The one name in `<...>`, with or without type arguments, or the empty
/// name.
fun Expr.single_type_name(): Sym {
    if self.type_args.size() != 1 { return intern("") }
    return when (self.type_args.at(0).kind) {
        Named(name, _args) => name
        _ => intern("")
    }
}

/// `Server` in `annotated<handler<Server>>()`.
fun Expr.queried_type_args(): List<TypeRef> {
    var pins = List.new<TypeRef>()
    if self.type_args.size() != 1 { return pins }
    when (self.type_args.at(0).kind) {
        Named(_name, args) => pins = args.clone()
        _ => {}
    }
    return pins
}

/// `<bench, (Request) -> Response>` for callable entries, `<bench>` for the
/// rest.
fun entry_type_args(declared: &DeclaredAnnotation, shape: &EntryShape, span: Span): List<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(span, TypeRefKind.Named(declared.name, List.new<TypeRef>())))
    if shape.is_callable { args.push(shape.function_ref.clone()) }
    return args
}

/// One entry. A function is named directly, not looked up: a private
/// function of another module is listed too.
fun annotated_entry(listed: &AnnotatedItem, declared: &DeclaredAnnotation, shape: &EntryShape, span: Span,
    ctx: &var TypeCtx): Expr {
    var fields = List.new<FieldInit>()
    fields.push(string_field("name", listed.name.as_str(), span))
    fields.push(string_field("module", listed.module.as_str(), span))
    val arguments = arguments_literal(listed, declared, span)
    fields.push(FieldInit { span: span, name: intern("args"), value: Box.new(arguments) })
    if shape.is_callable {
        var reference = Expr.new(span, ExprKind.FnRef(listed.item))
        reference.ty = shape.function_type.clone()
        ctx.note_fn_type(&reference.ty)
        fields.push(FieldInit { span: span, name: intern("function"), value: Box.new(reference) })
    } else {
        val kind_type = Expr.new(span, ExprKind.Variable(intern("AnnotatedKind")))
        val variant = Expr.new(span, ExprKind.FieldAccess(Box.new(kind_type), listed.kind.variant_name()))
        fields.push(FieldInit { span: span, name: intern("kind"), value: Box.new(variant) })
    }
    var entry = Expr.new(span, ExprKind.StructLit(intern(shape.entry_type_name()), fields))
    entry.type_args = entry_type_args(declared, shape, span)
    entry.type_args_written = true
    return entry
}

fun string_field(name: str, value: str, span: Span): FieldInit {
    val literal = Expr.new(span, ExprKind.LitStr(String.from(value)))
    return FieldInit { span: span, name: intern(name), value: Box.new(literal) }
}

/// `bench { iterations: 1000, label: "sort" }`, each value where the use
/// wrote it, so a type mismatch points there.
fun arguments_literal(listed: &AnnotatedItem, declared: &DeclaredAnnotation, span: Span): Expr {
    var fields = List.new<FieldInit>()
    while i in 0..declared.params.size() {
        val value = listed.args.at(i).clone()
        fields.push(FieldInit { span: value.span, name: declared.params.at(i).name, value: Box.new(value) })
    }
    return Expr.new(span, ExprKind.StructLit(declared.name, fields))
}

fun MarkTarget.marks_only_members(): bool {
    val kinds = self.kinds()
    if kinds.size() == 0 { return false }
    while listed in &kinds {
        if !listed.kind.is_member() { return false }
    }
    return true
}

fun MarkKind.variant_name(): Sym {
    return when (self) {
        Function => intern("Function")
        Struct => intern("Struct")
        Enum => intern("Enum")
        Trait => intern("Trait")
        // Only declarations are listed.
        _ => intern("")
    }
}
