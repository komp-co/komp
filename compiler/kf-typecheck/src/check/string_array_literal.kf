// `"abc"` where a `uint8` or `char` array is expected: the literal's bytes, or
// its characters, as an array literal.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type

/// What one element of an array built from text holds.
enum TextUnit {
    Byte
    Character
}

/// None unless `self` is `uint8` or `char`.
fun Type.text_unit(): TextUnit? {
    return when (self.kind) {
        UInt8 => TextUnit.Byte
        Char => TextUnit.Character
        _ => null
    }
}

fun TextUnit.count_in(text: str): uint64 {
    return when (self) {
        Byte => text.byte_len()
        Character => text.char_count()
    }
}

fun TextUnit.noun(): str {
    return when (self) {
        Byte => "bytes"
        Character => "characters"
    }
}

/// The literal's text, when it is one.
fun Expr.string_literal_text(): String? {
    return when (self.kind) {
        LitStr(text) => text.clone()
        _ => null
    }
}

/// How many elements the literal makes of `element`; None unless it is a
/// string literal and `element` holds text.
fun Expr.text_literal_length(element: &Type): uint64? {
    val text = self.string_literal_text() ?: return null
    val unit = element.text_unit() ?: return null
    return unit.count_in(text.as_str())
}

/// True when `self` is a string literal and `expected` an array of `uint8` or
/// `char`, whether or not the literal fits.
mutating fun Expr.retarget_string_literal(expected: Type, ctx: &var TypeCtx): bool {
    val text = self.string_literal_text() ?: return false
    val shape = expected.array_shape(ctx) ?: return false
    val unit = shape.element.text_unit() ?: return false
    val count = unit.count_in(text.as_str())
    if count != shape.length {
        val shown = expected.display_type(ctx)
        val message = "this string has ${count} ${unit.noun()}, but `${shown}` holds ${shape.length}"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        self.ty = Type.new_poison()
        return true
    }
    var elements = unit.elements_of(text.as_str(), self.span)
    while i in 0..elements.size() {
        check_expr(elements.at_mut(i), ctx)
    }
    self.become_array_literal(elements, expected, &shape, ctx)
    return true
}

/// One literal per byte, or per character.
fun TextUnit.elements_of(text: str, span: Span): List<Expr> {
    var out = List.new<Expr>()
    when (self) {
        Byte => {
            while i in 0..text.byte_len() {
                out.push(Expr.new(span, ExprKind.LitInt(text.byte_at(i) as int64)))
            }
        }
        Character => {
            while c in text.chars() {
                out.push(Expr.new(span, ExprKind.LitChar(c as uint32)))
            }
        }
    }
    return out
}
