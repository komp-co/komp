// What an operator says when it cannot dispatch: the name the reader should
// see, the impl to write, or for a type parameter the bound to widen.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.type_identity_display
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type

/// What the source calls the type, not the canonical `crate::module::Name`
/// lookup key, which no program could write.
pub fun Type.source_type_name(): String {
    return type_identity_display(intern(self.ty_base_name().as_str()))
}

pub fun emit_missing_operator_impl(ty: Type, trait_name: str, span: Span, ctx: &var TypeCtx): void {
    // A type parameter needs a bound, not an impl.
    when (ty.kind) {
        Generic(name) => {
            val why = "operator requires `${trait_name}`, which `${name.as_str()}` is not bounded by"
            val fix = "${why}; add it: `${name.as_str()}: ${trait_name}`"
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, fix)))
            return
        }
        _ => { }
    }
    val base = ty.source_type_name()
    // Two names: the impl target with the template's parameters (`Option<T>`),
    // what an author pastes, and the operand in full (`Option<int32>`), the
    // instantiation rejected.
    val target = impl_target_spelling(base.clone(), ctx)
    val operand = ty.display_type(ctx)
    var message = "operator requires `impl ${trait_name} for ${target}`"
    if !operand.as_str().equals(target.as_str()) {
        message = message + "; `${operand}` has none"
    }
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// `Option` as `Option<T>`, `HashMap` as `HashMap<K, V>`; others unchanged.
fun impl_target_spelling(base: String, ctx: &var TypeCtx): String {
    val info = unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) } ?: return base
    if info.type_params.size() == 0 { return base }
    var out = base.clone()
    out.append("<")
    while i in 0..info.type_params.size() {
        if i > 0 { out.append(", ") }
        out.append(info.type_params.at(i).as_str())
    }
    out.append(">")
    return out
}

fun emit_operator_type_mismatch(left: Type, right: Type, span: Span, ctx: &var TypeCtx): void {
    val shown = "`${left.display_type(ctx).as_str()}` and `${right.display_type(ctx).as_str()}`"
    val message = "operator operands must have the same type: ${shown.as_str()}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}
