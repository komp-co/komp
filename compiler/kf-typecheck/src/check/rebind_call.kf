// Re-binds a call to the instance its slot asks for, when its type arguments
// were settled bottom-up from its own arguments: a generic constructor
// inference could not fully bind (`Option.None`), or a generic call bound only
// by integer literals (`0..3` is `range(0, 3, 1)`, defaulting to `int32`).
//
// CONSTRAINT: both rebuild rather than mutate. A call's argument list may
// alias a statement buffer `check_stmt` handed out, so `set` through it
// corrupts the node.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.rebuilt
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_typecheck.types.*

/// A constructor checked against the template adopts the slot's instance
/// arguments and type. Payloads are not re-checked in place (see the
/// header); stamping the type args and materializing the layout is enough.
mutating fun Expr.rebind_template_ctor(inst: &GenericInst, ctx: &var TypeCtx): bool {
    if self.type_args.size() > 0 { return false }
    val base = inst.base.clone()
    when (self.kind) {
        MethodCall(recv_ptr, mname, margs) => {
            val recv_raw = unsafe { *recv_ptr }
            if !kind_is_variable_named(recv_raw.kind, base.as_str()) { return false }
            if !enum_name_has_variant(base.clone(), mname.as_string(), ctx) { return false }
            val concrete = concrete_enum_name(base.clone(), &inst.args, ctx)
            // A fresh, payload-coerced argument list, assigned to `self.kind`. The
            // concrete variant is where the real payload count is known, since
            // a `void` argument removes a slot.
            if !ctor_arity_matches(concrete.clone(), base.clone(), mname.as_string(), &margs, self.span, ctx) { return false }
            val coerced = coerce_ctor_payloads(concrete.clone(), mname.as_string(), margs, ctx)
            self.type_args = clone_type_args(&inst.args)
            self.ty = enum_ty_of(concrete.clone(), self.span)
            self.kind = ExprKind.MethodCall(recv_ptr, mname, coerced)
            return true
        }
        FieldAccess(obj_ptr, fname) => {
            val obj_raw = unsafe { *obj_ptr }
            if !kind_is_variable_named(obj_raw.kind, base.as_str()) { return false }
            if !enum_name_has_variant(base.clone(), fname.as_string(), ctx) { return false }
            val concrete = concrete_enum_name(base.clone(), &inst.args, ctx)
            self.type_args = clone_type_args(&inst.args)
            self.ty = enum_ty_of(concrete.clone(), self.span)
            return true
        }
        _ => return false
    }
}

/// Mangled, with its layout materialized. `args` is never empty here.
fun concrete_enum_name(base: String, args: &List<TypeRef>, ctx: &var TypeCtx): String {
    val concrete = mangle_type_name(base.as_str(), args, ctx)
    val stored = String.from(concrete.as_str())
    instantiate_generic_layout(base.clone(), args, stored.clone(), ctx)
    return stored
}

fun enum_ty_of(name: String, span: Span): Type {
    return Type { kind: TypeKind.EnumTy(intern(name.as_str())), provenance: Provenance.Inferred(span) }
}

/// A fresh list whose payloads carry the coercions the concrete variant
/// needs, which the template's `Generic(_)` payloads could not decide.
fun coerce_ctor_payloads(concrete: String, variant: String, args: &List<Expr>, ctx: &var TypeCtx): List<Expr> {
    val payloads = variant_payloads(concrete, variant, ctx)
    var out = List.new<Expr>()
    while i in 0..args.size() {
        // Cloned, so `out` shares no buffers with the AST.
        var a = args.at(i).clone()
        if i < payloads.size() {
            val ptype = *payloads.at(i)
            // `a` is this list's own, so every expectation applies.
            a.apply_expected(ptype, ctx)
        }
        out.push(a)
    }
    return out
}

/// Reported against the template's name, as written.
fun ctor_arity_matches(concrete: String, base: String, variant: String, args: &List<Expr>, span: Span, ctx: &var TypeCtx): bool {
    // Only with a real layout: `variant_payloads` returns empty for a missing
    // one too.
    val layout = unsafe { (*ctx.sigs).find_enum(concrete.as_str(), ctx.owner_crate) } ?: return true
    while v in &layout.variants {
        if v.name.as_str().equals(variant.as_str()) {
            if args.size() == v.payloads.size() { return true }
            // A trailing `void` payload may be omitted (`Result.Ok()`).
            if v.trailing_payloads_are_unit(args.size()) { return true }
            emit_ctor_arity_err(base, variant, v.payloads.size(), args.size(), span, ctx)
            return false
        }
    }
    return true
}

/// Empty if unknown.
fun variant_payloads(concrete: String, variant: String, ctx: &var TypeCtx): List<Type> {
    val layout = unsafe { (*ctx.sigs).find_enum(concrete.as_str(), ctx.owner_crate) } ?: return List.new<Type>()
    while v in &layout.variants {
        if v.name.as_str().equals(variant.as_str()) { return v.payloads }
    }
    return List.new<Type>()
}

fun kind_is_variable_named(k: ExprKind, want: str): bool {
    return when (k) {
        Variable(n) => n.as_str().equals(want)
        _ => false
    }
}
/// A generic call re-bound to the slot's instance: every container indexes by
/// `uint64`, but `0..3` alone would be `Range<int32>`. General, not
/// range-specific. The commitment point is the return type: the callee's
/// return, substituted with bindings read from the slot, must equal the slot
/// exactly, or the node is left for the ordinary mismatch report.
mutating fun Expr.rebind_generic_call(expected: &Type, ctx: &var TypeCtx): bool {
    // Written type arguments outrank the slot.
    if self.type_args_written { return false }
    if self.ty.type_eq(unsafe { *expected }) { return false }

    var callee = intern("")
    when (self.kind) {
        Call(sym, _args) => callee = sym
        _ => return false
    }
    val name = callee.as_string()
    val found = unsafe { (*ctx.sigs).find_imported_signature(name.as_str(), ctx.owner_file, ctx.owner_crate, ctx.owner_module) }
    if found.is_none() { return false }
    val sig = found ?: return false

    val bindings = self.rebound_call_bindings(expected, ctx)
    if bindings.size() == 0 { return false }
    var ret = sig.ret
    while si in 0..bindings.size() {
        ret = ret.subst_generic(*sig.generics.at(si), *bindings.at(si))
    }

    // Every argument must fit, tested without mutating, since
    // `apply_expected` would report a literal that does not fit.
    var params = List.new<Type>()
    var pi = 0
    while pi < sig.params.size() {
        var pt = *sig.params.at(pi)
        while pj in 0..bindings.size() {
            pt = pt.subst_generic(*sig.generics.at(pj), *bindings.at(pj))
        }
        params.push(pt)
        pi = pi + 1
    }
    when (self.kind) {
        Call(_sym, args) => {
            if args.size() != params.size() { return false }
            while ai in 0..args.size() {
                if !arg_admits_param(args.at(ai), params.at(ai), ctx.string_name()) { return false }
            }
        }
        _ => return false
    }

    // Rebuilt with a fresh argument list.
    var rebuilt = List.new<Expr>()
    when (self.kind) {
        Call(_sym, args) => {
            while ai in 0..args.size() {
                var a = args.at(ai).clone()
                a.apply_expected(*params.at(ai), ctx)
                rebuilt.push(a)
            }
        }
        _ => return false
    }

    // New bindings, so their bounds are checked now.
    while bi in 0..bindings.size() {
        check_generic_bounds_with_bindings(name.clone(), *sig.generics.at(bi), *bindings.at(bi), &sig.generics, &bindings, self.span, ctx)
    }

    // Written back, as check_call does.
    var written = List.new<TypeRef>()
    while binding in &bindings {
        val tr = binding.ty_written_ref(self.span, ctx.sigs)
        if tr.type_ref_is_poison() { return false }
        written.push(tr)
    }
    ret.register_returned_instance(self.span, ctx)
    self.type_args = written
    self.ty = ret
    self.kind = ExprKind.Call(callee, rebuilt)
    return true
}

/// Without changing `a`: equal types, the flat table, or an integer literal
/// that fits. Anything else is not rebound, the conservative direction.
fun Expr.arg_admits_param(want: &Type, string_name: Sym): bool {
    if type_eq(unsafe { self.ty }, unsafe { *want }) { return true }
    if self.ty.can_coerce(want, string_name) { return true }
    if is_numeric(unsafe { *want }) {
        when (self.kind) {
            LitInt(value) => return positive_integer_literal_fits(value, unsafe { *want })
            _ => { }
        }
        val magnitude = negative_integer_literal_magnitude(unsafe { *self })
        if magnitude >= 0 { return negative_integer_literal_fits(magnitude, unsafe { *want }) }
    }
    return false
}

/// The type arguments that make `a` produce `want`, or empty. Asked without
/// touching `a`, by expected-type propagation and by trait dispatch, which
/// must see `b[0..2]` as `Index<Range<uint64>>` before any expectation exists.
/// A callee with no generics is never rebound.
pub fun Expr.rebound_call_bindings(want: &Type, ctx: &var TypeCtx): List<Type> {
    val none = List.new<Type>()
    if self.type_args_written { return none }
    var callee = intern("")
    when (self.kind) {
        Call(sym, _args) => callee = sym
        _ => return none
    }
    val name = callee.as_string()
    val found = unsafe { (*ctx.sigs).find_imported_signature(name.as_str(), ctx.owner_file, ctx.owner_crate, ctx.owner_module) }
    if found.is_none() { return none }
    val sig = found ?: return none
    if sig.generics.size() == 0 { return none }

    // The same matcher as argument inference, run against the return.
    var bindings = List.new<Type>()
    while generic in &sig.generics {
        val bound = sig.ret.bind_generic_from_param(want, generic.as_str(), ctx)
        if bound.is_poison() { return none }
        bindings.push(bound)
    }
    // The bindings must reproduce `want` exactly.
    var ret = sig.ret
    while si in 0..bindings.size() {
        ret = ret.subst_generic(*sig.generics.at(si), *bindings.at(si))
    }
    if !ret.type_eq(unsafe { *want }) { return none }
    return bindings
}
