// Asserted here: a `build: fail` corpus case cannot tell this diagnostic from
// a C error.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.crate_id_poison
import kf_core.ast.intern
import kf_core.ast.types.*
import kf_core.diagnostic.*
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.leaked_diagnostics

/// `Counter.Iter = CountIter`, with or without `next_ptr`.
fun mk_iter_ctx(with_next_ptr: bool): TypeCtx {
    val sp: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sp = new_sig_table() }
    val iter_ty = Type { kind: TypeKind.Struct(intern("CountIter")), provenance: Provenance.Inferred(no_span()) }
    unsafe { sp.insert_assoc_binding(AssocBindingInfo {
        type_name: String.from("Counter"), trait_name: String.from(""),
        trait_args: String.from(""), assoc_name: String.from("Iter"), chosen: iter_ty,
        chosen_tref: TypeRef.new(no_span(), TypeRefKind.Named(intern("CountIter"), List.new<TypeRef>())) }) }
    if with_next_ptr {
        unsafe { sp.insert(FnSignature {
            name: String.from("CountIter_next_ptr"), params: List.new<Type>(),
            ret: Type.new_void(no_span()), generics: List.new<String>(), is_static: false,
            is_mutating: true, owner_module: intern(""), owner_crate: crate_id_poison(),
            is_pub: true, borrows: -1, is_prelude: false, is_extern: false }) }
    }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, Option.None, sp)
}

fun counter_ty(): Type {
    return Type { kind: TypeKind.Struct(intern("Counter")), provenance: Provenance.Inferred(no_span()) }
}

@test fun a_type_without_next_ptr_has_no_borrowing_iterator(): void {
    var ctx = mk_iter_ctx(false)
    assert_eq(borrowing_iterator_exists(&counter_ty(), &var ctx), false,
        "an iterator with only `next()` cannot back `while x in &xs`")
}

@test fun a_type_with_next_ptr_has_a_borrowing_iterator(): void {
    var ctx = mk_iter_ctx(true)
    assert_eq(borrowing_iterator_exists(&counter_ty(), &var ctx), true,
        "`next_ptr` on the iterator is what the borrowing form needs")
}

// Names the binder, the iterator and both repairs.
@test fun the_diagnostic_names_the_iterator_and_both_repairs(): void {
    var ctx = mk_iter_ctx(false)
    report_no_borrowing_iterator(&counter_ty(), intern("v"), no_span(), &var ctx)
    val diags = unsafe { *ctx.diags }
    assert_eq(diags.size(), 1, "one diagnostic")
    val m = diags.at(0).primary.message
    assert_eq(m.as_str().contains("while v in &..."), true, "names the loop as written")
    assert_eq(m.as_str().contains("CountIter"), true, "names the iterator")
    assert_eq(m.as_str().contains("next_ptr"), true, "names what is missing")
    assert_eq(m.as_str().contains("drop the `&`"), true, "and the other way out")
}

// An unknown subject is left to the ordinary `no method` path.
@test fun an_unknown_subject_is_not_reported_here(): void {
    var ctx = mk_iter_ctx(false)
    val unknown = Type { kind: TypeKind.Struct(intern("Nothing")), provenance: Provenance.Inferred(no_span()) }
    assert_eq(unknown.borrowing_iterator_exists(&var ctx), true,
        "no assoc binding means no claim")
}
