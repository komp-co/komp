// Resolving `recv.m(args)`, and the `no method` diagnostic with its
// nearest-name suggestion.

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_core.diagnostic.with_fix_applic
import kf_core.ast.types.type_node
import kf_typecheck.types.*
import kf_typecheck.traits.*
import kf_typecheck.check.record_untyped_receiver
import kf_typecheck.check.borrow.coerce_call_arg
import kf_typecheck.check.borrow.reject_kept_temporary
import kf_typecheck.note_import_use

/// `Equal`, `Compare` and `Display` on built-in types are satisfied without an
/// impl. Says only that the name is not an error; the type stays poison.
fun primitive_intrinsic_method(name: str): bool {
    return when name {
        "equals" => true
        "compare" => true
        "display" => true
        _ => false
    }
}

/// Only a struct has the container and field fallbacks.
fun TypeKind.is_primitive_kind(): bool {
    return when (self) {
        Struct(_) => false
        // An enum is nominal: it has the impl and field paths.
        EnumTy(_) => false
        _ => !self.trait_impl_owner_name().as_str().equals("")
    }
}

fun emit_no_such_method(type_name: String, method_name: String, span: Span, name_span: Span, ctx: &var TypeCtx): void {
    var msg = "no method `${method_name.as_str()}` on `${type_name.as_str()}`"
    if method_name.as_str().equals("display") {
        msg.append(" (implement `Display` for it, or interpolate a field instead)")
    }
    msg.append(unimported_extension_note(method_name.as_str(), ctx).as_str())
    val near = nearest_method(type_name.as_str(), method_name.as_str(), ctx)
    if near.name.as_str() != "" { msg.append(" (did you mean `${near.name.as_str()}`?)") }
    val diag = new_diagnostic(Severity.Error, new_label(span, msg))
    // The fix spans `name_span`, since the call's span opens at the receiver.
    if near.name.as_str() != "" && !name_span.is_none() {
        val title = "change to `${near.name.as_str()}`"
        // A tie makes the winner arbitrary: named, not written unasked.
        var applic = Applicability.MachineApplicable
        if near.tied { applic = Applicability.MaybeIncorrect }
        ctx.emit(with_fix_applic(diag, name_span, near.name, title, applic))
        return
    }
    ctx.emit(diag)
}

struct NearMethod {
    val name: String
    /// Another method is equally close.
    val tied: bool
}

/// The closest method, or "". Candidates come from the sig table, so inherent
/// and trait methods both count. A monomorphized receiver falls back to the
/// template's methods only when its own come up empty. One edit per four
/// characters, at least one.
fun nearest_method(type_name: str, wanted: str, ctx: &var TypeCtx): NearMethod {
    val wn = wanted.byte_len()
    if wn == 0 { return NearMethod { name: "", tied: false } }
    var budget: uint64 = wn / 4
    if budget == 0 { budget = 1 }
    val direct = nearest_with_extensions(type_name, wanted, budget, ctx)
    if direct.name.as_str() != "" { return direct }
    val base = mangle_base_name(String.from(type_name))
    if base.as_str().equals(type_name) { return direct }
    return nearest_method_of(base.as_str(), wanted, budget, ctx)
}

/// `tied` is a second candidate at the winning distance; the same name twice
/// (inherent and trait) is not a tie.
fun nearest_method_of(owner: str, wanted: str, budget: uint64, ctx: &var TypeCtx): NearMethod {
    var best = ""
    var best_d = budget + 1
    var tied = false
    var prefix = String.from(owner)
    prefix.append("_")
    val sigs = unsafe { (*ctx.sigs).sigs }
    while sig in &sigs {
        val cand = method_of(sig.name.as_str(), prefix.as_str())
        if cand.as_str() != "" && !cand.as_str().equals(wanted) {
            val d = edit_distance(wanted, cand.as_str(), best_d)
            if d < best_d {
                best_d = d
                best = cand
                tied = false
            } else if d == best_d && best.as_str() != "" && !cand.as_str().equals(best.as_str()) {
                tied = true
            }
        }
    }
    return NearMethod { name: best, tied: tied }
}

/// `Point_sum` under `Point_` is `sum`; `Widget_make__Producer` is `make`; ""
/// otherwise.
fun method_of(sig_name: str, prefix: str): String {
    val pn = prefix.byte_len()
    val n = sig_name.byte_len()
    if n <= pn { return "" }
    var i = 0
    while i < pn {
        if sig_name.byte_at(i) != prefix.byte_at(i) { return "" }
        i = i + 1
    }
    var end = n
    var j = pn
    while j + 1 < n {
        if sig_name.byte_at(j) == 95 && sig_name.byte_at(j + 1) == 95 {
            end = j
            break
        }
        j = j + 1
    }
    if end <= pn { return "" }
    return sig_name.substring(pn, end)
}

/// Levenshtein distance, abandoned past `cap`.
pub fun edit_distance(a: str, b: str, cap: uint64): uint64 {
    val an = a.byte_len()
    val bn = b.byte_len()
    if an > bn + cap { return cap + 1 }
    if bn > an + cap { return cap + 1 }
    var prev = List.new<uint64>()
    var k = 0
    while k <= bn {
        prev.push(k)
        k = k + 1
    }
    var i = 0
    while i < an {
        var cur = List.new<uint64>()
        cur.push(i + 1)
        var row_best = i + 1
        var j = 0
        while j < bn {
            val cost: uint64 = if a.byte_at(i) == b.byte_at(j) { 0 } else { 1 }
            var m = prev.get(j) + cost
            val del = prev.get(j + 1) + 1
            val ins = cur.get(j) + 1
            if del < m { m = del }
            if ins < m { m = ins }
            cur.push(m)
            if m < row_best { row_best = m }
            j = j + 1
        }
        if row_best > cap { return cap + 1 }
        prev = cur
        i = i + 1
    }
    return prev.get(bn)
}

fun emit_method_arity(method_name: String, expected: uint64, found: uint64, span: Span, ctx: &var TypeCtx): void {
    val msg = "wrong number of arguments to method `${method_name}`: expected ${expected}, found ${found}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

fun check_method_arg(args: &var List<Expr>, arg_tys: &List<Type>, index: uint64, expected: Type, method_name: String, span: Span, ctx: &var TypeCtx): bool {
    val outcome = coerce_call_arg(args, index, expected.clone(), ctx)
    if !outcome.valid { return false }
    // After the coercion, which may have typed an open binding; a lambda
    // still waiting on its bound stays poison.
    val actual = if arg_tys.at(index).is_poison() { Type.new_poison() } else { args.at(index).ty.clone() }
    if outcome.coerced || actual.type_eq(expected) || ctx.fits(actual, expected) { return true }
    if actual.display_type(ctx).as_str().equals(expected.display_type(ctx).as_str()) { return false }
    val msg = "wrong type for argument ${index + 1} of method `${method_name}`: expected `${expected.display_type(ctx)}`, found `${actual.display_type(ctx)}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
    return false
}

fun trait_method_ret(recv_ty: Type, method_name: String, args: &var List<Expr>, tm_span: Span, ctx: &var TypeCtx,
    call: &var Expr): Type {
    val selected = select_instance_trait_method(recv_ty.clone(), method_name.clone(), args, ctx)
    if selected.sig_name.as_str().equals("") { return Type.new_poison() }
    // Mono clones the impl at these.
    if selected.lifted.size() > 0 { call.type_args = selected.lifted_args(tm_span) }
    // A monomorphized receiver reads the template's return type through its
    // arguments: `Twice<S>.pull(): S` on `Twice__Counter` is Counter.
    val binding = bound_checked_recv_bindings(autoderef_ty(recv_ty).kind.trait_impl_owner_name(), method_name.clone(), tm_span, ctx)
    var pre = Type.new_poison()
    when (unsafe { (*ctx.sigs).find_signature(selected.sig_name.as_str()) }) {
        Some(sig) => {
            pre = sig.ret
            // The selected impl's parameter types are the arguments' only expectation.
            // Through `coerce_call_arg`: dispatch already accepted them.
            if !sig.is_static {
                if sig.params.size() == args.size() + 1 {
                    while ai in 0..args.size() {
                        coerce_call_arg(args, ai, selected.bind_lifted(subst_recv(*sig.params.at(ai + 1), &binding)), ctx)
                    }
                }
            }
        }
        None => { }
    }
    val ret = subst_recv(pre.clone(), &binding)
    // The receiver's arguments pin a return type naming another generic.
    pre.register_substituted_return_row(&ret, &binding, no_span(), ctx)
    ret.register_returned_instance(no_span(), ctx)
    return ret
}

pub fun check_method_call(receiver_ty: Type, method_name: String, args: &var List<Expr>, _span: Span, ctx: &var TypeCtx, call: &var Expr): Type {
    // Arguments first, in place, so nested receivers are typed even when the
    // method does not resolve.
    report_annotated_lambda_args(receiver_ty.clone(), method_name.clone(), args, _span, ctx)
    val pretyped = ctx.take_pretyped_args()
    var arg_tys = List.new<Type>()
    var ai = 0
    while ai < args.size() {
        val aa = args.at_mut(ai)
        // A lambda with a bare parameter waits for its bound's type.
        if aa.lambda_wants_expectation() {
            arg_tys.push(Type.new_poison())
        } else {
            if ai >= pretyped { aa.check_call_argument(ctx) }
            arg_tys.push(aa.ty.clone())
        }
        ai = ai + 1
    }
    expect_lambda_args(receiver_ty.clone(), method_name.clone(), args, &var arg_tys, _span, ctx)
    if receiver_ty.is_poison() {
        record_untyped_receiver(_span, method_name.as_str(), ctx.sigs)
        return Type.new_poison()
    }
    // Through a pointer or reference to the pointee.
    val recv_ty = autoderef_ty(receiver_ty)
    if ty_is_void(recv_ty) {
        val msg = "cannot call method `${method_name}` on `void`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(_span, msg)))
        return Type.new_poison()
    }
    if recv_ty.kind.kind_tag() == TAG_GENERIC() {
        // A bounded type parameter offers its bounds' methods; Mono dispatches
        // by name later.
        val gname = recv_ty.kind.generic_name()
        val treq = trait_method_for_generic(gname.clone(), method_name.clone(), ctx)
        if treq.arity != ARITY_NOT_FOUND() {
            if args.size() != treq.params.size() {
                emit_method_arity(method_name, treq.params.size(), args.size(), _span, ctx)
                return Type.new_poison()
            }
            var t_err = false
            while ti in 0..arg_tys.size() {
                val expected = *treq.params.at(ti)
                if !check_method_arg(args, &arg_tys, ti, expected, method_name.clone(), _span, ctx) { t_err = true }
            }
            if t_err { return Type.new_poison() }
            return treq.ret
        }
        report_no_parameter_method(gname.as_str(), method_name.as_str(), _span, ctx)
        return Type.new_poison()
    }
    // A projection receiver: methods come from the associated type's bounds.
    if recv_ty.kind.kind_tag() == TAG_PROJECTION() {
        val owner_param = recv_ty.kind.projection_owner_param()
        val member = recv_ty.kind.projection_member()
        if !owner_param.as_str().equals("") {
            val found = trait_method_for_projection(owner_param.clone(), member.as_str(), method_name.clone(), recv_ty.clone(), ctx)
            val preq = found.req
            if preq.arity != ARITY_NOT_FOUND() {
                if args.size() != preq.params.size() {
                    emit_method_arity(method_name, preq.params.size(), args.size(), _span, ctx)
                    return Type.new_poison()
                }
                var p_err = false
                while pi in 0..arg_tys.size() {
                    val expected = *preq.params.at(pi)
                    if !check_method_arg(args, &arg_tys, pi, expected, method_name.clone(), _span, ctx) { p_err = true }
                }
                if p_err { return Type.new_poison() }
                // The callee `<Type>_<method>__<Trait>` has an unknown type half,
                // recorded as `.` (no C identifier contains one) for Mono to fill.
                // CONSTRAINT: the `_` stays so `subst_static_callee` can reach the
                // trait arguments.
                var pending = "._${method_name}"
                if !found.trait_suffix.as_str().equals("") {
                    pending = pending + String.from("__") + found.trait_suffix
                }
                unsafe { call.mangled_callee = intern(pending.as_str()) }
                // The trait's return instance is named nowhere else.
                preq.ret.register_returned_instance(_span, ctx)
                return preq.ret
            }
        }
        // An unbounded associated type promises nothing.
        val plab_msg = "no method `${method_name}` on associated type `${member.as_string()}` (give it a bound whose trait provides it: `type ${member.as_string()}: SomeTrait`)"
        ctx.emit(new_diagnostic(Severity.Error, new_label(_span, plab_msg)))
        return Type.new_poison()
    }
    // String takes the ordinary struct path.
    val rtag = recv_ty.kind.kind_tag()
    // `str` methods mangle as `str_<method>`; `equals` coerces its argument
    // to `str`.
    val is_str = rtag == TAG_STR()
    if is_str {
        if method_name.as_str().equals("equals") {
            if args.size() != 1 { emit_method_arity(method_name, 1, args.size(), _span, ctx); return Type.new_poison() }
            if !check_method_arg(args, &arg_tys, 0, Type.new_str(_span), method_name, _span, ctx) {
                return Type.new_poison()
            }
            return Type.new_bool(_span)
        }
        if method_name.as_str().equals("as_str") {
            if args.size() != 0 { emit_method_arity(method_name, 0, args.size(), _span, ctx); return Type.new_poison() }
            return Type.new_str(_span)
        }
        val ret = trait_method_ret(recv_ty, method_name.clone(), args, _span, ctx, call)
        if !ret.is_poison() { return ret }
        emit_no_such_method("str", method_name, _span, call.name_span, ctx)
        return Type.new_poison()
    }
    // A trait implemented for a primitive resolves like a struct's.
    val is_prim = recv_ty.kind.is_primitive_kind()
    if is_prim {
        val prim_ret = trait_method_ret(recv_ty, method_name.clone(), args, _span, ctx, call)
        if !prim_ret.is_poison() { return prim_ret }
        recv_ty.borrow_intrinsic_method_operand(method_name.as_str(), args, ctx)
        // A trait declares it but no impl accepts these arguments.
        if receiver_declares_trait_method(recv_ty, method_name.clone(), ctx) {
            val amsg = call.no_fitting_impl_message(recv_ty, method_name.clone(), args, ctx)
            ctx.emit(new_diagnostic(Severity.Error, new_label(_span, amsg)))
            return Type.new_poison()
        }
    }
    // Nothing claims this method on a primitive: reported. A `Ptr<T>` arrives
    // here as its pointee.
    if is_prim {
        if !primitive_intrinsic_method(method_name.as_str()) {
            emit_no_such_method(recv_ty.display_type(ctx), method_name.clone(), _span, call.name_span, ctx)
        }
        return Type.new_poison()
    }
    val tag = recv_ty.kind.kind_tag()
    // Enums are impl targets too.
    if tag != TAG_STRUCT() && tag != TAG_ENUM() { return Type.new_poison() }
    val sname = recv_ty.kind.nominal_name()
    // An imported method resolves by symbol; this is its evidence.
    var has_link: bool = false
    when (recv_ty.kind) {
        Struct(identity) => {
            val link_name = unsafe { (*ctx.sigs).lookup_method_link(identity, method_name.as_str()) }
            if !link_name.as_str().equals("") {
                call.mangled_callee = link_name
                has_link = true
            }
        }
        EnumTy(identity) => {
            val link_name = unsafe { (*ctx.sigs).lookup_method_link(identity, method_name.as_str()) }
            if !link_name.as_str().equals("") {
                call.mangled_callee = link_name
                has_link = true
            }
        }
        _ => {}
    }
    // List container methods are resolved here, since the concrete impl is not
    // materialized yet: `get` -> element, `at`/`at_mut` -> `&`/`&var` element,
    // `size` -> uint64, `push`/`set` -> void.
    val is_list = name_starts_with(sname, "List__")
    if is_list {
        // The element fragment after "List__".
        val elem_frag = mangle_suffix(sname, 6)
        when method_name.as_str() {
            "get" => {
                if args.size() != 1 {
                    emit_method_arity(method_name, 1, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                // Typed without the signature, so `impl List<T: Copy>`'s bound is checked here.
                val bindings = recv_bindings_for_method(sname.clone(), _span, ctx)
                check_recv_bounds(sname.clone(), method_name.clone(), &bindings, _span, ctx)
                return ty_from_frag_in_scope(elem_frag, _span, ctx)
            }
            // A shared borrow, read in place.
            "at" => {
                if args.size() != 1 {
                    emit_method_arity(method_name, 1, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                val elem_ty = ty_from_frag_in_scope(elem_frag, _span, ctx)
                val inner = type_node(elem_ty)
                return Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Inferred(_span) }
            }
            // A mutable borrow, mutated in place.
            "at_mut" => {
                if args.size() != 1 {
                    emit_method_arity(method_name, 1, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                val elem_ty = ty_from_frag_in_scope(elem_frag, _span, ctx)
                val inner = type_node(elem_ty)
                return Type { kind: TypeKind.RefTo(true, inner), provenance: Provenance.Inferred(_span) }
            }
            "size" => {
                if args.size() != 0 {
                    emit_method_arity(method_name, 0, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                return Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(_span) }
            }
            "is_empty" => {
                if args.size() != 0 {
                    emit_method_arity(method_name, 0, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                return Type.new_bool(_span)
            }
            // Items are expected as the element type.
            "push" => {
                if args.size() != 1 {
                    emit_method_arity(method_name, 1, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                val pushed = ty_from_frag_in_scope(elem_frag.clone(), _span, ctx)
                if call.receiver_still_open(ctx) { return Type.new_void(_span) }
                if args.at(0).reject_kept_temporary(&pushed, method_name.as_str(), ctx) { return Type.new_poison() }
                if !check_method_arg(args, &arg_tys, 0, pushed, method_name, _span, ctx) { return Type.new_poison() }
                return Type.new_void(_span)
            }
            "set" => {
                if args.size() != 2 {
                    emit_method_arity(method_name, 2, args.size(), _span, ctx)
                    return Type.new_poison()
                }
                val stored = ty_from_frag_in_scope(elem_frag.clone(), _span, ctx)
                if call.receiver_still_open(ctx) { return Type.new_void(_span) }
                if args.at(1).reject_kept_temporary(&stored, method_name.as_str(), ctx) { return Type.new_poison() }
                if !check_method_arg(args, &arg_tys, 1, stored, method_name, _span, ctx) { return Type.new_poison() }
                return Type.new_void(_span)
            }
            _ => { }
        }
    }
    val mangled = sname + String.from("_") + method_name
    val found_sig = unsafe { (*ctx.sigs).find_signature(mangled.as_str()) }
    if found_sig.is_none() {
        // A method on a monomorphized generic: looked up under the template's
        // name with the receiver's arguments substituted
        // (`List<T>.iter(): ListIter<T>` on `List__int32`).
        val base = mangle_base_name(sname.clone())
        val base_len = base.as_str().byte_len()
        val name_len = sname.as_str().byte_len()
        if base_len < name_len {
            val binding = recv_bindings_for_method(sname.clone(), _span, ctx)
            if binding.recv_is_instance() {
                val bmangled = base + String.from("_") + method_name
                when (unsafe { (*ctx.sigs).find_signature(bmangled.as_str()) }) {
                    Some(bsig) => {
                        if !bsig.is_static {
                            if args.size() + 1 == bsig.params.size() {
                                // The method's own parameters (`fun map<F>`) are
                                // solved from the call.
                                note_import_use(ctx.sigs, ctx.owner_file, bsig.owner_module)
                                return bsig.check_method_generics(&binding, sname.clone(), method_name.clone(), args, &arg_tys, call, _span, ctx)
                            } else {
                                emit_method_arity(method_name, bsig.params.size() - 1, args.size(), _span, ctx)
                                return Type.new_poison()
                            }
                        }
                    }
                    None => { }
                }
            }
        }
        // Every struct is deep-cloneable, so `x.clone()` is `Self`.
        if method_name.as_str().equals("clone") && args.size() == 0 { return recv_ty }
        // A trait impl's method, not keyed in the sig table.
        val struct_trait_ret = trait_method_ret(recv_ty, method_name.clone(), args, _span, ctx, call)
        if !struct_trait_ret.is_poison() { return struct_trait_ret }
        // Nothing claims this method.
        if has_link { return Type.new_poison() }
        // A trait declares it but no impl accepts these arguments: the call is
        // at fault, not the impl.
        if receiver_declares_trait_method(recv_ty, method_name.clone(), ctx) {
            val amsg = call.no_fitting_impl_message(recv_ty, method_name.clone(), args, ctx)
            ctx.emit(new_diagnostic(Severity.Error, new_label(_span, amsg)))
            return Type.new_poison()
        }
        emit_no_such_method(sname.clone(), method_name.clone(), _span, call.name_span, ctx)
        return Type.new_poison()
    }
    val sig = found_sig ?: return Type.new_poison()
    note_import_use(ctx.sigs, ctx.owner_file, sig.owner_module)
    if sig.is_static {
        val lab = new_label(_span, String.from("static function called on a value; call it as Type.method(...)"))
        ctx.emit(new_diagnostic(Severity.Error, lab))
        return Type.new_poison()
    }
    // `self` is params[0].
    if args.size() + 1 != sig.params.size() {
        emit_method_arity(method_name, sig.params.size() - 1, args.size(), _span, ctx)
        return Type.new_poison()
    }
    // The receiver pins nothing, so only the method's own parameters remain.
    return sig.check_method_generics(&empty_recv_binding(), sname.clone(), method_name.clone(), args, &arg_tys, call, _span, ctx)
}

/// An exact match, which `nearest_method` excludes on purpose: it tells a
/// missing `()` from a typo. Scanned with `method_of`, so trait methods count;
/// a monomorphized receiver falls back to its base.
fun type_has_method_named(type_name: str, wanted: str, ctx: &var TypeCtx): bool {
    if type_has_method_of(type_name, wanted, ctx) { return true }
    val base = mangle_base_name(String.from(type_name))
    if base.as_str().equals(type_name) { return false }
    return type_has_method_of(base.as_str(), wanted, ctx)
}

fun type_has_method_of(owner: str, wanted: str, ctx: &var TypeCtx): bool {
    var prefix = String.from(owner)
    prefix.append("_")
    val sigs = unsafe { (*ctx.sigs).sigs }
    while sig in &sigs {
        if method_of(sig.name.as_str(), prefix.as_str()).as_str().equals(wanted) { return true }
    }
    return false
}
