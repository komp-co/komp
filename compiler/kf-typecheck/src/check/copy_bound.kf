// Whether a type satisfies `Copy`, judged structurally: the builtin wrappers
// have no impl to find, and an instance must meet its impl's own bounds.

import alloc.list.*

import kf_core.ast.*
import kf_core.span.no_span

/// Whether a value of type `ty` may be duplicated by copying its bytes. Poison
/// and projections answer yes: the first was reported, the second is decided
/// after monomorphization.
pub fun Type.type_is_copy(ctx: &var TypeCtx): bool {
    val copy_name = ctx.lang_trait_name(lang_copy_key())
    return when (self.kind) {
        PtrTo(_) => true
        RefTo(mutable, _) => !mutable
        BoxOf(_) => false
        FnTy(_) => true
        TraitTy(_) => false
        DynTraitTy(_) => false
        Void => true
        Never => true
        Poison => true
        Projection(_, _) => true
        Generic(name) => owner_has_bound(ctx.fn_owner.clone(), name.as_string(), copy_name.as_string(), ctx)
        ArrayOf(_element, _length) => self.array_element().type_is_copy(ctx)
        _ => self.bound_type_implements(copy_name.as_str(), ctx.sigs) &&
            self.instance_args_meet(copy_name.as_str(), no_span(), ctx)
    }
}
