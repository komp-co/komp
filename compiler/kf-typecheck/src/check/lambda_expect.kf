// An unannotated lambda parameter takes its type from the `Call` bound of the
// parameter it is passed to: `xs.map(|x| x * 2)` on `List__int32` expects
// `Call1<int32>`.
//
// CONSTRAINT: before the lambda is checked, since its impl must state a
// concrete type. Written to the node's `type_args`, not its parameter list,
// which a `when` holds by value.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_typecheck.types.*
import kf_typecheck.*

fun Expr.lambda_wants_expectation(): bool {
    when (self.kind) {
        Lambda(params, _body) => {
            while param in &params {
                if unsafe { (param.ty as uint64) == 0 } { return true }
            }
            return false
        }
        _ => return false
    }
}

fun Expr.lambda_param_count(): uint64 {
    return when (self.kind) {
        Lambda(params, _body) => params.size()
        _ => 0
    }
}

/// `F: Call1<T>` on `impl List<T>`'s `map`, reached on `List__int32`, answers
/// `[int32]`. Empty without such a bound.
fun call_bound_arg_types(owner: String, param: String, recv: &RecvBinding, span: Span, ctx: &var TypeCtx): List<Type> {
    var out = List.new<Type>()
    val sp = ctx.sigs
    val nb = unsafe { sp.bounds.size() }
    var i = 0
    while i < nb {
        val b = unsafe { *sp.bounds.at(i) }
        if b.owner.as_str().equals(owner.as_str()) {
            if b.param.as_str().equals(param.as_str()) {
                // Only the `Call` family describes a parameter list.
                if name_starts_with(b.trait_name.clone(), "Call") {
                    while arg_name in &b.arg_names {
                        out.push(bound_arg_type(arg_name, recv, span, ctx))
                    }
                    return out
                }
            }
        }
        i = i + 1
    }
    return out
}

/// An impl parameter the receiver pinned, or a named type.
fun bound_arg_type(name: String, recv: &RecvBinding, span: Span, ctx: &var TypeCtx): Type {
    // `Call1<&T>` keys as `kf__ref__T`: peeled first.
    val borrowed = ref_key_inner(name.as_str())
    if !borrowed.as_str().equals("") {
        val is_mut = ref_key_is_mut(name.as_str())
        val inner: Ptr<Type> = unsafe { alloc<Type>() }
        unsafe { *inner = bound_arg_type(borrowed, recv, span, ctx) }
        return Type { kind: TypeKind.RefTo(is_mut, inner), provenance: Provenance.Inferred(span) }
    }
    var i = 0
    while i < recv.names.size() {
        if recv.names.at(i).as_str().equals(name.as_str()) {
            if i < recv.types.size() { return *recv.types.at(i) }
        }
        i = i + 1
    }
    return (new_type_ref(span, TypeRefKind.Named(intern(name.as_str()), List.new<TypeRef>()))).resolve_type_ref(ctx)
}

/// `self_offset` is 1 for a method, 0 for a free function. What `recv` leaves
/// open is solved from the other arguments (`fold(0, |a, x| a + x)`). Each
/// step fails silently, leaving check_lambda to report the missing
/// annotation.
fun expect_lambdas_against(bound_owner: String, sig: &FnSignature, recv: &RecvBinding, self_offset: uint64, args: &var List<Expr>, arg_tys: &var List<Type>, span: Span, ctx: &var TypeCtx): void {
    var pending = false
    while item in &args {
        if item.lambda_wants_expectation() { pending = true }
    }
    if !pending { return }
    // A lambda's own slot is poison here and binds nothing.
    var gnames = List.new<String>()
    var gtypes = List.new<Type>()
    var r0 = 0
    while r0 < recv.names.size() {
        gnames.push(*recv.names.at(r0))
        if r0 < recv.types.size() { gtypes.push(*recv.types.at(r0)) }
        r0 = r0 + 1
    }
    while gname in &sig.generics {
        if !str_name_in(&gnames, gname.as_str()) {
            var bound = poison_ty()
            while k in 0..arg_tys.size() {
                if k + self_offset < sig.params.size() {
                    val at0 = *arg_tys.at(k)
                    if !at0.is_poison() {
                        val sp = subst_recv(*sig.params.at(k + self_offset), recv)
                        val cand = sp.bind_generic_from_param(&at0, gname.as_str(), ctx)
                        if !cand.is_poison() {
                            bound = cand
                            break
                        }
                    }
                }
            }
            gnames.push(gname)
            gtypes.push(bound)
        }
    }
    val binding = RecvBinding { names: gnames, types: gtypes }
    while i in 0..args.size() {
        val arg = args.at_mut(i)
        if arg.lambda_wants_expectation() {
            if i + self_offset < sig.params.size() {
                val expected = *sig.params.at(i + self_offset)
                if expected.kind.kind_tag() == TAG_GENERIC() {
                    val ptys = call_bound_arg_types(bound_owner.clone(), expected.kind.generic_name(), &binding, span, ctx)
                    if ptys.size() == arg.lambda_param_count() {
                        arg.stamp_lambda_expectation(&ptys, span)
                    }
                }
            }
            // Checked either way. Through check_call_argument, which marks it
            // as an argument.
            arg.check_call_argument(ctx)
            arg_tys.set(i, arg.ty.clone())
        }
    }
}

fun str_name_in(xs: &List<String>, target: str): bool {
    while item in &xs {
        if item.as_str().equals(target) { return true }
    }
    return false
}

/// A method's signature, the owner its bounds are keyed under, and the
/// receiver's bindings of the impl's parameters.
struct MethodLambdaSite {
    val bound_owner: String
    val sig: FnSignature
    val binding: RecvBinding
}

fun method_lambda_site(receiver_ty: Type, method_name: String, span: Span, ctx: &var TypeCtx): MethodLambdaSite? {
    if receiver_ty.is_poison() { return null }
    val recv_ty = autoderef_ty(receiver_ty)
    if recv_ty.kind.kind_tag() != TAG_STRUCT() { return null }
    val sname = recv_ty.kind.struct_name()
    // A generic receiver's methods are registered under the template name.
    var owner_type = sname.clone()
    var sig_name = sname.clone() + String.from("_") + method_name.clone()
    var found = unsafe { (*ctx.sigs).find_signature(sig_name.as_str()) }
    if found.is_none() {
        owner_type = mangle_base_name(sname.clone())
        sig_name = owner_type.clone() + String.from("_") + method_name.clone()
        found = unsafe { (*ctx.sigs).find_signature(sig_name.as_str()) }
    }
    val sig = found ?: return null
    val binding = recv_type_bindings(sname.clone(), span, ctx)
    return MethodLambdaSite { bound_owner: owner_type + String.from("_") + method_name, sig: sig, binding: binding }
}

/// The receiver pins the impl's parameters first.
pub fun expect_lambda_args(
    receiver_ty: Type,
    method_name: String,
    args: &var List<Expr>,
    arg_tys: &var List<Type>,
    span: Span,
    ctx: &var TypeCtx
): void {
    val site = method_lambda_site(receiver_ty, method_name, span, ctx) ?: return
    expect_lambdas_against(site.bound_owner.clone(), &site.sig, &site.binding, 1, args, arg_tys, span, ctx)
}

/// CONSTRAINT: before the arguments are checked, which turns each lambda
/// into its closure and loses the written parameter types.
pub fun report_annotated_lambda_args(receiver_ty: Type, method_name: String, args: &List<Expr>, span: Span,
    ctx: &var TypeCtx): void {
    val site = method_lambda_site(receiver_ty, method_name, span, ctx) ?: return
    report_annotated_against(site.bound_owner.clone(), &site.sig, &site.binding, 1, args, span, ctx)
}

/// As `report_annotated_lambda_args`, for a free function.
pub fun report_annotated_lambda_call_args(fn_name: String, args: &List<Expr>, span: Span, ctx: &var TypeCtx): void {
    val sigs = ctx.sigs
    val found = unsafe { (*sigs).find_imported_signature(fn_name.as_str(), ctx.owner_file, ctx.owner_crate, ctx.owner_module) }
    val sig = found ?: return
    report_annotated_against(fn_name, &sig, &empty_recv_binding(), 0, args, span, ctx)
}

fun report_annotated_against(
    bound_owner: String,
    sig: &FnSignature,
    recv: &RecvBinding,
    self_offset: uint64,
    args: &List<Expr>,
    span: Span,
    ctx: &var TypeCtx
): void {
    while i in 0..args.size() {
        val arg = args.at(i)
        if arg.lambda_param_count() == 0 || arg.lambda_wants_expectation() { continue }
        if i + self_offset >= sig.params.size() { continue }
        val expected = *sig.params.at(i + self_offset)
        if expected.kind.kind_tag() != TAG_GENERIC() { continue }
        val ptys = call_bound_arg_types(bound_owner.clone(), expected.kind.generic_name(), recv, span, ctx)
        var open = sig.generics.clone()
        while name in &recv.names { open.push(name.clone()) }
        arg.report_written_params_against(&ptys, &open, ctx)
    }
}

/// Every type parameter comes from the other arguments.
pub fun expect_lambda_call_args(fn_name: String, sig: &FnSignature, args: &var List<Expr>, arg_tys: &var List<Type>, span: Span, ctx: &var TypeCtx): void {
    expect_lambdas_against(fn_name, sig, &empty_recv_binding(), 0, args, arg_tys, span, ctx)
}

/// A type with no written form is dropped; the arity check then reports.
mutating fun Expr.stamp_lambda_expectation(arg_tys: &List<Type>, span: Span): void {
    var trefs = List.new<TypeRef>()
    while arg_ty in &arg_tys {
        val tr = arg_ty.type_to_type_ref(span)
        if tr.type_ref_is_poison() { return }
        trefs.push(tr)
    }
    self.type_args = trefs
}
