import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.*

/// `Option__int32`, with `Option`'s impl of Clone bounding its parameter by
/// `bound` ("" for none). No impl of Clone for `int32` is registered here.
fun ctx_with_option_of_int32(bound: str): TypeCtx {
    var ctx = mk_ctx()
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    val inst = GenericInst { mangled: String.from("Option__int32"), base: String.from("Option"), args: args }
    unsafe { ctx.sigs.insert_inst(inst) }
    var bounds = List.new<String>()
    bounds.push(String.from(bound))
    val record = ImplParamBounds { type_name: String.from("Option"), trait_name: String.from("Clone"), bounds: bounds }
    unsafe { ctx.sigs.impl_param_bounds.push(record) }
    return ctx
}

fun option_of_int32(): Type {
    return Type { kind: TypeKind.Struct(intern("Option__int32")), provenance: Provenance.Inferred(no_span()) }
}

@test fun an_argument_missing_the_impls_bound_fails(): void {
    var ctx = ctx_with_option_of_int32("Clone")
    val meets = option_of_int32().instance_args_meet("Clone", no_span(), &var ctx)
    assert_eq(meets, false, "int32 is not Clone in these tables")
}

@test fun an_unbounded_impl_parameter_passes(): void {
    var ctx = ctx_with_option_of_int32("")
    assert_eq(option_of_int32().instance_args_meet("Clone", no_span(), &var ctx), true, "the impl asks nothing of T")
}

@test fun a_type_that_is_no_instance_passes(): void {
    var ctx = ctx_with_option_of_int32("Clone")
    val plain = Type { kind: TypeKind.Struct(intern("Plain")), provenance: Provenance.Inferred(no_span()) }
    assert_eq(plain.instance_args_meet("Clone", no_span(), &var ctx), true, "there are no arguments to judge")
}
