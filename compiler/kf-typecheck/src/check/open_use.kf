// A use of a binding whose type is still open, needing a type of its own:
// the binding becomes it, or conflicts with the use that decided it first.

import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.span.Span
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type
import kf_typecheck.types.type_eq

/// After earlier uses, which saw the provisional type, `ty` decides the binding
/// for the body's next check; true when it did. At the first use, or when
/// `ty` is the provisional type, the caller retypes in place instead.
mutating fun Expr.decides_on_recheck(init: Span, ty: Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    if ctx.binding_uses(name.as_str()) <= 1 || self.ty.type_eq(ty) { return false }
    ctx.decide_binding_on_recheck(name.as_str(), init, ty.clone(), self.span)
    self.ty = ty
    return true
}

/// A use needing another type than an earlier use decided: reported with
/// both, and true. False when the binding was never open.
mutating fun Expr.conflicts_with_decision(expected: Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    val decided_at = ctx.binding_decided_at(name.as_str())
    if decided_at.is_none() || self.ty.is_poison() || self.ty.type_eq(expected) { return false }
    val decided = self.ty.display_type(ctx)
    val message = "`${name}` is `${decided}`, as an earlier use decided, " +
        "but this use expects `${expected.display_type(ctx)}`"
    var diagnostic = new_diagnostic(Severity.Error, new_label(self.span, message))
    diagnostic.secondary.push(new_label(decided_at, "decided `${decided}` here"))
    ctx.emit(diagnostic)
    self.ty = Type.new_poison()
    return true
}

/// The binding this initializer starts, declared as the type an earlier check
/// of the body decided for it, if there was one.
mutating fun Expr.declares_decided(name: String, mutable: bool, ctx: &var TypeCtx): bool {
    val preset = ctx.preset_for(self.span) ?: return false
    if !self.expect_or_reject(preset.ty.clone(), ctx) && !self.ty.is_poison() {
        val message = "this initializer cannot be `${preset.ty.display_type(ctx)}`, which a use of `${name}` needs"
        var diagnostic = new_diagnostic(Severity.Error, new_label(self.span, message))
        diagnostic.secondary.push(new_label(preset.decided_at, "needed here"))
        ctx.emit(diagnostic)
    }
    ctx.declare_decided(name, &preset, mutable)
    return true
}

/// The binding's type once `value` is stored into it: an open binding takes a
/// typed value's type, as a read in that slot would.
mutating fun TypeCtx.decide_by_store(name: str, value: &Expr, span: Span, target: Type): Type {
    if value.ty.type_eq(target) || value.operand_takes_other_type(self) { return target }
    var place = Expr.new(span, ExprKind.Variable(intern(name)))
    place.ty = target.clone()
    if is_numeric(value.ty) {
        if !place.narrow_open_number(value.ty.clone(), self) { return target }
    } else if place.narrow_open_text(value.ty.clone(), self) || place.narrow_open_array(value.ty.clone(), self) {
        return target
    }
    return self.lookup(name)
}

/// A type an earlier use ruled out: it needed the binding as `needed`, which
/// `target` is not. True when reported.
mutating fun Expr.conflicts_with_narrowing(target: &Type, needed: str, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    val narrowed_at = ctx.binding_narrowed_at(name.as_str())
    if narrowed_at.is_none() { return false }
    val shown = target.display_type(ctx)
    val message = "`${name}` cannot be `${shown}` here: an earlier use needs it as ${needed}, which `${shown}` is not"
    var diagnostic = new_diagnostic(Severity.Error, new_label(self.span, message))
    diagnostic.secondary.push(new_label(narrowed_at, "used as ${needed} here"))
    ctx.emit(diagnostic)
    self.ty = Type.new_poison()
    return true
}
