// A function named where a value is wanted, and a call through such a value.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.FnParts
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.check.borrow.coerce_call_arg
import kf_typecheck.check.borrow.type_is_borrow
import kf_typecheck.note_import_use_named

/// True when `name` is a function this file may call, which makes `self` a
/// `FnRef` to it. A generic function is reported, since a value has one type.
pub mutating fun Expr.name_function_value(name: Sym, ctx: &var TypeCtx): bool {
    val sigs = unsafe { &*ctx.sigs }
    val sig = sigs.lookup_callee(name.as_str(), Sym { id: 0 }, ctx.owner_file, ctx.owner_crate,
        ctx.owner_module) ?: return false
    note_import_use_named(ctx.sigs, ctx.owner_file, sig.owner_module, name)
    if sig.generics.size() > 0 {
        val message = "generic function `${name.as_str()}` cannot be used as a value: a function value has one type"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        self.ty = Type.new_poison()
        return true
    }
    val real = if sig.name.as_str().equals(name.as_str()) { name } else { intern(sig.name.as_str()) }
    self.kind = ExprKind.FnRef(real)
    val pinned = sigs.pinned_link_name(&sig)
    if pinned.byte_len() > 0 { self.mangled_callee = intern(pinned.as_str()) }
    var params = List.new<Type>()
    while param in &sig.params {
        params.push(param)
    }
    self.ty = Type.new_fn(params, sig.ret, Provenance.Inferred(self.span))
    ctx.note_fn_type(&self.ty)
    return true
}

/// A local holding a function value, or a borrow of one.
pub fun Sym.local_is_function_value(ctx: &var TypeCtx): bool {
    if !ctx.is_declared(self.as_str()) { return false }
    return ctx.lookup(self.as_str()).through_borrow().fn_parts() != null
}

/// `recv.name(args)` on a receiver with no method `name` but a field of that
/// name holding a function value becomes a call through the field. `recv` is
/// already checked.
pub mutating fun Expr.call_through_field(recv_ptr: Ptr<Expr>, recv_ty: Type, name: Sym, args: &var List<Expr>,
    ctx: &var TypeCtx): bool {
    val owner = autoderef_ty(recv_ty)
    if owner.kind.kind_tag() != TAG_STRUCT() { return false }
    val type_name = owner.kind.struct_name()
    if type_has_method_named(type_name.as_str(), name.as_str(), ctx) { return false }
    val was_quiet = ctx.quiet
    ctx.quiet = true
    val field_ty = check_field_access(recv_ty, name.as_string(), self.span, ctx)
    ctx.quiet = was_quiet
    if field_ty.through_borrow().fn_parts() == null { return false }
    var field = Expr.new(self.span, ExprKind.FieldAccess(recv_ptr, name))
    field.ty = field_ty
    val callee = Box.new(field)
    self.ty = self.call_through(callee, args, ctx)
    self.kind = ExprKind.CallValue(callee, args.clone())
    return true
}

/// `callee(args)` through a function value, which may be borrowed.
pub mutating fun Expr.check_call_value(callee_ptr: Box<Expr>, args: &var List<Expr>, ctx: &var TypeCtx): Type {
    check_expr(&var *callee_ptr, ctx)
    return self.call_through(callee_ptr, args, ctx)
}

/// The call's type, with `callee_ptr` already checked.
mutating fun Expr.call_through(callee_ptr: Box<Expr>, args: &var List<Expr>, ctx: &var TypeCtx): Type {
    val callee_ty = callee_ptr.ty
    if callee_ty.is_poison() { return Type.new_poison() }
    val parts = callee_ty.through_borrow().fn_parts() ?: return Type.new_poison()
    if callee_ty.type_is_borrow() {
        val span = callee_ptr.span
        var through = Expr.new(span, ExprKind.Deref(Box.new(*callee_ptr)))
        through.ty = parts_type(&parts, span)
        *callee_ptr = through
    }
    val arg_tys = type_call_arguments(args, ctx)
    if args.size() != parts.params.size() {
        val counts = "expected ${parts.params.size()}, found ${args.size()}"
        val message = "wrong number of arguments to a function value: ${counts}"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        return Type.new_poison()
    }
    var saw_error = false
    while j in 0..args.size() {
        val expected = *parts.params.at(j)
        val outcome = coerce_call_arg(args, j, expected.clone(), ctx)
        val found = if arg_tys.at(j).is_poison() { Type.new_poison() } else { args.at(j).ty.clone() }
        if !outcome.valid {
            saw_error = true
        } else if !outcome.coerced && !found.type_eq(expected) && !ctx.fits(found, expected) {
            saw_error = true
            val types = "expected `${expected.display_type(ctx)}`, found `${found.display_type(ctx)}`"
            val message = "wrong type for argument ${j + 1} of a function value: ${types}"
            ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        }
    }
    if saw_error { return Type.new_poison() }
    return parts.ret
}

fun parts_type(parts: &FnParts, span: Span): Type {
    var params = List.new<Type>()
    while param in &parts.params {
        params.push(param)
    }
    return Type.new_fn(params, parts.ret, Provenance.Inferred(span))
}
