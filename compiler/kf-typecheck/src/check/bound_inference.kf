// A type parameter only a bound mentions, inferred through the bound:
// `fun count<C: Iterable<T>, T>(c: &C)` with `xs: List<int32>` binds `C` to
// `List<int32>`, whose `Iterable<T> for List<T>` impl makes `T` `int32`.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.lang_copy_key
import kf_core.ast.types.*
import kf_typecheck.types.type_eq
import kf_typecheck.types.nominal_name
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.mangle_type
import kf_typecheck.types.type_ref_is_poison
import kf_typecheck.traits.key_segments
import kf_typecheck.traits.trait_args_satisfy
import kf_typecheck.traits.trait_arg_segments

/// Binds in place each unbound parameter a bound determines, repeating while
/// bindings appear (`A: Tr<B>, B: Tr<C>`).
pub fun infer_from_bounds(callee: str, gnames: &List<String>, inf_tys: &var List<Type>, span: Span,
    ctx: &var TypeCtx): void {
    val bounds = unsafe { (*ctx.sigs).bounds }
    var progress = true
    while progress {
        progress = false
        while b in &bounds {
            if !b.owner.as_str().equals(callee) { continue }
            val bound_at = name_index(gnames, b.param.as_str())
            if bound_at >= inf_tys.size() || inf_tys.at(bound_at).is_poison() { continue }
            val wanted = key_segments(b.trait_args.as_str())
            if !mentions_unbound(&wanted, gnames, inf_tys) { continue }
            val self_ty = inf_tys.at(bound_at)
            val impl_args = impl_trait_arg_types(self_ty, b.trait_name.as_str(), &wanted, gnames, inf_tys, span, ctx)
            if impl_args.size() != wanted.size() { continue }
            while k in 0..wanted.size() {
                val g = name_index(gnames, wanted.at(k).as_str())
                if g < inf_tys.size() && inf_tys.at(g).is_poison() {
                    inf_tys.set(g, impl_args.at(k).clone())
                    progress = true
                }
            }
        }
    }
}

/// The trait arguments of the single impl of `trait_name` for `self_ty`
/// agreeing with `wanted` where known; empty for none or several.
fun impl_trait_arg_types(self_ty: &Type, trait_name: str, wanted: &List<String>, gnames: &List<String>,
    inf_tys: &List<Type>, span: Span, ctx: &var TypeCtx): List<Type> {
    val have = autoderef_ty(self_ty.clone())
    val base = have.ty_base_name()
    val impls = unsafe { (*ctx.sigs).trait_impls }
    var found = List.new<Type>()
    var fits: uint64 = 0
    while ti in &impls {
        if !ti.type_name.as_str().equals(base.as_str()) || !ti.trait_name.as_str().equals(trait_name) { continue }
        val segs = trait_arg_segments(ti.trait_args.as_str(), ti.arg_count)
        if segs.size() != wanted.size() { continue }
        val impl_params = key_segments(ti.generics.as_str())
        var args = List.new<Type>()
        var agrees = true
        while k in 0..segs.size() {
            val arg = impl_segment_type(segs.at(k).as_str(), &impl_params, &have, span, ctx)
            if arg.is_poison() { agrees = false }
            val g = name_index(gnames, wanted.at(k).as_str())
            if g < inf_tys.size() {
                val known = *inf_tys.at(g)
                if !known.is_poison() && !known.type_eq(&arg) { agrees = false }
            } else if !type_eq(&ty_from_frag_in_scope(*wanted.at(k), span, ctx), &arg) {
                agrees = false
            }
            args.push(arg)
        }
        if agrees {
            fits = fits + 1
            found = args
        }
    }
    if fits != 1 { return List.new<Type>() }
    return found
}

/// A segment naming an impl parameter takes the receiver's argument there;
/// a compound segment (`Entry__K__V`) resolves each parameter it names.
fun impl_segment_type(seg: str, impl_params: &List<String>, receiver: &Type, span: Span, ctx: &var TypeCtx): Type {
    val at = name_index(impl_params, seg)
    if at >= impl_params.size() {
        if seg.contains("__") { return compound_segment_type(seg, impl_params, receiver, span, ctx) }
        return ty_from_frag_in_scope(String.from(seg), span, ctx)
    }
    val name = receiver.kind.nominal_name()
    val inst = unsafe { (*ctx.sigs).find_inst(name.as_str()) } ?: return Type.new_poison()
    if inst.args.size() != impl_params.size() { return Type.new_poison() }
    return (*inst.args.at(at)).resolve_type_ref(ctx)
}

/// Rebuilds a compound segment (`Entry__K__V`) concretely and registers it as
/// a `GenericInst`, since `ty_written_ref` can only spell a mono-suffixed struct
/// from that registry, and the all-or-nothing write-back would drop every
/// binding otherwise.
fun compound_segment_type(seg: str, impl_params: &List<String>, receiver: &Type, span: Span, ctx: &var TypeCtx): Type {
    val parts = key_segments(seg)
    if parts.size() == 0 { return Type.new_poison() }
    val base_name = *parts.at(0)
    var mangled = base_name.clone()
    var arg_refs = List.new<TypeRef>()
    var i: uint64 = 1
    while i < parts.size() {
        val part = *parts.at(i)
        var resolved = Type.new_poison()
        if name_index(impl_params, part.as_str()) < impl_params.size() {
            resolved = impl_segment_type(part.as_str(), impl_params, receiver, span, ctx)
        } else {
            resolved = ty_from_frag_in_scope(part.clone(), span, ctx)
        }
        if resolved.is_poison() { return Type.new_poison() }
        val tr = resolved.ty_written_ref(span, ctx.sigs)
        if tr.type_ref_is_poison() { return Type.new_poison() }
        arg_refs.push(tr)
        mangled.append("__")
        mangled.append(mangle_type(resolved).as_str())
        i = i + 1
    }
    unsafe { ctx.sigs.insert_inst(GenericInst { mangled: mangled.clone(), base: base_name, args: arg_refs }) }
    return Type { kind: TypeKind.Struct(intern(mangled.as_str())), provenance: Provenance.Inferred(span) }
}

fun mentions_unbound(segs: &List<String>, gnames: &List<String>, inf_tys: &List<Type>): bool {
    while seg in &segs {
        val g = name_index(gnames, seg.as_str())
        if g < inf_tys.size() && inf_tys.at(g).is_poison() { return true }
    }
    return false
}

/// `names.size()` when absent.
fun name_index(names: &List<String>, name: str): uint64 {
    while i in 0..names.size() {
        if names.at(i).as_str().equals(name) { return i }
    }
    return names.size()
}

/// An argument naming a still-unbound parameter in `free` accepts anything.
pub fun bound_type_implements_here(bound_ty: &Type, trait_name: str, args: String, free: &List<String>, span: Span,
    ctx: &var TypeCtx): bool {
    if trait_name.equals(ctx.lang_trait_name(lang_copy_key()).as_str()) { return bound_ty.type_is_copy(ctx) }
    if !bound_ty.bound_type_implements(trait_name, ctx.sigs) { return false }
    if !impl_args_agree(bound_ty, trait_name, args.as_str(), free, span, ctx) { return false }
    return bound_ty.instance_args_meet(trait_name, span, ctx)
}

/// The impl's arguments, with its parameters taking the receiver's, agree
/// with `args_key`; otherwise `impl Iterable<T> for List<T>` would pass for
/// `Iterable<Point>` on `List<int32>`. True when undecidable here.
fun impl_args_agree(bound_ty: &Type, trait_name: str, args_key: str, free: &List<String>, span: Span,
    ctx: &var TypeCtx): bool {
    val have = autoderef_ty(bound_ty.clone())
    val base = have.ty_base_name()
    val wanted = key_segments(args_key)
    val impls = unsafe { (*ctx.sigs).trait_impls }
    var any = false
    while ti in &impls {
        if !ti.type_name.as_str().equals(base.as_str()) || !ti.trait_name.as_str().equals(trait_name) { continue }
        if !trait_args_satisfy(args_key, ti.trait_args.as_str(), ti.generics.as_str(), ti.arg_count, free) { continue }
        any = true
        val segs = trait_arg_segments(ti.trait_args.as_str(), ti.arg_count)
        val impl_params = key_segments(ti.generics.as_str())
        if segs.size() != wanted.size() { return true }
        var agrees = true
        while k in 0..segs.size() {
            val open = name_index(free, wanted.at(k).as_str()) < free.size()
            if !open && name_index(&impl_params, segs.at(k).as_str()) < impl_params.size() {
                val arg = impl_segment_type(segs.at(k).as_str(), &impl_params, &have, span, ctx)
                val want = ty_from_frag_in_scope(*wanted.at(k), span, ctx)
                if !arg.is_poison() && !want.is_poison() && !arg.type_eq(&want) { agrees = false }
            }
        }
        if agrees { return true }
    }
    return !any
}
