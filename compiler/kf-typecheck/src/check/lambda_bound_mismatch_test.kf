import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.new_param
import kf_core.ast.statement.Stmt
import kf_typecheck.tref_p

fun lambda_with_param(ty: Ptr<TypeRef>): Expr {
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("n"), ty))
    return Expr.new(no_span(), ExprKind.Lambda(params, List.new<Stmt>()))
}

fun borrowed_int32_ref(): Ptr<TypeRef> {
    val borrowed: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *borrowed = TypeRef.new(no_span(), TypeRefKind.Reference(false, tref_p("int32"))) }
    return borrowed
}

fun expecting_int32(): List<Type> {
    var expected = List.new<Type>()
    expected.push(Type.new_int32(no_span()))
    return expected
}

@test fun a_written_param_the_bound_disagrees_with_is_reported(): void {
    var ctx = mk_ctx()
    val lambda = lambda_with_param(borrowed_int32_ref())
    lambda.report_written_params_against(&expecting_int32(), &List.new<String>(), &var ctx)
    val expected = "lambda parameter `n` is written `&int32`, but the `Call` bound it is passed to asks for `int32`"
    assert_eq(unsafe { (*ctx.diags).at(0).primary.message.as_str() }, expected, "both types are named")
}

@test fun a_written_param_the_bound_agrees_with_is_accepted(): void {
    var ctx = mk_ctx()
    lambda_with_param(tref_p("int32")).report_written_params_against(&expecting_int32(), &List.new<String>(), &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "int32 is what the bound asks for")
}

@test fun a_bound_left_generic_is_not_compared(): void {
    var ctx = mk_ctx()
    var expected = List.new<Type>()
    expected.push(Type { kind: TypeKind.Generic(intern("T")), provenance: Provenance.Inferred(no_span()) })
    lambda_with_param(borrowed_int32_ref()).report_written_params_against(&expected, &List.new<String>(), &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "T is still open here")
}

@test fun a_bound_mentioning_an_open_parameter_is_not_compared(): void {
    var ctx = mk_ctx()
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = Type { kind: TypeKind.Generic(intern("T")), provenance: Provenance.Inferred(no_span()) } }
    var expected = List.new<Type>()
    expected.push(Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Inferred(no_span()) })
    var open = List.new<String>()
    open.push(String.from("T"))
    lambda_with_param(borrowed_int32_ref()).report_written_params_against(&expected, &open, &var ctx)
    assert_eq(ctx.diags.items.size(), 0, "&T is decided when T is")
}
