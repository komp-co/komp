// `alias.name(args)`: a call through `import a.b as alias`.

import kf_core.ast.Sym
import kf_core.ast.alias_admission
import kf_core.ast.expression.Expr

/// The admission of the alias this method call's receiver names in the
/// caller's file, or poison. A local of that name shadows the alias.
fun Expr.alias_call_admission(ctx: &var TypeCtx): Sym {
    val alias = when (self.kind) {
        MethodCall(receiver, _method, _args) => receiver.variable_name()
        _ => String.from("")
    }
    if alias.as_str() == "" || ctx.is_declared(alias.as_str()) { return Sym { id: 0 } }
    val admission = alias_admission(alias.as_str())
    if unsafe { (*ctx.sigs).alias_target(ctx.owner_file, admission) }.id == 0 { return Sym { id: 0 } }
    return admission
}
