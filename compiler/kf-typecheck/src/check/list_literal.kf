// `[]` has no element to type it by, so it is the lang List's `new()` until a
// slot or a use names what it holds; a slot of an array or of a type
// converting from one retargets it instead. kf_core's list_literal.kf has the
// shape every list literal parses to.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.empty_list_literal_receiver
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.coerce_addr_of
import kf_core.diagnostic.error_at
import kf_typecheck.types.nominal_name

/// `[]` names the lang List, and is remembered as a literal.
mutating fun Expr.name_empty_list_literal(ctx: &var TypeCtx): void {
    val is_empty_literal = when (self.kind) {
        MethodCall(receiver, _method, _args) => receiver.names_empty_list_literal()
        _ => false
    }
    if !is_empty_literal { return }
    if ctx.list_name().as_str() == "" {
        ctx.emit(error_at(self.span, "`[]` builds a `List`, and this crate has no `alloc` dependency to provide one"))
        *self = Expr.new_poison(self.span)
        return
    }
    ctx.list_literals.push(self.span)
    *self = Expr.new_collection_new_call(self.span, ctx.list_name())
}

fun Expr.names_empty_list_literal(): bool {
    return when (self.kind) {
        Variable(name) => name.as_str() == empty_list_literal_receiver()
        _ => false
    }
}

/// `[]`, once named.
fun Expr.is_empty_list_literal(ctx: &TypeCtx): bool {
    while span in &ctx.list_literals {
        if span.same_as(self.span) { return true }
    }
    return false
}

/// `&[]` in a `&List<T>` slot: the literal takes the slot's pointee and is
/// lent. True when it did.
mutating fun Expr.lend_empty_list_literal(expected: &Type, ctx: &var TypeCtx): bool {
    if !self.is_empty_list_literal(ctx) { return false }
    when (expected.kind) {
        RefTo(_mutable, _inner) => { }
        _ => return false
    }
    if !self.apply_expected(expected.through_borrow(), ctx) { return false }
    self.coerce = coerce_addr_of()
    return true
}

/// The name a static call is written against: a generic instance's template,
/// or a type's own name without its crate and module.
fun Type.written_type_name(ctx: &var TypeCtx): Sym {
    val inst = self.expected_inst(ctx)
    if inst.is_some() {
        val found = inst ?: return intern("")
        return intern(found.base.as_str())
    }
    val identity = self.kind.nominal_name()
    val parts = identity.as_str().split("::")
    if parts.size() == 0 { return intern("") }
    return intern(parts.at(parts.size() - 1).as_str())
}

fun Type.is_nominal(): bool {
    return when (self.kind) {
        Struct(_identity) => true
        EnumTy(_identity) => true
        _ => false
    }
}
