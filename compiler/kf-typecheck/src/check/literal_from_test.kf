import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_resolve.*
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.leaked_diagnostics

fun literal_from_ctx(trait_args: str): TypeCtx {
    val declarations: Ptr<DeclTable> = unsafe { alloc<DeclTable>() }
    unsafe { *declarations = new_decl_table() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    val from = TraitImplInfo {
        type_name: String.from("Name"),
        receiver_identity: intern("Name"),
        trait_name: String.from("From"),
        trait_args: String.from(trait_args),
        generics: String.from(""),
        arg_count: 1
    }
    unsafe { signatures.insert_trait_impl(from) }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, declarations, signatures)
}

fun name_ty(): Type {
    return Type { kind: TypeKind.Struct(intern("Name")), provenance: Provenance.Inferred(no_span()) }
}

@test fun a_from_str_impl_takes_a_string_literal(): void {
    var ctx = literal_from_ctx("str")
    assert_eq(name_ty().implements_from("str", &var ctx), true, "From<str> is implemented")
}

@test fun a_from_impl_of_another_argument_takes_no_string_literal(): void {
    var ctx = literal_from_ctx("int32")
    assert_eq(name_ty().implements_from("str", &var ctx), false, "only From<int32> is implemented")
}

@test fun a_type_without_an_array_from_has_no_element(): void {
    var ctx = literal_from_ctx("str")
    assert_eq(name_ty().from_array_element(&var ctx) == null, true, "From<str> takes no array")
}
