// `Wrap { v: 5 }` for a generic `Wrap<T>`: each type parameter is read off the
// initializer of a field that mentions it, as a call's are off its arguments.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.FieldInit
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.bind_generic_from_param
import kf_typecheck.types.type_to_type_ref

/// None when `name` is no generic template. Otherwise every initializer has
/// been checked, once, and the arguments are written into `type_args`; false
/// when a parameter could not be bound, which is reported here.
mutating fun Expr.infer_struct_type_args(name: str, fields: &var List<FieldInit>, ctx: &var TypeCtx): bool? {
    val template = unsafe { (*ctx.sigs).generic_struct(name, ctx.owner_crate) } ?: return null
    while fi in &fields {
        val value: Ptr<Expr> = fi.value
        check_expr(unsafe { &var *value }, ctx)
    }
    val layout = template.layout
    var args = List.new<TypeRef>()
    while param in &template.type_params {
        val bound = layout.bind_from_fields(fields, param.as_str(), ctx) ?: return self.report_unbound(name, param, ctx)
        args.push(bound.type_to_type_ref(self.span))
    }
    self.type_args = args
    return true
}

/// The first initializer whose field mentions `param` and says what it is.
fun StructLayout.bind_from_fields(fields: &List<FieldInit>, param: str, ctx: &var TypeCtx): Type? {
    while fi in &fields {
        val value_ty = fi.value.ty.clone()
        if !value_ty.is_poison() {
            while field in &self.fields {
                if field.name.as_str() == fi.name.as_str() {
                    val bound = field.ty.bind_generic_from_param(&value_ty, param, ctx)
                    if !bound.is_poison() { return bound }
                }
            }
        }
    }
    return null
}

fun Expr.report_unbound(name: str, param: &String, ctx: &var TypeCtx): bool? {
    val message = "cannot infer `${param}` for `${name}` from its fields: " +
        "write the type arguments, as `${name}<...> { ... }`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    return false
}

/// `val b: Box2<int64> = Box2 { v: 5 }`: a literal of the annotated type that
/// writes no arguments takes the annotation's, before its fields are read.
mutating fun Expr.take_annotated_type_args(annotation: &TypeRef): void {
    if !self.type_args.is_empty() { return }
    var literal_name = String.from("")
    when (self.kind) {
        StructLit(name, _) => literal_name = name.as_string()
        _ => return
    }
    when (annotation.kind) {
        Named(name, args) => {
            if name.as_str() == literal_name.as_str() && !args.is_empty() { self.type_args = args.clone() }
        }
        _ => { }
    }
}
