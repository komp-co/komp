// `while i in a..b` over integers as a counted loop. The general `RangeIter`
// re-tests direction, inclusivity and overflow every iteration, measured at
// about ten times a hand-written index loop.
//
// Only for an exclusive range with step one: `..=` could wrap past its end
// (`0..=255` over `uint8`), and `.by()`, `.down()`, `.rev()` are method calls
// that never match here.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.expression.BinOp
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

/// `range(start, end, 1)`, as the parser writes `a..b`. Asked before the
/// subject is checked, while the callee has its parser name.
pub fun Expr.is_counted_range(): bool {
    return when (self.kind) {
        Call(callee, args) => {
            if !callee.as_str().equals("range") { return false }
            if args.size() != 3 { return false }
            is_literal_one(args.at(2))
        }
        _ => false
    }
}

/// Read back after checking, so both are typed. Empty if not the accepted
/// shape.
pub fun Expr.counted_range_bounds(): List<Expr> {
    var out = List.new<Expr>()
    when (self.kind) {
        Call(_callee, args) => {
            if args.size() == 3 {
                out.push(*args.at(0))
                out.push(*args.at(1))
            }
        }
        _ => { }
    }
    return out
}

fun Expr.is_literal_one(): bool {
    return when (self.kind) {
        LitInt(v) => v == 1
        _ => false
    }
}

/// Integers only: that is what was measured.
pub fun Expr.counted_range_is_integer(): bool {
    return when (self.ty.kind) {
        Int8 => true
        Int16 => true
        Int32 => true
        Int64 => true
        UInt8 => true
        UInt16 => true
        UInt32 => true
        UInt64 => true
        _ => false
    }
}

/// `while name in a..b { body }` becomes:
///
///     if true {
///         var __forix_N = a
///         val __forend_N = b
///         while __forix_N < __forend_N {
///             val name = __forix_N
///             __forix_N = __forix_N + 1
///             body
///         }
///     }
///
/// The increment precedes the body, so `continue` cannot skip it. `end` is
/// evaluated once, as the cursor would.
pub fun expand_foreach_counted(binder: Sym, start: Expr, end: Expr, body: List<Stmt>, span: Span): StmtKind {
    val tag = foreach_tag(span)
    val ixname = "__forix_${tag}"
    val endname = "__forend_${tag}"

    val start_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *start_ptr = start }
    val let_ix = Stmt.new(span, StmtKind.LetVar(intern(ixname.as_str()), null, start_ptr))

    val end_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *end_ptr = end }
    val let_end = Stmt.new(span, StmtKind.LetVal(intern(endname.as_str()), null, end_ptr))

    // `val name = __forix_N`.
    // CONSTRAINT: its span ends at the loop's first byte. A binding enclosing
    // the cursor stops `query scope` before the binder.
    val head = Span { file_id: span.file_id, start: span.start, end: span.start }
    val cur_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cur_ptr = Expr.new(head, ExprKind.Variable(intern(ixname.as_str()))) }
    val let_binder = Stmt.new(head, StmtKind.LetVal(binder, null, cur_ptr))

    // `__forix_N = __forix_N + 1`
    val bump_lhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *bump_lhs = Expr.new(span, ExprKind.Variable(intern(ixname.as_str()))) }
    val bump_rhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *bump_rhs = Expr.new(span, ExprKind.LitInt(1)) }
    val bump_expr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *bump_expr = Expr.new(span, ExprKind.Binary(bump_lhs, BinOp.Add, bump_rhs)) }
    val bump = Stmt.new(span, StmtKind.Assign(intern(ixname.as_str()), bump_expr))

    var while_body = List.new<Stmt>()
    while_body.push(let_binder)
    while_body.push(bump)
    while s in &body { while_body.push(s) }

    // `__forix_N < __forend_N`
    val cond_lhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cond_lhs = Expr.new(span, ExprKind.Variable(intern(ixname.as_str()))) }
    val cond_rhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cond_rhs = Expr.new(span, ExprKind.Variable(intern(endname.as_str()))) }
    val cond: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cond = Expr.new(span, ExprKind.Binary(cond_lhs, BinOp.Lt, cond_rhs)) }
    val while_stmt = Stmt.new(span, StmtKind.While(cond, while_body))

    var if_body = List.new<Stmt>()
    if_body.push(let_ix)
    if_body.push(let_end)
    if_body.push(while_stmt)
    val if_cond: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *if_cond = Expr.new(span, ExprKind.LitBool(true)) }
    return StmtKind.If(if_cond, if_body, List.new<Stmt>())
}
