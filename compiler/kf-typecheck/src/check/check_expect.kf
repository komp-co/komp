// Expected-type propagation: a slot that knows its type (annotated `let`,
// return, argument) applies it to the checked expression, through if and
// `when` branches and block tails, binding generic constructors inference
// could not (`Option.None`), and falling back to the coercion table.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.try_dyn_coerce

/// True when the node was transformed or coerced.
pub mutating fun Expr.apply_expected(expected: Type, ctx: &var TypeCtx): bool {
    if self.pin_at_first_use(expected.clone(), ctx) { return true }
    val _typed_by_slot = self.pin_open_binding(expected.clone(), ctx)
    // Each branch independently.
    var was_if = false
    var if_hit = false
    when (self.kind) {
        IfExpr(_cond, then_ptr, else_ptr) => {
            was_if = true
            val a = apply_expected(unsafe { &var *then_ptr }, expected.clone(), ctx)
            val b = apply_expected(unsafe { &var *else_ptr }, expected.clone(), ctx)
            if_hit = a || b
        }
        _ => { }
    }
    if was_if {
        if if_hit { self.ty = expected }
        return if_hit
    }

    // Every arm, and a block's tail.
    when (self.kind) {
        Block(stmts) => {
            if stmts.size() == 0 { return false }
            val vp = stmt_value_expr(*stmts.at(stmts.size() - 1)) ?: return false
            if !apply_expected(unsafe { &var *vp }, expected.clone(), ctx) { return false }
            self.ty = unsafe { vp.ty }
            return true
        }
        _ => { }
    }

    var was_when = false
    var when_hit = false
    when (self.kind) {
        WhenExpr(_subject, arms) => {
            was_when = true
            while item in &arms {
                val vp = arm_value_expr(item) ?: continue
                if apply_expected(unsafe { &var *vp }, expected.clone(), ctx) { when_hit = true }
            }
        }
        _ => { }
    }
    if was_when {
        if when_hit { self.ty = expected }
        return when_hit
    }

    if try_dyn_coerce(self, expected.clone(), ctx) { return true }

    // An integer literal takes a numeric slot's type when the value fits.
    when (self.kind) {
        LitInt(value) => {
            if is_numeric(expected) {
                if positive_integer_literal_fits(value, expected) {
                    self.ty = expected
                    return true
                }
                self.reject_integer_literal(expected, ctx)
                return true
            }
        }
        // A float literal narrows to a float32 slot; C converts the spelling.
        LitFloat(_) => {
            if is_float(expected) {
                self.ty = expected
                return true
            }
        }
        _ => { }
    }
    val negative_magnitude = negative_integer_literal_magnitude(*self)
    if negative_magnitude >= 0 && is_numeric(expected) {
        if negative_integer_literal_fits(negative_magnitude, expected) {
            when (self.kind) {
                Unary(_, inner) => unsafe { inner.ty = expected.clone() }
                _ => { }
            }
            self.ty = expected
            return true
        }
        self.reject_integer_literal(expected, ctx)
        return true
    }

    // A constructor written against a generic template without type args
    // adopts the expected instance's.
    val found_inst = expected.expected_inst(ctx)
    if found_inst.is_some() {
        val ip = found_inst ?: return false
        if self.rebind_template_ctor(&ip, ctx) { return true }
        if self.rebind_static_call(&ip, ctx) { return true }
        // `null` and bare payloads become real `Option.None` / `Option.Some`
        // constructors in an Option slot.
        if ip.inst_is_option(ctx) {
            val cur2 = *self
            if is_null_var(cur2) {
                self.rewrite_null_to_none(&ip, ctx)
                return true
            }
            // Wrapped in `Some` only when the value fits the payload, so a
            // `true` return can be trusted.
            if !type_names_equal(self.ty, expected) {
                // Poison was reported where it arose: the slot is claimed so
                // nothing cascades, and nothing is rewritten on a guess.
                if self.ty.is_poison() { return true }
                if ip.option_accepts_expr(self, ctx) {
                    self.wrap_in_some(&ip, ctx)
                    return true
                }
                return false
            }
            return false
        }
    }

    // A generic call inferred from its arguments alone, rebound to the
    // instance the slot names: `Range<int32>` and `Range<uint64>` are
    // unrelated types, so no flat coercion applies.
    if self.rebind_generic_call(&expected, ctx) { return true }

    // A string literal in a `String` slot is literal typing and becomes the
    // `From` call; a `str` value is a conversion and must be written.
    val cur = *self
    if cur.ty.kind.kind_tag() == TAG_STR() && expected.str_slot_wants_string(ctx.string_name()) {
        if !expr_is_lit_str(*self) {
            self.reject_str_value_to_string(ctx)
            return true
        }
        self.rewrite_str_to_string(ctx)
        if (&expected).is_lang_struct(ctx.string_name()) { return self.ty.type_eq(expected) }
        if !self.ty.type_eq(deref_target(expected.clone())) { return false }
        self.coerce = coerce_addr_of()
        return true
    }

    // The flat table: String-to-str views and address-of only.
    val code = coerce_code_for(cur.ty, expr_is_lit_str(cur), expected.clone(), ctx.string_name())
    if code == coerce_none() { return false }
    self.coerce = code
    return true
}

/// CONSTRAINT: through `at_mut`; get/set would drop the old element while the
/// copy aliases its boxes.
pub fun expect_arg(args: &var List<Expr>, idx: uint64, to: Type, ctx: &var TypeCtx): bool {
    if idx >= args.size() { return false }
    return apply_expected(args.at_mut(idx), to, ctx)
}

/// The registry entry when `expected` names a recorded generic instance.
fun Type.expected_inst(ctx: &var TypeCtx): GenericInst? {
    return when (self.kind) {
        Struct(n) => unsafe { (*ctx.sigs).find_inst(n.as_str()) }
        EnumTy(n) => unsafe { (*ctx.sigs).find_inst(n.as_str()) }
        _ => Option.None
    }
}

fun GenericInst.inst_is_option(ctx: &var TypeCtx): bool {
    return self.base.as_str().equals(ctx.option_name().as_str())
}

fun Type.type_is_option(ctx: &var TypeCtx): bool {
    val found = self.expected_inst(ctx)
    if found.is_none() { return false }
    val ip = found ?: return false
    return ip.inst_is_option(ctx)
}

/// A safe call's present arm: `a?.b` is `Option<B>`, so the value is wrapped
/// in `Some`, unless `b` is already an Option and the chain flattens. Only
/// the checker knows the type; the parser marked the node.
///
/// Reached through the arm's own `Ptr<Expr>` so the rewrite lands on the real
/// node.
pub fun wrap_safe_call_value(subject_ty: Type, arms: &var List<Arm>, span: Span, ctx: &var TypeCtx): void {
    if arms.size() == 0 { return }
    val vp = arm_value_expr(arms.at(0)) ?: return
    if !unsafe { vp.is_safe_call_value } { return }

    // The receiver must be optional, or the desugar's own `null` is what
    // fails, naming a token the author never wrote.
    if !subject_ty.is_poison() {
        if !subject_ty.type_is_option(ctx) {
            var msg = String.from("the receiver of `?.` must be optional, but this is `")
            msg.append(mangle_type(subject_ty.clone()).as_str())
            msg.append("` — a value that is always present is reached with `.`")
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
            // One error per mistake: the absent arm's `null` is not reported.
            while i in 1..arms.size() {
                val np = arm_value_expr(arms.at(i)) ?: continue
                note_null_typed(unsafe { np.span }, ctx)
            }
            return
        }
    }
    val vt = unsafe { vp.ty }
    // Already reported.
    if vt.is_poison() { return }
    val found = vt.expected_inst(ctx)
    if found.is_some() {
        val ip = found ?: return
        if ip.inst_is_option(ctx) { return }
    }
    var args = List.new<TypeRef>()
    args.push(vt.type_to_type_ref(unsafe { vp.span }))
    val option = ctx.option_name()
    val mangled = mangle_type_name(option.as_str(), &args, ctx)
    val inst = GenericInst { mangled: mangled, base: option.as_string(), args: args }
    wrap_in_some(unsafe { &var *vp }, &inst, ctx)
}

/// The value fits this Option's payload slot.
fun GenericInst.option_accepts_expr(expression: &var Expr, ctx: &var TypeCtx): bool {
    if self.args.size() != 1 { return false }
    val payload = (*self.args.at(0)).resolve_type_ref(ctx)
    // Nested expectations go on the payload, which lets a concrete value flow
    // into `Option<&dyn Trait>`.
    if expression.apply_expected(payload.clone(), ctx) { return true }
    if expression.ty.type_eq(payload) { return true }
    return ctx.fits(expression.ty, payload)
}

/// CONSTRAINT: apply first, then test. `apply_expected` may rewrite the node
/// (null to `Option.None`, a payload to `Option.Some`), and testing first would
/// reject exactly what the rewrite exists to accept.
pub mutating fun Expr.expect_or_reject(expected: Type, ctx: &var TypeCtx): bool {
    if self.apply_expected(expected.clone(), ctx) { return true }
    val cur = *self
    if cur.ty.type_eq(expected) { return true }
    return ctx.fits(cur.ty, expected)
}

/// Name-level equality: enum instances appear as Struct or EnumTy.
fun type_names_equal(a: Type, b: Type): bool {
    return mangle_type(a).as_str().equals(mangle_type(b).as_str())
}

/// `null` in an Option slot becomes `Option.None` in place. `null` is a
/// childless Variable, so overwriting `e.kind` aliases nothing.
mutating fun Expr.rewrite_null_to_none(inst: &GenericInst, ctx: &var TypeCtx): void {
    val span = self.span
    // Gives the `null` its type, so report_untyped_nulls stays quiet.
    note_null_typed(span, ctx)
    val base = ctx.option_name().as_string()
    val concrete = concrete_enum_name(base.clone(), &inst.args, ctx)
    val recv = Box.new(new_expr(span, ExprKind.Variable(ctx.option_name())))
    self.type_args = clone_type_args(&inst.args)
    self.ty = enum_ty_of(concrete.clone(), span)
    self.kind = ExprKind.FieldAccess(recv, intern("None"))
    self.is_variant_ctor = true
    self.reset_call_annotations()
}

/// A raw `str` becomes the lang string's `from(str)`, checked immediately so
/// later passes see the resolved impl.
mutating fun Expr.rewrite_str_to_string(ctx: &var TypeCtx): void {
    val span = self.span
    val snapshot = *self
    var args = List.new<Expr>()
    args.push(snapshot)
    val recv = Box.new(new_expr(span, ExprKind.Variable(ctx.string_name())))
    self.kind = ExprKind.MethodCall(recv, intern("from"), args)
    self.reset_call_annotations()
    check_expr(self, ctx)
}

/// A bare payload in an Option slot becomes `Option.Some(payload)`. The old
/// shell is snapshotted into a fresh argument list, then `e.kind` overwritten;
/// the old value is not dropped, so shared buffers pass into the payload.
mutating fun Expr.wrap_in_some(inst: &GenericInst, ctx: &var TypeCtx): void {
    val span = self.span
    val base = ctx.option_name().as_string()
    val concrete = concrete_enum_name(base.clone(), &inst.args, ctx)
    val snapshot = *self
    var payload_args = List.new<Expr>()
    payload_args.push(snapshot)
    val coerced = coerce_ctor_payloads(concrete.clone(), String.from("Some"), payload_args, ctx)
    val recv = Box.new(new_expr(span, ExprKind.Variable(ctx.option_name())))
    self.type_args = clone_type_args(&inst.args)
    self.ty = enum_ty_of(concrete.clone(), span)
    self.kind = ExprKind.MethodCall(recv, intern("Some"), coerced)
    // A constructor now; ownership treats the payload as a move sink.
    self.is_variant_ctor = true
    self.reset_call_annotations()
}

/// The side-channel fields describe the node's old kind and are cleared, or
/// codegen would emit the payload's callee in place of the constructor.
mutating fun Expr.reset_call_annotations(): void {
    // Spelled out: a field assignment carries no expected type to a `null`.
    self.decl = Option.None<DeclId>()
    self.mangled_callee = intern("")
    self.coerce = coerce_none()
    self.is_static_call = false
}
