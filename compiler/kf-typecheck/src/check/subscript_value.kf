// `a[i]` on a type whose elements are computed: through `IndexValue` it is
// `a.index_value(i)`, the element itself rather than a borrow of one.

import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.span.Span
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type

/// CONSTRAINT: by name until a release's seed knows a lang key for it.
fun index_value_trait_name(): str { return "IndexValue" }

/// True when `self`, a subscript, was rewritten to `index_value` and checked,
/// or reported.
pub mutating fun Expr.index_by_value(ctx: &var TypeCtx): bool {
    var call: Ptr<Expr>? = null
    when (self.kind) {
        Deref(inner) => { call = Option.Some(inner) }
        _ => return false
    }
    val subscript = call ?: return false
    return self.subscript_by_value(subscript, ctx)
}

mutating fun Expr.subscript_by_value(call: Ptr<Expr>, ctx: &var TypeCtx): bool {
    val subscript: &var Expr = unsafe { &var *call }
    if !subscript.is_shared_subscript() { return false }
    when (subscript.kind) {
        MethodCall(recv, _name, args) => {
            val container_expr: &var Expr = unsafe { &var *recv }
            check_expr(container_expr, ctx)
            val container = container_expr.ty.deref_one()
            if container.is_poison() || !container.bound_type_implements(index_value_trait_name(), ctx.sigs) {
                return false
            }
            if container.bound_type_implements("Index", ctx.sigs) {
                self.report_two_subscripts(&container, ctx)
                return true
            }
            var by_value = Expr.new(self.span, ExprKind.MethodCall(recv, intern("index_value"), args))
            by_value.name_span = subscript.name_span
            *self = by_value
            check_expr(self, ctx)
            return true
        }
        _ => return false
    }
}

mutating fun Expr.report_two_subscripts(container: &Type, ctx: &var TypeCtx): void {
    val shown = container.display_type(ctx)
    val message = "`${shown}` implements both `Index` and `${index_value_trait_name()}`, so `[]` on it has two " +
        "meanings; implement one"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = Type.new_poison()
}

/// `a[i]` read through `IndexValue`.
pub fun Expr.is_computed_subscript(): bool {
    return when (self.kind) {
        MethodCall(_recv, name, args) => name.as_str() == "index_value" && args.size() == 1
        _ => false
    }
}

/// A computed element has no place to write to.
pub fun Expr.report_write_to_computed_subscript(span: Span, ctx: &var TypeCtx): void {
    val message = "cannot write through this subscript: its element is computed by `${index_value_trait_name()}`, " +
        "and has no place to write to"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}
