// The trait decides whether an operator's right operand is passed by value or
// by borrow.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.*
import kf_typecheck.types.TAG_PTR
import kf_typecheck.types.TAG_REF
import kf_typecheck.types.kind_tag
import kf_typecheck.types.type_eq
import kf_typecheck.traits.trait_impl_owner_name

/// `check_binary`, then borrowing the right operand when the trait method takes
/// it by reference. Decided by the trait, since generic code over `T: Equal` is
/// checked against it.
pub fun BinOp.check_binary_operands(lhs_ptr: Ptr<Expr>, rhs_ptr: Ptr<Expr>, span: Span, ctx: &var TypeCtx): Type {
    val lhs = unsafe { &*lhs_ptr }
    val rhs = unsafe { &*rhs_ptr }
    val ty = self.check_binary(lhs, rhs, span, ctx)
    if ty.is_poison() { return ty }
    if !lhs.ty.operand_dispatches_to_its_trait() { return ty }
    lhs.ty.check_operator_impl_bounds(binop_method(*self), span, ctx)
    if rhs.coerce != coerce_none() { return ty }
    if !self.operator_trait_borrows_operand(ctx) { return ty }
    unsafe { (*rhs_ptr).coerce = coerce_addr_of() }
    return ty
}

/// The operator's impl has the bounds its method call would: `==` on
/// `Option<T>` needs `T: Equal`, as `.equals()` does.
fun Type.check_operator_impl_bounds(method: str, span: Span, ctx: &var TypeCtx): void {
    val nominal = when (self.kind) {
        Struct(_) => true
        EnumTy(_) => true
        _ => false
    }
    if !nominal || method == "" { return }
    val _binding = bound_checked_recv_bindings(self.kind.trait_impl_owner_name(), String.from(method), span, ctx)
}

// Raw strings, pointers and borrows compare by representation; a pointer
// offset is not an `Add`.
fun Type.operand_dispatches_to_its_trait(): bool {
    return when (self.kind) {
        StrTy => false
        PtrTo(_) => false
        BoxOf(_) => false
        RefTo(_, _) => false
        _ => true
    }
}

/// A primitive's `equals`/`compare` has no impl; its argument is borrowed as
/// an operator's would be.
pub fun Type.borrow_intrinsic_method_operand(method: str, args: &var List<Expr>, ctx: &var TypeCtx): void {
    if args.size() != 1 { return }
    val trait_name = intrinsic_method_trait(method, ctx)
    if trait_name.as_str().equals("") { return }
    val arg = args.at(0)
    if arg.coerce != coerce_none() || arg.ty.is_poison() { return }
    if !arg.ty.type_eq(self) { return }
    if !trait_name.trait_method_borrows_operand(method, ctx) { return }
    args.at_mut(0).coerce = coerce_addr_of()
}

fun intrinsic_method_trait(method: str, ctx: &var TypeCtx): Sym {
    if method == "equals" { return ctx.lang_trait_name(lang_equal_key()) }
    if method == "compare" { return ctx.lang_trait_name(lang_compare_key()) }
    return intern("")
}

fun BinOp.operator_trait_borrows_operand(ctx: &var TypeCtx): bool {
    return self.operator_trait_name(ctx).trait_method_borrows_operand(binop_method(*self), ctx)
}

fun Sym.trait_method_borrows_operand(method: str, ctx: &var TypeCtx): bool {
    if method == "" { return false }
    when (unsafe { (*ctx.sigs).find_trait(self.as_str()) }) {
        Some(info) => {
            while m in &info.methods {
                if m.name.as_str() == method && m.params.size() > 0 {
                    val tag = m.params.at(0).kind.kind_tag()
                    return tag == TAG_REF() || tag == TAG_PTR()
                }
            }
            return false
        }
        None => return false
    }
}

fun BinOp.operator_trait_name(ctx: &var TypeCtx): Sym {
    return when (self) {
        Add => ctx.lang_trait_name(lang_add_key())
        Sub => ctx.lang_trait_name(lang_sub_key())
        Mul => ctx.lang_trait_name(lang_mul_key())
        Div => ctx.lang_trait_name(lang_div_key())
        Mod => intern("Mod")
        Eq => ctx.lang_trait_name(lang_equal_key())
        NotEq => ctx.lang_trait_name(lang_equal_key())
        Lt => ctx.lang_trait_name(lang_compare_key())
        Gt => ctx.lang_trait_name(lang_compare_key())
        LtEq => ctx.lang_trait_name(lang_compare_key())
        GtEq => ctx.lang_trait_name(lang_compare_key())
        Shl => intern("Shl")
        Shr => intern("Shr")
        BitAnd => intern("BitAnd")
        BitOr => intern("BitOr")
        BitXor => intern("BitXor")
        _ => intern("")
    }
}
