import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.crate_id_poison
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_typecheck.check.check_expr
import kf_typecheck.check.mk_ctx

fun value_register_fn(name: str, generics: List<String>, ctx: &var TypeCtx): void {
    var params = List.new<Type>()
    params.push(Type.new_int32(no_span()))
    val signature = FnSignature {
        name: String.from(name), params: params, ret: Type.new_int32(no_span()), generics: generics,
        is_static: false, is_mutating: false, owner_module: intern(""), owner_crate: crate_id_poison(),
        is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false
    }
    unsafe { ctx.sigs.insert(signature) }
}

fun named_value(name: str): Expr {
    return Expr.new(no_span(), ExprKind.Variable(intern(name)))
}

@test fun a_function_name_is_a_value(): void {
    var ctx = mk_ctx()
    value_register_fn("double", List.new<String>(), &var ctx)
    var e = named_value("double")
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.fn_parts() != null, true, "a function's name types as a function type")
}

@test fun a_function_value_takes_the_functions_parameters(): void {
    var ctx = mk_ctx()
    value_register_fn("double", List.new<String>(), &var ctx)
    var e = named_value("double")
    check_expr(&var e, &var ctx)
    val parts = e.ty.fn_parts() ?: return
    assert_eq(parts.params.size(), 1, "one parameter, as declared")
}

@test fun a_generic_function_is_not_a_value(): void {
    var ctx = mk_ctx()
    var generics = List.new<String>()
    generics.push(String.from("T"))
    value_register_fn("id", generics, &var ctx)
    var e = named_value("id")
    check_expr(&var e, &var ctx)
    val message = unsafe { (*ctx.diags).at(0).primary.message.clone() }
    val expected = "generic function `id` cannot be used as a value: a function value has one type"
    assert_eq(message.as_str(), expected, "a value has one type, so the generic is refused")
}
