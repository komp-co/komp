// A method call on a receiver with no type cannot be emitted: codegen builds
// `poison_next`. Usually the tail of an earlier error, so these are collected
// and reported only when the check found nothing else.

import alloc.list.*

import kf_core.ast.intern
import kf_core.span.*
import kf_core.diagnostic.*

pub fun record_untyped_receiver(span: Span, method: str, sigs: Ptr<SigTable>): void {
    if unsafe { sigs as uint64 } == 0 { return }
    unsafe { (*sigs).untyped_recv_spans.push(span) }
    unsafe { (*sigs).untyped_recv_methods.push(intern(method)) }
}

/// Nothing when another error explains them.
pub fun untyped_receiver_diags(sigs: Ptr<SigTable>, found: &List<Diagnostic>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    if unsafe { sigs as uint64 } == 0 { return out }
    while d in &found {
        when (d.severity) {
            Error => return out
            _ => { }
        }
    }
    val spans = unsafe { (*sigs).untyped_recv_spans }
    val methods = unsafe { (*sigs).untyped_recv_methods }
    var i: uint64 = 0
    while i < spans.size() && i < methods.size() {
        val m = methods.get(i).as_str()
        val why = "internal error: the receiver of `${m}` lost its type with no error to explain it"
        val message = "${why}; this is a komp bug — the C it would emit calls `poison_${m}`"
        out.push(new_diagnostic(Severity.Error, new_label(spans.get(i), message)))
        i = i + 1
    }
    return out
}
