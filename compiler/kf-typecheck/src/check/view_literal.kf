// A view literal borrows from one place, so freezing that place is enough to
// keep the view valid. Fields lent from two different bindings are rejected.

import alloc.list.*

import kf_core.ast.lent_roots
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.check.borrow.type_is_view

/// Reported on a literal of a view type whose borrowed fields name two
/// bindings.
fun Expr.reject_split_view_origin(ctx: &var TypeCtx): void {
    if !self.ty.type_is_view(ctx.sigs) { return }
    val roots = self.lent_roots(unsafe { &(*ctx.sigs).views })
    if roots.size() < 2 { return }
    val first = roots.at(0).as_str()
    val second = roots.at(1).as_str()
    val message = "this view borrows from both `${first}` and `${second}`; a view borrows from one place, " +
        "so build it from one binding or keep the two apart"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
}
