import core.assert.assert_eq

import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import alloc.list.*
import kf_core.span.no_span

@test
fun resolved_struct_name_is_owned_str(): void {
    val name: String = struct_name_of(Type { kind: TypeKind.Struct(intern("Pair__int32")), provenance: Provenance.Inferred(no_span()) })
    assert_eq(name.as_str(), "Pair__int32", "resolved struct names are owned String values")
}

fun inits_named(first: str, second: str): List<FieldInit> {
    var inits = List.new<FieldInit>()
    inits.push(FieldInit.new(no_span(), String.from(first), Box.new(Expr.new(no_span(), ExprKind.LitInt(1)))))
    inits.push(FieldInit.new(no_span(), String.from(second), Box.new(Expr.new(no_span(), ExprKind.LitInt(2)))))
    return inits
}

@test fun a_field_init_is_found_by_name(): void {
    val inits = inits_named("first", "second")
    assert_eq(field_init_index(&inits, "second"), 1, "second is the second init")
}

@test fun a_missing_field_init_answers_the_size(): void {
    val inits = inits_named("first", "second")
    assert_eq(field_init_index(&inits, "third"), 2, "no init names third")
}
