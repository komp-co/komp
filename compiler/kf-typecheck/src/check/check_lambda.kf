// A lambda becomes a struct plus an `impl CallN<...>` whose `call` holds the
// body, and the node becomes a literal of that struct:
// `|x: int32| x * 2` is a fieldless struct implementing `Call1<int32>`.
//
// CONSTRAINT: minted here, not in a pre-pass: the impl states a concrete
// return type, which is the body's, known only once it is checked.
//
// A bare parameter's type comes from the `Call` bound on the receiving
// parameter, stamped by `expect_lambda_args`; without a bound it is an error.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_typecheck.types.*
import kf_typecheck.traits.register_assoc_bindings_decl
import kf_typecheck.traits.register_struct
import kf_typecheck.*
import kf_core.ast.subst.clone_type_ref
import kf_typecheck.check.decl.register_type_identity
import kf_typecheck.check.decl.register_sigs


pub mutating fun Expr.check_lambda(ctx: &var TypeCtx): Type {
    val span = self.span
    when (self.kind) {
        Lambda(params, body) => {
            if params.size() > 3 {
                emit_lambda_err(span, String.from("a lambda takes at most 3 parameters"), ctx)
                return poison_ty()
            }
            val stored_local = ctx.in_local_lambda_binding > 0
            if ctx.in_call_arg == 0 && !stored_local {
                emit_lambda_err(span, String.from("a lambda can only initialize a local or be passed directly to a function call; returning one or storing one in an aggregate is not supported yet"), ctx)
                return poison_ty()
            }
            // Bare parameters take the types `expect_lambda_args` stamped.
            val params = annotated_params(&params, &self.type_args, span)
            if !params_are_annotated(&params, span, ctx) { return poison_ty() }
            var captures = collect_captures(&body, &params, ctx)
            val ret = lambda_body_type(&params, &captures, &body, span, ctx)
            if ret.is_poison() { return poison_ty() }
            classify_captures(&body, &var captures, ctx)
            if stored_local && !own_stored_captures(&var captures, span, ctx) { return poison_ty() }
            val ret_ref = ret.type_to_type_ref(span)
            if ret_ref.type_ref_is_poison() {
                emit_lambda_err(span, String.from("a lambda body of this type is not supported yet"), ctx)
                return poison_ty()
            }
            val fields = capture_fields(&captures, span, ctx)
            if fields.size() != captures.size() { return poison_ty() }
            // Captured names become field reads.
            var rewrite_locals = List.new<String>()
            rewrite_captures_in_stmts(&body, &captures, span, &var rewrite_locals)
            val name = ctx.fresh_lambda_name()
            if stored_local { unsafe { ctx.sigs.stored_lambda_types.push(intern(name.as_str())) } }
            val mutating_call = capture_needs_mutating_call(&captures)
            synth_lambda_decls(name.clone(), &params, fields, &body, ret_ref, mutating_call, ty_is_void(ret), span, ctx)
            // CONSTRAINT: `type_args` is cleared: on a struct literal it would
            // mangle the lambda's struct as an instance of itself.
            self.type_args = List.new<TypeRef>()
            self.kind = ExprKind.StructLit(intern(name.as_str()), capture_inits(&captures, span, ctx))
            return lambda_struct_ty(name, span)
        }
        _ => return poison_ty()
    }
}

/// Anything other than a trailing expression is left alone.
fun Stmt.returned_value_stmt(span: Span): Stmt {
    when (self.kind) {
        Expression(expr_ptr) => {
            // A fresh Expr: the Lambda node is dropped when `e.kind` is
            // overwritten.
            val fresh: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *fresh = (*expr_ptr).clone() }
            val operand: Box<Expr>? = fresh
            return new_stmt(span, StmtKind.Return(operand))
        }
        _ => return self.clone()
    }
}

fun lambda_struct_ty(name: String, span: Span): Type {
    return Type { kind: TypeKind.Struct(intern(name.as_str())), provenance: Provenance.Inferred(span) }
}

/// Per lambda, carrying the enclosing function's name for readable C.
/// CONSTRAINT: single underscores only; `__` would read as a generic instance.
mutating fun TypeCtx.fresh_lambda_name(): String {
    var out = "Lambda_${self.fn_owner.as_str()}_"
    val n = unsafe { (*self.sigs).synth_decls.size() }
    out.append("${n}".as_str())
    return out
}

/// A local list, not a rewrite of the node, which a `when` holds by value.
fun annotated_params(params: &List<Param>, expected: &List<TypeRef>, span: Span): List<Param> {
    var out = List.new<Param>()
    while i in 0..params.size() {
        val p = *params.at(i)
        if unsafe { (p.ty as uint64) == 0 } {
            if i < expected.size() {
                val slot: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *slot = clone_type_ref(expected.at(i)) }
                out.push(new_param(p.span, p.name.as_string(), slot))
                continue
            }
        }
        out.push(p)
    }
    return out
}

fun params_are_annotated(params: &List<Param>, span: Span, ctx: &var TypeCtx): bool {
    while p in &params {
        if unsafe { (p.ty as uint64) == 0 } {
            emit_lambda_err(span, "lambda parameter `${p.name.as_string()}` needs a type annotation (its type is read from the `Call` bound on the parameter the lambda is passed to, and this position declares none)", ctx)
            return false
        }
    }
    return true
}

fun capture_fields(captures: &List<LambdaCapture>, span: Span, ctx: &var TypeCtx): List<Field> {
    var fields = List.new<Field>()
    while capture in &captures {
        val nm = capture.name
        val cty = ctx.lookup(nm.as_str())
        val tref = cty.type_to_type_ref(span)
        if tref.type_ref_is_poison() {
            emit_lambda_err(span, "a lambda cannot capture `${nm}`: its type has no written form", ctx)
            return fields
        }
        val ty_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        when (capture.mode) {
            Shared => {
                val inner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *inner_ptr = tref }
                unsafe { *ty_ptr = new_type_ref(span, TypeRefKind.Reference(false, inner_ptr)) }
            }
            Mutable => {
                val inner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *inner_ptr = tref }
                unsafe { *ty_ptr = new_type_ref(span, TypeRefKind.Reference(true, inner_ptr)) }
            }
            _ => unsafe { *ty_ptr = tref }
        }
        fields.push(new_field(span, nm, ty_ptr, false, true))
    }
    return fields
}

/// The literal replacing the lambda, reading each captured name once.
fun capture_inits(captures: &List<LambdaCapture>, span: Span, ctx: &var TypeCtx): List<FieldInit> {
    var inits = List.new<FieldInit>()
    while capture in &captures {
        val nm = capture.name
        val v: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *v = new_expr(span, ExprKind.Variable(intern(nm.as_str()))) }
        unsafe { v.ty = ctx.lookup(nm.as_str()) }
        when (capture.mode) {
            Shared => unsafe { v.coerce = coerce_addr_of() }
            Mutable => unsafe { v.coerce = coerce_addr_of() }
            _ => { }
        }
        inits.push(new_field_init(span, nm, v))
    }
    return inits
}

/// A name neither parameter nor capture is undeclared, and says so.
fun lambda_body_type(params: &List<Param>, captures: &List<LambdaCapture>, body: &List<Stmt>, span: Span, ctx: &var TypeCtx): Type {
    val sink: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *sink = List.new<Diagnostic>() }
    // Poison, not void: the return type is what is being computed;
    // `validate_lambda_returns` judges early returns afterwards.
    var inner = new_type_ctx(poison_ty(), sink, ctx.table, ctx.sigs)
    inner.owner_crate = ctx.owner_crate
    inner.owner_module = ctx.owner_module
    inner.owner_file = ctx.owner_file
    inner.fn_owner = ctx.fn_owner.clone()
    inner.generics = ctx.generics.clone()
    while p in &params {
        val tr: TypeRef = unsafe { *p.ty }
        val pty = tr.resolve_type_ref(&var inner)
        inner.declare(p.name.as_string(), pty)
    }
    while capture in &captures {
        val nm = capture.name
        if ctx.lookup_is_var(nm.as_str()) {
            inner.declare(nm.clone(), ctx.lookup(nm.as_str()))
        } else {
            inner.declare_val(nm.clone(), ctx.lookup(nm.as_str()))
        }
    }
    // In order, so a `val` is in scope for the statements after it.
    while si in 0..body.size() {
        (unsafe { body.at(si) as Ptr<Stmt> } as &var Stmt).check_stmt(&var inner)
    }
    val failed = unsafe { sink.size() } > 0
    var d = 0
    while d < unsafe { sink.size() } {
        ctx.emit(unsafe { *sink.at(d) })
        d = d + 1
    }
    if failed { return poison_ty() }
    val value = lambda_value_type(body, span)
    if !validate_lambda_returns(body, &value, span, ctx) { return poison_ty() }
    return value
}

/// Every `return` must agree with the trailing value. Compared, not
/// re-checked, since checking twice would mint nested lambdas twice.
fun validate_lambda_returns(body: &List<Stmt>, value: &Type, span: Span, ctx: &var TypeCtx): bool {
    var ok = true
    while item in &body {
        if !(item).validate_returns_stmt(value, span, ctx) { ok = false }
    }
    return ok
}

fun Stmt.validate_returns_stmt(value: &Type, span: Span, ctx: &var TypeCtx): bool {
    when (self.kind) {
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return true
            val got = unsafe { ep.ty.clone() }
            if got.is_poison() { return true }
            if got.type_eq(unsafe { *value }) { return true }
            if ctx.fits(got, unsafe { *value }) { return true }
            val msg = "this `return` answers `${got.display_type(ctx)}`, but the lambda's value is `${value.display_type(ctx)}`"
            ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
            return false
        }
        If(_c, then_body, else_body) => {
            val a = validate_lambda_returns(&then_body, value, span, ctx)
            val b = validate_lambda_returns(&else_body, value, span, ctx)
            return a && b
        }
        While(_c, body) => return validate_lambda_returns(&body, value, span, ctx)
        ForEach(_b, _s, body) => return validate_lambda_returns(&body, value, span, ctx)
        When(_s, arms) => {
            var ok = true
            while arm in &arms {
                if !validate_lambda_returns(arm.body, value, span, ctx) { ok = false }
            }
            return ok
        }
        _ => return true
    }
}

/// The last statement if it is an expression, void otherwise.
fun lambda_value_type(body: &List<Stmt>, span: Span): Type {
    if body.size() == 0 { return void_ty(span) }
    when (body.at(body.size() - 1).kind) {
        Expression(expr_ptr) => return unsafe { expr_ptr.ty.clone() }
        _ => return void_ty(span)
    }
}

/// `struct NAME {}` and `impl CallN<...> for NAME`, registered in
/// check_decl_module's pre-pass order and parked for it to move into the
/// module. Registered before returning, since the receiving call is typed
/// immediately.
fun synth_lambda_decls(name: String, params: &List<Param>, fields: List<Field>, lambda_body: &List<Stmt>, ret_ref: TypeRef, mutating_call: bool, void_result: bool, span: Span, ctx: &var TypeCtx): void {
    val owner = ctx.owner_crate
    val modp = ctx.owner_module
    val sigs = ctx.sigs
    val diags = ctx.diags

    var lam = new_top_decl(span, name.clone(), TopDeclKind.Struct(fields, true))
    lam.crate = owner
    lam.module_path = modp

    // fun call(params): ret { <body>, its last expression returned }
    // The statements are cloned: the Lambda node is replaced as soon as this
    // returns.
    val ret_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret_ptr = ret_ref.clone() }
    var body = List.new<Stmt>()
    while bi in 0..lambda_body.size() {
        val is_last = bi + 1 == lambda_body.size()
        if is_last && !void_result {
            body.push((lambda_body.at(bi)).returned_value_stmt(span))
        } else {
            body.push(lambda_body.at(bi).clone())
        }
    }
    var call_fn = new_top_decl(span, String.from("call"), TopDeclKind.Function(params.clone(), ret_ptr, body, true, false, mutating_call, false))
    call_fn.crate = owner
    call_fn.module_path = modp

    // type Out = ret
    val out_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *out_ptr = ret_ref }
    var out_decl = new_top_decl(span, String.from("Out"), TopDeclKind.AssocTypeBinding(out_ptr))
    out_decl.crate = owner
    out_decl.module_path = modp

    var methods = List.new<TopDecl>()
    methods.push(out_decl)
    methods.push(call_fn)

    val trait_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *trait_ptr = new_type_ref(span, TypeRefKind.Named(intern(call_trait_name(params.size(), mutating_call).as_str()), param_type_refs(params))) }
    var impl_decl = new_top_decl(span, name, TopDeclKind.TraitImpl(trait_ptr, methods))
    impl_decl.crate = owner
    impl_decl.module_path = modp

    lam.register_type_identity(sigs)
    impl_decl.register_assoc_bindings_decl(sigs, diags)
    lam.register_lambda_struct(sigs, diags)
    register_struct(&var impl_decl, sigs, diags, Option.None)
    register_sigs(&var impl_decl, sigs, diags, Option.None)

    unsafe { sigs.synth_decls.push(lam) }
    unsafe { sigs.synth_decls.push(impl_decl) }
}

mutating fun TopDecl.register_lambda_struct(sigs: Ptr<SigTable>, diags: Ptr<List<Diagnostic>>): void {
    when (self.kind) {
        Struct(fields, _is_pub) => {
            var ctx0 = new_type_ctx(void_ty(no_span()), diags, Option.None, sigs)
            ctx0.owner_crate = self.crate
            ctx0.owner_module = self.module_path
            ctx0.owner_file = self.span.file_id
            ctx0.metadata_owner = self
            ctx0.seed_generics(List.new<String>())
            var fs = List.new<StructFieldInfo>()
            while f in &fields {
                val ty_ptr: Ptr<TypeRef> = f.ty
                val f_tr: TypeRef = unsafe { *ty_ptr }
                val fty = f_tr.resolve_type_ref(&var ctx0)
                fs.push(StructFieldInfo { name: f.name.as_string(), ty: fty, is_var: f.is_var })
            }
            unsafe { sigs.insert_struct(StructLayout { name: self.name.as_string(), fields: fs, is_refcounted: false, owner_crate: self.crate }) }
        }
        _ => { }
    }
}

fun call_trait_name(arity: uint64, mutating_call: bool): String {
    val prefix = if mutating_call { String.from("CallMut") } else { String.from("Call") }
    return prefix + "${arity}"
}

fun param_type_refs(params: &List<Param>): List<TypeRef> {
    var out = List.new<TypeRef>()
    while p in &params {
        out.push(unsafe { *p.ty })
    }
    return out
}

fun emit_lambda_err(span: Span, msg: String, ctx: &var TypeCtx): void {
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}
