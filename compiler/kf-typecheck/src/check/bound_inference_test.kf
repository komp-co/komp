import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.*

// A compound trait argument (`Entry<K, V>`) resolves to a concrete type.
@test fun a_compound_trait_argument_resolves_to_a_concrete_instance(): void {
    var ctx = mk_ctx()
    unsafe { ctx.sigs.insert_trait_impl(TraitImplInfo {
        type_name: String.from("HashMap"),
        receiver_identity: intern("HashMap"),
        trait_name: String.from("Iterable"),
        trait_args: String.from("Entry__K__V"),
        generics: String.from("K__V"),
        arg_count: 1
    }) }
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    unsafe { ctx.sigs.insert_inst(GenericInst { mangled: String.from("HashMap__int32__int32"), base: String.from("HashMap"), args: args }) }

    val self_ty = Type { kind: TypeKind.Struct(intern("HashMap__int32__int32")), provenance: Provenance.Inferred(no_span()) }
    var wanted = List.new<String>()
    wanted.push(String.from("T"))
    var gnames = List.new<String>()
    gnames.push(String.from("T"))
    var inf_tys = List.new<Type>()
    inf_tys.push(Type.new_poison())

    var impl_params = List.new<String>()
    impl_params.push(String.from("K"))
    impl_params.push(String.from("V"))
    val direct = compound_segment_type("Entry__K__V", &impl_params, &self_ty, no_span(), &var ctx)
    var direct_spelled = String.from("<not-struct>")
    when (direct.kind) {
        Struct(n) => direct_spelled = n.as_string()
        Poison => direct_spelled = String.from("<poison>")
        _ => { }
    }
    assert_eq(direct_spelled.as_str(), "Entry__int32__int32", "compound_segment_type alone resolves the compound argument")

    val result = impl_trait_arg_types(&self_ty, "Iterable", &wanted, &gnames, &inf_tys, no_span(), &var ctx)
    assert_eq(result.size(), 1, "one argument resolved")
    var spelled = String.from("<not-struct>")
    when (result.at(0).kind) {
        Struct(n) => spelled = n.as_string()
        Poison => spelled = String.from("<poison>")
        _ => { }
    }
    assert_eq(spelled.as_str(), "Entry__int32__int32", "the compound argument names the concrete instance")
}
