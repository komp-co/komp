// One arm per StmtKind; a `let` also declares its binding.

import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_core.span.*
import kf_typecheck.types.*
import kf_typecheck.traits.validate_dyn_placement
import kf_typecheck.check.borrow.check_returned_borrow
import kf_typecheck.check.control.check_when_arms


pub mutating fun Stmt.check_stmt(ctx: &var TypeCtx): void {
    when (self.kind) {
        LetVal(name, ty_ref_ptr, init_ptr) => {
            // Only Lower synthesizes a binding without an initializer.
            val ip = init_ptr ?: return
            check_let(name.as_string(), ty_ref_ptr.view(), ip, false, self.span, ctx)
        }
        LetVar(name, ty_ref_ptr, init_ptr) => {
            val ip = init_ptr ?: return
            check_let(name.as_string(), ty_ref_ptr.view(), ip, true, self.span, ctx)
        }
        Assign(name, expr_ptr) => {
            check_assign(name.as_string(), expr_ptr, self.span, ctx)
        }
        AssignTo(place_ptr, expr_ptr) => {
            // `*p = rhs` / `e.field = rhs`: both sides typed; the store has no
            // value.
            check_expr(unsafe { &var *place_ptr }, ctx)
            check_expr(expr_ptr, ctx)
            reject_stored_lambda_transfer(unsafe { &*expr_ptr }, "an assignment", ctx)
            // A place is a slot: `s.f = 5` against `var f: int32?` becomes
            // `Option.Some(5)`, or codegen stores an int into a tagged union.
            // Mismatches are still not reported here.
            val want = unsafe { (*place_ptr).ty }
            if !want.is_poison() {
                expect_or_reject(unsafe { &var *expr_ptr }, want, ctx)
            }
            // The place must be writable. Raw pointer derefs are allowed.
            if !writable_place(place_ptr, ctx) {
                val bad_field = immutable_val_field(unsafe { *place_ptr }, ctx)
                if !bad_field.as_str().equals("") {
                    val lab = new_label(self.span, "cannot assign to field `${bad_field}"
                        + String.from("`: it is declared `val`; declare it `var`"))
                    ctx.emit(new_diagnostic(Severity.Error, lab))
                } else if place_root_name(unsafe { *place_ptr }).as_str().equals("self") {
                    val lab = new_label(self.span, String.from("cannot mutate `self` here; mark the enclosing method `mutating`"))
                    ctx.emit(new_diagnostic(Severity.Error, lab))
                } else {
                    val lab = new_label(self.span, String.from("cannot assign through an immutable place; declare it with `var` (or borrow with `&var`)"))
                    ctx.emit(new_diagnostic(Severity.Error, lab))
                }
            }
        }
        Return(maybe_expr) => {
            check_return(maybe_expr.view(), self.span, ctx)
        }
        If(cond_ptr, then_body, else_body) => {
            check_expr(unsafe { &var *cond_ptr }, ctx)
            while i in 0..then_body.size() {
                (then_body.at_mut(i)).check_stmt(ctx)
            }
            while j in 0..else_body.size() {
                (else_body.at_mut(j)).check_stmt(ctx)
            }
        }
        While(cond_ptr, body) => {
            check_expr(unsafe { &var *cond_ptr }, ctx)
            while i in 0..body.size() {
                (body.at_mut(i)).check_stmt(ctx)
            }
        }
        ForEach(binder, subj_ptr, body) => {
            self.check_foreach(binder, subj_ptr, body, self.span, ctx)
        }
        When(subj_ptr, arms) => {
            check_expr(unsafe { &var *subj_ptr }, ctx)
            val subj = unsafe { *subj_ptr }
            check_when_arms(subj.ty, &var arms, self.span, ctx)
        }
        Expression(expr_ptr) => {
            check_expr(expr_ptr, ctx)
        }
        Switch(_, _) => return
        Drop(_) => return
        Release(_) => return
        Break => return
        Continue => return
        Poison => return
    }
}

/// A value for a declared return type, nothing for `void`.
fun check_return(maybe_expr: Ptr<Expr>?, span: Span, ctx: &var TypeCtx): void {
    when (maybe_expr) {
        Some(expr_ptr) => {
            check_expr(unsafe { &var *expr_ptr }, ctx)
            reject_stored_lambda_transfer(unsafe { &*expr_ptr }, "a return value", ctx)
            // Coerced to the declared type.
            val accepted = apply_expected(unsafe { &var *expr_ptr }, ctx.return_ty, ctx)
            check_returned_borrow(unsafe { &*expr_ptr }, span, ctx)
            if ty_is_void(ctx.return_ty) {
                emit_return_err(span, String.from("`return` in a `void` function cannot carry a value"), ctx)
            } else if return_ty_wants_value(ctx.return_ty) && ty_is_void(unsafe { expr_ptr.ty }) {
                emit_return_err(span, String.from("`return` here needs a value, but this expression is `void`"), ctx)
            } else if !accepted && !type_eq(unsafe { expr_ptr.ty }, ctx.return_ty) && !ctx.fits(unsafe { expr_ptr.ty }, ctx.return_ty) && (unsafe { expr_ptr.ty }).kind.kind_tag() != TAG_GENERIC() && (unsafe { expr_ptr.ty }).kind.kind_tag() != TAG_PROJECTION() && !ctx.return_ty.is_poison() && !(unsafe { expr_ptr.ty }).is_poison() {
                val actual = unsafe { (*expr_ptr).ty }
                val msg = "wrong return type: expected `${ctx.return_ty.display_type(ctx)}`, found `${actual.display_type(ctx)}`"
                emit_return_err(span, msg, ctx)
            }
        }
        None => {
            if return_ty_wants_value(ctx.return_ty) {
                emit_return_err(span, String.from("`return` here needs a value: the function declares a return type"), ctx)
            }
        }
    }
}

/// `Never` and `Poison` need no second diagnostic.
fun return_ty_wants_value(t: Type): bool {
    return when (t.kind) {
        Void => false
        Never => false
        Poison => false
        _ => true
    }
}

fun ty_is_void(t: Type): bool {
    return when (t.kind) {
        Void => true
        _ => false
    }
}

fun emit_return_err(span: Span, msg: String, ctx: &var TypeCtx): void {
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

/// The parser's `&` / `&var` tags; see coerce_written_amp.
fun is_written_borrow(code: uint8): bool {
    if code == coerce_written_amp() { return true }
    return code == coerce_written_amp_var()
}

fun borrow_of(inner: Type, mutable: bool, span: Span): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.RefTo(mutable, p), provenance: Provenance.Inferred(span) }
}

fun check_let(name: String, ann: Ptr<TypeRef>?, init_ptr: Ptr<Expr>, mutable: bool, span: Span, ctx: &var TypeCtx): void {
    // Read before check_expr clears it.
    val written = unsafe { init_ptr.coerce }
    check_local_initializer(unsafe { &var *init_ptr }, ctx)
    val init = unsafe { *init_ptr }

    var ty = init.ty
    when (ann) {
        Some(ty_ref_ptr) => {
            val tr = unsafe { *ty_ref_ptr }
            val declared = tr.resolve_type_ref(ctx)
            declared.validate_dyn_placement(tr.span, ctx)
            // The declared type goes into the initializer: a literal stays `str`
            // in a `str` slot, becomes `String.from` in a `String` slot, and
            // `val a: int32? = 5` wraps in Some.
            // CONSTRAINT: expect_or_reject applies before it tests.
            if expect_or_reject(unsafe { &var *init_ptr }, declared.clone(), ctx) {
                ty = declared
            } else {
                val lab = new_label(init.span, String.from("init type doesn't match declared"))
                ctx.emit(new_diagnostic(Severity.Error, lab))
                ty = poison_ty()
            }
        }
        None => {
            // An unannotated literal defaults to String through the same
            // `From<str>` rewrite.
            val is_lit_str: bool = is_lit_str_expr(init) && ctx.string_is_visible()
            if is_lit_str {
                if apply_expected(unsafe { &var *init_ptr }, ctx.string_name().lang_struct_ty(init.span), ctx) {
                    ty = ctx.string_name().lang_struct_ty(init.span)
                }
            }
            // `val b = &xs` binds a borrow, like `val b: &List<int32> = &xs`;
            // otherwise it would move. An initializer already a reference is
            // bound as is.
            if is_written_borrow(written) {
                if !init.ty.is_poison() && init.ty.kind.kind_tag() != TAG_REF() {
                    val mutable_borrow: bool = written == coerce_written_amp_var()
                    // The init node carries the borrow type too, since codegen
                    // reads it for an unannotated let.
                    ty = borrow_of(init.ty.clone(), mutable_borrow, init.span)
                    unsafe { init_ptr.ty = borrow_of(init.ty.clone(), mutable_borrow, init.span) }
                    unsafe { init_ptr.coerce = coerce_addr_of() }
                }
            }
        }
    }
    // Its first use may choose a literal's width, an open call's type
    // arguments, or what a `null` is absent from.
    val flexible = is_numeric_literal(init) || open_call_pending(init.span, ctx) || init.is_bare_null()
    if ann.is_none() && flexible {
        ctx.declare_flexible(name, ty, mutable, init_ptr)
        return
    }
    if mutable {
        ctx.declare(name, ty)
    } else {
        ctx.declare_val(name, ty)
    }
}

fun check_assign(name: String, expr_ptr: Ptr<Expr>, span: Span, ctx: &var TypeCtx): void {
    check_expr(unsafe { &var *expr_ptr }, ctx)
    val expr = unsafe { *expr_ptr }
    expr.reject_stored_lambda_transfer("an assignment", ctx)
    val target = ctx.lookup(name.as_str())
    if target.is_poison() {
        return
    }
    // `x = v` needs a `var` binding.
    if !ctx.lookup_is_var(name.as_str()) {
        if name.as_str().equals("self") {
            val lab = new_label(span, String.from("cannot reassign `self` here; mark the enclosing method `mutating`"))
            ctx.emit(new_diagnostic(Severity.Error, lab))
        } else {
            val lab = new_label(span, "cannot reassign `${name}`: it is not a `var` binding")
            ctx.emit(new_diagnostic(Severity.Error, lab))
        }
    }
    // The target is a slot: `v = 5` against `var v: int32?` becomes
    // `Option.Some(5)`.
    val want = target.clone()
    if !expect_or_reject(unsafe { &var *expr_ptr }, target, ctx) {
        emit_assign_mismatch(name.clone(), want, unsafe { expr_ptr.ty }, span, ctx)
    }
}

fun emit_assign_mismatch(name: String, want: Type, got: Type, span: Span, ctx: &var TypeCtx): void {
    // Poison: already reported.
    if want.is_poison() { return }
    if got.is_poison() { return }
    val want_s = mangle_type(want)
    val got_s = mangle_type(got)
    val msg = "cannot assign `${got_s.as_str()}` to `${name.as_str()}`, which is `${want_s.as_str()}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, msg)))
}

fun is_lit_str_expr(e: Expr): bool {
    return when (e.kind) {
        LitStr(_) => true
        _ => false
    }
}

/// Without a lang string in the graph, a literal stays `str` rather than
/// becoming a type the crate cannot name.
mutating fun TypeCtx.string_is_visible(): bool {
    return !self.string_name().as_str().equals("")
}
