// An instance satisfies a trait only if its arguments meet the bounds its impl
// puts on its own parameters: `impl Clone for Option<T: Clone>` makes
// `Option<Unique>` Clone only if `Unique` is.

import alloc.list.*

import kf_core.ast.lang_copy_key
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.span.Span
import kf_typecheck.types.nominal_name
import kf_typecheck.types.resolve_type_ref

/// Some impl of `trait_name` whose parameter bounds all hold is enough. A
/// type that is not an instance, or an impl with no recorded bounds, passes.
pub fun Type.instance_args_meet(trait_name: str, span: Span, ctx: &var TypeCtx): bool {
    val inst = unsafe { (*ctx.sigs).find_inst(self.kind.nominal_name().as_str()) } ?: return true
    val impls = unsafe { (*ctx.sigs).impl_param_bounds_of(inst.base.as_str(), trait_name) }
    if impls.size() == 0 { return true }
    while each in &impls {
        if each.params_meet(&inst.args, span, ctx) { return true }
    }
    return false
}

fun ImplParamBounds.params_meet(args: &List<TypeRef>, span: Span, ctx: &var TypeCtx): bool {
    if self.bounds.size() != args.size() { return true }
    while i in 0..args.size() {
        val bounds = self.bounds.at(i)
        if bounds.as_str().byte_len() == 0 { continue }
        val arg = resolve_type_ref(args.at(i), ctx)
        while bound in &bounds.split("+") {
            if !arg.meets_bound(bound.as_str(), span, ctx) { return false }
        }
    }
    return true
}

/// A type parameter meets what its owner declares; a type with no name to
/// look an impl up by is judged only for `Copy`, as at the top of a bound.
fun Type.meets_bound(trait_name: str, span: Span, ctx: &var TypeCtx): bool {
    when (self.kind) {
        Generic(name) => return owner_has_bound(ctx.fn_owner.clone(), name.as_string(), String.from(trait_name), ctx)
        Poison => return true
        Projection(_, _) => return true
        _ => { }
    }
    if trait_name.equals(ctx.lang_trait_name(lang_copy_key()).as_str()) { return self.type_is_copy(ctx) }
    val base = self.ty_base_name()
    if base.as_str().byte_len() == 0 { return true }
    if ty_satisfies_intrinsically(base.as_str(), trait_name, ctx) { return true }
    return bound_type_implements_here(self, trait_name, String.from(""), &List.new<String>(), span, ctx)
}
