// How many arguments and type arguments each memory intrinsic takes. Codegen
// reads them by position, so a call short of one stops here.

import kf_core.span.*
import kf_core.ast.Intrinsic
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.diagnostic.error_at
import kf_typecheck.types.resolve_type_ref

/// Reports a call with `found` arguments when that is not the arity; true
/// when it did.
fun Intrinsic.report_arity(found: uint64, span: Span, ctx: &var TypeCtx): bool {
    val wanted = self.arity()
    if wanted < 0 || found == wanted as uint64 { return false }
    ctx.emit(error_at(span, "wrong number of arguments to `${self.name()}`: expected ${wanted}, found ${found}"))
    return true
}

/// The one type argument a call to `self` names; poison, reported, when it
/// names none or several.
fun Intrinsic.type_argument(type_args: &List<TypeRef>, span: Span, ctx: &var TypeCtx): Type {
    if type_args.size() == 1 { return (*type_args.at(0)).resolve_type_ref(ctx) }
    ctx.emit(error_at(span, "`${self.name()}` takes one type argument, found ${type_args.size()}"))
    return Type.new_poison()
}
