// An inferred binding written back as a type argument, since Mono
// materializes only from explicit ones.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.*
import kf_typecheck.types.type_ref_is_poison

/// A borrow is `Reference(mutable, inner)`, mutability kept. An instance is
/// spelled as its template and arguments from the registry, since this is
/// re-resolved in the caller's scope, where `List__int32` would read as a
/// template plus argument. A null `sigs` spells no instance.
pub fun Type.ty_written_ref(span: Span, sigs: Ptr<SigTable>): TypeRef {
    when (self.kind) {
        RefTo(mutable, inner) => {
            val within = ty_written_ref(unsafe { &*inner }, span, sigs)
            if within.type_ref_is_poison() { return within }
            val inner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *inner_ptr = within }
            return TypeRef.new(span, TypeRefKind.Reference(mutable, inner_ptr))
        }
        Struct(n) => return n.written_named_ref(span, sigs)
        EnumTy(n) => return n.written_named_ref(span, sigs)
        Value(v) => return TypeRef.new(span, TypeRefKind.Value(v))
        Projection(owner, member) => {
            val written_owner = ty_written_ref(unsafe { &*owner }, span, sigs)
            if written_owner.type_ref_is_poison() { return written_owner }
            return TypeRef.new(span, TypeRefKind.Projection(Box.new(written_owner), member))
        }
        _ => { }
    }
    val flat = self.ty_flat_ref_name()
    if flat.as_str().equals("") { return TypeRef.new(span, TypeRefKind.Poison) }
    return TypeRef.new(span, TypeRefKind.Named(intern(flat.as_str()), List.new<TypeRef>()))
}

fun Sym.written_named_ref(span: Span, sigs: Ptr<SigTable>): TypeRef {
    val flat = self.flat_written_name()
    if !flat.as_str().equals("") {
        return TypeRef.new(span, TypeRefKind.Named(intern(flat.as_str()), List.new<TypeRef>()))
    }
    if unsafe { sigs as uint64 } == 0 { return TypeRef.new(span, TypeRefKind.Poison) }
    val inst = unsafe { sigs.find_inst(self.as_str()) } ?: return TypeRef.new(span, TypeRefKind.Poison)
    val base = intern(inst.base.as_str()).flat_written_name()
    if base.as_str().equals("") { return TypeRef.new(span, TypeRefKind.Poison) }
    return TypeRef.new(span, TypeRefKind.Named(intern(base.as_str()), inst.args.clone()))
}

// Builtins, template names and generic parameters, which clone-subst rewrites
// inside a generic body. "" for mono-suffixed names, borrows and poison.
fun Type.ty_flat_ref_name(): String {
    when (self.kind) {
        Struct(n) => return n.flat_written_name()
        EnumTy(n) => return n.flat_written_name()
        Generic(n) => return n.as_string()
        _ => return self.ty_base_name()
    }
}

/// The last segment of a canonical identity, the spelling kf-mono's
/// `ty_to_mangle` uses: `crate::module::Name` is not a C identifier.
fun Sym.flat_written_name(): String {
    val s = type_identity_display(Sym { id: self.id })
    // `List__int32` would read as a template plus argument.
    val b = mangle_base_name(s.clone())
    if b.as_str().equals(s.as_str()) { return s }
    return ""
}
