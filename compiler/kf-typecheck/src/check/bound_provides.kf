// What a bound answers for, read through its supertraits too: the impl check
// already refused any implementor missing a required trait.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.types.Type
import kf_typecheck.traits.supertrait_closure_reqs
import kf_typecheck.traits.trait_method_in
import kf_typecheck.traits.key_segments

// Includes the bound's supertraits: `T: Num` with `trait Num: Add` answers
// for `+`.
fun owner_has_bound(owner: String, param: String, trait_name: String, ctx: &var TypeCtx): bool {
    val sp = ctx.sigs
    val nb = unsafe { sp.bounds.size() }
    var i = 0
    while i < nb {
        val b = unsafe { *sp.bounds.at(i) }
        if b.owner.as_str().equals(owner.as_str()) {
            if b.param.as_str().equals(param.as_str()) {
                if b.trait_name.as_str().equals(trait_name.as_str()) {
                    return true
                }
                val required = supertrait_closure_reqs(unsafe { &*sp }, b.trait_name.as_str(), b.trait_args.as_str())
                while req in &required {
                    if req.name.as_str().equals(trait_name.as_str()) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

// The trait method `method_name` resolves to on type parameter `gname`, from
// the enclosing function's bounds; sentinel arity when none provides it. The
// named trait is searched before its supertraits, so a redeclared name
// resolves to the trait actually written.
fun trait_method_for_generic(gname: String, method_name: String, ctx: &var TypeCtx): TraitMethodReq {
    val sp = ctx.sigs
    val nb = unsafe { sp.bounds.size() }
    var i = 0
    while i < nb {
        val b = unsafe { *sp.bounds.at(i) }
        if b.owner.as_str().equals(ctx.fn_owner.as_str()) {
            if b.param.as_str().equals(gname.as_str()) {
                // `Self` is the bounded parameter: `cmp(other: Self)` on
                // `T: Compare` reads `cmp(other: T)`.
                val self_t = Type.new_generic(gname.clone(), no_span())
                // The trait's parameters take the bound's arguments:
                // `next(): T?` on `I: Iterator<int32>` reads `next(): int32?`.
                val direct = trait_method_in(b.trait_name.as_str(), method_name.clone(),
                    &b.arg_names, self_t.clone(), ctx)
                if direct.arity != ARITY_NOT_FOUND() { return direct }
                // Supertrait arguments come back in the bound's vocabulary, so
                // the same substitution applies.
                val required = supertrait_closure_reqs(unsafe { &*sp }, b.trait_name.as_str(), b.trait_args.as_str())
                while sreq in &required {
                    val sargs = key_segments(sreq.args.as_str())
                    val found = trait_method_in(sreq.name.as_str(), method_name.clone(), &sargs, self_t.clone(), ctx)
                    if found.arity != ARITY_NOT_FOUND() { return found }
                }
            }
        }
        i = i + 1
    }
    return TraitMethodReq {
        name: "", span: no_span(), arity: ARITY_NOT_FOUND(),
        has_default: false, has_method_generics: false, is_static: false,
        params: List.new<Type>(), ret: Type.new_poison(), is_mutating: false
    }
}
