// A method's own generic parameters at a call site. The receiver supplies its
// impl's (`T` in `impl List<T>`, from `List__int32`); only the call supplies
// the method's (`F` in `fun map<F: Call1<T>>`). Resolved in that order, since
// the method's bounds are written in the impl's terms.

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_typecheck.types.*
import kf_core.ast.subst.monomorphized_type_name
import kf_typecheck.check.borrow.reject_kept_temporary
import kf_typecheck.check.borrow.may_keep_argument

/// The receiver's bindings and their bounds. Trait impl methods never reach
/// `check_method_generics`, so the check rides here.
pub fun bound_checked_recv_bindings(sname: String, method_name: String, span: Span, ctx: &var TypeCtx): RecvBinding {
    val binding = recv_type_bindings(sname.clone(), span, ctx)
    check_recv_bounds(sname, method_name, &binding, span, ctx)
    return binding
}

/// `impl List<T: Copy>` bounds are the receiver's to satisfy, checked like a
/// free function's. An empty binding has nothing to check.
fun check_recv_bounds(sname: String, method_name: String, recv: &RecvBinding, span: Span, ctx: &var TypeCtx): void {
    val owner = mangle_base_name(sname) + String.from("_") + method_name
    var i = 0
    while i < recv.names.size() {
        // Against the whole binding: a bound may name its siblings
        // (`impl Chain<A: Iterator<T>, B, T>`).
        check_generic_bounds_with_bindings(owner.clone(), *recv.names.at(i), *recv.types.at(i), &recv.names, &recv.types, span, ctx)
        i = i + 1
    }
}

/// Solves the method's own parameters, checks the arguments, stamps the
/// callee's type-arg suffix and returns the specialized return type, or
/// poison. Both substitutions happen before coerce_call_arg, or a `&A` param
/// never auto-borrows. `sname` is already mangled for a generic receiver.
fun FnSignature.check_method_generics(recv: &RecvBinding, sname: String, method_name: String, args: &var List<Expr>, arg_tys: &List<Type>, call: &var Expr, _span: Span, ctx: &var TypeCtx): Type {
    check_recv_bounds(sname.clone(), method_name.clone(), recv, _span, ctx)
    // Registered generics are the impl's then the method's; the impl's half is
    // pinned, so only the rest is open. Positionally as well as by name: a
    // self-call inside the impl has the template as its receiver, which binds
    // nothing, and its `T` is still the impl's.
    val impl_arity = sname.static_recv_arity(ctx)
    var mgnames = List.new<String>()
    while gi in 0..self.generics.size() {
        val gn = *self.generics.at(gi)
        var pinned = gi < impl_arity
        while name in &recv.names {
            if name.as_str().equals(gn.as_str()) { pinned = true }
        }
        if !pinned { mgnames.push(gn) }
    }
    var mbindings = List.new<Type>()
    while gb in 0..mgnames.size() {
        val gname = *mgnames.at(gb)
        var bound = Type.new_poison()
        if gb < call.type_args.size() {
            bound = (*call.type_args.at(gb)).resolve_type_ref(ctx)
        }
        if bound.is_poison() {
            var bk = 0
            while bk < arg_tys.size() {
                val sp = subst_recv(*self.params.at(bk + 1), recv)
                val at0 = *arg_tys.at(bk)
                val cand = sp.bind_generic_from_param(&at0, gname.as_str(), ctx)
                if !cand.is_poison() {
                    bound = cand
                    break
                }
                bk = bk + 1
            }
        }
        mbindings.push(bound)
    }
    var saw_error = false
    while i in 0..arg_tys.size() {
        var expected = subst_recv(*self.params.at(i + 1), recv)
        var sb = 0
        while sb < mgnames.size() {
            val bt = *mbindings.at(sb)
            if !bt.is_poison() {
                expected = expected.subst_generic(*mgnames.at(sb), bt.clone())
            }
            sb = sb + 1
        }
        val kept = self.may_keep_argument(i + 1)
        if kept && args.at(i).reject_kept_temporary(&expected, method_name.as_str(), ctx) {
            saw_error = true
        } else if !check_method_arg(args, &arg_tys, i, expected, method_name.clone(), _span, ctx) {
            saw_error = true
        }
    }
    if saw_error { return Type.new_poison() }
    // CONSTRAINT: written back, since mono materializes only from explicit
    // type args.
    if mgnames.size() > 0 {
        if call.type_args.size() == 0 {
            var written = List.new<TypeRef>()
            var ok = true
            while mbinding in &mbindings {
                val tr = mbinding.ty_written_ref(_span, ctx.sigs)
                if tr.type_ref_is_poison() { ok = false }
                written.push(tr)
            }
            if ok { call.type_args = written }
        }
    }
    // The callee gets the specialization's suffix (`Terminal_draw__DrawProbe`),
    // after the write-back.
    if call.mangled_callee.as_str().equals("") {
        var callee_seg = String.from(method_name.as_str())
        if call.type_args.size() > 0 {
            callee_seg = monomorphized_type_name(callee_seg, &call.type_args)
        }
        val callee = sname + String.from("_") + callee_seg
        call.mangled_callee = intern(callee.as_str())
    }
    val ret = subst_all_generics(subst_recv(self.ret, recv), &mgnames, &bound_or_left(&mgnames, &mbindings))
    // A return type naming an instance of the receiver's generic needs it to
    // exist.
    if recv.recv_is_instance() { materialize_method_return_instance(ret.clone(), recv, &mgnames, &mbindings, _span, ctx) }
    // One whose arguments the receiver's parameter names cannot supply still
    // gets a row; see register_substituted_return_row.
    self.ret.register_substituted_return_row(&ret, recv, _span, ctx)
    ret.register_returned_instance(_span, ctx)
    return ret
}

// A static call writes the type's and the method's type arguments in one
// list; the type's arity is the boundary. Folding both into the receiver
// spells one symbol two ways.

/// Zero for a non-generic receiver.
pub fun String.static_recv_arity(ctx: &var TypeCtx): uint64 {
    val base = mangle_base_name(self.clone())
    when (unsafe { (*ctx.sigs).find_generic_info(base.as_str(), ctx.owner_crate) }) {
        Some(gi) => { return gi.type_params.size() }
        None => { return 0 }
    }
}

/// `args[0..n)`: the receiver's half.
pub fun type_args_head(args: &List<TypeRef>, n: uint64): List<TypeRef> {
    var out = List.new<TypeRef>()
    var i = 0
    while i < n {
        if i < args.size() { out.push(*args.at(i)) }
        i = i + 1
    }
    return out
}

/// `args[n..)`: the method's own half.
pub fun type_args_tail(args: &List<TypeRef>, n: uint64): List<TypeRef> {
    var out = List.new<TypeRef>()
    var i: uint64 = n
    while i < args.size() {
        out.push(*args.at(i))
        i = i + 1
    }
    return out
}

/// Binds a static method's own parameters from its value arguments and writes
/// them onto the node, since mono materializes only from explicit type args.
/// All-or-nothing.
pub fun infer_static_method_type_args(sig: &FnSignature, n_recv: uint64, type_args: &var List<TypeRef>, args: &List<Expr>, span: Span, ctx: &var TypeCtx): void {
    // Only when exactly the receiver's half is present.
    if type_args.size() != n_recv { return }
    if sig.generics.size() <= n_recv { return }
    // The receiver's half goes first; the method's may be spelled in it.
    var pinned = List.new<Type>()
    var pi = 0
    while pi < n_recv {
        if pi < type_args.size() { pinned.push((*type_args.at(pi)).resolve_type_ref(ctx)) }
        pi = pi + 1
    }
    var flats = List.new<String>()
    var values = List.new<Type>()
    var ok = true
    var gi: uint64 = n_recv
    while gi < sig.generics.size() {
        val gname = *sig.generics.at(gi)
        var bound = Type.new_poison()
        while bk in 0..args.size() {
            if bk < sig.params.size() {
                // No `self`: argument i faces parameter i.
                var expected = *sig.params.at(bk)
                var si = 0
                while si < pinned.size() {
                    expected = expected.subst_generic(*sig.generics.at(si), *pinned.at(si))
                    si = si + 1
                }
                val at0 = args.at(bk).ty
                val cand = expected.bind_generic_from_param(&at0, gname.as_str(), ctx)
                if !cand.is_poison() {
                    bound = cand
                    break
                }
            }
        }
        if bound.is_poison() { ok = false }
        flats.push(bound.ty_flat_ref_name())
        values.push(bound)
        gi = gi + 1
    }
    if !ok { return }
    while i in 0..flats.size() {
        if flats.at(i).as_str().equals("") && !values.at(i).is_value() { return }
    }
    while i in 0..flats.size() {
        // A length binds as the value it is: `N` from an `int64[3]` is 3.
        val arg = if values.at(i).is_value() {
            values.at(i).type_to_type_ref(span)
        } else {
            TypeRef.new(span, TypeRefKind.Named(intern(flats.at(i).as_str()), List.new<TypeRef>()))
        }
        type_args.push(arg)
    }
}

/// A value argument's type: the `3` an `int64[3]` binds `N` to.
fun Type.is_value(): bool {
    return when (self.kind) {
        Value(_v) => true
        _ => false
    }
}

/// Each binding, or the parameter itself where none was found, so
/// substituting leaves an unbound parameter as written.
fun bound_or_left(names: &List<String>, bindings: &List<Type>): List<Type> {
    var out = List.new<Type>()
    while i in 0..names.size() {
        val bound = if i < bindings.size() { bindings.at(i).clone() } else { Type.new_poison() }
        out.push(if bound.is_poison() { Type.new_generic(names.at(i).clone(), no_span()) } else { bound })
    }
    return out
}
