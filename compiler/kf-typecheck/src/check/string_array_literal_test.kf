import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

fun uint8_ty(): Type {
    return Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(no_span()) }
}

fun string_literal(text: str): Expr {
    return Expr.new(no_span(), ExprKind.LitStr(String.from(text)))
}

@test fun a_byte_array_counts_the_utf8_bytes(): void {
    val length = string_literal("héllo").text_literal_length(&uint8_ty())
    assert_eq(length, Option.Some(6 as uint64), "é is two bytes")
}

@test fun a_char_array_counts_the_characters(): void {
    val length = string_literal("héllo").text_literal_length(&Type.new_char(no_span()))
    assert_eq(length, Option.Some(5 as uint64), "é is one character")
}

@test fun an_array_of_another_element_takes_no_text(): void {
    val length = string_literal("abc").text_literal_length(&Type.new_int32(no_span()))
    assert_eq(length == null, true, "an int32 array is not text")
}

@test fun a_byte_literal_is_one_element_per_byte(): void {
    val elements = TextUnit.Byte.elements_of("é", no_span())
    assert_eq(elements.size(), 2 as uint64, "two bytes")
}

@test fun a_char_literal_is_one_element_per_character(): void {
    val elements = TextUnit.Character.elements_of("é!", no_span())
    assert_eq(elements.size(), 2 as uint64, "two characters")
}
