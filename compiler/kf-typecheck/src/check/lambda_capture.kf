// Values a lambda reads from its enclosing scope: found, classified, and
// rewritten through capture fields.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Intrinsic
import kf_core.ast.intern
import kf_core.ast.view
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.coerce_addr_of
import kf_core.ast.declaration.Param
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*
import kf_typecheck.check.borrow.type_borrows

pub enum CaptureMode {
    Shared
    Mutable
    OwnedRead
    OwnedMutable
    Owned
}

pub struct LambdaCapture {
    pub val name: String
    pub var mode: CaptureMode
}

pub fun collect_captures(body: &List<Stmt>, params: &List<Param>, ctx: &var TypeCtx): List<LambdaCapture> {
    var found = List.new<LambdaCapture>()
    var locals = List.new<String>()
    gather_free_names_stmts(body, params, ctx, &var found, &var locals)
    return found
}

/// Carries what the body has bound so far: a name is local only after its
/// own initializer, so `val n = n` captures the outer `n`.
fun gather_free_names_stmts(stmts: &List<Stmt>, params: &List<Param>, ctx: &var TypeCtx, found: &var List<LambdaCapture>, locals: &var List<String>): void {
    while stmt in &stmts {
        (stmt).gather_free_names_stmt(params, ctx, found, locals)
    }
}

fun Stmt.gather_free_names_stmt(params: &List<Param>, ctx: &var TypeCtx, found: &var List<LambdaCapture>, locals: &var List<String>): void {
    when (self.kind) {
        LetVal(name, _ty, init_ptr) => {
            gather_free_names(init_ptr.view(), params, ctx, found, locals)
            locals.push(name.as_string())
        }
        LetVar(name, _ty, init_ptr) => {
            gather_free_names(init_ptr.view(), params, ctx, found, locals)
            locals.push(name.as_string())
        }
        Assign(_n, expr_ptr) => gather_free_names(expr_ptr, params, ctx, found, locals)
        AssignTo(place_ptr, expr_ptr) => {
            gather_free_names(place_ptr, params, ctx, found, locals)
            gather_free_names(expr_ptr, params, ctx, found, locals)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            gather_free_names(ep, params, ctx, found, locals)
        }
        Expression(expr_ptr) => gather_free_names(expr_ptr, params, ctx, found, locals)
        If(cond_ptr, then_body, else_body) => {
            gather_free_names(cond_ptr, params, ctx, found, locals)
            gather_free_names_nested(&then_body, params, ctx, found, locals)
            gather_free_names_nested(&else_body, params, ctx, found, locals)
        }
        While(cond_ptr, body) => {
            gather_free_names(cond_ptr, params, ctx, found, locals)
            gather_free_names_nested(&body, params, ctx, found, locals)
        }
        ForEach(binder, subj_ptr, body) => {
            gather_free_names(subj_ptr, params, ctx, found, locals)
            var inner = clone_name_list(locals)
            inner.push(binder.as_string())
            gather_free_names_stmts(&body, params, ctx, found, &var inner)
        }
        When(subj_ptr, arms) => {
            gather_free_names(subj_ptr, params, ctx, found, locals)
            while arm in &arms {
                gather_free_names(arm.guard.view(), params, ctx, found, locals)
                gather_free_names_nested(arm.body, params, ctx, found, locals)
            }
        }
        _ => return
    }
}

/// A nested block's bindings die with it.
fun gather_free_names_nested(stmts: &List<Stmt>, params: &List<Param>, ctx: &var TypeCtx, found: &var List<LambdaCapture>, locals: &var List<String>): void {
    var inner = clone_name_list(locals)
    gather_free_names_stmts(stmts, params, ctx, found, &var inner)
}

fun clone_name_list(names: &List<String>): List<String> {
    var out = List.new<String>()
    while name in &names {
        out.push(name)
    }
    return out
}

fun name_in_list(names: &List<String>, target: str): bool {
    while name in &names {
        if name.as_str().equals(target) { return true }
    }
    return false
}

/// After the body is typed, since mutability and coercions are semantic.
/// Owned beats Mutable beats Shared.
pub fun classify_captures(body: &List<Stmt>, captures: &var List<LambdaCapture>, ctx: &var TypeCtx): void {
    while item in &body {
        (item).classify_capture_stmt(captures, ctx)
    }
}

/// Initializers and returns take ownership; conditions read.
fun Stmt.classify_capture_stmt(captures: &var List<LambdaCapture>, ctx: &var TypeCtx): void {
    when (self.kind) {
        LetVal(_n, _ty, init_ptr) => classify_capture_expr(init_ptr.view(), true, captures, ctx)
        LetVar(_n, _ty, init_ptr) => classify_capture_expr(init_ptr.view(), true, captures, ctx)
        Assign(_n, expr_ptr) => classify_capture_expr(expr_ptr, true, captures, ctx)
        AssignTo(place_ptr, expr_ptr) => {
            classify_capture_expr(place_ptr, false, captures, ctx)
            classify_capture_expr(expr_ptr, true, captures, ctx)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            classify_capture_expr(ep, true, captures, ctx)
        }
        Expression(expr_ptr) => classify_capture_expr(expr_ptr, true, captures, ctx)
        If(cond_ptr, then_body, else_body) => {
            classify_capture_expr(cond_ptr, false, captures, ctx)
            classify_captures(&then_body, captures, ctx)
            classify_captures(&else_body, captures, ctx)
        }
        While(cond_ptr, body) => {
            classify_capture_expr(cond_ptr, false, captures, ctx)
            classify_captures(&body, captures, ctx)
        }
        ForEach(_b, subj_ptr, body) => {
            classify_capture_expr(subj_ptr, false, captures, ctx)
            classify_captures(&body, captures, ctx)
        }
        When(subj_ptr, arms) => {
            classify_capture_expr(subj_ptr, false, captures, ctx)
            while arm in &arms {
                classify_capture_expr(arm.guard.view(), false, captures, ctx)
                classify_captures(arm.body, captures, ctx)
            }
        }
        _ => return
    }
}

/// A stored closure owns every capture, keeping whether its call needs a
/// mutable `self`.
pub fun own_stored_captures(captures: &var List<LambdaCapture>, span: Span, ctx: &var TypeCtx): bool {
    while i in 0..captures.size() {
        val name = captures.at(i).name.clone()
        val mode = captures.at(i).mode
        val ty = ctx.lookup(name.as_str())
        if ty.capture_type_cannot_escape(ctx.sigs) {
            val message = "stored lambda cannot capture borrow-typed `${name}`; pass the lambda directly to a call instead"
            val label = new_label(span, message)
            ctx.diags.emit(new_diagnostic(Severity.Error, label))
            return false
        }
        val owned_mode = when (mode) {
            Shared => CaptureMode.OwnedRead
            Mutable => CaptureMode.OwnedMutable
            _ => mode
        }
        unsafe { captures.at_mut(i).mode = owned_mode }
    }
    return true
}

fun Type.capture_type_cannot_escape(sigs: Ptr<SigTable>): bool {
    if self.type_borrows(sigs) { return true }
    return when (self.kind) {
        Generic(_) => true
        DynTraitTy(_) => true
        _ => false
    }
}

fun gather_free_names(p_opt: Ptr<Expr>?, params: &List<Param>, ctx: &var TypeCtx, found: &var List<LambdaCapture>, locals: &var List<String>): void {
    val p = p_opt ?: return
    when (unsafe { p.kind }) {
        Variable(nm) => note_free_name(nm, params, ctx, found, locals)
        Binary(lp, _op, rp) => {
            gather_free_names(lp, params, ctx, found, locals)
            gather_free_names(rp, params, ctx, found, locals)
        }
        Unary(_op, ip) => gather_free_names(ip, params, ctx, found, locals)
        Deref(ip) => gather_free_names(ip, params, ctx, found, locals)
        MethodCall(recv_ptr, _m, args) => {
            gather_free_names(recv_ptr, params, ctx, found, locals)
            gather_free_names_list(&args, params, ctx, found, locals)
        }
        // Unchecked yet: a call through a local function value still names it.
        Call(nm, args) => {
            if nm.local_is_function_value(ctx) { note_free_name(nm, params, ctx, found, locals) }
            gather_free_names_list(&args, params, ctx, found, locals)
        }
        Intrinsic(_intrinsic, args) => gather_free_names_list(&args, params, ctx, found, locals)
        CallValue(callee, args) => {
            gather_free_names(callee, params, ctx, found, locals)
            gather_free_names_list(&args, params, ctx, found, locals)
        }
        FieldAccess(obj_ptr, _f) => gather_free_names(obj_ptr, params, ctx, found, locals)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            gather_free_names(c_ptr, params, ctx, found, locals)
            gather_free_names(t_ptr, params, ctx, found, locals)
            gather_free_names(e_ptr, params, ctx, found, locals)
        }
        StructLit(_nm, finits) => {
            while finit in &finits {
                gather_free_names(finit.value, params, ctx, found, locals)
            }
        }
        Cast(ip, _tref) => gather_free_names(ip, params, ctx, found, locals)
        WhenExpr(subj_ptr, arms) => {
            gather_free_names(subj_ptr, params, ctx, found, locals)
            while arm in &arms {
                gather_free_names(arm.guard.view(), params, ctx, found, locals)
                gather_free_names_nested(arm.body, params, ctx, found, locals)
            }
        }
        _ => return
    }
}

fun gather_free_names_list(args: &List<Expr>, params: &List<Param>, ctx: &var TypeCtx, found: &var List<LambdaCapture>, locals: &var List<String>): void {
    while i in 0..args.size() {
        gather_free_names(unsafe { args.at(i) as Ptr<Expr> }, params, ctx, found, locals)
    }
}

fun classify_capture_expr(p_opt: Ptr<Expr>?, consumed: bool, captures: &var List<LambdaCapture>, ctx: &var TypeCtx): void {
    val p = p_opt ?: return
    when (unsafe { p.kind }) {
        Variable(nm) => {
            if consumed && capture_owns_value(unsafe { p.ty }) {
                strengthen_capture(captures, nm.as_str(), CaptureMode.Owned)
            }
        }
        Binary(lp, _op, rp) => {
            classify_capture_expr(lp, true, captures, ctx)
            classify_capture_expr(rp, true, captures, ctx)
        }
        Unary(_op, ip) => classify_capture_expr(ip, true, captures, ctx)
        Deref(ip) => classify_capture_expr(ip, false, captures, ctx)
        MethodCall(recv_ptr, method, args) => {
            val root = place_root_name(unsafe { *recv_ptr })
            if method_is_mutating(unsafe { &recv_ptr.ty }, method.as_string(), args.size(), ctx) {
                strengthen_capture(captures, root.as_str(), CaptureMode.Mutable)
            }
            classify_capture_expr(recv_ptr, false, captures, ctx)
            classify_capture_args(&args, captures, ctx)
        }
        Call(_nm, args) => classify_capture_args(&args, captures, ctx)
        Intrinsic(_intrinsic, args) => classify_capture_args(&args, captures, ctx)
        CallValue(callee, args) => {
            classify_capture_expr(callee, false, captures, ctx)
            classify_capture_args(&args, captures, ctx)
        }
        FieldAccess(obj_ptr, _f) => classify_capture_expr(obj_ptr, consumed, captures, ctx)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            classify_capture_expr(c_ptr, false, captures, ctx)
            classify_capture_expr(t_ptr, consumed, captures, ctx)
            classify_capture_expr(e_ptr, consumed, captures, ctx)
        }
        StructLit(_nm, finits) => {
            while finit in &finits {
                classify_capture_expr(finit.value, true, captures, ctx)
            }
        }
        Cast(ip, _tref) => classify_capture_expr(ip, consumed, captures, ctx)
        WhenExpr(subj_ptr, arms) => {
            classify_capture_expr(subj_ptr, false, captures, ctx)
            while arm in &arms {
                classify_capture_expr(arm.guard.view(), false, captures, ctx)
                classify_captures(arm.body, captures, ctx)
            }
        }
        _ => return
    }
}

fun classify_capture_args(args: &List<Expr>, captures: &var List<LambdaCapture>, ctx: &var TypeCtx): void {
    while i in 0..args.size() {
        val arg = args.at(i)
        classify_capture_expr(unsafe { arg as Ptr<Expr> }, arg.coerce != coerce_addr_of(), captures, ctx)
    }
}

fun capture_owns_value(ty: Type): bool {
    return when (ty.kind) {
        Struct(_) => true
        EnumTy(_) => true
        BoxOf(_) => true
        _ => false
    }
}

fun strengthen_capture(captures: &var List<LambdaCapture>, name: str, mode: CaptureMode): void {
    val i = capture_index(captures, name)
    if i >= captures.size() { return }
    val current = *captures.at(i)
    if capture_mode_rank(mode) <= capture_mode_rank(current.mode) { return }
    unsafe { captures.at_mut(i).mode = mode }
}

fun capture_mode_rank(mode: CaptureMode): uint8 {
    return when (mode) {
        Shared => 0
        Mutable => 1
        OwnedRead => 2
        OwnedMutable => 2
        Owned => 3
    }
}

pub fun capture_needs_mutating_call(captures: &List<LambdaCapture>): bool {
    while capture in &captures {
        when (capture.mode) {
            Shared => { }
            OwnedRead => { }
            _ => return true
        }
    }
    return false
}

pub fun rewrite_captures_in_stmts(stmts: &List<Stmt>, captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    while stmt in &stmts {
        (stmt).rewrite_captures_stmt(captures, span, locals)
    }
}

/// Shadows as the collection walk does.
fun Stmt.rewrite_captures_stmt(captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    when (self.kind) {
        LetVal(name, _ty, init_ptr) => {
            rewrite_captures_to_fields(init_ptr.view(), captures, span, locals)
            locals.push(name.as_string())
        }
        LetVar(name, _ty, init_ptr) => {
            rewrite_captures_to_fields(init_ptr.view(), captures, span, locals)
            locals.push(name.as_string())
        }
        Assign(_n, expr_ptr) => rewrite_captures_to_fields(expr_ptr, captures, span, locals)
        AssignTo(place_ptr, expr_ptr) => {
            rewrite_captures_to_fields(place_ptr, captures, span, locals)
            rewrite_captures_to_fields(expr_ptr, captures, span, locals)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            rewrite_captures_to_fields(ep, captures, span, locals)
        }
        Expression(expr_ptr) => rewrite_captures_to_fields(expr_ptr, captures, span, locals)
        If(cond_ptr, then_body, else_body) => {
            rewrite_captures_to_fields(cond_ptr, captures, span, locals)
            rewrite_captures_nested(&then_body, captures, span, locals)
            rewrite_captures_nested(&else_body, captures, span, locals)
        }
        While(cond_ptr, body) => {
            rewrite_captures_to_fields(cond_ptr, captures, span, locals)
            rewrite_captures_nested(&body, captures, span, locals)
        }
        ForEach(binder, subj_ptr, body) => {
            rewrite_captures_to_fields(subj_ptr, captures, span, locals)
            var inner = clone_name_list(locals)
            inner.push(binder.as_string())
            rewrite_captures_in_stmts(&body, captures, span, &var inner)
        }
        When(subj_ptr, arms) => {
            rewrite_captures_to_fields(subj_ptr, captures, span, locals)
            while arm in &arms {
                rewrite_captures_to_fields(arm.guard.view(), captures, span, locals)
                rewrite_captures_nested(arm.body, captures, span, locals)
            }
        }
        _ => return
    }
}

fun rewrite_captures_nested(stmts: &List<Stmt>, captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    var inner = clone_name_list(locals)
    rewrite_captures_in_stmts(stmts, captures, span, &var inner)
}

fun rewrite_captures_to_fields(p_opt: Ptr<Expr>?, captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    val p = p_opt ?: return
    when (unsafe { p.kind }) {
        Variable(nm) => {
            if name_in_list(locals, nm.as_str()) { return }
            val i = capture_index(captures, nm.as_str())
            if i >= captures.size() { return }
            val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *recv = Expr.new(span, ExprKind.Variable(intern("self"))) }
            when (captures.at(i).mode) {
                Owned => unsafe { p.kind = ExprKind.FieldAccess(recv, nm) }
                OwnedRead => unsafe { p.kind = ExprKind.FieldAccess(recv, nm) }
                OwnedMutable => unsafe { p.kind = ExprKind.FieldAccess(recv, nm) }
                _ => {
                    val field: Ptr<Expr> = unsafe { alloc<Expr>() }
                    unsafe { *field = Expr.new(span, ExprKind.FieldAccess(recv, nm)) }
                    unsafe { p.kind = ExprKind.Deref(field) }
                }
            }
        }
        Binary(lp, _op, rp) => {
            rewrite_captures_to_fields(lp, captures, span, locals)
            rewrite_captures_to_fields(rp, captures, span, locals)
        }
        Unary(_op, ip) => rewrite_captures_to_fields(ip, captures, span, locals)
        Deref(ip) => rewrite_captures_to_fields(ip, captures, span, locals)
        MethodCall(recv_ptr, _m, args) => {
            rewrite_captures_to_fields(recv_ptr, captures, span, locals)
            rewrite_captures_list(&args, captures, span, locals)
        }
        Call(nm, args) => {
            rewrite_captures_list(&args, captures, span, locals)
            if name_in_list(locals, nm.as_str()) || capture_index(captures, nm.as_str()) >= captures.size() { return }
            // A captured function value is called through its field.
            val callee = Box.new(Expr.new(span, ExprKind.Variable(nm)))
            rewrite_captures_to_fields(callee, captures, span, locals)
            unsafe { p.kind = ExprKind.CallValue(callee, args) }
        }
        Intrinsic(_intrinsic, args) => rewrite_captures_list(&args, captures, span, locals)
        CallValue(callee, args) => {
            rewrite_captures_to_fields(callee, captures, span, locals)
            rewrite_captures_list(&args, captures, span, locals)
        }
        FieldAccess(obj_ptr, _f) => rewrite_captures_to_fields(obj_ptr, captures, span, locals)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            rewrite_captures_to_fields(c_ptr, captures, span, locals)
            rewrite_captures_to_fields(t_ptr, captures, span, locals)
            rewrite_captures_to_fields(e_ptr, captures, span, locals)
        }
        StructLit(_nm, finits) => {
            while finit in &finits {
                rewrite_captures_to_fields(finit.value, captures, span, locals)
            }
        }
        Cast(ip, _tref) => rewrite_captures_to_fields(ip, captures, span, locals)
        WhenExpr(subj_ptr, arms) => {
            rewrite_captures_to_fields(subj_ptr, captures, span, locals)
            while arm in &arms {
                rewrite_captures_to_fields(arm.guard.view(), captures, span, locals)
                rewrite_captures_nested(arm.body, captures, span, locals)
            }
        }
        _ => return
    }
}

fun rewrite_captures_list(args: &List<Expr>, captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    while i in 0..args.size() {
        rewrite_captures_to_fields(unsafe { args.at(i) as Ptr<Expr> }, captures, span, locals)
    }
}

fun capture_index(captures: &List<LambdaCapture>, name: str): uint64 {
    while i in 0..captures.size() {
        if captures.at(i).name.as_str().equals(name) { return i }
    }
    return captures.size()
}

fun param_named(params: &List<Param>, name: str): bool {
    while param in &params {
        if param.name.as_str().equals(name) { return true }
    }
    return false
}
