// An array, a list, or a borrow of one, where a slice is expected: it lends
// itself through its `as_slice()` or `as_slice_mut()`, so `sum(xs)` reads
// as `sum(xs.as_slice())`.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.type_eq
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.display_type

/// The method a source calls to lend itself as the slice `expected` is, and
/// the element both hold.
struct SliceLend {
    val method: String
    val element: Type
}

/// True when the node was rewritten into the lending call.
mutating fun Expr.lend_as_slice(expected: &Type, ctx: &var TypeCtx): bool {
    if self.ty.is_poison() || self.ty.type_eq(*expected) { return false }
    val lend = expected.slice_lend(ctx) ?: return false
    val source = self.ty.deref_one().sliceable_element(lend.method.as_str(), ctx) ?: return false
    if !source.type_eq(lend.element) { return false }
    if lend.method.as_str() == "as_slice_mut" && !self.lends_mutably(expected, ctx) {
        self.ty = Type.new_poison()
        return true
    }
    self.become_lend_call(lend.method.as_str(), ctx)
    return true
}

/// `self.method()`, checked. The receiver is a copy, so the node shares
/// nothing with it.
mutating fun Expr.become_lend_call(method: str, ctx: &var TypeCtx): void {
    val receiver = self.clone()
    *self = Expr.new(receiver.span, ExprKind.MethodCall(Box.new(receiver), intern(method), List.new<Expr>()))
    check_expr(self, ctx)
}

/// A list literal where a shared slice is expected builds an array in place
/// and lends that, so `sum([1, 2, 3])` allocates nothing. So does a string
/// literal where a slice of `uint8` or `char` is.
mutating fun Expr.lend_literal_as_slice(expected: &Type, ctx: &var TypeCtx): bool {
    val lend = expected.slice_lend(ctx) ?: return false
    if lend.method.as_str() != "as_slice" { return false }
    val text_length = self.text_literal_length(&lend.element)
    if text_length == null && !self.is_empty_list_literal(ctx) && !self.is_array_literal() { return false }
    val length = text_length ?: self.literal_elements().size()
    val element = lend.element.written_instance(self.span, ctx)
    val array = array_type_ref(element, length, ctx.array_name(), self.span).resolve_type_ref(ctx)
    val built = if text_length != null { self.retarget_string_literal(array.clone(), ctx) } else {
        self.retarget_array_literal(array, ctx)
    }
    if !built || self.ty.is_poison() { return true }
    self.become_lend_call("as_slice", ctx)
    return true
}

/// A mutable slice is lent only by a mutable place or a `&var` borrow;
/// reported otherwise.
fun Expr.lends_mutably(expected: &Type, ctx: &var TypeCtx): bool {
    val borrowed = when (self.ty.kind) {
        RefTo(mutable, _) => Option.Some(mutable)
        _ => null
    }
    if borrowed == null && self.place_is_mutable(ctx) { return true }
    if borrowed == Option.Some(true) { return true }
    val fix = if borrowed != null { "borrow it with `&var`" } else { "declare it with `var`" }
    val message = "cannot lend this as `${expected.display_type(ctx)}`, which writes through to it: ${fix}"
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    return false
}

/// What lending into `self`, a slice type, calls.
fun Type.slice_lend(ctx: &var TypeCtx): SliceLend? {
    val inst = self.expected_inst(ctx) ?: return null
    if inst.args.size() != 1 { return null }
    val base = inst.base.as_str()
    val shared = base == ctx.slice_name().as_str()
    if !shared && base != ctx.slice_mut_name().as_str() { return null }
    val method = if shared { "as_slice" } else { "as_slice_mut" }
    return SliceLend { method: String.from(method), element: inst.args.at(0).resolve_type_ref(ctx) }
}

/// The element of an array or list, or of a mutable slice lent as a shared
/// one.
fun Type.sliceable_element(method: str, ctx: &var TypeCtx): Type? {
    val inst = self.expected_inst(ctx) ?: return null
    val base = inst.base.as_str()
    val lends = base == ctx.array_name().as_str() || base == ctx.list_name().as_str() ||
        (method == "as_slice" && base == ctx.slice_mut_name().as_str())
    if !lends || inst.args.size() == 0 { return null }
    return inst.args.at(0).resolve_type_ref(ctx)
}

/// The type a borrow refers to, or the type itself.
fun Type.deref_one(): Type {
    return when (self.kind) {
        RefTo(_, _) => deref_target(self.clone())
        _ => self.clone()
    }
}

/// An instance of the library's mutable slice.
pub fun Type.is_slice_mut(ctx: &var TypeCtx): bool {
    val inst = self.expected_inst(ctx) ?: return false
    return inst.base.as_str() == ctx.slice_mut_name().as_str()
}

/// The instance of `param`, a slice, that `self` lends itself as, by its
/// mangled name: an `int64[4]` lends as `Slice<int64>`.
pub fun Type.lent_slice_name(param: &Type, ctx: &var TypeCtx): String? {
    val lend = param.slice_lend(ctx) ?: return null
    val target = param.expected_inst(ctx) ?: return null
    val source = self.deref_one()
    if source.sliceable_element(lend.method.as_str(), ctx) == null { return null }
    val inst = source.expected_inst(ctx) ?: return null
    var args = List.new<TypeRef>()
    args.push(inst.args.at(0).clone())
    // Resolved rather than mangled, so the instance is recorded for the
    // coercion that follows.
    val lent = TypeRef.new(no_span(), TypeRefKind.Named(intern(target.base.as_str()), args)).resolve_type_ref(ctx)
    return when (lent.kind) {
        Struct(name) => name.as_string()
        _ => null
    }
}
