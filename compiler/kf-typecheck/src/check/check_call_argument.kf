import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.expression.Expr

// A lambda may only be the direct value passed to a call.
mutating fun Expr.check_call_argument(ctx: &var TypeCtx): void {
    when (self.kind) {
        Lambda(_params, _body) => {
            ctx.in_call_arg = ctx.in_call_arg + 1
            check_expr(self, ctx)
            ctx.in_call_arg = ctx.in_call_arg - 1
        }
        _ => {
            check_expr(self, ctx)
            self.reject_stored_lambda_transfer("a call argument", ctx)
        }
    }
}

/// Types the arguments in place before the callee resolves, since mono needs
/// a nested receiver's type even when the callee does not resolve. A lambda
/// with a bare parameter waits for `expect_lambda_call_args`.
fun type_call_arguments(args: &var List<Expr>, ctx: &var TypeCtx): List<Type> {
    val pretyped = ctx.take_pretyped_args()
    var arg_tys = List.new<Type>()
    while i in 0..args.size() {
        val a = args.at_mut(i)
        if a.lambda_wants_expectation() {
            arg_tys.push(Type.new_poison())
        } else {
            if i >= pretyped { a.check_call_argument(ctx) }
            arg_tys.push(a.ty.clone())
        }
    }
    return arg_tys
}
