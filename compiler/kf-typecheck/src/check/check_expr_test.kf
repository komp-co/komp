    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("ghost"), args))
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.is_poison(), true, "unknown method → poison")
}

@test fun field_access_on_struct(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("P"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }

    ctx.declare(String.from("p"), Type { kind: TypeKind.Struct(intern("P")), provenance: Provenance.Declared(no_span()) })
    val obj_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *obj_ptr = Expr.new(no_span(), ExprKind.Variable(intern("p"))) }
    var e = Expr.new(no_span(), ExprKind.FieldAccess(obj_ptr, intern("x")))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 for p.x")
    }
}

@test fun resolve_type_ref_bare_name_no_mangle(): void {
    var ctx = mk_ctx()
    val tab = ctx.table ?: return
    val name = String.from("Foo")
    val _ = unsafe { tab.insert(name) }
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern("Foo"), List.new<TypeRef>()))
    val t = tr.resolve_type_ref(&var ctx)
    when (t.kind) {
        Struct(n) => assert_eq(n.as_str(), "Foo", "bare name → no mangle")
        _ => fail("expected Struct(Foo)")
    }
}

@test fun resolve_type_ref_single_arg_mangle(): void {
    var ctx = mk_ctx()
    val tab = ctx.table ?: return
    val name = String.from("List")
    val _ = unsafe { tab.insert(name) }
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())))
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), args))
    val t = tr.resolve_type_ref(&var ctx)
    when (t.kind) {
        Struct(n) => assert_eq(n.as_str(), "List__String", "List<String> → List__String")
        _ => fail("expected Struct(List__String)")
    }
}

@test fun resolve_type_ref_nested_generic_mangle(): void {
    var ctx = mk_ctx()
    val tab = ctx.table ?: return
    val name = String.from("List")
    val _ = unsafe { tab.insert(name) }
    var inner_args = List.new<TypeRef>()
    inner_args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())))
    val inner = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), inner_args))
    var outer_args = List.new<TypeRef>()
    outer_args.push(inner)
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), outer_args))
    val t = tr.resolve_type_ref(&var ctx)
    when (t.kind) {
        Struct(n) => assert_eq(n.as_str(), "List__List__String", "List<List<String>> → List__List__String")
        _ => fail("expected Struct(List__List__String)")
    }
}

@test fun alloc_array_call_types_as_ptr(): void {
    var ctx = mk_ctx()
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(4)))
    var e = Expr.new(no_span(), ExprKind.Intrinsic(Intrinsic.AllocArray, args))
    e.type_args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        PtrTo(p) => {
            val inner = unsafe { *p }
            val expected = Type.new_int32(no_span())
            assert_eq(inner.type_eq(expected), true, "alloc_array<int32> -> Ptr<int32>")
        }
        _ => fail("expected PtrTo result for alloc_array<int32>")
    }
}

@test fun an_intrinsic_without_its_type_argument_is_reported(): void {
    var ctx = mk_ctx()
    var e = Expr.new(no_span(), ExprKind.Intrinsic(Intrinsic.Sizeof, List.new<Expr>()))
    check_expr(&var e, &var ctx)
    assert_eq(ctx.diags.has_errors(), true, "`sizeof<>()` names no type")
}

@test fun box_new_types_as_boxof(): void {
    var ctx = mk_ctx()
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(7)))
    val recvp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recvp = Expr.new(no_span(), ExprKind.Variable(intern("Box"))) }
    var e = Expr.new(no_span(), ExprKind.MethodCall(recvp, intern("new"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        BoxOf(p) => {
            val inner = unsafe { *p }
            when (inner.kind) {
                Int32 => assert(true, "Box.new(7) -> Box<int32>")
                _ => fail("expected Box<int32>")
            }
        }
        _ => fail("expected BoxOf result")
    }
}

@test
fun resolve_type_ref_qualifies_the_current_module_type(): void {
    var ctx = mk_ctx()
    ctx.owner_crate = new_crate_id("left")
    ctx.owner_module = intern("models")
    val tab = ctx.table ?: return
    unsafe { tab.insert(String.from("Point")) }
    val sp = ctx.sigs
    unsafe { sp.insert_type_identity(TypeIdentity.new(new_crate_id("left"), intern("models"), intern("Point"))) }
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern("Point"), List.new<TypeRef>()))
    val ty = tr.resolve_type_ref(&var ctx)
    when (ty.kind) {
        Struct(actual) => assert_eq(type_identity_matches(actual, TypeIdentity.new(new_crate_id("left"), intern("models"), intern("Point"))), true, "resolved type uses the declaration owner")
        _ => fail("expected Struct")
    }
}

@test
fun alloc_intrinsic_preserves_qualified_type_argument(): void {
    var ctx = mk_ctx()
    ctx.owner_crate = new_crate_id("left")
    ctx.owner_module = intern("models")
    val tab = ctx.table ?: return
    unsafe { tab.insert(String.from("Point")) }
    val sp = ctx.sigs
    unsafe { sp.insert_type_identity(TypeIdentity.new(new_crate_id("left"), intern("models"), intern("Point"))) }
    var e = Expr.new(no_span(), ExprKind.Intrinsic(Intrinsic.Alloc, List.new<Expr>()))
    e.type_args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("Point"), List.new<TypeRef>())))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        PtrTo(inner) => {
            when (unsafe { inner.kind }) {
                Struct(actual) => assert_eq(type_identity_matches(actual, TypeIdentity.new(new_crate_id("left"), intern("models"), intern("Point"))), true, "alloc preserves the qualified argument type")
                _ => fail("expected qualified Point")
            }
        }
        _ => fail("expected PtrTo")
    }
}

@test
fun resolve_type_ref_uses_unambiguous_imported_type(): void {
    var ctx = mk_ctx()
    ctx.owner_crate = new_crate_id("consumer")
    ctx.owner_module = intern("main")
    val tab = ctx.table ?: return
    unsafe { tab.insert(String.from("Span")) }
    val sp = ctx.sigs
    val expected = TypeIdentity.new(new_crate_id("core"), intern("span"), intern("Span"))
    unsafe { sp.insert_type_identity(expected) }
    val tr = TypeRef.new(no_span(), TypeRefKind.Named(intern("Span"), List.new<TypeRef>()))
    val ty = tr.resolve_type_ref(&var ctx)
    when (ty.kind) {
        Struct(actual) => assert_eq(type_identity_matches(actual, expected), true, "unambiguous imported type keeps its declaration identity")
        _ => fail("expected Struct")
    }
}

