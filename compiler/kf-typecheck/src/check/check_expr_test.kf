    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("x"))) }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("area"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 from Foo.area()")
