// `clone` and `equals` on a String resolve.
@test fun string_clone_returns_string(): void {
    var ctx = mk_ctx()
    ctx.declare(String.from("s"), intern("String").lang_struct_ty(no_span()))
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("s"))) }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("clone"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Struct(name) => assert_eq(name.as_str(), "String", "String.clone returns String")
        _ => fail("expected String from String.clone()")
    }
}

// `equals` on a String resolves from the sig table, registered as core's
// `impl Equal for String` would be.
@test fun string_equals_returns_bool(): void {
    var ctx = mk_ctx()
    var params = List.new<Type>()
    params.push(intern("String").lang_struct_ty(no_span()))
    params.push(intern("String").lang_struct_ty(no_span()))
    unsafe { (*ctx.sigs).insert(FnSignature { name: String.from("String_equals"), params: params, ret: Type.new_bool(no_span()), generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern(""), owner_crate: crate_id_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }) }
    ctx.declare(String.from("s"), intern("String").lang_struct_ty(no_span()))
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("s"))) }
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitStr(String.from("x"))))
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("equals"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected bool from String.equals()")
    }
}

@test fun method_call_unknown_method_is_poison(): void {
    var ctx = mk_ctx()
    ctx.declare(String.from("x"), Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(no_span()) })
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
