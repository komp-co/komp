    vs.push(VariantInfo { name: String.from("Err"), payloads: List.new<Type>() })
    unsafe { sp.insert_enum(EnumLayout { name: String.from("Result"), variants: vs, owner_crate: crate_id_poison() }) }
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("Result"))) }
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(42)))
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("Ok"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        EnumTy(n) => assert_eq(n.as_str(), "Result", "got Result")
        _ => fail("expected EnumTy(Result)")
    }
}

