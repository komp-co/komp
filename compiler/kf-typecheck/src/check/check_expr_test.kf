// `write_file` types with no extern in scope, as under separate compilation.
@test fun write_file_call_types_void_without_sig(): void {
    var ctx = mk_ctx()
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitStr(String.from("/tmp/x"))))
    args.push(Expr.new(no_span(), ExprKind.LitStr(String.from("body"))))
    var e = Expr.new(no_span(), ExprKind.Call(intern("write_file"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Void => assert(true, "ok")
        _ => fail("expected void from the write_file intrinsic")
    }
}

@test fun write_file_string_content_arg_coerces_to_str(): void {
    var ctx = mk_ctx()
    ctx.declare(String.from("s"), intern("String").lang_struct_ty(no_span()))
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitStr(String.from("/tmp/x"))))
    args.push(Expr.new(no_span(), ExprKind.Variable(intern("s"))))
    var e = Expr.new(no_span(), ExprKind.Call(intern("write_file"), args))
    check_expr(&var e, &var ctx)
    val content = *args.at(1)
    assert_eq(content.coerce == coerce_none(), false, "String content arg records a str coercion")
}

@test
fun shared_reference_keeps_immutable_flag(): void {
    var ctx = mk_ctx()
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    val tr = TypeRef.new(no_span(), TypeRefKind.Reference(false, inner))
    val ty = tr.resolve_type_ref(&var ctx)
    when (ty.kind) {
        RefTo(mutable, _) => assert_eq(mutable, false, "&T stays shared")
        _ => assert_eq(false, true, "expected RefTo")
    }
}

@test
fun mutable_reference_keeps_mutable_flag(): void {
    var ctx = mk_ctx()
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    val tr = TypeRef.new(no_span(), TypeRefKind.Reference(true, inner))
    val ty = tr.resolve_type_ref(&var ctx)
    when (ty.kind) {
        RefTo(mutable, _) => assert_eq(mutable, true, "&var T stays mutable")
        _ => assert_eq(false, true, "expected RefTo")
    }
}

fun mk_borrow_ty(inner: Type, mutable: bool): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.RefTo(mutable, p), provenance: Provenance.Declared(no_span()) }
}

fun binary_over(a: str, op: BinOp, b: str): Expr {
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern(a))) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern(b))) }
    return Expr.new(no_span(), ExprKind.Binary(lhs_ptr, op, rhs_ptr))
}

mutating fun TypeCtx.register_prim_op(trait_name: str): void {
    val sp = self.sigs
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("int32"), receiver_identity: intern("int32"), trait_name: String.from(trait_name), trait_args: "", generics: "", arg_count: 0 }) }
}

// A borrowed operand types as its pointee.
@test fun a_borrowed_operand_types_as_its_pointee(): void {
    var ctx = mk_ctx()
    ctx.register_prim_op("Equal")
    ctx.declare(String.from("n"), mk_borrow_ty(Type.new_int32(no_span()), false))
    ctx.declare(String.from("m"), Type.new_int32(no_span()))
    var e = binary_over("n", BinOp.Eq, "m")
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected Bool from &int32 == int32")
    }
}

@test fun a_borrow_on_either_side_is_peeled(): void {
    var ctx = mk_ctx()
    ctx.register_prim_op("Add")
    ctx.declare(String.from("n"), mk_borrow_ty(Type.new_int32(no_span()), false))
    ctx.declare(String.from("m"), Type.new_int32(no_span()))
    var e = binary_over("m", BinOp.Add, "n")
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 from int32 + &int32")
    }
}

// Two borrows compare their pointees, not their addresses.
@test fun two_borrows_compare_their_pointees(): void {
    var ctx = mk_ctx()
    ctx.register_prim_op("Equal")
    ctx.declare(String.from("a"), mk_borrow_ty(Type.new_int32(no_span()), false))
    ctx.declare(String.from("b"), mk_borrow_ty(Type.new_int32(no_span()), true))
    var e = binary_over("a", BinOp.Eq, "b")
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected Bool from &int32 == &int32")
    }
}

// A borrow of a type without `Equal` is still an error.
@test fun two_borrows_still_need_the_operator_impl(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("Bare"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }
    val bare = Type { kind: TypeKind.Struct(intern("Bare")), provenance: Provenance.Declared(no_span()) }
    ctx.declare(String.from("a"), mk_borrow_ty(bare, false))
    ctx.declare(String.from("b"), mk_borrow_ty(bare, false))
    var e = binary_over("a", BinOp.Eq, "b")
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.is_poison(), true, "&Bare == &Bare without Equal is poison")
}

fun declared_struct_ty(identity: str): Type {
    return Type { kind: TypeKind.Struct(intern(identity)), provenance: Provenance.Inferred(no_span()) }
}

@test
fun the_impl_suggestion_drops_the_canonical_prefix(): void {
    val ty = declared_struct_ty("rprobe::rprobe::P")
    assert_eq(ty.source_type_name().as_str(), "P", "the reader pastes `impl Equal for P`, not the lookup key")
}

@test
fun the_impl_suggestion_leaves_a_bare_name_alone(): void {
    val ty = declared_struct_ty("P")
    assert_eq(ty.source_type_name().as_str(), "P", "a name with no encoded owner is already what source calls it")
}

@test
fun the_impl_suggestion_names_a_primitive_plainly(): void {
    assert_eq(source_type_name(&Type.new_int32(no_span())).as_str(), "int32", "a primitive has no owner to strip")
}
