    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("xs"))) }
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(0)))
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("get"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected int32 element from List__int32.get")
    }
}

