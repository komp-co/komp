import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.*
import kf_resolve.*
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.types.*
import kf_typecheck.leaked_diagnostics

pub fun mk_ctx(): TypeCtx {
    val table = new_decl_table()
    val sigs = new_sig_table()
    val tab_ptr: Ptr<DeclTable> = unsafe { alloc<DeclTable>() }
    unsafe { *tab_ptr = table }
    val sig_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sig_ptr = sigs }
    // A program built on alloc, whose `String` and `Option` are the lang ones.
    unsafe { (*sig_ptr).lang_string = intern("String") }
    unsafe { (*sig_ptr).lang_option = intern("Option") }
    unsafe { (*sig_ptr).note_lang_trait("equal", intern("Equal")) }
    unsafe { (*sig_ptr).note_lang_trait("clone", intern("Clone")) }
    unsafe { (*sig_ptr).note_lang_trait("drop", intern("Drop")) }
    unsafe { (*sig_ptr).note_lang_trait("hash", intern("Hash")) }
    unsafe { (*sig_ptr).note_lang_trait("default", intern("Default")) }
    unsafe { (*sig_ptr).note_lang_trait("add", intern("Add")) }
    unsafe { (*sig_ptr).note_lang_trait("sub", intern("Sub")) }
    unsafe { (*sig_ptr).note_lang_trait("mul", intern("Mul")) }
    unsafe { (*sig_ptr).note_lang_trait("div", intern("Div")) }
    unsafe { (*sig_ptr).note_lang_trait("compare", intern("Compare")) }
    return new_type_ctx(Type.new_void(no_span()), unsafe { &var *leaked_diagnostics() }, Option.Some(tab_ptr), sig_ptr)
}

@test fun lit_int_is_int32(): void {
    var ctx = mk_ctx()
    var e = Expr.new(no_span(), ExprKind.LitInt(42))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32")
    }
}

@test fun lit_bool_is_bool(): void {
    var ctx = mk_ctx()
    var e = Expr.new(no_span(), ExprKind.LitBool(true))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected Bool")
    }
}

@test fun int_add_int_is_int(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("int32"), receiver_identity: intern("int32"), trait_name: String.from("Add"), trait_args: "", generics: "", arg_count: 0 }) }
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.LitInt(1)) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.LitInt(2)) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Add, rhs_ptr))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 from int + int")
    }
}

@test fun bool_and_bool_is_bool(): void {
    var ctx = mk_ctx()
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.LitBool(true)) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.LitBool(false)) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.AndAnd, rhs_ptr))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected Bool from && of bools")
    }
}

@test fun call_unknown_fn_is_poison(): void {
    var ctx = mk_ctx()
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.Call(intern("ghost"), args))
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.is_poison(), true, "unknown call → poison")
}

@test fun call_known_fn_returns_sig_ret(): void {
    var ctx = mk_ctx()
    val params = List.new<Type>()
    val sig = FnSignature { name: String.from("answer"), params: params, ret: Type.new_int32(no_span()), generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern(""), owner_crate: crate_id_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }
    // Through a local: `(*ctx.sigs)` parses as `ctx.sigs`.
    val sp = ctx.sigs
    unsafe { sp.insert(sig) }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.Call(intern("answer"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 from sig.ret")
    }
}

@test fun int_plus_bool_emits_diagnostic(): void {
    var ctx = mk_ctx()
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.LitInt(1)) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.LitBool(true)) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Add, rhs_ptr))
    check_expr(&var e, &var ctx)
    val has_diag = e.ty.is_poison()
    assert_eq(has_diag, true, "result is poison")
}

// `==` on a struct without `Equal` is an error.
@test fun struct_eq_without_equal_impl_is_poison(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("Bare"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }
    ctx.declare(String.from("a"), Type { kind: TypeKind.Struct(intern("Bare")), provenance: Provenance.Declared(no_span()) })
    ctx.declare(String.from("b"), Type { kind: TypeKind.Struct(intern("Bare")), provenance: Provenance.Declared(no_span()) })
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("a"))) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("b"))) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Eq, rhs_ptr))
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.is_poison(), true, "struct == without Equal is poison")
}

// With `Equal`, struct `==` is bool.
@test fun struct_eq_with_equal_impl_is_bool(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("Eqd"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("Eqd"), receiver_identity: intern("Eqd"), trait_name: String.from("Equal"), trait_args: "", generics: "", arg_count: 0 }) }
    ctx.declare(String.from("a"), Type { kind: TypeKind.Struct(intern("Eqd")), provenance: Provenance.Declared(no_span()) })
    ctx.declare(String.from("b"), Type { kind: TypeKind.Struct(intern("Eqd")), provenance: Provenance.Declared(no_span()) })
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("a"))) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("b"))) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Eq, rhs_ptr))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "ok")
        _ => fail("expected Bool from Eqd == Eqd")
    }
}

@test fun string_eq_boxes_a_literal_operand(): void {
    var ctx = mk_ctx()
    register_string_with_equal_and_from(ctx.sigs)
    ctx.declare(String.from("value"), intern("String").lang_struct_ty(no_span()))
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("value"))) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.LitStr(String.from("value"))) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Eq, rhs_ptr))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Bool => assert(true, "String == literal is bool")
        _ => fail("expected bool from String == literal")
    }
}

