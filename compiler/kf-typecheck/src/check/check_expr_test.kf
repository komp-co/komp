@test fun method_call_records_its_resolved_callee(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    unsafe { sp.insert_struct(StructLayout { name: String.from("Foo"), fields: List.new<StructFieldInfo>(), is_refcounted: false, owner_crate: crate_id_poison() }) }
    var params = List.new<Type>()
    params.push(Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(no_span()) })
    unsafe { sp.insert(FnSignature { name: String.from("Foo_area"), params: params, ret: Type.new_int32(no_span()), generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern(""), owner_crate: crate_id_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }) }
    ctx.declare(String.from("x"), Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(no_span()) })
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("x"))) }
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("area"), List.new<Expr>()))
    check_expr(&var e, &var ctx)
    assert_eq(e.mangled_callee.as_str(), "Foo_area", "resolved method calls retain their exact callee")
}

// List container methods are not in the sig table but still type: `get` as
// the element, `size` as uint64.
