// With `Add`, struct `+` is the struct itself.
@test fun struct_add_with_add_impl_is_self(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("Vec"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("Vec"), receiver_identity: intern("Vec"), trait_name: String.from("Add"), trait_args: "", generics: "", arg_count: 0 }) }
    ctx.declare(String.from("a"), Type { kind: TypeKind.Struct(intern("Vec")), provenance: Provenance.Declared(no_span()) })
    ctx.declare(String.from("b"), Type { kind: TypeKind.Struct(intern("Vec")), provenance: Provenance.Declared(no_span()) })
    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("a"))) }
    val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs_ptr = Expr.new(no_span(), ExprKind.Variable(intern("b"))) }
    var e = Expr.new(no_span(), ExprKind.Binary(lhs_ptr, BinOp.Add, rhs_ptr))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Struct(nm) => assert_eq(nm.as_str(), "Vec", "Vec + Vec is Vec")
        _ => fail("expected Struct(Vec) from Vec + Vec")
    }
}

// `From<int32>` and `From<str>` on one target are different impls.
@test fun type_implements_distinguishes_trait_args(): void {
    val ctx = mk_ctx()
    val sp = ctx.sigs
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("Cel"), receiver_identity: intern("Cel"), trait_name: String.from("From"), trait_args: String.from("int32"), generics: "", arg_count: 1 }) }
    assert_eq(unsafe { sp.type_implements("Cel", "From", "int32") }, true, "From<int32> matches")
    assert_eq(unsafe { sp.type_implements("Cel", "From", "str") }, false, "From<str> != From<int32>")
    assert_eq(unsafe { sp.type_implements("Cel", "From", "") }, false, "bare From != From<int32>")
}

@test fun refcounted_bit_round_trips_through_layout(): void {
    val ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("data"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("RC"), fields: fs, is_refcounted: true, owner_crate: crate_id_poison() }) }
    val found = unsafe { sp.find_struct("RC", crate_id_poison()) }
    assert_eq(found.is_some(), true, "RC found")
    val layout = found ?: return
    assert_eq(layout.is_refcounted, true, "RC's is_refcounted bit preserved")
}

@test fun struct_lit_with_matching_fields(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var fs = List.new<StructFieldInfo>()
    fs.push(StructFieldInfo { name: String.from("x"), ty: Type.new_int32(no_span()), is_var: true })
    fs.push(StructFieldInfo { name: String.from("y"), ty: Type.new_int32(no_span()), is_var: true })
    unsafe { sp.insert_struct(StructLayout { name: String.from("Point"), fields: fs, is_refcounted: false, owner_crate: crate_id_poison() }) }

    var inits = List.new<FieldInit>()
    val xp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *xp = Expr.new(no_span(), ExprKind.LitInt(1)) }
    inits.push(FieldInit.new(no_span(), String.from("x"), xp))
    val yp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *yp = Expr.new(no_span(), ExprKind.LitInt(2)) }
    inits.push(FieldInit.new(no_span(), String.from("y"), yp))

    var e = Expr.new(no_span(), ExprKind.StructLit(intern("Point"), inits))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Struct(n) => assert_eq(n.as_str(), "Point", "result is Point")
        _ => fail("expected Struct(Point)")
    }
}

@test fun generic_fn_call_substitutes_ret_ty(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    // fun identity<T>(x: T): T
    var params = List.new<Type>()
    params.push(Type { kind: TypeKind.Generic(intern("T")), provenance: Provenance.Declared(no_span()) })
    val ret_ty = Type { kind: TypeKind.Generic(intern("T")), provenance: Provenance.Declared(no_span()) }
    val sig = FnSignature { name: String.from("identity"), params: params, ret: ret_ty, generics: List.new<String>(), is_static: false, is_mutating: false, owner_module: intern(""), owner_crate: crate_id_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }
    unsafe { sp.insert(sig) }
    // identity(42): T binds to int32
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitInt(42)))
    var e = Expr.new(no_span(), ExprKind.Call(intern("identity"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        Int32 => assert(true, "T → int32")
        _ => fail("expected Int32 from identity(42)")
    }
}

@test fun simple_variant_construction(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var vs = List.new<VariantInfo>()
    vs.push(VariantInfo { name: String.from("Error"), payloads: List.new<Type>() })
    vs.push(VariantInfo { name: String.from("Warning"), payloads: List.new<Type>() })
    unsafe { sp.insert_enum(EnumLayout { name: String.from("Severity"), variants: vs, owner_crate: crate_id_poison() }) }
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = Expr.new(no_span(), ExprKind.Variable(intern("Severity"))) }
    val args = List.new<Expr>()
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv_ptr, intern("Error"), args))
    check_expr(&var e, &var ctx)
    when (e.ty.kind) {
        EnumTy(n) => assert_eq(n.as_str(), "Severity", "got Severity")
        _ => fail("expected EnumTy(Severity)")
    }
}

@test fun payload_variant_construction_with_int_arg(): void {
    var ctx = mk_ctx()
    val sp = ctx.sigs
    var vs = List.new<VariantInfo>()
