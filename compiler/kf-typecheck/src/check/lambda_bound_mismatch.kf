// A lambda whose parameters are all written implements the `Call` trait its
// annotations spell. When that is not the one the bound asks for, the call
// names an impl that is never emitted, so the two are compared here.

import alloc.list.*

import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*

/// `expected` is the bound's parameter types. A slot that is unknown, or
/// still mentions one of the callee's type parameters `open` (`&T`), is not
/// compared.
fun Expr.report_written_params_against(expected: &List<Type>, open: &List<String>, ctx: &var TypeCtx): void {
    when (self.kind) {
        Lambda(params, _body) => {
            if params.size() != expected.size() { return }
            while k in 0..params.size() {
                val want = *expected.at(k)
                if want.is_poison() || want.mentions_any(open) { continue }
                val param = params.at(k)
                val written = (unsafe { &*param.ty }).resolve_quietly(ctx)
                if written.is_poison() || written.type_eq(want) { continue }
                val message = "lambda parameter `${param.name.as_str()}` is written `${written.display_type(ctx)}`, " +
                    "but the `Call` bound it is passed to asks for `${want.display_type(ctx)}`"
                ctx.emit(new_diagnostic(Severity.Error, new_label(param.span, message)))
            }
        }
        _ => { }
    }
}

/// Resolution without its diagnostics: the lambda's own check reports a bad
/// annotation.
fun TypeRef.resolve_quietly(ctx: &var TypeCtx): Type {
    val before = ctx.diags.items.size()
    val ty = self.resolve_type_ref(ctx)
    if ctx.diags.items.size() == before { return ty }
    while ctx.diags.items.size() > before {
        ctx.diags.items.pop()
    }
    return Type.new_poison()
}

/// Whether the type's mangled form has a segment naming one of `names`:
/// `&T` is `kf__ref__T`, `Option<T>` is `Option__T`.
pub fun Type.mentions_any(names: &List<String>): bool {
    if self.kind.kind_tag() == TAG_GENERIC() { return true }
    val mangled = mangle_type(self.clone())
    while segment in &mangled.as_str().split("__") {
        while name in &names {
            if segment.as_str().equals(name.as_str()) { return true }
        }
    }
    return false
}
