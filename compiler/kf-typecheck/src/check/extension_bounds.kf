// What an extension's bounds say about a receiver: whether they rule it out,
// how much they narrow, and how a blocked call is reported.

import alloc.list.*

import kf_core.span.no_span
import kf_core.span.Span
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.*
import kf_typecheck.traits.subst_trait_args
import kf_typecheck.traits.key_segments
import kf_typecheck.traits.str_list_has
import kf_core.ast.projection_mangle_display

/// "no method" with the reason, when an extension applies except for its
/// bound; false otherwise.
mutating fun Expr.report_blocked_extension(name: str, recv: &Type, ctx: &var TypeCtx): bool {
    val trait_name = bound_blocked_extension(name, recv, ctx)
    if trait_name.byte_len() == 0 { return false }
    val have = autoderef_ty(recv.clone())
    val shown = have.display_type(ctx)
    val type_name = shown.as_str()
    val why = "no method `${name}` on `${type_name}`: ${blocked_extension_owner(name, recv, ctx)} needs `${trait_name}`"
    var message = "${why}, which `${type_name}` does not implement"
    if have.kind.kind_tag() == TAG_GENERIC() {
        message = "${why}, which `${type_name}` is not bounded by; add it: `${type_name}: ${trait_name}`"
    }
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = Type.new_poison()
    return true
}

/// "" when none comes that close.
fun bound_blocked_extension(name: str, recv: &Type, ctx: &var TypeCtx): String {
    val sig = bound_blocked_signature(name, recv, ctx) ?: return ""
    return sig.first_unmet_bound(&autoderef_ty(recv.clone()), ctx)
}

fun blocked_extension_owner(name: str, recv: &Type, ctx: &var TypeCtx): String {
    val sig = bound_blocked_signature(name, recv, ctx) ?: return ""
    val on = extension_receiver_shown(sig.name.as_str(), &autoderef_ty(*sig.params.at(0)), ctx)
    return "`${on.as_str()}.${name}`"
}

fun bound_blocked_signature(name: str, recv: &Type, ctx: &var TypeCtx): FnSignature? {
    val names = unsafe { (*ctx.sigs).ext_names }
    val links = unsafe { (*ctx.sigs).ext_links }
    val have = autoderef_ty(recv.clone())
    while i in 0..names.size() {
        if names.get(i).as_str().equals(name) {
            when (unsafe { (*ctx.sigs).find_signature(links.get(i).as_str()) }) {
                Some(sig) => {
                    val blocked = sig.first_unmet_bound(&have, ctx).byte_len() > 0
                    if blocked && sig.extension_visible(ctx) { return sig }
                }
                None => { }
            }
        }
    }
    return null
}

/// As written: `Iterable<Point>` for a trait receiver.
fun extension_receiver_shown(link: str, receiver: &Type, ctx: &var TypeCtx): String {
    val param = unsafe { (*ctx.sigs).receiver_trait_param(link) }
    if param.byte_len() == 0 { return receiver.display_type(ctx) }
    val bounds = unsafe { (*ctx.sigs).bounds }
    while b in &bounds {
        if b.owner.as_str().equals(link) && b.param.as_str().equals(param.as_str()) { return b.bound_shown() }
    }
    return param
}

pub fun BoundInfo.bound_shown(): String {
    if self.trait_args.byte_len() == 0 { return self.trait_name.clone() }
    return "${self.trait_name}<${projection_mangle_display(self.trait_args.as_str())}>"
}

/// The first bound `binding` misses, or "". An unmet bound means the
/// extension does not apply at all. The caller's own parameter meets bounds
/// it declares.
fun FnSignature.unmet_bound(param: str, binding: &Type, ctx: &var TypeCtx): String {
    val link = self.name.as_str()
    val is_param = binding.kind.kind_tag() == TAG_GENERIC()
    val caller_param = if is_param { binding.kind.generic_name() } else { String.from("") }
    val bounds = unsafe { (*ctx.sigs).bounds }
    val no_names = List.new<String>()
    val no_types = List.new<Type>()
    while b in &bounds {
        if b.owner.as_str().equals(link) && b.param.as_str().equals(param) {
            if caller_param.byte_len() > 0 {
                if !owner_has_bound(ctx.fn_owner.clone(), caller_param.clone(), b.trait_name.clone(), ctx) {
                    return b.bound_shown()
                }
            } else {
                val args = subst_trait_args(b.trait_args.as_str(), &no_names, &no_types, false)
                if !bound_type_implements_here(binding, b.trait_name.as_str(), args, &self.generics, no_span(), ctx) {
                    return b.bound_shown()
                }
            }
        }
    }
    return ""
}

/// Over every parameter the receiver binds.
fun FnSignature.first_unmet_bound(have: &Type, ctx: &var TypeCtx): String {
    val want = autoderef_ty(*self.params.at(0))
    while g in &self.generics {
        val binding = want.bind_generic_from_param(have, g.as_str(), ctx)
        if !binding.is_poison() {
            val trait_name = self.unmet_bound(g.as_str(), &binding, ctx)
            if trait_name.byte_len() > 0 { return trait_name }
        }
    }
    return ""
}

/// 0 unbounded, 1 bounded, 2 when no bound argument names an extension
/// parameter.
fun FnSignature.bound_narrowing(param: str, ctx: &var TypeCtx): uint64 {
    val bounds = unsafe { (*ctx.sigs).bounds }
    var seen = false
    var closed = true
    while b in &bounds {
        if b.owner.as_str().equals(self.name.as_str()) && b.param.as_str().equals(param) {
            seen = true
            while seg in &key_segments(b.trait_args.as_str()) {
                if str_list_has(&self.generics, seg.as_str()) { closed = false }
            }
        }
    }
    if !seen { return 0 }
    if closed { return 2 }
    return 1
}

/// Suggests a bound; for a trait receiver's parameter, names the trait.
fun report_no_parameter_method(param: str, method: str, span: Span, ctx: &var TypeCtx): void {
    val trait_param = unsafe { (*ctx.sigs).receiver_trait_param(ctx.fn_owner.as_str()) }
    val fix = "declare a bound whose trait provides it: `${param}: SomeTrait`"
    var message = "no method `${method}` on type parameter `${param}` (${fix})"
    if trait_param.as_str().equals(param) {
        val shown = display_type(&Type.new_generic(String.from(param), span), ctx)
        message = "no method `${method}` on `self`: an extension on `${shown.as_str()}` has only that trait's methods"
    }
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}
