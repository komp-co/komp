// Per-file import bookkeeping: what each file imports, which imports a name
// came through, and where a new import line goes.

import alloc.list.*

import kf_core.ast.Sym

/// CONSTRAINT: recorded without a name: a method or type cannot be listed in
/// an import, so a wildcard carrying one cannot be narrowed.
pub fun note_import_use(sp: Ptr<SigTable>, file: uint32, module: Sym): void {
    note_import_use_named(sp, file, module, Sym { id: 0 })
}

/// One entry per distinct (file, module, name). Scanned backwards, since a
/// file's uses repeat in runs.
pub fun note_import_use_named(sp: Ptr<SigTable>, file: uint32, module: Sym, name: Sym): void {
    if file == 0 { return }
    if module.id == 0 { return }
    var i = unsafe { sp.used_files.size() }
    while i > 0 {
        i = i - 1
        if unsafe { sp.used_files.get(i) } == file {
            if unsafe { sp.used_modules.get(i).id } == module.id {
                if unsafe { sp.used_names.get(i).id } == name.id { return }
            }
        }
    }
    unsafe { sp.used_files.push(file) }
    unsafe { sp.used_modules.push(module) }
    unsafe { sp.used_names.push(name) }
}

/// In first-seen order. A poison entry means the import cannot be narrowed.
pub fun import_uses_of(sp: Ptr<SigTable>, file: uint32, module: Sym): List<Sym> {
    var out = List.new<Sym>()
    var i = 0
    while i < unsafe { sp.used_files.size() } {
        if unsafe { sp.used_files.get(i) } == file {
            if unsafe { sp.used_modules.get(i).id } == module.id {
                out.push(unsafe { sp.used_names.get(i) })
            }
        }
        i = i + 1
    }
    return out
}

pub fun import_was_used(sp: Ptr<SigTable>, file: uint32, module: Sym): bool {
    var i = 0
    while i < unsafe { sp.used_files.size() } {
        if unsafe { sp.used_files.get(i) } == file {
            if unsafe { sp.used_modules.get(i).id } == module.id { return true }
        }
        i = i + 1
    }
    return false
}

/// Keeps the last import's end: inserting after the block is always legal.
pub fun note_import_end(sp: Ptr<SigTable>, file: uint32, end: uint32): void {
    var i = 0
    while i < unsafe { sp.import_files.size() } {
        if unsafe { sp.import_files.get(i) } == file {
            if end > unsafe { sp.import_ends.get(i) } {
                unsafe { sp.import_ends.set(i, end) }
            }
            return
        }
        i = i + 1
    }
    unsafe { sp.import_files.push(file) }
    unsafe { sp.import_ends.push(end) }
}

/// Byte 0 with `false` when the file has no imports.
pub fun import_insert_at(sp: Ptr<SigTable>, file: uint32): uint32 {
    var i = 0
    while i < unsafe { sp.import_files.size() } {
        if unsafe { sp.import_files.get(i) } == file {
            return unsafe { sp.import_ends.get(i) }
        }
        i = i + 1
    }
    return 0
}
