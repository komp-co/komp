
import kf_core.span.*
import kf_interface.parse.*

/// Read and parse one `.kfi`. Version and format errors stay in the result
/// for the driver to report. Generic template fragments register their
/// source in `smap` so diagnostics can quote template code.
pub fun load_compiled_crate(interface_path: str, smap: Ptr<SourceMap>): InterfaceLoad {
    val source = read_file(interface_path)
    val loaded = parse_interface_mapped(source.as_str(), smap)
    return loaded
}
