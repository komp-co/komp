// Files whose text the caller supplies — an editor's unsaved buffers —
// instead of disk. Only the bytes change: each file keeps its module path,
// FileId and place in the crate.

import alloc.list.*

/// A staged file with empty text is a real, empty document, not an absent
/// one.
pub struct Overlay {
    var paths:    List<String>
    var contents: List<String>
}

pub fun no_overlay(): Overlay {
    return Overlay { paths: List.new<String>(), contents: List.new<String>() }
}

pub fun overlay_for(path: str, content: str): Overlay {
    var overlay = no_overlay()
    overlay.stage(path, content)
    return overlay
}

/// Replaces what was staged for `path` before.
pub mutating fun Overlay.stage(path: str, content: str): void {
    when (self.staged_index(path)) {
        Some(at) => self.contents.set(at, String.from(content))
        None => {
            self.paths.push(String.from(path))
            self.contents.push(String.from(content))
        }
    }
}

/// `path` is read from disk again.
pub mutating fun Overlay.unstage(path: str): void {
    val at = self.staged_index(path) ?: return
    val _path = self.paths.remove(at)
    val _content = self.contents.remove(at)
}

pub fun Overlay.is_staged(path: str): bool {
    return self.staged_index(path).is_some()
}

pub fun Overlay.staged_count(): uint64 {
    return self.paths.size()
}

/// CONSTRAINT: `path` is compared by exact spelling, as SourceMap path
/// lookups are; looser matching would stage a file no FileId lookup finds.
pub fun Overlay.overlay_read(path: str): String {
    when (self.staged_index(path)) {
        Some(at) => return self.contents[at].clone()
        None => return read_file(path)
    }
}

fun Overlay.staged_index(path: str): uint64? {
    while i in 0..self.paths.size() {
        if self.paths[i].as_str() == path { return Option.Some(i) }
    }
    return null
}
