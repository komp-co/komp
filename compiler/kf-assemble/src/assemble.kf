// Module discovery: walks `<crate_root>/src/**/*.kf` and parses each file into
// a `Module`. Import resolution is a later pass.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_parse.lexer.tokenize
import kf_parse.parser.*
import kf_shared.walk_kf_files_inc

// Signatures for runtime functions defined in the prelude, so call arguments
// coerce correctly. komp emits no prototype for an extern, so these do not
// clash with the prelude's definitions.
extern "C" fun runtime_println(s: str): void
extern "C" fun join(a: str, b: str): String
extern "C" fun read_file(path: str): String
extern "C" fun write_file(path: str, content: str): void

mutating fun Parser.drain_parse_diags(pdiags: Ptr<List<Diagnostic>>): void {
    while diag in &self.diags {
        unsafe { pdiags.push(diag) }
    }
}

/// Nested impl, trait and trait-impl methods are declarations too, so
/// ownership is stamped through the tree.
pub fun stamp_module_owner(module: &var Module, crate: CrateId): void {
    module.crate = crate
    val module_path = module_path_sym(&module.path)
    stamp_decl_list(&var module.decls, crate, module_path)
}

fun module_path_sym(path: &List<String>): Sym {
    var joined = ""
    var i = 0
    val component_count = path.size()
    val directory_count = if component_count > 0 { component_count - 1 } else { 0 }
    while i < directory_count {
        if i > 0 { joined = joined + String.from(".") }
        joined = joined + *path.at(i)
        i = i + 1
    }
    return intern(joined.as_str())
}

fun stamp_decl_list(decls: &var List<TopDecl>, crate: CrateId, module_path: Sym): void {
    while i in 0..decls.size() {
        stamp_decl_owner(decls.at_mut(i), crate, module_path)
    }
}

pub fun Module.module_has_valid_ownership(): bool {
    if (self.crate.is_poison()) { return false }
    return decl_list_has_valid_ownership(&self.decls)
}

fun decl_list_has_valid_ownership(decls: &List<TopDecl>): bool {
    while decl in &decls {
        if !decl.decl_has_valid_ownership() { return false }
    }
    return true
}

// CONSTRAINT: borrowed. A by-value TopDecl is a shallow copy sharing the
// module's buffers, and dropping it would free a list the module still uses.
fun TopDecl.decl_has_valid_ownership(): bool {
    if self.crate.is_poison() { return false }
    return when (self.kind) {
        ImplBlock(methods) => decl_list_has_valid_ownership(&methods)
        TraitDecl(methods, _, _) => decl_list_has_valid_ownership(&methods)
        TraitImpl(_, methods) => decl_list_has_valid_ownership(&methods)
        _ => true
    }
}

/// `src_root/span/source_file.kf` in crate `kf_core` is
/// `["kf_core", "span", "source_file"]`.
pub fun module_path_for(file_path: str, src_root: str, crate_name: String): List<String> {
    var out = List.new<String>()
    out.push(String.from(crate_name.as_str()))

    val total: uint64 = file_path.byte_len()
    val root_len: uint64 = src_root.byte_len()
    if total <= root_len {
        return out
    }
    var i: uint64 = root_len + 1
    val end: uint64 = total - 3
    var seg_start: uint64 = i
    while i <= end {
        val at_end: bool = i == end
        val is_sep: bool = !at_end && file_path.byte_at(i) == 47  // '/'
        if at_end || is_sep {
            val seg_len: uint64 = i - seg_start
            if seg_len > 0 {
                val seg: String = file_path.substring(seg_start, i)
                out.push(seg)
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    return out
}

/// One `Module` per non-test `.kf` file; zero modules on error.
pub fun assemble_crate(crate_root: str, crate_name: String, smap: Ptr<SourceMap>, pdiags: Ptr<List<Diagnostic>>): Crate {
    val none = no_overlay()
    return assemble_crate_inc(crate_root, crate_name, smap, pdiags, false, &none)
}

/// Includes `_test.kf` files: for the test driver, `check` and `query`,
/// which answer for the whole crate.
pub fun assemble_crate_tests(crate_root: str, crate_name: String, smap: Ptr<SourceMap>, pdiags: Ptr<List<Diagnostic>>): Crate {
    val none = no_overlay()
    return assemble_crate_inc(crate_root, crate_name, smap, pdiags, true, &none)
}

/// `overlay` supplies one file's text in place of disk (an editor buffer);
/// `no_overlay()` for a build.
///
/// CONSTRAINT: once per crate per SourceMap. A second assembly registers
/// every file twice, and path lookups then answer with FileIds the modules'
/// spans do not carry.
pub fun assemble_crate_inc(crate_root: str, crate_name: String, smap: Ptr<SourceMap>, pdiags: Ptr<List<Diagnostic>>, include_tests: bool, overlay: &Overlay): Crate {
    var c = new_crate(String.from(crate_name.as_str()))
    val src_root: String = join(crate_root, "src")
    if !is_dir(src_root.as_str()) {
        // A crate with no src/ must be an error: otherwise the build emits a
        // program with none of the project's code and exits 0.
        unsafe { pdiags.push(error_at(no_span(), "crate `${crate_name}` has no src/ directory (expected ${src_root}); sources beside kf.toml are not read")) }
        return c
    }
    var paths = List.new<String>()
    walk_kf_files_inc(src_root.as_str(), &var paths, include_tests)
    while path in &paths {
        val p: String = path
        val src: String = overlay.overlay_read(p.as_str())
        val fid = unsafe { smap.add_file(new_source_file(p.clone(), src.clone())) }
        val toks = tokenize(src.as_str(), fid)
        var parser = new_parser(toks)
        val mod_path: List<String> = module_path_for(p.as_str(), src_root.as_str(), crate_name.clone())
        var m: Module = parser.parse_module(mod_path)
        stamp_module_owner(&var m, new_crate_id(crate_name.as_str()))
        parser.drain_parse_diags(pdiags)
        c.modules.push(m)
    }
    return c
}
