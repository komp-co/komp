import alloc.list.*
import alloc.text_edit.*
import core.text.*

/// Where one file's lines sit inside the shared `line_starts` buffer.
pub struct FileLines {
    pub val first: uint64
    pub val count: uint64
}

pub struct SourceMap {
    pub var files: List<SourceFile>
    /// `<module>.<file stem>` names from dependency interfaces
    /// (`core.option`), so a wildcard import can name a file without its
    /// sources on disk. String, not Sym: interning lives in `kf_core.ast`,
    /// which imports this module.
    pub var interface_files: List<String>
    /// Every line's starting byte offset, for every file, concatenated;
    /// `file_lines` says which slice is whose.
    /// CONSTRAINT: flat lists, not on `SourceFile` (handed out by value, it
    /// would free a shared buffer) and not `List<List<uint32>>` (mono emits
    /// the outer typedef without the inner).
    var line_starts: List<uint32>
    var file_lines: List<FileLines>
}

/// No directory, no `.kf` suffix: `"libs/core/src/string.kf"` is `"string"`.
/// A `.kfi` keeps its extension, so it is never mistaken for source.
pub fun path_file_stem(path: str): String {
    var start = 0
    when (path.last_index_of("/")) {
        Some(at) => { start = at + 1 }
        None => { }
    }
    var end: uint64 = path.byte_len()
    if path.ends_with(".kf") { end = end - 3 }
    if end <= start { return String.from("") }
    return path.substring(start, end)
}

pub fun new_source_map(): SourceMap {
    return SourceMap {
        files: List.new<SourceFile>(),
        interface_files: List.new<String>(),
        line_starts: List.new<uint32>(),
        file_lines: List.new<FileLines>()
    }
}

impl SourceMap {
    pub mutating fun add_file(file: SourceFile): uint32 {
        val first = self.line_starts.size()
        val src = file.content.as_str()
        // Every file has a line at byte 0, so the slice is never empty.
        self.line_starts.push(0)
        val n: uint64 = src.byte_len()
        var i = 0
        while i < n {
            if src.byte_at(i) == 10 {
                self.line_starts.push((i + 1) as uint32)
            }
            i = i + 1
        }
        val count = self.line_starts.size() - first
        self.files.push(file)
        self.file_lines.push(FileLines { first: first, count: count })
        return self.files.size() as uint32
    }

    /// The last line start <= `offset`, relative to the file's slice.
    fun line_index_for(slot: uint64, offset: uint32): uint64 {
        val fl = self.file_lines.at(slot)
        var lo = 0
        var hi: uint64 = fl.count
        while hi - lo > 1 {
            val mid = lo + (hi - lo) / 2
            if self.line_starts.get(fl.first + mid) <= offset {
                lo = mid
            } else {
                hi = mid
            }
        }
        return lo
    }

    fun line_start_at(slot: uint64, line_index: uint64): uint64 {
        return self.line_starts.get(self.file_lines.at(slot).first + line_index) as uint64
    }

    /// "" for no such file. Reads `files` by reference: `get_file` copies
    /// the whole content, and this runs once per declaration.
    pub fun file_stem_of(file_id: uint32): String {
        if file_id == 0 { return String.from("") }
        val idx: uint64 = (file_id - 1) as uint64
        if idx >= self.files.size() { return String.from("") }
        return path_file_stem(self.files.at(idx).path.as_str())
    }

    /// "" for no such file. By reference, as in `file_stem_of`.
    pub fun file_path_of(file_id: uint32): String {
        if file_id == 0 { return String.from("") }
        val idx: uint64 = (file_id - 1) as uint64
        if idx >= self.files.size() { return String.from("") }
        return self.files.at(idx).path.clone()
    }

    pub fun get_file(file_id: uint32): SourceFile? {
        if file_id == 0 {
            return null
        }
        val idx: uint64 = (file_id - 1) as uint64
        if idx >= self.files.size() {
            return null
        }
        return *self.files.at(idx)
    }

    /// `files.size()` when the id names no file, so callers can borrow with
    /// `at()` instead of copying.
    fun slot_for(file_id: uint32): uint64 {
        if file_id == 0 { return self.files.size() }
        val idx: uint64 = (file_id - 1) as uint64
        if idx >= self.files.size() { return self.files.size() }
        return idx
    }

    /// 1-indexed; null for an invalid file id.
    pub fun span_to_location(s: Span): Location? {
        val idx = self.slot_for(s.file_id)
        if idx >= self.files.size() { return null }
        val f = self.files.at(idx)
        val target: uint64 = s.start as uint64
        if target > f.content.as_str().byte_len() { return null }
        val li = self.line_index_for(idx, s.start)
        val col: uint32 = (target - self.line_start_at(idx, li) + 1) as uint32
        return Location { file_path: f.path.clone(), line: (li + 1) as uint32, col: col }
    }

    /// The line containing `s.start`, without its newline; "" if invalid.
    pub fun span_line(s: Span): String {
        val idx = self.slot_for(s.file_id)
        if idx >= self.files.size() { return "" }
        val f = self.files.at(idx)
        val src = f.content.as_str()
        val n: uint64 = src.byte_len()
        val target: uint64 = s.start as uint64
        if target > n { return "" }
        val line_start: uint64 = self.line_start_at(idx, self.line_index_for(idx, s.start))
        var line_end: uint64 = target
        while line_end < n {
            if src.byte_at(line_end) == 10 { break }
            line_end = line_end + 1
        }
        return src.substring(line_start, line_end)
    }
}
