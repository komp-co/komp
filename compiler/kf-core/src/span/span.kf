/// A byte range in a source file, `start` inclusive, `end` exclusive.
@derive(Copy)
pub struct Span {
    pub val file_id: uint32
    pub val start: uint32
    pub val end: uint32
}

impl Span {
    pub fun len(): uint32 {
        return self.end - self.start
    }

    pub fun is_empty(): bool {
        return self.end == self.start
    }

    pub fun is_none(): bool {
        return self.file_id == 0
    }

    /// The smallest span covering both; `self`'s file wins.
    pub fun merge(other: Span): Span {
        var s: uint32 = self.start
        if other.start < s { s = other.start }
        var e: uint32 = self.end
        if other.end > e { e = other.end }
        return Span { file_id: self.file_id, start: s, end: e }
    }
}

/// File id 0 is reserved for this; real files start at 1.
pub fun no_span(): Span {
    return Span { file_id: 0, start: 0, end: 0 }
}
