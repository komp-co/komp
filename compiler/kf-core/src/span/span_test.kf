import core.assert.assert_eq
import core.assert.fail
import core.assert.assert

@test fun span_len_basic(): void {
    val s = Span { file_id: 1, start: 5, end: 12 }
    assert_eq(s.len(), 7, "span length")
}

@test fun span_len_zero(): void {
    val s = Span { file_id: 1, start: 5, end: 5 }
    assert_eq(s.len(), 0, "empty span length")
}

@test fun span_is_empty_true(): void {
    val s = Span { file_id: 1, start: 0, end: 0 }
    assert_eq(s.is_empty(), true, "zero-zero is empty")
}

@test fun span_is_empty_false(): void {
    val s = Span { file_id: 1, start: 5, end: 12 }
    assert_eq(s.is_empty(), false, "non-zero len not empty")
}

@test fun span_merge_disjoint(): void {
    val a = Span { file_id: 1, start: 5, end: 10 }
    val b = Span { file_id: 1, start: 20, end: 30 }
    val merged = a.merge(b)
    assert_eq(merged.start, 5, "merged start = min")
    assert_eq(merged.end, 30, "merged end = max")
    assert_eq(merged.file_id, 1, "file_id from self")
}

@test fun no_span_reports_none(): void {
    val s = no_span()
    assert_eq(s.file_id, 0, "no_span file_id is 0")
    assert_eq(s.is_none(), true, "no_span is none")
}

@test fun real_span_is_not_none(): void {
    val s = Span { file_id: 1, start: 0, end: 5 }
    assert_eq(s.is_none(), false, "file_id 1 is not none")
}

@test fun source_file_constructed(): void {
    val sf = new_source_file(String.from("foo.kf"), String.from("hello"))
    assert_eq(sf.path.as_str(), "foo.kf", "path round-trip")
    assert_eq(sf.content.as_str(), "hello", "content round-trip")
}

@test fun source_map_starts_empty(): void {
    val sm = new_source_map()
    assert_eq(sm.files.size(), 0, "no files initially")
}

@test fun source_map_add_file_returns_id_1(): void {
    var sm = new_source_map()
    val sf = new_source_file(String.from("a.kf"), String.from("content"))
    val id = sm.add_file(sf)
    assert_eq(id, 1, "first id is 1, not 0")
    assert_eq(sm.files.size(), 1, "size is 1")
}

@test fun source_map_get_file_zero_returns_none(): void {
    val sm = new_source_map()
    when (sm.get_file(0)) {
        Some(_) => fail("file_id 0 must be None")
        None => assert(true, "ok")
    }
}

@test fun source_map_get_file_out_of_range_returns_none(): void {
    val sm = new_source_map()
    when (sm.get_file(99)) {
        Some(_) => fail("missing file must be None")
        None => assert(true, "ok")
    }
}

@test fun source_map_span_to_location_first_line(): void {
    var sm = new_source_map()
    val sf = new_source_file(String.from("x.kf"), String.from("abcdef"))
    val id = sm.add_file(sf)
    val s = Span { file_id: id, start: 3, end: 4 }
    when (sm.span_to_location(s)) {
        Some(loc) => check_loc(loc, 1, 4)
        None => fail("expected a location")
    }
}

@test fun source_map_span_to_location_unknown_file(): void {
    val sm = new_source_map()
    val s = Span { file_id: 42, start: 0, end: 1 }
    when (sm.span_to_location(s)) {
        Some(_) => fail("unknown file must be None")
        None => assert(true, "ok")
    }
}

fun check_loc(loc: Location, expected_line: uint32, expected_col: uint32): void {
    assert_eq(loc.line, expected_line, "line")
    assert_eq(loc.col, expected_col, "col")
}

fun three_line_map(): SourceMap {
    var sm = new_source_map()
    // "one\ntwo\nthree\n" — lines start at 0, 4, 8; the file is 14 bytes.
    val _id = sm.add_file(new_source_file(String.from("m.kf"), String.from("one\ntwo\nthree\n")))
    return sm
}

@test fun a_later_line_resolves_to_its_own_line_and_column(): void {
    val sm = three_line_map()
    // byte 9 is the `h` of "three" — line 3, column 2.
    when (sm.span_to_location(Span { file_id: 1, start: 9, end: 10 })) {
        Some(loc) => check_loc(loc, 3, 2)
        None => fail("expected a location")
    }
}

@test fun the_first_byte_of_a_line_is_column_one(): void {
    val sm = three_line_map()
    when (sm.span_to_location(Span { file_id: 1, start: 4, end: 5 })) {
        Some(loc) => check_loc(loc, 2, 1)
        None => fail("expected a location")
    }
}

// A newline belongs to the line it ends: byte 3 is line 1, column 4.
@test fun a_newline_belongs_to_the_line_it_ends(): void {
    val sm = three_line_map()
    when (sm.span_to_location(Span { file_id: 1, start: 3, end: 4 })) {
        Some(loc) => check_loc(loc, 1, 4)
        None => fail("expected a location")
    }
}

@test fun an_offset_at_end_of_file_still_resolves(): void {
    val sm = three_line_map()
    // One past the last byte: the empty fourth line the trailing newline opens.
    when (sm.span_to_location(Span { file_id: 1, start: 14, end: 14 })) {
        Some(loc) => check_loc(loc, 4, 1)
        None => fail("an offset at the end of the file has a location")
    }
}

@test fun an_offset_past_the_end_of_file_has_no_location(): void {
    val sm = three_line_map()
    when (sm.span_to_location(Span { file_id: 1, start: 15, end: 15 })) {
        Some(_) => fail("past the end is not a location")
        None => assert(true, "ok")
    }
}

@test fun span_line_returns_the_whole_line_without_its_newline(): void {
    val sm = three_line_map()
    assert_eq(sm.span_line(Span { file_id: 1, start: 9, end: 10 }).as_str(), "three", "the third line")
    assert_eq(sm.span_line(Span { file_id: 1, start: 5, end: 6 }).as_str(), "two", "the second line")
    assert_eq(sm.span_line(Span { file_id: 1, start: 0, end: 1 }).as_str(), "one", "the first line")
}

@test fun each_file_indexes_its_own_lines(): void {
    var sm = new_source_map()
    val _a = sm.add_file(new_source_file(String.from("a.kf"), String.from("aaaa\nbbbb\n")))
    val b = sm.add_file(new_source_file(String.from("b.kf"), String.from("x\ny\nz\n")))
    assert_eq(b, 2, "the second file is id 2")
    // byte 4 in b.kf is `z` — line 3, column 1. In a.kf it would be line 1.
    when (sm.span_to_location(Span { file_id: b, start: 4, end: 5 })) {
        Some(loc) => check_loc(loc, 3, 1)
        None => fail("expected a location")
    }
    assert_eq(sm.span_line(Span { file_id: b, start: 4, end: 5 }).as_str(), "z", "b.kf's third line")
    assert_eq(sm.span_line(Span { file_id: 1, start: 4, end: 5 }).as_str(), "aaaa", "a.kf is unaffected")
}

@test fun a_file_with_no_newlines_is_one_line(): void {
    var sm = new_source_map()
    val id = sm.add_file(new_source_file(String.from("one.kf"), String.from("abcdef")))
    when (sm.span_to_location(Span { file_id: id, start: 5, end: 6 })) {
        Some(loc) => check_loc(loc, 1, 6)
        None => fail("expected a location")
    }
}

@test fun an_empty_file_still_answers_for_offset_zero(): void {
    var sm = new_source_map()
    val id = sm.add_file(new_source_file(String.from("e.kf"), ""))
    when (sm.span_to_location(Span { file_id: id, start: 0, end: 0 })) {
        Some(loc) => check_loc(loc, 1, 1)
        None => fail("an empty file has a line 1")
    }
}
