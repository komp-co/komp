import core.assert.assert_eq

@test
fun an_option_nobody_set_has_its_default(): void {
    assert_eq(no_lint_options().get("nope", "max"), 0, "an unknown option reads as zero")
}

@test
fun a_set_option_reads_back(): void {
    var options = no_lint_options()
    options.set("some_lint", "max", 3)
    options.set("some_lint", "max", 4)
    assert_eq(options.get("some_lint", "max"), 4, "the later row wins")
}
