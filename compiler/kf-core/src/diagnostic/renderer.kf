import kf_core.span.*

/// Renders:
///   <file>:<line>:<col>: error: <primary.message>
///       <the offending source line>
///       ^~~~
///   = note: <secondary[0].message> (at <file>:<line>:<col>)
///         <that line's source>
///         ^~~~
///
/// A span the map cannot place gets the bare `error: <message>` head.
pub fun Diagnostic.render(smp: Ptr<SourceMap>): String {
    return self.render_colored(smp, false)
}

/// With ANSI color when `color` is true; the driver decides. Color never
/// moves a character of the plain rendering.
pub fun Diagnostic.render_colored(smp: Ptr<SourceMap>, color: bool): String {
    var out = ""
    when (unsafe { smp.span_to_location(self.primary.span) }) {
        Some(loc) => {
            // Uncolored, so terminals can still turn it into a link.
            out.append(loc.file_path)
            out.append(":")
            out.append_uint32(loc.line)
            out.append(":")
            out.append_uint32(loc.col)
            out.append(": ")
            out.append_head(self.severity, self.primary.message.as_str(), color)
            out.append_source_echo(smp, self.primary.span, loc.col, primary_indent(), severity_color(self.severity, color), color)
        }
        None => {
            out.append_head(self.severity, self.primary.message.as_str(), color)
        }
    }

    while item in &self.secondary {
        // CONSTRAINT: a separate function, because a local bound inside a
        // while-with-when body gets its drop mis-emitted.
        out.render_secondary(smp, item, color)
    }
    return out
}

mutating fun String.append_head(severity: Severity, message: str, color: bool): void {
    self.append(severity_color(severity, color))
    self.append(severity_prefix(severity))
    self.append(sgr_reset(color))
    self.append(": ")
    self.append(sgr_bold(color))
    self.append(message)
    self.append(sgr_reset(color))
}

/// A note's echo sits two spaces further in than the primary's.
fun primary_indent(): str { return "    " }
fun secondary_indent(): str { return "      " }

/// The source line and a caret under the span. Nothing for a span the map
/// cannot place or an empty line. Only the caret is colored.
mutating fun String.append_source_echo(smp: Ptr<SourceMap>, span: Span, col: uint32, pad: str, caret_color: str, color: bool): void {
    val src_line = unsafe { smp.span_line(span) }
    if src_line.len() == 0 { return }
    self.append("\n")
    self.append(pad)
    self.append(src_line)
    self.append("\n")
    val caret = caret_line(col, span.len() as uint64, src_line.len(), pad)
    self.append(caret_color)
    self.append(caret.as_str())
    self.append(sgr_reset(color))
}

/// Clipped to the echoed line so a multi-line span cannot smear past it.
fun caret_line(col: uint32, span_len: uint64, line_len: uint64, pad: str): String {
    var out = String.from(pad)
    var i = 1
    while i < col {
        out.append(" ")
        i = i + 1
    }
    out.append("^")
    var rest = 1
    val start: uint64 = (col as uint64) - 1
    while rest < span_len {
        if start + rest >= line_len { break }
        out.append("~")
        rest = rest + 1
    }
    return out
}

mutating fun String.render_secondary(smp: Ptr<SourceMap>, lbl: &Label, color: bool): void {
    self.append("\n  ")
    self.append(note_color(color))
    self.append("= note:")
    self.append(sgr_reset(color))
    self.append(" ")
    self.append(lbl.message)
    when (unsafe { smp.span_to_location(lbl.span) }) {
        Some(loc) => {
            self.append(" (at ")
            self.append(loc.file_path)
            self.append(":")
            self.append_uint32(loc.line)
            self.append(":")
            self.append_uint32(loc.col)
            self.append(")")
            self.append_source_echo(smp, lbl.span, loc.col, secondary_indent(), note_color(color), color)
        }
        None => {}
    }
}

fun severity_prefix(s: Severity): str {
    return when (s) {
        Error => "error"
        Warning => "warning"
        Note => "note"
    }
}

// Empty strings when color is off, so sites append unconditionally.

fun severity_color(s: Severity, color: bool): str {
    if !color { return "" }
    return when (s) {
        Error => "\033[1;31m"
        Warning => "\033[1;33m"
        Note => "\033[1;36m"
    }
}

fun note_color(color: bool): str {
    if !color { return "" }
    return "\033[1;36m"
}

fun sgr_bold(color: bool): str {
    if !color { return "" }
    return "\033[1m"
}

fun sgr_reset(color: bool): str {
    if !color { return "" }
    return "\033[0m"
}

mutating fun String.append_uint32(n: uint32) {
    val s = String.of(&((n as int64)))
    self.append(s)
}
