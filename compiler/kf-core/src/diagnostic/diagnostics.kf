// Where a pass reports. The driver owns one and lends it as `&var`, so a
// check reports without a pointer.
//
// CONSTRAINT: named after diagnostic.kf, so `Diagnostic`'s typedef is
// emitted before this one's.

import alloc.list.*

/// What passes reported, in order, and errors counted without being kept.
pub struct Diagnostics {
    pub var items: List<Diagnostic>
    /// Errors already printed by whoever found them.
    var counted: int32
}

pub fun new_diagnostics(): Diagnostics {
    return Diagnostics { items: List.new<Diagnostic>(), counted: 0 }
}

impl Diagnostics {
    pub mutating fun emit(diag: Diagnostic): void {
        self.items.push(diag)
    }

    /// `n` errors reported and printed elsewhere.
    pub mutating fun count_errors(n: int32): void {
        self.counted = self.counted + n
    }

    pub fun error_count(): int32 {
        var errors = self.counted
        while d in &self.items {
            when (d.severity) {
                Error => errors = errors + 1
                _ => { }
            }
        }
        return errors
    }

    pub fun size(): uint64 {
        return self.items.size()
    }

    pub fun at(i: uint64): &Diagnostic {
        return self.items.at(i)
    }

    /// Withdraws the last report: a trial check that did not stick.
    pub mutating fun pop(): void {
        self.items.pop()
    }

    pub fun has_errors(): bool {
        return self.error_count() > 0
    }
}
