// Returning a field read out of a `when` arm once came back with garbage in
// the first field. Every variant below reads the same Span from the same decl
// and they must agree: A returns it from the arm, B binds a local first, C
// assigns into a local declared before the `when`, D takes the subject by
// value, E reads a field of the field. `file_id` is first in `Span` and is
// what `is_none` tests.
import core.assert.assert_eq
import alloc.list.*
import kf_core.span.no_span
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

fun probe_decl(): TopDecl {
    var body = List.new<Stmt>()
    var s = Stmt.new(Span { file_id: 1, start: 21, end: 26 }, StmtKind.Break)
    s.binder = Span { file_id: 1, start: 21, end: 26 }
    body.push(s)
    val rt: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rt = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    return new_top_decl(no_span(), String.from("probe"), TopDeclKind.Function(List.new<Param>(), rt, body, true, false, false, false))
}

fun TopDecl.variant_a(): Span {
    when (self.kind) {
        Function(_pa, _r, body, _pb, _u, _mv, _s) => return body.at(0).binder
        _ => return no_span()
    }
}

fun TopDecl.variant_b(): Span {
    when (self.kind) {
        Function(_pa, _r, body, _pb, _u, _mv, _s) => {
            val b = body.at(0).binder
            return b
        }
        _ => return no_span()
    }
}

/// C -- assigned into a local declared before the when.
fun TopDecl.variant_c(): Span {
    var out = no_span()
    when (self.kind) {
        Function(_pa, _r, body, _pb, _u, _mv, _s) => out = body.at(0).binder
        _ => {}
    }
    return out
}

/// D -- the subject by value rather than through a borrow.
fun variant_d(td: TopDecl): Span {
    when (td.kind) {
        Function(_pa, _r, body, _pb, _u, _mv, _s) => return body.at(0).binder
        _ => return no_span()
    }
}

/// E -- a nested field read off the same call result.
fun TopDecl.variant_e(): uint32 {
    when (self.kind) {
        Function(_pa, _r, body, _pb, _u, _mv, _s) => return body.at(0).binder.file_id
        _ => return 0
    }
}

@test
fun a_field_returned_from_an_arm_matches_every_other_route(): void {
    val td = probe_decl()
    val a = td.variant_a()
    val b = td.variant_b()
    assert_eq(a.start, b.start, "start agrees")
    assert_eq(a.end, b.end, "end agrees")
    assert_eq(a.file_id, b.file_id, "file_id agrees -- the first field is the one a torn copy corrupts")

    val c = td.variant_c()
    assert_eq(a.file_id, c.file_id, "and the pre-when local agrees too")
    assert_eq(td.variant_e(), b.file_id, "as does a nested read of the same field")
    assert_eq(variant_d(probe_decl()).file_id, b.file_id, "and the by-value subject")
}
