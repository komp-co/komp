import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt

// CONSTRAINT: TopDecl and its supporting structs share this file because
// cross-file struct typedef order follows file names; one file keeps them in
// source order.

/// A declared type parameter, e.g. the `T` in `struct Box<T>`, with its trait
/// bounds.
@derive(Clone)
pub struct TypeParam {
    pub val span: Span
    pub val name: Sym
    pub var bounds: List<TypeRef>
}

pub fun new_type_param(span: Span, name: String): TypeParam {
    return TypeParam { span: span, name: intern(name.as_str()), bounds: List.new<TypeRef>() }
}

@derive(Clone)
pub struct Param {
    pub val span: Span
    pub val name: Sym
    pub val ty: Box<TypeRef>
}

pub fun new_param(span: Span, name: String, ty: Ptr<TypeRef>): Param {
    return Param { span: span, name: intern(name.as_str()), ty: ty }
}

pub struct Field {
    pub val span: Span
    pub val name: Sym
    pub val ty: Box<TypeRef>
    pub val is_var: bool
    pub val is_pub: bool
    /// The `@...` run above the field.
    pub var annotations: List<Annotation>
}

pub fun new_field(span: Span, name: String, ty: Ptr<TypeRef>, is_var: bool, is_pub: bool): Field {
    return Field {
        span: span, name: intern(name.as_str()), ty: ty, is_var: is_var, is_pub: is_pub,
        annotations: List.new<Annotation>()
    }
}

pub struct Variant {
    pub val span: Span
    pub val name: Sym
    pub var payloads: List<TypeRef>
    /// The `@...` run above the variant.
    pub var annotations: List<Annotation>
}

pub fun new_variant(span: Span, name: String, payloads: List<TypeRef>): Variant {
    return Variant { span: span, name: intern(name.as_str()), payloads: payloads, annotations: List.new<Annotation>() }
}

/// One argument of `@name(...)`: `Clone`, `"string"`, `iterations = 100`.
@derive(Clone)
pub struct AnnotationArg {
    /// Empty for a positional argument.
    pub val name: Sym
    pub val value: Box<Expr>
}

/// `@name` or `@name(args)` above a declaration.
@derive(Clone)
pub struct Annotation {
    pub val name: Sym
    pub var args: List<AnnotationArg>
    /// `@name()` as against `@name`.
    pub val has_parens: bool
    pub val span: Span
}

/// A kind of declaration, or of a type's member, an annotation may mark by
/// kind.
@derive(Clone, Equal)
pub enum MarkKind {
    Function
    Struct
    Enum
    Trait
    Field
    Variant
}

/// One kind in `on struct: Plugin, enum`, and the traits a marked type of
/// that kind implements.
@derive(Clone)
pub struct KindTarget {
    pub val kind: MarkKind
    pub val bounds: List<TypeRef>
}

/// What a declared annotation may mark.
@derive(Clone)
pub enum MarkTarget {
    /// `on (A) -> R`: a function of exactly that type.
    Function(Box<TypeRef>)
    /// `on fun, struct: Plugin`: any declaration of a listed kind.
    Kinds(List<KindTarget>)
    /// `on (bool, _, ..) -> _`: a function whose type matches, `_` standing
    /// for any one type and a trailing `..` for any further parameters.
    Signature(List<TypeRef>, bool, Box<TypeRef>)
}

/// What a bare `annotation NAME` marks: a `() -> void` function.
pub fun default_mark_target(span: Span): MarkTarget {
    val void_ref = Box.new(TypeRef.new(span, TypeRefKind.Named(intern("void"), List.new<TypeRef>())))
    return MarkTarget.Function(Box.new(TypeRef.new(span, TypeRefKind.Function(List.new<TypeRef>(), void_ref))))
}

/// CONSTRAINT: the name lives on this outer struct, not in the kind's
/// payload: destructuring a Drop-typed payload out of a variant double-frees
/// it. Read `.name` rather than destructuring.
@derive(Clone)
pub struct TopDecl {
    pub val span: Span
    pub var name: Sym
    pub var kind: TopDeclKind
    pub var crate: CrateId
    pub var module_path: Sym
    pub var decl: DeclId?
    pub var generics: List<TypeParam>
    /// Every `@name(...)` written above the declaration, in source order.
    pub var annotations: List<Annotation>
    /// Set on methods from a `TraitImpl`, which Mono turns into an ImplBlock.
    /// Codegen puts them in the crate header even without `pub`.
    pub var from_trait_impl: bool
    /// Source unless loaded from an interface, which also fills link_name
    /// with the archive symbol.
    pub var linkage: Linkage
    pub var link_name: Sym
    /// Dynamic layouts this declaration requests and vtables it supplies,
    /// kept here so copies of the declaration carry them.
    pub var dyn_layouts: List<DynTraitLayout>
    pub var dyn_vtables: List<DynVTableInstance>
    /// Byte offset just past the last token, in the file of `span`; 0 for a
    /// synthesized declaration. Interfaces slice template source with it.
    pub var decl_end: uint32
    /// Where the declaration's own name is written; `no_span()` when
    /// synthesized.
    pub var name_span: Span
    /// An extension function's name as written (`area` in
    /// `fun List<Point>.area()`), empty otherwise. `name` is then a hidden
    /// name distinguishing extensions, and the first parameter is `self`.
    pub var ext_name: Sym
    /// The module whose names the body sees, when not its own: a template's,
    /// for a declaration the template adds to another module. Empty
    /// otherwise.
    pub var resolves_in: Sym
    /// A `sealed trait`: only its own crate implements it.
    pub var is_sealed: bool
    /// A `view struct` or `view enum`: its values borrow.
    pub var is_view: bool
    /// The lang key (`copy`) of the trait an impl block implements, once Mono
    /// has turned the trait impl into a plain impl block; empty otherwise.
    pub var implemented_lang_trait: Sym
}

pub enum TopDeclKind {
    /// `fun NAME(params): ret { body }`.
    Function(List<Param>, Box<TypeRef>, List<Stmt>, bool, bool, bool, bool)
    // ^ params, return-type, body, is_pub, is_unsafe, is_mutating, is_static
    /// `struct NAME { fields }`.
    Struct(List<Field>, bool)
    // ^ fields, is_pub
    /// `enum NAME { variants }`.
    EnumDecl(List<Variant>, bool)
    // ^ variants, is_pub
    /// `extern "C" fun NAME(params): ret`.
    Extern(List<Param>, Box<TypeRef>, bool, bool)
    // ^ params, return-type, is_pub, is_unsafe
    /// `impl NAME { ... }`. The outer `name` is the target type; each method
    /// is a Function TopDecl.
    ImplBlock(List<TopDecl>)
    /// `trait NAME: SUPER + SUPER { ... }`. Methods with an empty body are
    /// required, others are defaults. Payload: members, is_pub, supertraits.
    /// Associated types ride in the member list; supertraits are written on
    /// the header, so they have their own list.
    TraitDecl(List<TopDecl>, bool, List<TypeRef>)
    /// `impl TRAIT for TYPE { ... }`. The box is the trait ref; the target is
    /// the outer `name`. Boxed to keep a Drop payload off the enum.
    TraitImpl(Box<TypeRef>, List<TopDecl>)
    /// `type Item` / `type Item: Bound` inside a trait; the payload is its
    /// bounds. Rides in the trait's member list.
    AssocType(List<TypeRef>)
    /// `type Item = int32` inside a trait impl — the impl's choice for one
    /// associated type. The outer `name` is the associated type's name.
    AssocTypeBinding(Box<TypeRef>)
    /// `annotation NAME(params) on TARGET`: a name a declaration may carry
    /// as `@NAME(args)`. Payload: params, target, is_pub.
    AnnotationDecl(List<Param>, MarkTarget, bool)
    /// `template NAME on KIND T { declarations }`: what `@NAME` adds beside
    /// each declaration of that kind it marks. The outer `name` is the
    /// annotation's. Payload: the kind, `T`, the declarations.
    Template(MarkKind, Sym, List<TopDecl>)
    /// Parse error.
    Poison
}

impl TopDecl {
    /// `@name` or `@name(...)` is written above this declaration.
    pub fun has_annotation(name: str): bool {
        while a in &self.annotations {
            if a.name.as_str() == name { return true }
        }
        return false
    }

    /// The words of the first `@name(...)`, or none: `derive` on
    /// `@derive(Clone, Equal)` gives `["Clone", "Equal"]`.
    pub fun annotation_words(name: str): List<String> {
        while a in &self.annotations {
            if a.name.as_str() == name { return a.words() }
        }
        return List.new<String>()
    }

    /// The module the body's names resolve in.
    pub fun scope_module(): Sym {
        return if self.resolves_in.as_str().byte_len() > 0 { self.resolves_in } else { self.module_path }
    }

    /// Where a diagnostic about this declaration points: its name, falling
    /// back to the whole span for synthesized and poison declarations.
    pub fun decl_name_span(): Span {
        if self.name_span.is_none() { return self.span }
        return self.name_span
    }
}

pub fun new_top_decl(span: Span, name: String, kind: TopDeclKind): TopDecl {
    return TopDecl {
        span: span, name: intern(name.as_str()), kind: kind, crate: crate_id_poison(),
        module_path: intern(""), decl: null, generics: List.new<TypeParam>(),
        annotations: List.new<Annotation>(), from_trait_impl: false, linkage: linkage_source(),
        link_name: intern(""), dyn_layouts: List.new<DynTraitLayout>(),
        dyn_vtables: List.new<DynVTableInstance>(), decl_end: 0, name_span: no_span(), ext_name: intern(""),
        resolves_in: intern(""), is_sealed: false, is_view: false, implemented_lang_trait: intern("")
    }
}

/// Stamps the owner onto nested methods too, which are checked as
/// declarations in their own right.
pub mutating fun TopDecl.stamp_decl_owner(crate: CrateId, module_path: Sym): void {
    self.module_path = module_path
    self.crate = crate
    when (self.kind) {
        ImplBlock(methods) => {
            stamp_nested_decl_owners(&var methods, crate, module_path)
            self.kind = TopDeclKind.ImplBlock(methods)
        }
        TraitDecl(methods, is_pub, supers) => {
            stamp_nested_decl_owners(&var methods, crate, module_path)
            self.kind = TopDeclKind.TraitDecl(methods, is_pub, supers)
        }
        TraitImpl(trait_ref, methods) => {
            stamp_nested_decl_owners(&var methods, crate, module_path)
            self.kind = TopDeclKind.TraitImpl(trait_ref, methods)
        }
        Template(kind, marked, body) => {
            stamp_nested_decl_owners(&var body, crate, module_path)
            self.kind = TopDeclKind.Template(kind, marked, body)
        }
        _ => {}
    }
}

pub fun stamp_nested_decl_owners(methods: &var List<TopDecl>, crate: CrateId, module_path: Sym): void {
    while i in 0..methods.size() {
        stamp_decl_owner(methods.at_mut(i), crate, module_path)
    }
}

impl Module {
    /// `@no_mangle`: its C name and every symbol derived from it carry no
    /// crate prefix.
    pub fun type_is_no_mangle(name: str): bool {
        while td in &self.decls {
            if td.name.as_str() == name && td.has_annotation("no_mangle") {
                when (td.kind) {
                    Struct(_fields, _is_pub) => return true
                    EnumDecl(_variants, _is_pub) => return true
                    _ => {}
                }
            }
        }
        return false
    }
}
