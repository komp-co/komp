// The `@derive(...)` options, as data. The expander is a tag that
// kf-typecheck's derive.kf dispatches, since kf-core cannot name its
// functions.

import alloc.list.*

pub enum DeriveExpander {
    Default
    Equal
    Clone
    Copy
    Hash
}

pub struct DeriveInfo {
    pub val name: String
    pub val struct_ok: bool
    pub val enum_ok: bool
    pub val expander: DeriveExpander
    /// The key the synthesized impl names: `@derive(Equal)` writes
    /// `impl <lang("equal")> for X`.
    pub val lang_key: String
}

/// Adding one is an entry here plus a case in kf-typecheck's
/// `expand_one_derive`.
pub fun derive_registry(): List<DeriveInfo> {
    var out = List.new<DeriveInfo>()
    out.push(DeriveInfo { name: String.from("Default"), struct_ok: true, enum_ok: false,
        expander: DeriveExpander.Default, lang_key: String.from(lang_default_key()) })
    out.push(DeriveInfo { name: String.from("Equal"), struct_ok: true, enum_ok: true,
        expander: DeriveExpander.Equal, lang_key: String.from(lang_equal_key()) })
    out.push(DeriveInfo { name: String.from("Clone"), struct_ok: true, enum_ok: true,
        expander: DeriveExpander.Clone, lang_key: String.from(lang_clone_key()) })
    out.push(DeriveInfo { name: String.from("Copy"), struct_ok: true, enum_ok: true,
        expander: DeriveExpander.Copy, lang_key: String.from(lang_copy_key()) })
    out.push(DeriveInfo { name: String.from("Hash"), struct_ok: true, enum_ok: false,
        expander: DeriveExpander.Hash, lang_key: String.from(lang_hash_key()) })
    return out
}

/// A poison entry (empty name) when nothing answers to `name`.
pub fun lookup_derive(name: str): DeriveInfo {
    val all = derive_registry()
    while d in &all {
        if d.name.as_str().equals(name) { return d.clone() }
    }
    return DeriveInfo { name: "", struct_ok: false, enum_ok: false,
        expander: DeriveExpander.Default, lang_key: "" }
}

pub fun derive_options_of(annotation: str): List<String> {
    return annotation_args(annotation, "derive")
}

pub fun derivable_on_struct(name: str): bool {
    return lookup_derive(name).struct_ok
}

pub fun derivable_on_enum(name: str): bool {
    return lookup_derive(name).enum_ok
}

pub fun struct_derive_summary(): String {
    return derive_summary(true)
}

pub fun enum_derive_summary(): String {
    return derive_summary(false)
}

fun derive_summary(structs: bool): String {
    var names = List.new<String>()
    val all = derive_registry()
    var i = 0
    while i < all.size() {
        val d = *all.at(i)
        val ok = if structs { d.struct_ok } else { d.enum_ok }
        if ok { names.push(d.name.clone()) }
        i = i + 1
    }
    var out = String.from("")
    i = 0
    while i < names.size() {
        if i > 0 {
            if i == names.size() - 1 { out.append(" or ") } else { out.append(", ") }
        }
        out.append("`")
        out.append(names.at(i).as_str())
        out.append("`")
        i = i + 1
    }
    return out
}
