// View types: a `view struct` or `view enum` borrows from somewhere, as `str`
// and `&T` do, so the borrow rules treat its values as borrows.

import alloc.list.*
import kf_core.ast.declaration.TopDecl

impl TopDecl {
    /// Its values borrow, and its own fields may hold borrows.
    pub fun is_view_type(): bool {
        when (self.kind) {
            Struct(_fields, _is_pub) => return self.is_view
            EnumDecl(_variants, _is_pub) => return self.is_view
            _ => return false
        }
    }
}

impl Module {
    /// Every view type by declared name, dependencies' and instances included.
    pub fun view_type_names(): List<String> {
        var out = List.new<String>()
        while td in &self.decls {
            if td.is_view_type() { out.push(td.name.as_string()) }
        }
        return out
    }
}

/// `name` as written (`Window`, `geometry.Window`) or as an identity
/// (`app::geometry::Window`) names one of `views`.
pub fun names_view(views: &List<String>, name: str): bool {
    val last = last_path_segment(name)
    while view in &views {
        if view.as_str() == name || view.as_str() == last.as_str() { return true }
    }
    return false
}

fun last_path_segment(name: str): String {
    var start: uint64 = 0
    while i in 0..name.byte_len() {
        val b = name.byte_at(i)
        if b == 46 || b == 58 { start = i + 1 }
    }
    return name.substring(start, name.byte_len())
}
