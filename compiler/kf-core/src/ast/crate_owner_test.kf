import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.declaration.new_top_decl
import kf_core.span.no_span

@test
fun new_top_decl_has_poison_crate(): void {
    val decl = new_top_decl(no_span(), String.from("item"), TopDeclKind.Poison)
    assert_eq(decl.crate.is_poison(), true, "new declaration has no crate owner")
}

@test
fun new_module_has_poison_crate(): void {
    val module = new_module(List.new<String>())
    assert_eq(module.crate.is_poison(), true, "new module has no crate owner")
}
