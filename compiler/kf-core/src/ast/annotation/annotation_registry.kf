// The annotations the compiler accepts, as data. Validation and the "unknown
// annotation" message both read this registry.

import alloc.list.*
import kf_core.ast.declaration.TopDecl

/// The declaration kinds an annotation may sit on.
pub enum AnnotationTarget {
    /// `@test`, `@test_disabled`.
    Function
    /// `@derive`, `@no_mangle`.
    StructOrEnum
    /// `@lang` — a type or trait the language builds on.
    StructEnumOrTrait
    /// `@receiver_params`, `@receiver_trait` — a declaration written with an
    /// extension receiver (`ext_name` set).
    Extension
    /// `@allow` — any declaration.
    Any
}

pub struct AnnotationInfo {
    pub val name: String
    pub val target: AnnotationTarget
    /// True for `@name(...)`, false for a bare `@name`.
    pub val takes_args: bool
}

/// Order is the order of the generated "expected" list.
pub fun annotation_registry(): List<AnnotationInfo> {
    var out = List.new<AnnotationInfo>()
    out.push(AnnotationInfo {
        name: String.from("test"),
        target: AnnotationTarget.Function,
        takes_args: false
    })
    out.push(AnnotationInfo {
        name: String.from("test_disabled"),
        target: AnnotationTarget.Function,
        takes_args: false
    })
    out.push(AnnotationInfo {
        name: String.from("allow"),
        target: AnnotationTarget.Any,
        takes_args: true
    })
    out.push(AnnotationInfo {
        name: String.from("derive"),
        target: AnnotationTarget.StructOrEnum,
        takes_args: true
    })
    out.push(AnnotationInfo {
        name: String.from("no_mangle"),
        target: AnnotationTarget.StructOrEnum,
        takes_args: false
    })
    out.push(AnnotationInfo {
        name: String.from("lang"),
        target: AnnotationTarget.StructEnumOrTrait,
        takes_args: true
    })
    out.push(AnnotationInfo {
        name: String.from("prelude"),
        target: AnnotationTarget.Function,
        takes_args: false
    })
    out.push(AnnotationInfo {
        name: String.from("receiver_params"),
        target: AnnotationTarget.Extension,
        takes_args: true
    })
    out.push(AnnotationInfo {
        name: String.from("receiver_trait"),
        target: AnnotationTarget.Extension,
        takes_args: true
    })
    return out
}

/// A poison entry (empty name) when no annotation answers to `kind`.
pub fun lookup_annotation(kind: str): AnnotationInfo {
    val all = annotation_registry()
    while a in &all {
        if a.name.as_str().equals(kind) { return a.clone() }
    }
    return AnnotationInfo { name: "", target: AnnotationTarget.Any, takes_args: false }
}

pub fun annotation_is_known(kind: str): bool {
    return lookup_annotation(kind).name.as_str().byte_len() > 0
}

pub fun annotation_target_allows(target: AnnotationTarget, td: &TopDecl): bool {
    return when (target) {
        Function => when (td.kind) {
            Function(_p, _r, _b, _pub, _u, _m, _s) => true
            _ => false
        }
        StructOrEnum => when (td.kind) {
            Struct(_f, _p) => true
            EnumDecl(_v, _p) => true
            _ => false
        }
        StructEnumOrTrait => when (td.kind) {
            Struct(_f, _p) => true
            EnumDecl(_v, _p) => true
            TraitDecl(_m, _p, _s) => true
            _ => false
        }
        Extension => !td.ext_name.as_str().equals("")
        Any => true
    }
}

/// "a function", "a struct or enum" — the subject of the "can only annotate"
/// error.
pub fun annotation_target_phrase(target: AnnotationTarget): String {
    return when (target) {
        Function => String.from("a function")
        StructOrEnum => String.from("a struct or enum")
        StructEnumOrTrait => String.from("a struct, enum or trait")
        Extension => String.from("an extension function")
        Any => String.from("any declaration")
    }
}

pub fun known_annotations_summary(): String {
    var out = String.from("")
    val all = annotation_registry()
    while i in 0..all.size() {
        val a = *all.at(i)
        if i > 0 {
            if i == all.size() - 1 { out.append(" or ") } else { out.append(", ") }
        }
        out.append("@")
        out.append(a.name.as_str())
        if a.takes_args { out.append("(...)") }
    }
    return out
}
