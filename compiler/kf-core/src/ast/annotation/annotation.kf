// Reading and writing an annotation's arguments.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*

/// One the compiler writes itself, each word a bare name:
/// `receiver_params(T, U)`.
pub fun new_annotation(span: Span, name: str, words: List<String>): Annotation {
    var args = List.new<AnnotationArg>()
    while word in &words {
        val value = Expr.new(span, ExprKind.Variable(intern(word.as_str())))
        args.push(AnnotationArg { name: intern(""), value: Box.new(value) })
    }
    return Annotation { name: intern(name), args: args, has_parens: words.size() > 0, span: span }
}

impl Annotation {
    /// Each positional argument that is a bare name or a string, as text, in
    /// order: `@derive(Clone, Equal)` gives `["Clone", "Equal"]` and
    /// `@lang("string")` gives `["string"]`.
    pub fun words(): List<String> {
        var out = List.new<String>()
        while arg in &self.args {
            if !arg.name.as_str().equals("") { continue }
            when (arg.value.kind) {
                Variable(word) => out.push(word.as_string())
                LitStr(text) => out.push(text.clone())
                _ => {}
            }
        }
        return out
    }

    /// As it would be written, without the `@`: `derive(Clone, Equal)`.
    pub fun to_source(): String {
        var out = self.name.as_string()
        if !self.has_parens { return out }
        out.append("(")
        while i in 0..self.args.size() {
            val arg = self.args.at(i)
            if i > 0 { out.append(", ") }
            if !arg.name.as_str().equals("") { out.append("${arg.name.as_str()} = ") }
            out.append(arg.value.argument_source().as_str())
        }
        out.append(")")
        return out
    }
}

/// A name, a literal, a negation or `Enum.Variant`; any other expression
/// renders as `_`.
fun Expr.argument_source(): String {
    return when (self.kind) {
        Variable(name) => name.as_string()
        LitStr(text) => "\"${escaped(text.as_str(), 34)}\""
        LitChar(c) => "'${escaped(String.of(&(c as char)).as_str(), 39)}'"
        LitInt(n) => String.of(&(n))
        LitFloat(spelling) => spelling.clone()
        LitBool(b) => if b { String.from("true") } else { String.from("false") }
        FieldAccess(owner, member) => "${owner.argument_source().as_str()}.${member.as_str()}"
        Unary(op, inner) => when (op) {
            Neg => "-${inner.argument_source().as_str()}"
            Not => "!${inner.argument_source().as_str()}"
        }
        _ => String.from("_")
    }
}

/// `text` with `\`, the `quote` byte and a newline escaped.
fun escaped(text: str, quote: uint8): String {
    var out = String.from("")
    while i in 0..text.byte_len() {
        val b = text.byte_at(i)
        if b == 92 || b == quote { out.append("\\") }
        if b == 10 {
            out.append("\\n")
        } else {
            out.append(text.substring(i, i + 1).as_str())
        }
    }
    return out
}

impl MarkKind {
    /// `fun`, `struct`, `field`..., as written after `on`.
    pub fun word(): str {
        return when (self) {
            Function => "fun"
            Struct => "struct"
            Enum => "enum"
            Trait => "trait"
            Field => "field"
            Variant => "variant"
        }
    }

    /// A struct's field or an enum's variant, as against a declaration.
    pub fun is_member(): bool {
        return when (self) {
            Field => true
            Variant => true
            _ => false
        }
    }
}

/// The kind `word` names; null for anything else.
pub fun mark_kind_of(word: str): MarkKind? {
    return when word {
        "fun" => MarkKind.Function
        "struct" => MarkKind.Struct
        "enum" => MarkKind.Enum
        "trait" => MarkKind.Trait
        "field" => MarkKind.Field
        "variant" => MarkKind.Variant
        _ => null
    }
}

/// `on any`: every declaration kind, without bounds.
pub fun any_kind_target(): MarkTarget {
    var kinds = List.new<KindTarget>()
    kinds.push(KindTarget { kind: MarkKind.Function, bounds: List.new<TypeRef>() })
    kinds.push(KindTarget { kind: MarkKind.Struct, bounds: List.new<TypeRef>() })
    kinds.push(KindTarget { kind: MarkKind.Enum, bounds: List.new<TypeRef>() })
    kinds.push(KindTarget { kind: MarkKind.Trait, bounds: List.new<TypeRef>() })
    return MarkTarget.Kinds(kinds)
}

impl MarkTarget {
    /// The listed kinds; empty for a function type.
    pub fun kinds(): List<KindTarget> {
        var kinds = List.new<KindTarget>()
        when (self) {
            Kinds(listed) => kinds = listed.clone()
            _ => {}
        }
        return kinds
    }
}

impl TypeRef {
    /// `_`, any one type.
    pub fun is_wildcard(): bool {
        return when (self.kind) {
            Named(name, args) => args.size() == 0 && name.as_str() == "_"
            _ => false
        }
    }

    /// `_`, `&_` or `&var _`: a wildcard where a signature pattern admits one.
    pub fun is_wildcard_slot(): bool {
        return when (self.kind) {
            Reference(_is_mutable, inner) => inner.is_wildcard()
            _ => self.is_wildcard()
        }
    }

    /// A `_` anywhere inside, including the type itself.
    pub fun mentions_wildcard(): bool {
        if self.is_wildcard() { return true }
        when (self.kind) {
            Named(_name, args) => return args.any_mentions_wildcard()
            DynTrait(_name, args) => return args.any_mentions_wildcard()
            Function(params, ret) => return params.any_mentions_wildcard() || ret.mentions_wildcard()
            Reference(_is_mutable, inner) => return inner.mentions_wildcard()
            Array(element, _size) => return element.mentions_wildcard()
            Projection(owner, _member) => return owner.mentions_wildcard()
            Value(_v) => return false
            Poison => return false
        }
    }
}

fun List<TypeRef>.any_mentions_wildcard(): bool {
    while item in &self {
        if item.mentions_wildcard() { return true }
    }
    return false
}
