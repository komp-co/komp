import alloc.list.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind

// Generic substitution and monomorphized-name mangling over TypeRef.
// CONSTRAINT: in kf-core because kf-typecheck, upstream of kf-mono,
// instantiates layouts on demand too. Mangling matches mangle.kf's `__`
// convention.

/// `List<int32>` is "List__int32", `Pair<int32,str>` is "Pair__int32__str".
pub fun TypeRef.mangle_tyref(): String {
    when (self.kind) {
        Named(n, args) => {
            if args.size() == 0 { return String.from(n.as_str()) }
            var result = String.from(n.as_str())
            while item in &args {
                result.append("__")
                val arg = item.mangle_tyref()
                result.append(arg.as_str())
            }
            return result
        }
        DynTrait(n, args) => {
            var result = String.from("Dyn__")
            result.append(n.as_str())
            while item in &args {
                result.append("__")
                val arg = item.mangle_tyref()
                result.append(arg.as_str())
            }
            return result
        }
        Reference(is_mut, inner) => {
            // `&dyn Trait` is a fat value already named `Dyn__Trait`; it is
            // not wrapped as a pointer.
            val pointee_ref = unsafe { *inner }
            when (pointee_ref.kind) {
                DynTrait(_p, _a) => return mangle_tyref(unsafe { &*inner })
                _ => {}
            }
            // `&T` is not `T`: `List<&A>` and `List<A>` need different names.
            val pointee = mangle_tyref(unsafe { &*inner })
            return borrow_frag(is_mut, pointee.as_str())
        }
        Function(params, ret) => {
            var frags = List.new<String>()
            while param in &params {
                frags.push(mangle_tyref(param))
            }
            return fn_frag(&frags, mangle_tyref(&*ret).as_str())
        }
        Array(elem, _n) => {
            var result = String.from("Array__")
            val item = mangle_tyref(unsafe { &*elem })
            result.append(item.as_str())
            return result
        }
        // Named by owner and member so substitution can rewrite the owner.
        Projection(owner, member) => {
            val inner = mangle_tyref(unsafe { &*owner })
            return projection_mangle_frag(inner.as_str(), member.as_str())
        }
        Value(v) => return value_frag(v)
        Poison => return String.from("poison")
    }
}

/// `Pair`, [int32, str] is "Pair__int32__str"; no args is the bare base.
pub fun monomorphized_type_name(base: String, args: &List<TypeRef>): String {
    if args.size() == 0 {
        return base
    }
    var result = base
    while item in &args {
        result.append("__")
        val arg = item.mangle_tyref()
        result.append(arg.as_str())
    }
    return result
}

pub fun subst_tref_list(items: &List<TypeRef>, names: &var List<String>, repls: &var List<TypeRef>): List<TypeRef> {
    var out = List.new<TypeRef>()
    while item in &items {
        out.push(item.subst_type_ref(names, repls))
    }
    return out
}

/// `names`/`repls` are parallel: parameter name, replacement.
pub fun TypeRef.subst_type_ref(names: &var List<String>, repls: &var List<TypeRef>): TypeRef {
    when (self.kind) {
        Named(n, args) => {
            if args.size() == 0 {
                while i in 0..names.size() {
                    val nm = *names.at(i)
                    if nm.as_str().equals(n.as_str()) {
                        return clone_type_ref(repls.at(i))
                    }
                }
                return self.clone_type_ref()
            }
            var new_args = List.new<TypeRef>()
            while arg in &args {
                new_args.push(arg.subst_type_ref(names, repls))
            }
            return TypeRef.new(self.span, TypeRefKind.Named(n, new_args))
        }
        DynTrait(n, args) => {
            return TypeRef.new(self.span, TypeRefKind.DynTrait(n, subst_tref_list(&args, names, repls)))
        }
        Reference(is_mut, inner) => {
            val sub = subst_type_ref(unsafe { &*inner }, names, repls)
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = sub }
            return TypeRef.new(self.span, TypeRefKind.Reference(is_mut, q))
        }
        Function(params, ret) => {
            val result = Box.new(subst_type_ref(&*ret, names, repls))
            return TypeRef.new(self.span, TypeRefKind.Function(subst_tref_list(&params, names, repls), result))
        }
        Array(_elem, _n) => return self.clone_type_ref()
        Value(v) => return TypeRef.new(self.span, TypeRefKind.Value(v))
        // Only the owner is substituted; the impl chooses the member.
        Projection(owner, member) => {
            val osub = subst_type_ref(unsafe { &*owner }, names, repls)
            val oq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *oq = osub }
            return TypeRef.new(self.span, TypeRefKind.Projection(oq, member))
        }
        Poison => return TypeRef.new_poison(self.span)
    }
}

/// An independent owned copy, taken through a borrow so no by-value shallow
/// copy is dropped (which would double-free nested buffers).
pub fun TypeRef.clone_type_ref(): TypeRef {
    when (self.kind) {
        Named(n, args) => {
            var new_args = List.new<TypeRef>()
            while arg in &args {
                new_args.push(arg.clone_type_ref())
            }
            return TypeRef.new(self.span, TypeRefKind.Named(n, new_args))
        }
        DynTrait(n, args) => {
            return TypeRef.new(self.span, TypeRefKind.DynTrait(n, clone_tref_vec(&args)))
        }
        Reference(is_mut, inner) => {
            val sub = clone_type_ref(unsafe { &*inner })
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = sub }
            return TypeRef.new(self.span, TypeRefKind.Reference(is_mut, q))
        }
        Function(ps, ret) => {
            var new_ps = List.new<TypeRef>()
            while item in &ps {
                new_ps.push(item.clone_type_ref())
            }
            val rsub = clone_type_ref(unsafe { &*ret })
            val rq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *rq = rsub }
            return TypeRef.new(self.span, TypeRefKind.Function(new_ps, rq))
        }
        Array(elem, n) => {
            val esub = clone_type_ref(unsafe { &*elem })
            val eq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *eq = esub }
            return TypeRef.new(self.span, TypeRefKind.Array(eq, n))
        }
        // A clone copies. Poisoning a projection here would erase it from every
        // signature, since modules are deep-cloned before typecheck.
        Projection(owner, member) => {
            val osub = clone_type_ref(unsafe { &*owner })
            val oq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *oq = osub }
            return TypeRef.new(self.span, TypeRefKind.Projection(oq, member))
        }
        Value(v) => return TypeRef.new(self.span, TypeRefKind.Value(v))
        Poison => return TypeRef.new_poison(self.span)
    }
}

pub fun clone_tref_vec(src: &List<TypeRef>): List<TypeRef> {
    var out = List.new<TypeRef>()
    while item in &src {
        out.push(item.clone_type_ref())
    }
    return out
}
