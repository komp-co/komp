import alloc.list.*

pub fun clone_expr_ptr(p: Ptr<Expr>, names: &var List<String>, repls: &var List<TypeRef>): Ptr<Expr> {
    val np: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *np = subst_expr(&*p, names, repls) }
    return np
}

/// An absent operand (a bare `return`) stays absent.
fun clone_expr_box_opt(p: Ptr<Expr>?, names: &var List<String>, repls: &var List<TypeRef>): Box<Expr>? {
    return when (p) {
        Some(inner) => clone_expr_ptr(inner, names, repls)
        None => null
    }
}

/// An absent guard stays absent.
pub fun clone_expr_ptr_opt(p_opt: Ptr<Expr>?, names: &var List<String>, repls: &var List<TypeRef>): Box<Expr>? {
    val p = p_opt ?: return null
    return clone_expr_ptr(p, names, repls)
}

fun clone_tref_ptr(p: Ptr<TypeRef>, names: &var List<String>, repls: &var List<TypeRef>): Ptr<TypeRef> {
    val np: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *np = subst_type_ref(&*p, names, repls) }
    return np
}

fun clone_tref_ptr_opt(popt: Ptr<TypeRef>?, names: &var List<String>, repls: &var List<TypeRef>): Box<TypeRef>? {
    val p = popt ?: return null
    val np: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *np = subst_type_ref(&*p, names, repls) }
    return np
}

fun Expr.rebuild_expr(new_kind: ExprKind, names: &var List<String>, repls: &var List<TypeRef>): Expr {
    return Expr {
        span:           self.span,
        name_span:      self.name_span,
        kind:           new_kind,
        decl:           self.decl,
        ty:             self.ty.subst_type(names, repls),
        mangled_callee: self.mangled_callee,
        coerce:         self.coerce,
        type_args:      subst_tref_list(self.type_args, names, repls),
        type_args_written: self.type_args_written,
        is_static_call: self.is_static_call,
        is_dynamic_call: self.is_dynamic_call,
        dynamic_slot: self.dynamic_slot,
        dynamic_layout: intern(subst_mangled_name(self.dynamic_layout.as_str(), names, repls).as_str()),
        is_intrinsic:   self.is_intrinsic,
        is_safe_call_value: self.is_safe_call_value,
        is_variant_ctor: self.is_variant_ctor,
        derefs_at_call: self.derefs_at_call
    }
}

pub fun Expr.subst_expr(names: &var List<String>, repls: &var List<TypeRef>): Expr {
    when (self.kind) {
        LitInt(v) => return self.rebuild_expr(ExprKind.LitInt(v), names, repls)
        LitStr(sv) => return self.rebuild_expr(ExprKind.LitStr(sv.clone()), names, repls)
        LitFloat(fv) => return self.rebuild_expr(ExprKind.LitFloat(fv.clone()), names, repls)
        LitChar(cv) => return self.rebuild_expr(ExprKind.LitChar(cv), names, repls)
        LitBool(b) => return self.rebuild_expr(ExprKind.LitBool(b), names, repls)
        Variable(nm) => return self.rebuild_expr(ExprKind.Variable(nm), names, repls)
        Binary(lp, op, rp) => {
            val nl = clone_expr_ptr(lp, names, repls)
            val nr = clone_expr_ptr(rp, names, repls)
            return self.rebuild_expr(ExprKind.Binary(nl, op, nr), names, repls)
        }
        Unary(op, ip) => return self.rebuild_expr(ExprKind.Unary(op, clone_expr_ptr(ip, names, repls)), names, repls)
        Deref(ip) => return self.rebuild_expr(ExprKind.Deref(clone_expr_ptr(ip, names, repls)), names, repls)
        Call(nm, args) => {
            val nnm = subst_mangled_name(nm.as_str(), names, repls)
            val nargs = subst_expr_list(args, names, repls)
            var call = self.rebuild_expr(ExprKind.Call(intern(nnm.as_str()), nargs), names, repls)
            call.mangled_callee = intern(subst_mangled_name(self.mangled_callee.as_str(), names, repls).as_str())
            return call
        }
        MethodCall(recv_ptr, m, args) => {
            val nr = clone_expr_ptr(recv_ptr, names, repls)
            var nargs = subst_expr_list(args, names, repls)
            // CONSTRAINT: only here are receiver and argument still both
            // spelled with the same type parameter. When it stands for a
            // borrow, the auto-dereferenced receiver's by-value `Self`
            // arguments must follow it.
            mark_self_shaped_args(unsafe { &(*recv_ptr).ty }, args, &var nargs, names, repls)
            var mc = self.rebuild_expr(ExprKind.MethodCall(nr, m, nargs), names, repls)
            // `T.method(...)` carries the placeholder callee `T_method`;
            // substituting `T` gives the real static.
            if self.is_static_call || !self.mangled_callee.as_str().equals("") {
                mc.mangled_callee = intern(subst_static_callee(self.mangled_callee.as_str(), names, repls).as_str())
            }
            return mc
        }
        FieldAccess(obj_ptr, f) => {
            val no = clone_expr_ptr(obj_ptr, names, repls)
            return self.rebuild_expr(ExprKind.FieldAccess(no, f), names, repls)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            val nc = clone_expr_ptr(c_ptr, names, repls)
            val nt = clone_expr_ptr(t_ptr, names, repls)
            val nel = clone_expr_ptr(e_ptr, names, repls)
            return self.rebuild_expr(ExprKind.IfExpr(nc, nt, nel), names, repls)
        }
        WhenExpr(subj_ptr, arms) => {
            val ns = clone_expr_ptr(subj_ptr, names, repls)
            return self.rebuild_expr(ExprKind.WhenExpr(ns, subst_arm_list(&arms, names, repls)), names, repls)
        }
        StructLit(nm, finits) => {
            var nfi = List.new<FieldInit>()
            while fi in &finits {
                val nv = clone_expr_ptr(fi.value, names, repls)
                nfi.push(new_field_init(fi.span, fi.name.as_string(), nv))
            }
            return self.rebuild_expr(ExprKind.StructLit(nm, nfi), names, repls)
        }
        Cast(ip, tref_ptr) => {
            val ni = clone_expr_ptr(ip, names, repls)
            val ntref = clone_tref_ptr(tref_ptr, names, repls)
            return self.rebuild_expr(ExprKind.Cast(ni, ntref), names, repls)
        }
        DynCoerce(ip, vtable) => {
            val ni = clone_expr_ptr(ip, names, repls)
            val concrete_vtable = subst_mangled_name(vtable.as_str(), names, repls)
            return self.rebuild_expr(ExprKind.DynCoerce(ni, intern(concrete_vtable.as_str())), names, repls)
        }
        Retain(ip) => {
            val ni = clone_expr_ptr(ip, names, repls)
            return self.rebuild_expr(ExprKind.Retain(ni), names, repls)
        }
        Release(nm) => return self.rebuild_expr(ExprKind.Release(nm), names, repls)
        Lambda(ps, b) => return self.rebuild_expr(ExprKind.Lambda(ps.clone(), b.clone()), names, repls)
        Block(stmts) => return self.rebuild_expr(ExprKind.Block(subst_stmt_list(&stmts, names, repls)), names, repls)
        Poison => return self.rebuild_expr(ExprKind.Poison, names, repls)
    }
}

fun subst_expr_list(args: &List<Expr>, names: &var List<String>, repls: &var List<TypeRef>): List<Expr> {
    var out = List.new<Expr>()
    while arg in &args {
        out.push(arg.subst_expr(names, repls))
    }
    return out
}

// Rewrites the type prefix of a static callee `Type_method` when `Type` is a
// substituted parameter. A concrete prefix is returned unchanged.
pub fun subst_static_callee(callee: str, names: &var List<String>, repls: &var List<TypeRef>): String {
    val s = callee
    val n = s.byte_len()
    // The boundary is the first single `_`: `__` is the mangle's compound
    // delimiter, so `List__T_push` splits as `List__T` + `push`.
    var us: uint64 = n
    var i = 0
    while i < n {
        if s.byte_at(i) == 95 {
            if i + 1 < n && s.byte_at(i + 1) == 95 {
                i = i + 2
            } else {
                us = i
                i = n
            }
        } else {
            i = i + 1
        }
    }
    if us == n { return String.from(callee) }
    val prefix = s.substring(0, us)
    val method = s.substring(us + 1, n)
    // The owner prefix and the method tail (which may carry trait arguments)
    // are both rewritten. A bare parameter standing for a borrow contributes
    // its pointee in owner position: impls are registered on `int32`, not
    // `&int32`. Only a bare one; `List__T_push` genuinely is
    // `List__kf__ref__Square`.
    var result = ""
    if name_is_bare_param(prefix.as_str(), names) {
        var through = repls_through_borrow(repls)
        result = subst_mangled_name(prefix.as_str(), names, &var through)
    } else {
        result = subst_mangled_name(prefix.as_str(), names, repls)
    }
    result.append("_")
    val suffix = subst_mangled_name(method.as_str(), names, repls)
    result.append(suffix.as_str())
    return result
}

/// The whole name is a parameter, not a compound containing one.
fun name_is_bare_param(name: str, names: &var List<String>): bool {
    while item in &names {
        if item.as_str().equals(name) { return true }
    }
    return false
}

/// Each borrow read through to what it borrows; owner position only.
fun repls_through_borrow(repls: &var List<TypeRef>): List<TypeRef> {
    var out = List.new<TypeRef>()
    while repl in &repls {
        out.push(tyref_through_borrow(repl))
    }
    return out
}

fun tyref_through_borrow(t: TypeRef): TypeRef {
    when (t.kind) {
        Reference(_m, inner) => { return tyref_through_borrow(unsafe { *inner }) }
        _ => { }
    }
    return t
}

/// See `Expr.derefs_at_call`. Both sides are read before substitution: the
/// receiver must be the bare parameter `P` and the argument spelled `P` too.
fun Type.mark_self_shaped_args(args: &List<Expr>, out: &var List<Expr>, names: &var List<String>, repls: &var List<TypeRef>): void {
    val pname = self.generic_param_name()
    if pname.as_str().equals("") { return }
    if !replacement_is_a_borrow(pname.as_str(), names, repls) { return }
    while i in 0..args.size() {
        if i < out.size() {
            val arg_param = generic_param_name(&args.at(i).ty)
            if arg_param.as_str().equals(pname.as_str()) {
                unsafe { out.at_mut(i).derefs_at_call = true }
            }
        }
    }
}

fun Type.generic_param_name(): String {
    return when (self.kind) {
        Generic(n) => n.as_string()
        _ => ""
    }
}

fun replacement_is_a_borrow(pname: str, names: &var List<String>, repls: &var List<TypeRef>): bool {
    while i in 0..names.size() {
        if names.at(i).as_str().equals(pname) {
            if i < repls.size() {
                return when (repls.at(i).kind) {
                    Reference(_m, _inner) => true
                    _ => false
                }
            }
        }
    }
    return false
}

pub fun subst_mangled_name(name: str, names: &var List<String>, repls: &var List<TypeRef>): String {
    // Only a segment naming a parameter changes; the common case has none.
    if !name.has_param_segment(names) { return String.from(name) }
    val s = name
    val n = s.byte_len()
    var out = ""
    var seg_start: uint64 = 0
    var emitted_any = false
    var i: uint64 = 0
    while i + 1 < n {
        val d0 = s.byte_at(i)
        val d1 = s.byte_at(i + 1)
        if d0 == 95 && d1 == 95 {
            val seg = s.substring(seg_start, i)
            if emitted_any { out.append("__") }
            val chosen = if out.replacement_is_suffix(seg.as_str(), repls) { String.from(seg.as_str()) } else { pick_seg(seg.as_str(), names, repls) }
            out.append(chosen.as_str())
            emitted_any = true
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    val tail = s.substring(seg_start, n)
    if emitted_any { out.append("__") }
    val chosen_tail = if out.replacement_is_suffix(tail.as_str(), repls) { String.from(tail.as_str()) } else { pick_seg(tail.as_str(), names, repls) }
    out.append(chosen_tail.as_str())
    return out
}

/// Whether some `__`-separated segment of the name is one of `names`.
fun str.has_param_segment(names: &List<String>): bool {
    if names.size() == 0 { return false }
    val n = self.byte_len()
    var seg_start: uint64 = 0
    var i: uint64 = 0
    while i + 1 < n {
        if self.byte_at(i) == 95 && self.byte_at(i + 1) == 95 {
            if self.substring(seg_start, i).as_str().is_one_of(names) { return true }
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    return self.substring(seg_start, n).as_str().is_one_of(names)
}

fun str.is_one_of(names: &List<String>): bool {
    while item in &names {
        if item.as_str().equals(self) { return true }
    }
    return false
}

// A compound can already hold a complete replacement (`List__kf_core__Stmt`);
// its final segment must not be expanded again.
fun String.replacement_is_suffix(segment: str, repls: &var List<TypeRef>): bool {
    var candidate = String.from(self.as_str())
    candidate.append(segment)
    while repl in &repls {
        val replacement = repl.mangle_tyref()
        val candidate_len = candidate.as_str().byte_len()
        val replacement_len = replacement.as_str().byte_len()
        if replacement_len <= candidate_len {
            val start = candidate_len - replacement_len
            var boundary = start == 0
            if start >= 2 {
                boundary = candidate.as_str().byte_at(start - 1) == 95 && candidate.as_str().byte_at(start - 2) == 95
            }
            if boundary {
                var same = true
                var j = 0
                while j < replacement_len {
                    if candidate.as_str().byte_at(start + j) != replacement.as_str().byte_at(j) { same = false }
                    j = j + 1
                }
                if same { return true }
            }
        }
    }
    return false
}

fun pick_seg(seg: str, names: &var List<String>, repls: &var List<TypeRef>): String {
    while i in 0..names.size() {
        if names.at(i).as_str().equals(seg) {
            if i < repls.size() {
                val item = *repls.at(i)
                return item.mangle_tyref()
            }
        }
    }
    return String.from(seg)
}
