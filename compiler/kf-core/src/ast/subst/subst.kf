import alloc.list.*

import kf_core.span.no_span

/// A deep copy: the rebuilt arm and the original both drop their pattern.
pub fun fresh_pattern_box(pp: Ptr<Pattern>): Ptr<Pattern> {
    val np: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *np = (*pp).clone() }
    return np
}

pub fun clone_sym_list(ss: &List<Sym>): List<Sym> {
    var out = List.new<Sym>()
    while item in &ss {
        out.push(item)
    }
    return out
}

/// Each rebuilt arm gets its own pattern, since both arms are dropped.
pub fun subst_arm_list(arms: &List<Arm>, names: &var List<String>, repls: &var List<TypeRef>): List<Arm> {
    var narms = List.new<Arm>()
    while a in &arms {
        val ng = clone_expr_ptr_opt(a.guard.view(), names, repls)
        val nbody = subst_stmt_list(a.body, names, repls)
        narms.push(new_arm(a.span, fresh_pattern_box(a.pattern), ng, nbody))
    }
    return narms
}

pub fun subst_stmt_list(stmts: &List<Stmt>, names: &var List<String>, repls: &var List<TypeRef>): List<Stmt> {
    var out = List.new<Stmt>()
    while stmt in &stmts {
        out.push(stmt.subst_stmt(names, repls))
    }
    return out
}

/// Carries the binder span across, since the rebuilds below go through
/// `new_stmt`, which has none.
pub fun Stmt.subst_stmt(names: &var List<String>, repls: &var List<TypeRef>): Stmt {
    val binder = self.binder
    var out = self.subst_stmt_kinded(names, repls)
    out.binder = binder
    return out
}

fun Stmt.subst_stmt_kinded(names: &var List<String>, repls: &var List<TypeRef>): Stmt {
    when (self.kind) {
        LetVal(nm, ty_ptr, init_ptr) => {
            val nty = clone_tref_ptr_opt(ty_ptr.view(), names, repls)
            // A null init is `var x: T` with no value.
            val ninit = clone_expr_ptr_opt(init_ptr.view(), names, repls)
            return new_stmt(self.span, StmtKind.LetVal(nm, nty, ninit))
        }
        LetVar(nm, ty_ptr, init_ptr) => {
            val nty = clone_tref_ptr_opt(ty_ptr.view(), names, repls)
            // A null init is `var x: T` with no value.
            val ninit = clone_expr_ptr_opt(init_ptr.view(), names, repls)
            return new_stmt(self.span, StmtKind.LetVar(nm, nty, ninit))
        }
        Assign(nm, expr_ptr) => {
            val ne = clone_expr_ptr(expr_ptr, names, repls)
            return new_stmt(self.span, StmtKind.Assign(nm, ne))
        }
        AssignTo(place_ptr, expr_ptr) => {
            val np = clone_expr_ptr(place_ptr, names, repls)
            val ne = clone_expr_ptr(expr_ptr, names, repls)
            return new_stmt(self.span, StmtKind.AssignTo(np, ne))
        }
        Return(expr_ptr) => {
            val ne = clone_expr_box_opt(expr_ptr.view(), names, repls)
            return new_stmt(self.span, StmtKind.Return(ne))
        }
        If(cond_ptr, then_body, else_body) => {
            val nc = clone_expr_ptr(cond_ptr, names, repls)
            val nt = subst_stmt_list(then_body, names, repls)
            val nel = subst_stmt_list(else_body, names, repls)
            return new_stmt(self.span, StmtKind.If(nc, nt, nel))
        }
        While(cond_ptr, body) => {
            val nc = clone_expr_ptr(cond_ptr, names, repls)
            val nb = subst_stmt_list(body, names, repls)
            return new_stmt(self.span, StmtKind.While(nc, nb))
        }
        ForEach(binder, subj_ptr, body) => {
            val ns = clone_expr_ptr(subj_ptr, names, repls)
            val nb = subst_stmt_list(body, names, repls)
            return new_stmt(self.span, StmtKind.ForEach(binder, ns, nb))
        }
        When(subj_ptr, arms) => {
            val ns = clone_expr_ptr(subj_ptr, names, repls)
            return new_stmt(self.span, StmtKind.When(ns, subst_arm_list(&arms, names, repls)))
        }
        Expression(expr_ptr) => {
            val ne = clone_expr_ptr(expr_ptr, names, repls)
            return new_stmt(self.span, StmtKind.Expression(ne))
        }
        Switch(subj_ptr, sarms) => {
            val ns = clone_expr_ptr(subj_ptr, names, repls)
            var narms = List.new<SwitchArm>()
            while sa in &sarms {
                val nbody = subst_stmt_list(sa.body, names, repls)
                val nguard = clone_expr_ptr_opt(sa.guard.view(), names, repls)
                val nprelude = subst_stmt_list(sa.guard_prelude, names, repls)
                narms.push(new_guarded_switch_arm(sa.span, sa.tag, clone_sym_list(sa.binders), nguard, nprelude, nbody))
            }
            return new_stmt(self.span, StmtKind.Switch(ns, narms))
        }
        Drop(nm) => return new_stmt(self.span, StmtKind.Drop(nm))
        Release(nm) => return new_stmt(self.span, StmtKind.Release(nm))
        Break => return new_stmt(self.span, StmtKind.Break)
        Continue => return new_stmt(self.span, StmtKind.Continue)
        Poison => return stmt_poison(self.span)
    }
}

pub fun Type.subst_type(names: &var List<String>, repls: &var List<TypeRef>): Type {
    when (self.kind) {
        Generic(n) => {
            val r = lookup_repl_type(n.as_string(), names, repls)
            if r.found { return r.ty }
            return unsafe { *self }
        }
        Struct(n)  => return subst_named_type(n.as_string(), self, names, repls, true)
        EnumTy(n)  => return subst_named_type(n.as_string(), self, names, repls, false)
        DynTraitTy(object) => {
            val args = new_type_vec()
            val source_args = unsafe { object.args }
            var i = 0
            while i < unsafe { source_args.size() } {
                args.push(subst_type(unsafe { source_args.at(i) }, names, repls))
                i = i + 1
            }
            val rebuilt = dyn_trait_type(unsafe { object.principal }, args, no_span())
            return Type { kind: rebuilt.kind, provenance: self.provenance }
        }
        PtrTo(p) => {
            val inner = subst_type(unsafe { &*p }, names, repls)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.PtrTo(np), provenance: self.provenance }
        }
        BoxOf(p) => {
            val inner = subst_type(unsafe { &*p }, names, repls)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.BoxOf(np), provenance: self.provenance }
        }
        RefTo(m, p) => {
            val inner = subst_type(unsafe { &*p }, names, repls)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.RefTo(m, np), provenance: self.provenance }
        }
        // Only the owner is substituted; the impl chooses the member.
        Projection(owner, member) => {
            val inner = subst_type(unsafe { &*owner }, names, repls)
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = inner }
            return Type { kind: TypeKind.Projection(np, member), provenance: self.provenance }
        }
        _ => return unsafe { *self }
    }
}

// Exactly a parameter: the concrete type. Otherwise its `__` segments are
// rewritten.
fun subst_named_type(n: String, orig: &Type, names: &var List<String>, repls: &var List<TypeRef>, is_struct: bool): Type {
    val r = lookup_repl_type(n, names, repls)
    if r.found { return r.ty }
    val nn = subst_mangled_name(n.as_str(), names, repls)
    if is_struct {
        return Type { kind: TypeKind.Struct(intern(nn.as_str())), provenance: orig.provenance }
    }
    return Type { kind: TypeKind.EnumTy(intern(nn.as_str())), provenance: orig.provenance }
}

struct ReplLookup { pub val found: bool  pub val ty: Type }

fun lookup_repl_type(n: String, names: &var List<String>, repls: &var List<TypeRef>): ReplLookup {
    while i in 0..names.size() {
        if names.at(i).as_str().equals(n.as_str()) {
            if i < repls.size() {
                return ReplLookup { found: true, ty: tref_to_type_shallow(repls.at(i)) }
            }
        }
    }
    return ReplLookup { found: false, ty: poison_ty() }
}

// Sufficient because Mono's replacement type arguments are already concrete.
fun TypeRef.tref_to_type_shallow(): Type {
    when (self.kind) {
        Named(n, args) => {
            val s = n.as_str()
            return when s {
                "int8" => Type { kind: TypeKind.Int8, provenance: Provenance.Inferred(no_span()) }
                "int16" => Type { kind: TypeKind.Int16, provenance: Provenance.Inferred(no_span()) }
                "int32" => Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) }
                "int64" => Type { kind: TypeKind.Int64, provenance: Provenance.Inferred(no_span()) }
                "uint8" => Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(no_span()) }
                "uint16" => Type { kind: TypeKind.UInt16, provenance: Provenance.Inferred(no_span()) }
                "uint32" => Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(no_span()) }
                "uint64" => Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
                "float32" => Type { kind: TypeKind.Float32, provenance: Provenance.Inferred(no_span()) }
                "float64" => Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(no_span()) }
                "bool" => Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(no_span()) }
                "char" => Type { kind: TypeKind.Char, provenance: Provenance.Inferred(no_span()) }
                "str" => Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
                _ => Type { kind: TypeKind.Struct(intern(self.mangle_tyref().as_str())), provenance: Provenance.Inferred(no_span()) }
            }
        }
        Reference(is_mut, inner) => {
            val it = tref_to_type_shallow(unsafe { &*inner })
            val np: Ptr<Type> = unsafe { alloc<Type>() }
            unsafe { *np = it }
            return Type { kind: TypeKind.RefTo(is_mut, np), provenance: Provenance.Inferred(no_span()) }
        }
        _ => return poison_ty()
    }
}

pub fun subst_dyn_layouts(source: &List<DynTraitLayout>, names: &var List<String>, repls: &var List<TypeRef>): List<DynTraitLayout> {
    var result = List.new<DynTraitLayout>()
    while layout in &source {
        var args = List.new<Type>()
        while arg in &layout.args {
            args.push(arg.subst_type(names, repls))
        }
        var methods = List.new<DynMethodSlot>()
        while method in &layout.methods {
            var params = List.new<Type>()
            while pi in 0..method.params.size() {
                params.push(subst_type(method.params.at(pi), names, repls))
            }
            methods.push(DynMethodSlot {
                name: method.name, params: params, ret: method.ret.subst_type(names, repls),
                is_mutating: method.is_mutating, slot: method.slot
            })
        }
        val identity = subst_mangled_name(layout.identity.as_str(), names, repls)
        result.push(DynTraitLayout {
            identity: intern(identity.as_str()), principal: layout.principal, args: args,
            methods: methods, owner: layout.owner, imported: layout.imported
        })
    }
    return result
}

pub fun subst_dyn_vtables(source: &List<DynVTableInstance>, names: &var List<String>, repls: &var List<TypeRef>): List<DynVTableInstance> {
    var result = List.new<DynVTableInstance>()
    while table in &source {
        var adapters = List.new<Sym>()
        while item in &table.adapters {
            val adapter = subst_static_callee(item.as_str(), names, repls)
            adapters.push(intern(adapter.as_str()))
        }
        val layout = subst_mangled_name(table.layout.as_str(), names, repls)
        val receiver_identity = subst_mangled_name(table.receiver_identity.as_str(), names, repls)
        val symbol = subst_mangled_name(table.symbol.as_str(), names, repls)
        result.push(DynVTableInstance {
            layout: intern(layout.as_str()), receiver: table.receiver.subst_type(names, repls),
            receiver_identity: intern(receiver_identity.as_str()), symbol: intern(symbol.as_str()), adapters: adapters,
            owner: table.owner, linkage: table.linkage
        })
    }
    return result
}
