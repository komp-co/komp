import core.assert.*
import alloc.list.*

import kf_core.span.*

@test fun new_expr_initializes_poison_decl(): void {
    val e = Expr.new(no_span(), ExprKind.LitInt(7))
    assert_eq(e.decl.is_none(), true, "decl id starts absent")
}

@test fun new_expr_round_trips_span(): void {
    val sp = Span { file_id: 1, start: 10, end: 11 }
    val e = Expr.new(sp, ExprKind.LitInt(5))
    assert_eq(e.span.start, 10, "span start")
}

@test fun expr_poison_kind_is_poison(): void {
    val e = Expr.new_poison(no_span())
    when (e.kind) {
        Poison => assert(true, "ok")
        _ => fail("expected Poison kind")
    }
}

@test fun lit_int_kind(): void {
    val e = Expr.new(no_span(), ExprKind.LitInt(42))
    when (e.kind) {
        LitInt(n) => assert_eq(n, 42, "int")
        _ => fail("expected LitInt")
    }
}

@test fun lit_bool_kind(): void {
    val e = Expr.new(no_span(), ExprKind.LitBool(false))
    when (e.kind) {
        LitBool(b) => assert_eq(b, false, "bool")
        _ => fail("expected LitBool")
    }
}

@test fun arg_vec_starts_empty(): void {
    val v = List.new<Expr>()
    assert_eq(v.size(), 0, "fresh arg vec")
}

@test fun arg_vec_push_grows(): void {
    var v = List.new<Expr>()
    v.push(Expr.new_poison(no_span()))
    v.push(Expr.new_poison(no_span()))
    assert_eq(v.size(), 2, "two args")
}
