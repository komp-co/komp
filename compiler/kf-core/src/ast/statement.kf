import alloc.list.*

import kf_core.span.*

@derive(Clone)
pub struct Stmt {
    /// The full extent, not just the leading keyword.
    pub var span: Span
    /// Where the binder name is written (`x` in `val x = 1`); `no_span()` if
    /// nothing is bound. On the outer struct so no kind's payload changes.
    pub var binder: Span
    pub val kind: StmtKind
}

/// One arm of a Lower-desugared `Switch`.
/// CONSTRAINT: in this file so its typedef is emitted before StmtKind's;
/// cross-file typedef order follows file names.
@derive(Clone)
pub struct SwitchArm {
    pub val span:    Span
    pub val tag:     SwitchTag
    pub val binders: List<Sym>
    /// Null when unguarded. Any guard makes codegen emit the whole `Switch`
    /// as an if/else-if chain.
    pub val guard:   Box<Expr>?
    /// Runs before the guard, inside it: binds the guard's owned temporaries
    /// and its value, then drops them. Empty when the guard owns nothing.
    pub var guard_prelude: List<Stmt>
    pub var body:    List<Stmt>
}

@derive(Clone)
pub enum SwitchTag {
    /// `Some(x) =>`, by variant name.
    Variant(String)
    /// `0 =>` / `true =>` over a non-enum subject; booleans arrive as 1 and 0.
    IntLit(int64)
    /// `_ =>`, a C `default:`.
    Wildcard
    /// `0..32 =>`, both bounds inclusive.
    Range(int64, int64)
    /// `A | B =>`: one label per alternative, one body.
    Alternatives(List<SwitchTag>)
}

pub fun new_switch_arm(span: Span, tag: SwitchTag, binders: List<Sym>, guard: Box<Expr>?, body: List<Stmt>): SwitchArm {
    return new_guarded_switch_arm(span, tag, binders, guard, List.new<Stmt>(), body)
}

pub fun new_guarded_switch_arm(
    span: Span,
    tag: SwitchTag,
    binders: List<Sym>,
    guard: Box<Expr>?,
    guard_prelude: List<Stmt>,
    body: List<Stmt>
): SwitchArm {
    return SwitchArm { span: span, tag: tag, binders: binders, guard: guard, guard_prelude: guard_prelude, body: body }
}

pub fun SwitchArm.switch_arm_has_guard(): bool {
    return self.guard.is_some()
}

pub enum StmtKind {
    /// `val name: ty = init`; no annotation means inferred.
    LetVal(Sym, Box<TypeRef>?, Box<Expr>?)
    /// `var name: ty = init`. No initializer only in Lower's `var __whenN: T`,
    /// which then must be annotated.
    LetVar(Sym, Box<TypeRef>?, Box<Expr>?)
    /// `name = expr`.
    Assign(Sym, Box<Expr>)
    /// `place = expr` for an lvalue such as `*ptr` or `ptr.field`.
    AssignTo(Box<Expr>, Box<Expr>)
    /// `return expr`; None is a bare `return`.
    Return(Box<Expr>?)
    /// `if cond { then } else { otherwise }`; the else body may be empty.
    If(Box<Expr>, List<Stmt>, List<Stmt>)
    /// `while cond { body }`.
    While(Box<Expr>, List<Stmt>)
    /// `while name in subject { body }`. Kept until typecheck, which requires
    /// the subject to implement `Iterable`; Lower rewrites it to the iterator
    /// protocol.
    ForEach(Sym, Box<Expr>, List<Stmt>)
    /// `when (subject) { pattern => body }`.
    When(Box<Expr>, List<Arm>)
    /// Expression statement.
    Expression(Box<Expr>)
    Break
    Continue
    /// Produced only by Lower, from a `When`.
    Switch(Box<Expr>, List<SwitchArm>)
    /// Produced only by Lower: an early drop. Codegen emits `<TypeName>_drop(name)`.
    Drop(Sym)
    /// Produced only by Lower at each scope exit. Same C as Drop.
    Release(Sym)
    /// An error; propagates silently.
    Poison
}

pub fun new_stmt(span: Span, kind: StmtKind): Stmt {
    return Stmt { span: span, binder: no_span(), kind: kind }
}

/// Only the parser calls this; rebuilt statements go through `new_stmt`.
pub fun new_binding_stmt(span: Span, binder: Span, kind: StmtKind): Stmt {
    return Stmt { span: span, binder: binder, kind: kind }
}

pub fun stmt_poison(span: Span): Stmt {
    return new_stmt(span, StmtKind.Poison)
}
