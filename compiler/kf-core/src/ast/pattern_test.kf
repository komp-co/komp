import core.assert.assert_eq
import core.assert.assert
import core.assert.fail
import alloc.list.*

import kf_core.span.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

@test fun new_pattern_round_trips_span(): void {
    val sp = Span { file_id: 1, start: 5, end: 9 }
    val p = new_pattern(sp, PatternKind.Wildcard)
    assert_eq(p.span.start, 5, "span start")
    assert_eq(p.span.end, 9, "span end")
}

@test fun pattern_poison_kind_is_poison(): void {
    val p = pattern_poison(no_span())
    when (p.kind) {
        Poison => assert(true, "ok")
        Wildcard => fail("expected Poison")
        LitInt(_) => fail("expected Poison")
        LitStr(_) => fail("expected Poison")
        LitBool(_) => fail("expected Poison")
        LitChar(_) => fail("expected Poison")
        Identifier(_) => fail("expected Poison")
        Variant(_, _) => fail("expected Poison")
        StructPat(_, _, _) => fail("expected Poison")
        Or(_) => fail("expected Poison")
        Range(_, _, _) => fail("expected Poison")
    }
}

@test fun wildcard_kind_classifies(): void {
    val p = new_pattern(no_span(), PatternKind.Wildcard)
    when (p.kind) {
        Wildcard => assert(true, "ok")
        Poison => fail("expected Wildcard")
        LitInt(_) => fail("expected Wildcard")
        LitStr(_) => fail("expected Wildcard")
        LitBool(_) => fail("expected Wildcard")
        LitChar(_) => fail("expected Wildcard")
        Identifier(_) => fail("expected Wildcard")
        Variant(_, _) => fail("expected Wildcard")
        StructPat(_, _, _) => fail("expected Wildcard")
        Or(_) => fail("expected Wildcard")
        Range(_, _, _) => fail("expected Wildcard")
    }
}

@test fun lit_int_pattern(): void {
    val p = new_pattern(no_span(), PatternKind.LitInt(42))
    when (p.kind) {
        LitInt(n) => assert_eq(n, 42, "int payload")
        Poison => fail("expected LitInt")
        Wildcard => fail("expected LitInt")
        LitStr(_) => fail("expected LitInt")
        LitBool(_) => fail("expected LitInt")
        LitChar(_) => fail("expected LitInt")
        Identifier(_) => fail("expected LitInt")
        Variant(_, _) => fail("expected LitInt")
        StructPat(_, _, _) => fail("expected LitInt")
        Or(_) => fail("expected LitInt")
        Range(_, _, _) => fail("expected LitInt")
    }
}

@test fun lit_bool_pattern(): void {
    val p = new_pattern(no_span(), PatternKind.LitBool(true))
    when (p.kind) {
        LitBool(b) => assert_eq(b, true, "bool payload")
        LitChar(_) => fail("expected LitBool")
        Poison => fail("expected LitBool")
        Wildcard => fail("expected LitBool")
        LitInt(_) => fail("expected LitBool")
        LitStr(_) => fail("expected LitBool")
        Identifier(_) => fail("expected LitBool")
        Variant(_, _) => fail("expected LitBool")
        StructPat(_, _, _) => fail("expected LitBool")
        Or(_) => fail("expected LitBool")
        Range(_, _, _) => fail("expected LitBool")
    }
}

@test fun lit_char_pattern(): void {
    val p = new_pattern(no_span(), PatternKind.LitChar(97))
    when (p.kind) {
        LitChar(c) => assert_eq(c, 97, "char payload")
        Poison => fail("expected LitChar")
        Wildcard => fail("expected LitChar")
        LitInt(_) => fail("expected LitChar")
        LitStr(_) => fail("expected LitChar")
        LitBool(_) => fail("expected LitChar")
        Identifier(_) => fail("expected LitChar")
        Variant(_, _) => fail("expected LitChar")
        StructPat(_, _, _) => fail("expected LitChar")
        Or(_) => fail("expected LitChar")
        Range(_, _, _) => fail("expected LitChar")
    }
}

@test fun pattern_vec_starts_empty(): void {
    val v = List.new<Pattern>()
    assert_eq(v.size(), 0, "fresh")
}

@test fun pattern_vec_push_grows(): void {
    var v = List.new<Pattern>()
    v.push(new_pattern(no_span(), PatternKind.Wildcard))
    v.push(new_pattern(no_span(), PatternKind.Wildcard))
    assert_eq(v.size(), 2, "two pushes")
}

@test fun a_continue_tail_yields(): void {
    val s = Stmt.new(no_span(), StmtKind.Continue)
    assert_eq(s.tail_yields_value(), true, "a jump never needs a value")
}

@test fun a_break_is_a_jump(): void {
    assert_eq(Stmt.new(no_span(), StmtKind.Break).is_jump(), true, "break jumps")
}

@test fun a_return_is_a_jump(): void {
    val s = Stmt.new(no_span(), StmtKind.Return(null))
    assert_eq(s.is_jump(), true, "return jumps")
}

@test fun a_drop_is_not_a_jump(): void {
    val s = Stmt.new(no_span(), StmtKind.Drop(intern("x")))
    assert_eq(s.is_jump(), false, "a drop does not jump")
}
