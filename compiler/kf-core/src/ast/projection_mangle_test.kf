import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.subst.subst_mangled_name
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind

fun segs_of(s: str): List<String> {
    return mangle_segments(s)
}

@test fun a_projection_names_its_owner_and_member(): void {
    val frag = projection_mangle_frag("F", "Out")
    assert_eq(frag.as_str() == "Proj__F__Out__EndProj", true, "the fragment brackets owner and member")
}

@test fun the_owner_is_a_segment_substitution_can_reach(): void {
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    names.push(String.from("F"))
    repls.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("Inc"), List.new<TypeRef>())))
    val out = subst_mangled_name("List__Proj__F__Out__EndProj", &var names, &var repls)
    assert_eq(out.as_str() == "List__Proj__Inc__Out__EndProj", true, "substitution rewrites the owner segment")
}

@test fun a_multi_segment_owner_still_closes(): void {
    val segs = segs_of("List__Proj__crate__Inc__Out__EndProj")
    // Proj sits at 1; its close is the last segment, whatever the owner cost.
    assert_eq(projection_close_index(&segs, 1), 5, "the close is found past a two-segment owner")
}

@test fun a_nested_projection_matches_its_own_close(): void {
    val segs = segs_of("Proj__Proj__F__Out__EndProj__Item__EndProj")
    assert_eq(projection_close_index(&segs, 0), 6, "the outer close skips the inner pair")
    assert_eq(projection_close_index(&segs, 1), 4, "the inner close is its own")
}

@test fun a_name_without_a_close_reports_none(): void {
    val segs = segs_of("List__Proj__F")
    assert_eq(projection_close_index(&segs, 1), 1, "an unclosed marker answers with itself")
}

@test fun a_close_carries_a_method_tail(): void {
    assert_eq(is_projection_close("EndProj_push"), true, "a dispatch symbol glues the method on with one `_`")
    assert_eq(projection_close_tail("EndProj_push").as_str() == "_push", true, "the tail is what follows the close")
    assert_eq(projection_close_tail("EndProj").as_str() == "", true, "a bare close has no tail")
    assert_eq(is_projection_close("EndProjector"), false, "a longer name is not a close")
}

@test fun an_ordinary_name_holds_no_marker(): void {
    assert_eq(name_has_projection_marker("List__int32"), false, "no marker in a plain instance name")
    assert_eq(name_has_projection_marker("List__Proj__F__Out__EndProj"), true, "the filter sees the marker")
}
