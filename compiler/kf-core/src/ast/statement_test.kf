import core.assert.assert_eq
import core.assert.assert
import core.assert.fail
import alloc.list.*

import kf_core.span.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

@test fun new_stmt_round_trips_span(): void {
    val sp = Span { file_id: 1, start: 5, end: 9 }
    val s = Stmt.new(sp, StmtKind.Poison)
    assert_eq(s.span.start, 5, "span")
}

@test fun stmt_poison_kind_is_poison(): void {
    val s = Stmt.new_poison(no_span())
    when (s.kind) {
        Poison => assert(true, "ok")
        _ => fail("expected Poison")
    }
}

@test fun stmt_vec_starts_empty(): void {
    val v = List.new<Stmt>()
    assert_eq(v.size(), 0, "fresh stmt vec")
}

@test fun stmt_vec_push_grows(): void {
    var v = List.new<Stmt>()
    v.push(Stmt.new_poison(no_span()))
    v.push(Stmt.new_poison(no_span()))
    v.push(Stmt.new_poison(no_span()))
    assert_eq(v.size(), 3, "three pushes")
}
