/// How a declaration's body relates to this build.
pub enum Linkage {
    Source
    /// Loaded from a `.kfi`: signature only; the body is in the dependency's
    /// archive under `link_name`.
    ImportedCompiled
    /// Compiled here and exported through this crate's interface.
    ExportedCompiled
    /// A generic template carried by an interface for the consumer to
    /// instantiate.
    GenericTemplate
    /// A private declaration an exported template needs; invisible to consumer
    /// source.
    HiddenSupport
}

pub fun linkage_source(): Linkage {
    return Linkage.Source
}

impl Linkage {
    /// Bodyless, satisfied by a dependency archive: not type-checked, not
    /// emitted.
    pub fun is_imported(): bool {
        return when (self) {
            ImportedCompiled => true
            HiddenSupport => true
            _ => false
        }
    }

    /// A template from an interface, or an instance materialized from one.
    /// The consumer emits instances with internal linkage so several can
    /// hold copies.
    pub fun is_template(): bool {
        return when (self) {
            GenericTemplate => true
            _ => false
        }
    }

    /// Kept out of every export surface.
    pub fun is_hidden(): bool {
        return when (self) {
            HiddenSupport => true
            _ => false
        }
    }
}

impl CrateId {
    // CONSTRAINT: in kf-core so Codegen and the interface writer share one
    // spelling without a dependency cycle.
    pub fun symbol_prefix(): String {
        if self.is_poison() { return "" }
        val cname = Sym { id: self.raw }
        var prefix = sanitize_crate_symbol(cname.as_str())
        prefix.append("__")
        return prefix
    }
}

pub fun sanitize_crate_symbol(name: str): String {
    val n = name.byte_len()
    var out = ""
    var start: uint64 = 0
    var i = 0
    while i < n {
        val b = name.byte_at(i)
        if !crate_symbol_ident_byte(b) {
            val piece = name.substring(start, i)
            out.append(piece.as_str())
            out.append("_")
            start = i + 1
        }
        i = i + 1
    }
    val tail = name.substring(start, n)
    out.append(tail.as_str())
    return out
}

fun crate_symbol_ident_byte(b: uint8): bool {
    if b >= 48 && b <= 57 { return true }
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    return b == 95
}

/// Types whose C identity the runtime fixes: never crate-qualified or carried
/// as hidden support. Containers are lang items; ask `is_container_type_name`.
pub fun is_runtime_type_name(s: str): bool {
    return when s {
        "str" => true
        "Box" => true
        "Ptr" => true
        "bool" => true
        "char" => true
        "void" => true
        "int8" => true
        "int16" => true
        "int32" => true
        "int64" => true
        "uint8" => true
        "uint16" => true
        "uint32" => true
        "uint64" => true
        "float32" => true
        "float64" => true
        _ => false
    }
}

pub fun is_mangled_decl_name(s: str): bool {
    val n = s.byte_len()
    var i: uint64 = 0
    while i + 1 < n {
        if s.byte_at(i) == 95 {
            if s.byte_at(i + 1) == 95 { return true }
        }
        i = i + 1
    }
    return false
}
