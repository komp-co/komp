import alloc.list.*

import kf_core.span.*

// CONSTRAINT: TypeRef and TypeRefKind share this file so their typedefs are
// emitted in source order.

/// A type as written: `List<int32>`, `&Foo`, `(int32) -> bool`.
@derive(Clone)
pub struct TypeRef {
    pub val span: Span
    pub val kind: TypeRefKind
}

pub enum TypeRefKind {
    /// `Foo`, `List<int32>`: name and type arguments.
    Named(Sym, List<TypeRef>)
    /// `dyn Trait<A>`. TypeCheck allows it only behind a reference.
    DynTrait(Sym, List<TypeRef>)
    /// `(int32, str) -> bool` — params + return type.
    Function(List<TypeRef>, Box<TypeRef>)
    /// `&T` or `&var T` — mutable flag + inner.
    Reference(bool, Box<TypeRef>)
    /// `Array<T, N>`, `T[N]`; `T[]` has no length until its initializer
    /// gives one.
    Array(Box<TypeRef>, uint64?)
    /// `C.Iter`: an associated type of a type or parameter (`Self` inside a
    /// trait). Typecheck resolves it to the impl's choice.
    Projection(Box<TypeRef>, Sym)
    /// An error; propagates silently.
    Poison
}

pub fun new_type_ref(span: Span, kind: TypeRefKind): TypeRef {
    return TypeRef { span: span, kind: kind }
}

pub fun type_ref_poison(span: Span): TypeRef {
    return TypeRef { span: span, kind: TypeRefKind.Poison }
}

/// `void` with no arguments. As an enum payload it carries nothing, so
/// `Result<void, E>.Ok` has no payload.
pub fun TypeRef.type_ref_is_void(): bool {
    return when (self.kind) {
        Named(name, args) => name.as_str().equals("void") && args.size() == 0
        _ => false
    }
}
