// The single spelling of a resolved `Type` as a mangle fragment.
// CONSTRAINT: the fragment names instances and backs the checker's type
// identity, so two types sharing one are one type. Keep exactly one copy.

import kf_core.ast.dyn_meta.dyn_trait_identity

impl Type {
    /// A pointer-shaped wrapper contributes its marker and its pointee:
    /// `List<&A>`, `List<&B>` and `List<A>` must all differ.
    pub fun mangle_frag(): String {
        when (self.kind) {
            Int8 => return String.from("int8")
            Int16 => return String.from("int16")
            Int32 => return String.from("int32")
            Int64 => return String.from("int64")
            UInt8 => return String.from("uint8")
            UInt16 => return String.from("uint16")
            UInt32 => return String.from("uint32")
            UInt64 => return String.from("uint64")
            Float32 => return String.from("float32")
            Float64 => return String.from("float64")
            Bool => return String.from("bool")
            Char => return String.from("char")
            StrTy => return String.from("str")
            Void => return String.from("void")
            Never => return String.from("never")
            Struct(n) => return type_identity_display(n)
            EnumTy(n) => return type_identity_display(n)
            TraitTy(n) => return type_identity_display(n)
            DynTraitTy(_) => return self.dyn_trait_identity().as_string()
            Generic(n) => return String.from(n.as_str())
            PtrTo(p) => return wrapped_type_frag("Ptr__", p)
            BoxOf(p) => return wrapped_type_frag("Box__", p)
            ArrayOf(_p, length) => return array_mangle_frag(self.array_element().mangle_frag().as_str(), length)
            RefTo(is_mut, p) => {
                // `&dyn Trait` is a fat value already named by its dyn identity.
                val pointee = unsafe { *p }
                when (pointee.kind) {
                    DynTraitTy(_) => return pointee.mangle_frag()
                    _ => {}
                }
                // Reserved-prefixed and carrying mutability; see c_names.kf.
                return wrapped_type_frag(borrow_frag_marker(is_mut), p)
            }
            FnTy(_) => {
                val parts = self.fn_parts() ?: return String.from("poison")
                var params = List.new<String>()
                while param in &parts.params {
                    params.push(param.mangle_frag())
                }
                return fn_frag(&params, parts.ret.mangle_frag().as_str())
            }
            // Kept, not poisoned, so `F` stays a segment substitution can reach.
            Projection(owner, member) => {
                val inner = unsafe { *owner }.mangle_frag()
                return projection_mangle_frag(inner.as_str(), member.as_str())
            }
            Poison => return String.from("poison")
        }
    }

    /// The scalar spelling, or "" for a non-scalar kind.
    pub fun scalar_frag(): String {
        return when (self.kind) {
            Int8 => String.from("int8")
            Int16 => String.from("int16")
            Int32 => String.from("int32")
            Int64 => String.from("int64")
            UInt8 => String.from("uint8")
            UInt16 => String.from("uint16")
            UInt32 => String.from("uint32")
            UInt64 => String.from("uint64")
            Float32 => String.from("float32")
            Float64 => String.from("float64")
            Bool => String.from("bool")
            Char => String.from("char")
            StrTy => String.from("str")
            _ => ""
        }
    }
}

fun wrapped_type_frag(marker: str, p: Ptr<Type>): String {
    var result = String.from(marker)
    val inner = unsafe { *p }
    result.append(inner.mangle_frag().as_str())
    return result
}
