import alloc.list.*

import kf_core.span.*
import kf_core.ast.declaration.TopDecl

/// `import foo.bar.*`, `import foo.bar.Baz` or `import foo.bar as fb`.
pub struct Import {
    pub val span: Span
    pub val path: List<String> // ["foo", "bar"] for every form
    pub val wildcard: bool // true for `.*`, false otherwise
    /// The name after `as`, or "".
    pub val alias: String
    /// An `export`: what it names is part of `owner`'s surface, and not in
    /// the file's own scope.
    pub val is_pub: bool
    /// The dotted module the export is written in, once the file's module
    /// is known.
    pub var owner: String
    /// The name an export offers its function under, after `as`; "" keeps
    /// the function's own.
    pub val exposed: String
}

pub fun new_import(span: Span, path: List<String>, wildcard: bool): Import {
    return Import { span: span, path: path, wildcard: wildcard, alias: "", is_pub: false, owner: "", exposed: "" }
}

pub fun new_aliased_import(span: Span, path: List<String>, alias: String): Import {
    return Import { span: span, path: path, wildcard: false, alias: alias, is_pub: false, owner: "", exposed: "" }
}

/// `export ... from <module>` written in module `owner`; `path` is the
/// module for `*`, or the module and the one name.
pub fun new_reexport(span: Span, path: List<String>, wildcard: bool, owner: String): Import {
    return Import { span: span, path: path, wildcard: wildcard, alias: "", is_pub: true, owner: owner, exposed: "" }
}

/// `export name as exposed from <module>`; `exposed` "" keeps the name.
pub fun new_renaming_reexport(span: Span, path: List<String>, exposed: String): Import {
    return Import { span: span, path: path, wildcard: false, alias: "", is_pub: true, owner: "", exposed: exposed }
}

pub fun Import.clone_import(): Import {
    return Import { span: self.span, path: self.path.clone(), wildcard: self.wildcard, alias: self.alias.clone(),
        is_pub: self.is_pub, owner: self.owner.clone(), exposed: self.exposed.clone() }
}

/// What an aliased import admits in the per-file import table: no bare name,
/// since none starts with `as `; a qualified call finds its module by it.
pub fun alias_admission(alias: str): Sym {
    return intern("as ${alias}")
}

/// What an export admits in its own file's import table: nothing, since no
/// name is `(export)`.
pub fun export_admission(): Sym {
    return intern("(export)")
}

/// One function admitted under another name, after an `export ... as`:
/// `written=real`, since no name holds `=`. Plain `written` when they match.
pub fun renamed_admission(written: str, real: str): Sym {
    if written == real { return intern(written) }
    return intern("${written}=${real}")
}

/// The name a file writes, from an admitted `written` or `written=real`.
pub fun admission_written(admitted: str): String {
    val at = admission_equals_at(admitted)
    if at < 0 { return String.from(admitted) }
    return String.from(admitted.substring(0, at as uint64).as_str())
}

/// The function's own name, from an admitted `written` or `written=real`.
pub fun admission_real(admitted: str): String {
    val at = admission_equals_at(admitted)
    if at < 0 { return String.from(admitted) }
    return String.from(admitted.substring(at as uint64 + 1, admitted.byte_len()).as_str())
}

fun admission_equals_at(admitted: str): int64 {
    while i in 0..admitted.byte_len() {
        if admitted.byte_at(i) == 61 { return i as int64 }
    }
    return 0 - 1
}

/// False for an import the parser added itself (the `core.range.*` a `..`
/// needs), which has a file but no extent. Anything reporting on source text
/// asks this first.
pub fun Import.import_is_written(): bool {
    if self.span.is_none() { return false }
    return self.span.end > self.span.start
}

/// One source file's AST. Sibling files in a directory share scope.
@derive(Clone)
pub struct Module {
    pub var crate: CrateId
    pub val path: List<String> // module path, ["kf_core", "ast"]
    pub var decls: List<TopDecl>
    pub var imports: List<Import>
}

pub fun new_module(path: List<String>): Module {
    return Module {
        crate: crate_id_poison(),
        path: path,
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
}

/// A crate: the input to every pass.
pub struct Crate {
    pub val name: String // from kf.toml [project] name
    pub var modules: List<Module>
}

pub fun new_crate(name: String): Crate {
    return Crate { name: name, modules: List.new<Module>() }
}
