import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern

/// A resolved type with provenance, attached to an Expr after typecheck, as
/// opposed to the syntactic `TypeRef`. Poison propagates silently through
/// every operation, so one root cause reports one error.
@derive(Copy)
pub struct Type {
    pub val kind: TypeKind
    pub val provenance: Provenance
}

pub struct DynTraitType {
    pub val principal: Sym
    pub val args: Ptr<List<Type>>
}

@derive(Copy, Equal)
pub enum TypeKind {
    Int8
    Int16
    Int32
    Int64
    UInt8
    UInt16
    UInt32
    UInt64
    Float32
    Float64
    Bool
    Char
    StrTy
    Void
    Never
    // The mangled name as it appears in C.
    Struct(Sym)
    EnumTy(Sym)
    TraitTy(Sym)
    DynTraitTy(Ptr<DynTraitType>)
    // A type parameter inside a generic body.
    Generic(Sym)
    PtrTo(Ptr<Type>) // Ptr<T>
    BoxOf(Ptr<Type>) // Box<T> — owning, auto-deref, C `T*`
    RefTo(bool, Ptr<Type>) // &var T (true) or &T (false)
    FnTy(Ptr<FnSig>) // owns a heap FnSig
    /// `C.Out` whose owner is not yet concrete. An inferred type (`c.make()`
    /// through a `C: Producer` bound) has no TypeRef to substitute; Mono
    /// resolves it once the owner is pinned, and nothing after Mono sees one.
    Projection(Ptr<Type>, Sym)
    /// A value parameter's argument: the `7` in `Mod<int32, 7>`.
    Value(int64)
    Poison
}

/// Where a type came from, for "expected X (declared on line 5)" diagnostics.
@derive(Copy)
pub enum Provenance {
    Declared(Span)
    Inferred(Span)
    /// Compiler-synthesized; the Sym says why. A Sym, not a String, keeps
    /// Type free of heap data.
    Synth(Span, Sym)
}

/// A function type's signature, boxed in TypeKind.FnTy to keep TypeKind
/// value-typed.
pub struct FnSig {
    pub val params: Ptr<List<Type>>
    pub val ret: Ptr<Type>
}

/// A function type's parameter and result types, read out of its FnSig.
pub struct FnParts {
    pub val params: List<Type>
    pub val ret: Type
}

impl Type {
    pub static fun new(kind: TypeKind, provenance: Provenance): Self {
        return Self { kind: kind, provenance: provenance }
    }

    pub static fun new_int32(span: Span): Self {
        return Type.new(TypeKind.Int32, Provenance.Inferred(span))
    }

    pub static fun new_bool(span: Span): Self {
        return Type.new(TypeKind.Bool, Provenance.Inferred(span))
    }

    pub static fun new_void(span: Span): Self {
        return Type.new(TypeKind.Void, Provenance.Synth(span, intern("void return")))
    }

    /// A call that does not return (`panic`). Unlike `Void`, lets the
    /// all-paths-return analysis accept a function ending in one.
    pub static fun new_never(span: Span): Self {
        return Type.new(TypeKind.Never, Provenance.Synth(span, intern("diverges")))
    }

    pub static fun new_poison(): Self {
        val s = no_span()
        return Type.new(TypeKind.Poison, Provenance.Synth(s, intern("error recovery")))
    }

    pub static fun new_str(span: Span): Self {
        return Type.new(TypeKind.StrTy, Provenance.Inferred(span))
    }

    /// An unannotated float literal's type; float64 keeps every written digit.
    pub static fun new_float64(span: Span): Self {
        return Type.new(TypeKind.Float64, Provenance.Inferred(span))
    }

    pub static fun new_char(span: Span): Self {
        return Type.new(TypeKind.Char, Provenance.Inferred(span))
    }

    pub static fun new_generic(name: String, span: Span): Self {
        return Type.new(TypeKind.Generic(intern(name.as_str())), Provenance.Inferred(span))
    }

    pub static fun new_ptr(inner: Type, span: Span): Self {
        val p = type_node(inner)
        return Type.new(TypeKind.PtrTo(p), Provenance.Inferred(span))
    }

    pub static fun new_fn(params: List<Type>, ret: Type, provenance: Provenance): Self {
        val signature = signature_node(FnSig { params: type_list_node(params), ret: type_node(ret) })
        return Type.new(TypeKind.FnTy(signature), provenance)
    }

    /// A projection whose owner names no impl yet (a type parameter, or `Self` in
    /// a trait); Mono pins the owner.
    pub static fun new_projection(owner: Type, member: Sym, span: Span): Self {
        val p = type_node(owner)
        return Type { kind: TypeKind.Projection(p, member), provenance: Provenance.Inferred(span) }
    }

    pub static fun new_box(inner: Type, span: Span): Self {
        val p = type_node(inner)
        return Type { kind: TypeKind.BoxOf(p), provenance: Provenance.Inferred(span) }
    }

    pub fun is_poison(): bool {
        return self.kind == TypeKind.Poison
    }

    /// The checker's bottom type: a value that is never produced.
    pub fun is_never(): bool {
        return self.kind == TypeKind.Never
    }

    /// `&self`, or `&var self` when `is_mutable`.
    pub fun borrowed(is_mutable: bool, span: Span): Type {
        return Type { kind: TypeKind.RefTo(is_mutable, type_node(self)), provenance: Provenance.Inferred(span) }
    }

    /// None for anything but a function type.
    pub fun fn_parts(): FnParts? {
        return when (self.kind) {
            FnTy(signature) => {
                var params = List.new<Type>()
                val source = unsafe { &*signature.params }
                while i in 0..source.size() {
                    params.push(source.get(i))
                }
                FnParts { params: params, ret: unsafe { *signature.ret } }
            }
            _ => null
        }
    }

    /// The type behind `&` or `&var`, or the type itself.
    pub fun through_borrow(): Type {
        when (self.kind) {
            RefTo(_, inner) => return unsafe { *inner }
            _ => return self
        }
    }
}
