import core.assert.assert_eq
import kf_core.span.no_span

@test
fun a_type_built_inside_a_typing_lives_in_its_nodes(): void {
    val nodes = TypingNodes.new()
    val previous = nodes.enter()
    val _p = Type.new_ptr(Type.new_int32(no_span()), no_span())
    restore_type_nodes(previous)
    assert_eq(nodes.size(), 1 as uint64, "the pointee")
}

@test
fun a_function_type_puts_its_signature_list_and_result(): void {
    val nodes = TypingNodes.new()
    val previous = nodes.enter()
    val _f = Type.new_fn(List.new<Type>(), Type.new_void(no_span()), Provenance.Inferred(no_span()))
    restore_type_nodes(previous)
    assert_eq(nodes.size(), 3 as uint64, "signature, parameter list and result")
}

@test
fun a_type_built_after_restoring_goes_to_the_previous_nodes(): void {
    val outer = TypingNodes.new()
    val before = outer.enter()
    val inner = TypingNodes.new()
    val previous = inner.enter()
    restore_type_nodes(previous)
    val _p = Type.new_ptr(Type.new_bool(no_span()), no_span())
    restore_type_nodes(before)
    assert_eq(outer.size(), 1 as uint64, "the outer typing's")
}

@test
fun types_built_outside_any_typing_still_have_a_home(): void {
    val p = Type.new_ptr(Type.new_char(no_span()), no_span())
    assert_eq(p.is_poison(), false, "built without a typing")
}
