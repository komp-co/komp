// The single spelling of a resolved `Type` as a mangle fragment.
// CONSTRAINT: the fragment names instances and backs the checker's type
// identity, so two types sharing one are one type. Keep exactly one copy.

import kf_core.ast.dyn_meta.dyn_trait_identity
import kf_core.ast.*

impl Type {
    /// A pointer-shaped wrapper contributes its marker and its pointee:
    /// `List<&A>`, `List<&B>` and `List<A>` must all differ.
    pub fun mangle_frag(): String {
        return when (self.kind) {
            Int8 => "int8"
            Int16 => "int16"
            Int32 => "int32"
            Int64 => "int64"
            UInt8 => "uint8"
            UInt16 => "uint16"
            UInt32 => "uint32"
            UInt64 => "uint64"
            Float32 => "float32"
            Float64 => "float64"
            Bool => "bool"
            Char => "char"
            StrTy => "str"
            Void => "void"
            Never => "never"
            Struct(n) => type_identity_display(n)
            EnumTy(n) => type_identity_display(n)
            TraitTy(n) => type_identity_display(n)
            DynTraitTy(_) => self.dyn_trait_identity().as_string()
            Generic(n) => String.from(n.as_str())
            PtrTo(p) => wrapped_type_frag("Ptr__", p)
            BoxOf(p) => wrapped_type_frag("Box__", p)
            RefTo(is_mut, p) => borrow_type_frag(is_mut, p)
            FnTy(_) => self.function_type_frag()
            // Kept, not poisoned, so `F` stays a segment substitution can reach.
            Projection(owner, member) => {
                val inner = unsafe { *owner }.mangle_frag()
                projection_mangle_frag(inner.as_str(), member.as_str())
            }
            Value(v) => value_frag(v)
            Poison => String.from("poison")
        }
    }

    /// The scalar spelling, or "" for a non-scalar kind.
    pub fun scalar_frag(): String {
        return when (self.kind) {
            Int8 => "int8"
            Int16 => "int16"
            Int32 => "int32"
            Int64 => "int64"
            UInt8 => "uint8"
            UInt16 => "uint16"
            UInt32 => "uint32"
            UInt64 => "uint64"
            Float32 => "float32"
            Float64 => "float64"
            Bool => "bool"
            Char => "char"
            StrTy => "str"
            _ => ""
        }
    }
}

/// `&dyn Trait` is a fat value already named by its dyn identity; any other
/// borrow is reserved-prefixed and carries its mutability (see c_names.kf).
fun borrow_type_frag(is_mut: bool, p: Ptr<Type>): String {
    val pointee = unsafe { *p }
    when (pointee.kind) {
        DynTraitTy(_) => return pointee.mangle_frag()
        _ => return wrapped_type_frag(borrow_frag_marker(is_mut), p)
    }
}

fun Type.function_type_frag(): String {
    val parts = self.fn_parts() ?: return String.from("poison")
    var params = List.new<String>()
    while param in &parts.params {
        params.push(param.mangle_frag())
    }
    return fn_frag(&params, parts.ret.mangle_frag().as_str())
}

fun wrapped_type_frag(marker: str, p: Ptr<Type>): String {
    var result = String.from(marker)
    val inner = unsafe { *p }
    result.append(inner.mangle_frag().as_str())
    return result
}
