import alloc.list.*
import alloc.arena.*

extern "C" fun kf_type_nodes_swap(next: uint64): uint64

/// Where a typing's `Type` children live. A `Type` is a copy that shares its
/// children with every other copy, so none can free them; the typing that
/// made them drops them all at once with this.
pub struct TypeNodes {
    var types: Arena<Type>
    var lists: Arena<List<Type>>
    var signatures: Arena<FnSig>
    var objects: Arena<DynTraitType>
}

impl TypeNodes {
    pub static fun new(): TypeNodes {
        return TypeNodes {
            types: Arena.new<Type>(), lists: Arena.new<List<Type>>(), signatures: Arena.new<FnSig>(),
            objects: Arena.new<DynTraitType>()
        }
    }

    pub fun size(): uint64 {
        return self.types.size() + self.lists.size() + self.signatures.size() + self.objects.size()
    }
}

/// One typing's nodes, at an address that does not move, freed with it.
///
/// CONSTRAINT: restore the nodes `enter` replaced before this is dropped.
pub struct TypingNodes {
    var nodes: Box<TypeNodes>
}

impl TypingNodes {
    pub static fun new(): TypingNodes {
        return TypingNodes { nodes: Box.new(TypeNodes.new()) }
    }

    /// Makes these the nodes new type children go to, and returns the ones
    /// they replace, for `restore_type_nodes`.
    pub fun enter(): uint64 {
        val nodes: Ptr<TypeNodes> = self.nodes
        return kf_type_nodes_swap(nodes as uint64)
    }

    pub fun size(): uint64 {
        return self.nodes.size()
    }
}

pub fun restore_type_nodes(previous: uint64): void {
    val _replaced = kf_type_nodes_swap(previous)
}

/// The current nodes; without any, ones the process never frees, which is
/// right for a run that compiles once and exits.
fun current_type_nodes_at(): Ptr<TypeNodes> {
    var current = kf_type_nodes_swap(0)
    if current == 0 {
        // Leaked on purpose: they live as long as the process.
        val process: Ptr<TypeNodes> = unsafe { alloc<TypeNodes>() }
        unsafe { *process = TypeNodes.new() }
        current = process as uint64
    }
    val _none = kf_type_nodes_swap(current)
    return current as Ptr<TypeNodes>
}

fun current_type_nodes(): &var TypeNodes {
    return unsafe { &var *current_type_nodes_at() }
}

/// A child slot holding `value`, owned by the current nodes.
pub fun type_node(value: Type): Ptr<Type> {
    return current_type_nodes().types.put(value)
}

pub fun type_list_node(value: List<Type>): Ptr<List<Type>> {
    return current_type_nodes().lists.put(value)
}

pub fun signature_node(value: FnSig): Ptr<FnSig> {
    return current_type_nodes().signatures.put(value)
}

pub fun dyn_trait_node(value: DynTraitType): Ptr<DynTraitType> {
    return current_type_nodes().objects.put(value)
}
