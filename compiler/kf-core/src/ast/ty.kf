import kf_core.span.*

/// A resolved type with provenance, attached to an Expr after typecheck, as
/// opposed to the syntactic `TypeRef`. Poison propagates silently through
/// every operation, so one root cause reports one error.
pub struct Type {
    pub val kind: TypeKind
    pub val provenance: Provenance
}

pub struct DynTraitType {
    pub val principal: Sym
    pub val args: Ptr<TypeList>
}

pub enum TypeKind {
    Int8
    Int16
    Int32
    Int64
    UInt8
    UInt16
    UInt32
    UInt64
    Float32
    Float64
    Bool
    Char
    StrTy
    Void
    Never
    // The mangled name as it appears in C.
    Struct(Sym)
    EnumTy(Sym)
    TraitTy(Sym)
    DynTraitTy(Ptr<DynTraitType>)
    // A type parameter inside a generic body.
    Generic(Sym)
    PtrTo(Ptr<Type>) // Ptr<T>
    BoxOf(Ptr<Type>) // Box<T> — owning, auto-deref, C `T*`
    RefTo(bool, Ptr<Type>) // &var T (true) or &T (false)
    FnTy(Ptr<FnSig>) // owns a heap FnSig
    /// `C.Out` whose owner is not yet concrete. An inferred type (`c.make()`
    /// through a `C: Producer` bound) has no TypeRef to substitute; Mono
    /// resolves it once the owner is pinned, and nothing after Mono sees one.
    Projection(Ptr<Type>, Sym)
    Poison
}

/// Where a type came from, for "expected X (declared on line 5)" diagnostics.
pub enum Provenance {
    Declared(Span)
    Inferred(Span)
    /// Compiler-synthesized; the Sym says why. A Sym, not a String, keeps
    /// Type free of heap data.
    Synth(Span, Sym)
}

/// A function type's signature, boxed in TypeKind.FnTy to keep TypeKind
/// value-typed.
pub struct FnSig {
    pub val params: Ptr<TypeList>
    pub val ret: Ptr<Type>
}

pub struct TypeList {
    pub var data: Ptr<Type>
    pub var len: uint64
    pub var cap: uint64
}

pub fun new_type_vec(): TypeList {
    val null_data: Ptr<Type> = unsafe { 0 as Ptr<Type> }
    return TypeList { data: null_data, len: 0, cap: 0 }
}

impl TypeList {
    pub mutating fun push(item: Type): void {
        if self.cap == 0 {
            self.data = unsafe { alloc_array<Type>(4) }
            self.cap = 4
        } else if self.len == self.cap {
            val new_cap: uint64 = self.cap * 2
            self.data = unsafe { realloc_array<Type>(self.data, new_cap) }
            self.cap = new_cap
        }
        unsafe { *(self.data + self.len) = item }
        self.len = self.len + 1
    }

    pub fun get(i: uint64): Type {
        if i >= self.len {
            runtime_println("panic: type vec index out of bounds")
            unsafe { exit(1) }
        }
        return unsafe { *(self.data + i) }
    }

    /// A borrow of slot `i`, where `get` would copy.
    pub fun at(i: uint64): &Type {
        if i >= self.len {
            runtime_println("panic: type vec index out of bounds")
            unsafe { exit(1) }
        }
        return unsafe { &*(self.data + i) }
    }

    pub fun size(): uint64 {
        return self.len
    }
}

pub fun int32_ty(span: Span): Type {
    return Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(span) }
}

pub fun bool_ty(span: Span): Type {
    return Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(span) }
}

pub fun void_ty(span: Span): Type {
    return Type { kind: TypeKind.Void, provenance: Provenance.Synth(span, intern("void return")) }
}

/// A call that does not return (`panic`). Unlike `Void`, lets the
/// all-paths-return analysis accept a function ending in one.
pub fun never_ty(span: Span): Type {
    return Type { kind: TypeKind.Never, provenance: Provenance.Synth(span, intern("diverges")) }
}

pub fun poison_ty(): Type {
    val s = no_span()
    return Type { kind: TypeKind.Poison, provenance: Provenance.Synth(s, intern("error recovery")) }
}

pub fun str_ty(span: Span): Type {
    return Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(span) }
}

/// An unannotated float literal's type; float64 keeps every written digit.
pub fun float64_ty(span: Span): Type {
    return Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(span) }
}

pub fun char_ty(span: Span): Type {
    return Type { kind: TypeKind.Char, provenance: Provenance.Inferred(span) }
}

pub fun generic_ty(name: String, span: Span): Type {
    return Type { kind: TypeKind.Generic(intern(name.as_str())), provenance: Provenance.Inferred(span) }
}

pub fun ptr_ty(inner: Type, span: Span): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.PtrTo(p), provenance: Provenance.Inferred(span) }
}

/// A projection whose owner names no impl yet (a type parameter, or `Self` in
/// a trait); Mono pins the owner.
pub fun projection_ty(owner: Type, member: Sym, span: Span): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = owner }
    return Type { kind: TypeKind.Projection(p, member), provenance: Provenance.Inferred(span) }
}

pub fun box_ty(inner: Type, span: Span): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.BoxOf(p), provenance: Provenance.Inferred(span) }
}

impl Type {
    pub fun is_poison(): bool {
        return when (self.kind) {
            Poison => true
            // Unresolved is not broken: poison would suppress errors around it.
            Projection(_owner, _member) => false
            Int8 => false
            Int16 => false
            Int32 => false
            Int64 => false
            UInt8 => false
            UInt16 => false
            UInt32 => false
            UInt64 => false
            Float32 => false
            Float64 => false
            Bool => false
            Char => false
            StrTy => false
            Void => false
            Never => false
            Struct(_) => false
            EnumTy(_) => false
            TraitTy(_) => false
            DynTraitTy(_) => false
            Generic(_) => false
            PtrTo(_) => false
            BoxOf(_) => false
            RefTo(_, _) => false
            FnTy(_) => false
        }
    }
}
