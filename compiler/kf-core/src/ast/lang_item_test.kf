import core.assert.assert_eq
import alloc.list.*
import kf_core.span.no_span
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.declaration.*
import kf_core.ast.annotation.new_annotation

fun marked_struct(name: str, lang_key: str): TopDecl {
    var td = new_top_decl(no_span(), String.from(name), TopDeclKind.Struct(List.new<Field>(), true))
    if !lang_key.equals("") { td.annotations.push(new_annotation(no_span(), "lang", [String.from(lang_key)])) }
    return td
}

fun module_of(decls: List<TopDecl>): Module {
    return Module { crate: new_crate_id("alloc"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

@test fun the_lang_string_is_found_by_its_key_not_its_name(): void {
    var decls = List.new<TopDecl>()
    decls.push(marked_struct("Other", ""))
    decls.push(marked_struct("Text", "string"))
    val m = module_of(decls)
    assert_eq((&m).lang_type_name(lang_string_key()).as_str(), "Text", "whatever the library called it")
}

@test fun a_graph_without_the_item_has_no_name_for_it(): void {
    var decls = List.new<TopDecl>()
    decls.push(marked_struct("String", ""))
    val m = module_of(decls)
    assert_eq((&m).lang_type_name(lang_string_key()).as_str(), "", "a type called String is not the lang string")
}

@test fun a_lang_struct_is_a_struct_of_that_name(): void {
    val t = intern("Text").lang_struct_ty(no_span())
    assert_eq(t.is_poison(), false, "a real type")
    assert_eq((&t).is_lang_struct(intern("Text")), true, "and the lang item it was made from")
}

@test fun a_qualified_identity_still_names_the_lang_struct(): void {
    val t = Type { kind: TypeKind.Struct(intern("alloc::string::Text")), provenance: Provenance.Inferred(no_span()) }
    assert_eq((&t).is_lang_struct(intern("Text")), true, "a canonical identity displays as its name")
}

@test fun the_empty_name_matches_nothing(): void {
    val t = intern("").lang_struct_ty(no_span())
    assert_eq((&t).is_lang_struct(intern("")), false, "no lang string in the graph means no string type")
    assert_eq((&Type.new_str(no_span())).is_lang_struct(intern("Text")), false, "a str is not the owned string")
}

@test fun a_placeholder_names_its_key_and_nothing_else_does(): void {
    assert_eq(lang_placeholder("string").lang_placeholder_key().as_str(), "string", "the key comes back")
    assert_eq(intern("String").lang_placeholder_key().as_str(), "", "an ordinary name is no placeholder")
    assert_eq(intern("lang::").lang_placeholder_key().as_str(), "", "a placeholder names a key")
}

@test fun the_array_key_is_known(): void {
    assert_eq(is_known_lang_key(lang_array_key()), true, "core marks `Array` with `@lang(\"array\")`")
}

@test fun the_slice_key_is_known(): void {
    assert_eq(is_known_lang_key(lang_slice_key()), true, "a shared slice is a lang item")
}

@test fun the_mutable_slice_key_is_known(): void {
    assert_eq(is_known_lang_key(lang_slice_mut_key()), true, "a mutable slice is a lang item")
}
