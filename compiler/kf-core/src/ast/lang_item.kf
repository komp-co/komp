// Lang items: library types and traits the language builds on, marked
// `@lang("key")`. The compiler asks for them by key and gets back the name
// the library chose.

import alloc.list.*

import kf_core.span.Span
import kf_core.span.no_span
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.Annotation
import kf_core.ast.declaration.AnnotationArg
import kf_core.ast.declaration.TopDecl

pub fun lang_string_key(): str { return "string" }

pub fun lang_iterable_key(): str { return "iterable" }

pub fun lang_display_key(): str { return "display" }

pub fun lang_compare_key(): str { return "compare" }

pub fun lang_equal_key(): str { return "equal" }

pub fun lang_clone_key(): str { return "clone" }

pub fun lang_copy_key(): str { return "copy" }

pub fun lang_drop_key(): str { return "drop" }

pub fun lang_hash_key(): str { return "hash" }

pub fun lang_default_key(): str { return "default" }

pub fun lang_add_key(): str { return "add" }

pub fun lang_sub_key(): str { return "sub" }

pub fun lang_mul_key(): str { return "mul" }

pub fun lang_div_key(): str { return "div" }

pub fun lang_option_key(): str { return "option" }

pub fun lang_list_key(): str { return "list" }

pub fun lang_array_key(): str { return "array" }

pub fun lang_slice_key(): str { return "slice" }

pub fun lang_slice_mut_key(): str { return "slice_mut" }

/// Every key the compiler consumes, in "expected"-list order. An unknown key
/// is an error, so a typo cannot silently leave a type unmarked.
pub fun known_lang_keys(): List<String> {
    var out = List.new<String>()
    out.push(String.from(lang_string_key()))
    out.push(String.from(lang_iterable_key()))
    out.push(String.from(lang_display_key()))
    out.push(String.from(lang_compare_key()))
    out.push(String.from(lang_equal_key()))
    out.push(String.from(lang_clone_key()))
    out.push(String.from(lang_copy_key()))
    out.push(String.from(lang_drop_key()))
    out.push(String.from(lang_hash_key()))
    out.push(String.from(lang_default_key()))
    out.push(String.from(lang_add_key()))
    out.push(String.from(lang_sub_key()))
    out.push(String.from(lang_mul_key()))
    out.push(String.from(lang_div_key()))
    out.push(String.from(lang_option_key()))
    out.push(String.from(lang_list_key()))
    out.push(String.from(lang_array_key()))
    out.push(String.from(lang_slice_key()))
    out.push(String.from(lang_slice_mut_key()))
    return out
}

pub fun is_known_lang_key(key: str): bool {
    val keys = known_lang_keys()
    while item in &keys {
        if item.as_str().equals(key) { return true }
    }
    return false
}

pub fun known_lang_keys_summary(): String {
    var out = String.from("")
    val keys = known_lang_keys()
    while i in 0..keys.size() {
        if i > 0 {
            if i == keys.size() - 1 { out.append(" or ") } else { out.append(", ") }
        }
        out.append("`@lang(\"")
        out.append(keys.at(i).as_str())
        out.append("\")`")
    }
    return out
}

/// `@lang("key")`, for a declaration read back from an interface.
pub fun lang_annotation(key: str): Annotation {
    var args = List.new<AnnotationArg>()
    val literal = Expr.new(no_span(), ExprKind.LitStr(String.from(key)))
    args.push(AnnotationArg { name: intern(""), value: Box.new(literal) })
    return Annotation { name: intern("lang"), args: args, has_parens: true, span: no_span() }
}

impl TopDecl {
    /// The key of this declaration's `@lang(...)`, or "".
    pub fun lang_key_of(): String {
        val words = self.annotation_words("lang")
        if words.size() == 0 { return "" }
        return words.at(0).clone()
    }
}

impl Module {
    /// The struct or enum marked `@lang(key)`, or the empty name. Includes
    /// dependencies' declarations.
    pub fun lang_type_name(key: str): Sym {
        while td in &self.decls {
            var is_type = false
            when (td.kind) {
                Struct(_fields, _is_pub) => { is_type = true }
                EnumDecl(_variants, _is_pub) => { is_type = true }
                _ => {}
            }
            if is_type && td.lang_key_of().as_str().equals(key) { return td.name }
        }
        return intern("")
    }

    /// The trait marked `@lang(key)`, or the empty name.
    pub fun lang_trait_name(key: str): Sym {
        while td in &self.decls {
            var is_trait = false
            when (td.kind) {
                TraitDecl(_members, _is_pub, _supers) => { is_trait = true }
                _ => {}
            }
            if is_trait && td.lang_key_of().as_str().equals(key) { return td.name }
        }
        return intern("")
    }

    /// Clone, Drop or Equal, by `@lang` key: traits whose impl methods carry
    /// no dispatch suffix.
    pub fun is_auto_trait(name: str): bool {
        if name.equals(self.lang_trait_name(lang_clone_key()).as_str()) { return true }
        if name.equals(self.lang_trait_name(lang_drop_key()).as_str()) { return true }
        if name.equals(self.lang_trait_name(lang_equal_key()).as_str()) { return true }
        return false
    }
}

/// What the lexer writes where interpolation needs the string type. `::` is
/// not part of an identifier, so no source can spell it.
pub fun lang_placeholder(key: str): Sym {
    var text = String.from("lang::")
    text.append(key)
    return intern(text.as_str())
}

impl Sym {
    /// The lang key this placeholder stands for, or "".
    pub fun lang_placeholder_key(): String {
        val text = self.as_str()
        val n = text.byte_len()
        if n <= 6 { return "" }
        val head = text.substring(0, 6)
        if !head.as_str().equals("lang::") { return "" }
        return text.substring(6, n)
    }

    pub fun lang_struct_ty(span: Span): Type {
        return Type { kind: TypeKind.Struct(self), provenance: Provenance.Inferred(span) }
    }
}

/// The empty name means no crate declares the item, and matches nothing.
pub fun is_lang_name(name: str, lang: Sym): bool {
    if lang.as_str().equals("") { return false }
    return name.equals(lang.as_str())
}

/// `@lang("list")` or `@lang("option")`. The empty name matches nothing.
pub fun is_container_type_name(name: str, list_name: Sym, option_name: Sym): bool {
    return is_lang_name(name, list_name) || is_lang_name(name, option_name)
}

impl Type {
    /// The empty name matches nothing.
    pub fun is_lang_struct(name: Sym): bool {
        return when (self.kind) {
            Struct(identity) => is_lang_name(type_identity_display(identity).as_str(), name)
            _ => false
        }
    }
}
