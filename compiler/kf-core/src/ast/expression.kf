import alloc.list.*

import kf_core.span.*

/// Pass annotations on the outer struct are filled in as passes run.
@derive(Clone)
pub struct Expr {
    pub val span: Span
    /// Where the expression's name is written: `helper` in `helper(1)`,
    /// `push` in `xs.push(1)`. `no_span()` if it names nothing or was
    /// synthesized. `span` covers the whole call.
    pub var name_span: Span
    pub var kind: ExprKind
    pub var decl: DeclId?
    pub var ty: Type
    // Set by Mono on calls; empty otherwise.
    pub var mangled_callee: Sym
    // Implicit conversion TypeCheck records and Codegen applies; see the
    // coerce_* constants below.
    pub var coerce: uint8
    // Use-site type arguments: `id<int32>(x)`, `Pair<int32,int32>{...}`.
    // Empty when none were written or inferred.
    pub var type_args: List<TypeRef>
    /// The author wrote `type_args`, as opposed to inference filling them in.
    /// A written annotation must not be overridden by expected-type
    /// re-binding.
    pub var type_args_written: bool
    // `Type.method(args)`: a self-less call; codegen passes no receiver.
    pub var is_static_call: bool
    /// Dynamic dispatch; the slot and layout are recorded alongside.
    pub var is_dynamic_call: bool
    pub var dynamic_slot: uint64
    pub var dynamic_layout: Sym
    /// A memory intrinsic (`alloc<T>()`, `sizeof<T>()`, `take<T>(x)`), set by
    /// the parser.
    ///
    /// CONSTRAINT: never re-derive this from the name. `<crate>__<fn>` has the
    /// same shape as a folded intrinsic, so in a crate named `alloc` every
    /// free function would look like one.
    pub var is_intrinsic: bool
    /// The value of a safe call's `Some` arm (the `x.b` in `a?.b`). The
    /// checker decides from the member's type whether to wrap it in `Some` or
    /// flatten an `Option` chain.
    pub var is_safe_call_value: bool
    /// Constructs an enum variant (`Option.Some(x)`), which has no callee to
    /// resolve. Recorded here because a method call returning an enum looks
    /// the same by type and name.
    pub var is_variant_ctor: bool
    /// A `Self`-shaped argument passed by value through an auto-dereferencing
    /// receiver. Set during substitution, the only place that can tell it from
    /// a parameter declared `&Key` in its own right.
    pub var derefs_at_call: bool
}

pub fun coerce_none(): uint8 { return 0 }
pub fun coerce_to_cstr(): uint8 { return 2 }
pub fun coerce_addr_of(): uint8 { return 3 }
// The source wrote `&`/`&var` here. TypeCheck-internal: an un-annotated
// `val b = &xs` gets a `&T` type instead of moving. check_expr clears it.
pub fun coerce_written_amp(): uint8 { return 4 }
pub fun coerce_written_amp_var(): uint8 { return 5 }
// Marked by the move checker for a deep copy; codegen emits `<T>_clone(...)`.
pub fun coerce_clone(): uint8 { return 6 }

@derive(Clone)
pub enum ExprKind {
    /// Integer literal. Type narrowing happens in TypeCheck.
    LitInt(int64)
    /// Float literal, carried as its spelling, which codegen writes verbatim.
    LitFloat(String)
    /// Char literal, as the Unicode scalar it denotes.
    LitChar(uint32)
    /// String literal, escapes already decoded.
    LitStr(String)
    LitBool(bool)
    /// Interned name; after Resolve `decl` points at the binding.
    Variable(Sym)
    /// `lhs op rhs`.
    Binary(Box<Expr>, BinOp, Box<Expr>)
    /// `!x`, `-x`.
    Unary(UnaryOp, Box<Expr>)
    /// `*ptr` through a `Ptr<T>` or `&T`. Codegen emits `(*x)`.
    Deref(Box<Expr>)
    /// `f(args)`.
    Call(Sym, List<Expr>)
    /// `receiver.method(args)`.
    MethodCall(Box<Expr>, Sym, List<Expr>)
    /// `receiver.field`. Fields are not in the decl table.
    FieldAccess(Box<Expr>, Sym)
    /// `if cond { then } else { otherwise }`; `else` is mandatory.
    IfExpr(Box<Expr>, Box<Expr>, Box<Expr>)
    /// `when` as an expression; each arm body is one `Expression` statement.
    /// Lower rewrites it to a temporary plus a `When` statement, since C
    /// expressions cannot introduce one.
    WhenExpr(Box<Expr>, List<Arm>)
    /// `Foo { field: value }`, fields in source order; the checker matches
    /// them to the declaration.
    StructLit(Sym, List<FieldInit>)
    /// `expr as Type`: a numeric or pointer cast, emitted as a C cast.
    Cast(Box<Expr>, Box<TypeRef>)
    /// A concrete borrow coerced to a borrowed trait object; the symbol names
    /// its vtable.
    DynCoerce(Box<Expr>, Sym)
    /// `|a, b| expr` or `|a, b| { stmts }`. A parameter's type pointer is null
    /// when unannotated; TypeCheck takes it from the expected `Call` bound.
    /// The body is a statement list whose last expression statement is the
    /// value. TypeCheck replaces the node with a literal of the struct it
    /// synthesizes.
    Lambda(List<Param>, List<Stmt>)
    /// Produced only by Lower: retains a value about to be alias-stored.
    Retain(Box<Expr>)
    /// Produced only by Lower. Codegen emits `<TypeName>_drop(name)`.
    Release(Sym)
    /// `{ stmt  stmt  tail }` where a value is wanted. The last statement is
    /// the value if it is an expression, otherwise the block is `void`. A
    /// branch holding exactly one expression is that expression, not a Block.
    Block(List<Stmt>)
    /// An error; propagates silently.
    Poison
}

pub enum BinOp {
    Add
    Sub
    Mul
    Div
    Mod
    Eq
    NotEq
    Lt
    Gt
    LtEq
    GtEq
    AndAnd
    OrOr
    Shl
    Shr
    BitAnd
    BitOr
    BitXor
}

pub enum UnaryOp {
    Neg
    Not
}

/// The trait method an operator dispatches to, or "" for operators that stay
/// native C. CONSTRAINT: the single table Lower's reachability and ownership
/// walks both read; a second copy drifts into double drops.
pub fun binop_method(op: BinOp): str {
    return when (op) {
        Add => "add"
        Sub => "sub"
        Mul => "mul"
        Div => "div"
        Mod => "mod"
        Eq => "equals"
        NotEq => "equals"
        Lt => "compare"
        Gt => "compare"
        LtEq => "compare"
        GtEq => "compare"
        Shl => "shl"
        Shr => "shr"
        BitAnd => "bit_and"
        BitOr => "bit_or"
        BitXor => "bit_xor"
        _ => ""
    }
}

pub fun binop_dispatches_to_trait_method(op: BinOp): bool {
    return !binop_method(op).equals("")
}

pub fun new_expr(span: Span, kind: ExprKind): Expr {
    return Expr { span: span, name_span: no_span(), kind: kind, decl: null, ty: poison_ty(), mangled_callee: intern(""), coerce: 0, type_args: List.new<TypeRef>(), type_args_written: false, is_static_call: false, is_dynamic_call: false, dynamic_slot: 0, dynamic_layout: intern(""), is_intrinsic: false, is_safe_call_value: false, is_variant_ctor: false, derefs_at_call: false }
}

pub fun expr_poison(span: Span): Expr {
    return new_expr(span, ExprKind.Poison)
}

/// A `field: value` initializer; `value` is boxed to break the type cycle.
@derive(Clone)
pub struct FieldInit {
    pub val span: Span
    pub val name: Sym
    pub val value: Box<Expr>
}

pub fun new_field_init(span: Span, name: String, value: Box<Expr>): FieldInit {
    return FieldInit { span: span, name: intern(name.as_str()), value: value }
}
