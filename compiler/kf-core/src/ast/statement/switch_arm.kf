import kf_core.ast.Sym
import kf_core.ast.expression.Expr

@derive(Clone)
pub enum SwitchTag {
    /// `Some(x) =>`, by variant name.
    Variant(String)
    /// `0 =>` / `true =>` over a non-enum subject; booleans arrive as 1 and 0.
    IntLit(int64)
    /// `_ =>`, a C `default:`.
    Wildcard
    /// `0..32 =>`, both bounds inclusive.
    Range(int64, int64)
    /// `A | B =>`: one label per alternative, one body.
    Alternatives(List<SwitchTag>)
}

/// One arm of a Lower-desugared `Switch`.
/// CONSTRAINT: in this file so its typedef is emitted before StmtKind's;
/// cross-file typedef order follows file names.
@derive(Clone)
pub struct SwitchArm {
    pub val span: Span
    pub val tag: SwitchTag
    pub var binders: List<Sym>
    /// Null when unguarded. Any guard makes codegen emit the whole `Switch`
    /// as an if/else-if chain.
    pub val guard: Box<Expr>?
    /// Runs before the guard, inside it: binds the guard's owned temporaries
    /// and its value, then drops them. Empty when the guard owns nothing.
    pub var guard_prelude: List<Stmt>
    pub var body: List<Stmt>
    /// Binders bound to their payload's address; see `Arm.ref_binders`.
    pub var ref_binders: List<Sym>
}

impl SwitchArm {
    pub static fun new(
        span: Span,
        tag: SwitchTag,
        binders: List<Sym>,
        guard: Box<Expr>?,
        body: List<Stmt>
    ): Self {
        return SwitchArm.new_guarded(span, tag, binders, guard, List.new<Stmt>(), body)
    }

    pub static fun new_guarded(
        span: Span,
        tag: SwitchTag,
        binders: List<Sym>,
        guard: Box<Expr>?,
        guard_prelude: List<Stmt>,
        body: List<Stmt>
    ): Self {
        return SwitchArm {
            span: span,
            tag: tag,
            binders: binders,
            guard: guard,
            guard_prelude: guard_prelude,
            body: body,
            ref_binders: List.new<Sym>()
        }
    }

    pub fun has_guard(): bool {
        return self.guard.is_some()
    }
}
