import alloc.list.*

import kf_core.span.*
import kf_core.ast.Arm
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr

pub enum StmtKind {
    /// `val name: ty = init`; no annotation means inferred.
    LetVal(Sym, Box<TypeRef>?, Box<Expr>?)
    /// `var name: ty = init`. No initializer only in Lower's `var __whenN: T`,
    /// which then must be annotated.
    LetVar(Sym, Box<TypeRef>?, Box<Expr>?)
    /// `name = expr`.
    Assign(Sym, Box<Expr>)
    /// `place = expr` for an lvalue such as `*ptr` or `ptr.field`.
    AssignTo(Box<Expr>, Box<Expr>)
    /// `return expr`; None is a bare `return`.
    Return(Box<Expr>?)
    /// `if cond { then } else { otherwise }`; the else body may be empty.
    If(Box<Expr>, List<Stmt>, List<Stmt>)
    /// `while cond { body }`.
    While(Box<Expr>, List<Stmt>)
    /// `while name in subject { body }`. Kept until typecheck, which requires
    /// the subject to implement `Iterable`; Lower rewrites it to the iterator
    /// protocol.
    ForEach(Sym, Box<Expr>, List<Stmt>)
    /// `when (subject) { pattern => body }`.
    When(Box<Expr>, List<Arm>)
    /// Expression statement.
    Expression(Box<Expr>)
    Break
    Continue
    /// Produced only by Lower, from a `When`.
    Switch(Box<Expr>, List<SwitchArm>)
    /// Produced only by Lower: an early drop. Codegen emits `<TypeName>_drop(name)`.
    Drop(Sym)
    /// Produced only by Lower at each scope exit. Same C as Drop.
    Release(Sym)
    /// An error; propagates silently.
    Poison
}

@derive(Clone)
pub struct Stmt {
    /// The full extent, not just the leading keyword.
    pub var span: Span
    /// Where the binder name is written (`x` in `val x = 1`); `no_span()` if
    /// nothing is bound. On the outer struct so no kind's payload changes.
    pub var binder: Span
    pub var kind: StmtKind
}

impl Stmt {
    pub static fun new(span: Span, kind: StmtKind): Self {
        return Self { span: span, binder: no_span(), kind: kind }
    }

    /// Only the parser calls this; rebuilt statements go through `new`.
    pub static fun new_binding(span: Span, binder: Span, kind: StmtKind): Stmt {
        return Self { span: span, binder: binder, kind: kind }
    }

    pub static fun new_poison(span: Span): Stmt {
        return Stmt.new(span, StmtKind.Poison)
    }
}
