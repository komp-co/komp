// Which written types are borrows, and where a returned one comes from.
// CONSTRAINT: one rule for TypeCheck, which enforces it, and the interface
// writer, which publishes it.

import alloc.list.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.*

/// `str`, `&T` and `&var T`: types whose validity is bounded by another frame.
pub fun TypeRef.type_ref_is_borrow(): bool {
    when (self.kind) {
        Reference(_, _) => return true
        Named(name, args) => return args.size() == 0 && name.as_str() == "str"
        _ => return false
    }
}

/// A borrow, or a value of one of `views`.
pub fun TypeRef.type_ref_borrows(views: &List<String>): bool {
    if self.type_ref_is_borrow() { return true }
    when (self.kind) {
        Named(name, _args) => return names_view(views, name.as_str())
        _ => return false
    }
}

/// The parameter index a returned borrow comes from, or -1 when it borrows
/// nothing the caller owns. An instance method borrows from `self`;
/// otherwise the single borrow parameter is the origin. With none, the borrow
/// can only be a literal. With several, the origin cannot be named and the
/// signature is rejected where it is checked.
pub fun type_ref_borrow_origin(param_types: &List<TypeRef>, ret: &TypeRef, has_self: bool,
    views: &List<String>): int32 {
    if !ret.type_ref_borrows(views) { return 0 - 1 }
    if has_self { return 0 }
    var found: int32 = 0 - 1
    while i in 0..param_types.size() {
        val p = *param_types.at(i)
        if p.type_ref_borrows(views) {
            if found != 0 - 1 { return 0 - 1 }
            found = i as int32
        }
    }
    return found
}

/// The binding a borrow ultimately reads from, or "" when it bottoms out in a
/// literal or an owned value.
pub fun Expr.expr_borrow_root(): String {
    return self.borrow_root_in(&List.new<String>())
}

/// As `expr_borrow_root`, with `views` counted as borrows. Field reads,
/// derefs, method calls and coercions keep pointing into the same storage; a
/// call's result and a view literal point into the one place their lent
/// values do.
pub fun Expr.borrow_root_in(views: &List<String>): String {
    when (self.kind) {
        Variable(name) => return name.as_string()
        FieldAccess(base, _) => return (unsafe { &*base }).borrow_root_in(views)
        Deref(inner) => return (unsafe { &*inner }).borrow_root_in(views)
        MethodCall(receiver, _, _) => return (unsafe { &*receiver }).borrow_root_in(views)
        DynCoerce(inner, _) => return (unsafe { &*inner }).borrow_root_in(views)
        Cast(inner, _) => return (unsafe { &*inner }).borrow_root_in(views)
        _ => {}
    }
    val roots = self.lent_roots(views)
    return if roots.size() == 1 { roots.at(0).clone() } else { String.from("") }
}

/// The distinct bindings a call's lent arguments, or a struct literal's lent
/// fields, borrow from. A literal or other static borrow adds none.
pub fun Expr.lent_roots(views: &List<String>): List<String> {
    var roots = List.new<String>()
    when (self.kind) {
        Call(_name, args) => args.add_lent_roots(views, &var roots)
        Intrinsic(_intrinsic, args) => args.add_lent_roots(views, &var roots)
        StructLit(_name, fields) => {
            while field in &fields {
                if field.value.is_lent(views) { add_root(&var roots, field.value.borrow_root_in(views)) }
            }
        }
        _ => {}
    }
    return roots
}

fun List<Expr>.add_lent_roots(views: &List<String>, roots: &var List<String>): void {
    while arg in &self {
        if arg.is_lent(views) { add_root(roots, arg.borrow_root_in(views)) }
    }
}

fun add_root(roots: &var List<String>, root: String): void {
    if root.as_str() == "" { return }
    while seen in &roots {
        if seen.as_str() == root.as_str() { return }
    }
    roots.push(root)
}

/// Passed as a borrow: borrow-typed or a view, or lent with `&` written or
/// implied.
fun Expr.is_lent(views: &List<String>): bool {
    val c = self.coerce
    if c == coerce_addr_of() || c == coerce_written_amp() || c == coerce_written_amp_var() { return true }
    when (self.ty.kind) {
        StrTy => return true
        RefTo(_, _) => return true
        Struct(name) => return names_view(views, name.as_str())
        EnumTy(name) => return names_view(views, name.as_str())
        _ => return false
    }
}
