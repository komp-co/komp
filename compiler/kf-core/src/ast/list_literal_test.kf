import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

fun at(start: uint32): Span { return Span { file_id: 1, start: start, end: start + 1 } }

fun ints(values: List<int64>): List<Expr> {
    var out = List.new<Expr>()
    while v in &values {
        out.push(Expr.new(at(v as uint32), ExprKind.LitInt(v)))
    }
    return out
}

fun literal_of(values: List<int64>): Expr {
    return Expr.new_list_literal(at(40), &ints(values))
}

@test fun an_empty_literal_is_a_bare_new_call(): void {
    val receiver_name = when (literal_of(List.new<int64>()).kind) {
        MethodCall(receiver, _method, _args) => {
            when (receiver.kind) {
                Variable(name) => name.as_string()
                _ => String.from("")
            }
        }
        _ => String.from("")
    }
    assert_eq(receiver_name.as_str(), empty_list_literal_receiver(), "the checker names its type")
}

@test fun a_literal_is_an_array_literal_of_its_elements(): void {
    var values = List.new<int64>()
    values.push(3)
    values.push(9)
    val callee = when (literal_of(values).kind) {
        Call(name, _args) => name.as_string()
        _ => String.from("")
    }
    assert_eq(callee.as_str(), array_literal_callee(), "the array literal call")
}

@test fun a_literal_keeps_its_elements_in_order(): void {
    var values = List.new<int64>()
    values.push(3)
    values.push(9)
    val second = when (literal_of(values).kind) {
        Call(_name, args) => {
            when (args.at(1).kind) {
                LitInt(n) => n
                _ => 0
            }
        }
        _ => 0
    }
    assert_eq(second, 9, "the second argument is 9")
}
