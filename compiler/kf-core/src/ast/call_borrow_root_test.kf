// A call's returned borrow roots at the one argument it was lent.

import core.assert.assert_eq
import alloc.list.*
import kf_core.span.no_span
import kf_core.ast.expression.*

fun local(name: str, coerce: uint8): Expr {
    var e = Expr.new(no_span(), ExprKind.Variable(intern(name)))
    e.coerce = coerce
    return e
}

fun call_of(args: List<Expr>): Expr {
    return Expr.new(no_span(), ExprKind.Call(intern("peek"), args))
}

@test fun a_call_borrows_from_the_argument_it_was_lent(): void {
    var args = List.new<Expr>()
    args.push(local("owned", coerce_addr_of()))
    args.push(local("count", 0))
    assert_eq(call_of(args).expr_borrow_root().as_str(), "owned", "the receiver an extension borrows")
}

@test fun a_call_lent_nothing_has_no_root(): void {
    var args = List.new<Expr>()
    args.push(local("count", 0))
    assert_eq(call_of(args).expr_borrow_root().as_str(), "", "a borrow from nothing the caller owns")
}

@test fun a_call_lent_two_borrows_has_no_root(): void {
    var args = List.new<Expr>()
    args.push(local("left", coerce_written_amp()))
    args.push(local("right", coerce_written_amp()))
    assert_eq(call_of(args).expr_borrow_root().as_str(), "", "no origin can be named, and the signature says so")
}
