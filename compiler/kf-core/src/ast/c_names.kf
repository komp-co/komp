// Emitted C names that must not collide with a user's name or with one the C
// implementation has taken. Generated names use the reserved prefix `kf__`.
//
// CONSTRAINT: in kf-core because kf-interface writes the same glue names
// into a `.kfi` and cannot see kf-codegen; two spellings would drift into a
// link error.

import alloc.list.*

/// Locals are emitted as `__<name>`, except where that is a GCC keyword alias
/// (`__signed`), which takes `__kf__<name>` instead.
pub fun c_local_name(name: str): String {
    var out = if c_reserves_local(name) { String.from("__kf__") } else { String.from("__") }
    out.append(name)
    return out
}

/// GCC spells each alias both `__x` and `__x__`, so a trailing `__` is
/// dropped before the lookup. `__builtin_*` is a family, matched by prefix.
fun c_reserves_local(name: str): bool {
    if name.starts_with("builtin_") { return true }
    val s = without_trailing_score2(name)
    val n = s.as_str()
    return when n {
        "alignof" => true
        "asm" => true
        "attribute" => true
        "auto_type" => true
        "complex" => true
        "const" => true
        "extension" => true
        "float128" => true
        "imag" => true
        "inline" => true
        "int128" => true
        "label" => true
        "real" => true
        "restrict" => true
        "signed" => true
        "thread" => true
        "typeof" => true
        "volatile" => true
        "DATE" => true
        "FILE" => true
        "FUNCTION" => true
        "LINE" => true
        "PRETTY_FUNCTION" => true
        "STDC" => true
        "TIME" => true
        "VA_ARGS" => true
        "func" => true
        _ => false
    }
}

/// A field keeps its KFlat name unless it is a C keyword, in which case it is
/// escaped: `int32_t signed;` does not compile.
pub fun c_field_name(name: str): String {
    if c_reserves_field(name) {
        var out = String.from("kf__f__")
        out.append(name)
        return out
    }
    return String.from(name)
}

/// The C23 keywords a KFlat identifier can spell, listed explicitly: a missed
/// keyword is a cc error, an extra one a needless rename.
fun c_reserves_field(name: str): bool {
    return when name {
        "auto" => true
        "char" => true
        "const" => true
        "double" => true
        "extern" => true
        "float" => true
        "inline" => true
        "int" => true
        "long" => true
        "register" => true
        "restrict" => true
        "short" => true
        "signed" => true
        "static" => true
        "typedef" => true
        "union" => true
        "unsigned" => true
        "void" => true
        "volatile" => true
        "break" => true
        "case" => true
        "continue" => true
        "default" => true
        "do" => true
        "else" => true
        "enum" => true
        "for" => true
        "goto" => true
        "if" => true
        "return" => true
        "sizeof" => true
        "struct" => true
        "switch" => true
        "while" => true
        "alignas" => true
        "alignof" => true
        "bool" => true
        "constexpr" => true
        "false" => true
        "nullptr" => true
        "static_assert" => true
        "thread_local" => true
        "true" => true
        "typeof" => true
        _ => false
    }
}

fun without_trailing_score2(name: str): String {
    val n = name.byte_len()
    if n < 2 { return String.from(name) }
    if name.byte_at(n - 1) != 95 { return String.from(name) }
    if name.byte_at(n - 2) != 95 { return String.from(name) }
    return name.substring(0, n - 2)
}

/// `kf__tag__<E>`, reserved-prefixed so it cannot collide with a method.
pub fun enum_tag_type(name: str): String {
    var out = String.from("kf__tag__")
    out.append(name)
    return out
}

/// `kf__tag__<E>__<V>`. `<E>_Tag_<V>` would be the mangle of a method named
/// `Tag_<V>`.
pub fun enum_tag_const(ename: str, vname: str): String {
    var out = enum_tag_type(ename)
    out.append("__")
    out.append(vname)
    return out
}

/// `kf__retain__<T>`. `<T>_retain` would be the mangle of a method named
/// `retain`.
pub fun type_retain_fn(name: str): String {
    var out = String.from("kf__retain__")
    out.append(name)
    return out
}

// A borrow in a generic's instance name is mangled structurally, with a
// reserved-prefix marker that carries mutability. A plain `Ref__String` would
// collide with a user's `struct Ref<T>`, and ignoring mutability would give
// `&T` and `&var T` one name and one layout.

pub fun borrow_frag_marker(is_mut: bool): str {
    if is_mut { return "kf__mut__" }
    return "kf__ref__"
}

pub fun borrow_frag(is_mut: bool, inner: str): String {
    var out = String.from(borrow_frag_marker(is_mut))
    out.append(inner)
    return out
}

/// A function type's fragment: `kf__fn__`, the parameters separated by
/// `__kf__and__`, `__kf__to__` and the result, then `__kf__nf`. The markers are
/// reserved, so the fragment splits back apart even when nested.
pub fun fn_frag(params: &List<String>, ret: str): String {
    var out = String.from("kf__fn__")
    while i in 0..params.size() {
        if i > 0 { out.append("__kf__and__") }
        out.append(params.at(i).as_str())
    }
    out.append("__kf__to__")
    out.append(ret)
    out.append("__kf__nf")
    return out
}

/// A function fragment's parameter and result fragments, the inverse of
/// `fn_frag`.
pub struct FnFragParts {
    pub val params: List<String>
    pub val ret: String
}

/// None when `frag` is not exactly one function fragment.
pub fun fn_frag_parts(frag: str): FnFragParts? {
    if !frag.starts_with("kf__fn__") || !frag.ends_with("__kf__nf") { return null }
    val body = frag.substring(8, frag.byte_len() - 8)
    var params = List.new<String>()
    var depth = 0
    var start: uint64 = 0
    var i: uint64 = 0
    var ret = String.from("")
    var seen_to = false
    while i < body.byte_len() {
        val rest = body.as_str().substring(i, body.byte_len())
        if rest.starts_with("kf__fn__") {
            depth = depth + 1
            i = i + 8
        } else if rest.starts_with("__kf__nf") {
            depth = depth - 1
            i = i + 8
        } else if depth == 0 && rest.starts_with("__kf__and__") {
            params.push(body.as_str().substring(start, i))
            i = i + 11
            start = i
        } else if depth == 0 && rest.starts_with("__kf__to__") {
            if i > start { params.push(body.as_str().substring(start, i)) }
            i = i + 10
            start = i
            seen_to = true
        } else {
            i = i + 1
        }
    }
    if !seen_to || depth != 0 { return null }
    ret = body.as_str().substring(start, body.byte_len())
    return FnFragParts { params: params, ret: ret }
}

/// What `frag` borrows, or "" when it is not a borrow. The inverse of
/// `borrow_frag`.
pub fun borrow_frag_inner(frag: str): String {
    val n = frag.byte_len()
    if n <= 9 { return "" }
    if frag.starts_with("kf__ref__") { return frag.substring(9, n) }
    if frag.starts_with("kf__mut__") { return frag.substring(9, n) }
    return ""
}

/// Only meaningful where `borrow_frag_inner` answered with something.
pub fun borrow_frag_is_mut(frag: str): bool {
    return frag.starts_with("kf__mut__")
}

/// An array type's fragment, `kf__array__3__int32`: the length first, so the
/// element's fragment is everything after it.
pub fun array_mangle_frag(element: str, length: uint64): String {
    return "kf__array__${length}__${element}"
}

/// An array fragment's element and length, the inverse of `array_mangle_frag`.
pub struct ArrayFragParts {
    pub val element: String
    pub val length: uint64
}

/// None when `frag` is not an array fragment.
pub fun array_frag_parts(frag: str): ArrayFragParts? {
    val prefix = "kf__array__"
    if !frag.starts_with(prefix) { return null }
    var length: uint64 = 0
    var i = prefix.byte_len()
    while i < frag.byte_len() && frag.byte_at(i) >= 48 && frag.byte_at(i) <= 57 {
        length = length * 10 + (frag.byte_at(i) - 48) as uint64
        i = i + 1
    }
    if i == prefix.byte_len() || !frag.substring(i, frag.byte_len()).starts_with("__") { return null }
    return ArrayFragParts { element: frag.substring(i + 2, frag.byte_len()), length: length }
}
