import alloc.list.*
import kf_core.ast.CrateId
import kf_core.ast.Linkage
import kf_core.ast.Sym
import kf_core.ast.types.Type

@derive(Clone)
pub struct DynMethodSlot {
    pub val name: Sym
    pub val params: List<Type>
    pub val ret: Type
    pub val is_mutating: bool
    pub val slot: uint64
}

@derive(Clone)
pub struct DynTraitLayout {
    pub val identity: Sym
    pub val principal: Sym
    pub val args: List<Type>
    pub var methods: List<DynMethodSlot>
    pub val owner: CrateId
    pub val imported: bool
}

@derive(Clone)
pub struct DynVTableInstance {
    pub val layout: Sym
    pub val receiver: Type
    pub val receiver_identity: Sym
    pub val symbol: Sym
    pub val adapters: List<Sym>
    pub val owner: CrateId
    pub val linkage: Linkage
}

pub fun DynMethodSlot.clone_dyn_method_slot(): DynMethodSlot {
    return DynMethodSlot {
        name: self.name,
        params: clone_dyn_type_list(&self.params),
        ret: self.ret.clone(),
        is_mutating: self.is_mutating,
        slot: self.slot
    }
}

pub fun DynTraitLayout.clone_dyn_trait_layout(): DynTraitLayout {
    var methods = List.new<DynMethodSlot>()
    while method in &self.methods {
        methods.push(method.clone_dyn_method_slot())
    }
    return DynTraitLayout {
        identity: self.identity,
        principal: self.principal,
        args: clone_dyn_type_list(&self.args),
        methods: methods,
        owner: self.owner,
        imported: self.imported
    }
}

pub fun DynVTableInstance.clone_dyn_vtable_instance(): DynVTableInstance {
    var adapters = List.new<Sym>()
    while adapter in &self.adapters {
        adapters.push(adapter)
    }
    return DynVTableInstance {
        layout: self.layout,
        receiver: self.receiver.clone(),
        receiver_identity: self.receiver_identity,
        symbol: self.symbol,
        adapters: adapters,
        owner: self.owner,
        linkage: self.linkage
    }
}

pub fun clone_dyn_layout_list(source: &List<DynTraitLayout>): List<DynTraitLayout> {
    var result = List.new<DynTraitLayout>()
    while item in &source {
        result.push(item.clone_dyn_trait_layout())
    }
    return result
}

pub fun clone_dyn_vtable_list(source: &List<DynVTableInstance>): List<DynVTableInstance> {
    var result = List.new<DynVTableInstance>()
    while item in &source {
        result.push(item.clone_dyn_vtable_instance())
    }
    return result
}

fun clone_dyn_type_list(source: &List<Type>): List<Type> {
    var result = List.new<Type>()
    while item in &source {
        result.push(item.clone())
    }
    return result
}
