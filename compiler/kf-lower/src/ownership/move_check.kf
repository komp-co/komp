// Move analysis over function bodies. A heap-typed local read in value
// context (assignment rhs, by-value argument, return) is a move.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.coerce_none
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.Variant
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*

pub mutating fun Module.move_check_module(diags: &var Diagnostics, mob_count: Ptr<MobCount>, smap: Ptr<SourceMap>, lints: &var Diagnostics, list_name: Sym): void {
    val names = self.compute_move_only_names(list_name)
    val copies = self.copy_type_names()
    // Built once and shared by pointer: it holds move-only lists.
    var param_table = self.build_param_table()
    // Module-scoped: mono turns one source line into many functions.
    var warnings = self.new_warn_state()
    while i in 0..self.decls.size() {
        self.decls.at_mut(i).move_check_top_decl(diags, names, &copies, &var param_table, mob_count, smap, &var warnings)
    }
    // Hands the module's advisories to the caller's channel, which the driver
    // levels and prints. Each is copied explicitly: pushing one by value
    // would be a move out of a borrow.
    while lint in &warnings.lints {
        lints.emit(lint.clone())
    }
}

mutating fun TopDecl.move_check_top_decl(diags: &var Diagnostics, names: List<String>, copies: &List<String>,
    ptable: Ptr<List<ParamEntry>>, mob_count: Ptr<MobCount>, smap: Ptr<SourceMap>, warn: Ptr<WarnState>): void {
    self.move_check_top_decl_in(diags, names, copies, ptable, mob_count, smap, "", warn)
}

/// `self_owner` is the enclosing impl's target, or "" at the top level.
mutating fun TopDecl.move_check_top_decl_in(diags: &var Diagnostics, names: List<String>, copies: &List<String>,
    ptable: Ptr<List<ParamEntry>>, mob_count: Ptr<MobCount>, smap: Ptr<SourceMap>, self_owner: str,
    warn: Ptr<WarnState>): void {
    when (self.kind) {
        Function(params, _, body, _, _, _, _) => {
            var ctx = new_move_ctx(diags, clone_str_list(names), ptable, mob_count, self.name.as_string(), smap, warn)
            ctx.self_owner = String.from(self_owner)
            ctx.copy_names = clone_str_list(copies)
            declare_owned_value_params(params, &var ctx)
            move_check_stmt_list(&var body, &var ctx)
        }
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                methods.at_mut(i).move_check_top_decl_in(diags, names, copies, ptable, mob_count, smap,
                    self.name.as_str(), warn)
            }
        }
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}

pub fun move_check_stmt_list(stmts: &var List<Stmt>, ctx: &var MoveCtx): void {
    while i in 0..stmts.size() {
        stmts.at_mut(i).move_check_stmt(ctx)
    }
}

pub mutating fun Stmt.move_check_stmt(ctx: &var MoveCtx): void {
    // Consumes in earlier statements are ordered before this one.
    ctx.clear_consumed_here()
    when (self.kind) {
        LetVal(let_name, _, init_ptr) => {
            val ip = init_ptr ?: return
            move_check_expr_value(unsafe { &var *ip }, ctx)
            val init = unsafe { *ip }
            // A move-only value bound from a borrow path (`xs.get(i)`, `*p`,
            // `obj.field`) is recorded as borrowed, not owned.
            val borrow_init = init.ty.mc_is_move_only(ctx.move_only_names) && init.is_borrow_source(ctx)
            if borrow_init {
                ctx.declare_borrowed(let_name)
            } else {
                val heap = ctx.tracks(&init.ty)
                if heap { ctx.declare_owned(let_name) }
            }
        }
        LetVar(var_name, _, init_ptr) => {
            // A null init is `var x: T` with no value yet; nothing is bound.
            val ip = init_ptr ?: return
            val init = unsafe { &var *ip }
            move_check_expr_value(init, ctx)
            // A `var` owns what it holds, so a value read through a borrow is
            // copied; one read through a raw pointer is the unsafe code's own.
            val borrow_init = init.ty.mc_is_move_only(ctx.move_only_names) && init.is_borrow_source(ctx)
            if borrow_init && !init.reads_through_a_raw_pointer() {
                init.mark_auto_clone(String.from("<var binding>"), 0, ctx)
            }
            if ctx.tracks(&init.ty) { ctx.declare_owned(var_name) }
        }
        Assign(asn_name, expr_ptr) => {
            move_check_expr_value(unsafe { &var *expr_ptr }, ctx)
            // A reassignment rebinds fully: clear the moved record and any
            // stale borrow status, then classify the rhs like a `val`.
            ctx.unmark_moved(asn_name)
            ctx.remove_borrowed(asn_name)
            val rhs = unsafe { *expr_ptr }
            val borrow_init = rhs.ty.mc_is_move_only(ctx.move_only_names) && rhs.is_borrow_source(ctx)
            if borrow_init {
                ctx.declare_borrowed(asn_name)
            } else {
                val heap = ctx.tracks(&rhs.ty)
                if heap { ctx.declare_owned(asn_name) }
            }
        }
        AssignTo(place_ptr, expr_ptr) => {
            // The place is a borrow; the rhs is stored by value.
            move_check_expr_borrow(unsafe { &var *place_ptr }, ctx)
            move_check_expr_value(unsafe { &var *expr_ptr }, ctx)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            move_check_expr_value(unsafe { &var *ep }, ctx)
            check_consumed_return(unsafe { &var *ep }, ctx)
        }
        Expression(expr_ptr) => {
            move_check_expr_borrow(unsafe { &var *expr_ptr }, ctx)
        }
        If(cond_ptr, then_body, else_body) => {
            move_check_expr_borrow(unsafe { &var *cond_ptr }, ctx)
            val moved_before = ctx.snapshot_moved()
            val owned_before = ctx.snapshot_owned()
            val borrowed_before = ctx.snapshot_borrowed()
            val then_div = stmt_list_diverges(then_body)
            val else_div = stmt_list_diverges(else_body)
            move_check_stmt_list(&var then_body, ctx)
            val moved_after_then = ctx.snapshot_moved()
            ctx.restore_moved(moved_before)
            ctx.restore_owned(owned_before)
            ctx.restore_borrowed(borrowed_before)
            move_check_stmt_list(&var else_body, ctx)
            val moved_after_else = ctx.snapshot_moved()
            // A diverging branch never falls through, so it is left out of the
            // merge. The branch-end sets are unioned, so a name moved before
            // the `if` and reassigned in both branches is live again.
            if !then_div && !else_div {
                check_branch_divergence(moved_after_then, moved_after_else, self.span, ctx)
            }
            // A name consumed in both branches keeps both consumes pending.
            var merged = List.new<MovedEntry>()
            if !then_div {
                val m2 = union_moved_consumes(merged, moved_after_then)
                merged = m2
            }
            if !else_div {
                val m3 = union_moved_consumes(merged, moved_after_else)
                merged = m3
            }
            ctx.moved = merged
            ctx.apply_owned_intersection_div(owned_before, moved_after_then, moved_after_else, then_div, else_div)
        }
        // The subject is evaluated once; the body is loop-carried.
        ForEach(_binder, subj_ptr, body) => {
            move_check_expr_borrow(unsafe { &var *subj_ptr }, ctx)
            val fe_moved_before = ctx.snapshot_moved()
            move_check_stmt_list(&var body, ctx)
            val fe_moved_after = ctx.snapshot_moved()
            while fe in &distinct_moved(&fe_moved_after) {
                if !moved_contains(fe_moved_before, fe.name) {
                    emit_loop_move_leak(fe.name.as_string(), fe.site, ctx)
                }
            }
        }
        While(cond_ptr, body) => {
            move_check_expr_borrow(unsafe { &var *cond_ptr }, ctx)
            val moved_before = ctx.snapshot_moved()
            move_check_stmt_list(&var body, ctx)
            val moved_after_first = ctx.snapshot_moved()
            // Moved in the body but not before it: moved again on the next
            // iteration.
            while e in &distinct_moved(&moved_after_first) {
                val pre = moved_contains(moved_before, e.name)
                if !pre {
                    emit_loop_move_leak(e.name.as_string(), e.site, ctx)
                }
            }
        }
        When(subj_ptr, arms) => {
            move_check_expr_borrow(unsafe { &var *subj_ptr }, ctx)
            val subj = unsafe { *subj_ptr }
            // Through the subject's borrow forms: `when` over an
            // `&Option<String>` binds payloads it does not own.
            val subj_owner = subj.ty.mc_receiver_pointee()
            // `when (self)` is classified from the enclosing impl: Mono leaves
            // `self` typed as the template, which matches no move-only name.
            var subj_mo = subj_owner.mc_is_move_only(ctx.move_only_names)
            if !subj_mo {
                if mc_expr_is_self(&subj) {
                    subj_mo = mc_names_has(ctx.move_only_names, ctx.self_owner.as_str())
                }
            }
            // A fresh value is owned by nothing else, so a variant's binders
            // own what they bind rather than view it.
            val subj_fresh = subj.is_fresh_move_only_value(ctx)
            val moved_before = ctx.snapshot_moved()
            val owned_before = ctx.snapshot_owned()
            val borrowed_before = ctx.snapshot_borrowed()
            // Diverging arms are skipped. Seeded from empty, so a name
            // reassigned in every arm comes out live.
            var unioned_moved = List.new<MovedEntry>()
            while ai in 0..arms.size() {
                val arm = arms.at_mut(ai)
                ctx.restore_moved(moved_before)
                ctx.restore_owned(owned_before)
                ctx.restore_borrowed(borrowed_before)
                declare_pattern_binds(arm.pattern, ctx)
                val owns_payloads = subj_fresh && arm.pattern.is_flat_variant()
                if subj_mo && !owns_payloads { declare_pattern_binds_borrowed(arm.pattern, ctx) }
                when (arm.guard) {
                    Some(guard) => move_check_expr_borrow(unsafe { &var *guard }, ctx)
                    None => { }
                }
                move_check_stmt_list(&var arm.body, ctx)
                val arm_div = stmt_list_diverges(arm.body)
                if !arm_div {
                    val after = ctx.snapshot_moved()
                    unioned_moved = union_moved_consumes(unioned_moved, after)
                }
            }
            ctx.moved = unioned_moved
        }
        Switch(_, _) => return
        Drop(_) => return
        // Produced after the move check.
        Release(_) => return
        Break => return
        Continue => return
        Poison => return
    }
}

/// Through any borrows or derefs; mirrors trim_binders' expr_is_self.
fun mc_expr_is_self(e: &Expr): bool {
    return when (e.kind) {
        Variable(name) => name.as_str().equals("self")
        Unary(_op, inner) => mc_expr_is_self(unsafe { &*inner })
        _ => false
    }
}

fun mc_names_has(names: &List<String>, name: str): bool {
    if name.byte_len() == 0 { return false }
    while item in &names {
        if item.as_str().equals(name) { return true }
    }
    return false
}

/// A call's result, owned by nobody but the `when` over it.
///
/// CONSTRAINT: rc_insert hoists exactly these subjects and consumes them, so
/// the arms own the payloads their binders take.
fun Expr.is_fresh_move_only_value(ctx: &var MoveCtx): bool {
    if self.coerce != coerce_none() { return false }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return false }
    return when (self.kind) {
        Call(_n, _a) => true
        Intrinsic(_i, _a) => true
        CallValue(_callee, _a) => true
        MethodCall(_r, _m, _a) => true
        _ => false
    }
}

/// A variant whose payloads are each a name or `_`.
fun Pattern.is_flat_variant(): bool {
    when (self.kind) {
        Variant(_name, payloads) => {
            while p in &payloads {
                when (p.kind) {
                    Identifier(_n) => { }
                    Wildcard => { }
                    _ => return false
                }
            }
            return true
        }
        _ => return false
    }
}

/// `*p`, or a field reached from one, where `p` is a raw pointer.
fun Expr.reads_through_a_raw_pointer(): bool {
    return when (self.kind) {
        Deref(inner) => when (inner.ty.kind) {
            PtrTo(_p) => true
            _ => false
        }
        FieldAccess(base, _f) => base.reads_through_a_raw_pointer()
        _ => false
    }
}
