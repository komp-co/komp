// One warning per source line, and none about pruned functions.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.diagnostic.*
import kf_core.ast.new_module

fun at(file: uint32, start: uint32): Span {
    return Span { file_id: file, start: start, end: start + 4 }
}

fun fresh_warn_state(): WarnState {
    return WarnState {
        warned: List.new<Span>(), reached: new_reached(),
        prune: false, clone_names: List.new<String>(), lints: List.new<Diagnostic>()
    }
}

@test fun the_first_time_a_span_is_offered_it_is_new(): void {
    var w = fresh_warn_state()
    assert_eq(w.warn_span_is_new(at(1, 10)), true, "nothing has been said yet")
}

@test fun the_same_span_is_not_new_a_second_time(): void {
    var w = fresh_warn_state()
    val _first = w.warn_span_is_new(at(1, 10))
    assert_eq(w.warn_span_is_new(at(1, 10)), false, "the 55 instances of one line are one line")
}

@test fun many_instances_of_one_span_yield_one_warning(): void {
    var w = fresh_warn_state()
    var said: uint64 = 0
    var i: uint64 = 0
    while i < 55 {
        if w.warn_span_is_new(at(1, 10)) { said = said + 1 }
        i = i + 1
    }
    assert_eq(said, 1, "the count in the issue, collapsed to the line it describes")
}

@test fun a_different_offset_in_one_file_is_new(): void {
    var w = fresh_warn_state()
    val _first = w.warn_span_is_new(at(1, 10))
    assert_eq(w.warn_span_is_new(at(1, 20)), true, "a second line still warns")
}

@test fun the_same_offset_in_a_different_file_is_new(): void {
    var w = fresh_warn_state()
    val _first = w.warn_span_is_new(at(1, 10))
    assert_eq(w.warn_span_is_new(at(2, 10)), true, "two files share offsets; they are not the same line")
}

@test fun a_span_of_a_different_length_is_new(): void {
    var w = fresh_warn_state()
    val _first = w.warn_span_is_new(at(1, 10))
    assert_eq(w.warn_span_is_new(Span { file_id: 1, start: 10, end: 99 }), true, "a wider span is a different subject")
}

@test fun a_module_with_no_main_filters_nothing(): void {
    val m = new_module(List.new<String>())
    val w = m.new_warn_state()
    assert_eq(w.prune, false, "a library's exports ARE its API, so nothing is unreachable")
}
