// One call may not lend the same place twice if either lending is mutable:
//
//     swap(&var pair.a, &var pair.a)   // two mutable borrows
//     mix(&var pair.a, &pair.a)        // the write may invalidate the read
//
// Overlap is containment over access paths: `x.a` overlaps `x` and `x.a.b`,
// not `x.b`. An element at a non-literal index is the whole container.
//
// The receiver is not counted: `out.append(out.as_str())` is an aliasing
// shape `String.append` supports on purpose.
//
// CONSTRAINT: runs after alpha_rename, so a plain name comparison is exact.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

struct Claim {
    val path: String
    val is_mut: bool
}

pub fun Module.borrow_exclusivity_module(diags: Ptr<List<Diagnostic>>): void {
    var param_table = self.build_param_table()
    while decl in &self.decls {
        decl.bx_check_top_decl(&var param_table, diags)
    }
}

fun TopDecl.bx_check_top_decl(ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    when (self.kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => {
            bx_check_stmts(&body, ptable, diags)
        }
        ImplBlock(methods) => {
            while method in &methods {
                method.bx_check_top_decl(ptable, diags)
            }
        }
        TraitImpl(_tref, methods) => {
            while method in &methods {
                method.bx_check_top_decl(ptable, diags)
            }
        }
        _ => { }
    }
}

fun bx_check_stmts(stmts: &List<Stmt>, ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    while stmt in &stmts {
        (stmt).bx_check_stmt(ptable, diags)
    }
}

fun Stmt.bx_check_stmt(ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    when (self.kind) {
        Expression(e) => bx_check_expr(unsafe { &*e }, self.span, ptable, diags)
        LetVal(_n, _t, init) => bx_check_init(init.view(), self.span, ptable, diags)
        LetVar(_n, _t, init) => bx_check_init(init.view(), self.span, ptable, diags)
        Assign(_n, e) => bx_check_expr(unsafe { &*e }, self.span, ptable, diags)
        AssignTo(target, e) => {
            bx_check_expr(unsafe { &*target }, self.span, ptable, diags)
            bx_check_expr(unsafe { &*e }, self.span, ptable, diags)
        }
        Return(maybe) => {
            when (maybe) {
                Some(e) => bx_check_expr(unsafe { &*e }, self.span, ptable, diags)
                None => { }
            }
        }
        If(cond, then_b, else_b) => {
            bx_check_expr(unsafe { &*cond }, self.span, ptable, diags)
            bx_check_stmts(&then_b, ptable, diags)
            bx_check_stmts(&else_b, ptable, diags)
        }
        While(cond, body) => {
            bx_check_expr(unsafe { &*cond }, self.span, ptable, diags)
            bx_check_stmts(&body, ptable, diags)
        }
        ForEach(_b, subject, body) => {
            bx_check_expr(unsafe { &*subject }, self.span, ptable, diags)
            bx_check_stmts(&body, ptable, diags)
        }
        When(subject, arms) => {
            bx_check_expr(unsafe { &*subject }, self.span, ptable, diags)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => bx_check_expr(unsafe { &*guard }, self.span, ptable, diags)
                    None => { }
                }
                bx_check_stmts(arm.body, ptable, diags)
            }
        }
        Switch(subject, arms) => {
            bx_check_expr(unsafe { &*subject }, self.span, ptable, diags)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => bx_check_expr(unsafe { &*guard }, self.span, ptable, diags)
                    None => { }
                }
                bx_check_stmts(arm.body, ptable, diags)
            }
        }
        _ => { }
    }
}

/// A declaration without an initializer has a null pointer.
fun bx_check_init(init_opt: Ptr<Expr>?, at: Span, ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    val init = init_opt ?: return
    bx_check_expr(unsafe { &*init }, at, ptable, diags)
}

fun Expr.bx_check_expr(at: Span, ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    when (self.kind) {
        Call(name, args) => {
            var claims = List.new<Claim>()
            collect_arg_claims(&args, name.as_string(), ptable, &var claims)
            report_conflicts(&claims, at, diags)
            bx_check_exprs(&args, at, ptable, diags)
        }
        MethodCall(receiver, method, args) => {
            var claims = List.new<Claim>()
            // Declared arguments only; the receiver is excluded.
            val recv = unsafe { &*receiver };
            val key = recv.ty.bx_method_key(method.as_str())
            collect_arg_claims(&args, key, ptable, &var claims)
            report_conflicts(&claims, at, diags)
            recv.bx_check_expr(at, ptable, diags)
            bx_check_exprs(&args, at, ptable, diags)
        }
        Binary(l, _op, r) => {
            bx_check_expr(unsafe { &*l }, at, ptable, diags)
            bx_check_expr(unsafe { &*r }, at, ptable, diags)
        }
        Cast(inner, _t) => bx_check_expr(unsafe { &*inner }, at, ptable, diags)
        Deref(inner) => bx_check_expr(unsafe { &*inner }, at, ptable, diags)
        _ => { }
    }
}

fun bx_check_exprs(args: &List<Expr>, at: Span, ptable: Ptr<List<ParamEntry>>, diags: Ptr<List<Diagnostic>>): void {
    while arg in &args {
        arg.bx_check_expr(at, ptable, diags)
    }
}

/// A by-value argument aliases nothing the callee holds.
fun collect_arg_claims(args: &List<Expr>, callee: String, ptable: Ptr<List<ParamEntry>>, out: &var List<Claim>): void {
    while i in 0..args.size() {
        val pl = param_lookup(unsafe { &*ptable }, callee.clone(), i)
        if pl.found && pl.is_lend {
            val path = access_path(args.at(i))
            if path.as_str() != "" {
                out.push(Claim { path: path, is_mut: pl.is_mut_sink })
            }
        }
    }
}

/// `Type_method`, the param table key; empty without a nominal type.
fun Type.bx_method_key(method: str): String {
    val base = self.bl_ty_base_name()
    if base.as_str() == "" { return "" }
    return "${base.as_str()}_${method}"
}

fun report_conflicts(claims: &List<Claim>, at: Span, diags: Ptr<List<Diagnostic>>): void {
    while i in 0..claims.size() {
        var j = i + 1
        while j < claims.size() {
            val a = claims.at(i)
            val b = claims.at(j)
            if (a.is_mut || b.is_mut) && paths_overlap(a.path.as_str(), b.path.as_str()) {
                a.emit_conflict(b, at, diags)
                return
            }
            j = j + 1
        }
    }
}

fun Claim.emit_conflict(b: &Claim, at: Span, diags: Ptr<List<Diagnostic>>): void {
    val message = self.conflict_message(b)
    unsafe { diags.push(new_diagnostic(Severity.Error, new_label(at, message))) }
}

fun Claim.conflict_message(b: &Claim): String {
    val both_mut = self.is_mut && b.is_mut
    if self.path.as_str() == b.path.as_str() {
        if both_mut {
            return "`${self.path.as_str()}` is lent mutably twice in one call: the callee may assume the two are independent"
        }
        return "`${self.path.as_str()}` is lent mutably and read in the same call: the write may invalidate the read"
    }
    val outer = self.shorter_path(b)
    val inner = self.longer_path(b)
    return "`${outer.as_str()}` and `${inner.as_str()}` overlap in one call, and one of them is lent mutably"
}

fun Claim.shorter_path(b: &Claim): String {
    if self.path.len() <= b.path.len() { return self.path.clone() }
    return b.path.clone()
}

fun Claim.longer_path(b: &Claim): String {
    if self.path.len() > b.path.len() { return self.path.clone() }
    return b.path.clone()
}

/// Equal paths overlap and `x` contains `x.a`, but `x.a` and `x.ab` do not.
pub fun paths_overlap(a: str, b: str): bool {
    if a == b { return true }
    return path_contains(a, b) || path_contains(b, a)
}

/// `outer` is a prefix of `inner` ending at a component boundary.
fun path_contains(outer: str, inner: str): bool {
    val olen = outer.byte_len()
    val ilen = inner.byte_len()
    if olen >= ilen { return false }
    var i = 0
    while i < olen {
        if outer.byte_at(i) != inner.byte_at(i) { return false }
        i = i + 1
    }
    return inner.byte_at(olen) == 46
}

/// A dotted path, or "" for a literal, constructor or computed value. A
/// method call reduces to its receiver, so every element of a container
/// shares the container's path.
pub fun Expr.access_path(): String {
    when (self.kind) {
        Variable(name) => return name.as_string()
        FieldAccess(base, field) => {
            val root = access_path(unsafe { &*base })
            if root.as_str() == "" { return "" }
            return "${root.as_str()}.${field.as_str()}"
        }
        Deref(inner) => return access_path(unsafe { &*inner })
        MethodCall(receiver, _m, _a) => return access_path(unsafe { &*receiver })
        DynCoerce(inner, _s) => return access_path(unsafe { &*inner })
        Cast(inner, _t) => return access_path(unsafe { &*inner })
        Retain(inner) => return access_path(unsafe { &*inner })
        _ => return ""
    }
}
