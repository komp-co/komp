import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

// A local recorded as borrowed, not owned (`val t = xs.get(i)`, or a
// `when` binder over a move-only subject). Moving it is a move out of a
// borrow.
fun Expr.expr_is_borrowed_local(ctx: &var MoveCtx): bool {
    return when (self.kind) {
        Variable(n) => ctx.contains_borrowed(n)
        _ => false
    }
}

pub mutating fun MoveCtx.contains_borrowed(name: Sym): bool {
    while item in &self.borrowed {
        if item.id == name.id { return true }
    }
    return false
}

pub mutating fun MoveCtx.declare_borrowed(name: Sym): void {
    if !self.contains_borrowed(name) { self.borrowed.push(name) }
}

pub fun move_check_args_borrow(args: &var List<Expr>, ctx: &var MoveCtx): void {
    while i in 0..args.size() {
        args.at_mut(i).move_check_expr_borrow(ctx)
    }
}

// A reassignment replaces the value, so a stale borrowed status must not
// survive it.
pub mutating fun MoveCtx.remove_borrowed(name: Sym): void {
    var kept = List.new<Sym>()
    while b in &self.borrowed {
        if b.id != name.id { kept.push(b) }
    }
    self.borrowed = kept
}

pub mutating fun MoveCtx.contains_owned(name: Sym): bool {
    while o in &self.owned {
        val eq = o.id == name.id
        if eq { return true }
    }
    return false
}

pub mutating fun MoveCtx.contains_moved(name: Sym): bool {
    while e in &self.moved {
        val eq = e.name.id == name.id
        if eq { return true }
    }
    return false
}

/// Turns every pending consume of `name` into a copy: after an `if` each
/// branch may hold one. True when any was not a copy already.
pub mutating fun MoveCtx.clone_pending_consumes(name: Sym): bool {
    var cloned = false
    while e in &self.moved {
        if e.name.id == name.id && ctx_clone_node(e.last_consume) { cloned = true }
    }
    return cloned
}

pub mutating fun MoveCtx.declare_owned(name: Sym): void {
    val present = self.contains_owned(name)
    if !present {
        self.owned.push(name)
    }
}

pub mutating fun MoveCtx.mark_moved(name: Sym, site: Span, node: Ptr<Expr>): void {
    var new_owned = List.new<Sym>()
    while o in &self.owned {
        val same = o.id == name.id
        if !same { new_owned.push(o) }
    }
    self.owned = new_owned
    self.moved.push(MovedEntry { name: name, site: site, last_consume: node })
    self.note_consumed_here(name)
}

/// Records that `name` was consumed by the statement being checked.
pub mutating fun MoveCtx.note_consumed_here(name: Sym): void {
    while n in &self.consumed_here {
        if n.id == name.id { return }
    }
    self.consumed_here.push(name)
}

/// An earlier consume of `name` in this statement: siblings nothing orders.
pub mutating fun MoveCtx.ctx_consumed_here(name: Sym): bool {
    while n in &self.consumed_here {
        if n.id == name.id { return true }
    }
    return false
}

/// Called at each statement boundary.
pub mutating fun MoveCtx.clear_consumed_here(): void {
    self.consumed_here = List.new<Sym>()
}

/// Idempotent; a node already carrying a coercion is left alone.
pub fun ctx_clone_node(node: Ptr<Expr>): bool {
    val raw: uint64 = unsafe { node as uint64 }
    if raw == 0 { return false }
    if unsafe { node.coerce } != coerce_none() { return false }
    unsafe { node.coerce = coerce_clone() }
    return true
}

pub mutating fun MoveCtx.unmark_moved(name: Sym): void {
    var new_moved = List.new<MovedEntry>()
    while e in &self.moved {
        val same = e.name.id == name.id
        if !same { new_moved.push(e) }
    }
    self.moved = new_moved
}

pub mutating fun MoveCtx.ctx_emit(d: Diagnostic): void {
    val dp = self.diags
    unsafe { dp.push(d) }
}

/// String, refcounted structs and enums.
fun Type.is_heap_ty(): bool {
    return when (self.kind) {
        Struct(_) => true
        EnumTy(_) => true
        Int8 => false
        Int16 => false
        Int32 => false
        Int64 => false
        UInt8 => false
        UInt16 => false
        UInt32 => false
        UInt64 => false
        Float32 => false
        Float64 => false
        Bool => false
        Char => false
        StrTy => false
        Void => false
        Never => false
        TraitTy(_) => false
        DynTraitTy(_) => false
        Generic(_) => false
        PtrTo(_) => false
        BoxOf(_) => true
        ArrayOf(_, _) => self.array_element().is_heap_ty()
        RefTo(_, _) => false
        FnTy(_) => false
        // Mono resolves every projection.
        Projection(_, _) => false
        Poison => false
    }
}

/// Reading out of a container, deref or field is not owning, and neither is
/// renaming an already-borrowed local: `var e = d` after
/// `val d = xs.get(i)` names the same element.
pub fun Expr.is_borrow_source(ctx: &var MoveCtx): bool {
    if self.is_borrow_path(&ctx.move_only_names) { return true }
    if self.expr_is_borrowed_local(ctx) { return true }
    // An `if` is a view if either branch is.
    return when (self.kind) {
        IfExpr(_c, t_ptr, e_ptr) => is_borrow_source(unsafe { &*t_ptr }, ctx)
            || is_borrow_source(unsafe { &*e_ptr }, ctx)
        _ => false
    }
}
