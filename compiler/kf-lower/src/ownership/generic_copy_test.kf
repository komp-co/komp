import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

fun param_bounded(name: str, bound: str): TypeParam {
    var tp = new_type_param(no_span(), String.from(name))
    tp.bounds.push(TypeRef.new(no_span(), TypeRefKind.Named(intern(bound), List.new<TypeRef>())))
    return tp
}

fun no_supers(): TemplateBounds {
    return TemplateBounds { clone_trait: intern("Clone"), copy_trait: intern("Copy"), supers: List.new<TraitSupers>() }
}

fun empty_fn(name: str): TopDecl {
    return new_top_decl(no_span(), String.from(name),
        TopDeclKind.Function(List.new<Param>(), void_ret(), List.new<Stmt>(), true, false, false, false))
}

@test
fun a_written_bound_is_found(): void {
    val bounded = no_supers().param_is_bounded_by(&param_bounded("T", "Clone"), intern("Clone"))
    assert_eq(bounded, true, "`T: Clone` names Clone")
}

@test
fun another_bound_is_not_that_trait(): void {
    val bounded = no_supers().param_is_bounded_by(&param_bounded("T", "Equal"), intern("Clone"))
    assert_eq(bounded, false, "`T: Equal` is not Clone")
}

@test
fun an_unknown_trait_bounds_nothing(): void {
    assert_eq(no_supers().param_is_bounded_by(&param_bounded("T", "Clone"), intern("")), false,
        "with no lang trait in scope, nothing counts as bounded")
}

@test
fun a_supertrait_bounds_the_parameter(): void {
    var supers = List.new<Sym>()
    supers.push(intern("Copy"))
    var table = List.new<TraitSupers>()
    table.push(TraitSupers { name: intern("Whole"), supers: supers })
    val bounds = TemplateBounds { clone_trait: intern("Clone"), copy_trait: intern("Copy"), supers: table }
    assert_eq(bounds.param_is_bounded_by(&param_bounded("T", "Whole"), intern("Copy")), true,
        "`trait Whole: Copy` makes `T: Whole` Copy")
}

@test
fun a_generic_function_is_a_template(): void {
    var f = empty_fn("pick")
    f.generics.push(new_type_param(no_span(), String.from("T")))
    assert_eq(decl_is_template(&f), true, "it has a type parameter")
}

@test
fun a_plain_function_is_not_a_template(): void {
    assert_eq(decl_is_template(&empty_fn("main")), false, "no type parameters")
}

@test
fun an_impl_with_a_generic_method_is_a_template(): void {
    var method = empty_fn("map")
    method.generics.push(new_type_param(no_span(), String.from("F")))
    var methods = List.new<TopDecl>()
    methods.push(method)
    val block = new_top_decl(no_span(), String.from("Bag"), TopDeclKind.ImplBlock(methods))
    assert_eq(decl_is_template(&block), true, "one generic method is enough")
}
