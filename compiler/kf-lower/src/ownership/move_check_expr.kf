
import kf_core.ast.*

pub mutating fun Expr.move_check_expr_value(ctx: &var MoveCtx): void {
    when (self.kind) {
        Variable(name) => {
            val heap = self.ty.is_heap_ty()
            if heap { self.consume_var_node(name, ctx) }
        }
        Call(_, args) => {
            move_check_args_borrow(args, ctx)
            val callee = self.mangled_callee.as_string()
            check_consumed_args_for(args, callee, ctx)
            move_check_args_consume(args, callee, ctx)
        }
        MethodCall(recv_ptr, _, args) => {
            move_check_expr_borrow(unsafe { &var *recv_ptr }, ctx)
            move_check_args_borrow(args, ctx)
            // A constructor has no callee in the parameter table.
            if self.is_variant_ctor && !self.payload_is_a_borrow() {
                check_consumed_ctor_payloads(args, ctx)
            }
            val callee2 = self.mangled_callee.as_string()
            check_consumed_args_for(args, callee2, ctx)
            move_check_args_consume(args, callee2, ctx)
        }
        Binary(lhs_ptr, _op, rhs_ptr) => {
            move_check_expr_borrow(unsafe { &var *lhs_ptr }, ctx)
            move_check_expr_borrow(unsafe { &var *rhs_ptr }, ctx)
        }
        Unary(_, inner_ptr) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        Deref(inner_ptr) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        FieldAccess(obj_ptr, _) => {
            move_check_expr_borrow(unsafe { &var *obj_ptr }, ctx)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            move_check_expr_borrow(unsafe { &var *c_ptr }, ctx)
            move_check_expr_value(unsafe { &var *t_ptr }, ctx)
            move_check_expr_value(unsafe { &var *e_ptr }, ctx)
        }
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        StructLit(_, fields) => {
            while fi in &fields {
                val vp = fi.value
                move_check_expr_value(unsafe { &var *vp }, ctx)
                check_consumed_field(unsafe { &var *vp }, ctx)
            }
        }
        Cast(inner_ptr, _) => {
            move_check_expr_value(unsafe { &var *inner_ptr }, ctx)
        }
        DynCoerce(inner_ptr, _) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        LitInt(_) => return
        LitStr(_) => return
        LitFloat(_) => return
        LitChar(_) => return
        LitBool(_) => return
        Retain(_) => return
        Release(_) => return
        Lambda(_, _) => return
        Block(_) => return
        Poison => return
    }
}

/// Borrow context: variable reads do not move.
pub mutating fun Expr.move_check_expr_borrow(ctx: &var MoveCtx): void {
    when (self.kind) {
        Variable(name) => {
            val heap = self.ty.is_heap_ty()
            if heap {
                val already_moved = ctx.contains_moved(name)
                if already_moved {
                    mark_uam_clone(name, self, false, ctx)
                }
            }
        }
        Call(_, args) => {
            move_check_args_borrow(args, ctx)
            val callee_b1 = self.mangled_callee.as_string()
            check_consumed_args_for(args, callee_b1, ctx)
            move_check_args_consume(args, callee_b1, ctx)
        }
        MethodCall(recv_ptr, _, args) => {
            move_check_expr_borrow(unsafe { &var *recv_ptr }, ctx)
            move_check_args_borrow(args, ctx)
            // A constructor's payloads are move-sinks as an argument too.
            if self.is_variant_ctor && !self.payload_is_a_borrow() {
                check_consumed_ctor_payloads(args, ctx)
            }
            val callee_b2 = self.mangled_callee.as_string()
            check_consumed_args_for(args, callee_b2, ctx)
            move_check_args_consume(args, callee_b2, ctx)
        }
        Binary(lhs_ptr, _op, rhs_ptr) => {
            move_check_expr_borrow(unsafe { &var *lhs_ptr }, ctx)
            move_check_expr_borrow(unsafe { &var *rhs_ptr }, ctx)
        }
        Unary(_, inner_ptr) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        Deref(inner_ptr) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        FieldAccess(obj_ptr, _) => {
            move_check_expr_borrow(unsafe { &var *obj_ptr }, ctx)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            move_check_expr_borrow(unsafe { &var *c_ptr }, ctx)
            move_check_expr_borrow(unsafe { &var *t_ptr }, ctx)
            move_check_expr_borrow(unsafe { &var *e_ptr }, ctx)
        }
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        StructLit(_, fields) => {
            while fi in &fields {
                val vp = fi.value
                move_check_expr_borrow(unsafe { &var *vp }, ctx)
                check_consumed_field(unsafe { &var *vp }, ctx)
            }
        }
        Cast(inner_ptr, _) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        DynCoerce(inner_ptr, _) => {
            move_check_expr_borrow(unsafe { &var *inner_ptr }, ctx)
        }
        LitInt(_) => return
        LitStr(_) => return
        LitFloat(_) => return
        LitChar(_) => return
        LitBool(_) => return
        Retain(_) => return
        Release(_) => return
        Lambda(_, _) => return
        Block(_) => return
        Poison => return
    }
}
