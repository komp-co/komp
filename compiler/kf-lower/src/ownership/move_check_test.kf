import core.assert.*
import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_lower.refcount.ret_op

fun null_tref(): Ptr<TypeRef> {
    return unsafe { 0 as Ptr<TypeRef> }
}

fun mk_str_var(name: String): Expr {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name.as_str())))
    e.ty = intern("String").lang_struct_ty(no_span())
    return e
}

fun mk_int_var(name: String): Expr {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name.as_str())))
    e.ty = int32_ty(no_span())
    return e
}

fun mk_letval(name: String, init: Expr): Stmt {
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = init }
    return new_stmt(no_span(), StmtKind.LetVal(intern(name.as_str()), null, ip))
}

fun mk_return(expr: Expr): Stmt {
    val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ep = expr }
    return new_stmt(no_span(), StmtKind.Return(ret_op(ep)))
}

fun fresh_diag_ptr(): Ptr<List<Diagnostic>> {
    val diags = List.new<Diagnostic>()
    val dp: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *dp = diags }
    return dp
}

// A MoveCtx with an empty param table. The move-only names normally come
// from core's `impl Drop for String`; these tests state it.
fun fresh_ctx(dp: Ptr<List<Diagnostic>>): MoveCtx {
    var names = List.new<String>()
    names.push(String.from("String"))
    val pt: Ptr<List<ParamEntry>> = unsafe { alloc<List<ParamEntry>>() }
    unsafe { *pt = List.new<ParamEntry>() }
    val mc: Ptr<MobCount> = unsafe { alloc<MobCount>() }
    unsafe { *mc = MobCount { n: 0 } }
    val sm: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *sm = new_source_map() }
    val wp: Ptr<WarnState> = unsafe { alloc<WarnState>() }
    // No module: each test asserts one warning at a time.
    unsafe { *wp = WarnState {
            warned: List.new<Span>(), reached: new_reached(),
            prune: false, clone_names: List.new<String>(), lints: List.new<Diagnostic>()
        } }
    return new_move_ctx(dp, names, pt, mc, String.from("test_fn"), sm, wp)
}

@test fun move_check_no_move_for_int(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s = mk_letval(String.from("y"), mk_int_var(String.from("x")))
    s.move_check_stmt(&var ctx)
    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "int locals don't trigger move diagnostics")
}

@allow(deref_through_temporary)
@test fun move_after_move_clones_prior_consume(): void {
    // val y = x; val z = x: the first consume is auto-cloned and no
    // diagnostic is pushed.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s1 = mk_letval(String.from("y"), mk_str_var(String.from("x")))
    s1.move_check_stmt(&var ctx)
    var s2 = mk_letval(String.from("z"), mk_str_var(String.from("x")))
    s2.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "MM-2 use-after-move emits no diagnostic")

    when (s1.kind) {
        LetVal(_n, _t, ip) => {
            val first_use = unsafe { *(ip!!) }
            assert_eq(first_use.coerce == coerce_clone(), true, "prior consume marked coerce_clone")
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
}

@test fun two_consumes_in_one_statement_both_copy(): void {
    // `f(g(x), h(x))`: nothing orders the two consumes, so both copy.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var first = mk_str_var(String.from("x"))
    var second = mk_str_var(String.from("x"))
    first.mark_var_consumed(&var ctx)
    second.mark_var_consumed(&var ctx)
    assert_eq(first.coerce == coerce_clone(), true, "the first sibling consume copies")
    assert_eq(second.coerce == coerce_clone(), true, "the second sibling consume copies too")
    assert_eq(ctx.contains_owned(intern("x")), true, "`x` still owns its own value")
}

@allow(deref_through_temporary)
@test fun two_consumes_in_separate_statements_move_once(): void {
    // In different statements they are ordered: only the first copies.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s1 = mk_letval(String.from("y"), mk_str_var(String.from("x")))
    s1.move_check_stmt(&var ctx)
    var s2 = mk_letval(String.from("z"), mk_str_var(String.from("x")))
    s2.move_check_stmt(&var ctx)

    when (s1.kind) {
        LetVal(_n, _t, ip) => {
            val first_use = unsafe { *(ip!!) }
            assert_eq(first_use.coerce == coerce_clone(), true, "the earlier statement's consume copies")
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
    when (s2.kind) {
        LetVal(_n2, _t2, ip2) => {
            val last_use = unsafe { *(ip2!!) }
            assert_eq(last_use.coerce == coerce_none(), true, "the last consume stays a move")
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
}

@test fun move_check_no_diag_on_single_use(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s = mk_letval(String.from("y"), mk_str_var(String.from("x")))
    s.move_check_stmt(&var ctx)
    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "single move is fine")
}

@test fun use_after_move_does_not_poison(): void {
    // A later use stays intact; the prior consume is cloned instead.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    val consume: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *consume = mk_str_var(String.from("x")) }
    ctx.mark_moved(intern("x"), no_span(), consume)

    var e = mk_str_var(String.from("x"))
    e.move_check_expr_value(&var ctx)

    when (e.kind) {
        Poison => assert_eq(false, true, "MM-2 must not poison a use-after-move")
        _ => assert_eq(true, true, "use-after-move left intact")
    }
    val prior = unsafe { *consume }
    assert_eq(prior.coerce == coerce_clone(), true, "prior consume cloned")
}
