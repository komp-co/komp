// A generic body that copies a `T` it reads through a borrow says so in its
// bounds: `T: Clone`, or `T: Copy`. Checked on the templates, before mono
// replaces them with instances that each answer for one concrete type.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.ast.subst.clone_type_ref
import kf_core.ast.subst.subst_stmt_list
import kf_lower.alpha_rename_module
import kf_lower.desugar_block_expr_module
import kf_lower.desugar_when_expr_module

/// Adds an `unauthorized_copy` to `lints` for each copy of an under-bounded
/// type parameter. `m` is not changed: the templates are checked as copies.
pub fun check_generic_copies(m: &Module, smap: Ptr<SourceMap>, clone_trait: Sym, copy_trait: Sym,
                             lints: Ptr<List<Diagnostic>>): void {
    var templates = new_module(m.path.clone())
    templates.crate = m.crate
    while td in &m.decls {
        if decl_is_template(td) { templates.decls.push(copy_template(td)) }
    }
    if templates.decls.size() == 0 { return }
    desugar_block_expr_module(&var templates)
    desugar_when_expr_module(&var templates)
    alpha_rename_module(&var templates)
    var param_table = build_param_table(m)
    var warnings = WarnState {
        warned: List.new<Span>(), reached: new_reached(), prune: false,
        clone_names: List.new<String>(), lints: List.new<Diagnostic>()
    }
    var discarded = List.new<Diagnostic>()
    var moves_out_of_borrows = MobCount { n: 0 }
    val bounds = TemplateBounds { clone_trait: clone_trait, copy_trait: copy_trait }
    while td in &templates.decls {
        check_template(td, &List.new<TypeParam>(), &bounds, &var discarded, &var param_table,
                       &var moves_out_of_borrows, smap, &var warnings)
    }
    while d in &warnings.lints {
        if d.code.as_str().equals("unauthorized_copy") { unsafe { lints.push(d.clone()) } }
    }
}

/// A copy whose bodies share no node with `td`: the desugaring passes rewrite
/// what they are given in place.
fun copy_template(td: &TopDecl): TopDecl {
    var out = td.clone()
    when (td.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            var names = List.new<String>()
            var repls = List.new<TypeRef>()
            var copied = List.new<Param>()
            while param in &params {
                val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *ty = clone_type_ref(&*param.ty) }
                copied.push(new_param(param.span, param.name.as_string(), ty))
            }
            val ret_copy: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *ret_copy = clone_type_ref(&*ret) }
            out.kind = TopDeclKind.Function(copied, ret_copy, subst_stmt_list(&body, &var names, &var repls),
                is_pub, is_unsafe, is_mutating, is_static)
        }
        ImplBlock(methods) => {
            var copied = List.new<TopDecl>()
            while method in &methods { copied.push(copy_template(method)) }
            out.kind = TopDeclKind.ImplBlock(copied)
        }
        _ => { }
    }
    return out
}

struct TemplateBounds {
    val clone_trait: Sym
    val copy_trait: Sym
}

fun decl_is_template(td: &TopDecl): bool {
    if td.linkage.is_imported() { return false }
    when (td.kind) {
        Function(_, _, _, _, _, _, _) => return td.generics.size() > 0
        ImplBlock(methods) => {
            if td.generics.size() > 0 { return true }
            while method in &methods {
                if method.generics.size() > 0 { return true }
            }
            return false
        }
        _ => return false
    }
}

/// `outer` is the enclosing impl block's parameters, bounds included.
fun check_template(td: &TopDecl, outer: &List<TypeParam>, bounds: &TemplateBounds, diags: Ptr<List<Diagnostic>>,
                   table: Ptr<List<ParamEntry>>, mob: Ptr<MobCount>, smap: Ptr<SourceMap>,
                   warn: Ptr<WarnState>): void {
    when (td.kind) {
        Function(params, _, body, _, _, _, _) => {
            var all = outer.clone()
            while tp in &td.generics { all.push(tp.clone()) }
            if all.size() == 0 { return }
            var owning = List.new<String>()
            var copyable = List.new<String>()
            while tp in &all {
                val is_copy = param_is_bounded_by(tp, bounds.copy_trait)
                if !is_copy { owning.push(tp.name.as_string()) }
                if is_copy || param_is_bounded_by(tp, bounds.clone_trait) { copyable.push(tp.name.as_string()) }
            }
            unsafe { (*warn).clone_names = copyable }
            var ctx = new_move_ctx(diags, owning, table, mob, td.name.as_string(), smap, warn)
            declare_owned_value_params(params, &var ctx)
            move_check_stmt_list(body, &var ctx)
        }
        ImplBlock(methods) => {
            while method in &methods {
                check_template(method, &td.generics, bounds, diags, table, mob, smap, warn)
            }
        }
        _ => { }
    }
}

/// Whether `tp` carries `trait_name` among its bounds, as written.
fun param_is_bounded_by(tp: &TypeParam, trait_name: Sym): bool {
    if trait_name.as_str().equals("") { return false }
    while b in &tp.bounds {
        when (b.kind) {
            Named(name, _) => { if name.id == trait_name.id { return true } }
            _ => { }
        }
    }
    return false
}
