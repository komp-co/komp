// Which by-value params the callee owns, for the move checker.
// CONSTRAINT: must agree with rc_value_params.kf, which asks the same of the
// same list for the refcount pass; a disagreement is a leak or a double free.

import alloc.list.*

import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.Param
import kf_core.ast.subst.mangle_tyref

// A by-value move-only parameter is owned by its callee, so the move checker
// must treat it as owned: only then is a later use after a consume cloned.
pub fun declare_owned_value_params(params: &List<Param>, ctx: &var MoveCtx): void {
    while p in &params {
        if !tref_is_borrow_sink(p.ty) {
            val tr = unsafe { *p.ty }
            if tr.mc_tref_is_move_only(ctx) { ctx.declare_owned(p.name) }
        }
    }
}

// Asked of a written type; the set holds mangled names (`List__String`).
fun TypeRef.mc_tref_is_move_only(ctx: &var MoveCtx): bool {
    when (self.kind) {
        Named(n, _args) => {
            if n.as_str().equals("Box") { return true }
            return names_contains(&ctx.move_only_names, mangle_tyref(self).as_str())
        }
        _ => { }
    }
    return false
}
