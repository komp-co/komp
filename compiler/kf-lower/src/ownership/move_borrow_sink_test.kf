import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.diagnostic.*
import kf_core.ast.*

fun ctx_with_one_sink(name: String, borrow_sink: bool): MoveCtx {
    val dp = fresh_diag_ptr()
    var sinks = List.new<bool>()
    sinks.push(borrow_sink)
    var muts = List.new<bool>()
    muts.push(false)
    var lends = List.new<bool>()
    lends.push(borrow_sink)
    var entries = List.new<ParamEntry>()
    entries.push(ParamEntry { name: name, sinks: sinks, muts: muts, lends: lends, is_extern: false })
    val table: Ptr<List<ParamEntry>> = unsafe { alloc<List<ParamEntry>>() }
    unsafe { *table = entries }
    val count: Ptr<MobCount> = unsafe { alloc<MobCount>() }
    unsafe { *count = MobCount { n: 0 } }
    val map: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *map = new_source_map() }
    val wp: Ptr<WarnState> = unsafe { alloc<WarnState>() }
    // No module: each test asserts one warning at a time.
    unsafe { *wp = WarnState {
        warned: List.new<Span>(), reached: new_reached(),
        prune: false, clone_names: List.new<String>(), lints: List.new<Diagnostic>()
    } }
    // Normally filled from core's `impl Drop for String`.
    var names = List.new<String>()
    names.push(String.from("String"))
    return new_move_ctx(dp, names, table, count, String.from("sink_test"), map, wp)
}

fun sink_test_call(callee: str): Expr {
    var args = List.new<Expr>()
    args.push(mk_str_var(String.from("x")))
    var call = new_expr(no_span(), ExprKind.Call(intern(callee), args))
    call.mangled_callee = intern(callee)
    call.ty = void_ty(no_span())
    return call
}

fun Expr.sink_test_first_arg_coerce(): uint8 {
    when (self.kind) {
        Call(_, args) => return args.at(0).coerce
        _ => return coerce_none()
    }
}

@test fun repeated_reference_sink_calls_do_not_clone(): void {
    var ctx = ctx_with_one_sink(String.from("borrow"), true)
    ctx.declare_owned(intern("x"))
    var first = sink_test_call("borrow")
    first.move_check_expr_value(&var ctx)
    var second = sink_test_call("borrow")
    second.move_check_expr_value(&var ctx)
    assert_eq(first.sink_test_first_arg_coerce() == coerce_clone(), false, "reference sink never auto-clones")
}

@test fun reference_sink_call_leaves_local_owned(): void {
    var ctx = ctx_with_one_sink(String.from("borrow"), true)
    ctx.declare_owned(intern("x"))
    var call = sink_test_call("borrow")
    call.move_check_expr_value(&var ctx)
    assert_eq(ctx.contains_owned(intern("x")), true, "reference sink leaves local owned")
}

@test fun repeated_value_sink_calls_clone_prior_consume(): void {
    var ctx = ctx_with_one_sink(String.from("consume"), false)
    ctx.declare_owned(intern("x"))
    var first = sink_test_call("consume")
    first.move_check_expr_value(&var ctx)
    var second = sink_test_call("consume")
    second.move_check_expr_value(&var ctx)
    assert_eq(first.sink_test_first_arg_coerce() == coerce_clone(), true, "repeated value sink clones prior consume")
}

// `Option.None` parses as a field access; a variant owns nothing.

fun mob_enum_ty(name: str): Type {
    return Type { kind: TypeKind.EnumTy(intern(name)), provenance: Provenance.Inferred(no_span()) }
}

fun mob_field_of(recv: Expr, field: str, ty: Type): Expr {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = recv }
    var e = new_expr(no_span(), ExprKind.FieldAccess(p, intern(field)))
    e.ty = ty
    return e
}

/// TypeCheck does not walk a constructor's receiver, so it stays poison.
fun mob_variant_ctor(enum_name: str, variant: str): Expr {
    val recv = new_expr(no_span(), ExprKind.Variable(intern(enum_name)))
    return mob_field_of(recv, variant, mob_enum_ty(enum_name))
}

/// A real field read: its receiver is typed.
fun mob_field_read(owner: str, field: str, enum_name: str): Expr {
    var recv = new_expr(no_span(), ExprKind.Variable(intern("holder")))
    recv.ty = Type { kind: TypeKind.Struct(intern(owner)), provenance: Provenance.Inferred(no_span()) }
    return mob_field_of(recv, field, mob_enum_ty(enum_name))
}

@test
fun a_constructed_variant_is_not_a_borrow_path(): void {
    assert_eq(is_variant_construction(&mob_variant_ctor("Option", "None")), true, "`Option.None` constructs, it does not read")
}

@test
fun a_field_read_of_an_enum_is_a_borrow_path(): void {
    assert_eq(is_variant_construction(&mob_field_read("Holder", "mode", "BuildMode")), false, "`holder.mode` reads out of `holder`")
}

// A generic enum types as its mangled instance, so the receiver name cannot
// decide.
@test
fun a_generic_enums_variant_is_recognised(): void {
    val recv = new_expr(no_span(), ExprKind.Variable(intern("Option")))
    val e = mob_field_of(recv, "None", mob_enum_ty("Option__SourceFile"))
    assert_eq(e.is_variant_construction(), true, "`Option.None` on an `Option<SourceFile>`")
}

@test
fun a_non_enum_field_access_is_untouched(): void {
    var recv = new_expr(no_span(), ExprKind.Variable(intern("holder")))
    recv.ty = Type { kind: TypeKind.Struct(intern("Holder")), provenance: Provenance.Inferred(no_span()) }
    val e = mob_field_of(recv, "name", Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) })
    assert_eq(e.is_variant_construction(), false, "a String field is not a variant")
}
