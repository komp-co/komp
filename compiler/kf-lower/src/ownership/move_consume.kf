// What a by-value position consumes.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

// Flags a move out of a borrow when: no explicit borrow (coerce != addr_of),
// the value is move-only, it is reached through a borrow path or borrowed
// local, and the parameter is a known move-sink. Unknown callees and
// borrow-sink params are left alone.
mutating fun Expr.check_consumed_arg(callee: String, idx: uint64, ctx: &var MoveCtx): void {
    if self.coerce == coerce_addr_of() { return }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return }
    val borrowed_read = is_borrow_path(unsafe { &*self }, ctx.move_only_names) ||
        expr_is_borrowed_local(unsafe { &*self }, ctx)
    if !borrowed_read { return }
    val pl = param_lookup(unsafe { &*ctx.ptable }, callee, idx)
    if !pl.found {
        // Lambda call methods are synthesized after the table is built; their
        // non-borrow arguments are by value.
        if callee.as_str().contains("Lambda_") {
            self.mark_auto_clone(callee, idx, ctx)
        }
        return
    }
    if pl.is_borrow_sink { return }    // Ptr/& param: a borrow, not a consume
    self.mark_auto_clone(callee, idx, ctx)
}

// Marks the node for an auto-clone and warns. A node already carrying a
// coercion only warns.
mutating fun Expr.mark_auto_clone(callee: String, idx: uint64, ctx: &var MoveCtx): void {
    if self.coerce == coerce_none() {
        self.coerce = coerce_clone()
    }
    // The copy happens either way; permission only picks the diagnostic.
    val w = ctx.warn
    if unsafe { self.ty.clone_is_authorized(&(*w).clone_names) } {
        warn_auto_clone(self.span, callee, idx, ctx)
        return
    }
    reject_auto_clone(self.span, self.ty, callee, idx, ctx)
}

// A copy of a type that never allowed copying: an error by default. Its level
// can be lowered without changing the program, since the copy is inserted
// regardless.
fun reject_auto_clone(span: Span, ty: &Type, callee: String, idx: uint64, ctx: &var MoveCtx): void {
    if span_is_in_a_dependency(span, ctx) { return }
    if !warning_has_a_subject(span, ctx) { return }
    val idx_s = "${idx}"
    val m = String.from("copying `") + ty.unauthorized_clone_name() +
        String.from("` here to fill arg ") + idx_s +
        String.from(" of `") + callee.clone() +
        String.from("`, but it does not implement `Clone`") + ty.clone_repair()
    ctx.record_lint(lint_at("unauthorized_copy", span, m))
}

fun Type.clone_repair(): String {
    when (self.kind) {
        Generic(n) => return "; borrow with `&`, or bound it: `${n.as_str()}: Clone`"
        _ => return String.from("; borrow with `&`, or write `@derive(Clone)` on it to allow the copy")
    }
}

// Arg `i` is declared param `i`; the receiver is never in `args`.
fun check_consumed_args_for(args: &var List<Expr>, callee: String, ctx: &var MoveCtx): void {
    while i in 0..args.size() {
        check_consumed_arg(args.at_mut(i), callee.clone(), i, ctx)
    }
}

// An enum constructor's payload is a move-sink like a struct literal field.
// It has no callee in the param table, so it needs this entry. Cloning, not
// marking the source moved, avoids stranding the struct's other fields.
pub fun check_consumed_ctor_payloads(args: &var List<Expr>, ctx: &var MoveCtx): void {
    while i in 0..args.size() {
        check_consumed_sink(args.at_mut(i), String.from("<enum-payload>"), ctx)
    }
}

/// `Option.Some(x)` filling an `Option<Ptr<T>>` or `Option<&T>` holds a
/// pointer to `x`, not `x`: the payload borrows.
fun Expr.payload_is_a_borrow(): bool {
    when (self.kind) {
        MethodCall(_recv, name, _args) => if name.as_str() != "Some" { return false }
        _ => return false
    }
    if self.type_args.size() != 1 { return false }
    return when (self.type_args.at(0).kind) {
        Reference(_, _) => true
        Named(n, _) => n.as_str() == "Ptr"
        _ => false
    }
}

// A struct literal field always takes ownership.
mutating fun Expr.check_consumed_field(ctx: &var MoveCtx): void {
    self.check_consumed_sink(String.from("<struct-field>"), ctx)
}

// Shared by every unconditional move-sink.
mutating fun Expr.check_consumed_sink(what: String, ctx: &var MoveCtx): void {
    if self.coerce == coerce_addr_of() { return }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return }
    val borrowed_read = is_borrow_path(unsafe { &*self }, ctx.move_only_names) ||
        expr_is_borrowed_local(unsafe { &*self }, ctx)
    if !borrowed_read { return }
    self.mark_auto_clone(what, 0, ctx)
}

// A return always takes ownership.
mutating fun Expr.check_consumed_return(ctx: &var MoveCtx): void {
    if self.coerce == coerce_addr_of() { return }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return }
    val borrowed_read = is_borrow_path(unsafe { &*self }, ctx.move_only_names) ||
        expr_is_borrowed_local(unsafe { &*self }, ctx)
    if !borrowed_read { return }
    self.mark_auto_clone(String.from("<return>"), 0, ctx)
}

// A bare move-only variable passed by value into a move-sink param is a
// consume. Gated like check_consumed_arg: a coerced argument, a borrow-sink
// param or an unknown callee does not consume.
pub mutating fun Expr.consume_bare_var_arg(callee: String, idx: uint64, ctx: &var MoveCtx): void {
    if self.coerce != coerce_none() { return }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return }
    val pl = param_lookup(unsafe { &*ctx.ptable }, callee, idx)
    if !pl.found { return }
    if pl.is_borrow_sink { return }
    // An extern "C" callee never drops a by-value argument.
    if pl.is_extern { return }
    self.mark_var_consumed(ctx)
}

// If already moved, clones the prior consume; else, if owned, marks it moved.
pub mutating fun Expr.mark_var_consumed(ctx: &var MoveCtx): void {
    when (self.kind) {
        Variable(name) => self.consume_var_node(name, ctx)
        _ => { }
    }
}

/// The consume decision for a named local.
///
/// CONSTRAINT: "clone every consume but the last" needs the last to run last,
/// and one statement does not order its argument evaluations. So a second
/// consume in the same statement copies too, and the original stays owned.
pub mutating fun Expr.consume_var_node(name: Sym, ctx: &var MoveCtx): void {
    if ctx.ctx_consumed_here(name) {
        ctx.clone_pending_consume(name)
        if ctx_clone_node(unsafe { self as Ptr<Expr> }) {
            warn_use_after_move(self.span, name.as_string(), ctx)
        }
        // Every consume here copies, so the original is still owned; a later
        // statement's consume is its first real move.
        ctx.unmark_moved(name)
        ctx.declare_owned(name)
        return
    }
    if ctx.contains_moved(name) {
        mark_uam_clone(name, self, true, ctx)
        return
    }
    if ctx.contains_owned(name) {
        ctx.mark_moved(name, self.span, unsafe { self as Ptr<Expr> })
    }
}

/// A no-op when nothing is pending or it already copies.
mutating fun MoveCtx.clone_pending_consume(name: Sym): void {
    val node: Ptr<Expr> = self.pending_consume(name)
    if ctx_clone_node(node) { }
}

// Runs after the borrow walk of the same args: `foo(x, x.len())` reads x
// before the callee runs. Arg `i` is declared param `i`.
pub fun move_check_args_consume(args: &var List<Expr>, callee: String, ctx: &var MoveCtx): void {
    while i in 0..args.size() {
        consume_bare_var_arg(args.at_mut(i), callee.clone(), i, ctx)
    }
}

// Records `implicit_copy`, naming the enclosing function, callee and argument
// so the author can borrow with `&` instead.
fun warn_auto_clone(span: Span, callee: String, idx: uint64, ctx: &var MoveCtx): void {
    if span_is_in_a_dependency(span, ctx) { return }
    if !warning_has_a_subject(span, ctx) { return }
    val idx_s = "${idx}"
    val m = String.from("auto-inserted a copy in `") + ctx.cur_fn.clone() +
        String.from("` (arg ") + idx_s +
        String.from(" of `") + callee.clone() +
        String.from("`); borrow with `&` to avoid the copy")
    ctx.record_lint(lint_at("implicit_copy", span, m))
}

// Collected on the module-scoped WarnState so the driver resolves each
// level; `ctx.diags` is discarded.
mutating fun MoveCtx.record_lint(d: Diagnostic): void {
    val w = self.warn
    unsafe { (*w).lints.push(d) }
}

// A separate lint from `implicit_copy`: an earlier move was undone.
fun warn_use_after_move(span: Span, name: String, ctx: &var MoveCtx): void {
    if span_is_in_a_dependency(span, ctx) { return }
    if !warning_has_a_subject(span, ctx) { return }
    val m = String.from("cloned `") + name.clone() +
        String.from("` to keep it live after a move in `") + ctx.cur_fn.clone() +
        String.from("`; restructure to move once and avoid the copy")
    ctx.record_lint(lint_at("copy_after_move", span, m))
}

// A use of an already-moved name: clones the pending consume, warns, and
// updates state. `is_consume` is whether this use moves the value.
// Over-cloning only adds a copy; under-cloning is a double free.
fun mark_uam_clone(name: Sym, e: &var Expr, is_consume: bool, ctx: &var MoveCtx): void {
    val node: Ptr<Expr> = ctx.pending_consume(name)
    val raw: uint64 = unsafe { node as uint64 }
    if raw != 0 {
        if unsafe { node.coerce } == coerce_none() {
            unsafe { node.coerce = coerce_clone() }
            warn_use_after_move(e.span, name.as_string(), ctx)
        }
    }
    ctx.unmark_moved(name)
    if is_consume {
        // This use is now the pending consume.
        ctx.mark_moved(name, e.span, unsafe { e as Ptr<Expr> })
    } else {
        // A borrow leaves the original owned.
        ctx.declare_owned(name)
    }
}
