import alloc.list.*

import kf_core.ast.*

// Types whose values must be uniquely owned: a struct with a direct `Box`
// field, a type with a user `Drop` impl, and, transitively, anything
// containing one. Computed to a fixpoint. Over-approximating only costs extra
// borrows; under-approximating causes phantom drops.
pub mutating fun Module.compute_move_only_names(list_name: Sym): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            Struct(fields, _p) => {
                if struct_has_box_field(fields) { out.push(td.name.as_string()) }
            }
            // A user `Drop` impl makes a type move-only. Post-mono this is an
            // ImplBlock keyed on the mangled name.
            ImplBlock(methods) => {
                if impl_has_drop_method(methods) { out.push(td.name.as_string()) }
            }
            _ => { }
        }
    }
    var changed = true
    while changed {
        changed = false
        while td in &self.decls {
            val nm = td.name.as_string()
            if !names_contains(&out, nm.as_str()) {
                var hit = false
                when (td.kind) {
                    Struct(fields, _p) => { hit = fields_infect(fields, &out, list_name) }
                    EnumDecl(variants, _p) => { hit = variants_infect(variants, &out, list_name) }
                    _ => { }
                }
                if hit {
                    out.push(nm)
                    changed = true
                }
            }
        }
    }
    return out
}

fun fields_infect(fields: List<Field>, names: &List<String>, list_name: Sym): bool {
    while f in &fields {
        val tr = unsafe { *f.ty }
        if tr.tref_infects(names, list_name) { return true }
    }
    return false
}

fun variants_infect(variants: List<Variant>, names: &List<String>, list_name: Sym): bool {
    while v in &variants {
        while tr in &v.payloads {
            if tr.tref_infects(names, list_name) { return true }
        }
    }
    return false
}

// Box, the lang list, an already-infected name, or a generic with an
// infecting argument (`Option<String>`), or an array of any of these. String
// qualifies through its own `impl Drop`. `&T`, `Ptr` and function types never
// own.
fun TypeRef.tref_infects(names: &List<String>, list_name: Sym): bool {
    when (self.kind) {
        Named(n, args) => {
            val s = n.as_str()
            if s.equals("Box") { return true }
            if is_lang_name(s, list_name) { return true }
            if s.equals("Ptr") { return false }
            if names_contains(names, n.as_str()) { return true }
            while a in &args {
                if a.tref_infects(names, list_name) { return true }
            }
            return false
        }
        Array(element, _length) => return element.tref_infects(names, list_name)
        _ => return false
    }
}

fun impl_has_drop_method(methods: List<TopDecl>): bool {
    while m in &methods {
        if m.name.as_str() == "drop" { return true }
    }
    return false
}

fun struct_has_box_field(fields: List<Field>): bool {
    while f in &fields {
        val tr = unsafe { *f.ty }
        when (tr.kind) {
            Named(n, _a) => { if n.as_str().equals("Box") { return true } }
            _ => { }
        }
    }
    return false
}

pub fun names_contains(names: &List<String>, target: str): bool {
    while n in &names {
        val eq = n.as_str().equals(target)
        if eq { return true }
    }
    return false
}
