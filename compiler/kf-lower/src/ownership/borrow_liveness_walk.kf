// What borrow_liveness asks of a subtree: does it return, move, mutate or
// mention a name. The four families share one shape and must all cover every
// arm; a missing `stmt_mentions` arm silently ends a live range early.
//
// CONSTRAINT: runs after alpha_rename, so a plain name comparison is exact.

import alloc.list.*

import kf_core.ast.*

fun Stmt.stmt_returns(name: str): bool {
    when (self.kind) {
        Return(maybe) => {
            when (maybe) {
                Some(e) => {
                    // Only the borrow itself escapes, not a value computed
                    // from it.
                    val returned = unsafe { *e }
                    if !returned.ty.bl_ty_is_borrow() { return false }
                    return expr_borrow_root(&returned).as_str() == name
                }
                None => return false
            }
        }
        If(_c, then_body, else_body) => {
            if list_returns(&then_body, name) { return true }
            return list_returns(&else_body, name)
        }
        While(_c, body) => return list_returns(&body, name)
        ForEach(_b, _s, body) => return list_returns(&body, name)
        When(_s, arms) => {
            while arm in &arms {
                if list_returns(arm.body, name) { return true }
            }
            return false
        }
        Switch(_s, arms) => {
            while arm in &arms {
                if list_returns(arm.body, name) { return true }
            }
            return false
        }
        _ => return false
    }
}

fun list_returns(stmts: &List<Stmt>, name: str): bool {
    while stmt in &stmts {
        if (stmt).stmt_returns(name) { return true }
    }
    return false
}

/// Hands `origin` to a consuming parameter or returns it. A borrowing
/// parameter, or an argument already marked for auto-clone, does not count.
fun Stmt.stmt_moves(origin: str, ptable: Ptr<List<ParamEntry>>): bool {
    when (self.kind) {
        Expression(e) => return expr_moves(unsafe { &*e }, origin, ptable)
        LetVal(_n, _t, init) => return init_moves(init.view(), origin, ptable)
        LetVar(_n, _t, init) => return init_moves(init.view(), origin, ptable)
        Assign(_n, rhs) => return expr_moves(unsafe { &*rhs }, origin, ptable)
        Return(maybe) => {
            when (maybe) {
                Some(e) => return expr_moves(unsafe { &*e }, origin, ptable)
                None => return false
            }
        }
        _ => return false
    }
}

fun init_moves(init_opt: Ptr<Expr>?, origin: str, ptable: Ptr<List<ParamEntry>>): bool {
    val init = init_opt ?: return false
    return expr_moves(unsafe { &*init }, origin, ptable)
}

fun expr_moves(e: &Expr, origin: str, ptable: Ptr<List<ParamEntry>>): bool {
    when (e.kind) {
        Call(name, args) => return args_move(&args, origin, name.as_string(), 0, ptable)
        MethodCall(receiver, _m, args) => {
            if expr_moves(unsafe { &*receiver }, origin, ptable) { return true }
            // ParamEntry omits `self`, so arg i is param i.
            return args_move(&args, origin, e.mangled_callee.as_string(), 0, ptable)
        }
        Binary(l, _op, r) => {
            if expr_moves(unsafe { &*l }, origin, ptable) { return true }
            return expr_moves(unsafe { &*r }, origin, ptable)
        }
        Cast(inner, _t) => return expr_moves(unsafe { &*inner }, origin, ptable)
        Retain(inner) => return expr_moves(unsafe { &*inner }, origin, ptable)
        _ => return false
    }
}

fun args_move(args: &List<Expr>, origin: str, callee: String, base: uint64, ptable: Ptr<List<ParamEntry>>): bool {
    while i in 0..args.size() {
        val a = args.at(i)
        if a.arg_is_moved_origin(origin, callee.clone(), base + i, ptable) { return true }
        if expr_moves(a, origin, ptable) { return true }
    }
    return false
}

fun Expr.arg_is_moved_origin(origin: str, callee: String, idx: uint64, ptable: Ptr<List<ParamEntry>>): bool {
    when (self.kind) {
        Variable(n) => {
            if n.as_str() != origin { return false }
        }
        _ => return false
    }
    if self.coerce != coerce_none() { return false }
    val pl = param_lookup(unsafe { &*ptable }, callee, idx)
    if !pl.found { return false }
    return !pl.is_borrow_sink
}

fun Stmt.stmt_disturbs(origin: str, muts: &List<MutatingMethod>): bool {
    when (self.kind) {
        Assign(name, _rhs) => return name.as_str() == origin
        AssignTo(place, _rhs) => {
            val root = expr_borrow_root(unsafe { &*place })
            return root.as_str() == origin
        }
        Expression(e) => return expr_mutates(unsafe { &*e }, origin, muts)
        LetVal(_n, _t, init) => return init_mutates(init.view(), origin, muts)
        LetVar(_n, _t, init) => return init_mutates(init.view(), origin, muts)
        _ => return false
    }
}

fun init_mutates(init_opt: Ptr<Expr>?, origin: str, muts: &List<MutatingMethod>): bool {
    val init = init_opt ?: return false
    return expr_mutates(unsafe { &*init }, origin, muts)
}

/// Only a mutating method called on `origin` itself; calls inside
/// arguments are caught when the walk reaches them.
fun Expr.expr_mutates(origin: str, muts: &List<MutatingMethod>): bool {
    when (self.kind) {
        MethodCall(receiver, method, args) => {
            val recv = unsafe { *receiver }
            if expr_borrow_root(&recv).as_str() == origin {
                if recv.ty.is_mutating_method(method.as_str(), muts) { return true }
            }
            if recv.expr_mutates(origin, muts) { return true }
            return list_mutates(&args, origin, muts)
        }
        Call(_name, args) => return list_mutates(&args, origin, muts)
        Binary(l, _op, r) => {
            if expr_mutates(unsafe { &*l }, origin, muts) { return true }
            return expr_mutates(unsafe { &*r }, origin, muts)
        }
        Unary(_op, inner) => return expr_mutates(unsafe { &*inner }, origin, muts)
        Deref(inner) => return expr_mutates(unsafe { &*inner }, origin, muts)
        FieldAccess(base, _f) => return expr_mutates(unsafe { &*base }, origin, muts)
        Cast(inner, _t) => return expr_mutates(unsafe { &*inner }, origin, muts)
        DynCoerce(inner, _v) => return expr_mutates(unsafe { &*inner }, origin, muts)
        Retain(inner) => return expr_mutates(unsafe { &*inner }, origin, muts)
        IfExpr(c, t, e2) => {
            if expr_mutates(unsafe { &*c }, origin, muts) { return true }
            if expr_mutates(unsafe { &*t }, origin, muts) { return true }
            return expr_mutates(unsafe { &*e2 }, origin, muts)
        }
        StructLit(_n, finits) => {
            while finit in &finits {
                if expr_mutates(unsafe { &*finit.value }, origin, muts) { return true }
            }
            return false
        }
        _ => return false
    }
}

fun list_mutates(args: &List<Expr>, origin: str, muts: &List<MutatingMethod>): bool {
    while arg in &args {
        if arg.expr_mutates(origin, muts) { return true }
    }
    return false
}

fun Stmt.stmt_mentions(name: str): bool {
    when (self.kind) {
        LetVal(_n, _t, init) => return init_mentions(init.view(), name)
        LetVar(_n, _t, init) => return init_mentions(init.view(), name)
        Assign(n, rhs) => {
            if n.as_str() == name { return true }
            return expr_mentions(unsafe { &*rhs }, name)
        }
        AssignTo(place, rhs) => {
            if expr_mentions(unsafe { &*place }, name) { return true }
            return expr_mentions(unsafe { &*rhs }, name)
        }
        Return(maybe) => {
            when (maybe) {
                Some(e) => return expr_mentions(unsafe { &*e }, name)
                None => return false
            }
        }
        Expression(e) => return expr_mentions(unsafe { &*e }, name)
        If(cond, then_body, else_body) => {
            if expr_mentions(unsafe { &*cond }, name) { return true }
            if list_mentions(&then_body, name) { return true }
            return list_mentions(&else_body, name)
        }
        While(cond, body) => {
            if expr_mentions(unsafe { &*cond }, name) { return true }
            return list_mentions(&body, name)
        }
        ForEach(_b, subject, body) => {
            if expr_mentions(unsafe { &*subject }, name) { return true }
            return list_mentions(&body, name)
        }
        When(subject, arms) => {
            if expr_mentions(unsafe { &*subject }, name) { return true }
            return arms_mention(&arms, name)
        }
        Switch(subject, arms) => {
            if expr_mentions(unsafe { &*subject }, name) { return true }
            return switch_arms_mention(&arms, name)
        }
        Drop(n) => return n.as_str() == name
        Release(n) => return n.as_str() == name
        Break => return false
        Continue => return false
        Poison => return false
    }
}

fun init_mentions(init_opt: Ptr<Expr>?, name: str): bool {
    val init = init_opt ?: return false
    return expr_mentions(unsafe { &*init }, name)
}

fun list_mentions(stmts: &List<Stmt>, name: str): bool {
    while stmt in &stmts {
        if (stmt).stmt_mentions(name) { return true }
    }
    return false
}

fun arms_mention(arms: &List<Arm>, name: str): bool {
    while arm in &arms {
        if list_mentions(&arm.body, name) { return true }
    }
    return false
}

fun switch_arms_mention(arms: &List<SwitchArm>, name: str): bool {
    while arm in &arms {
        if list_mentions(&arm.body, name) { return true }
    }
    return false
}

fun Expr.expr_mentions(name: str): bool {
    when (self.kind) {
        Variable(n) => return n.as_str() == name
        Release(n) => return n.as_str() == name
        MethodCall(receiver, _m, args) => {
            if expr_mentions(unsafe { &*receiver }, name) { return true }
            return exprs_mention(&args, name)
        }
        Call(_n, args) => return exprs_mention(&args, name)
        Binary(l, _op, r) => {
            if expr_mentions(unsafe { &*l }, name) { return true }
            return expr_mentions(unsafe { &*r }, name)
        }
        Unary(_op, inner) => return expr_mentions(unsafe { &*inner }, name)
        Deref(inner) => return expr_mentions(unsafe { &*inner }, name)
        FieldAccess(base, _f) => return expr_mentions(unsafe { &*base }, name)
        Cast(inner, _t) => return expr_mentions(unsafe { &*inner }, name)
        DynCoerce(inner, _v) => return expr_mentions(unsafe { &*inner }, name)
        Retain(inner) => return expr_mentions(unsafe { &*inner }, name)
        IfExpr(c, t, e2) => {
            if expr_mentions(unsafe { &*c }, name) { return true }
            if expr_mentions(unsafe { &*t }, name) { return true }
            return expr_mentions(unsafe { &*e2 }, name)
        }
        StructLit(_n, finits) => {
            while finit in &finits {
                if expr_mentions(unsafe { &*finit.value }, name) { return true }
            }
            return false
        }
        WhenExpr(subject, arms) => {
            if expr_mentions(unsafe { &*subject }, name) { return true }
            return arms_mention(&arms, name)
        }
        Lambda(_p, body) => return stmts_mention(&body, name)
        Block(stmts) => {
            while stmt in &stmts {
                if (stmt).stmt_mentions(name) { return true }
            }
            return false
        }
        LitInt(_v) => return false
        LitFloat(_v) => return false
        LitChar(_v) => return false
        LitStr(_v) => return false
        LitBool(_v) => return false
        Poison => return false
    }
}

fun stmts_mention(stmts: &List<Stmt>, name: str): bool {
    while stmt in &stmts {
        if (stmt).stmt_mentions(name) { return true }
    }
    return false
}

fun exprs_mention(args: &List<Expr>, name: str): bool {
    while arg in &args {
        if arg.expr_mentions(name) { return true }
    }
    return false
}
