// Whether the author allowed a type to be copied: `impl Clone`, written or
// derived. The move checker inserts deep copies either way; this decides
// only which diagnostic is raised.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.types.Type
import kf_core.ast.types.type_identity_display
import kf_core.ast.declaration.TopDecl

/// Every type with a `clone`, by mangled name: `impl Clone`, `@derive(Clone)`
/// and an inherent `fun clone()` all count.
pub fun Module.compute_clone_names(): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            ImplBlock(methods) => {
                if impl_has_clone_method(&methods) {
                    val nm = td.name.as_string()
                    if !names_contains(&out, nm.as_str()) { out.push(nm) }
                }
            }
            _ => { }
        }
    }
    return out
}

fun impl_has_clone_method(methods: &List<TopDecl>): bool {
    while method in &methods {
        if method.name.as_str().equals("clone") { return true }
    }
    return false
}

/// `Box<T>` answers for its pointee. Anything not a struct, enum or box is
/// copyable.
pub fun Type.clone_is_authorized(clone_names: &List<String>): bool {
    when (self.kind) {
        BoxOf(inner) => return clone_is_authorized(unsafe { &*inner }, clone_names)
        Struct(n) => return names_contains(clone_names, type_identity_display(n).as_str())
        EnumTy(n) => return names_contains(clone_names, type_identity_display(n).as_str())
        Generic(n) => return names_contains(clone_names, n.as_str())
        _ => return true
    }
}

/// Names the pointee of a `Box`, which is where `@derive(Clone)` goes.
pub fun Type.unauthorized_clone_name(): String {
    when (self.kind) {
        BoxOf(inner) => return unauthorized_clone_name(unsafe { &*inner })
        _ => return without_crate_prefix(self.clone().mangle_frag())
    }
}

/// `kf_core__Location` becomes `Location`; `List__TopDecl` is left alone. A
/// crate name is lower-case and a type name is not.
fun without_crate_prefix(name: String): String {
    val s = name.as_str()
    val at = s.index_of("__") ?: return name
    if at == 0 { return name }
    if !is_lower_snake(s, at) { return name }
    return String.from(s.substring(at + 2, s.byte_len()).as_str())
}

fun is_lower_snake(s: str, end: uint64): bool {
    var i = 0
    while i < end {
        val b = s.byte_at(i)
        val lower = b >= 97 && b <= 122
        val digit = b >= 48 && b <= 57
        if !lower && !digit && b != 95 { return false }
        i = i + 1
    }
    return true
}
