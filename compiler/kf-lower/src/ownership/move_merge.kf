import alloc.list.*

import kf_core.span.*
import kf_core.ast.Pattern
import kf_core.ast.Sym
import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*

mutating fun MoveCtx.snapshot_moved(): List<MovedEntry> {
    var snap = List.new<MovedEntry>()
    while e in &self.moved {
        snap.push(e)
    }
    return snap
}

mutating fun MoveCtx.restore_moved(snap: List<MovedEntry>): void {
    var fresh = List.new<MovedEntry>()
    while e in &snap {
        fresh.push(e)
    }
    self.moved = fresh
}

fun moved_contains(set: List<MovedEntry>, name: Sym): bool {
    while e in &set {
        val eq = e.name.id == name.id
        if eq { return true }
    }
    return false
}

/// The last statement is a `return`, so moves inside do not reach the
/// fall-through path.
fun stmt_list_diverges(body: &List<Stmt>): bool {
    if body.size() == 0 { return false }
    val last = *body.at(body.size() - 1)
    val lk = last.kind
    return when (lk) {
        Return(_) => true
        _ => false
    }
}

fun check_branch_divergence(then_set: List<MovedEntry>, else_set: List<MovedEntry>, if_span: Span, ctx: &var MoveCtx): void {
    while e in &distinct_moved(&then_set) {
        val in_else = moved_contains(else_set, e.name)
        if !in_else {
            emit_branch_divergence(e.name.as_string(), e.site, if_span, ctx)
        }
    }
    while e in &distinct_moved(&else_set) {
        val in_then = moved_contains(then_set, e.name)
        if !in_then {
            emit_branch_divergence(e.name.as_string(), e.site, if_span, ctx)
        }
    }
}

fun emit_branch_divergence(name: String, branch_site: Span, if_span: Span, ctx: &var MoveCtx): void {
    val msg = "`${name}` moved in some branches but not others"
    var d = error_at(if_span, msg)
    d.secondary.push(new_label(branch_site, String.from("moved here in one branch")))
    ctx.ctx_emit(d)
}

mutating fun MoveCtx.apply_owned_intersection_div(owned_before: List<Sym>, moved_then: List<MovedEntry>, moved_else: List<MovedEntry>, then_div: bool, else_div: bool): void {
    var fresh = List.new<Sym>()
    while n in &owned_before {
        var in_then: bool = false
        if !then_div { in_then = moved_contains(moved_then, n) }
        var in_else: bool = false
        if !else_div { in_else = moved_contains(moved_else, n) }
        val moved_anywhere = in_then || in_else
        if !moved_anywhere {
            fresh.push(n)
        }
    }
    self.owned = fresh
}

mutating fun MoveCtx.snapshot_owned(): List<Sym> {
    var snap = List.new<Sym>()
    while item in &self.owned {
        snap.push(item)
    }
    return snap
}

mutating fun MoveCtx.restore_owned(snap: List<Sym>): void {
    var fresh = List.new<Sym>()
    while item in &snap {
        fresh.push(item)
    }
    self.owned = fresh
}

mutating fun MoveCtx.snapshot_borrowed(): List<Sym> {
    var snap = List.new<Sym>()
    while item in &self.borrowed {
        snap.push(item)
    }
    return snap
}

mutating fun MoveCtx.restore_borrowed(snap: List<Sym>): void {
    var fresh = List.new<Sym>()
    while item in &snap {
        fresh.push(item)
    }
    self.borrowed = fresh
}

fun moved_has_consume(set: &List<MovedEntry>, name: Sym, node: Ptr<Expr>): bool {
    val raw: uint64 = unsafe { node as uint64 }
    while e in &set {
        if e.name.id == name.id && unsafe { e.last_consume as uint64 } == raw { return true }
    }
    return false
}

/// The names moved on either side. A name moved on both keeps each side's
/// consume: only one side runs, so neither copies unless a later use reads
/// the name, which then copies both.
fun union_moved_consumes(a: List<MovedEntry>, b: List<MovedEntry>): List<MovedEntry> {
    var fresh = List.new<MovedEntry>()
    while item in &a {
        fresh.push(item)
    }
    while e in &b {
        if !moved_has_consume(&fresh, e.name, e.last_consume) { fresh.push(e) }
    }
    return fresh
}

/// The first entry of each moved name, so a name moved on several paths is
/// reported once.
fun distinct_moved(set: &List<MovedEntry>): List<MovedEntry> {
    var out = List.new<MovedEntry>()
    while e in &set {
        if !moved_contains(out, e.name) { out.push(e) }
    }
    return out
}

fun declare_pattern_binds(pp: Ptr<Pattern>, ctx: &var MoveCtx): void {
    val p = unsafe { *pp }
    when (p.kind) {
        Identifier(name) => {
            ctx.declare_owned(name)
        }
        Variant(_, payloads) => {
            while sub in &payloads {
                val sp: Ptr<Pattern> = unsafe { alloc<Pattern>() }
                unsafe { *sp = sub }
                declare_pattern_binds(sp, ctx)
            }
        }
        StructPat(_, names, _) => {
            while item in &names {
                ctx.declare_owned(item)
            }
        }
        // Alternatives bind nothing.
        Or(_) => return
        Range(_, _, _) => return
        Wildcard => return
        LitInt(_) => return
        LitStr(_) => return
        LitBool(_) => return
        LitChar(_) => return
        Poison => return
    }
}

/// As `declare_pattern_binds`, but borrowed: a binder over a by-value
/// move-only subject is a view into it.
fun declare_pattern_binds_borrowed(pp: Ptr<Pattern>, ctx: &var MoveCtx): void {
    val p = unsafe { *pp }
    when (p.kind) {
        Identifier(name) => {
            ctx.declare_borrowed(name)
        }
        Variant(_, payloads) => {
            while sub in &payloads {
                val sp: Ptr<Pattern> = unsafe { alloc<Pattern>() }
                unsafe { *sp = sub }
                declare_pattern_binds_borrowed(sp, ctx)
            }
        }
        StructPat(_, names, _) => {
            while item in &names {
                ctx.declare_borrowed(item)
            }
        }
        // Alternatives bind nothing.
        Or(_) => return
        Range(_, _, _) => return
        Wildcard => return
        LitInt(_) => return
        LitStr(_) => return
        LitBool(_) => return
        LitChar(_) => return
        Poison => return
    }
}

fun emit_loop_move_leak(name: String, site: Span, ctx: &var MoveCtx): void {
    val msg = "`${name}` moved inside loop body would re-move on next iteration"
    val d = error_at(site, msg)
    ctx.ctx_emit(d)
}
