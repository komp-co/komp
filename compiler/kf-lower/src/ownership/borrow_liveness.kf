// A borrow may not outlive its origin. While a local bound to a borrow of
// another local is live, the origin may not be disturbed:
//
//     var out = String.from("a")
//     val view = out.as_str()      // view borrows out
//     out.append("b")              // may reallocate; view now dangles
//     use(view)
//
// CONSTRAINT: runs after alpha_rename, so a plain name comparison is exact.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*

/// Keyed by the mangled `Type_method`: a name alone would conflate a mutating
/// `append` on one type with a read-only one on another.
pub struct MutatingMethod {
    pub val mangled: String
}

/// What every check in a module consults.
struct LivenessFacts {
    val muts: List<MutatingMethod>
    /// View types, whose values borrow as `&T` does.
    val views: List<String>
}

pub fun Module.borrow_liveness_module(diags: &var Diagnostics): void {
    var muts = List.new<MutatingMethod>()
    self.collect_mutating_methods(&var muts)
    val facts = LivenessFacts { muts: muts, views: self.view_type_names() }
    // Which parameters consume their argument. By pointer: it holds move-only
    // lists.
    var param_table = self.build_param_table()
    while decl in &self.decls {
        bl_check_top_decl(decl, &facts, &var param_table, diags)
    }
}

fun Module.collect_mutating_methods(out: &var List<MutatingMethod>): void {
    while td in &self.decls {
        when (td.kind) {
            ImplBlock(methods) => collect_mutating_in_impl(td.name.as_str(), &methods, out)
            TraitImpl(_tref, methods) => collect_mutating_in_impl(td.name.as_str(), &methods, out)
            _ => { }
        }
    }
}

fun collect_mutating_in_impl(owner: str, methods: &List<TopDecl>, out: &var List<MutatingMethod>): void {
    while method in &methods {
        when (method.kind) {
            Function(_p, _r, _b, _pub, _u, is_mutating, _st) => {
                if is_mutating {
                    var mangled = String.from(owner)
                    mangled.append("_")
                    mangled.append(method.name.as_str())
                    out.push(MutatingMethod { mangled: mangled })
                }
            }
            _ => { }
        }
    }
}

fun bl_check_top_decl(td: &TopDecl, facts: &LivenessFacts, ptable: Ptr<List<ParamEntry>>, diags: &var Diagnostics): void {
    when (td.kind) {
        Function(params, _r, body, _pub, _u, _mut, _st) => {
            var names = List.new<String>()
            names.push(String.from("self"))
            while param in &params {
                names.push(param.name.as_string())
            }
            check_stmt_list(&body, facts, ptable, &names, diags)
        }
        ImplBlock(methods) => {
            while method in &methods {
                bl_check_top_decl(method, facts, ptable, diags)
            }
        }
        TraitImpl(_tref, methods) => {
            while method in &methods {
                bl_check_top_decl(method, facts, ptable, diags)
            }
        }
        _ => { }
    }
}

/// A borrow is checked within the block that declared it.
fun check_stmt_list(stmts: &List<Stmt>, facts: &LivenessFacts, ptable: Ptr<List<ParamEntry>>, params: &List<String>, diags: &var Diagnostics): void {
    while i in 0..stmts.size() {
        (stmts.at(i)).check_nested_blocks(facts, ptable, params, diags)
        val origin = owning_origin(stmts, i, (stmts.at(i)).borrow_binding_origin(&facts.views), &facts.views)
        if origin.as_str() != "" {
            val bound = (stmts.at(i)).binding_name()
            if !name_in(params, origin.as_str()) {
                report_returned_borrow_of_local(stmts, i, bound.as_str(), origin.as_str(), &facts.views, diags)
            }
            val last = last_use_index(stmts, bound.as_str(), i)
            var j = i + 1
            while j <= last {
                if (stmts.at(j)).stmt_disturbs(origin.as_str(), &facts.muts) {
                    (stmts.at(j)).emit_outlives_error(bound.as_str(), origin.as_str(), diags)
                } else if (stmts.at(j)).stmt_moves(origin.as_str(), ptable) {
                    (stmts.at(j)).emit_moved_error(bound.as_str(), origin.as_str(), diags)
                }
                j = j + 1
            }
        }
    }
}

/// Through bindings that are borrows themselves to the one that owns: with
/// `val a = owned.as_str()` then `val b = a`, `b` keeps `owned` in place.
fun owning_origin(stmts: &List<Stmt>, at: uint64, origin: String, views: &List<String>): String {
    var current = origin
    var j = at
    while j > 0 {
        j = j - 1
        if (stmts.at(j)).binding_name().as_str() == current.as_str() {
            var further = (stmts.at(j)).borrow_binding_origin(views)
            if further.as_str() == "" && (stmts.at(j)).declares_borrow_without_value(views) {
                further = assigned_borrow_origin(stmts, j + 1, current.as_str(), views)
                // Every value assigned borrows something that outlives the function.
                if further.as_str() == "" { return further }
            }
            if further.as_str() == "" { return current }
            current = further
        }
    }
    return current
}

fun Stmt.emit_outlives_error(borrow: str, origin: str, diags: &var Diagnostics): void {
    val message = "`${origin}` cannot be changed here: `${borrow}` borrows it and is still used afterwards"
    diags.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
}

/// `val view = text.as_str()` then `return view`: TypeCheck catches the
/// direct form; here the origin is known, so the bound form is caught too.
fun report_returned_borrow_of_local(stmts: &List<Stmt>, from: uint64, bound: str, origin: str, views: &List<String>,
    diags: &var Diagnostics): void {
    var i = from + 1
    while i < stmts.size() {
        if (stmts.at(i)).stmt_returns(bound, views) {
            val message = "cannot return `${bound}`: it borrows `${origin}`, which this function owns and drops at the return"
            diags.emit(new_diagnostic(Severity.Error, new_label(stmts.at(i).span, message)))
            return
        }
        i = i + 1
    }
}

fun name_in(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

fun Stmt.emit_moved_error(borrow: str, origin: str, diags: &var Diagnostics): void {
    val message = "`${origin}` cannot be moved here: `${borrow}` borrows it and is still used afterwards"
    diags.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
}

/// The local a `val`/`var` initializer borrows from, or "".
fun Stmt.borrow_binding_origin(views: &List<String>): String {
    when (self.kind) {
        LetVal(_n, _t, init) => return init_borrow_origin(init.view(), views)
        LetVar(_n, _t, init) => return init_borrow_origin(init.view(), views)
        _ => return ""
    }
}

fun init_borrow_origin(init_opt: Ptr<Expr>?, views: &List<String>): String {
    val init = init_opt ?: return ""
    val e = unsafe { *init }
    if !e.ty.bl_ty_is_borrow(views) { return "" }
    return e.borrow_root_in(views)
}

fun Stmt.binding_name(): String {
    when (self.kind) {
        LetVal(n, _t, _i) => return n.as_string()
        LetVar(n, _t, _i) => return n.as_string()
        _ => return ""
    }
}

fun Type.bl_ty_is_borrow(views: &List<String>): bool {
    when (self.kind) {
        StrTy => return true
        RefTo(_, _) => return true
        Struct(name) => return names_view(views, name.as_str())
        EnumTy(name) => return names_view(views, name.as_str())
        _ => return false
    }
}

/// The last statement mentioning `name`, or `from` when nothing does.
fun last_use_index(stmts: &List<Stmt>, name: str, from: uint64): uint64 {
    var last = from
    var i = from + 1
    while i < stmts.size() {
        if (stmts.at(i)).stmt_mentions(name) { last = i }
        i = i + 1
    }
    return last
}

fun Type.is_mutating_method(method: str, muts: &List<MutatingMethod>): bool {
    val base = self.bl_ty_base_name()
    if base.as_str() == "" { return false }
    var wanted = base
    wanted.append("_")
    wanted.append(method)
    while mut in &muts {
        if mut.mangled.as_str() == wanted.as_str() { return true }
    }
    return false
}

/// The nominal name a method dispatches on, through any borrow.
fun Type.bl_ty_base_name(): String {
    when (self.kind) {
        Struct(name) => return name.as_string()
        EnumTy(name) => return name.as_string()
        RefTo(_m, inner) => return bl_ty_base_name(unsafe { &*inner })
        PtrTo(inner) => return bl_ty_base_name(unsafe { &*inner })
        BoxOf(inner) => return bl_ty_base_name(unsafe { &*inner })
        StrTy => return String.from("str")
        _ => return ""
    }
}

fun Stmt.check_nested_blocks(facts: &LivenessFacts, ptable: Ptr<List<ParamEntry>>, params: &List<String>, diags: &var Diagnostics): void {
    when (self.kind) {
        If(_c, then_body, else_body) => {
            check_stmt_list(&then_body, facts, ptable, params, diags)
            check_stmt_list(&else_body, facts, ptable, params, diags)
        }
        While(_c, body) => check_stmt_list(&body, facts, ptable, params, diags)
        ForEach(_b, _s, body) => check_stmt_list(&body, facts, ptable, params, diags)
        When(_s, arms) => {
            while arm in &arms {
                check_stmt_list(arm.body, facts, ptable, params, diags)
            }
        }
        Switch(_s, arms) => {
            while arm in &arms {
                check_stmt_list(arm.body, facts, ptable, params, diags)
            }
        }
        _ => { }
    }
}
