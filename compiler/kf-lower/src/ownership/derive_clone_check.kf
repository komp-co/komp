// A type whose `drop` frees a raw pointer has no derivable Clone: the
// derived copy shares the buffer, and both owners free it.
//
//     pub struct Owned { var data: Ptr<uint8> }
//     impl Drop for Owned { fun drop(): void { unsafe { free(self.data) } } }
//
// An error, because the compiler inserts clones itself where the author never
// sees them. Writing `impl Clone` is the fix.

import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*

pub fun Module.derive_clone_check_module(diags: Ptr<List<Diagnostic>>): void {
    while td in &self.decls {
        when (td.kind) {
            Struct(fields, _p) => {
                val name = td.name.as_string()
                if !self.type_clones(name.as_str()) {
                    val freed = self.fields_freed_by_drop(name.as_str())
                    report_freed_ptr_fields(fields, &freed, td.span, diags)
                }
            }
            _ => { }
        }
    }
}

/// One error per offending field. The span identifies the type, whose name is
/// mangled by now.
fun report_freed_ptr_fields(fields: &List<Field>, freed: &List<String>, span: Span, diags: Ptr<List<Diagnostic>>): void {
    while f in &fields {
        val tr = unsafe { *f.ty }
        if tr.tref_is_raw_ptr() && names_contains(freed, f.name.as_str()) {
            var msg = String.from("this type's `drop` frees `")
            msg.append(f.name.as_str())
            msg.append("`, so a derived `Clone` would copy the pointer and free the buffer twice; write an `impl Clone` that copies what `drop` frees")
            unsafe { diags.push(new_diagnostic(Severity.Error, new_label(span, msg))) }
        }
    }
}

/// `Ptr<T>` only: `Box<T>` is deep-copied and `&T` is not owned.
fun TypeRef.tref_is_raw_ptr(): bool {
    when (self.kind) {
        Named(n, args) => {
            if !n.as_str().equals("Ptr") { return false }
            return args.size() == 1
        }
        _ => return false
    }
}

/// The fields `drop` passes to a deallocator. A drop that only writes through
/// a pointer (a drop counter) is fine; an unrecognised indirect free errs on
/// the side of accepting.
fun Module.fields_freed_by_drop(name: str): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        if td.name.as_str().equals(name) {
            when (td.kind) {
                ImplBlock(methods) => {
                    while j in 0..methods.size() {
                        val mth = methods.at(j)
                        if mth.name.as_str().equals("drop") {
                            when (mth.kind) {
                                Function(_p, _r, body, _pu, _u, _mu, _s) => collect_freed_in_stmts(&body, &var out)
                                _ => { }
                            }
                        }
                    }
                }
                _ => { }
            }
        }
    }
    return out
}

/// `free` and `kf_free`.
fun is_dealloc_name(n: str): bool {
    if n.equals("free") { return true }
    return n.equals("kf_free")
}

fun collect_freed_in_stmts(stmts: &List<Stmt>, out: &var List<String>): void {
    while stmt in &stmts {
        (stmt).collect_freed_in_stmt(out)
    }
}

fun Stmt.collect_freed_in_stmt(out: &var List<String>): void {
    when (self.kind) {
        Expression(ep) => collect_freed_in_expr(unsafe { &*ep }, out)
        LetVal(_n, _t, ip) => collect_freed_in_opt(ip.view(), out)
        LetVar(_n, _t, ip) => collect_freed_in_opt(ip.view(), out)
        Return(ep) => collect_freed_in_opt(ep.view(), out)
        Assign(_n, rp) => collect_freed_in_expr(unsafe { &*rp }, out)
        AssignTo(_pp, rp) => collect_freed_in_expr(unsafe { &*rp }, out)
        If(cp, t, e) => {
            collect_freed_in_expr(unsafe { &*cp }, out)
            collect_freed_in_stmts(&t, out)
            collect_freed_in_stmts(&e, out)
        }
        While(cp, body) => {
            collect_freed_in_expr(unsafe { &*cp }, out)
            collect_freed_in_stmts(&body, out)
        }
        _ => { }
    }
}

fun collect_freed_in_opt(ep: Ptr<Expr>?, out: &var List<String>): void {
    val p = ep ?: return
    collect_freed_in_expr(unsafe { &*p }, out)
}

/// Casts are seen through: `free(self.data as Ptr<void>)` counts.
fun Expr.collect_freed_in_expr(out: &var List<String>): void {
    when (self.kind) {
        Call(n, args) => {
            if is_dealloc_name(n.as_str()) {
                while arg in &args {
                    collect_self_fields(arg, out)
                }
            }
            while arg in &args {
                arg.collect_freed_in_expr(out)
            }
        }
        MethodCall(rp, _mn, args) => {
            collect_freed_in_expr(unsafe { &*rp }, out)
            while arg in &args {
                arg.collect_freed_in_expr(out)
            }
        }
        Binary(l, _op, r) => {
            collect_freed_in_expr(unsafe { &*l }, out)
            collect_freed_in_expr(unsafe { &*r }, out)
        }
        Unary(_op, inner) => collect_freed_in_expr(unsafe { &*inner }, out)
        Deref(inner) => collect_freed_in_expr(unsafe { &*inner }, out)
        Cast(inner, _t) => collect_freed_in_expr(unsafe { &*inner }, out)
        FieldAccess(obj, _f) => collect_freed_in_expr(unsafe { &*obj }, out)
        _ => { }
    }
}

fun collect_self_fields(e: &Expr, out: &var List<String>): void {
    when (e.kind) {
        FieldAccess(obj, fname) => {
            val o = unsafe { *obj }
            when (o.kind) {
                Variable(vn) => {
                    if vn.as_str().equals("self") {
                        if !names_contains(unsafe { &*out }, fname.as_str()) { out.push(fname.as_string()) }
                    }
                }
                _ => { }
            }
            collect_self_fields(unsafe { &*obj }, out)
        }
        Cast(inner, _t) => collect_self_fields(unsafe { &*inner }, out)
        Deref(inner) => collect_self_fields(unsafe { &*inner }, out)
        Unary(_op, inner) => collect_self_fields(unsafe { &*inner }, out)
        Binary(l, _op, r) => {
            collect_self_fields(unsafe { &*l }, out)
            collect_self_fields(unsafe { &*r }, out)
        }
        _ => { }
    }
}

fun Module.type_clones(name: str): bool {
    return self.type_has_method(name, "clone")
}

/// Post-mono, `impl Drop for X` and `impl X` are both ImplBlocks on X.
fun Module.type_has_method(name: str, mname: str): bool {
    while td in &self.decls {
        if td.name.as_str().equals(name) {
            when (td.kind) {
                ImplBlock(methods) => {
                    while j in 0..methods.size() {
                        if methods.at(j).name.as_str().equals(mname) { return true }
                    }
                }
                _ => { }
            }
        }
    }
    return false
}
