import core.assert.assert_eq
import alloc.list.*
import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

// bx_-prefixed: the liveness tests in this unit define `var_expr` and friends.

fun bx_boxed(e: Expr): Ptr<Expr> {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = e }
    return p
}

fun bx_var(name: str): Expr {
    var e = Expr.new(no_span(), ExprKind.Variable(intern(name)))
    e.ty = Type { kind: TypeKind.Struct(intern("Pair")), provenance: Provenance.Inferred(no_span()) }
    return e
}

fun bx_field(base: Expr, field: str): Expr {
    var e = Expr.new(no_span(), ExprKind.FieldAccess(bx_boxed(base), intern(field)))
    e.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    return e
}

@test
fun a_variable_is_its_own_path(): void {
    assert_eq(access_path(&bx_var("x")).as_str(), "x", "a bare local names itself")
}

@test
fun a_field_extends_the_path(): void {
    assert_eq(access_path(&bx_field(bx_var("x"), "a")).as_str(), "x.a", "`x.a` reaches into `x`")
}

@test
fun a_nested_field_extends_it_again(): void {
    assert_eq(access_path(&bx_field(bx_field(bx_var("x"), "inner"), "a")).as_str(), "x.inner.a", "depth is carried")
}

// A method's returned borrow points into its receiver.
@test
fun a_method_call_reduces_to_its_receiver(): void {
    val call = Expr.new(no_span(), ExprKind.MethodCall(bx_boxed(bx_var("xs")), intern("at_mut"), List.new<Expr>()))
    assert_eq(call.access_path().as_str(), "xs", "`xs.at_mut(i)` points into `xs`")
}

@test
fun a_literal_names_no_place(): void {
    val lit = Expr.new(no_span(), ExprKind.LitInt(7))
    assert_eq(lit.access_path().as_str(), "", "a literal aliases nothing")
}

@test
fun the_same_path_overlaps_itself(): void {
    assert_eq(paths_overlap("x.a", "x.a"), true, "one place named twice")
}

@test
fun a_path_overlaps_what_contains_it(): void {
    assert_eq(paths_overlap("x", "x.a"), true, "`x` contains `x.a`")
    assert_eq(paths_overlap("x.a", "x"), true, "containment is symmetric for overlap")
}

@test
fun sibling_fields_do_not_overlap(): void {
    assert_eq(paths_overlap("x.a", "x.b"), false, "distinct fields are distinct storage")
}

@test
fun a_shared_prefix_is_not_containment(): void {
    assert_eq(paths_overlap("x.a", "x.ab"), false, "`x.ab` is a sibling of `x.a`, not a child")
    assert_eq(paths_overlap("out", "outer"), false, "a bare prefix is not a path prefix")
}

@test
fun unrelated_roots_do_not_overlap(): void {
    assert_eq(paths_overlap("x.a", "y.a"), false, "different roots are different storage")
}
