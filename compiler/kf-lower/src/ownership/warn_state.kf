// Module-scoped state for the move checker's advisories. A MoveCtx is built
// per function, but deduplication and reachability span the module.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.intern
import kf_core.diagnostic.*
import kf_lower.*

pub struct WarnState {
    /// Spans already reported: mono turns one line into many functions.
    pub var warned: List<Span>
    /// Names reachability will keep, when this module is a program.
    pub var reached: Reached
    /// A library prunes nothing, so nothing is filtered.
    pub val prune: bool
    /// Types whose author allowed copying, by mangled name.
    pub var clone_names: List<String>
    /// The advisories, collected for the driver to level.
    pub var lints: List<Diagnostic>
}

pub fun Module.new_warn_state(): WarnState {
    // A program prunes what `main` cannot reach; a library prunes nothing.
    if !self.module_is_pruned() {
        return WarnState {
            warned: List.new<Span>(), reached: new_reached(), prune: false,
            clone_names: self.compute_clone_names(), lints: List.new<Diagnostic>()
        }
    }
    return WarnState {
        warned: List.new<Span>(), reached: self.compute_reached(), prune: true,
        clone_names: self.compute_clone_names(), lints: List.new<Diagnostic>()
    }
}

pub mutating fun WarnState.warn_span_is_new(span: Span): bool {
    while s in &self.warned {
        if s.file_id == span.file_id && s.start == span.start && s.end == span.end {
            return false
        }
    }
    self.warned.push(span)
    return true
}

/// The function survives pruning and the span is new.
/// CONSTRAINT: reachability is asked first, or a pruned instance would take
/// the dedup slot from a live one.
fun warning_has_a_subject(span: Span, ctx: &var MoveCtx): bool {
    val w = ctx.warn
    if unsafe { w.prune } {
        if !name_is_reached(unsafe { &w.reached }, intern(ctx.cur_fn.as_str())) { return false }
    }
    return warn_span_is_new(unsafe { &var *w }, span)
}
