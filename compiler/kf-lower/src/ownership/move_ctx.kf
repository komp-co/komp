import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

/// Lower cannot depend on kf-driver, so it reads the crate root directly.
extern "C" fun kf_local_root(): str

/// These advisories are hidden for dependency code, which a consumer cannot
/// change. An unattributable span or unset root shows the warning.
fun span_is_in_a_dependency(span: Span, ctx: &var MoveCtx): bool {
    val root = unsafe { kf_local_root() }
    if root.byte_len() == 0 { return false }
    val path = unsafe { (*ctx.smap).file_path_of(span.file_id) }
    if path.as_str().equals("") { return false }
    return !path.as_str().starts_with(root)
}



/// Per-function move-check state, in parallel lists.
pub struct MoveCtx {
    pub var owned: List<Sym>
    pub var moved: List<MovedEntry>
    // Use-after-move, branch divergence and loop move leaks. Not
    // liveness-accurate, so the pipeline discards this channel.
    pub val diags: Ptr<List<Diagnostic>>
    // Mangled names of move-only types.
    pub var move_only_names: List<String>
    // Locals and binders bound from a borrow path; they own nothing.
    pub var borrowed: List<Sym>
    // Shared by pointer: it holds move-only lists.
    pub val ptable: Ptr<List<ParamEntry>>
    // Counts move-out-of-borrow errors. A count, not a list: a pushed message
    // String was read back dangling under the seed.
    pub val mob_count: Ptr<MobCount>
    // The enclosing impl's target, or "". `when (self)` in a substituted body
    // still reads as the template, so it is classified from this.
    pub var self_owner: String
    // For naming the enclosing function in warnings.
    pub var cur_fn: String
    pub val warn: Ptr<WarnState>
    // For path:line:col in warnings.
    pub val smap: Ptr<SourceMap>
    // Names consumed by this statement, cleared at each statement boundary.
    // `moved` cannot answer this: a borrow read resets a moved name to owned.
    pub var consumed_here: List<Sym>
}

@derive(Copy)
pub struct MovedEntry {
    pub val name: Sym
    pub val site: Span
    // The most recent consume; a later use clones it so the original stays
    // live.
    pub val last_consume: Ptr<Expr>
}

// A struct, not `Ptr<uint64>`: `alloc<uint64>` mis-renders the C type.
pub struct MobCount {
    pub var n: uint64
}

pub fun new_move_ctx(diags: Ptr<List<Diagnostic>>, move_only_names: List<String>, ptable: Ptr<List<ParamEntry>>, mob_count: Ptr<MobCount>, cur_fn: String, smap: Ptr<SourceMap>, warn: Ptr<WarnState>): MoveCtx {
    return MoveCtx { owned: List.new<Sym>(), moved: List.new<MovedEntry>(), diags: diags, move_only_names: move_only_names, borrowed: List.new<Sym>(), ptable: ptable, mob_count: mob_count, self_owner: "", cur_fn: cur_fn, smap: smap, warn: warn, consumed_here: List.new<Sym>() }
}


pub fun clone_str_list(src: &List<String>): List<String> {
    var out = List.new<String>()
    while item in &src {
        out.push(item)
    }
    return out
}

// The callee parameter table, keyed by mangled callee (`List__int64_get`):
// for each declared parameter, whether it is a borrow-sink (`&`, `Ptr`) or a
// by-value move-sink. Computed once, holding only primitives. The receiver is
// never in `args`, so argument `i` is parameter `i`.
pub struct ParamEntry {
    pub val name:  String
    pub val sinks: List<bool>     // sinks.get(i) == param i is a borrow-sink
    // Param `i` is `&var T`. The written `&` is gone by Lower, so the
    // declaration is the only record.
    pub val muts:  List<bool>
    // Param `i` is a borrow in kf-core's sense (includes `str`, excludes
    // `Ptr`), unlike `sinks`, which asks whether ownership transfers.
    pub val lends: List<bool>
    // The C side never drops a by-value String, so the caller keeps its drop.
    pub val is_extern: bool
}

pub fun Module.build_param_table(): List<ParamEntry> {
    var out = List.new<ParamEntry>()
    while decl in &self.decls {
        decl.collect_param_entries(&var out)
    }
    return out
}

fun param_sinks_of(params: &List<Param>): List<bool> {
    var ps = List.new<bool>()
    while p in &params {
        ps.push(tref_is_borrow_sink(p.ty))   // Param.ty is Box<TypeRef> == Ptr<TypeRef>
    }
    return ps
}

fun param_lends_of(params: &List<Param>): List<bool> {
    var ps = List.new<bool>()
    while param in &params {
        ps.push(type_ref_is_borrow(unsafe { &*(param.ty) }))
    }
    return ps
}

fun param_muts_of(params: &List<Param>): List<bool> {
    var ps = List.new<bool>()
    while param in &params {
        ps.push(tref_is_mut_sink(param.ty))
    }
    return ps
}

fun TopDecl.collect_param_entries(out: &var List<ParamEntry>): void {
    when (self.kind) {
        Function(params, _r, _b, _p, _u, _m, _s) => {
            out.push(ParamEntry { name: self.name.as_string(), sinks: param_sinks_of(params), muts: param_muts_of(params), lends: param_lends_of(params), is_extern: false })
        }
        Extern(params, _r, _p, _u) => {
            out.push(ParamEntry { name: self.name.as_string(), sinks: param_sinks_of(params), muts: param_muts_of(params), lends: param_lends_of(params), is_extern: true })
        }
        ImplBlock(methods) => { collect_impl_entries(self.name.as_string(), methods, out) }
        TraitImpl(_t, methods) => { collect_impl_entries(self.name.as_string(), methods, out) }
        _ => return
    }
}

fun collect_impl_entries(struct_name: String, methods: &List<TopDecl>, out: &var List<ParamEntry>): void {
    while meth in &methods {
        when (meth.kind) {
            Function(params, _r, _b, _p, _u, _m, _s) => {
                val key = struct_name + String.from("_") + meth.name.as_string()
                out.push(ParamEntry { name: key, sinks: param_sinks_of(params), muts: param_muts_of(params), lends: param_lends_of(params), is_extern: false })
            }
            _ => return
        }
    }
}

// `&T`, `&var T` or `Ptr<T>`: takes no ownership.
pub fun tref_is_borrow_sink(trp: Ptr<TypeRef>): bool {
    val t: TypeRef = unsafe { *trp }
    val tk = t.kind
    return when (tk) {
        Reference(_, _) => true
        Named(n, _) => n.as_str().equals("Ptr")
        _ => false
    }
}

// `&var T` only; writes through `Ptr<T>` carry their own proof.
fun tref_is_mut_sink(trp: Ptr<TypeRef>): bool {
    val t: TypeRef = unsafe { *trp }
    val tk = t.kind
    return when (tk) {
        Reference(mutable, _) => mutable
        _ => false
    }
}

// found=false when the callee or index is unknown, so nothing is flagged.
pub struct ParamLookup {
    val found: bool
    val is_borrow_sink: bool
    val is_mut_sink: bool
    val is_lend: bool
    val is_extern: bool
}

pub fun param_lookup(table: &List<ParamEntry>, callee: String, idx: uint64): ParamLookup {
    while e in &table {
        if e.name.as_str().equals(callee.as_str()) {
            if idx < e.sinks.size() {
                return ParamLookup { found: true, is_borrow_sink: e.sinks.get(idx), is_mut_sink: e.muts.get(idx), is_lend: e.lends.get(idx), is_extern: e.is_extern }
            }
            return ParamLookup { found: false, is_borrow_sink: false, is_mut_sink: false, is_lend: false, is_extern: false }
        }
    }
    return ParamLookup { found: false, is_borrow_sink: false, is_mut_sink: false, is_lend: false, is_extern: false }
}

// A Box, or a type in move_only_names.
fun Type.mc_is_move_only(names: &List<String>): bool {
    when (self.kind) {
        BoxOf(_) => return true
        Struct(n) => {
            val name = type_identity_display(n)
            while item in &names {
                if item.as_str().equals(name.as_str()) { return true }
            }
            return false
        }
        EnumTy(n) => {
            while item in &names {
                if item.as_str().equals(type_identity_display(n).as_str()) { return true }
            }
            return false
        }
        // Listed only by the template check, for a parameter not bounded by `Copy`.
        Generic(n) => {
            while item in &names {
                if item.as_str().equals(n.as_str()) { return true }
            }
            return false
        }
        _ => return false
    }
}

// Through pointer and borrow forms; a Box is itself move-only.
fun Type.mc_receiver_pointee(): Type {
    when (self.kind) {
        RefTo(_mutable, inner) => return mc_receiver_pointee(unsafe { &*inner })
        PtrTo(inner) => return mc_receiver_pointee(unsafe { &*inner })
        _ => return unsafe { *self }
    }
}

// A field read or deref: consuming it by value is a move out of a borrow. An
// accessor's element read is a deref inside the accessor, classified there.
fun Expr.is_borrow_path(names: &List<String>): bool {
    when (self.kind) {
        FieldAccess(_, _) => return !self.is_variant_construction()
        Deref(_) => return true
        DynCoerce(_, _) => return true
        _ => return false
    }
}

// `Option.None` parses as a field access; a constructed variant owns nothing.
// TypeCheck leaves such a receiver poison, which is how it is told apart: the
// written name does not match a generic enum's mangled type.
fun Expr.is_variant_construction(): bool {
    val is_enum = when (self.ty.kind) {
        EnumTy(_name) => true
        _ => false
    }
    if !is_enum { return false }
    when (self.kind) {
        FieldAccess(base, _) => {
            val recv = unsafe { *base }
            return recv.ty.is_poison()
        }
        _ => return false
    }
}
