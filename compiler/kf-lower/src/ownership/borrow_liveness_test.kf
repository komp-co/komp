import core.assert.assert_eq
import alloc.list.*
import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.diagnostic.*

fun boxed_expr(e: Expr): Ptr<Expr> {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = e }
    return p
}

fun var_expr(name: str, ty: Type): Expr {
    var e = Expr.new(no_span(), ExprKind.Variable(intern(name)))
    e.ty = ty
    return e
}

fun str_type(): Type {
    return Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
}

fun string_type(): Type {
    return Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
}

/// `val <bound> = <origin>.as_str()`, typed as the borrow it is.
fun borrow_binding(bound: str, origin: str): Stmt {
    var call = Expr.new(no_span(), ExprKind.MethodCall(boxed_expr(var_expr(origin, string_type())), intern("as_str"), List.new<Expr>()))
    call.ty = str_type()
    return Stmt.new(no_span(), StmtKind.LetVal(intern(bound), null, boxed_expr(call)))
}

/// `<origin>.append("x")` as a bare statement.
fun append_call(origin: str): Stmt {
    var args = List.new<Expr>()
    args.push(Expr.new(no_span(), ExprKind.LitStr(String.from("x"))))
    var call = Expr.new(no_span(), ExprKind.MethodCall(boxed_expr(var_expr(origin, string_type())), intern("append"), args))
    call.ty = Type { kind: TypeKind.Void, provenance: Provenance.Inferred(no_span()) }
    return Stmt.new(no_span(), StmtKind.Expression(boxed_expr(call)))
}

/// `<origin> = <origin>`, which drops the old buffer.
fun reassign(origin: str): Stmt {
    return Stmt.new(no_span(), StmtKind.Assign(intern(origin), boxed_expr(var_expr(origin, string_type()))))
}

fun read_of(name: str): Stmt {
    return Stmt.new(no_span(), StmtKind.Expression(boxed_expr(var_expr(name, str_type()))))
}

/// One per declaration: a shared pointer would be dropped by each.
fun void_ret(): Ptr<TypeRef> {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    return p
}

fun typed_param(name: str, ty: TypeRef): Param {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = ty }
    return new_param(no_span(), String.from(name), p)
}

fun string_ref(): TypeRef {
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    return TypeRef.new(no_span(), TypeRefKind.Reference(false, inner))
}

/// `consume(s: String)` takes its argument by value; `observe(s: &String)`
/// borrows it.
fun sink_decls(): List<TopDecl> {
    var out = List.new<TopDecl>()
    var consume_params = List.new<Param>()
    consume_params.push(typed_param("s", TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>()))))
    out.push(new_top_decl(no_span(), String.from("consume"), TopDeclKind.Function(consume_params, void_ret(), List.new<Stmt>(), true, false, false, false)))
    var observe_params = List.new<Param>()
    observe_params.push(typed_param("s", string_ref()))
    out.push(new_top_decl(no_span(), String.from("observe"), TopDeclKind.Function(observe_params, void_ret(), List.new<Stmt>(), true, false, false, false)))
    return out
}

/// `<callee>(<origin>)` as a bare statement.
fun call_with(callee: str, origin: str): Stmt {
    var args = List.new<Expr>()
    args.push(var_expr(origin, string_type()))
    var call = Expr.new(no_span(), ExprKind.Call(intern(callee), args))
    call.ty = Type { kind: TypeKind.Void, provenance: Provenance.Inferred(no_span()) }
    return Stmt.new(no_span(), StmtKind.Expression(boxed_expr(call)))
}

fun return_of(name: str, ty: Type): Stmt {
    return Stmt.new(no_span(), StmtKind.Return(Option.Some(boxed_expr(var_expr(name, ty)))))
}

/// `<recv>.<method>(<origin>)`; `mangled` keys the param table.
fun method_call_with(recv: str, method: str, mangled: str, origin: str): Stmt {
    var args = List.new<Expr>()
    args.push(var_expr(origin, string_type()))
    var call = Expr.new(no_span(), ExprKind.MethodCall(boxed_expr(var_expr(recv, string_type())), intern(method), args))
    call.mangled_callee = intern(mangled)
    call.ty = Type { kind: TypeKind.Void, provenance: Provenance.Inferred(no_span()) }
    return Stmt.new(no_span(), StmtKind.Expression(boxed_expr(call)))
}

/// One function whose body is `body`, plus a `String` impl declaring
/// `append` mutating and `as_str` not.
fun module_with(body: List<Stmt>): Module {
    var methods = List.new<TopDecl>()
    methods.push(new_top_decl(no_span(), String.from("append"), TopDeclKind.Function(List.new<Param>(), void_ret(), List.new<Stmt>(), true, false, true, false)))
    methods.push(new_top_decl(no_span(), String.from("as_str"), TopDeclKind.Function(List.new<Param>(), void_ret(), List.new<Stmt>(), true, false, false, false)))
    var take_params = List.new<Param>()
    take_params.push(typed_param("s", TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>()))))
    methods.push(new_top_decl(no_span(), String.from("take"), TopDeclKind.Function(take_params, void_ret(), List.new<Stmt>(), true, false, false, false)))
    var read_params = List.new<Param>()
    read_params.push(typed_param("s", string_ref()))
    methods.push(new_top_decl(no_span(), String.from("read"), TopDeclKind.Function(read_params, void_ret(), List.new<Stmt>(), true, false, false, false)))

    var decls = sink_decls()
    decls.push(new_top_decl(no_span(), String.from("String"), TopDeclKind.ImplBlock(methods)))
    decls.push(new_top_decl(no_span(), String.from("subject"), TopDeclKind.Function(List.new<Param>(), void_ret(), body, true, false, false, false)))
    return Module { crate: new_crate_id("application"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun errors_for(body: List<Stmt>): uint64 {
    val m = module_with(body)
    var out = new_diagnostics()
    m.borrow_liveness_module(&var out)
    return out.size()
}

@test
fun mutating_the_origin_while_the_borrow_is_read_is_rejected(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(append_call("out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 1, "append may reallocate the buffer `view` points into")
}

@test
fun reassigning_the_origin_while_the_borrow_is_read_is_rejected(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(reassign("out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 1, "reassignment drops the buffer outright")
}

// Once nothing reads the borrow, the origin is free.
@test
fun mutating_after_the_last_use_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(read_of("view"))
    body.push(append_call("out"))
    assert_eq(errors_for(body), 0, "nothing reads `view` after the append")
}

@test
fun a_borrow_that_is_never_read_constrains_nothing(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(append_call("out"))
    assert_eq(errors_for(body), 0, "an unread borrow has no live range to protect")
}

@test
fun a_read_only_method_on_the_origin_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(Stmt.new(no_span(), StmtKind.Expression(boxed_expr(var_expr("out", string_type())))))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 0, "reading the origin is not disturbing it")
}

@test
fun an_unrelated_local_is_not_the_origin(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(append_call("other"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 0, "only the origin is frozen")
}

@test
fun moving_the_origin_into_a_consuming_param_is_rejected(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(call_with("consume", "out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 1, "the callee becomes responsible for dropping what `view` points into")
}

@test
fun lending_the_origin_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(call_with("observe", "out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 0, "a borrowing parameter takes nothing away")
}

@test
fun moving_the_origin_after_the_last_use_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(read_of("view"))
    body.push(call_with("consume", "out"))
    assert_eq(errors_for(body), 0, "nothing reads `view` after the move")
}

// A borrow bound before it is returned.
@test
fun returning_a_laundered_borrow_of_a_local_is_rejected(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(return_of("view", str_type()))
    assert_eq(errors_for(body), 1, "`out` is dropped at the return that hands out a borrow of it")
}

// A value computed from a borrow leaves nothing pointing at the origin.
@test
fun returning_a_value_computed_from_a_borrow_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(return_of("view", Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) }))
    assert_eq(errors_for(body), 0, "an int32 return carries no borrow out")
}

// A method's ParamEntry omits `self`, so arg i is param i.
@test
fun moving_the_origin_into_a_method_is_rejected(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(method_call_with("sink", "take", "String_take", "out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 1, "`take` consumes its argument, dropping what `view` points into")
}

@test
fun lending_the_origin_to_a_method_is_accepted(): void {
    var body = List.new<Stmt>()
    body.push(borrow_binding("view", "out"))
    body.push(method_call_with("sink", "read", "String_read", "out"))
    body.push(read_of("view"))
    assert_eq(errors_for(body), 0, "`read` borrows its argument, taking nothing away")
}
