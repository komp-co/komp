// Rewrites a `when` used as a value into a `when` statement:
//
//   return when (s) { p => e }   ->   when (s) { p => return e }
//
//   val x = when (s) { p => e }  ->   var __whenN: T
//                                     when (s) { p => __whenN = e }
//                                     val x = __whenN
//
// C expressions cannot introduce a statement, so this cannot wait for codegen.
//
// CONSTRAINT: runs before alpha_rename, so the temporary is renamed and
// refcounted like any local.

import alloc.list.*

import kf_core.ast.*
import kf_typecheck.types.type_to_type_ref

/// Per-function counter, so two `when` values get distinct temporaries.
pub struct WhenTemps {
    pub var n: uint64
}

pub mutating fun Module.desugar_when_expr_module(): void {
    while i in 0..self.decls.size() {
        when_expr_top_decl(self.decls.at_mut(i))
    }
}

mutating fun TopDecl.when_expr_top_decl(): void {
    when (self.kind) {
        Function(params, ret, body, p, u, mu, st) => {
            var temps = WhenTemps { n: 0 }
            val new_body = when_expr_stmt_list(&body, &var temps)
            self.kind = TopDeclKind.Function(params, ret, new_body, p, u, mu, st)
        }
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                when_expr_top_decl(methods.at_mut(i))
            }
            self.kind = TopDeclKind.ImplBlock(methods)
        }
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}

fun when_expr_stmt_list(stmts: &List<Stmt>, temps: &var WhenTemps): List<Stmt> {
    var out = List.new<Stmt>()
    while stmt in &stmts {
        when_expr_stmt(stmt, temps, &var out)
    }
    return out
}

/// Appends, because a `when` value expands into several statements.
fun when_expr_stmt(s: Stmt, temps: &var WhenTemps, out: &var List<Stmt>): void {
    when (s.kind) {
        Return(opt_ptr) => {
            if opt_ptr.is_none() {
                out.push(s)
                return
            }
            val rp = opt_ptr ?: return
            when (unsafe { rp.kind }) {
                // A `when` that is the operand returns from its arms directly.
                WhenExpr(subj_ptr, arms) => {
                    // The subject may be a `when` value itself (`a?.b?.c`).
                    hoist_when_values(subj_ptr, temps, out)
                    out.push(new_stmt(s.span, StmtKind.When(subj_ptr, arms_returning(&arms, temps))))
                }
                _ => {
                    hoist_when_values(rp, temps, out)
                    out.push(s)
                }
            }
        }
        LetVal(name, ty_ptr, init_ptr) => expand_let(s, name, ty_ptr.duplicate(), init_ptr.view(), true, temps, out)
        LetVar(name, ty_ptr, init_ptr) => expand_let(s, name, ty_ptr.duplicate(), init_ptr.view(), false, temps, out)
        If(cond_ptr, then_body, else_body) => {
            hoist_when_values(cond_ptr, temps, out)
            val nt = when_expr_stmt_list(&then_body, temps)
            val ne = when_expr_stmt_list(&else_body, temps)
            out.push(new_stmt(s.span, StmtKind.If(cond_ptr, nt, ne)))
        }
        While(cond_ptr, body) => expand_while(s, cond_ptr, body, temps, out)
        ForEach(binder, subj_ptr, body) => {
            hoist_when_values(subj_ptr, temps, out)
            out.push(new_stmt(s.span, StmtKind.ForEach(binder, subj_ptr, when_expr_stmt_list(&body, temps))))
        }
        When(subj_ptr, arms) => {
            hoist_when_values(subj_ptr, temps, out)
            var new_arms = List.new<Arm>()
            while a in &arms {
                new_arms.push(new_arm(a.span, a.pattern, a.guard.duplicate(), when_expr_stmt_list(&a.body, temps)))
            }
            out.push(new_stmt(s.span, StmtKind.When(subj_ptr, new_arms)))
        }
        Assign(_n, rhs) => {
            hoist_when_values(rhs, temps, out)
            out.push(s)
        }
        AssignTo(place, rhs) => {
            hoist_when_values(place, temps, out)
            hoist_when_values(rhs, temps, out)
            out.push(s)
        }
        Expression(e) => {
            hoist_when_values(e, temps, out)
            out.push(s)
        }
        Switch(_, _) => out.push(s)
        Drop(_) => out.push(s)
        Release(_) => out.push(s)
        Break => out.push(s)
        Continue => out.push(s)
        Poison => out.push(s)
    }
}

/// A binding with no initializer (`var __blkN: T`) passes through.
fun expand_let(s: Stmt, name: Sym, ty: Box<TypeRef>?, init_ptr: Ptr<Expr>?, is_val: bool, temps: &var WhenTemps, out: &var List<Stmt>): void {
    val ip = init_ptr ?: {
        out.push(s)
        return
    }
    var is_when = false
    when (unsafe { ip.kind }) {
        WhenExpr(_s, _a) => { is_when = true }
        _ => { }
    }
    if !is_when {
        // `s` is a copy: rewrite its own initializer, the one pushed.
        hoist_when_values(s.let_init() ?: ip, temps, out)
        out.push(s)
        return
    }
    when (unsafe { ip.kind }) {
        WhenExpr(subj_ptr, arms) => {
            val span = s.span
            val value_ty = unsafe { ip.ty }
            hoist_when_values(subj_ptr, temps, out)
            val temp = temps.fresh_when_temp()

            // Declared without a value; the annotation is required.
            val ann: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *ann = type_to_type_ref(&value_ty, span) }
            out.push(new_stmt(span, StmtKind.LetVar(temp, ann, null)))

            out.push(new_stmt(span, StmtKind.When(subj_ptr, arms_assigning(&arms, temp, temps))))

            val vp: Ptr<Expr> = unsafe { alloc<Expr>() }
            var v = new_expr(span, ExprKind.Variable(temp))
            v.ty = value_ty
            unsafe { *vp = v }
            if is_val {
                out.push(new_stmt(span, StmtKind.LetVal(name, ty, vp)))
            } else {
                out.push(new_stmt(span, StmtKind.LetVar(name, ty, vp)))
            }
        }
        _ => out.push(s)
    }
}

/// `while COND { BODY }` where COND holds a `when` value becomes
///
///     while true { <hoisted>  if !COND { break }  BODY }
///
/// since the condition is re-evaluated on every back edge.
fun expand_while(s: Stmt, cond_ptr: Ptr<Expr>, body: List<Stmt>, temps: &var WhenTemps, out: &var List<Stmt>): void {
    var hoisted = List.new<Stmt>()
    hoist_when_values(cond_ptr, temps, &var hoisted)
    if hoisted.size() == 0 {
        out.push(new_stmt(s.span, StmtKind.While(cond_ptr, when_expr_stmt_list(&body, temps))))
        return
    }
    val span = s.span
    var inner = List.new<Stmt>()
    while item in &hoisted {
        inner.push(item)
    }
    val neg: Ptr<Expr> = unsafe { alloc<Expr>() }
    var negated = new_expr(span, ExprKind.Unary(UnaryOp.Not, cond_ptr))
    negated.ty = unsafe { cond_ptr.ty }
    unsafe { *neg = negated }
    var brk = List.new<Stmt>()
    brk.push(new_stmt(span, StmtKind.Break))
    inner.push(new_stmt(span, StmtKind.If(neg, brk, List.new<Stmt>())))
    val lowered = when_expr_stmt_list(&body, temps)
    while item in &lowered {
        inner.push(item)
    }
    val always: Ptr<Expr> = unsafe { alloc<Expr>() }
    var t = new_expr(span, ExprKind.LitBool(true))
    t.ty = bool_ty(span)
    unsafe { *always = t }
    out.push(new_stmt(span, StmtKind.While(always, inner)))
}

/// Every statement before the value, so an arm's steps are kept.
fun Arm.arm_steps_into(temps: &var WhenTemps, out: &var List<Stmt>): void {
    val n: uint64 = self.body.size()
    if n == 0 { return }
    var i: uint64 = 0
    while i + 1 < n {
        when_expr_stmt(*self.body.at(i), temps, out)
        i = i + 1
    }
}

fun arms_returning(arms: &List<Arm>, temps: &var WhenTemps): List<Arm> {
    var out = List.new<Arm>()
    while a in &arms {
        var body = List.new<Stmt>()
        when (arm_value_expr(&a)) {
            Some(vp) => {
                a.arm_steps_into(temps, &var body)
                // A `when` inside the arm's value is hoisted inside this arm.
                hoist_when_values(vp, temps, &var body)
                body.push(new_stmt(unsafe { vp.span }, StmtKind.Return(Option.Some(vp))))
            }
            None => body = when_expr_stmt_list(&a.body, temps)
        }
        out.push(new_arm(a.span, a.pattern, a.guard.duplicate(), body))
    }
    return out
}

fun arms_assigning(arms: &List<Arm>, temp: Sym, temps: &var WhenTemps): List<Arm> {
    var out = List.new<Arm>()
    while a in &arms {
        var body = List.new<Stmt>()
        when (arm_value_expr(&a)) {
            Some(vp) => {
                a.arm_steps_into(temps, &var body)
                hoist_when_values(vp, temps, &var body)
                body.push(new_stmt(unsafe { vp.span }, StmtKind.Assign(temp, vp)))
            }
            None => body = when_expr_stmt_list(&a.body, temps)
        }
        out.push(new_arm(a.span, a.pattern, a.guard.duplicate(), body))
    }
    return out
}

mutating fun WhenTemps.fresh_when_temp(): Sym {
    var name = String.from("__when")
    val n: int64 = self.n as int64
    name.append(String.of(&(n)).as_str())
    self.n = self.n + 1
    return intern(name.as_str())
}

fun Stmt.let_init(): Ptr<Expr>? {
    return when (self.kind) {
        LetVal(_n, _ty, init) => init.view()
        LetVar(_n, _ty, init) => init.view()
        _ => null
    }
}
