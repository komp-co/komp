import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*

fun tb_null_tyref(): Ptr<TypeRef> {
    return unsafe { 0 as Ptr<TypeRef> }
}

/// `enum <name> { <variant>(payloads...) }` with `payload_count` payloads.
fun tb_enum(name: str, variant: str, payload_count: uint64): TopDecl {
    var payloads = List.new<TypeRef>()
    var i: uint64 = 0
    while i < payload_count {
        payloads.push(new_type_ref(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
        i = i + 1
    }
    var variants = List.new<Variant>()
    variants.push(new_variant(no_span(), String.from(variant), payloads))
    return new_top_decl(no_span(), String.from(name), TopDeclKind.EnumDecl(variants, true))
}

/// `when (self) { <variant>(b0..) => ... }` in `impl <impl_name>`.
fun tb_impl_with_arm(impl_name: str, variant: str, binder_count: uint64): TopDecl {
    var binders = List.new<Sym>()
    var i: uint64 = 0
    while i < binder_count {
        binders.push(intern("b"))
        i = i + 1
    }
    val subj = new_expr(no_span(), ExprKind.Variable(intern("self")))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    var arms = List.new<SwitchArm>()
    arms.push(new_switch_arm(no_span(), SwitchTag.Variant(String.from(variant)), binders, null, List.new<Stmt>()))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Switch(sp, arms)))
    val method = new_top_decl(no_span(), String.from("probe"),
        TopDeclKind.Function(List.new<Param>(), tb_null_tyref(), body, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(method)
    return new_top_decl(no_span(), String.from(impl_name), TopDeclKind.ImplBlock(methods))
}

fun tb_module(decls: List<TopDecl>): Module {
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

/// 999 for a shape this helper did not build, so a broken fixture fails loudly.
fun Module.tb_first_arm_binders(i: uint64): uint64 {
    val td = self.decls.at(i)
    when (td.kind) {
        ImplBlock(methods) => {
            when (methods.at(0).kind) {
                Function(_p, _r, body, _pub, _u, _mu, _s) => {
                    when (body.at(0).kind) {
                        Switch(_subj, arms) => { return arms.at(0).binders.size() }
                        _ => { return 999 }
                    }
                }
                _ => { return 999 }
            }
        }
        _ => { return 999 }
    }
    return 999
}

@test
fun a_binder_past_the_variants_payloads_is_dropped(): void {
    // `Option<void>`'s Some carries nothing, but the template body binds one.
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Option__void", "Some", 0))
    decls.push(tb_impl_with_arm("Option__void", "Some", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 0, "nothing to bind, so nothing is bound")
}

@test
fun a_binder_the_variant_does_have_is_kept(): void {
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Option__int32", "Some", 1))
    decls.push(tb_impl_with_arm("Option__int32", "Some", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 1, "a real payload still binds")
}

@test
fun an_enum_the_module_does_not_declare_is_left_alone(): void {
    // An unknown owner must not truncate real bindings.
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Somewhere__Else", "Some", 0))
    decls.push(tb_impl_with_arm("Option__int32", "Some", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 1, "an unknown owner keeps its binders")
}

@test
fun the_owner_comes_from_the_impl_not_the_subjects_type(): void {
    // The subject carries no type, as in a substituted body; the impl name
    // decides.
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Result__void__int32", "Ok", 0))
    decls.push(tb_impl_with_arm("Result__void__int32", "Ok", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 0, "the impl target decides")
}

@test
fun a_variant_the_owner_does_not_have_is_left_alone(): void {
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Option__void", "Some", 0))
    decls.push(tb_impl_with_arm("Option__void", "NoSuchVariant", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 1, "an unknown variant keeps its binders")
}

/// The arm's body is `return b0`, which reads the binder.
fun tb_impl_with_returning_arm(impl_name: str, variant: str, binder_count: uint64): TopDecl {
    var binders = List.new<Sym>()
    var i: uint64 = 0
    while i < binder_count {
        binders.push(intern("b"))
        i = i + 1
    }
    val subj = new_expr(no_span(), ExprKind.Variable(intern("self")))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    val read = new_expr(no_span(), ExprKind.Variable(intern("b")))
    val rp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rp = read }
    var arm_body = List.new<Stmt>()
    arm_body.push(new_stmt(no_span(), StmtKind.Return(rp)))
    var arms = List.new<SwitchArm>()
    arms.push(new_switch_arm(no_span(), SwitchTag.Variant(String.from(variant)), binders, null, arm_body))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Switch(sp, arms)))
    val method = new_top_decl(no_span(), String.from("probe"),
        TopDeclKind.Function(List.new<Param>(), tb_null_tyref(), body, true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(method)
    return new_top_decl(no_span(), String.from(impl_name), TopDeclKind.ImplBlock(methods))
}

/// 999 for a shape this helper did not build.
fun Module.tb_first_arm_return_has_value(i: uint64): uint64 {
    val td = self.decls.at(i)
    when (td.kind) {
        ImplBlock(methods) => {
            when (methods.at(0).kind) {
                Function(_p, _r, body, _pub, _u, _mu, _s) => {
                    when (body.at(0).kind) {
                        Switch(_subj, arms) => {
                            when (arms.at(0).body.at(0).kind) {
                                Return(e) => { return when (e) { Some(_p) => 1  None => 0 } }
                                _ => { return 999 }
                            }
                        }
                        _ => { return 999 }
                    }
                }
                _ => { return 999 }
            }
        }
        _ => { return 999 }
    }
    return 999
}

// A body that returns the removed binder returns nothing at `void`.
@test
fun returning_a_trimmed_binder_becomes_a_bare_return(): void {
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Option__void", "Some", 0))
    decls.push(tb_impl_with_returning_arm("Option__void", "Some", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 0, "nothing to bind, so nothing is bound")
    assert_eq(m.tb_first_arm_return_has_value(1), 0, "and nothing to return, so nothing is returned")
}

// A payload that is really there keeps its binder and its return.
@test
fun returning_a_kept_binder_is_untouched(): void {
    var decls = List.new<TopDecl>()
    decls.push(tb_enum("Option__int32", "Some", 1))
    decls.push(tb_impl_with_returning_arm("Option__int32", "Some", 1))
    var m = tb_module(decls)
    m.trim_variant_binders()
    assert_eq(m.tb_first_arm_binders(1), 1, "a real payload still binds")
    assert_eq(m.tb_first_arm_return_has_value(1), 1, "and the return still hands it back")
}
