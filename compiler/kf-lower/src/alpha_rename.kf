// Gives every shadowing binding a fresh name and rewrites its references, so
// no two live locals in a function share a name. Codegen emits locals with no
// scope layer and the move checker keys its sets on names, so both need it.
//
// CONSTRAINT: runs first in Lower, before move_check.
//
// CONSTRAINT: rewrites in place through pointers into the AST; lists are
// taken by shared borrow so their backing is never dropped.

import alloc.list.*

import kf_core.ast.*


// One scope's (original -> renamed) pairs; a non-shadowing binding maps to
// itself.
pub struct RnScope {
    pub var origs: List<Sym>
    pub var news: List<Sym>
}

// Scopes, outermost first, and a per-function counter for fresh names.
pub struct RnCtx {
    pub var scopes: List<RnScope>
    pub var counter: uint64
}

mutating fun RnCtx.push_scope(): void {
    self.scopes.push(RnScope { origs: List.new<Sym>(), news: List.new<Sym>() })
}

mutating fun RnCtx.pop_scope(): void {
    self.scopes.pop()
}

mutating fun RnCtx.rn_visible(name: Sym): bool {
    while sc in &self.scopes {
        while i in 0..sc.origs.size() {
            if sc.origs.get(i).id == name.id { return true }
        }
    }
    return false
}

// The innermost mapping, or `name` itself for a global, function or enum
// constructor.
mutating fun RnCtx.rn_lookup(name: Sym): Sym {
    var si: uint64 = self.scopes.size()
    while si > 0 {
        si = si - 1
        val sc = self.scopes.at(si)
        var i: uint64 = sc.origs.size()
        while i > 0 {
            i = i - 1
            if sc.origs.get(i).id == name.id { return sc.news.get(i) }
        }
    }
    return name
}

// Binds `name` in the innermost scope, minting a fresh name if it shadows.
// Returns the name the binding and its references use.
mutating fun RnCtx.rn_bind(name: Sym): Sym {
    var nn = name
    if self.rn_visible(name) {
        val suffix = "${self.counter}"
        val fresh = name.as_string() + String.from("__shadow") + suffix
        nn = intern(fresh.as_str())
        self.counter = self.counter + 1
    }
    val n = self.scopes.size()
    if n > 0 {
        val top = self.scopes.at_mut(n - 1)
        top.origs.push(name)
        top.news.push(nn)
    }
    return nn
}

// Params and pattern binders shadow outer names but keep their own.
mutating fun RnCtx.bind_identity(name: Sym): void {
    val n = self.scopes.size()
    if n > 0 {
        val top = self.scopes.at_mut(n - 1)
        top.origs.push(name)
        top.news.push(name)
    }
}

fun rename_expr_ptr(p_opt: Ptr<Expr>?, ctx: &var RnCtx): void {
    val p = p_opt ?: return
    when (unsafe { p.kind }) {
        Variable(nm) => {
            val nn = ctx.rn_lookup(nm)
            if nn.id != nm.id { unsafe { p.kind = ExprKind.Variable(nn) } }
        }
        Binary(lp, _op, rp) => {
            rename_expr_ptr(lp, ctx)
            rename_expr_ptr(rp, ctx)
        }
        Unary(_op, ip) => rename_expr_ptr(ip, ctx)
        Deref(ip) => rename_expr_ptr(ip, ctx)
        MethodCall(recv_ptr, _m, args) => {
            rename_expr_ptr(recv_ptr, ctx)
            rename_expr_list(&args, ctx)
        }
        Call(_nm, args) => rename_expr_list(&args, ctx)
        FieldAccess(obj_ptr, _f) => rename_expr_ptr(obj_ptr, ctx)
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            rename_expr_ptr(c_ptr, ctx)
            rename_expr_ptr(t_ptr, ctx)
            rename_expr_ptr(e_ptr, ctx)
        }
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        StructLit(_nm, finits) => {
            while fi in &finits {
                rename_expr_ptr(fi.value, ctx)
            }
        }
        Cast(ip, _tref) => rename_expr_ptr(ip, ctx)
        DynCoerce(ip, _vtable) => rename_expr_ptr(ip, ctx)
        Retain(ip) => rename_expr_ptr(ip, ctx)
        LitInt(_) => return
        LitStr(_) => return
        LitFloat(_) => return
        LitChar(_) => return
        LitBool(_) => return
        Release(_) => return
        Lambda(_, _) => return
        // Already statements: the block-expression desugar ran first.
        Block(_) => return
        Poison => return
    }
}

fun rename_expr_list(args: &List<Expr>, ctx: &var RnCtx): void {
    while i in 0..args.size() {
        val ep: Ptr<Expr> = unsafe { args.at(i) as Ptr<Expr> }
        rename_expr_ptr(ep, ctx)
    }
}

// A pattern's binders are registered as identities: arm bodies are separate
// C blocks, so references only need to resolve to the binder.

fun Pattern.rn_register_pattern(ctx: &var RnCtx): void {
    when (self.kind) {
        Identifier(nm) => ctx.bind_identity(nm)
        Variant(_n, subs) => {
            while sub in &subs {
                sub.rn_register_pattern(ctx)
            }
        }
        StructPat(_n, binders, subs) => {
            while binder in &binders {
                ctx.bind_identity(binder)
            }
            while sub in &subs {
                sub.rn_register_pattern(ctx)
            }
        }
        // Alternatives bind nothing.
        Or(_) => return
        Range(_, _, _) => return
        Wildcard => return
        LitInt(_) => return
        LitStr(_) => return
        LitBool(_) => return
        LitChar(_) => return
        Poison => return
    }
}

fun rename_stmt_list(stmts: &List<Stmt>, ctx: &var RnCtx): void {
    while i in 0..stmts.size() {
        val sp: Ptr<Stmt> = unsafe { stmts.at(i) as Ptr<Stmt> }
        rename_stmt(sp, ctx)
    }
}

fun rename_stmt(sp: Ptr<Stmt>, ctx: &var RnCtx): void {
    when (unsafe { sp.kind }) {
        LetVal(nm, ty, init) => {
            rename_expr_ptr(init, ctx)          // init reads the OUTER scope
            val nn = ctx.rn_bind(nm)
            if nn.id != nm.id { unsafe { sp.kind = StmtKind.LetVal(nn, ty, init) } }
        }
        LetVar(nm, ty, init) => {
            rename_expr_ptr(init, ctx)
            val nn = ctx.rn_bind(nm)
            if nn.id != nm.id { unsafe { sp.kind = StmtKind.LetVar(nn, ty, init) } }
        }
        Assign(nm, expr_box) => {
            rename_expr_ptr(expr_box, ctx)
            val nn = ctx.rn_lookup(nm)          // existing binding, not a new one
            if nn.id != nm.id { unsafe { sp.kind = StmtKind.Assign(nn, expr_box) } }
        }
        AssignTo(place_box, expr_box) => {
            rename_expr_ptr(place_box, ctx)
            rename_expr_ptr(expr_box, ctx)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            rename_expr_ptr(ep, ctx)
        }
        If(cond_box, then_body, else_body) => {
            rename_expr_ptr(cond_box, ctx)
            ctx.push_scope()
            rename_stmt_list(&then_body, ctx)
            ctx.pop_scope()
            ctx.push_scope()
            rename_stmt_list(&else_body, ctx)
            ctx.pop_scope()
        }
        // The subject reads the outer scope; the binder belongs to the loop.
        ForEach(binder, subj_box, body) => {
            rename_expr_ptr(subj_box, ctx)
            ctx.push_scope()
            val nb = ctx.rn_bind(binder)
            rename_stmt_list(&body, ctx)
            ctx.pop_scope()
            if nb.id != binder.id { unsafe { sp.kind = StmtKind.ForEach(nb, subj_box, body) } }
        }
        While(cond_box, body) => {
            rename_expr_ptr(cond_box, ctx)
            ctx.push_scope()
            rename_stmt_list(&body, ctx)
            ctx.pop_scope()
        }
        When(subj_box, arms) => {
            rename_expr_ptr(subj_box, ctx)
            while a in &arms {
                ctx.push_scope()
                rn_register_pattern(unsafe { &*a.pattern }, ctx)
                rename_expr_ptr(a.guard, ctx)
                rename_stmt_list(&a.body, ctx)
                ctx.pop_scope()
            }
        }
        Expression(expr_box) => rename_expr_ptr(expr_box, ctx)
        Switch(_, _) => return
        Drop(_) => return
        Release(_) => return
        Break => return
        Continue => return
        Poison => return
    }
}

pub mutating fun Module.alpha_rename_module(): void {
    while i in 0..self.decls.size() {
        val dp: Ptr<TopDecl> = unsafe { self.decls.at(i) as Ptr<TopDecl> }
        alpha_rename_decl(dp)
    }
}

fun alpha_rename_decl(dp: Ptr<TopDecl>): void {
    when (unsafe { dp.kind }) {
        Function(params, _ret, body, _pub, _uns, _mut, _stat) => {
            var ctx = RnCtx { scopes: List.new<RnScope>(), counter: 0 }
            ctx.push_scope()
            // Params are outermost: a body `val x` shadowing param `x` is
            // renamed, the param keeps its C name.
            while item in &params {
                ctx.bind_identity(item.name)
            }
            rename_stmt_list(&body, &var ctx)
        }
        ImplBlock(methods) => {
            while mi in 0..methods.size() {
                val mp: Ptr<TopDecl> = unsafe { methods.at(mi) as Ptr<TopDecl> }
                alpha_rename_decl(mp)
            }
        }
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}
