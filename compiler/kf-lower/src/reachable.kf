// Drops the code a program cannot reach. A program merges all of `core` and
// `alloc`; hosted linkers drop the rest, but a freestanding target would fail
// to link.
//
// Keyed on the name a call site writes, not the receiver's type: Mono leaves
// substituted receivers typed as the template. Over-keeping costs little;
// under-keeping is a missing symbol.
//
// Marked by hand, since no call node names them:
//
//   operators   codegen turns `+` into `int32_add__Add`
//   glue        codegen synthesizes `<T>_drop_user` / `<T>_clone_user`

import alloc.list.*

import kf_core.ast.*


/// Indexed by Sym id, which the interner hands out densely.
pub struct Reached {
    var seen: List<bool>
}

pub fun new_reached(): Reached {
    return Reached { seen: List.new<bool>() }
}

mutating fun Reached.reached_grow(id: uint64): void {
    while self.seen.size() <= id {
        self.seen.push(false)
    }
}

/// True the first time, which drives the fixpoint.
pub mutating fun Reached.reached_mark(s: Sym): bool {
    val id = s.id as uint64
    self.reached_grow(id)
    if self.seen.get(id) { return false }
    self.seen.set(id, true)
    return true
}

pub fun Reached.reached_has(s: Sym): bool {
    val id = s.id as uint64
    if id >= self.seen.size() { return false }
    return self.seen.get(id)
}

/// `from__From__str` is `from`; "" without a `__` suffix. A trait impl's
/// method declares the long name, a call site writes the short one.
pub fun base_method_name(name: str): String {
    val n = name.byte_len()
    var i: uint64 = 0
    var end = n
    var looking = true
    while looking && i + 1 < n {
        if name.byte_at(i) == 95 {
            if name.byte_at(i + 1) == 95 {
                end = i
                looking = false
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    if end >= n { return "" }
    return name.substring(0, end)
}

/// Under the declared name or the plain method name.
pub fun Reached.name_is_reached(name: Sym): bool {
    if self.reached_has(name) { return true }
    val base = base_method_name(name.as_str())
    if base.as_str().byte_len() == 0 { return false }
    return self.reached_has(intern(base.as_str()))
}

/// `String_from__From__str` is `from`; "" without an owner prefix. The owner
/// boundary is the first single `_`. A static call records its callee only in
/// `mangled_callee`.
pub fun mangled_method_name(callee: str): String {
    val n = callee.byte_len()
    var boundary = n
    var i = 0
    var scanning = true
    while scanning && i < n {
        if callee.byte_at(i) == 95 { // '_'
            if i + 1 < n && callee.byte_at(i + 1) == 95 {
                i = i + 2
            } else {
                boundary = i
                scanning = false
            }
        } else {
            i = i + 1
        }
    }
    if boundary >= n { return "" }
    val start = boundary + 1
    var end = n
    var j = start
    var looking = true
    while looking && j + 1 < n {
        if callee.byte_at(j) == 95 {
            if callee.byte_at(j + 1) == 95 {
                end = j
                looking = false
            } else {
                j = j + 1
            }
        } else {
            j = j + 1
        }
    }
    if end <= start { return "" }
    return callee.substring(start, end)
}

/// A static call's receiver pointer is null.
fun collect_expr_at(p_opt: Ptr<Expr>?, out: &var List<Sym>, dyn_used: &var bool): void {
    val p = p_opt ?: return
    collect_expr(unsafe { &*p }, out, dyn_used)
}

/// `dyn_used`: a trait object was formed, whose vtable references methods no
/// call site names.
fun Expr.collect_expr(out: &var List<Sym>, dyn_used: &var bool): void {
    // Both the mangled symbol and the method it decodes to are marked.
    val mc = self.mangled_callee.as_str()
    if mc.byte_len() > 0 {
        out.push(self.mangled_callee)
        val decoded = mangled_method_name(mc)
        if decoded.as_str().byte_len() > 0 {
            out.push(intern(decoded.as_str()))
        }
    }
    when (self.kind) {
        Call(name, args) => {
            out.push(name)
            collect_exprs(&args, out, dyn_used)
        }
        MethodCall(recv, name, args) => {
            collect_expr_at(recv, out, dyn_used)
            out.push(name)
            collect_exprs(&args, out, dyn_used)
        }
        Binary(lhs, op, rhs) => {
            collect_expr_at(lhs, out, dyn_used)
            val m = binop_method(op)
            if m.byte_len() > 0 { out.push(intern(m)) }
            collect_expr_at(rhs, out, dyn_used)
        }
        Unary(_op, inner) => collect_expr_at(inner, out, dyn_used)
        Deref(inner) => collect_expr_at(inner, out, dyn_used)
        FieldAccess(obj, _f) => collect_expr_at(obj, out, dyn_used)
        IfExpr(cond, then_e, else_e) => {
            collect_expr_at(cond, out, dyn_used)
            collect_expr_at(then_e, out, dyn_used)
            collect_expr_at(else_e, out, dyn_used)
        }
        StructLit(_name, inits) => {
            while init in &inits {
                init.value.collect_expr(out, dyn_used)
            }
        }
        Cast(inner, _t) => collect_expr_at(inner, out, dyn_used)
        DynCoerce(inner, name) => {
            collect_expr_at(inner, out, dyn_used)
            out.push(name)
            (*dyn_used) = true
        }
        Retain(inner) => collect_expr_at(inner, out, dyn_used)
        _ => return
    }
}

fun collect_exprs(es: &List<Expr>, out: &var List<Sym>, dyn_used: &var bool): void {
    while item in &es {
        item.collect_expr(out, dyn_used)
    }
}

fun collect_stmts(stmts: &List<Stmt>, out: &var List<Sym>, dyn_used: &var bool): void {
    while stmt in &stmts {
        (stmt).collect_stmt(out, dyn_used)
    }
}

fun Stmt.collect_stmt(out: &var List<Sym>, dyn_used: &var bool): void {
    when (self.kind) {
        LetVal(_n, _t, init) => collect_expr_at(init.view(), out, dyn_used)
        LetVar(_n, _t, init) => collect_expr_at(init.view(), out, dyn_used)
        Assign(_n, value) => collect_expr_at(value, out, dyn_used)
        AssignTo(place, value) => {
            collect_expr_at(place, out, dyn_used)
            collect_expr_at(value, out, dyn_used)
        }
        Return(value) => {
            when (value) {
                Some(p) => collect_expr_at(p, out, dyn_used)
                None => return
            }
        }
        If(cond, then_body, else_body) => {
            collect_expr_at(cond, out, dyn_used)
            collect_stmts(&then_body, out, dyn_used)
            collect_stmts(&else_body, out, dyn_used)
        }
        While(cond, body) => {
            collect_expr_at(cond, out, dyn_used)
            collect_stmts(&body, out, dyn_used)
        }
        ForEach(_n, subject, body) => {
            collect_expr_at(subject, out, dyn_used)
            collect_stmts(&body, out, dyn_used)
        }
        When(subject, arms) => {
            collect_expr_at(subject, out, dyn_used)
            while arm in &arms {
                collect_expr_at(arm.guard.view(), out, dyn_used)
                collect_stmts(arm.body, out, dyn_used)
            }
        }
        Switch(subject, arms) => {
            collect_expr_at(subject, out, dyn_used)
            while arm in &arms {
                collect_expr_at(arm.guard.view(), out, dyn_used)
                collect_stmts(&arm.guard_prelude, out, dyn_used)
                collect_stmts(arm.body, out, dyn_used)
            }
        }
        Expression(value) => collect_expr_at(value, out, dyn_used)
        _ => return
    }
}

/// CONSTRAINT: the body is read in place. Returning it would move a List out
/// of a borrowed decl, and the repairing auto-clone is shallow.
fun TopDecl.collect_decl_body(out: &var List<Sym>, dyn_used: &var bool): void {
    when (self.kind) {
        Function(_p, _r, body, _pu, _u, _mu, _st) => collect_stmts(&body, out, dyn_used)
        _ => return
    }
}

fun TopDecl.decl_is_function(): bool {
    return when (self.kind) {
        Function(_p, _r, _b, _pu, _u, _m, _s) => true
        _ => false
    }
}

fun Module.module_has_main(): bool {
    while d in &self.decls {
        if d.decl_is_function() {
            if d.name.as_str() == "main" { return true }
        }
    }
    return false
}

/// Every definition with a body, flattened: free functions and methods.
pub struct DefTable {
    var names:  List<Sym>
    var owners: List<uint64>
    var slots:  List<uint64>
    var nested: List<bool>
}

fun Module.build_def_table(): DefTable {
    var out = DefTable { names: List.new<Sym>(), owners: List.new<uint64>(), slots: List.new<uint64>(), nested: List.new<bool>() }
    while i in 0..self.decls.size() {
        val d = self.decls.at(i)
        when (d.kind) {
            Function(_p, _r, _b, _pu, _u, _mu, _s) => {
                out.names.push(d.name)
                out.owners.push(i)
                out.slots.push(0)
                out.nested.push(false)
            }
            ImplBlock(methods) => {
                var j = 0
                while j < methods.size() {
                    out.names.push(methods.at(j).name)
                    out.owners.push(i)
                    out.slots.push(j)
                    out.nested.push(true)
                    j = j + 1
                }
            }
            _ => { }
        }
    }
    return out
}

fun Module.collect_def(owner: uint64, slot: uint64, nested: bool, out: &var List<Sym>, dyn_used: &var bool): void {
    val d = self.decls.at(owner)
    if !nested {
        d.collect_decl_body(out, dyn_used)
        return
    }
    when (d.kind) {
        ImplBlock(methods) => collect_decl_body(methods.at(slot), out, dyn_used)
        _ => return
    }
}

/// Once any `dyn` coercion is reachable, every trait method stays live.
fun Module.mark_trait_methods(reached: &var Reached): bool {
    var changed = false
    while d in &self.decls {
        when (d.kind) {
            TraitDecl(members, _pu, _supers) => {
                while j in 0..members.size() {
                    if reached.reached_mark(members.at(j).name) { changed = true }
                }
            }
            _ => { }
        }
    }
    return changed
}

/// A no-op without `main`: a library's exports are its API.
pub mutating fun Module.drop_unreachable(): void {
    if !self.module_has_main() { return }
    val reached = self.compute_reached()
    self.prune_module(&reached)
}

/// A program, whose unreached declarations are deleted before codegen.
pub fun Module.module_is_pruned(): bool {
    return self.module_has_main()
}

/// Reachable names without deleting anything, for the move checker, which
/// runs before pruning. Name-keyed, so it over-keeps.
pub fun Module.compute_reached(): Reached {
    var reached = new_reached()
    reached.reached_mark(intern("main"))
    // Called from type-keyed glue that no call site names.
    reached.reached_mark(intern("drop"))
    reached.reached_mark(intern("clone"))

    val defs = self.build_def_table()
    var visited = List.new<bool>()
    while _ in &defs.names {
        visited.push(false)
    }

    var dyn_used = false
    var dyn_marked = false
    var changed = true
    while changed {
        changed = false
        var i = 0
        while i < defs.names.size() {
            if !visited.get(i) && reached.name_is_reached(defs.names.get(i)) {
                visited.set(i, true)
                var refs = List.new<Sym>()
                self.collect_def(defs.owners.get(i), defs.slots.get(i), defs.nested.get(i), &var refs, &var dyn_used)

                while ref in &refs {
                    if reached.reached_mark(ref) { changed = true }
                }
            }
            i = i + 1
        }
        if dyn_used && !dyn_marked {
            dyn_marked = true
            if self.mark_trait_methods(&var reached) { changed = true }
        }
    }

    return reached
}

mutating fun Module.prune_module(reached: &Reached): void {
    while i in 0..self.decls.size() {
        prune_impl_methods(self.decls.at_mut(i), reached)
    }
    var kept = List.new<TopDecl>()
    while d in &self.decls {
        var keep = true
        when (d.kind) {
            Function(_p, _r, _b, _pu, _u, _mu, _s) => { keep = reached.name_is_reached(d.name) }
            _ => { }
        }
        if keep { kept.push(d) }
    }
    self.decls = kept
}

/// The block stays even when empty: codegen reads impls for more than bodies.
mutating fun TopDecl.prune_impl_methods(reached: &Reached): void {
    when (self.kind) {
        ImplBlock(methods) => {
            var keep_methods = List.new<TopDecl>()
            while method in &methods {
                if reached.name_is_reached(method.name) { keep_methods.push(method) }
            }
            self.kind = TopDeclKind.ImplBlock(keep_methods)
        }
        _ => return
    }
}
