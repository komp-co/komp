// Whether a body holds anything the when-expression desugar rewrites: a
// `when` used as a value, or a block expression (a list literal's).
//
// CONSTRAINT: every expression and statement kind is listed, so a new kind
// cannot hide a `when` from the desugar.

import alloc.list.*

import kf_core.ast.Arm
import kf_core.ast.Intrinsic
import kf_core.ast.expression.Expr
import kf_core.ast.expression.FieldInit
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.SwitchArm

pub fun stmts_hold_a_when_value(stmts: &List<Stmt>): bool {
    while s in &stmts {
        if s.holds_a_when_value() { return true }
    }
    return false
}

fun Stmt.holds_a_when_value(): bool {
    return when (self.kind) {
        LetVal(_n, _ty, init) => opt_holds_a_when_value(&init)
        LetVar(_n, _ty, init) => opt_holds_a_when_value(&init)
        Assign(_n, value) => value.holds_a_when_value()
        AssignTo(place, value) => place.holds_a_when_value() || value.holds_a_when_value()
        Return(value) => opt_holds_a_when_value(&value)
        If(cond, then_body, else_body) => {
            cond.holds_a_when_value() || stmts_hold_a_when_value(&then_body) || stmts_hold_a_when_value(&else_body)
        }
        While(cond, body) => cond.holds_a_when_value() || stmts_hold_a_when_value(&body)
        ForEach(_b, subject, body) => subject.holds_a_when_value() || stmts_hold_a_when_value(&body)
        When(subject, arms) => subject.holds_a_when_value() || arms_hold_a_when_value(&arms)
        Expression(e) => e.holds_a_when_value()
        Switch(subject, arms) => subject.holds_a_when_value() || switch_arms_hold_a_when_value(&arms)
        Break => false
        Continue => false
        Drop(_n) => false
        Release(_n) => false
        Poison => false
    }
}

fun opt_holds_a_when_value(value: &Box<Expr>?): bool {
    return when (value) {
        Some(e) => e.holds_a_when_value()
        None => false
    }
}

fun arms_hold_a_when_value(arms: &List<Arm>): bool {
    while a in &arms {
        if opt_holds_a_when_value(&a.guard) || stmts_hold_a_when_value(&a.body) { return true }
    }
    return false
}

fun switch_arms_hold_a_when_value(arms: &List<SwitchArm>): bool {
    while a in &arms {
        if opt_holds_a_when_value(&a.guard) || stmts_hold_a_when_value(&a.guard_prelude) { return true }
        if stmts_hold_a_when_value(&a.body) { return true }
    }
    return false
}

fun exprs_hold_a_when_value(exprs: &List<Expr>): bool {
    while e in &exprs {
        if e.holds_a_when_value() { return true }
    }
    return false
}

fun Expr.holds_a_when_value(): bool {
    return when (self.kind) {
        WhenExpr(_s, _a) => true
        Block(_stmts) => true
        LitInt(_v) => false
        LitFloat(_v) => false
        LitChar(_v) => false
        LitStr(_v) => false
        FnRef(_) => false
        LitBool(_v) => false
        Variable(_n) => false
        Release(_n) => false
        Poison => false
        Binary(l, _op, r) => l.holds_a_when_value() || r.holds_a_when_value()
        Unary(_op, inner) => inner.holds_a_when_value()
        Deref(inner) => inner.holds_a_when_value()
        Call(_n, args) => exprs_hold_a_when_value(&args)
        Intrinsic(_i, args) => exprs_hold_a_when_value(&args)
        CallValue(callee, args) => callee.holds_a_when_value() || exprs_hold_a_when_value(&args)
        MethodCall(recv, _m, args) => recv.holds_a_when_value() || exprs_hold_a_when_value(&args)
        FieldAccess(obj, _f) => obj.holds_a_when_value()
        IfExpr(c, t, el) => c.holds_a_when_value() || t.holds_a_when_value() || el.holds_a_when_value()
        StructLit(_n, finits) => field_inits_hold_a_when_value(&finits)
        Cast(inner, _t) => inner.holds_a_when_value()
        DynCoerce(inner, _v) => inner.holds_a_when_value()
        Lambda(_params, body) => stmts_hold_a_when_value(&body)
        Retain(inner) => inner.holds_a_when_value()
    }
}

fun field_inits_hold_a_when_value(finits: &List<FieldInit>): bool {
    while fi in &finits {
        if fi.value.holds_a_when_value() { return true }
    }
    return false
}
