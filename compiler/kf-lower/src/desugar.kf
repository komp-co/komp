// `when` becomes a Switch. Iteration is expanded during typecheck, since the
// `iter()`/`next()` calls it synthesizes must be resolved and typed.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.Variant
import kf_core.ast.statement.*

pub mutating fun Module.desugar_module(): void {
    while i in 0..self.decls.size() {
        desugar_top_decl(self.decls.at_mut(i))
    }
}

mutating fun TopDecl.desugar_top_decl(): void {
    when (self.kind) {
        Function(_params, _ret, body, _p, _u, _m, _s) => desugar_stmts(&var body)
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                desugar_top_decl(methods.at_mut(i))
            }
        }
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}

/// In place: only a `when` statement is replaced.
pub fun desugar_stmts(stmts: &var List<Stmt>): void {
    while i in 0..stmts.size() {
        stmts.at_mut(i).desugar_stmt()
    }
}

pub mutating fun Stmt.desugar_stmt(): void {
    when (self.kind) {
        When(subject, arms) => {
            while ai in 0..arms.size() {
                desugar_stmts(&var arms.at_mut(ai).body)
            }
            // Built from copies and held by a local, so the store frees the
            // `when` it replaces.
            val lowered = StmtKind.Switch(Box.new(subject.clone()), desugar_when_arms(&arms))
            self.kind = lowered
        }
        If(_cond, then_body, else_body) => {
            desugar_stmts(&var then_body)
            desugar_stmts(&var else_body)
        }
        While(_cond, body) => desugar_stmts(&var body)
        // Typecheck expands it; reaching here means that pass was skipped.
        ForEach(_b, _s, _bd) => { }
        LetVal(_, _, _) => { }
        LetVar(_, _, _) => { }
        Assign(_, _) => { }
        AssignTo(_, _) => { }
        Return(_) => { }
        Expression(_) => { }
        Switch(_, _) => { }
        Drop(_) => { }
        // Produced later, by rc_insert.
        Release(_) => { }
        Break => { }
        Continue => { }
        Poison => { }
    }
}

fun desugar_when_arms(arms: &List<Arm>): List<SwitchArm> {
    var out = List.new<SwitchArm>()
    while arm in &arms {
        out.push(arm.arm_to_switch())
    }
    return out
}

fun Arm.arm_to_switch(): SwitchArm {
    val pat: &Pattern = unsafe { &*self.pattern }
    var out = SwitchArm.new(self.span, pat.pattern_to_tag(), pat.pattern_binders(), self.guard.duplicate(),
        self.body.clone())
    out.ref_binders = self.ref_binders.clone()
    return out
}

fun bool_case_value(b: bool): int64 {
    if b { return 1 }
    return 0
}

fun Pattern.pattern_to_tag(): SwitchTag {
    return when (self.kind) {
        Variant(name, _) => SwitchTag.Variant(name.as_string())
        StructPat(name, _, _) => SwitchTag.Variant(name.as_string())
        Wildcard => SwitchTag.Wildcard
        // A bare binder matches anything.
        Identifier(_) => SwitchTag.Wildcard
        LitInt(n) => SwitchTag.IntLit(n)
        // `case 1:` / `case 0:`.
        LitBool(b) => SwitchTag.IntLit(bool_case_value(b))
        // A code point compares as an integer.
        LitChar(c) => SwitchTag.IntLit(c as int64)
        Range(low, high, _) => SwitchTag.Range(low, high)
        Or(alternatives) => alternatives_to_tag(&alternatives)
        // Typecheck rewrote a string arm to a binder and a guard.
        LitStr(_) => SwitchTag.Wildcard
        Poison => SwitchTag.Wildcard
    }
}

/// A catch-all alternative makes the whole arm one.
fun alternatives_to_tag(alternatives: &List<Pattern>): SwitchTag {
    var tags = List.new<SwitchTag>()
    while alternative in &alternatives {
        val tag = alternative.pattern_to_tag()
        when (tag) {
            Wildcard => return SwitchTag.Wildcard
            _ => tags.push(tag)
        }
    }
    return SwitchTag.Alternatives(tags)
}

fun Pattern.pattern_binders(): List<Sym> {
    var out = List.new<Sym>()
    self.pattern_binders_into(&var out)
    return out
}

fun Pattern.pattern_binders_into(out: &var List<Sym>): void {
    when (self.kind) {
        Identifier(name) => {
            out.push(name)
        }
        Variant(_, payloads) => {
            while sub in &payloads {
                sub.pattern_binders_into(out)
            }
        }
        StructPat(_, names, _) => {
            while item in &names {
                out.push(item)
            }
        }
        // Alternatives bind nothing; check_pattern rejects one that does.
        Or(_) => return
        Range(_, _, _) => return
        Wildcard => return
        LitInt(_) => return
        LitStr(_) => return
        LitBool(_) => return
        LitChar(_) => return
        Poison => return
    }
}
