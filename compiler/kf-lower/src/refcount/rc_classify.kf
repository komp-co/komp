import alloc.list.*

import kf_core.span.*
import kf_core.ast.Intrinsic
import kf_core.ast.view
import kf_core.ast.types.Type
import kf_core.ast.types.type_identity_display
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.coerce_clone
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_lower.ownership.names_contains

/// A hand-written `.clone()` is fresh whatever its receiver.
fun Expr.expr_is_clone_call(): bool {
    return when (self.kind) {
        MethodCall(_r, m, _a) => m.as_str().equals("clone")
        _ => false
    }
}

fun is_fresh_owned_producer(rev: Expr, ctx: &var RcCtx): bool {
    // The auto-clone coerce is fresh too.
    if rev.coerce == coerce_clone() { return true }
    if rev.expr_is_clone_call() { return true }
    val rev_ty = rev.ty
    if !(&rev_ty).is_lang_struct(ctx.string_name) { return false }
    return when (rev.kind) {
        Call(_, _) => true
        Intrinsic(_, _) => true
        CallValue(_callee, _) => true
        MethodCall(_, _, _) => true
        // A binary result is fresh; its operands drop after evaluation.
        Binary(_, _, _) => true
        _ => false
    }
}

/// Rewrites `stmts` in place, splicing each statement's hoisted temporaries
/// and early-exit releases in around it.
pub fun rc_insert_stmts(stmts: &var List<Stmt>, ctx: &var RcCtx): void {
    val n = stmts.size()
    var laid_out = List.new<Stmt>()
    var slots = List.new<uint64>()
    while i in 0..n {
        var before = List.new<Stmt>()
        var after = List.new<Stmt>()
        // Borrowed fresh temporaries (`make().as_str()`) are hoisted ahead of
        // the statement so their drop fires.
        push_rewritten(&var before, stmts.at_mut(i).collect_stmt_hoists(ctx), ctx)
        stmts.at_mut(i).rc_insert_in_list(&var before, &var after, ctx)
        laid_out.extend(before)
        slots.push(n + laid_out.size())
        laid_out.push(Stmt.new(no_span(), StmtKind.Break))
        laid_out.extend(after)
    }
    splice_into_slots(stmts, laid_out, &slots)
}

/// Appends `laid_out` and swaps each original statement into its slot there,
/// then drops the placeholders the swaps left at the front.
fun splice_into_slots(stmts: &var List<Stmt>, laid_out: List<Stmt>, slots: &List<uint64>): void {
    val n = slots.size()
    stmts.extend(laid_out)
    while i in 0..n {
        stmts.swap(i, slots.get(i))
    }
    stmts.reverse()
    while _i in 0..n {
        stmts.pop()
    }
    stmts.reverse()
}

fun push_rewritten(out: &var List<Stmt>, items: List<Stmt>, ctx: &var RcCtx): void {
    var taken = items
    while i in 0..taken.size() {
        taken.at_mut(i).rc_insert_stmt(ctx)
    }
    out.extend(taken)
}

/// Rewrites the statement, putting what runs before it on `before` and what
/// runs after it on `after`.
mutating fun Stmt.rc_insert_in_list(before: &var List<Stmt>, after: &var List<Stmt>, ctx: &var RcCtx): void {
    val span = self.span
    when (self.kind) {
        Return(ep) => {
            var exclude = returned_var_names(ep.view(), ctx)
            refine_return_exclusions(ep.view(), ctx, &var exclude)
            val rel_count = ctx.exit_releases(false, &exclude).size()
            if return_drops_after_eval(ep.view(), rel_count, ctx) {
                after.extend(ctx.exit_releases(false, &exclude))
                after.push(self.bind_return_value(ctx))
            } else {
                before.extend(ctx.exit_releases(false, &exclude))
            }
        }
        Break => before.extend(ctx.exit_releases(true, &List.new<String>()))
        Continue => before.extend(ctx.exit_releases(true, &List.new<String>()))
        Switch(subj_ptr, _arms) => {
            // An owning rvalue subject is bound to a temp first.
            push_rewritten(before, hoist_owned_when_subject(subj_ptr, span, ctx), ctx)
            self.rc_insert_stmt(ctx)
        }
        // Ends one ownership and begins one; see rc_assign.kf.
        Assign(asn_name, rhs_ptr) => {
            val name = asn_name
            val prior = assign_ownership_before(name, rhs_ptr, ctx)
            val old = self_read_assign_old(name, rhs_ptr, &prior, span, ctx, before)
            self.rc_insert_stmt(ctx)
            // `s = s + x` borrows `s`; `s = concat(s, x)` consumes it and
            // gets the same buffer back.
            val still_owning = ctx.rc_owning_frame(name.as_str()) >= 0
            before.extend(assign_ownership_after(name, span, &prior, ctx))
            if !still_owning { return }
            val nm = old ?: return
            after.push(Stmt.new(span, StmtKind.Release(nm)))
        }
        // The old value is named, then released after the store.
        AssignTo(place_ptr, rhs_ptr) => {
            place_rhs_take_ownership(rhs_ptr, ctx)
            val old = lower_place_assign_drop(place_ptr, rhs_ptr, span, ctx, before)
            self.rc_insert_stmt(ctx)
            val nm = old ?: return
            after.push(Stmt.new(span, StmtKind.Release(nm)))
        }
        _ => self.rc_insert_stmt(ctx)
    }
}

// `val x = y` on a heap type: ownership moves, with no retain and no release
// of the source. "" if not a bare variable.
fun move_source_name(init: Expr): String {
    return when (init.kind) {
        Variable(n) => n.as_string()
        _ => ""
    }
}

// `val v = *ptr` binds a borrow: no retain, no scope-exit drop.
fun is_deref_init(init: Expr): bool {
    return when (init.kind) {
        Deref(_) => true
        _ => false
    }
}

enum BindingMode { OwnedFresh, OwnedRetain, Moved, Borrowed }

// A call returning a move-only value by value hands off ownership.
fun is_move_only_call_result(init: Expr, ctx: &var RcCtx): bool {
    return when (init.kind) {
        Call(_, _) => init.ty.is_move_only(ctx)
        Intrinsic(_, _) => init.ty.is_move_only(ctx)
        CallValue(_callee, _) => init.ty.is_move_only(ctx)
        MethodCall(_, _, _) => init.ty.is_move_only(ctx)
        _ => false
    }
}

// A binary producing a move-only value is fresh: concat borrows its operands
// and a struct operator returns a new value.
fun is_fresh_binary(init: Expr, ctx: &var RcCtx): bool {
    return when (init.kind) {
        Binary(_, _, _) => init.ty.is_move_only(ctx)
        _ => false
    }
}

/// Fresh, a clone, or a moved bare variable. A deref or a field read is a
/// view, as it is when bound directly.
fun if_branch_is_owned(bp: Ptr<Expr>, ctx: &var RcCtx): bool {
    val e = unsafe { *bp }
    if e.coerce == coerce_clone() { return true }
    if is_deref_init(e) { return false }
    return when (e.kind) {
        FieldAccess(_, _) => false
        _ => true
    }
}

/// Every branch must be fresh; `if c { *xs.at(i) } else { fresh }` is not.
fun is_move_only_if_expr(init: Expr, ctx: &var RcCtx): bool {
    when (init.kind) {
        IfExpr(_c, t_ptr, e_ptr) => {
            if !init.ty.is_move_only(ctx) { return false }
            if !if_branch_is_owned(t_ptr, ctx) { return false }
            return if_branch_is_owned(e_ptr, ctx)
        }
        _ => return false
    }
}

fun classify_binding(init: Expr, ctx: &var RcCtx): BindingMode {
    // Must come first: an auto-cloned init owns a fresh copy and must not mark
    // its source moved.
    if init.coerce == coerce_clone() { return BindingMode.OwnedFresh }
    // A trait-object coercion packages a borrow; it transfers nothing.
    when (init.kind) {
        DynCoerce(_, _) => return BindingMode.Borrowed
        _ => { }
    }
    if is_deref_init(init) { return BindingMode.Borrowed }
    val msrc = move_source_name(init)
    if !msrc.as_str().equals("") { return BindingMode.Moved }
    // Retaining a clone would copy twice.
    if init.coerce == coerce_clone() { return BindingMode.OwnedFresh }
    if init.expr_is_clone_call() { return BindingMode.OwnedFresh }
    if is_fresh_alloc(init) { return BindingMode.OwnedFresh }
    // Before the move-only borrow rule.
    if is_move_only_call_result(init, ctx) { return BindingMode.OwnedFresh }
    if is_fresh_binary(init, ctx) { return BindingMode.OwnedFresh }
    // Each branch is fresh or moves a bare variable in.
    if is_move_only_if_expr(init, ctx) { return BindingMode.OwnedFresh }
    if init.ty.is_move_only(ctx) { return BindingMode.Borrowed }
    return BindingMode.OwnedRetain
}

fun apply_binding_mode(mode: BindingMode, name: String, init_ptr: Ptr<Expr>, ctx: &var RcCtx): void {
    when (mode) {
        Borrowed => { ctx.add_view_local(name) }
        OwnedFresh => { ctx.add_heap_local(name) }
        Moved => {
            val source = move_source_name(unsafe { *init_ptr })
            // Bound from a view, the binding is a view too.
            if ctx.is_view_local(source.as_str()) {
                ctx.add_view_local(name)
                return
            }
            ctx.add_heap_local(name)
            // A loop-carried source is cloned (see consume_var_site).
            consume_var_site(init_ptr, source, ctx)
        }
        OwnedRetain => {
            ctx.add_heap_local(name)
            val init = unsafe { *init_ptr }
            val isp: Span = init.span
            val ity: Type = init.ty
            val inner: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *inner = init }
            var retained = Expr.new(isp, ExprKind.Retain(inner))
            retained.ty = ity
            unsafe { *init_ptr = retained }
        }
    }
}

fun Type.is_move_only(ctx: &var RcCtx): bool {
    when (self.kind) {
        // A non-fresh Box read is a borrow; `Box.new` was classified earlier.
        BoxOf(_) => return true
        Struct(n) => {
            val name = type_identity_display(n)
            return names_contains(ctx.move_only_names, name.as_str())
        }
        EnumTy(n) => return names_contains(ctx.move_only_names, type_identity_display(n).as_str())
        _ => return false
    }
}
