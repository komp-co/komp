// Who owns an enum payload after a `when` matches it.
//
// A `when` consumes its subject when some arm moves a move-only payload out.
// The subject is then not dropped at scope end; instead:
//
//   * an arm binding the payload owns it through the binder;
//   * an arm binding nothing takes the whole subject, so the enum's drop
//     glue runs at its end.
//
// The trigger is a move, not a mention: a binder passed to a constructor or
// call escapes, one read through a field or as a receiver does not. Missing
// an escape frees twice; inventing one frees never.

import alloc.list.*

import kf_core.ast.Intrinsic
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.type_identity_display
import kf_core.ast.expression.Expr
import kf_core.ast.expression.coerce_addr_of
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.SwitchArm
import kf_lower.ownership.names_contains

/// "" for a field or deref, which is only borrowed.
pub fun Expr.when_subject_var(): String {
    return when (self.kind) {
        Variable(name) => name.as_string()
        _ => ""
    }
}

/// Accepts `Struct` too: a monomorphized enum instance is typed as one.
pub fun Expr.when_subject_enum(): String {
    return when (self.ty.kind) {
        Struct(name) => type_identity_display(name)
        EnumTy(name) => type_identity_display(name)
        _ => ""
    }
}

/// Mirrors `is_move_only`'s Struct arm.
fun payload_owns(tyname: str, ctx: &var RcCtx): bool {
    return names_contains(ctx.move_only_names, tyname)
}

/// A `_` binder declines the payload, which the arm must still drop.
fun SwitchArm.arm_binds_real(i: uint64): bool {
    if i >= self.binders.size() { return false }
    return !self.binders.at(i).as_str().equals("_")
}

fun SwitchArm.arm_variant_name(): String {
    return when (self.tag) {
        Variant(name) => name.clone()
        _ => ""
    }
}

/// `name` is moved somewhere that outlives the arm: `return v`,
/// `return Option.Some(v)`, a call or constructor argument, a struct-literal
/// field, an if-expression branch. A method receiver or field read only
/// borrows, and treating a read as an escape leaves the payload freed by
/// nobody.
fun Expr.expr_moves_out(name: str): bool {
    if self.expr_is_move_of(name) { return true }
    when (self.kind) {
        Call(_n, args) => return any_arg_moves_out(&args, name)
        Intrinsic(_i, args) => return any_arg_moves_out(&args, name)
        CallValue(_callee, args) => return any_arg_moves_out(&args, name)
        // The receiver is borrowed; only arguments are searched.
        MethodCall(_recv, _m, args) => return any_arg_moves_out(&args, name)
        IfExpr(_c, t, el) => {
            if expr_moves_out(unsafe { &*t }, name) { return true }
            return expr_moves_out(unsafe { &*el }, name)
        }
        StructLit(_n, finits) => {
            while finit in &finits {
                if expr_moves_out(unsafe { &*finit.value }, name) { return true }
            }
            return false
        }
        _ => return false
    }
    return false
}

/// `name`, possibly under a cast or retain. An argument marked
/// `coerce_addr_of` (`f(&v)`) is not a move, agreeing with
/// `check_consumed_arg`.
fun Expr.expr_is_move_of(name: str): bool {
    if self.coerce == coerce_addr_of() { return false }
    when (self.kind) {
        Variable(n) => return n.as_str().equals(name)
        Cast(i, _t) => return expr_is_move_of(unsafe { &*i }, name)
        Retain(i) => return expr_is_move_of(unsafe { &*i }, name)
        DynCoerce(i, _v) => return expr_is_move_of(unsafe { &*i }, name)
        _ => return false
    }
    return false
}

fun any_arg_moves_out(args: &List<Expr>, name: str): bool {
    while arg in &args {
        if arg.expr_moves_out(name) { return true }
    }
    return false
}

/// Assigned to something outside the arm, or returned.
fun stmts_move_out(stmts: &List<Stmt>, name: str): bool {
    while stmt in &stmts {
        if stmt_moves_out(stmt, name) { return true }
    }
    return false
}

fun stmt_moves_out(s: Stmt, name: str): bool {
    when (s.kind) {
        // `val s = <binder>` then `return Option.Some(s)`: the two-step escape
        // `?` and `?:` emit.
        LetVal(_n, _t, init) => {
            val p = init ?: return false
            return expr_moves_out(unsafe { &*p }, name)
        }
        LetVar(_n, _t, init) => {
            val p = init ?: return false
            return expr_moves_out(unsafe { &*p }, name)
        }
        Expression(e) => { return expr_moves_out(unsafe { &*e }, name) }
        Assign(_target, rhs) => { return expr_moves_out(unsafe { &*rhs }, name) }
        AssignTo(_place, rhs) => { return expr_moves_out(unsafe { &*rhs }, name) }
        Return(e) => {
            when (e) {
                Some(p) => { return expr_moves_out(unsafe { &*p }, name) }
                None => { return false }
            }
        }
        If(_c, then_body, else_body) => {
            return stmts_move_out(&then_body, name) || stmts_move_out(&else_body, name)
        }
        While(_c, body) => { return stmts_move_out(&body, name) }
        Switch(_subj, arms) => { return arms_move_out(&arms, name) }
        _ => { return false }
    }
    return false
}

fun arms_move_out(arms: &List<SwitchArm>, name: str): bool {
    while arm in &arms {
        if stmts_move_out(arm.body, name) { return true }
    }
    return false
}

/// Gives every owning payload an arm declined a generated name, so it is
/// dropped like any binder. Scalars are left unnamed. Names come from
/// `block_counter`, so they are stable across runs, which the fixpoint needs.
pub fun name_declined_payloads(arms: &var List<SwitchArm>, ename: str, ctx: &var RcCtx): void {
    while i in 0..arms.size() {
        arms.at_mut(i).name_declined(ename, ctx)
    }
}

mutating fun SwitchArm.name_declined(ename: str, ctx: &var RcCtx): void {
    val vname = self.arm_variant_name()
    // A wildcard arm keeps the whole-subject drop.
    if vname.as_str().equals("") { return }
    val n = variant_payload_count(unsafe { &*ctx.variants }, ename, vname.as_str())
    if n == 0 { return }

    var binders = List.new<Sym>()
    var changed = false
    while i in 0..n {
        if self.arm_binds_real(i) {
            binders.push(self.binders.get(i))
        } else {
            val ty = variant_payload_type(unsafe { &*ctx.variants }, ename, vname.as_str(), i)
            if payload_owns(ty.as_str(), ctx) {
                val id = ctx.block_counter
                ctx.block_counter = id + 1
                binders.push(intern("__declined_${u64_to_str(id)}"))
                changed = true
            } else if i < self.binders.size() {
                binders.push(self.binders.get(i))
            } else {
                binders.push(intern("_"))
            }
        }
    }
    if changed { self.binders = binders }
}

/// A bare variable subject of an enum this module declares, which is a
/// hoisted fresh value or has an arm that hands an owning payload out.
pub fun Expr.when_consumes_subject(arms: &List<SwitchArm>, ctx: &var RcCtx): bool {
    val sname = self.when_subject_var()
    if sname.as_str().equals("") { return false }
    val ename = self.when_subject_enum()
    if ename.as_str().equals("") { return false }
    if !variant_payloads_knows(unsafe { &*ctx.variants }, ename.as_str()) { return false }
    // A binder lent to the `when`'s value must outlive the arm, so the
    // subject stays the enclosing scope's and the binders are views of it.
    if arms_lend_a_binder(arms, ctx) && !arms_let_a_binder_out(arms, ctx) { return false }
    // CONSTRAINT: the move check gives the binders of a fresh subject its
    // payload, so a hoisted one is always consumed.
    if is_hoisted_subject(sname.as_str()) { return true }
    var escapes = false
    while arm in &arms {
        val vname = arm.arm_variant_name()
        if !vname.as_str().equals("") {
            val n = variant_payload_count(unsafe { &*ctx.variants }, ename.as_str(), vname.as_str())
            var p = 0
            while p < n {
                val ty = variant_payload_type(unsafe { &*ctx.variants }, ename.as_str(), vname.as_str(), p)
                if payload_owns(ty.as_str(), ctx) && arm.arm_binds_real(p) {
                    if stmts_move_out(&arm.body, arm.binders.at(p).as_str()) { escapes = true }
                }
                p = p + 1
            }
        }
    }
    return escapes
}

/// The arm's owning binders, or the subject itself when it binds none.
pub fun SwitchArm.arm_owned_names(ename: str, subject: str, ctx: &var RcCtx): List<String> {
    var out = List.new<String>()
    val vname = self.arm_variant_name()
    if !vname.as_str().equals("") {
        val n = variant_payload_count(unsafe { &*ctx.variants }, ename, vname.as_str())
        var i = 0
        while i < n {
            val ty = variant_payload_type(unsafe { &*ctx.variants }, ename, vname.as_str(), i)
            if payload_owns(ty.as_str(), ctx) && self.arm_binds_real(i) {
                out.push(self.binders.at(i).as_string())
            }
            i = i + 1
        }
    }
    if out.size() > 0 { return out }
    // Unless a binder escaped: the drop glue frees by layout and would free
    // what the escapee holds. Dropping nothing only leaks.
    if self.arm_lets_a_binder_out(ctx) { return out }
    out.push(String.from(subject))
    return out
}

fun SwitchArm.arm_lets_a_binder_out(ctx: &var RcCtx): bool {
    var i = 0
    while i < self.binders.size() {
        if self.arm_binds_real(i) {
            if stmts_move_out(&self.body, self.binders.at(i).as_str()) { return true }
        }
        i = i + 1
    }
    return false
}

/// Binders the arm does not own are views of the subject's payload.
pub fun SwitchArm.rc_add_binder_views(owned: &List<String>, ctx: &var RcCtx): void {
    while b in &self.binders {
        if !b.as_str().equals("_") && !names_contains(owned, b.as_str()) { ctx.add_view_local(b.as_string()) }
    }
}

fun arms_let_a_binder_out(arms: &List<SwitchArm>, ctx: &var RcCtx): bool {
    while arm in &arms {
        if arm.arm_lets_a_binder_out(ctx) { return true }
    }
    return false
}

fun arms_lend_a_binder(arms: &List<SwitchArm>, ctx: &var RcCtx): bool {
    while arm in &arms {
        if arm.arm_lends_a_binder(ctx) { return true }
    }
    return false
}

/// The arm stores a value that may borrow one of its binders in the
/// `when`'s result (`__whenN = b.as_str()`), which is read after the arm.
fun SwitchArm.arm_lends_a_binder(ctx: &var RcCtx): bool {
    while stmt in &self.body {
        when (stmt.kind) {
            Assign(target, rhs) => {
                if target.as_str().starts_with("__when") && !rhs.ty.holds_no_borrow(ctx) {
                    var named = List.new<String>()
                    rhs.collect_escaping_names(ctx, &var named)
                    while b in &self.binders {
                        if names_contains(&named, b.as_str()) { return true }
                    }
                }
            }
            _ => { }
        }
    }
    return false
}
