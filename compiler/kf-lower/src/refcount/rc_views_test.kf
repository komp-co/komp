import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.expression.Expr
import kf_core.ast.expression.coerce_clone
import kf_core.ast.statement.*

fun string_var(name: str): Ptr<Expr> {
    val p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *p = mk_string_var_expr(String.from(name)) }
    return p
}

@test fun a_binding_moved_from_a_view_owns_nothing(): void {
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_view_local(String.from("d"))
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVar(intern("lowered"), null, string_var("d"))))
    rc_insert_stmts(&var body, &var ctx)
    assert_eq(ctx.rc_owning_frame("lowered") < 0, true, "not registered as owning what `d` only borrows")
    assert_eq(ctx.is_view_local("lowered"), true, "and a view itself, so the next binding from it is one too")
}

@test fun a_binding_moved_from_an_owner_still_takes_it(): void {
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("a"))
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("b"), null, string_var("a"))))
    rc_insert_stmts(&var body, &var ctx)
    assert_eq(ctx.rc_owning_frame("b") >= 0, true, "the new binding owns the value")
    assert_eq(ctx.rc_owning_frame("a") < 0, true, "and the source no longer does")
}

@test fun an_owner_at_the_same_depth_outranks_a_view(): void {
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_view_local(String.from("x"))
    ctx.add_heap_local(String.from("x"))
    assert_eq(ctx.is_view_local("x"), false, "an assignment that gave `x` a value of its own made it an owner")
    assert_eq(ctx.is_view_local("never_seen"), false, "a name the pass never recorded is not a view")
}

@test fun an_assignment_from_a_view_takes_a_copy(): void {
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("x"))
    ctx.add_view_local(String.from("d"))
    val rhs = string_var("d")
    val before = assign_ownership_before(intern("x"), rhs, &var ctx)
    assert_eq(unsafe { rhs.coerce } == coerce_clone(), true, "`x` owns what it holds, so it gets its own copy")
    assert_eq(before.rhs_owned_fresh, true, "which the assignment may then drop the old value for")
}

@test fun a_binder_the_arm_does_not_own_is_a_view(): void {
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    var binders = List.new<Sym>()
    binders.push(intern("payload"))
    binders.push(intern("_"))
    var body = List.new<Stmt>()
    body.push(Stmt.new(no_span(), StmtKind.LetVal(intern("kept"), null, string_var("payload"))))
    val arm = SwitchArm.new(no_span(), SwitchTag.Variant(String.from("Some")), binders, null, body)
    val _vi = ctx.push_frame(false)
    arm.rc_add_binder_views(&List.new<String>(), &var ctx)
    assert_eq(ctx.is_view_local("payload"), true, "the binder reads the subject's payload in place")
    assert_eq(ctx.is_view_local("_"), false, "a declined payload names nothing")
}
