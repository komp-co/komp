import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.BinOp
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

fun guard_of(kind: ExprKind, ty: Type): Ptr<Expr>? {
    val guard: Ptr<Expr> = unsafe { alloc<Expr>() }
    var e = Expr.new(no_span(), kind)
    e.ty = ty
    unsafe { *guard = e }
    return Option.Some<Ptr<Expr>>(guard)
}

@test fun an_unguarded_arm_has_no_prelude(): void {
    var ctx = rc_ctx_for_test("f")
    assert_eq(guard_temporaries(null, &var ctx).size(), 0, "nothing to bind")
}

@test fun a_guard_owning_nothing_has_no_prelude(): void {
    var ctx = rc_ctx_for_test("f")
    val guard = guard_of(ExprKind.LitBool(true), Type.new_bool(no_span()))
    assert_eq(guard_temporaries(guard, &var ctx).size(), 0, "a literal owns nothing")
}

// `make().byte_len() == 3`: the fresh `String` receiver is bound, the guard's
// value is bound, and the receiver is released.
@test fun a_fresh_receiver_in_a_guard_is_bound_and_released(): void {
    var ctx = rc_ctx_for_test("f")
    val string_ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    val receiver: Ptr<Expr> = unsafe { alloc<Expr>() }
    var made = Expr.new(no_span(), ExprKind.Call(intern("make"), List.new<Expr>()))
    made.ty = string_ty
    unsafe { *receiver = made }
    val length: Ptr<Expr> = unsafe { alloc<Expr>() }
    var call = Expr.new(no_span(), ExprKind.MethodCall(receiver, intern("byte_len"), List.new<Expr>()))
    call.ty = Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
    unsafe { *length = call }
    val three: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *three = Expr.new(no_span(), ExprKind.LitInt(3)) }
    val guard = guard_of(ExprKind.Binary(length, BinOp.Eq, three), Type.new_bool(no_span()))
    assert_eq(guard_temporaries(guard, &var ctx).size(), 3, "bind the receiver, bind the value, release")
}
