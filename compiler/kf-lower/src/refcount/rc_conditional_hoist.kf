import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.UnaryOp
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_typecheck.types.type_to_type_ref

// A hoisted temporary runs before its statement, so one from a part that runs
// only sometimes, the right of `&&` or `||` or a branch of an `if` value,
// goes into an `if` that runs it when that part would run:
//
//   if ready && make().size() == 0 { .. }   ->   var __sc_N: bool = ready
//                                                if __sc_N { val __tmp_M = make()
//                                                            __sc_N = __tmp_M.size() == 0 }
//                                                if __sc_N { .. }

/// `a && b` or `a || b` whose right operand hoists becomes a local the left
/// sets, and the right resets when the left does not decide.
fun hoist_short_circuit(ep: Ptr<Expr>, left: Ptr<Expr>, is_and: bool, right: Ptr<Expr>, ctx: &var RcCtx,
    out: &var List<Stmt>): void {
    hoist_borrowed_temps(left, ctx, out)
    var right_hoists = List.new<Stmt>()
    hoist_borrowed_temps(right, ctx, &var right_hoists)
    if right_hoists.is_empty() { return }
    val e = unsafe { *ep }
    val result = fresh_conditional_local("__sc_", ctx)
    out.push(Stmt.new(e.span, StmtKind.LetVar(result, annotation_for(&e.ty, e.span), moved_out(left))))
    var decided = local_read(result, &e.ty, e.span)
    if !is_and {
        decided = Expr.new(e.span, ExprKind.Unary(UnaryOp.Not, Box.new(decided)))
        decided.ty = e.ty
    }
    right_hoists.push(Stmt.new(e.span, StmtKind.Assign(result, moved_out(right))))
    out.push(Stmt.new(e.span, StmtKind.If(Box.new(decided), right_hoists, List.new<Stmt>())))
    replace_with_local(ep, result, &e)
}

/// `if c { a } else { b }` as a value, a branch of which hoists, becomes a
/// local each branch fills after its own temporaries.
fun hoist_if_value(ep: Ptr<Expr>, cond: Ptr<Expr>, then_value: Ptr<Expr>, else_value: Ptr<Expr>, ctx: &var RcCtx,
    out: &var List<Stmt>): void {
    hoist_borrowed_temps(cond, ctx, out)
    var then_hoists = List.new<Stmt>()
    hoist_borrowed_temps(then_value, ctx, &var then_hoists)
    var else_hoists = List.new<Stmt>()
    hoist_borrowed_temps(else_value, ctx, &var else_hoists)
    if then_hoists.is_empty() && else_hoists.is_empty() { return }
    val e = unsafe { *ep }
    val result = fresh_conditional_local("__ifv_", ctx)
    out.push(Stmt.new(e.span, StmtKind.LetVar(result, annotation_for(&e.ty, e.span), null)))
    then_hoists.push(Stmt.new(e.span, StmtKind.Assign(result, moved_out(then_value))))
    else_hoists.push(Stmt.new(e.span, StmtKind.Assign(result, moved_out(else_value))))
    out.push(Stmt.new(e.span, StmtKind.If(moved_out(cond), then_hoists, else_hoists)))
    replace_with_local(ep, result, &e)
}

fun fresh_conditional_local(prefix: str, ctx: &var RcCtx): Sym {
    val id = ctx.block_counter
    ctx.block_counter = id + 1
    return intern("${prefix}${u64_to_str(id)}")
}

fun annotation_for(ty: &Type, span: Span): Box<TypeRef>? {
    return Box.new(type_to_type_ref(ty, span))
}

/// The node at `p`, moved into a box of its own.
fun moved_out(p: Ptr<Expr>): Box<Expr> {
    return Box.new(unsafe { *p })
}

fun local_read(name: Sym, ty: &Type, span: Span): Expr {
    var read = Expr.new(span, ExprKind.Variable(name))
    read.ty = ty.clone()
    return read
}

/// The expression becomes a read of `name`, keeping how it was passed.
fun replace_with_local(ep: Ptr<Expr>, name: Sym, was: &Expr): void {
    var read = local_read(name, &was.ty, was.span)
    read.coerce = was.coerce
    unsafe { *ep = read }
}
