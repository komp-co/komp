import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Intrinsic
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_lower.ownership.*

@derive(Clone)
pub struct RcFrame {
    pub val block_idx: uint64
    pub var heap_locals: List<String>
    pub val is_loop: bool
    /// Bindings here that own nothing: borrows, or moved from one.
    pub var view_locals: List<String>
}

pub struct RcCtx {
    pub var fn_name: String
    pub var frame_stack: List<RcFrame>
    pub var block_counter: uint64
    pub var move_only_names: List<String>
    /// Types whose values cannot hold a borrow; see rc_borrow_free.kf.
    pub var borrow_free: List<String>
    // Decides per callee whether a by-value String argument transfers
    // ownership (a komp function drops it) or is only lent (an extern keeps
    // the caller's drop).
    pub var ptable: Ptr<List<ParamEntry>>
    // Which payloads of each variant own something. By pointer: built once.
    pub var variants: Ptr<VariantPayloads>
    // The graph's `@lang("string")` type, or the empty name.
    pub var string_name: Sym
}

pub fun new_rc_ctx(fn_name: String): RcCtx {
    val tp: Ptr<List<ParamEntry>> = unsafe { alloc<List<ParamEntry>>() }
    unsafe { *tp = List.new<ParamEntry>() }
    val vp: Ptr<VariantPayloads> = unsafe { alloc<VariantPayloads>() }
    unsafe { *vp = no_variant_payloads() }
    return RcCtx {
        fn_name: fn_name,
        frame_stack: List.new<RcFrame>(),
        block_counter: 0,
        move_only_names: List.new<String>(),
        borrow_free: List.new<String>(),
        ptable: tp,
        variants: vp,
        string_name: intern("")
    }
}

pub mutating fun RcCtx.push_frame(is_loop: bool): uint64 {
    val idx = self.block_counter
    self.block_counter = idx + 1
    val f = RcFrame { block_idx: idx, heap_locals: List.new<String>(), is_loop: is_loop,
        view_locals: List.new<String>() }
    self.frame_stack.push(f)
    return idx
}

/// -1 for a binding that owns nothing now. The index matters: a binding
/// declared outside a loop must not be dropped per iteration.
pub fun RcCtx.rc_owning_frame(name: str): int64 {
    var found: int64 = 0 - 1
    while i in 0..self.frame_stack.size() {
        if names_contains(&self.frame_stack.at(i).heap_locals, name) { found = i as int64 }
    }
    return found
}

/// For a binding given a new value after its rhs consumed the old one.
pub mutating fun RcCtx.restore_heap_local_at(idx: uint64, name: String): void {
    val f = self.frame_stack.at_mut(idx)
    if !names_contains(&f.heap_locals, name.as_str()) { f.heap_locals.push(name) }
}

pub mutating fun RcCtx.add_heap_local(name: String): void {
    val top_idx = self.frame_stack.size() - 1
    self.frame_stack.at_mut(top_idx).heap_locals.push(name)
}

/// Record `name` as a binding in the current scope that owns nothing.
pub mutating fun RcCtx.add_view_local(name: String): void {
    val top_idx = self.frame_stack.size() - 1
    self.frame_stack.at_mut(top_idx).view_locals.push(name)
}

/// A name never recorded either way is not a view.
pub fun RcCtx.is_view_local(name: str): bool {
    var view_frame: int64 = 0 - 1
    while i in 0..self.frame_stack.size() {
        if names_contains(&self.frame_stack.at(i).view_locals, name) { view_frame = i as int64 }
    }
    return view_frame >= 0 && view_frame > self.rc_owning_frame(name)
}

/// One Release per heap local, in reverse declaration order.
pub mutating fun RcCtx.pop_frame(): List<Stmt> {
    val top_idx = self.frame_stack.size() - 1
    var releases = List.new<Stmt>()
    val f = self.frame_stack.at(top_idx)
    var i: uint64 = f.heap_locals.size()
    while i > 0 {
        i = i - 1
        releases.push(Stmt.new(no_span(), StmtKind.Release(intern(f.heap_locals.at(i).as_str()))))
    }
    self.frame_stack.pop()
    return releases
}

/// 0 = untracked (borrowed or moved: leave alone); 1 = same region (plain
/// move, elide the drop); 2 = loop-carried (clone at the consume and keep the
/// drop, since the back-edge may read it again).
pub mutating fun RcCtx.consume_kind(name: String): uint8 {
    var var_frame: uint64 = 0
    var found = false
    while i in 0..self.frame_stack.size() {
        if names_contains(&self.frame_stack.at(i).heap_locals, name.as_str()) {
            var_frame = i
            found = true
        }
    }
    if !found { return 0 }
    var j: uint64 = var_frame + 1
    while j < self.frame_stack.size() {
        if self.frame_stack.at(j).is_loop { return 2 }
        j = j + 1
    }
    return 1
}

/// Releases an early jump emits, top frame down, without popping.
/// `stop_at_loop` stops after the first loop frame (break/continue). Names in
/// `exclude`, which the jump still reads, are skipped.
mutating fun RcCtx.exit_releases(stop_at_loop: bool, exclude: &List<String>): List<Stmt> {
    var releases = List.new<Stmt>()
    var fi: uint64 = self.frame_stack.size()
    while fi > 0 {
        fi = fi - 1
        val f = self.frame_stack.at(fi)
        var li: uint64 = f.heap_locals.size()
        while li > 0 {
            li = li - 1
            val name = f.heap_locals.at(li)
            val excluded = names_contains(exclude, name.as_str())
            if !excluded {
                releases.push(Stmt.new(no_span(), StmtKind.Release(intern(name.as_str()))))
            }
        }
        if stop_at_loop && f.is_loop {
            break
        }
    }
    return releases
}

// A terminator already emitted every live frame's releases, so none are
// appended after it.
fun Stmt.is_terminator(): bool {
    return when (self.kind) {
        Return(_) => true
        Break => true
        Continue => true
        _ => false
    }
}

fun append_releases(body: &var List<Stmt>, releases: List<Stmt>): void {
    if body.size() > 0 && body.at(body.size() - 1).is_terminator() { return }
    body.extend(releases)
}

// `str`, and a returned `Ptr<T>`/`&T`: may point into a local, so every named
// local stays alive.
fun ty_is_view(ty: Type): bool {
    return when (ty.kind) {
        StrTy => true
        PtrTo(_) => true
        RefTo(_, _) => true
        _ => false
    }
}

fun is_heap_ty_rc(ty: Type): bool {
    return when (ty.kind) {
        Struct(_) => true
        EnumTy(_) => true
        Int8 => false
        Int16 => false
        Int32 => false
        Int64 => false
        UInt8 => false
        UInt16 => false
        UInt32 => false
        UInt64 => false
        Float32 => false
        Float64 => false
        Bool => false
        Char => false
        StrTy => false
        Void => false
        Never => false
        TraitTy(_) => false
        DynTraitTy(_) => false
        Generic(_) => false
        PtrTo(_) => false
        BoxOf(_) => true
        RefTo(_, _) => false
        FnTy(_) => false
        // Mono resolves every projection.
        Projection(_, _) => false
        Value(_) => false
        Poison => false
    }
}

/// Already owned, needing no retain: a `from(...)`, `List.new<T>()`, a heap
/// struct literal, a Retain.
fun is_fresh_alloc(e: Expr): bool {
    when (e.kind) {
        Call(name, _) => {
            val s = name.as_str()
            val is_take = s.equals("take")
            if is_take { return true }
            return false
        }
        Intrinsic(_, _) => return false
        StructLit(_, _) => return true
        MethodCall(_, m, _) => {
            val s = m.as_str()
            val is_from = s.equals("from")
            if is_from { return true }
            // A static `.new(...)` returns a fresh value.
            val is_new = s.equals("new")
            if is_new { return true }
            return false
        }
        Retain(_) => return true
        FnRef(_) => return false
        CallValue(_, _) => return false
        LitInt(_) => return false
        LitStr(_) => return false
        LitFloat(_) => return false
        LitChar(_) => return false
        LitBool(_) => return false
        Variable(_) => return false
        Binary(_, _, _) => return false
        Unary(_, _) => return false
        Deref(_) => return false
        FieldAccess(_, _) => return false
        IfExpr(_, _, _) => return false
        WhenExpr(_, _) => return false
        Cast(_, _) => return false
        DynCoerce(_, _) => return false
        Release(_) => return false
        Lambda(_, _) => return false
        Block(_) => return false
        Poison => return false
    }
}
