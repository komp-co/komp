import alloc.list.*

import kf_core.span.*
import kf_core.ast.Intrinsic
import kf_core.ast.intern
import kf_core.ast.view
import kf_core.ast.expression.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.statement.SwitchArm

// `when (make())`: an owning rvalue subject is hoisted into a local so its
// scope-exit drop fires. Borrowed subjects are left alone. Returns the
// binding to emit before the switch, if any.
fun hoist_owned_when_subject(subj_ptr: Ptr<Expr>, span: Span, ctx: &var RcCtx): List<Stmt> {
    var out = List.new<Stmt>()
    val subj = unsafe { *subj_ptr }
    if !is_heap_ty_rc(subj.ty) { return out }
    when (subj.kind) {
        Call(_, _) => { }
        Intrinsic(_, _) => { }
        CallValue(_callee, _) => { }
        MethodCall(_, _, _) => { }
        _ => return out
    }
    val mode = classify_binding(subj, ctx)
    when (mode) {
        OwnedFresh => { }
        _ => return out
    }
    val tmp_id = ctx.block_counter
    ctx.block_counter = tmp_id + 1
    val tmp_name = "${hoisted_subject_prefix()}${u64_to_str(tmp_id)}"
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = subj }
    out.push(Stmt.new(span, StmtKind.LetVal(intern(tmp_name.as_str()), null, init)))
    var v = Expr.new(span, ExprKind.Variable(intern(tmp_name.as_str())))
    v.ty = subj.ty
    unsafe { *subj_ptr = v }
    return out
}

fun hoisted_subject_prefix(): str { return "__when_own_" }

/// A local `hoist_owned_when_subject` made: it holds a fresh value no one
/// else owns.
fun is_hoisted_subject(name: str): bool {
    return name.starts_with(hoisted_subject_prefix())
}

// `make().as_str()`: a fresh temporary that is only borrowed is owned by
// nobody. A method receiver is hoisted to a local so it is dropped; receivers
// are always borrowed, so this is safe. Nested receivers hoist inner-first.
fun hoist_borrowed_temps(ep: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    val e = unsafe { *ep }
    when (e.kind) {
        MethodCall(recv_ptr, _m, args) => {
            hoist_borrowed_temps(recv_ptr, ctx, out)
            while i in 0..args.size() {
                hoist_borrowed_temps(args.at_mut(i), ctx, out)
                maybe_hoist_borrowed_arg(args.at_mut(i), ctx, out)
            }
            maybe_hoist_receiver(recv_ptr, ctx, out)
        }
        Call(_n, args) => {
            while i in 0..args.size() {
                hoist_borrowed_temps(args.at_mut(i), ctx, out)
                maybe_hoist_borrowed_arg(args.at_mut(i), ctx, out)
            }
        }
        Intrinsic(_i, args) => {
            while i in 0..args.size() {
                hoist_borrowed_temps(args.at_mut(i), ctx, out)
                maybe_hoist_borrowed_arg(args.at_mut(i), ctx, out)
            }
        }
        CallValue(callee, args) => {
            hoist_borrowed_temps(callee, ctx, out)
            while i in 0..args.size() {
                hoist_borrowed_temps(args.at_mut(i), ctx, out)
                maybe_hoist_borrowed_arg(args.at_mut(i), ctx, out)
            }
        }
        FieldAccess(obj_ptr, _f) => hoist_borrowed_temps(obj_ptr, ctx, out)
        Binary(l, op, r) => {
            when (op) {
                AndAnd => {
                    hoist_short_circuit(ep, l, true, r, ctx, out)
                    return
                }
                OrOr => {
                    hoist_short_circuit(ep, l, false, r, ctx, out)
                    return
                }
                _ => { }
            }
            hoist_borrowed_temps(l, ctx, out)
            maybe_hoist_receiver(l, ctx, out)
            hoist_borrowed_temps(r, ctx, out)
            maybe_hoist_borrowed_arg(r, ctx, out)
        }
        Unary(_op, inner) => hoist_borrowed_temps(inner, ctx, out)
        Deref(inner) => hoist_borrowed_temps(inner, ctx, out)
        Cast(inner, _t) => hoist_borrowed_temps(inner, ctx, out)
        // A `&dyn` borrows its operand, a fresh value included.
        DynCoerce(inner, _vtable) => {
            hoist_borrowed_temps(inner, ctx, out)
            maybe_hoist_borrowed_arg(inner, ctx, out)
        }
        Retain(inner) => hoist_borrowed_temps(inner, ctx, out)
        IfExpr(c, t, el) => hoist_if_value(ep, c, t, el, ctx, out)
        StructLit(_n, finits) => {
            while finit in &finits {
                hoist_borrowed_temps(finit.value, ctx, out)
            }
        }
        _ => { }
    }
}

// Hoists a fresh move-only temporary to a dropped local.
//
// CONSTRAINT: the node's coercion is carried over. A hoisted argument is
// passed by borrow and still needs `coerce_addr_of`.
fun maybe_hoist_owned_temp(p: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    val e = unsafe { *p }
    if !e.ty.is_move_only(ctx) { return }
    var is_temp = false
    when (e.kind) {
        Call(_, _) => is_temp = true
        Intrinsic(_, _) => is_temp = true
        CallValue(_callee, _) => is_temp = true
        MethodCall(_, _, _) => is_temp = true
        StructLit(_, _) => is_temp = true
        Binary(_, _, _) => is_temp = true
        _ => { }
    }
    if !is_temp { return }
    val mode = classify_binding(e, ctx)
    when (mode) {
        OwnedFresh => { }
        _ => return
    }
    val tmp_id = ctx.block_counter
    ctx.block_counter = tmp_id + 1
    val tmp_name = "__tmp_${u64_to_str(tmp_id)}"
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = e }
    unsafe { init.coerce = coerce_none() }
    out.push(Stmt.new(e.span, StmtKind.LetVal(intern(tmp_name.as_str()), null, init)))
    var v = Expr.new(e.span, ExprKind.Variable(intern(tmp_name.as_str())))
    v.ty = e.ty
    v.coerce = e.coerce
    unsafe { *p = v }
}

fun maybe_hoist_receiver(recv_ptr: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    maybe_hoist_owned_temp(recv_ptr, ctx, out)
}

// A fresh rvalue passed by borrow leaks its temporary, so it is hoisted. Only
// by borrow: a by-value argument is dropped by the callee.
fun maybe_hoist_borrowed_arg(arg_ptr: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    if unsafe { arg_ptr.coerce } != coerce_addr_of() { return }
    maybe_hoist_owned_temp(arg_ptr, ctx, out)
}

// An operator returns an owned value or a scalar, never a borrow of its
// operand, so its borrowed operands can be hoisted. The left one first, to
// keep left-to-right evaluation.
fun hoist_operator_operands(ep: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    val e = unsafe { *ep }
    when (e.kind) {
        Binary(l, _op, r) => {
            hoist_operator_operands(l, ctx, out)
            maybe_hoist_receiver(l, ctx, out)
            hoist_operator_operands(r, ctx, out)
            maybe_hoist_borrowed_arg(r, ctx, out)
        }
        _ => { }
    }
}

/// Hoists the temporaries below every subexpression whose value cannot hold
/// a borrow: they are consumed there, so none outlives the statement.
/// `val v = make().as_str()` keeps its temporary, and leaks it.
fun hoist_bounded_temps(ep: Ptr<Expr>, ctx: &var RcCtx, out: &var List<Stmt>): void {
    val e = unsafe { &*ep }
    if e.coerce != coerce_addr_of() && e.ty.holds_no_borrow(ctx) {
        hoist_borrowed_temps(ep, ctx, out)
        return
    }
    when (e.kind) {
        Binary(_l, _op, _r) => hoist_operator_operands(ep, ctx, out)
        Call(_n, args) => {
            while i in 0..args.size() {
                hoist_bounded_temps(args.at_mut(i), ctx, out)
            }
        }
        Intrinsic(_intrinsic, args) => {
            while i in 0..args.size() {
                hoist_bounded_temps(args.at_mut(i), ctx, out)
            }
        }
        CallValue(callee, args) => {
            hoist_bounded_temps(callee, ctx, out)
            while i in 0..args.size() {
                hoist_bounded_temps(args.at_mut(i), ctx, out)
            }
        }
        MethodCall(recv_ptr, _m, args) => {
            hoist_bounded_temps(recv_ptr, ctx, out)
            while i in 0..args.size() {
                hoist_bounded_temps(args.at_mut(i), ctx, out)
            }
        }
        StructLit(_n, finits) => {
            while finit in &finits {
                hoist_bounded_temps(finit.value, ctx, out)
            }
        }
        FieldAccess(obj_ptr, _f) => hoist_bounded_temps(obj_ptr, ctx, out)
        Unary(_op, inner) => hoist_bounded_temps(inner, ctx, out)
        Cast(inner, _t) => hoist_bounded_temps(inner, ctx, out)
        _ => { }
    }
}

// An Expression statement discards its result, so it is always hoist-safe.
pub mutating fun Stmt.collect_stmt_hoists(ctx: &var RcCtx): List<Stmt> {
    var out = List.new<Stmt>()
    when (self.kind) {
        Expression(ep) => hoist_borrowed_temps(ep, ctx, &var out)
        LetVal(_n, _ty, ep) => {
            val p = ep ?: return out
            hoist_bounded_temps(p, ctx, &var out)
        }
        // No initializer, nothing to hoist.
        LetVar(_n, _ty, ep) => {
            val p = ep ?: return out
            hoist_bounded_temps(p, ctx, &var out)
        }
        Assign(_n, ep) => hoist_bounded_temps(ep, ctx, &var out)
        AssignTo(_place, ep) => hoist_bounded_temps(ep, ctx, &var out)
        Return(ep) => {
            val rp = ep ?: return out
            hoist_bounded_temps(rp, ctx, &var out)
        }
        // An `if` condition is a bool, so its temporaries can always be
        // hoisted ahead of the statement. Bodies hoist in their own scope.
        //
        // Not `while`: a hoist before the loop would evaluate the condition
        // once.
        If(cp, _then, _els) => hoist_borrowed_temps(cp, ctx, &var out)
        _ => { }
    }
    return out
}

/// Rewrites one statement in place: marks what it consumes and rewrites the
/// scopes it opens.
pub mutating fun Stmt.rc_insert_stmt(ctx: &var RcCtx): void {
    when (self.kind) {
        LetVal(name, _ty, init_ptr) => {
            val ip = init_ptr ?: return
            val init = unsafe { *ip }
            if is_heap_ty_rc(init.ty) {
                val mode = classify_binding(init, ctx)
                apply_binding_mode(mode, name.as_string(), ip, ctx)
            }
            init.mark_consumed_moves(ctx)
        }
        LetVar(name, _ty, init_ptr) => {
            val ip = init_ptr ?: return
            val init = unsafe { *ip }
            if is_heap_ty_rc(init.ty) {
                val mode = classify_binding(init, ctx)
                apply_binding_mode(mode, name.as_string(), ip, ctx)
            }
            init.mark_consumed_moves(ctx)
        }
        If(cond_ptr, then_body, else_body) => {
            // The condition can consume (`if !consume(a)`).
            mark_consumed_moves(unsafe { *cond_ptr }, ctx)
            rc_insert_scope(&var then_body, ctx)
            rc_insert_scope(&var else_body, ctx)
            // CONSTRAINT: a binder is a copy of the payload, so a list that
            // grew is moved back into place.
            self.kind = StmtKind.If(take<Box<Expr>>(cond_ptr), take<List<Stmt>>(then_body),
                take<List<Stmt>>(else_body))
        }
        // Desugar runs first; passed through if the order ever changes.
        ForEach(_b, _s, _bd) => { }
        While(cond_ptr, body) => {
            val _wi = ctx.push_frame(true)
            // Marked inside the loop frame: the condition re-runs on the
            // back-edge.
            mark_consumed_moves(unsafe { *cond_ptr }, ctx)
            rc_insert_stmts(&var body, ctx)
            append_releases(&var body, ctx.pop_frame())
            self.kind = StmtKind.While(take<Box<Expr>>(cond_ptr), take<List<Stmt>>(body))
        }
        Switch(subj_ptr, arms) => rc_insert_switch(unsafe { &*subj_ptr }, &var arms, ctx)
        Assign(_name, rhs_ptr) => {
            mark_assign_rhs_moved(rhs_ptr, ctx)
            mark_consumed_moves(unsafe { *rhs_ptr }, ctx)
        }
        AssignTo(_place_ptr, rhs_ptr) => {
            mark_assign_rhs_moved(rhs_ptr, ctx)
            mark_consumed_moves(unsafe { *rhs_ptr }, ctx)
        }
        Return(expr_ptr) => {
            val ep = expr_ptr ?: return
            mark_consumed_moves(unsafe { *ep }, ctx)
        }
        Expression(expr_ptr) => {
            mark_consumed_moves(unsafe { *expr_ptr }, ctx)
            // A discarded fresh result (`render(x);`) is bound to a local so
            // it is dropped. Only OwnedFresh; a borrowed result is not.
            val e = unsafe { *expr_ptr }
            if !e.ty.is_move_only(ctx) { return }
            when (classify_binding(e, ctx)) {
                OwnedFresh => {
                    val tmp_id = ctx.block_counter
                    ctx.block_counter = tmp_id + 1
                    val tmp_name = "__discard_${u64_to_str(tmp_id)}"
                    ctx.add_heap_local(tmp_name.clone())
                    self.kind = StmtKind.LetVal(intern(tmp_name.as_str()), null, take<Box<Expr>>(expr_ptr))
                }
                _ => { }
            }
        }
        When(_, _) => { }
        Drop(_) => { }
        Release(_) => { }
        Break => { }
        Continue => { }
        Poison => { }
    }
}

/// A nested scope, closed by the releases of what it still owns.
fun rc_insert_scope(body: &var List<Stmt>, ctx: &var RcCtx): void {
    val _i = ctx.push_frame(false)
    rc_insert_stmts(body, ctx)
    append_releases(body, ctx.pop_frame())
}

fun rc_insert_switch(subject: &Expr, arms: &var List<SwitchArm>, ctx: &var RcCtx): void {
    mark_consumed_moves(*subject, ctx)
    // Marked moved before the arm frames are pushed, so a non-binding arm can
    // re-register it as its own.
    val subj_name = subject.when_subject_var()
    val subj_enum = subject.when_subject_enum()
    // Declined owning payloads get generated names first, so the arm frame
    // drops them like any binder.
    name_declined_payloads(arms, subj_enum.as_str(), ctx)
    val consumes = subject.when_consumes_subject(arms, ctx)
    if consumes { ctx.rc_mark_moved(subj_name.clone()) }
    while ai in 0..arms.size() {
        val arm = arms.at_mut(ai)
        val _i = ctx.push_frame(false)
        var owned = List.new<String>()
        if consumes {
            owned = arm.arm_owned_names(subj_enum.as_str(), subj_name.as_str(), ctx)
            while item in &owned {
                ctx.add_heap_local(item)
            }
        }
        arm.rc_add_binder_views(&owned, ctx)
        // A guard can consume what the body would; it is marked in the arm's
        // frame.
        when (arm.guard) {
            Some(g) => mark_consumed_moves(unsafe { *g }, ctx)
            None => { }
        }
        arm.guard_prelude = guard_temporaries(arm.guard.view(), ctx)
        rc_insert_stmts(&var arm.body, ctx)
        append_releases(&var arm.body, ctx.pop_frame())
    }
}
