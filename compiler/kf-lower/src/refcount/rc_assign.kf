// Ownership at `x = rhs` on an owning binding:
//
//   1. drop what is overwritten, or every assignment leaks;
//   2. own what is given: a `xs.get(i)` view becomes an owned copy;
//   3. keep owning afterwards: `s = grow(s)` consumed `s`, so its drop
//      registration is restored.
//
// (1) and (3) are exclusive, decided by whether the rhs consumed the binding.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.expression.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_lower.ownership.names_contains

/// Everything an assignment needs to know before its RHS is marked.
pub struct AssignOwnership {
    pub val owning_frame: int64
    pub val heap: bool
    pub val rhs_reads_target: bool
    /// The rhs owns itself, so it cannot alias the buffer about to be freed.
    pub val rhs_owned_fresh: bool
}

/// Read before the rhs is marked, since marking destroys the evidence.
pub fun assign_ownership_before(name: Sym, rhs_ptr: Ptr<Expr>, ctx: &var RcCtx): AssignOwnership {
    val rhs = unsafe { *rhs_ptr }
    if !is_heap_ty_rc(rhs.ty) {
        return AssignOwnership { owning_frame: 0 - 1, heap: false, rhs_reads_target: false, rhs_owned_fresh: false }
    }
    // A rhs that merely mentions the binding (`p = joined(p.as_str(), x)`)
    // still reads it, so it cannot be dropped first.
    var mentioned = List.new<String>()
    rhs.collect_var_names_in_expr(&var mentioned)
    val reads_target = names_contains(&mentioned, name.as_str())
    // Done on the way in, before consume marking rewrites the expression.
    var owned_fresh = false
    when (classify_binding(rhs, ctx)) {
        Borrowed => owned_fresh = take_a_copy(rhs_ptr)
        Moved => { if ctx.is_view_local(move_source_name(rhs).as_str()) { owned_fresh = take_a_copy(rhs_ptr) } }
        OwnedFresh => owned_fresh = true
        _ => { }
    }
    return AssignOwnership { owning_frame: ctx.rc_owning_frame(name.as_str()), heap: true, rhs_reads_target: reads_target, rhs_owned_fresh: owned_fresh }
}

/// Returns the drop that must run before the assignment, if any.
pub fun assign_ownership_after(name: Sym, span: Span, before: &AssignOwnership, ctx: &var RcCtx): List<Stmt> {
    var out = List.new<Stmt>()
    if !before.heap { return out }
    if before.owning_frame < 0 {
        // Owned nothing (no initializer, or moved out): nothing to drop or
        // restore.
        return out
    }
    val still_owning = ctx.rc_owning_frame(name.as_str()) >= 0
    if still_owning {
        // Unless the rhs reads the binding; then `self_read_assign_old`
        // releases the old value after the store.
        if !before.rhs_reads_target {
            out.push(Stmt.new(span, StmtKind.Release(name)))
        }
        return out
    }
    // Consumed: nothing to drop, but the new value is registered at the
    // declaring scope.
    ctx.restore_heap_local_at(before.owning_frame as uint64, name.as_string())
    return out
}

/// `*xs.at_mut(0) = *xs.at(1)` would otherwise leave two slots on one buffer.
pub fun place_rhs_take_ownership(rhs_ptr: Ptr<Expr>, ctx: &var RcCtx): void {
    val rhs = unsafe { *rhs_ptr }
    when (classify_binding(rhs, ctx)) {
        Borrowed => { val _ = take_a_copy(rhs_ptr) }
        Moved => { if ctx.is_view_local(move_source_name(rhs).as_str()) { val _ = take_a_copy(rhs_ptr) } }
        _ => { }
    }
}

/// True when it now is an owned copy.
fun take_a_copy(rhs_ptr: Ptr<Expr>): bool {
    if unsafe { rhs_ptr.coerce } != coerce_none() { return false }
    unsafe { rhs_ptr.coerce = coerce_clone() }
    return true
}

/// `x = f(x)`: binds the old value to a temp so it is released after the
/// store. Only for a fresh rhs, which cannot alias it; otherwise it leaks.
/// The temp is pushed raw: classified, it would read as a move.
pub fun self_read_assign_old(name: Sym, rhs_ptr: Ptr<Expr>, before: &AssignOwnership, span: Span, ctx: &var RcCtx, out: &var List<Stmt>): Sym? {
    if !before.heap { return null }
    if !before.rhs_reads_target { return null }
    if before.owning_frame < 0 { return null }
    if !before.rhs_owned_fresh { return null }
    val tmp_id = ctx.block_counter
    ctx.block_counter = tmp_id + 1
    val tmp_name = "__old_${u64_to_str(tmp_id)}"
    val tmp_sym = intern(tmp_name.as_str())
    var v = Expr.new(span, ExprKind.Variable(name))
    v.ty = unsafe { (*rhs_ptr).ty }
    val vp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *vp = v }
    out.push(Stmt.new(span, StmtKind.LetVal(tmp_sym, null, vp)))
    return tmp_sym
}
