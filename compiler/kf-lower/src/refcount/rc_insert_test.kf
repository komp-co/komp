    val first = *out.at(0)
    when (first.kind) {
        Release(nm) => assert_eq(nm.as_str(), "x", "drops loop-body local x before continue")
        _ => assert_eq(false, true, "expected Release(x) first")
    }
}

@test fun rc_insert_switch_arm_with_no_binders(): void {
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)

    val sa = new_switch_arm(no_span(), SwitchTag.Wildcard, List.new<Sym>(), null, List.new<Stmt>())
    var arms = List.new<SwitchArm>()
    arms.push(sa)
    val subj = new_expr(no_span(), ExprKind.LitBool(true))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    var s = new_stmt(no_span(), StmtKind.Switch(sp, arms))
    s.rc_insert_stmt(&var ctx)
    assert_eq(true, true, "switch with no binders survives")
}

@allow(deref_through_temporary)
@test fun rc_insert_bare_var_move_skips_retain(): void {
    // val x = y  (y: String) -> a move: no Retain.
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)
    val yp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *yp = mk_string_var_expr(String.from("y")) }
    var s = new_stmt(no_span(), StmtKind.LetVal(intern("x"), null, yp))
    s.rc_insert_stmt(&var ctx)
    when (s.kind) {
        LetVal(_, _, init_ptr) => {
            val init = unsafe { *(init_ptr!!) }
            when (init.kind) {
                Retain(_) => assert_eq(false, true, "move (val x = y) must NOT retain")
                Variable(n) => assert_eq(n.as_str(), "y", "bare Variable preserved (move)")
                _ => assert_eq(false, true, "expected bare Variable")
            }
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
}

@test fun rc_insert_move_removes_source_from_releases(): void {
    // val y = <fresh>; val x = y -> only x is released.
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("y"))     // simulate `val y = String.from(...)`
    val yp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *yp = mk_string_var_expr(String.from("y")) }
    var s = new_stmt(no_span(), StmtKind.LetVal(intern("x"), null, yp))
    s.rc_insert_stmt(&var ctx)
    val rels = ctx.pop_frame()
    assert_eq(rels.size() == 1, true, "only x released; y moved out")
    val r0 = *rels.at(0)
    when (r0.kind) {
        Release(nm) => assert_eq(nm.as_str(), "x", "releases x, not moved-out y")
        _ => assert_eq(false, true, "expected Release")
    }
}

@allow(deref_through_temporary)
@test fun rc_insert_field_read_is_borrow(): void {
    // val x = obj.field -> a borrow: no Retain.
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)
    val objp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *objp = new_expr(no_span(), ExprKind.Variable(intern("obj"))) }
    var fa = new_expr(no_span(), ExprKind.FieldAccess(objp, intern("field")))
    fa.ty = intern("String").lang_struct_ty(no_span())
    val fap: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *fap = fa }
    var s = new_stmt(no_span(), StmtKind.LetVal(intern("x"), null, fap))
    s.rc_insert_stmt(&var ctx)
    when (s.kind) {
        LetVal(_, _, init_ptr) => {
            val init = unsafe { *(init_ptr!!) }
            when (init.kind) {
                Retain(_) => assert_eq(false, true, "String field read must NOT be Retain-wrapped (borrow)")
                _ => assert_eq(true, true, "field read is a borrow (no retain)")
            }
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
}

@allow(deref_through_temporary)
@test fun rc_insert_deref_read_is_borrow(): void {
    // val v = *p -> a borrow: no Retain and no Release(v).
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)
    val pvar: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *pvar = new_expr(no_span(), ExprKind.Variable(intern("p"))) }
    var deref = new_expr(no_span(), ExprKind.Deref(pvar))
    deref.ty = intern("String").lang_struct_ty(no_span())
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = deref }
    var s = new_stmt(no_span(), StmtKind.LetVal(intern("v"), null, ip))
    s.rc_insert_stmt(&var ctx)
    when (s.kind) {
        LetVal(_, _, init_ptr) => {
            val init = unsafe { *(init_ptr!!) }
            when (init.kind) {
                Retain(_) => assert_eq(false, true, "deref-read borrow must NOT retain")
                Deref(_) => assert_eq(true, true, "deref preserved (borrow)")
                _ => assert_eq(false, true, "expected bare Deref")
            }
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
    val rels = ctx.pop_frame()
    assert_eq(rels.size() == 0, true, "borrow v is not released")
}

fun struct_ty_named(name: str): Type {
    return Type { kind: TypeKind.Struct(intern(name)), provenance: Provenance.Inferred(no_span()) }
}

fun mk_string_param(name: str): Param {
    val tr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tr = new_type_ref(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    return new_param(no_span(), String.from(name), tr)
}

fun mk_ref_string_param(name: str): Param {
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = new_type_ref(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    val tr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tr = new_type_ref(no_span(), TypeRefKind.Reference(false, inner)) }
    return new_param(no_span(), String.from(name), tr)
}

@test fun byvalue_string_param_dropped_at_exit(): void {
    var params = List.new<Param>()
    params.push(mk_string_param("s"))
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    track_value_params(&params, &var ctx)
    val rels = ctx.pop_frame()
    assert_eq(rels.size() == 1, true, "one release for the by-value String param")
}

@test fun ref_param_not_tracked(): void {
    var params = List.new<Param>()
    params.push(mk_ref_string_param("s"))
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    track_value_params(&params, &var ctx)
    val rels = ctx.pop_frame()
    assert_eq(rels.size() == 0, true, "&String param is a borrow, never dropped by callee")
}

@test fun return_fresh_binary_drops_after_eval(): void {
    // return a + b -> __retval temp, Release(a), return temp.
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("a"))
    val av = mk_string_var_expr(String.from("a"))
    val bv = mk_string_var_expr(String.from("b"))
    val ap: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ap = av }
    val bp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *bp = bv }
    var bin = new_expr(no_span(), ExprKind.Binary(ap, BinOp.Add, bp))
    bin.ty = intern("String").lang_struct_ty(no_span())
    val rp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rp = bin }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(rp))))
    var out = body
    rc_insert_stmts(&var out, &var ctx)
    assert_eq(out.size() == 3, true, "temp + release + return")
    when (out.at(0).kind) {
        LetVal(_, _, _) => assert_eq(true, true, "first stmt is the retval temp")
        _ => assert_eq(false, true, "expected LetVal first")
    }
    when (out.at(1).kind) {
        Release(n) => assert_eq(n.as_str(), "a", "borrowed-only local dropped after eval")
        _ => assert_eq(false, true, "expected Release second")
    }
}

@test fun return_cloned_read_drops_after_eval(): void {
    // return l.clone(): the clone must run before `all` is dropped.
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("all"))
    var lv = mk_string_var_expr(String.from("l"))
    lv.coerce = coerce_clone()
    val rp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rp = lv }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(rp))))
    var out = body
    rc_insert_stmts(&var out, &var ctx)
    assert_eq(out.size() == 3, true, "temp + release + return")
    when (out.at(0).kind) {
        LetVal(_, _, _) => assert_eq(true, true, "the clone is evaluated first")
        _ => assert_eq(false, true, "expected the retval temp first")
    }
    when (out.at(1).kind) {
        Release(n) => assert_eq(n.as_str(), "all", "the source is dropped after the clone")
        _ => assert_eq(false, true, "expected Release second")
    }
}

@test fun discarded_fresh_result_bound_and_dropped(): void {
    // render(x) as a statement -> val __discard_N = ...
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)
    var args = List.new<Expr>()
    args.push(mk_string_var_expr(String.from("x")))
    var call = new_expr(no_span(), ExprKind.Call(intern("render"), args))
    call.ty = intern("String").lang_struct_ty(no_span())
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = call }
    var s = new_stmt(no_span(), StmtKind.Expression(cp))
    s.rc_insert_stmt(&var ctx)
    when (s.kind) {
        LetVal(_, _, _) => assert_eq(true, true, "discarded result bound to a temp")
        _ => assert_eq(false, true, "expected LetVal rewrite")
    }
    val rels = ctx.pop_frame()
    assert_eq(rels.size() == 1, true, "the discard temp is dropped at scope exit")
}

@test fun canonical_struct_matches_move_only_display_name(): void {
    var ctx = rc_ctx_for_test("m")
    ctx.move_only_names.push(String.from("Unique"))
    val identity = new_type_identity(new_crate_id("model"), intern("types"), intern("Unique"))
    val ty = named_struct_ty(identity, no_span())
    assert_eq(ty.is_move_only(&var ctx), true, "canonical type matches move-only display name")
}

pub fun ret_op(p: Ptr<Expr>): Box<Expr>? {
    return p
}
