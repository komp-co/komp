import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*

// Normally filled from core's `impl Drop for String`; these tests state it.
fun rc_ctx_for_test(fn_name: str): RcCtx {
    var ctx = new_rc_ctx(String.from(fn_name))
    ctx.move_only_names.push(String.from("String"))
    ctx.string_name = intern("String")
    return ctx
}

fun null_tr(): Ptr<TypeRef> {
    return unsafe { 0 as Ptr<TypeRef> }
}

fun mk_string_var_expr(name: String): Expr {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name.as_str())))
    e.ty = intern("String").lang_struct_ty(no_span())
    return e
}

fun binding_mode_tag(m: BindingMode): uint64 {
    when (m) {
        OwnedFresh => return 0
        OwnedRetain => return 1
        Moved => return 2
        Borrowed => return 3
    }
}

@test fun rc_insert_switch_arm_binder_has_no_ownership(): void {
    // A binder aliases a field of the subject: no retain/release pair.
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)

    var binders = List.new<Sym>()
    binders.push(intern("x"))
    val sa = new_switch_arm(no_span(), SwitchTag.Variant(String.from("Some")), binders, null, List.new<Stmt>())
    var arms = List.new<SwitchArm>()
    arms.push(sa)
    val subj = new_expr(no_span(), ExprKind.Variable(intern("opt")))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    var s = new_stmt(no_span(), StmtKind.Switch(sp, arms))
    s.rc_insert_stmt(&var ctx)

    when (s.kind) {
        Switch(_, out_arms) => {
            val a = *out_arms.at(0)
            assert_eq(a.body.size() == 0, true, "binder has no retain or release")
        }
        _ => assert_eq(false, true, "expected Switch")
    }
}

@allow(deref_through_temporary)
@test fun rc_insert_take_call_skips_retain(): void {
    // val y = take(x): no Retain; take is fresh.
    var ctx = rc_ctx_for_test("main")
    val _i = ctx.push_frame(false)

    var args = List.new<Expr>()
    val xv = mk_string_var_expr(String.from("x"))
    args.push(xv)
    var call = new_expr(no_span(), ExprKind.Call(intern("take"), args))
    call.ty = intern("String").lang_struct_ty(no_span())
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = call }
    var s = new_stmt(no_span(), StmtKind.LetVal(intern("y"), null, cp))
    s.rc_insert_stmt(&var ctx)

    when (s.kind) {
        LetVal(_, _, init_ptr) => {
            val init = unsafe { *(init_ptr!!) }
            when (init.kind) {
                Retain(_) => assert_eq(false, true, "take<T> result should NOT be retained")
                Call(name, _) => assert_eq(name.as_str(), "take", "Call(take) preserved")
                _ => assert_eq(false, true, "expected Call(take)")
            }
        }
        _ => assert_eq(false, true, "expected LetVal")
    }
}

@test fun returned_var_names_extracts_bare_var(): void {
    var ctx = rc_ctx_for_test("f")
    // return x  → ["x"]
    val xv = new_expr(no_span(), ExprKind.Variable(intern("x")))
    val xp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *xp = xv }
    val names = returned_var_names(xp, &var ctx)
    assert_eq(names.size() == 1, true, "bare Variable return → one name")
    assert_eq(names.at(0).as_str(), "x", "bare Variable return → its name")
}

@test fun returned_var_names_call_collects_arg_vars(): void {
    var ctx = rc_ctx_for_test("f")
    // return f(l1, post)  -> ["l1", "post"]
    var args = List.new<Expr>()
    args.push(new_expr(no_span(), ExprKind.Variable(intern("l1"))))
    args.push(new_expr(no_span(), ExprKind.Variable(intern("post"))))
    val cv = new_expr(no_span(), ExprKind.Call(intern("concat"), args))
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = cv }
    val names = returned_var_names(cp, &var ctx)
    assert_eq(names.size() == 2, true, "call args → both var names collected")
    assert_eq(names.at(0).as_str(), "l1", "first arg var")
    assert_eq(names.at(1).as_str(), "post", "second arg var")
}

@test fun returned_var_names_non_var_is_empty(): void {
    var ctx = rc_ctx_for_test("f")
    // return 5  → []  (LitInt is not a tracked local)
    val lv = new_expr(no_span(), ExprKind.LitInt(5))
    val lp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *lp = lv }
    val names = returned_var_names(lp, &var ctx)
    assert_eq(names.size() == 0, true, "non-Variable return → empty (excludes nothing)")
}

@test fun returned_var_names_absent_operand_is_empty(): void {
    var ctx = rc_ctx_for_test("f")
    // bare `return` (no operand) → []
    val absent: Ptr<Expr>? = null
    val names = returned_var_names(absent, &var ctx)
    assert_eq(names.size() == 0, true, "bare return → empty")
}

@test fun exit_releases_return_walks_to_fn_root_excluding_moved(): void {
    // fn frame holds a, b (both heap). `return a` drops b, not a.
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("a"))
    ctx.add_heap_local(String.from("b"))
    var excl = List.new<String>()
    excl.push(String.from("a"))
    val rels = ctx.exit_releases(false, &excl)
    assert_eq(rels.size() == 1, true, "one release (b), a excluded")
    val r0 = *rels.at(0)
    when (r0.kind) {
        Release(nm) => assert_eq(nm.as_str(), "b", "drops b, not moved-out a")
        _ => assert_eq(false, true, "expected Release")
    }
}

@test fun exit_releases_break_stops_at_loop_frame(): void {
    // fn frame holds outer; loop frame holds x. break drops x only.
    var ctx = rc_ctx_for_test("g")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("outer"))
    val _w = ctx.push_frame(true)
    ctx.add_heap_local(String.from("x"))
    val rels = ctx.exit_releases(true, &List.new<String>())
    assert_eq(rels.size() == 1, true, "only loop-body local x drops, not outer")
    val r0 = *rels.at(0)
    when (r0.kind) {
        Release(nm) => assert_eq(nm.as_str(), "x", "drops x, stops at loop frame")
        _ => assert_eq(false, true, "expected Release")
    }
}

@test fun stmt_list_return_splices_sibling_drop(): void {
    // frame holds a, b; body is `return a` → [Release(b), Return]
    var ctx = rc_ctx_for_test("f")
    val _i = ctx.push_frame(false)
    ctx.add_heap_local(String.from("a"))
    ctx.add_heap_local(String.from("b"))
    // `a` needs a heap type, so the simple splice path is taken.
    var av = new_expr(no_span(), ExprKind.Variable(intern("a")))
    av.ty = intern("String").lang_struct_ty(no_span())
    val ap: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ap = av }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(ap))))
    var out = body
    rc_insert_stmts(&var out, &var ctx)
    assert_eq(out.size() == 2, true, "Release(b) spliced before Return")
    val first = *out.at(0)
    when (first.kind) {
        Release(nm) => assert_eq(nm.as_str(), "b", "drops sibling b, not returned a")
        _ => assert_eq(false, true, "expected Release(b) first")
    }
}

@test fun stmt_list_break_splices_loop_local_drop(): void {
    var ctx = rc_ctx_for_test("g")
    val _i = ctx.push_frame(false)
    val _w = ctx.push_frame(true)
    ctx.add_heap_local(String.from("x"))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Break))
    var out = body
    rc_insert_stmts(&var out, &var ctx)
    assert_eq(out.size() == 2, true, "Release(x) spliced before Break")
    val first = *out.at(0)
    when (first.kind) {
        Release(nm) => assert_eq(nm.as_str(), "x", "drops loop-body local x before break")
        _ => assert_eq(false, true, "expected Release(x) first")
    }
}

@test fun stmt_list_continue_splices_loop_local_drop(): void {
    var ctx = rc_ctx_for_test("h")
    val _i = ctx.push_frame(false)
    val _w = ctx.push_frame(true)
    ctx.add_heap_local(String.from("x"))
    var body = List.new<Stmt>()
