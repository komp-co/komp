// Which values cannot hold a borrow. A temporary below one is consumed
// within the statement, so it can be dropped at the statement's end.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.lang_list_key
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.type_identity_display
import kf_core.ast.declaration.TopDecl
import kf_lower.ownership.names_contains

/// Every struct and enum whose fields, transitively, are scalars, the lang
/// string, a `Box` of such, or such types. The lang string owns its buffer,
/// and a lang list the elements behind its pointer.
pub fun Module.borrow_free_names(string_name: Sym, list_name: Sym): List<String> {
    var free = List.new<String>()
    while td in &self.decls {
        if td.is_struct_or_enum() { free.push(td.name.as_string()) }
    }
    var changed = true
    while changed {
        changed = false
        var kept = List.new<String>()
        while td in &self.decls {
            if td.is_struct_or_enum() && names_contains(&free, td.name.as_str()) {
                if td.name == string_name || td.fields_hold_no_borrow(&free, string_name, list_name) {
                    kept.push(td.name.as_string())
                } else {
                    changed = true
                }
            }
        }
        free = kept
    }
    return free
}

fun TopDecl.is_struct_or_enum(): bool {
    return when (self.kind) {
        Struct(_fields, _p) => true
        EnumDecl(_variants, _p) => true
        _ => false
    }
}

fun TopDecl.fields_hold_no_borrow(free: &List<String>, string_name: Sym, list_name: Sym): bool {
    val owns_pointees = self.lang_key_of().as_str().equals(lang_list_key())
    when (self.kind) {
        Struct(fields, _p) => {
            while f in &fields {
                if !f.ty.holds_no_borrow(free, string_name, list_name, owns_pointees) { return false }
            }
            return true
        }
        EnumDecl(variants, _p) => {
            while v in &variants {
                while payload in &v.payloads {
                    if !payload.holds_no_borrow(free, string_name, list_name, false) { return false }
                }
            }
            return true
        }
        _ => return false
    }
}

/// `owns_pointees`: a `Ptr` here owns what it points at, as a list's does.
fun TypeRef.holds_no_borrow(free: &List<String>, string_name: Sym, list_name: Sym, owns_pointees: bool): bool {
    when (self.kind) {
        Named(n, args) => {
            if is_scalar_type_name(n.as_str()) || n == string_name { return true }
            val owns_args = n.as_str().equals("Box") || n == list_name || (owns_pointees && n.as_str().equals("Ptr"))
            if owns_args {
                while a in &args {
                    if !a.holds_no_borrow(free, string_name, list_name, false) { return false }
                }
                return true
            }
            return args.size() == 0 && names_contains(free, n.as_str())
        }
        _ => return false
    }
}

fun is_scalar_type_name(s: str): bool {
    return when s {
        "bool" => true
        "char" => true
        "void" => true
        "int8" => true
        "int16" => true
        "int32" => true
        "int64" => true
        "uint8" => true
        "uint16" => true
        "uint32" => true
        "uint64" => true
        "float32" => true
        "float64" => true
        _ => false
    }
}

/// A scalar, or a struct or enum in `borrow_free`.
fun Type.holds_no_borrow(ctx: &RcCtx): bool {
    return when (self.kind) {
        Int8 => true
        Int16 => true
        Int32 => true
        Int64 => true
        UInt8 => true
        UInt16 => true
        UInt32 => true
        UInt64 => true
        Float32 => true
        Float64 => true
        Bool => true
        Char => true
        Void => true
        Struct(n) => names_contains(&ctx.borrow_free, type_identity_display(n).as_str())
        EnumTy(n) => names_contains(&ctx.borrow_free, type_identity_display(n).as_str())
        _ => false
    }
}
