import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind

fun holder_ty(): Type {
    return Type { kind: TypeKind.Struct(intern("Holder")), provenance: Provenance.Inferred(no_span()) }
}

fun typed(kind: ExprKind, ty: Type): Expr {
    var e = Expr.new(no_span(), kind)
    e.ty = ty
    return e
}

fun field_of(base: Expr, name: str): Expr {
    return typed(ExprKind.FieldAccess(Box.new(base), intern(name)), holder_ty())
}

@test fun a_field_of_a_local_struct_is_a_place_path(): void {
    val place = field_of(typed(ExprKind.Variable(intern("h")), holder_ty()), "items")
    assert_eq(place.place_path_copy().is_some(), true, "h.items reads the same place again")
}

@test fun a_field_of_a_field_is_a_place_path(): void {
    val place = field_of(field_of(typed(ExprKind.Variable(intern("h")), holder_ty()), "inner"), "items")
    assert_eq(place.place_path_copy().is_some(), true, "h.inner.items reads the same place again")
}

@test fun a_field_of_a_call_result_is_not_a_place_path(): void {
    val call = typed(ExprKind.Call(intern("make"), List.new<Expr>()), holder_ty())
    assert_eq(field_of(call, "items").place_path_copy().is_some(), false, "make().items is a fresh value")
}
