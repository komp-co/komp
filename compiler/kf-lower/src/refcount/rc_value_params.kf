// A by-value move-only param is owned by its callee and dropped at scope exit
// unless moved on or returned. `&T`, `Ptr<T>` and `self` are not tracked.
//
// CONSTRAINT: the same predicate the caller side uses (`is_move_only`); a
// disagreement leaks or double-frees.

import alloc.list.*

import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.Param
import kf_core.ast.subst.mangle_tyref
import kf_lower.ownership.tref_is_borrow_sink
import kf_lower.ownership.names_contains

fun track_value_params(params: &List<Param>, ctx: &var RcCtx): void {
    while p in &params {
        if !tref_is_borrow_sink(p.ty) {
            val tr = unsafe { *p.ty }
            if tr.tref_is_move_only(ctx) {
                ctx.add_heap_local(p.name.as_string())
            }
        }
    }
}

/// `is_move_only` for a written type, through the mangled spelling.
/// CONSTRAINT: mirrors `is_move_only` in rc_classify.kf arm for arm.
fun TypeRef.tref_is_move_only(ctx: &var RcCtx): bool {
    when (self.kind) {
        Named(n, _args) => {
            if n.as_str().equals("Box") { return true }
            return names_contains(&ctx.move_only_names, mangle_tyref(self).as_str())
        }
        _ => { }
    }
    return false
}
