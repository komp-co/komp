// Consumed-move marking for the refcount pass.

import alloc.list.*
import kf_core.ast.Intrinsic
import kf_core.ast.types.type_identity_display
import kf_core.ast.expression.*
import kf_lower.ownership.param_lookup

// After a move the source owns nothing, so no frame drops it.
pub mutating fun RcCtx.rc_mark_moved(name: String): void {
    var fresh_frames = List.new<RcFrame>()
    while f in &self.frame_stack {
        var kept = List.new<String>()
        while hl in &f.heap_locals {
            if !hl.equals(name) { kept.push(hl) }
        }
        fresh_frames.push(RcFrame { block_idx: f.block_idx, heap_locals: kept, is_loop: f.is_loop,
            view_locals: f.view_locals.clone() })
    }
    self.frame_stack = fresh_frames
}

// `x = y` with `y` a bare move-only variable moves it, so `y` is not dropped
// at scope exit. Loop-carried sources clone instead (see consume_var_site).
fun mark_assign_rhs_moved(rhs_ptr: Ptr<Expr>, ctx: &var RcCtx): void {
    val rhs = unsafe { *rhs_ptr }
    if rhs.ty.is_move_only(ctx) {
        val src = move_source_name(rhs)
        if !src.as_str().equals("") {
            consume_var_site(rhs_ptr, src, ctx)
        }
    }
}

// A bare move-only variable passed by value into a call or constructor is
// consumed, so its scope-exit drop is elided; a `&` argument is not.
// Loop-carried consumes clone instead, since the back-edge may read it again.
//
// A String argument consumes only when a komp-compiled move-sink param will
// drop it; an extern never does. An unknown callee (a variant constructor)
// takes ownership like an aggregate.
fun mark_arg_if_consumed(ap: Ptr<Expr>, callee: String, idx: uint64, ctx: &var RcCtx): void {
    val a = unsafe { *ap }
    when (a.kind) {
        Variable(n) => {
            if a.ty.is_move_only(ctx) {
                if a.coerce != coerce_addr_of() {
                    if arg_callee_keeps_ownership(ap, callee, idx, ctx) { return }
                    consume_var_site(ap, n.as_string(), ctx)
                }
            }
        }
        _ => { }
    }
}

// The callee does not take ownership: a `to_cstr` view, a cloned pass, a
// borrow-sink param, or an extern. False for an unknown, uncoerced callee.
fun arg_callee_keeps_ownership(ap: Ptr<Expr>, callee: String, idx: uint64, ctx: &var RcCtx): bool {
    val co = unsafe { ap.coerce }
    if co == coerce_to_cstr() { return true }
    if co == coerce_clone() { return true }
    if callee.as_str().equals("") { return false }
    val pl = param_lookup(unsafe { &*ctx.ptable }, callee, idx)
    if !pl.found { return false }
    if pl.is_borrow_sink { return true }
    if pl.is_extern { return true }
    return false
}

// Plain move: elide the source's drop. Loop-carried: clone at the site and
// keep the drop. Untracked (borrowed or already moved): leave alone.
//
// CONSTRAINT: loop-carried consumes clone for every move-only type. Once a
// callee drops its by-value param, eliding would free a value the next
// iteration reads.
fun consume_var_site(ap: Ptr<Expr>, name: String, ctx: &var RcCtx): void {
    val kind = ctx.consume_kind(name.clone())
    if kind == 1 {
        ctx.rc_mark_moved(name)
        return
    }
    if kind == 2 {
        // An existing coercion is kept: a clone, or a read that consumes
        // nothing.
        if unsafe { ap.coerce } == coerce_none() {
            unsafe { ap.coerce = coerce_clone() }
        }
    }
}

// Marks every bare move-only variable in a by-value argument position as
// moved, recursing into nested calls.
fun Expr.mark_consumed_moves(ctx: &var RcCtx): void {
    when (self.kind) {
        Call(_n, args) => {
            val callee = self.mangled_callee.as_string()
            while i in 0..args.size() {
                mark_arg_if_consumed(args.at_mut(i), callee.clone(), i, ctx)
                mark_consumed_moves(*args.at(i), ctx)
            }
        }
        CallValue(_callee, args) => {
            val callee = self.mangled_callee.as_string()
            while i in 0..args.size() {
                mark_arg_if_consumed(args.at_mut(i), callee.clone(), i, ctx)
                mark_consumed_moves(*args.at(i), ctx)
            }
        }
        Intrinsic(_intrinsic, args) => {
            while i in 0..args.size() {
                mark_arg_if_consumed(args.at_mut(i), String.from(""), i, ctx)
                mark_consumed_moves(*args.at(i), ctx)
            }
        }
        MethodCall(recv_ptr, _m, args) => {
            mark_consumed_moves(unsafe { *recv_ptr }, ctx)
            val callee = self.mangled_callee.as_string()
            while i in 0..args.size() {
                mark_arg_if_consumed(args.at_mut(i), callee.clone(), i, ctx)
                mark_consumed_moves(*args.at(i), ctx)
            }
        }
        StructLit(n, finits) => {
            val lambda_literal = rc_name_starts_with(type_identity_display(n), "Lambda_")
            while fi in &finits {
                if lambda_literal {
                    mark_lambda_capture_moved(fi.value, ctx)
                } else {
                    mark_arg_if_consumed(fi.value, "", 0, ctx)
                }
                mark_consumed_moves(unsafe { *fi.value }, ctx)
            }
        }
        Binary(l, _op, r) => {
            mark_consumed_moves(unsafe { *l }, ctx)
            mark_consumed_moves(unsafe { *r }, ctx)
        }
        Unary(_op, inner) => { mark_consumed_moves(unsafe { *inner }, ctx) }
        Deref(inner) => { mark_consumed_moves(unsafe { *inner }, ctx) }
        FieldAccess(obj, _f) => { mark_consumed_moves(unsafe { *obj }, ctx) }
        IfExpr(c, t, el) => {
            // Both branches of an if-expression move their bare variables into
            // the result.
            mark_arg_if_consumed(t, "", 0, ctx)
            mark_arg_if_consumed(el, "", 0, ctx)
            mark_consumed_moves(unsafe { *c }, ctx)
            mark_consumed_moves(unsafe { *t }, ctx)
            mark_consumed_moves(unsafe { *el }, ctx)
        }
        Cast(inner, _ty) => { mark_consumed_moves(unsafe { *inner }, ctx) }
        DynCoerce(inner, _vtable) => { mark_consumed_moves(unsafe { *inner }, ctx) }
        Retain(inner) => { mark_consumed_moves(unsafe { *inner }, ctx) }
        _ => { }
    }
}

// A stored closure owns its by-value captures, refcounted structs included.
fun mark_lambda_capture_moved(ap: Ptr<Expr>, ctx: &var RcCtx): void {
    val capture = unsafe { *ap }
    when (capture.kind) {
        Variable(name) => {
            if capture.coerce == coerce_addr_of() { return }
            if is_heap_ty_rc(capture.ty) { consume_var_site(ap, name.as_string(), ctx) }
        }
        _ => { }
    }
}

fun rc_name_starts_with(name: String, prefix: str): bool {
    val value = name.as_str()
    val value_len = value.byte_len()
    val prefix_len = prefix.byte_len()
    if value_len < prefix_len { return false }
    var i = 0
    while i < prefix_len {
        if value.byte_at(i) != prefix.byte_at(i) { return false }
        i = i + 1
    }
    return true
}
