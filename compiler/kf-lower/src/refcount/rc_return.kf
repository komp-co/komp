// The order of a `return`'s value and its scope-exit releases.

import alloc.list.*

import kf_core.ast.Intrinsic
import kf_core.ast.expression.*

/// Narrows the locals a return path must not release.
fun refine_return_exclusions(ep: Ptr<Expr>?, ctx: &var RcCtx, exclude: &var List<String>): void {
    val rp = ep ?: return
    val rev = unsafe { *rp }
    if ty_is_view(rev.ty) {
        // A returned `str` may view any local named in it, so those leak
        // rather than dangle.
        rev.collect_escaping_names(ctx, exclude)
    }
    if is_fresh_owned_producer(rev, ctx) {
        // A fresh String cannot alias a local, so borrowed-from locals drop
        // after evaluation; only names moved into it stay excluded.
        var moved = List.new<String>()
        rev.collect_moved_names(BorrowMode.Value, &var moved)
        (*exclude) = moved
    }
}

/// Releases run after the operand is evaluated whenever there are both:
/// a local the operand does not name may still back what it reads through a
/// view. A bare move-only variable is the exception, unless it was made a
/// clone.
fun return_drops_after_eval(ep: Ptr<Expr>?, rel_count: uint64, ctx: &var RcCtx): bool {
    if rel_count == 0 { return false }
    val rp = ep ?: return false
    val rev = unsafe { *rp }
    if !rev.ty.is_move_only(ctx) { return true }
    if rev.coerce != coerce_none() { return true }
    return when (rev.kind) {
        Variable(_) => false
        _ => true
    }
}

/// The locals a returned value may still read: every one it names, except
/// below a subexpression that cannot hold a borrow, which is computed before
/// the drops and keeps only the locals moved into it.
fun Expr.collect_escaping_names(ctx: &var RcCtx, out: &var List<String>): void {
    if self.coerce != coerce_addr_of() && self.ty.holds_no_borrow(ctx) {
        self.collect_moved_names(BorrowMode.Value, out)
        return
    }
    // A copy holds nothing of the local it was taken from.
    if self.coerce == coerce_clone() { return }
    when (self.kind) {
        Variable(name) => out.push(name.as_string())
        Release(name) => out.push(name.as_string())
        Call(_n, args) => escaping_names_in_list(&args, ctx, out)
        Intrinsic(_i, args) => escaping_names_in_list(&args, ctx, out)
        CallValue(_callee, args) => escaping_names_in_list(&args, ctx, out)
        StructLit(_n, finits) => {
            while fi in &finits {
                fi.value.collect_escaping_names(ctx, out)
            }
        }
        Binary(l, _op, r) => {
            l.collect_escaping_names(ctx, out)
            r.collect_escaping_names(ctx, out)
        }
        Unary(_op, inner) => inner.collect_escaping_names(ctx, out)
        Deref(inner) => inner.collect_escaping_names(ctx, out)
        MethodCall(recv, _m, args) => {
            if !self.is_static_call && !self.is_variant_ctor { recv.collect_escaping_names(ctx, out) }
            escaping_names_in_list(&args, ctx, out)
        }
        FieldAccess(obj, _f) => obj.collect_escaping_names(ctx, out)
        IfExpr(c, t, el) => {
            c.collect_escaping_names(ctx, out)
            t.collect_escaping_names(ctx, out)
            el.collect_escaping_names(ctx, out)
        }
        Cast(inner, _t) => inner.collect_escaping_names(ctx, out)
        DynCoerce(inner, _vtable) => inner.collect_escaping_names(ctx, out)
        Retain(inner) => inner.collect_escaping_names(ctx, out)
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        LitInt(_v) => { }
        LitStr(_s) => { }
        LitFloat(_) => { }
        LitChar(_) => { }
        FnRef(_) => { }
        LitBool(_b) => { }
        Lambda(_, _) => { }
        Block(_) => { }
        Poison => { }
    }
}

fun escaping_names_in_list(args: &List<Expr>, ctx: &var RcCtx, out: &var List<String>): void {
    while item in &args {
        item.collect_escaping_names(ctx, out)
    }
}
