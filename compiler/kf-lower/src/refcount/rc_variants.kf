// Which payloads of each enum variant own something. An arm's binders carry
// no type, and releasing an `int32` would call `int32_drop`, which does not
// exist. One row per payload, in flat parallel lists.

import alloc.list.*

import kf_core.ast.*

pub struct VariantPayloads {
    var owners: List<String>
    var variants: List<String>
    var indices: List<uint64>
    var tynames: List<String>
}

pub fun no_variant_payloads(): VariantPayloads {
    return VariantPayloads {
        owners: List.new<String>(),
        variants: List.new<String>(),
        indices: List.new<uint64>(),
        tynames: List.new<String>()
    }
}

/// Only `Named` answers; "" never matches a move-only name.
fun TypeRef.payload_type_name(): String {
    return when (self.kind) {
        Named(n, _args) => n.as_string()
        _ => ""
    }
}

pub fun Module.variant_payloads_of(): VariantPayloads {
    var out = no_variant_payloads()
    while td in &self.decls {
        when (td.kind) {
            EnumDecl(variants, _p) => {
                var vi = 0
                while vi < variants.size() {
                    val v = *variants.at(vi)
                    var pi = 0
                    while pi < v.payloads.size() {
                        out.owners.push(td.name.as_string())
                        out.variants.push(v.name.as_string())
                        out.indices.push(pi)
                        out.tynames.push((v.payloads.at(pi)).payload_type_name())
                        pi = pi + 1
                    }
                    vi = vi + 1
                }
            }
            _ => {}
        }
    }
    return out
}

/// 0 for no payloads and for an unknown variant alike; ask
/// `variant_payloads_knows` when the difference matters.
pub fun VariantPayloads.variant_payload_count(owner: str, variant: str): uint64 {
    var n: uint64 = 0
    var i = 0
    while i < self.owners.size() {
        if self.owners.at(i).as_str().equals(owner) && self.variants.at(i).as_str().equals(variant) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub fun VariantPayloads.variant_payload_type(owner: str, variant: str, idx: uint64): String {
    var i = 0
    while i < self.owners.size() {
        if self.owners.at(i).as_str().equals(owner) && self.variants.at(i).as_str().equals(variant) {
            if self.indices.get(i) == idx { return self.tynames.at(i).clone() }
        }
        i = i + 1
    }
    return ""
}

/// "No payloads anywhere" and "never seen" must not be conflated.
pub fun VariantPayloads.variant_payloads_knows(name: str): bool {
    while owner in &self.owners {
        if owner.as_str().equals(name) { return true }
    }
    return false
}
