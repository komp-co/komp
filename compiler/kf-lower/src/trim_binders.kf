// Drops `when` binders for payloads substitution removed. A payload that
// became `void` is gone from the variant, but a generic body still binds it:
// `Option<T>.is_some()` matching `Some(_v)` at `Option<void>`.
//
// CONSTRAINT: the owner comes from the enclosing impl, not the subject: Mono
// leaves the subject typed as the template.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.view
import kf_core.ast.types.Type
import kf_core.ast.types.type_identity_display
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.Variant
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.statement.SwitchTag

/// Payloads per `<enum>.<variant>` as emitted.
pub struct VariantArity {
    var owners: List<String>
    var variants: List<String>
    var counts: List<uint64>
}

pub fun no_variant_arity(): VariantArity {
    return VariantArity { owners: List.new<String>(), variants: List.new<String>(), counts: List.new<uint64>() }
}

pub fun Module.variant_arity_of(): VariantArity {
    var out = no_variant_arity()
    while td in &self.decls {
        when (td.kind) {
            EnumDecl(variants, _p) => {
                var vi = 0
                while vi < variants.size() {
                    val v = *variants.at(vi)
                    out.owners.push(td.name.as_string())
                    out.variants.push(v.name.as_string())
                    out.counts.push(v.payloads.size())
                    vi = vi + 1
                }
            }
            _ => {}
        }
    }
    return out
}

/// "No such variant" and "unknown enum" must not be conflated; the second
/// leaves binders alone.
pub fun VariantArity.variant_arity_knows(name: str): bool {
    while owner in &self.owners {
        if owner.as_str().equals(name) { return true }
    }
    return false
}

/// `absent` when there is no entry.
pub fun VariantArity.variant_arity_for(owner: str, variant: str, absent: uint64): uint64 {
    var i = 0
    while i < self.owners.size() {
        if self.owners.at(i).as_str().equals(owner) && self.variants.at(i).as_str().equals(variant) {
            return self.counts.get(i)
        }
        i = i + 1
    }
    return absent
}

/// Mirrors codegen's `when_subject_enum_name`, `Struct` arm included.
pub fun Type.switch_subject_enum(): String {
    return when (self.kind) {
        Struct(name) => type_identity_display(name)
        EnumTy(name) => type_identity_display(name)
        RefTo(_mutable, pointee) => switch_subject_enum(unsafe { &*pointee })
        PtrTo(pointee) => switch_subject_enum(unsafe { &*pointee })
        _ => ""
    }
}

/// Through any borrows or derefs.
fun expr_is_self(e: &Expr): bool {
    return when (e.kind) {
        Variable(name) => name.as_str().equals("self")
        Unary(_op, inner) => expr_is_self(unsafe { &*inner })
        _ => false
    }
}

pub mutating fun Module.trim_variant_binders(): void {
    val arity = self.variant_arity_of()
    if arity.owners.size() == 0 { return }
    while i in 0..self.decls.size() {
        trim_decl(self.decls.at_mut(i), &arity, "")
    }
}

/// `self_owner` is the enclosing impl's target, or "". Edits in place: most
/// bodies bind no trimmed payload.
mutating fun TopDecl.trim_decl(arity: &VariantArity, self_owner: str): void {
    when (self.kind) {
        Function(_params, _ret, body, _p, _u, _mu, _s) => trim_stmts(&var body, arity, self_owner)
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                trim_decl(methods.at_mut(i), arity, self.name.as_str())
            }
        }
        _ => return
    }
}

fun trim_stmts(stmts: &var List<Stmt>, arity: &VariantArity, self_owner: str): void {
    while i in 0..stmts.size() {
        stmts.at_mut(i).trim_stmt(arity, self_owner)
    }
}

mutating fun Stmt.trim_stmt(arity: &VariantArity, self_owner: str): void {
    when (self.kind) {
        Switch(subj, arms) => {
            val owner = switch_owner(unsafe { &*subj }, arity, self_owner)
            while ai in 0..arms.size() {
                val a = arms.at_mut(ai)
                trim_stmts(&var a.body, arity, self_owner)
                val kept = bindable_count(&a.binders, &a.tag, owner.as_str(), arity)
                if kept < a.binders.size() {
                    blank_returns_of(&var a.body, &a.binders, kept)
                    a.binders = binder_prefix(&a.binders, kept)
                }
            }
        }
        If(_cond, then_body, else_body) => {
            trim_stmts(&var then_body, arity, self_owner)
            trim_stmts(&var else_body, arity, self_owner)
        }
        While(_cond, body) => trim_stmts(&var body, arity, self_owner)
        _ => { }
    }
}

/// `self` inside an enum's impl answers with the impl's target.
fun Expr.switch_owner(arity: &VariantArity, self_owner: str): String {
    if expr_is_self(self) {
        if arity.variant_arity_knows(self_owner) { return String.from(self_owner) }
    }
    return self.ty.switch_subject_enum()
}

/// How many written binders the variant still has payloads for. Only variant
/// arms are trimmed; an unknown owner or variant answers the written count,
/// so real bindings are never deleted.
fun bindable_count(written: &List<Sym>, tag: &SwitchTag, owner: str, arity: &VariantArity): uint64 {
    if written.size() == 0 || owner.byte_len() == 0 { return written.size() }
    val vname = when (tag) {
        Variant(name) => name.clone()
        _ => ""
    }
    if vname.as_str().byte_len() == 0 { return written.size() }
    val keep = arity.variant_arity_for(owner, vname.as_str(), written.size())
    return if keep < written.size() { keep } else { written.size() }
}

fun binder_prefix(written: &List<Sym>, keep: uint64): List<Sym> {
    var out = List.new<Sym>()
    while i in 0..keep {
        out.push(written.get(i))
    }
    return out
}

/// Kept binders are a prefix: payloads only disappear off the end.
fun is_dropped_binder(written: &List<Sym>, kept: uint64, name: str): bool {
    var i: uint64 = kept
    while i < written.size() {
        if written.at(i).as_str().equals(name) { return true }
        i = i + 1
    }
    return false
}

fun Expr.expr_reads_dropped(written: &List<Sym>, kept: uint64): bool {
    return when (self.kind) {
        Variable(name) => is_dropped_binder(written, kept, name.as_str())
        _ => false
    }
}

/// `return <dropped binder>` becomes a bare `return`: at `void` the method
/// returns nothing too. Any other read of a missing payload is left to fail.
fun blank_returns_of(stmts: &var List<Stmt>, written: &List<Sym>, kept: uint64): void {
    while i in 0..stmts.size() {
        stmts.at_mut(i).blank_returns_in(written, kept)
    }
}

mutating fun Stmt.blank_returns_in(written: &List<Sym>, kept: uint64): void {
    when (self.kind) {
        Return(e) => {
            val p = e.view() ?: return
            if expr_reads_dropped(unsafe { &*p }, written, kept) {
                self.kind = StmtKind.Return(null)
            }
        }
        Switch(_subj, arms) => {
            while ai in 0..arms.size() {
                blank_returns_of(&var arms.at_mut(ai).body, written, kept)
            }
        }
        If(_cond, then_body, else_body) => {
            blank_returns_of(&var then_body, written, kept)
            blank_returns_of(&var else_body, written, kept)
        }
        While(_cond, body) => blank_returns_of(&var body, written, kept)
        _ => { }
    }
}
