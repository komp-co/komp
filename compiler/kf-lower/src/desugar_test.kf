import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*

fun mk_some_x_arm(): Arm {
    val inner = new_pattern(no_span(), PatternKind.Identifier(intern("x")))
    var payloads = List.new<Pattern>()
    payloads.push(inner)
    val some_pat = new_pattern(no_span(), PatternKind.Variant(intern("Some"), payloads))
    val sp: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *sp = some_pat }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(bare_op())))
    return new_arm(no_span(), sp, null, body)
}

fun mk_none_arm(): Arm {
    val none_pat = new_pattern(no_span(), PatternKind.Variant(intern("None"), List.new<Pattern>()))
    val np: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *np = none_pat }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(bare_op())))
    return new_arm(no_span(), np, null, body)
}

@test fun desugar_when_to_switch(): void {
    var arms = List.new<Arm>()
    arms.push(mk_some_x_arm())
    arms.push(mk_none_arm())
    val subj = new_expr(no_span(), ExprKind.Variable(intern("opt")))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    val w = new_stmt(no_span(), StmtKind.When(sp, arms))
    val rewritten = desugar_stmt(w)
    when (rewritten.kind) {
        Switch(_, switch_arms) => {
            assert_eq(switch_arms.size() == 2, true, "two arms")
            val a0 = *switch_arms.at(0)
            when (a0.tag) {
                Variant(name) => assert_eq(name.as_str(), "Some", "first arm tag is Some")
                IntLit(_) => assert_eq(false, true, "expected Variant tag, got IntLit")
                Wildcard => assert_eq(false, true, "expected Variant tag, got Wildcard")
                Range(_, _) => assert_eq(false, true, "unexpected Range tag")
                Alternatives(_) => assert_eq(false, true, "unexpected Alternatives tag")
            }
            assert_eq(a0.binders.size() == 1, true, "Some(x) has 1 binder")
            assert_eq(a0.binders.get(0).as_str(), "x", "binder is x")
        }
        _ => assert_eq(false, true, "expected Switch")
    }
}

@test fun desugar_when_wildcard_arm(): void {
    val wild = new_pattern(no_span(), PatternKind.Wildcard)
    val wp: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *wp = wild }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(bare_op())))
    val arm = new_arm(no_span(), wp, null, body)
    var arms = List.new<Arm>()
    arms.push(arm)

    val subj = new_expr(no_span(), ExprKind.LitBool(true))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    val w = new_stmt(no_span(), StmtKind.When(sp, arms))
    val rewritten = desugar_stmt(w)
    when (rewritten.kind) {
        Switch(_, switch_arms) => {
            val a = *switch_arms.at(0)
            when (a.tag) {
                Wildcard => assert_eq(true, true, "wildcard tag preserved")
                Variant(_) => assert_eq(false, true, "expected Wildcard")
                IntLit(_) => assert_eq(false, true, "expected Wildcard, got IntLit")
                Range(_, _) => assert_eq(false, true, "unexpected Range tag")
                Alternatives(_) => assert_eq(false, true, "unexpected Alternatives tag")
            }
            assert_eq(a.binders.size() == 0, true, "wildcard binds nothing")
        }
        _ => assert_eq(false, true, "expected Switch")
    }
}

@test fun desugar_module_empty_clean(): void {
    var m = Module {
        crate: crate_id_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    m.desugar_module()
    assert_eq(m.decls.size() == 0, true, "empty module survives desugar")
}

// A literal pattern is a scalar tag, not `default:`.
@test fun an_integer_pattern_lowers_to_a_scalar_tag(): void {
    val tag = (new_pattern(no_span(), PatternKind.LitInt(7))).pattern_to_tag()
    when (tag) {
        IntLit(n) => assert_eq(n, 7, "the literal carries through to the case constant")
        Variant(_) => fail("expected IntLit, got Variant")
        Wildcard => fail("expected IntLit, got Wildcard")
        Range(_, _) => fail("unexpected Range tag")
        Alternatives(_) => fail("unexpected Alternatives tag")
    }
}

@test fun a_true_pattern_lowers_to_one(): void {
    val tag = (new_pattern(no_span(), PatternKind.LitBool(true))).pattern_to_tag()
    when (tag) {
        IntLit(n) => assert_eq(n, 1, "C compares a bool as an integer")
        Variant(_) => fail("expected IntLit, got Variant")
        Wildcard => fail("expected IntLit, got Wildcard")
        Range(_, _) => fail("unexpected Range tag")
        Alternatives(_) => fail("unexpected Alternatives tag")
    }
}

@test fun a_false_pattern_lowers_to_zero(): void {
    val tag = (new_pattern(no_span(), PatternKind.LitBool(false))).pattern_to_tag()
    when (tag) {
        IntLit(n) => assert_eq(n, 0, "`false` is case 0")
        Variant(_) => fail("expected IntLit, got Variant")
        Wildcard => fail("expected IntLit, got Wildcard")
        Range(_, _) => fail("unexpected Range tag")
        Alternatives(_) => fail("unexpected Alternatives tag")
    }
}

fun bare_op(): Box<Expr>? {
    return null
}

@test fun a_range_pattern_lowers_to_a_range_tag(): void {
    val tag = (new_pattern(no_span(), PatternKind.Range(0, 31, false))).pattern_to_tag()
    when (tag) {
        Range(low, high) => assert_eq(high - low, 31, "both bounds carry through, inclusive")
        IntLit(_) => fail("expected Range, got IntLit")
        Variant(_) => fail("expected Range, got Variant")
        Alternatives(_) => fail("expected Range, got Alternatives")
        Wildcard => fail("expected Range, got Wildcard")
    }
}

@test fun a_catch_all_alternative_lowers_to_a_wildcard(): void {
    var alternatives = List.new<Pattern>()
    alternatives.push(new_pattern(no_span(), PatternKind.LitInt(1)))
    alternatives.push(new_pattern(no_span(), PatternKind.Wildcard))
    val tag = (new_pattern(no_span(), PatternKind.Or(alternatives))).pattern_to_tag()
    when (tag) {
        Wildcard => assert_eq(true, true, "`1 | _` matches anything")
        IntLit(_) => fail("expected Wildcard, got IntLit")
        Variant(_) => fail("expected Wildcard, got Variant")
        Range(_, _) => fail("expected Wildcard, got Range")
        Alternatives(_) => fail("expected Wildcard, got Alternatives")
    }
}

@test fun alternatives_lower_to_one_label_each(): void {
    var alternatives = List.new<Pattern>()
    alternatives.push(new_pattern(no_span(), PatternKind.LitInt(1)))
    alternatives.push(new_pattern(no_span(), PatternKind.LitInt(2)))
    val tag = (new_pattern(no_span(), PatternKind.Or(alternatives))).pattern_to_tag()
    when (tag) {
        Alternatives(tags) => assert_eq(tags.size(), 2, "one tag per alternative")
        IntLit(_) => fail("expected Alternatives, got IntLit")
        Variant(_) => fail("expected Alternatives, got Variant")
        Range(_, _) => fail("expected Alternatives, got Range")
        Wildcard => fail("expected Alternatives, got Wildcard")
    }
}
