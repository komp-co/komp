import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.declaration.TopDecl

@test fun lower_empty_module_runs_clean(): void {
    var m = Module {
        crate: crate_id_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    val sm: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *sm = new_source_map() }
    val diags = m.lower_module(sm, (&m).lang_type_name(lang_list_key()))
    assert_eq(diags.size() == 0, true, "empty module yields zero diagnostics")
}
