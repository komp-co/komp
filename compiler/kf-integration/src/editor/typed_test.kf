// Hover and inlays on a real crate that depends on nothing.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq

import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module
import kf_core.diagnostic.*
import kf_driver.fresh_source_map
import kf_driver.collect_module_diags
import kf_driver.editor.innermost_expr_at
import kf_driver.editor.written_type
import kf_driver.editor.path_for_file_id
import kf_driver.editor.render_inlays_json
import kf_integration.harness.assemble_project
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun typed_fixture_path(): str {
    return scratch_path("kf_query_typed/src/main.kf")
}

/// `fun add(a: int32, b: int32): int32 { return a + b }`, then a main binding
/// its result.
fun typed_fixture_source(): String {
    val src = """fun add(a: int32, b: int32): int32 {
    return a + b
}

fun run(): int32 {
    val total = add(1, 2)
    return total
}
"""
    return src
}

fun prepare_typed_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_typed")} && mkdir -p ${scratch_path("kf_query_typed/src")}") }
    write_file(scratch_path("kf_query_typed/kf.toml"), "[project]\nname = \"query_typed\"\nkind = \"lib\"\n")
    write_file(typed_fixture_path(), typed_fixture_source().as_str())
}

/// `a` in `return a + b`, after a 37-byte first line.
fun offset_of_a(): uint32 {
    return 48
}

@test
fun hover_reports_the_type_the_checker_gave_an_expression(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val hit = crate.module.innermost_expr_at(crate.file_id, offset_of_a())
    assert_eq(hit.ty.written_type(crate.sigs).as_str(), "int32", "`a` in `a + b` is an int32")
}

@test
fun hover_answers_nothing_where_no_expression_sits(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val hit = crate.module.innermost_expr_at(crate.file_id, 0)
    assert_eq(hit.found, false, "the `fun` keyword covers no expression")
}

@test
fun a_typed_query_finds_the_crate_above_the_file(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    assert_eq(crate.ok, true, "the file's crate root is the directory holding kf.toml")
}

@test
fun a_typed_query_refuses_a_file_with_no_crate(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_loose")} && mkdir -p ${scratch_path("kf_query_loose")}") }
    write_file(scratch_path("kf_query_loose/stray.kf"), "fun f(): int32 { return 1 }\n")
    val crate = typed_crate_for(scratch_path("kf_query_loose/stray.kf"))
    assert_eq(crate.ok, false, "a .kf with no kf.toml above it is not part of a crate")
}

@test
fun an_inlay_hint_names_the_type_of_an_unannotated_binding(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    assert_eq(json.as_str().contains("\"label\":\": int32\""), true, "`val total = add(1, 2)` is an int32")
}

@test
fun an_inlay_hint_sits_at_the_end_of_the_binder_name(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    // `val` at 80, so `total` ends at 89.
    assert_eq(json.as_str().contains("\"byte_offset\":89"), true, "the hint lands where the name ends")
}

@test
fun hover_renders_nothing_for_an_offset_outside_the_file(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val hit = crate.module.innermost_expr_at(crate.file_id, 9000)
    assert_eq(hit.found, false, "an offset past the end of the file covers no expression")
}

fun loop_fixture_path(): str {
    return scratch_path("kf_query_loop/src/main.kf")
}

/// `while i in 0..3`, whose expansion mints bindings carrying the loop's span.
fun prepare_loop_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_loop")} && mkdir -p ${scratch_path("kf_query_loop/src")}") }
    write_file(scratch_path("kf_query_loop/kf.toml"), "[project]\nname = \"query_loop\"\nkind = \"lib\"\n")
    var src = """fun count(): int32 {
    var sum = 0
    while i in 0..3 {
        sum = sum + i
    }
    return sum
}
"""
    write_file(loop_fixture_path(), src.as_str())
}

@test
fun a_desugared_loop_contributes_no_inlay_hints(): void {
    prepare_loop_fixture()
    val crate = typed_crate_for(loop_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    // `var sum = 0` is the only written binding; its name ends at 32.
    assert_eq(json.as_str().contains("\"byte_offset\":32"), true, "the written binding is hinted")
    // The loop variable `i` ends at 48.
    assert_eq(json.as_str().contains("\"byte_offset\":48"), false, "the loop variable is not a binding site")
    assert_eq(json.as_str().contains("RangeIter"), false, "no synthesized iterator type leaks out")
    assert_eq(json.as_str().contains("Option__"), false, "no synthesized option type leaks out")
}

@test
fun a_binder_span_survives_the_clone_every_body_goes_through(): void {
    prepare_typed_fixture()
    // Merging deep-clones every decl; the binder must survive.
    val crate = typed_crate_for(typed_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    assert_eq(json.as_str().contains("\"byte_offset\":89"), true, "the binder survives merge_module_list")
}

// A misspelled method's fix covers the method name.

fun fix_fixture_path(): str {
    return scratch_path("kf_diag_fix/src/main.kf")
}

fun prepare_fix_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_diag_fix")} && mkdir -p ${scratch_path("kf_diag_fix/src")}") }
    write_file(scratch_path("kf_diag_fix/kf.toml"), "[project]\nname = \"diag_fix\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Point {\n")
    src.append("    pub val x: int32\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Point {\n")
    src.append("    pub fun sum(): int32 {\n")
    src.append("        return self.x\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val p = Point { x: 1 }\n")
    src.append("    return p.sunm()\n")
    src.append("}\n")
    write_file(fix_fixture_path(), src.as_str())
}

/// `typed_crate_for` drops diagnostics, so the check is re-run.
fun fix_fixture_diags(): List<Diagnostic> {
    prepare_fix_fixture()
    var crate = typed_crate_for(fix_fixture_path())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    return typecheck_module(&var crate.module, &var table)
}

@test
fun a_near_miss_method_is_named_in_the_message(): void {
    val diags = fix_fixture_diags()
    var said = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("did you mean `sum`?") { said = true }
    }
    assert_eq(said, true, "`sunm` is one edit from `sum`, and the message says so")
}

@test
fun a_near_miss_method_carries_a_fix_over_the_name_only(): void {
    val diags = fix_fixture_diags()
    var checked = false
    while d in &diags {
        if fix_has_repair(&d.fix) {
            checked = true
            assert_eq(d.fix.replacement.as_str(), "sum", "the repair writes the real method name")
            // `sunm` is 4 bytes; the call's own span opens at the receiver.
            assert_eq(d.fix.span.end - d.fix.span.start, 4 as uint32, "and covers the name, not the call")
        }
    }
    assert_eq(checked, true, "the diagnostic carries a repair at all")
}

// `impl Cell<T>` registers under the base name, so `Cell__int32` finds its
// candidates by falling back to it.

fun generic_fix_fixture_path(): str {
    return scratch_path("kf_diag_fix_generic/src/main.kf")
}

/// `unwrp` for `unwrap`, within budget, on a fixture-declared `Cell<int32>`.
fun prepare_generic_fix_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_diag_fix_generic")} && mkdir -p ${scratch_path("kf_diag_fix_generic/src")}") }
    write_file(scratch_path("kf_diag_fix_generic/kf.toml"), "[project]\nname = \"diag_fix_generic\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Cell<T> {\n")
    src.append("    pub val item: T\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Cell<T> {\n")
    src.append("    pub fun unwrap(): T {\n")
    src.append("        return self.item\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val c = Cell<int32> { item: 1 }\n")
    src.append("    return c.unwrp()\n")
    src.append("}\n")
    write_file(generic_fix_fixture_path(), src.as_str())
}

fun generic_fix_fixture_diags(): List<Diagnostic> {
    prepare_generic_fix_fixture()
    var crate = typed_crate_for(generic_fix_fixture_path())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    return typecheck_module(&var crate.module, &var table)
}

@test
fun a_near_miss_on_a_generic_instance_is_named(): void {
    val diags = generic_fix_fixture_diags()
    var said = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("did you mean `unwrap`?") { said = true }
    }
    assert_eq(said, true, "the receiver reports as `Cell__int32`; the method lives on `Cell`")
}

@test
fun a_near_miss_on_a_generic_instance_carries_a_fix(): void {
    val diags = generic_fix_fixture_diags()
    var checked = false
    while d in &diags {
        if fix_has_repair(&d.fix) {
            checked = true
            assert_eq(d.fix.replacement.as_str(), "unwrap", "the repair writes the base impl's method name")
            assert_eq(d.fix.span.end - d.fix.span.start, 5 as uint32, "over `unwrp`, not the whole call")
        }
    }
    assert_eq(checked, true, "a monomorphized receiver gets a repair, not just a message")
}

@test
fun a_far_off_name_on_a_generic_instance_stays_silent(): void {
    // The fallback widens the candidates, never the budget.
    unsafe { system("rm -rf ${scratch_path("kf_diag_fix_far")} && mkdir -p ${scratch_path("kf_diag_fix_far/src")}") }
    write_file(scratch_path("kf_diag_fix_far/kf.toml"), "[project]\nname = \"diag_fix_far\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Cell<T> {\n")
    src.append("    pub val item: T\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Cell<T> {\n")
    src.append("    pub fun unwrap(): T {\n")
    src.append("        return self.item\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val c = Cell<int32> { item: 1 }\n")
    src.append("    return c.frobnicate()\n")
    src.append("}\n")
    write_file(scratch_path("kf_diag_fix_far/src/main.kf"), src.as_str())
    var crate = typed_crate_for(scratch_path("kf_diag_fix_far/src/main.kf"))
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    val diags = typecheck_module(&var crate.module, &var table)
    var suggested = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("did you mean") { suggested = true }
        if fix_has_repair(diag.fix) { suggested = true }
    }
    assert_eq(suggested, false, "`frobnicate` is nothing like `unwrap`, so nothing is offered")
}

// Unused imports need every body checked: the lint reads which module each
// name resolved to.

/// `Pair` comes from `helper`; nothing names anything from `spare`.
fun prepare_unused_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_unused_import")} && mkdir -p ${scratch_path("kf_unused_import/src/helper")} ${scratch_path("kf_unused_import/src/spare")}") }
    write_file(scratch_path("kf_unused_import/kf.toml"), "[project]\nname = \"unused_import\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_unused_import/src/helper/helper.kf"), "pub struct Pair {\n    pub val a: int32\n}\n")
    write_file(scratch_path("kf_unused_import/src/spare/spare.kf"), "pub struct Unwanted {\n    pub val b: int32\n}\n")
    var src = """import unused_import.helper.*
import unused_import.spare.*
import kf_driver.editor.path_for_file_id
import kf_driver.editor.render_inlays_json

pub fun probe(): int32 {
    val p = Pair { a: 1 }
    return p.a
}
"""
    write_file(scratch_path("kf_unused_import/src/main.kf"), src.as_str())
}

/// As the driver builds them: the lint needs `Module.crate`.
fun unused_fixture_diags(): List<Diagnostic> {
    prepare_unused_fixture()
    val smap = fresh_source_map()
    var pdiags = new_diagnostics()
    var merged = assemble_project(scratch_path("kf_unused_import"), smap, &var pdiags)
    return merged.collect_module_diags(smap)
}

fun says_unused(diags: &List<Diagnostic>, path: str): bool {
    while diag in &diags {
        val m = diag.primary.message
        if m.as_str().contains("unused import") && m.as_str().contains(path) { return true }
    }
    return false
}

@test
fun an_import_nothing_names_is_reported(): void {
    val diags = unused_fixture_diags()
    assert_eq(says_unused(&diags, "unused_import.spare"), true,
        "nothing in main.kf names anything spare declares")
}

@test
fun an_import_that_is_named_is_left_alone(): void {
    val diags = unused_fixture_diags()
    assert_eq(says_unused(&diags, "unused_import.helper"), false,
        "`Pair` is written, so its import earns its line")
}

@test
fun an_unused_import_is_a_warning_carrying_a_cautious_fix(): void {
    // Not an error, and not machine-applicable: a name can reach a module by
    // a path the analysis does not watch.
    val diags = unused_fixture_diags()
    var checked = false
    while d in &diags {
        if d.primary.message.as_str().contains("unused import") {
            checked = true
            assert_eq(d.diag_is_warning(), true, "reported as a warning, not an error")
            assert_eq(fix_is_machine_applicable(&d.fix), false, "so `komp check --fix` leaves it alone")
            assert_eq(d.fix.replacement.as_str(), "", "the repair deletes rather than rewrites")
        }
    }
    assert_eq(checked, true, "the fixture produced one")
}

fun Diagnostic.diag_is_warning(): bool {
    return when (self.severity) {
        Warning => true
        _ => false
    }
}

// The buffer, not the file: each fixture is on disk and the query answers
// about unsaved text.

/// With a function appended that was never saved.
fun staged_typed_source(): String {
    var src = typed_fixture_source()
    src.append("\n")
    src.append("fun staged_only(staged_param: int32): int32 {\n")
    src.append("    return staged_param\n")
    src.append("}\n")
    return src
}

/// In the buffer alone, past the end of the file on disk.
fun offset_of_staged_param(): uint32 {
    return index_of(staged_typed_source().as_str(), "return staged_param") + 7
}

@test
fun a_typed_query_checks_the_staged_buffer(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for_overlay(typed_fixture_path(), staged_typed_source().as_str())
    val hit = crate.module.innermost_expr_at(crate.file_id, offset_of_staged_param())
    assert_eq(hit.ty.written_type(crate.sigs).as_str(), "int32",
        "a function nobody has saved still has types")
}

@test
fun without_an_overlay_the_same_offset_is_past_the_end_of_the_file(): void {
    // The offset is past the end of the saved file.
    prepare_typed_fixture()
    val crate = typed_crate_for(typed_fixture_path())
    val hit = crate.module.innermost_expr_at(crate.file_id, offset_of_staged_param())
    assert_eq(hit.found, false, "the file on disk has no expression there")
}

@test
fun a_staged_file_keeps_the_identity_the_walk_gave_it(): void {
    // The overlay replaces bytes in place, so cross-file answers keep their
    // neighbours.
    prepare_typed_fixture()
    val crate = typed_crate_for_overlay(typed_fixture_path(), staged_typed_source().as_str())
    assert_eq(crate.ok, true, "still found inside its own project")
    assert_eq(path_for_file_id(crate.smap, crate.file_id).as_str(), typed_fixture_path(),
        "and still registered under its own path")
}

@test
fun a_staged_buffer_is_the_source_an_answer_quotes(): void {
    prepare_typed_fixture()
    val crate = typed_crate_for_overlay(typed_fixture_path(), staged_typed_source().as_str())
    assert_eq(crate.source.as_str(), staged_typed_source().as_str(),
        "so a span rendered back to the reader quotes what they wrote")
}

// `Cell`'s parameter is `A` while the receiver binds `K` and `V`, so a match
// by parameter name cannot pass.

fun subst_fixture_path(): str {
    return scratch_path("kf_query_subst/src/main.kf")
}

fun prepare_subst_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_subst")} && mkdir -p ${scratch_path("kf_query_subst/src")}") }
    write_file(scratch_path("kf_query_subst/kf.toml"), "[project]\nname = \"query_subst\"\nkind = \"lib\"\n")
    var src = String.from("struct Cell<A> {\n")
    src.append("    val item: A\n")
    src.append("}\n")
    src.append("\n")
    src.append("struct Tag {\n")
    src.append("    val n: int32\n")
    src.append("}\n")
    src.append("\n")
    src.append("struct Holder<K, V> {\n")
    src.append("    val key: K\n")
    src.append("    val slot: V\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Holder<K, V> {\n")
    src.append("    fun fetch(): Cell<V> {\n")
    src.append("        return Cell<V> { item: self.slot }\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("fun wrap<Q>(x: Q): Cell<Q> {\n")
    src.append("    return Cell<Q> { item: x }\n")
    src.append("}\n")
    src.append("\n")
    src.append("fun run(): int32 {\n")
    src.append("    val h = Holder<int32, Tag> { key: 1, slot: Tag { n: 2 } }\n")
    src.append("    val got = h.fetch()\n")
    src.append("    val made = wrap<Tag>(Tag { n: 3 })\n")
    src.append("    return got.item.n + made.item.n\n")
    src.append("}\n")
    write_file(subst_fixture_path(), src.as_str())
}

@test
fun a_methods_inferred_instance_renders_the_way_it_was_written(): void {
    prepare_subst_fixture()
    val crate = typed_crate_for(subst_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    assert_eq(json.as_str().contains("\"label\":\": Cell<Tag>\""), true, "`h.fetch()` returns a Cell<Tag>")
}

@test
fun a_generic_functions_inferred_instance_renders_the_way_it_was_written(): void {
    prepare_subst_fixture()
    val crate = typed_crate_for(subst_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    // Absent, not merely outnumbered.
    assert_eq(json.as_str().contains("Cell__Tag"), false, "no link name reaches the reader")
}

fun arity_fixture_path(): str {
    return scratch_path("kf_diag_arity/src/main.kf")
}

/// `Pair` takes two type parameters and the call supplies one.
fun prepare_arity_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_diag_arity")} && mkdir -p ${scratch_path("kf_diag_arity/src")}") }
    write_file(scratch_path("kf_diag_arity/kf.toml"), "[project]\nname = \"diag_arity\"\nkind = \"lib\"\n")
    var src = String.from("pub enum Pair<A, B> {\n")
    src.append("    L(A)\n")
    src.append("    R(B)\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Pair<A, B> {\n")
    src.append("    pub static fun left(a: A): Pair<A, B> {\n")
    src.append("        return Pair.L<A, B>(a)\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val p = Pair.left<int32>(1)\n")
    src.append("    return 0\n")
    src.append("}\n")
    write_file(arity_fixture_path(), src.as_str())
}

fun arity_fixture_diags(): List<Diagnostic> {
    prepare_arity_fixture()
    var crate = typed_crate_for(arity_fixture_path())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    return typecheck_module(&var crate.module, &var table)
}

@test
fun too_few_type_arguments_on_a_static_call_is_reported(): void {
    val diags = arity_fixture_diags()
    var said = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("takes 2 type arguments") { said = true }
    }
    assert_eq(said, true, "the arity mismatch is reported, not left for mono to crash on")
}

@test
fun a_type_argument_arity_message_names_both_counts(): void {
    val diags = arity_fixture_diags()
    var checked = false
    while diag in &diags {
        val msg = diag.primary.message.clone()
        if msg.as_str().contains("takes 2 type arguments") {
            checked = true
            assert_eq(msg.as_str().contains("1 was supplied"), true, "the message says how many arrived")
            assert_eq(msg.as_str().contains("Pair"), true, "and which type it is about")
        }
    }
    assert_eq(checked, true, "the arity diagnostic is present to inspect")
}

fun field_fixture_path(): str {
    return scratch_path("kf_diag_field/src/main.kf")
}

/// A method read as a field, and a name that is neither.
fun prepare_field_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_diag_field")} && mkdir -p ${scratch_path("kf_diag_field/src")}") }
    write_file(scratch_path("kf_diag_field/kf.toml"), "[project]\nname = \"diag_field\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Bag {\n")
    src.append("    pub val n: int32\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Bag {\n")
    src.append("    pub fun total(): int32 {\n")
    src.append("        return self.n\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val b = Bag { n: 1 }\n")
    src.append("    val t = b.total\n")
    src.append("    val q = b.nope\n")
    src.append("    return 0\n")
    src.append("}\n")
    write_file(field_fixture_path(), src.as_str())
}

fun field_fixture_diags(): List<Diagnostic> {
    prepare_field_fixture()
    var crate = typed_crate_for(field_fixture_path())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    return typecheck_module(&var crate.module, &var table)
}

@test
fun a_field_that_does_not_exist_is_reported(): void {
    val diags = field_fixture_diags()
    var said = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("no field `nope` on `Bag`") { said = true }
    }
    assert_eq(said, true, "an absent field is named, not left for gcc")
}

/// `total` is a method with its parentheses left off, not a near miss.
@test
fun a_method_read_as_a_field_says_so(): void {
    val diags = field_fixture_diags()
    var checked = false
    while diag in &diags {
        val msg = diag.primary.message.clone()
        if msg.as_str().contains("no field `total`") {
            checked = true
            assert_eq(msg.as_str().contains("is a method"), true, "it says the name IS a method")
            assert_eq(msg.as_str().contains("total()"), true, "and shows the call form")
        }
    }
    assert_eq(checked, true, "the method-as-field diagnostic is present to inspect")
}

fun static_arity_fixture_path(): str {
    return scratch_path("kf_diag_static_arity/src/main.kf")
}

/// A static method called with too few arguments.
fun prepare_static_arity_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_diag_static_arity")} && mkdir -p ${scratch_path("kf_diag_static_arity/src")}") }
    write_file(scratch_path("kf_diag_static_arity/kf.toml"), "[project]\nname = \"diag_static_arity\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Thing {\n")
    src.append("    pub val n: int32\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Thing {\n")
    src.append("    pub static fun takes_one(a: int32): int32 {\n")
    src.append("        return a\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    return Thing.takes_one()\n")
    src.append("}\n")
    write_file(static_arity_fixture_path(), src.as_str())
}

fun static_arity_fixture_diags(): List<Diagnostic> {
    prepare_static_arity_fixture()
    var crate = typed_crate_for(static_arity_fixture_path())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    return typecheck_module(&var crate.module, &var table)
}

@test
fun a_static_call_with_too_few_arguments_is_reported(): void {
    val diags = static_arity_fixture_diags()
    var said = false
    while diag in &diags {
        if diag.primary.message.as_str().contains("takes_one") { said = true }
    }
    assert_eq(said, true, "the static path reports arity like the other two, not silently poisons")
}

@test
fun a_static_arity_message_names_both_counts(): void {
    val diags = static_arity_fixture_diags()
    var checked = false
    while diag in &diags {
        val msg = diag.primary.message.clone()
        if msg.as_str().contains("takes_one") {
            checked = true
            assert_eq(msg.as_str().contains("expected 1"), true, "the declared count")
            assert_eq(msg.as_str().contains("found 0"), true, "and the one written")
        }
    }
    assert_eq(checked, true, "the arity diagnostic is present to inspect")
}
