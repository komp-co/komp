// Scope completion on a real crate. Each test pairs a name offered with one
// in the same function that is not. Offsets come from markers.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_completion_json

extern "C" fun system(cmd: str): int32

fun scope_fixture_path(): str {
    return scratch_path("kf_query_scope/src/main.kf")
}

/// Raw, so it sits at column 0.
fun scope_fixture_source(): String {
    return String.from("""pub struct Point {
    pub val x: int32
}

pub enum Maybe {
    Nothing
    Just(int32)
}

pub fun helper(a: int32): int32 {
    return a
}

pub fun probe(seed: int32): int32 {
    val outer = 1
    if seed > 0 {
        val in_then = 2
        // MARK_THEN
    } else {
        val in_else = 3
        // MARK_ELSE
    }
    val later = 4
    // MARK_AFTER
    while step in 0..3 {
        // MARK_LOOP
    }
    val m = Maybe.Just(7)
    when (m) {
        Just(payload) => {
            // MARK_ARM
        }
        Nothing => { }
    }
    return 0
}
""")
}

/// A typed query assembles the test files too.
fun scope_test_file_source(): String {
    return String.from("""@test
fun a_test_nobody_calls(): void {
}

fun a_helper_a_test_calls(): int32 {
    return 1
}
""")
}

fun prepare_scope_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_scope")} && mkdir -p ${scratch_path("kf_query_scope/src")}") }
    write_file(scratch_path("kf_query_scope/kf.toml"), """[project]
name = "query_scope"
kind = "lib"
""")
    write_file(scope_fixture_path(), scope_fixture_source().as_str())
    write_file(scratch_path("kf_query_scope/src/main_test.kf"), scope_test_file_source().as_str())
}

fun scope_at(marker: str): String {
    prepare_scope_fixture()
    val offset = index_of(scope_fixture_source().as_str(), marker)
    val crate = typed_crate_for(scope_fixture_path())
    return render_completion_json("main.kf", offset, &crate)
}

fun offers(json: str, label: str): bool {
    val needle = "\"label\":\"${label}\","
    return json.contains(needle.as_str())
}

@test
fun a_cursor_off_a_member_position_completes_the_scope(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(json.contains("\"receiver_type\":null"), true, "nothing to the left of a dot, so no receiver")
    assert_eq(json.contains("\"items\":[]"), false, "but the names in scope are not nothing")
}

@test
fun a_local_declared_above_the_cursor_is_offered(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(offers(json, "outer"), true, "declared at the top of the function")
    assert_eq(offers(json, "later"), true, "and the one just above the cursor")
}

@test
fun a_local_declared_below_the_cursor_is_not(): void {
    // `later` is written after MARK_THEN.
    val json = scope_at("// MARK_THEN").as_str()
    assert_eq(offers(json, "outer"), true, "the one above is in scope")
    assert_eq(offers(json, "later"), false, "the one below is not in scope yet")
}

@test
fun the_two_arms_of_an_if_do_not_see_each_other(): void {
    // Both blocks close before MARK_AFTER.
    val then_json = scope_at("// MARK_THEN").as_str()
    assert_eq(offers(then_json, "in_then"), true, "its own block's local")
    assert_eq(offers(then_json, "in_else"), false, "not the other arm's")

    val else_json = scope_at("// MARK_ELSE").as_str()
    assert_eq(offers(else_json, "in_else"), true, "and the same in reverse")
    assert_eq(offers(else_json, "in_then"), false, "the arm not taken binds nothing here")
}

@test
fun a_block_local_does_not_escape_its_block(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(offers(json, "in_then"), false, "the if has closed")
    assert_eq(offers(json, "in_else"), false, "both of them have")
}

@test
fun a_local_carries_the_type_the_checker_gave_it(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(json.contains("\"label\":\"outer\",\"kind\":\"local\",\"detail\":\"int32\""), true,
              "inferred from the initializer, not from the spelling")
}

@test
fun a_loop_binder_is_in_scope_in_its_body(): void {
    val json = scope_at("// MARK_LOOP").as_str()
    assert_eq(offers(json, "step"), true, "`while step in ...` binds `step` over the body")
}

@test
fun a_loop_binder_does_not_outlive_its_loop(): void {
    val json = scope_at("// MARK_ARM").as_str()
    assert_eq(offers(json, "step"), false, "the loop has closed")
}

@test
fun a_when_arm_binds_its_payload(): void {
    val json = scope_at("// MARK_ARM").as_str()
    assert_eq(offers(json, "payload"), true, "the `x` in `Just(x)` is what a reader reaches for there")
}

@test
fun the_enclosing_functions_parameters_are_in_scope(): void {
    val json = scope_at("// MARK_THEN").as_str()
    assert_eq(json.contains("\"label\":\"seed\",\"kind\":\"parameter\",\"detail\":\"int32\""), true,
              "a parameter is nameable anywhere in its body")
}

@test
fun another_functions_parameter_is_not(): void {
    val json = scope_at("// MARK_THEN").as_str()
    assert_eq(offers(json, "a"), false, "`helper`'s parameter belongs to `helper`")
}

@test
fun the_crates_own_declarations_are_offered(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(json.contains("\"label\":\"helper\",\"kind\":\"function\",\"detail\":\"(a: int32): int32\""), true,
              "a function with enough signature to choose by")
    assert_eq(json.contains("\"label\":\"Point\",\"kind\":\"struct\""), true, "and the types")
    assert_eq(json.contains("\"label\":\"Maybe\",\"kind\":\"enum\""), true, "of both kinds")
}

@test
fun a_local_shadowing_a_declaration_is_offered_as_the_local(): void {
    // One item per name, innermost first.
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(json.contains("\"label\":\"outer\",\"kind\":\"local\""), true, "the local wins")
    assert_eq(json.contains("\"label\":\"outer\",\"kind\":\"function\""), false, "and is not also listed as anything else")
}

// Types resolve globally; free functions are gated per file.

fun app_path(): str { return scratch_path("kf_query_scope_app/src/main.kf") }

fun app_source(with_import: bool): String {
    val body = String.from("""pub fun probe(): int32 {
    // MARK_DEP
    return 0
}
""")
    if !with_import { return body }
    return String.from("""import helperlib.api.*

""") + body
}

/// `helperlib` declares one function and one type.
fun dep_answer(with_import: bool): String {
    unsafe { system("rm -rf ${scratch_path("kf_query_scope_dep")} ${scratch_path("kf_query_scope_app")} && mkdir -p ${scratch_path("kf_query_scope_dep/src")} ${scratch_path("kf_query_scope_app/src")}") }
    write_file(scratch_path("kf_query_scope_dep/kf.toml"), """[project]
name = "helperlib"
kind = "lib"
""")
    write_file(scratch_path("kf_query_scope_dep/src/api.kf"), """pub struct LibType {
    pub val v: int32
}

pub fun lib_helper(a: int32): int32 {
    return a
}
""")
    write_file(scratch_path("kf_query_scope_app/kf.toml"), """[project]
name = "app"
kind = "lib"

[dependencies]
helperlib = { path = "../kf_query_scope_dep" }
""")
    val src = app_source(with_import)
    write_file(app_path(), src.as_str())
    val offset = index_of(src.as_str(), "// MARK_DEP")
    val crate = typed_crate_for(app_path())
    return render_completion_json("main.kf", offset, &crate)
}

@test
fun a_dependencys_function_needs_an_import(): void {
    val json = dep_answer(false).as_str()
    assert_eq(offers(json, "lib_helper"), false, "not imported, so writing it would not compile")
}

@test
fun a_dependencys_function_is_offered_once_imported(): void {
    val json = dep_answer(true).as_str()
    assert_eq(offers(json, "lib_helper"), true, "the import is what makes it callable")
}

@test
fun a_dependencys_type_needs_no_import(): void {
    val json = dep_answer(false).as_str()
    assert_eq(offers(json, "LibType"), true, "nameable without an import, because it is")
}

@test
fun at_the_top_level_there_are_declarations_but_no_locals(): void {
    // Byte 4 is inside `pub struct Point`.
    prepare_scope_fixture()
    val crate = typed_crate_for(scope_fixture_path())
    val json = render_completion_json("main.kf", 4, &crate).as_str()
    assert_eq(offers(json, "Point"), true, "the crate's types are still nameable — `impl` takes one")
    assert_eq(offers(json, "outer"), false, "but no function's locals are")
    assert_eq(offers(json, "seed"), false, "and no function's parameters")
    assert_eq(offers(json, "helper"), false, "a function is not callable between declarations")
    assert_eq(offers(json, "fun"), true, "and a declaration keyword is")
}

/// 0 when absent.
fun index_of(hay: str, needle: str): uint32 {
    val hn = hay.byte_len()
    val nn = needle.byte_len()
    if nn == 0 { return 0 }
    if nn > hn { return 0 }
    var i: uint64 = 0
    while i + nn <= hn {
        var j: uint64 = 0
        var same = true
        while j < nn {
            if hay.byte_at(i + j) != needle.byte_at(j) { same = false }
            j = j + 1
        }
        if same { return i as uint32 }
        i = i + 1
    }
    return 0
}

@test
fun every_marker_is_found(): void {
    // A missing marker would read as offset 0.
    val src = scope_fixture_source()
    assert_eq(index_of(src.as_str(), "// MARK_THEN") > 0, true, "MARK_THEN")
    assert_eq(index_of(src.as_str(), "// MARK_ELSE") > 0, true, "MARK_ELSE")
    assert_eq(index_of(src.as_str(), "// MARK_AFTER") > 0, true, "MARK_AFTER")
    assert_eq(index_of(src.as_str(), "// MARK_LOOP") > 0, true, "MARK_LOOP")
    assert_eq(index_of(src.as_str(), "// MARK_ARM") > 0, true, "MARK_ARM")
}

@test
fun a_test_function_is_not_offered(): void {
    // Nothing writes a `@test`'s name.
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(offers(json, "a_test_nobody_calls"), false, "nothing calls a `@test` by name")
}

@test
fun a_plain_function_in_a_test_file_still_is(): void {
    val json = scope_at("// MARK_AFTER").as_str()
    assert_eq(offers(json, "a_helper_a_test_calls"), true, "the gate is the annotation, not the file")
}
