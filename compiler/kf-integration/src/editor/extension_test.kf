import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_completion_json
import kf_driver.editor.render_hover_json
import kf_driver.editor.render_signature_json
import kf_driver.editor.render_symbols_json

extern "C" fun system(cmd: str): int32

fun extension_fixture_source(): str {
    return """pub struct Point {
    pub val x: int32
}

pub fun Point.scaled(by: int32): int32 {
    return self.x * by
}

pub fun probe(): int32 {
    val p = Point { x: 2 }
    return p.scaled(3)
}
"""
}

fun extension_fixture_path(): str {
    return scratch_path("kf_query_extension/src/main.kf")
}

fun extension_crate(): TypedCrate {
    val root = scratch_path("kf_query_extension")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file(scratch_path("kf_query_extension/kf.toml"), "[project]\nname = \"query_extension\"\nkind = \"lib\"\n")
    write_file(extension_fixture_path(), extension_fixture_source())
    return typed_crate_for(extension_fixture_path())
}

fun after_the_dot(): uint32 {
    return extension_fixture_source().index_of("p.scaled(3)")!! as uint32 + 2
}

@test
fun an_extension_is_listed_under_its_receiver_and_name(): void {
    val json = render_symbols_json("main.kf", &extension_crate().module)
    val expected = "\"name\":\"Point.scaled\",\"kind\":\"function\",\"detail\":\"(by: int32): int32\""
    val listed = json.as_str().contains(expected)
    assert_eq(listed, true, "not the hidden name, and without `self`")
}

@test
fun an_extension_is_offered_after_a_dot(): void {
    val crate = extension_crate()
    val json = render_completion_json("main.kf", after_the_dot(), &crate)
    val expected = "\"label\":\"scaled\",\"kind\":\"method\",\"detail\":\"Point.scaled(by: int32): int32\""
    val offered = json.as_str().contains(expected)
    assert_eq(offered, true, "an extension is called like a method, so it is offered like one")
}

@test
fun hovering_an_extension_call_shows_its_signature(): void {
    val crate = extension_crate()
    val json = render_hover_json("main.kf", after_the_dot() + 1, &crate)
    val shown = json.as_str().contains("\"signature\":\"Point.scaled(by: int32): int32\"")
    assert_eq(shown, true, "the signature as written")
}

fun trait_receiver_source(): str {
    return """import alloc.list.List

pub struct Point {
    pub val x: int32
}

pub fun Iterable<Point>.total(scale: int32): int32 {
    return scale
}

pub fun probe(ps: &List<Point>): int32 {
    return total(ps, 2)
}
"""
}

fun trait_receiver_crate(): TypedCrate {
    val root = scratch_path("kf_query_trait_receiver")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    val manifest = "[project]\nname = \"query_trait_receiver\"\nkind = \"lib\"\n"
    write_file(scratch_path("kf_query_trait_receiver/kf.toml"), manifest)
    write_file(scratch_path("kf_query_trait_receiver/src/main.kf"), trait_receiver_source())
    return typed_crate_for(scratch_path("kf_query_trait_receiver/src/main.kf"))
}

@test
fun a_trait_receiver_is_listed_as_the_trait(): void {
    val json = render_symbols_json("main.kf", &trait_receiver_crate().module)
    val listed = json.as_str().contains("\"name\":\"Iterable<Point>.total\"")
    assert_eq(listed, true, "not the parameter the trait became")
}

@test
fun an_extension_called_as_a_function_counts_its_receiver(): void {
    val crate = trait_receiver_crate()
    val offset = trait_receiver_source().index_of("ps, 2)")!! as uint32 + 4
    val json = render_signature_json("main.kf", offset, &crate)
    val labelled = json.as_str().contains("\"label\":\"total(self: &Iterable<Point>, scale: int32): int32\"")
    assert_eq(labelled, true, "the receiver is the first argument")
    assert_eq(json.as_str().contains("\"active_parameter\":1"), true, "the cursor is on `scale`")
}

fun front_declared_source(): str {
    return """pub trait Loud {
    fun volume(): int32
}

pub struct Horn {
    pub val x: int32
}

impl Loud for Horn {
    fun volume(): int32 { return 9 }
}

pub fun <T: Loud> T.level(): int32 {
    return self.volume()
}

pub fun probe(): int32 {
    val h = Horn { x: 1 }
    return h.level()
}
"""
}

fun front_declared_crate(): TypedCrate {
    val root = scratch_path("kf_query_front_declared")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    val manifest = "[project]\nname = \"query_front_declared\"\nkind = \"lib\"\n"
    write_file(scratch_path("kf_query_front_declared/kf.toml"), manifest)
    write_file(scratch_path("kf_query_front_declared/src/main.kf"), front_declared_source())
    return typed_crate_for(scratch_path("kf_query_front_declared/src/main.kf"))
}

@test
fun a_receiver_declared_before_the_receiver_still_applies_to_every_type(): void {
    val crate = front_declared_crate()
    val offset = front_declared_source().index_of("h.level()")!! as uint32 + 2
    val json = render_completion_json("main.kf", offset, &crate)
    val offered = json.as_str().contains("\"label\":\"level\",\"kind\":\"method\"")
    assert_eq(offered, true, "a parameter declared in front is still a parameter receiver")
}
