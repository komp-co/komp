// A dependency-free fixture crate, so no stdlib is staged.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq

import std.fs.scratch_path
import kf_driver.editor.render_signature_json

fun signature_fixture_path(): str {
    return scratch_path("kf_query_sig/src/main.kf")
}

/// ```
/// fun add(a: int32, b: int32): int32 {
///     return a + b
/// }
///
/// fun run(): int32 {
///     return add(1, 2)
/// }
/// ```
/// The call sits at 87; its first argument at 91, its second at 94.
fun prepare_signature_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_sig")} && mkdir -p ${scratch_path("kf_query_sig/src")}") }
    write_file(scratch_path("kf_query_sig/kf.toml"), "[project]\nname = \"query_sig\"\nkind = \"lib\"\n")
    var src = """fun add(a: int32, b: int32): int32 {
    return a + b
}

fun run(): int32 {
    return add(1, 2)
}
"""
    write_file(signature_fixture_path(), src.as_str())
}

fun signature_at(offset: uint32): String {
    prepare_signature_fixture()
    val crate = typed_crate_for(signature_fixture_path())
    return render_signature_json("main.kf", offset, &crate)
}

@test
fun signature_help_names_the_parameters(): void {
    val json = signature_at(91)
    assert_eq(json.as_str().contains("\"label\":\"add(a: int32, b: int32): int32\""), true, "the label carries names, not just types")
}

@test
fun signature_help_lists_each_parameter_on_its_own(): void {
    val json = signature_at(91)
    assert_eq(json.as_str().contains("\"parameters\":[{\"label\":\"a: int32\"},{\"label\":\"b: int32\"}]"), true, "a client can highlight one parameter")
}

@test
fun signature_help_starts_at_the_first_parameter(): void {
    val json = signature_at(91)
    assert_eq(json.as_str().contains("\"active_parameter\":0"), true, "the cursor before any comma is in the first argument")
}

@test
fun signature_help_advances_past_a_comma(): void {
    val json = signature_at(94)
    assert_eq(json.as_str().contains("\"active_parameter\":1"), true, "the cursor after the comma is in the second argument")
}

@test
fun signature_help_is_silent_outside_a_call(): void {
    val json = signature_at(2)
    assert_eq(json.as_str().contains("\"label\":null"), true, "the `fun` keyword is not inside a call")
}

