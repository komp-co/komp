// Two files, so the answer reaches past the asked one.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_references_json


fun references_fixture_path(): str {
    return scratch_path("kf_query_refs/src/lib.kf")
}

/// ```
/// // lib.kf
/// fun helper(n: int32): int32 {
///     return n + 1
/// }
///
/// fun uses_it_twice(): int32 {
///     return helper(1) + helper(2)   // calls at 90 and 102
/// }
///
/// // other.kf
/// fun elsewhere(): int32 {
///     return helper(9)               // call at 36
/// }
/// ```
fun prepare_references_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_refs")} && mkdir -p ${scratch_path("kf_query_refs/src")}") }
    write_file(scratch_path("kf_query_refs/kf.toml"), "[project]\nname = \"query_refs\"\nkind = \"lib\"\n")
    var lib = """fun helper(n: int32): int32 {
    return n + 1
}

fun uses_it_twice(): int32 {
    return helper(1) + helper(2)
}
"""
    write_file(references_fixture_path(), lib.as_str())
    val other = "fun elsewhere(): int32 {\n    return helper(9)\n}\n"
    write_file(scratch_path("kf_query_refs/src/other.kf"), other.as_str())
}

fun references_at(offset: uint32): String {
    prepare_references_fixture()
    val crate = typed_crate_for(references_fixture_path())
    return render_references_json("lib.kf", offset, &crate)
}

@test
fun references_find_the_other_use_in_the_same_file(): void {
    val json = references_at(90)
    assert_eq(json.as_str().contains("\"byte_start\":102"), true, "the second call is a reference to the same function")
}

@test
fun references_reach_into_another_file_of_the_crate(): void {
    val json = references_at(90)
    assert_eq(json.as_str().contains("other.kf\",\"byte_start\":36"), true, "a use in a sibling file counts")
}

@test
fun references_name_the_declaration(): void {
    val json = references_at(90)
    // `helper` spans 4..10, not the `fun` before it.
    assert_eq(json.as_str().contains("\"declaration\":{\"file\":\"${scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":4,\"byte_end\":10"), true, "the declaration is its name, not its keyword")
}

@test
fun references_answer_from_the_declaration_name(): void {
    val json = references_at(6)
    assert_eq(json.as_str().contains("\"declaration\":{\"file\":\"${scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":4,\"byte_end\":10"), true, "the cursor on `helper` finds `helper`")
    assert_eq(json.as_str().contains("\"byte_start\":90"), true, "and every call site")
    assert_eq(json.as_str().contains("other.kf\",\"byte_start\":36"), true, "including one in a sibling file")
}

// The declaration is reported once, not in the list of uses.
@test
fun the_declaration_is_not_one_of_its_own_references(): void {
    val json = references_at(6)
    assert_eq(json.as_str().contains("\"references\":[{\"file\":\"${scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":90"), true, "the first reference is the first call, not the declaration")
}

@test
fun references_are_silent_on_a_local(): void {
    // Offset 41 is the parameter `n`, which Resolve leaves poisoned.
    val json = references_at(41)
    assert_eq(json.as_str().contains("\"references\":[]"), true, "a parameter reports nothing rather than guessing by spelling")
}

@test
fun references_are_silent_off_any_name(): void {
    val json = references_at(3)
    assert_eq(json.as_str().contains("\"declaration\":null"), true, "the space after `fun` names nothing")
}
