import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq

import std.fs.scratch_path
import kf_driver.editor.render_hover_json

extern "C" fun system(cmd: str): int32

fun hover_decl_fixture_path(): str {
    return scratch_path("kf_query_hover_decl/src/main.kf")
}

fun hover_decl_fixture_source(): String {
    return String.from("""/// A point in the plane.
pub struct Point {
    pub val x: int32
}

impl Point {
    /// Makes the origin.
    pub static fun origin(): Point {
        return Point { x: 0 }
    }
}

pub fun probe(): int32 {
    val p = Point.origin()
    return p.x
}
""")
}

fun prepare_hover_decl_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_hover_decl")} && mkdir -p ${scratch_path("kf_query_hover_decl/src")}") }
    write_file(scratch_path("kf_query_hover_decl/kf.toml"), "[project]\nname = \"query_hover_decl\"\nkind = \"lib\"\n")
    write_file(hover_decl_fixture_path(), hover_decl_fixture_source().as_str())
}

/// Byte offset of the first occurrence of `needle`, plus `into`.
fun at(needle: str, into: uint32): uint32 {
    val hay = hover_decl_fixture_source()
    val hn = hay.as_str().byte_len()
    val nn = needle.byte_len()
    var i: uint64 = 0
    while i + nn <= hn {
        var ok = true
        var j: uint64 = 0
        while j < nn {
            if hay.as_str().byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { return (i as uint32) + into }
        i = i + 1
    }
    return 0
}

fun hover_json_at(offset: uint32): String {
    prepare_hover_decl_fixture()
    val crate = typed_crate_for(hover_decl_fixture_path())
    return render_hover_json("main.kf", offset, &crate)
}

@test
fun hover_on_a_static_method_carries_its_signature(): void {
    // Inside `origin` of `Point.origin()`, a member with no DeclId.
    val json = hover_json_at(at("Point.origin()", 8))
    assert_eq(json.as_str().contains("\"signature\":\"origin(): Point\""), true, "a method is reached through its receiver, not the declaration index")
}

@test
fun hover_on_a_static_method_carries_its_doc(): void {
    val json = hover_json_at(at("Point.origin()", 8))
    assert_eq(json.as_str().contains("\"documentation\":\"Makes the origin.\""), true, "the run above the method, not above the impl")
}

@test
fun hover_on_a_static_receiver_names_the_type(): void {
    // `Point` in `Point.origin()` is a type name and types as poison.
    val json = hover_json_at(at("Point.origin()", 2))
    assert_eq(json.as_str().contains("\"signature\":\"struct Point\""), true, "the keyword tells a reader what kind of type it is")
}

@test
fun a_poison_type_is_not_reported_as_a_type(): void {
    val json = hover_json_at(at("Point.origin()", 2))
    assert_eq(json.as_str().contains("\"type\":null"), true, "`<error>` reads as a broken file, not as `this is not a value`")
}

@test
fun hover_on_a_type_declaration_carries_its_doc(): void {
    val json = hover_json_at(at("pub struct Point", 12))
    assert_eq(json.as_str().contains("\"documentation\":\"A point in the plane.\""), true, "a struct is documented like anything else")
}

@test
fun hover_on_an_instance_method_still_resolves(): void {
    // `p.x`: the text before the dot is a local, not a type.
    val json = hover_json_at(at("return p.x", 9))
    assert_eq(json.as_str().contains("\"type\":\"int32\""), true, "a field read is still an expression with a type")
}
