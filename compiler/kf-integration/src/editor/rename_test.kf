// Two files, so the edits reach past the asked one. Most tests are refusals.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_rename_json

extern "C" fun system(cmd: str): int32

fun rename_fixture_path(): str {
    return scratch_path("kf_query_rename/src/lib.kf")
}

/// ```
/// // lib.kf
/// pub fun helper(n: int32): int32 {   // the name at 8
///     return n + 1
/// }
///
/// pub fun taken(): int32 {            // the name at 62
///     return 0
/// }
///
/// pub fun uses_it(): int32 {
///     return helper(1) + helper(2)    // uses at 133 and 145
/// }
///
/// // other.kf
/// pub fun elsewhere(): int32 {
///     return helper(9)                // use at 40
/// }
/// ```
fun prepare_rename_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_rename")} && mkdir -p ${scratch_path("kf_query_rename/src")}") }
    write_file(scratch_path("kf_query_rename/kf.toml"), "[project]\nname = \"query_rename\"\nkind = \"lib\"\n")
    var lib = String.from("pub fun helper(n: int32): int32 {\n")
    lib.append("    return n + 1\n")
    lib.append("}\n")
    lib.append("\n")
    lib.append("pub fun taken(): int32 {\n")
    lib.append("    return 0\n")
    lib.append("}\n")
    lib.append("\n")
    lib.append("pub fun uses_it(): int32 {\n")
    lib.append("    return helper(1) + helper(2)\n")
    lib.append("}\n")
    write_file(rename_fixture_path(), lib.as_str())
    val other = "pub fun elsewhere(): int32 {\n    return helper(9)\n}\n"
    write_file(scratch_path("kf_query_rename/src/other.kf"), other.as_str())
}

fun rename_at(offset: uint32, new_name: str): String {
    prepare_rename_fixture()
    val crate = typed_crate_for(rename_fixture_path())
    return render_rename_json("lib.kf", offset, new_name, &crate)
}

@test
fun rename_edits_the_declaration_and_every_use(): void {
    val json = rename_at(8, "scaled")
    assert_eq(json.as_str().contains("\"ok\":true"), true, "a free rename is allowed")
    assert_eq(json.as_str().contains("\"byte_start\":8,\"byte_end\":14"), true, "the declaration's own name is edited")
    assert_eq(json.as_str().contains("\"byte_start\":133,\"byte_end\":139"), true, "and the first use")
    assert_eq(json.as_str().contains("\"byte_start\":145,\"byte_end\":151"), true, "and the second")
}

@test
fun rename_reaches_into_a_sibling_file(): void {
    val json = rename_at(8, "scaled")
    assert_eq(json.as_str().contains("other.kf\",\"byte_start\":40,\"byte_end\":46"), true, "a use in another file is an edit too")
}

@test
fun rename_answers_the_same_from_a_use_as_from_the_declaration(): void {
    val from_use = rename_at(133, "scaled")
    assert_eq(from_use.as_str().contains("\"byte_start\":8,\"byte_end\":14"), true, "asking at a call still edits the declaration")
    assert_eq(from_use.as_str().contains("other.kf\",\"byte_start\":40"), true, "and every other use")
}

@test
fun rename_refuses_a_name_already_declared(): void {
    val json = rename_at(8, "taken")
    assert_eq(json.as_str().contains("\"ok\":false"), true, "a collision is refused")
    assert_eq(json.as_str().contains("already declared in this crate (a function)"), true, "and says what it would collide with")
    assert_eq(json.as_str().contains("\"edits\":[]"), true, "with no edits to apply by accident")
}

@test
fun rename_refuses_a_new_name_that_is_not_a_name(): void {
    assert_eq(rename_at(8, "1foo").as_str().contains("is not a name"), true, "a leading digit is not an identifier")
    assert_eq(rename_at(8, "return").as_str().contains("is not a name"), true, "a keyword is not an identifier")
    assert_eq(rename_at(8, "foo bar").as_str().contains("is not a name"), true, "two words are not one identifier")
    assert_eq(rename_at(8, "foo+").as_str().contains("is not a name"), true, "trailing punctuation is not part of a name")
}

@test
fun rename_refuses_the_name_it_already_has(): void {
    assert_eq(rename_at(8, "helper").as_str().contains("the new name is the old name"), true, "renaming to itself is not a rename")
}

@test
fun rename_refuses_where_there_is_no_name(): void {
    val json = rename_at(1, "anything")
    assert_eq(json.as_str().contains("\"ok\":false"), true, "the `pub` keyword names no declaration")
    assert_eq(json.as_str().contains("nothing to rename here"), true, "and says so")
}

// Validate-only: no new name yet.
@test
fun an_empty_new_name_validates_without_editing(): void {
    val json = rename_at(133, "")
    assert_eq(json.as_str().contains("\"ok\":true"), true, "the target is renameable")
    assert_eq(json.as_str().contains("\"byte_start\":133,\"byte_end\":139"), true, "and the name to highlight is reported")
    assert_eq(json.as_str().contains("\"edits\":[]"), true, "without doing the work")
}

@test
fun an_empty_new_name_still_refuses_an_impossible_target(): void {
    val json = rename_at(1, "")
    assert_eq(json.as_str().contains("\"ok\":false"), true, "validating a non-name still refuses")
}

