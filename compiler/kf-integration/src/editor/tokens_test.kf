import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_tokens_json


fun tokens_fixture_path(): str {
    return scratch_path("kf_query_tokens/src/lib.kf")
}

/// ```
/// fun helper(n: int32): int32 {
///     return n + 1              // `n` at 41
/// }
///
/// fun uses_it(): int32 {
///     return helper(1)          // the call at 84
/// }
/// ```
fun prepare_tokens_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_tokens")} && mkdir -p ${scratch_path("kf_query_tokens/src")}") }
    write_file(scratch_path("kf_query_tokens/kf.toml"), "[project]\nname = \"query_tokens\"\nkind = \"lib\"\n")
    val lib = "fun helper(n: int32): int32 {\n    return n + 1\n}\n\nfun uses_it(): int32 {\n    return helper(1)\n}\n"
    write_file(tokens_fixture_path(), lib.as_str())
}

fun tokens_json(): String {
    prepare_tokens_fixture()
    val crate = typed_crate_for(tokens_fixture_path())
    return render_tokens_json("lib.kf", &crate)
}

@test
fun tokens_call_a_call_a_function(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_start\":84,\"byte_end\":90,\"type\":\"function\""), true, "a call is a function, whatever it is spelled like")
}

// The token is the callee's name, not the call's span over its arguments.
@test
fun a_call_token_stops_at_the_callee_name(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_end\":93"), false, "the argument list is not part of the name")
}

@test
fun a_declaration_name_is_a_token(): void {
    val json = tokens_json()
    assert_eq(json.as_str().contains("\"byte_start\":4,\"byte_end\":10,\"type\":\"function\""), true, "`helper` in `fun helper(...)` is a function")
    assert_eq(json.as_str().contains("\"byte_start\":54,\"byte_end\":61,\"type\":\"function\""), true, "so is `uses_it`")
}

@test
fun tokens_call_a_bare_name_a_variable(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_start\":41,\"byte_end\":42,\"type\":\"variable\""), true, "a name that is not a call reads as a variable")
}

@test
fun tokens_come_in_source_order(): void {
    // Declarations at 4 and 54, the parameter use at 41, the call at 84: the
    // walk visits a body before the next declaration.
    val json = tokens_json()
    assert_eq(json.as_str().contains("\"byte_start\":4,\"byte_end\":10,\"type\":\"function\"},{\"byte_start\":41"), true, "the declaration precedes its body")
    assert_eq(json.as_str().contains("\"byte_start\":41,\"byte_end\":42,\"type\":\"variable\"},{\"byte_start\":54"), true, "the body precedes the next declaration")
    assert_eq(json.as_str().contains("\"byte_start\":54,\"byte_end\":61,\"type\":\"function\"},{\"byte_start\":84"), true, "and that declaration precedes its own body")
}

@test
fun tokens_are_scoped_to_the_one_file(): void {
    prepare_tokens_fixture()
    write_file(scratch_path("kf_query_tokens/src/other.kf"), "fun far_away(): int32 {\n    return helper(2)\n}\n")
    val crate = typed_crate_for(tokens_fixture_path())
    val json = render_tokens_json("lib.kf", &crate)
    assert_eq(json.as_str().contains("\"byte_start\":35,"), false, "a sibling file's names are not this file's tokens")
}
