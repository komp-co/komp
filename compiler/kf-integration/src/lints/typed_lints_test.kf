// The lints that read types, over a small program type-checked as a
// project is: what each reports, and what it leaves alone.

import core.assert.assert_eq
import alloc.list.*
import alloc.path.Path

import kf_core.diagnostic.*
import kf_driver.*
import kf_driver.build.fresh_diag_list
import kf_lint.lint_typed_module
import std.fs.create_dir_all
import std.fs.remove_dir_all
import std.fs.scratch_path
import std.fs.write_text

/// The codes the typed lints report over a bin project whose main.kf is
/// `src`, space-separated; "errors" when it does not type-check.
fun typed_codes(name: str, src: str): String {
    val dir = scratch_path(name)
    val _cleared = remove_dir_all(dir)
    val _made = create_dir_all(Path.new("${dir}/src".as_str()))
    val manifest = "[project]\nname = \"typed\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    val _manifest = write_text("${dir}/kf.toml".as_str(), manifest)
    val _source = write_text("${dir}/src/main.kf".as_str(), src)
    val smap = fresh_source_map()
    val pdiags = fresh_diag_list()
    var merged = assemble_project(dir, smap, pdiags)
    val checked = merged.checked_diagnostics(smap, &new_lint_config())
    if count_errors(&checked) > 0 { return String.from("errors") }
    val found = lint_typed_module(&merged)
    var codes = String.from("")
    while d in &found {
        if !codes.is_empty() { codes.append(" ") }
        codes.append(d.code.as_str())
    }
    return codes
}

@test
fun a_dropped_result_is_reported(): void {
    val parse = "fun parse(): Result<int32, int32> {\n    return Result.Ok(1)\n}\n\n"
    val src = "${parse}fun main(): int32 {\n    parse()\n    return 0\n}\n"
    assert_eq(typed_codes("typed_result", src.as_str()).as_str(), "unused_result", "the error goes nowhere")
}

@test
fun a_result_bound_to_a_name_is_not_dropped(): void {
    val parse = "fun parse(): Result<int32, int32> {\n    return Result.Ok(1)\n}\n\n"
    val src = "${parse}fun main(): int32 {\n    val _parsed = parse()\n    return 0\n}\n"
    assert_eq(typed_codes("typed_result_bound", src.as_str()).as_str(), "", "bound, so seen")
}

@test
fun a_dropped_option_is_reported(): void {
    val src = "fun first(): int32? {\n    return null\n}\n\nfun main(): int32 {\n    first()\n    return 0\n}\n"
    assert_eq(typed_codes("typed_option", src).as_str(), "unused_option", "the value goes nowhere")
}

@test
fun cloning_a_copy_type_is_reported(): void {
    val point = "@derive(Copy, Clone)\nstruct P {\n    val x: int32\n}\n\n"
    val src = "${point}fun main(): int32 {\n    val p = P { x: 1 }\n    val q = p.clone()\n    return q.x\n}\n"
    assert_eq(typed_codes("typed_clone", src.as_str()).as_str(), "clone_on_copy", "P copies anyway")
}

@test
fun cloning_a_type_without_copy_is_not(): void {
    val point = "@derive(Clone)\nstruct P {\n    val x: int32\n}\n\n"
    val src = "${point}fun main(): int32 {\n    val p = P { x: 1 }\n    val q = p.clone()\n    return q.x\n}\n"
    assert_eq(typed_codes("typed_clone_deep", src.as_str()).as_str(), "", "a clone is how to copy it")
}

@test
fun casting_to_the_same_type_is_reported(): void {
    val src = "fun main(): int32 {\n    val a: int32 = 1\n    return a as int32\n}\n"
    assert_eq(typed_codes("typed_cast", src).as_str(), "redundant_cast", "already an int32")
}

@test
fun casting_to_another_type_is_not(): void {
    val src = "fun main(): int32 {\n    val a: int64 = 1\n    return a as int32\n}\n"
    assert_eq(typed_codes("typed_cast_other", src).as_str(), "", "int64 to int32 is a real cast")
}

@test
fun comparing_floats_for_equality_is_reported(): void {
    val src = "fun main(): int32 {\n    val a: float64 = 0.5\n    return if a == 0.5 { 1 } else { 0 }\n}\n"
    assert_eq(typed_codes("typed_float", src).as_str(), "float_equality", "rounding makes it unreliable")
}

@test
fun comparing_a_float_with_zero_is_not(): void {
    val src = "fun main(): int32 {\n    val a: float64 = 0.5\n    return if a == 0.0 { 1 } else { 0 }\n}\n"
    assert_eq(typed_codes("typed_float_zero", src).as_str(), "", "zero is exact")
}
