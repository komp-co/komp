// `when` over an enum with a Box payload: the enum's drop glue frees the
// active variant's box once, dropping the pointee first. The tree is built by
// constructor functions and consumed by `return t.verdict(&g)`, whose
// borrows do not escape.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun prepare_box_when_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_mm3_boxwhen")} && mkdir -p ${scratch_path("kf_mm3_boxwhen/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_mm3_boxwhen/kf.toml"), "[project]\nname = \"boxwhen\"\nkind = \"bin\"\n")
    write_file(scratch_path("kf_mm3_boxwhen/src/main.kf"), """enum Tree {
    Leaf(int32),
    Node(Box<Tree>, int32),
    Tag(Box<String>)
}

fun node(child: Tree, v: int32): Tree {
    return Tree.Node(Box.new(child), v)
}

fun tag(s: str): Tree {
    return Tree.Tag(Box.new(String.from(s)))
}

fun total(t: &Tree): int32 {
    when (*t) {
        Leaf(v) => return v
        Node(child, v) => return total(&*child) + v
        Tag(s) => {
            if (*s).equals("tag") { return 5 }
            return 0
        }
    }
    return 0
}

fun verdict(t: &Tree, g: &Tree): int32 {
    if total(t) + total(g) == 41 { return 0 }
    return 1
}

fun main(): int32 {
    val t = node(node(Tree.Leaf(30), 4), 2)
    val g = tag("tag")
    var acc: int32 = 0
    when (node(Tree.Leaf(9), 1)) {
        Leaf(v) => { acc = v }
        Node(child, v) => { acc = total(&*child) + v }
        Tag(s) => { acc = 0 }
    }
    if acc != 10 { return 2 }
    return verdict(&t, &g)
}
""")
    return 0
}

fun box_glue_contains(source: str, needle: str): bool {
    val source_len = source.byte_len()
    val needle_len = needle.byte_len()
    if needle_len == 0 || source_len < needle_len { return false }
    var i: uint64 = 0
    while i + needle_len <= source_len {
        var matches = true
        var j: uint64 = 0
        while j < needle_len {
            if source.byte_at(i + j) != needle.byte_at(j) {
                matches = false
            }
            j = j + 1
        }
        if matches { return true }
        i = i + 1
    }
    return false
}

@test
fun box_payload_enum_when_is_asan_leak_clean(): void {
    assert_eq(prepare_box_when_fixture(), 0, "fixture prepared")
    val built = build_project_separate(scratch_path("kf_mm3_boxwhen"), "-fsanitize=address")
    assert_eq(built, 0, "box-payload enum project builds")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_mm3_boxwhen/target/kflat/boxwhen")}") }
    assert_eq(ran, 0, "when over a Box-payload enum drops each box exactly once")
}

// A List enum payload or struct field drops through the aggregate's glue,
// found structurally by the instantiation's `impl Drop`.
fun prepare_list_glue_fixture(): int32 {
    // Explicit core/alloc deps on a copied libs tree: the test binary's
    // sysroot cannot resolve the implicit-dep path. Runs from the repo root.
    val prep = unsafe { system("rm -rf ${scratch_path("kf_mm3_listglue")} ${scratch_path("kf_mm3_listglue_libs")} && mkdir -p ${scratch_path("kf_mm3_listglue/src")} && cp -r libs ${scratch_path("kf_mm3_listglue_libs")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_mm3_listglue/kf.toml"), """[project]
name = "listglue"
kind = "bin"

[dependencies]
core = { path = "../kf_mm3_listglue_libs/core" }
alloc = { path = "../kf_mm3_listglue_libs/alloc" }
""")
    write_file(scratch_path("kf_mm3_listglue/src/main.kf"), """enum W {
    Leaf(int32),
    Named(String),
    Group(List<W>)
}

struct Panel {
    val kids: List<String>
}

fun leaf(v: int32): W {
    return W.Leaf(v)
}

fun named(s: str): W {
    return W.Named(String.from(s))
}

fun mklabel(s: str): String {
    return String.from(s)
}

fun total(w: &W): int32 {
    when (*w) {
        Leaf(v) => return v
        Named(s) => { if s.equals("x") { return 2 }
            return 0 }
        Group(kids) => {
            var acc: int32 = 0
            var i: uint64 = 0
            while i < kids.size() {
                acc = acc + total(kids.at(i))
                i = i + 1
            }
            return acc
        }
    }
    return 0
}

fun mk_panel(): Panel {
    var kids = List.new<String>()
    kids.push(String.from("hello"))
    return Panel { kids: kids }
}

fun main(): int32 {
    var kids = List.new<W>()
    kids.push(leaf(30))
    kids.push(named("x"))
    kids.push(leaf(10))
    val ui = W.Group(kids)
    val p = mk_panel()
    if p.kids.size() != 1 { return 3 }
    val ok = mklabel("xy").equals("xy")
    if !ok { return 4 }
    if total(&ui) == 42 { return 0 }
    return 1
}
""")
    return 0
}

@test
fun list_members_in_aggregates_are_asan_leak_clean(): void {
    assert_eq(prepare_list_glue_fixture(), 0, "fixture prepared")
    val built = build_project_separate(scratch_path("kf_mm3_listglue"), "-fsanitize=address")
    assert_eq(built, 0, "List-member project builds")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_mm3_listglue/target/kflat/listglue")}") }
    assert_eq(ran, 0, "aggregate drops free List payloads and fields exactly once")
}

@test
fun aggregate_glue_drops_list_members(): void {
    val _p = prepare_list_glue_fixture()
    val _b = build_project_separate(scratch_path("kf_mm3_listglue"), "")
    val source = read_file(scratch_path("kf_mm3_listglue/target/kflat/listglue.c"))
    assert_eq(box_glue_contains(source.as_str(), "List__listglue__W__glue_drop(v.u.V_Group._0);"), true, "enum drop glue drops the List payload")
    assert_eq(box_glue_contains(source.as_str(), "List__String__glue_drop(v.kids);"), true, "struct drop glue drops the List field")
}

// A lib crate's `pub enum` with a `List<T>` payload: public glue must see the
// materialized `List__T` instance impl, or the consumer leaks the container.
fun prepare_pub_list_enum_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_mm3_publist")} ${scratch_path("kf_mm3_publist_app")} ${scratch_path("kf_mm3_publist_libs")} && mkdir -p ${scratch_path("kf_mm3_publist/src")} ${scratch_path("kf_mm3_publist_app/src")} && cp -r libs ${scratch_path("kf_mm3_publist_libs")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_mm3_publist/kf.toml"), """[project]
name = "tree"
kind = "lib"

[dependencies]
core = { path = "../kf_mm3_publist_libs/core" }
alloc = { path = "../kf_mm3_publist_libs/alloc" }
""")
    write_file(scratch_path("kf_mm3_publist/src/lib.kf"), """pub enum Node {
    Item(String),
    Group(List<Node>)
}

pub fun item(s: str): Node {
    return Node.Item(String.from(s))
}

pub fun group(kids: List<Node>): Node {
    return Node.Group(kids)
}

pub fun weight(n: &Node): int32 {
    when (*n) {
        Item(s) => { if s.equals("x") { return 1 }
            return 0 }
        Group(kids) => {
            var acc: int32 = 0
            var i: uint64 = 0
            while i < kids.size() {
                acc = acc + weight(kids.at(i))
                i = i + 1
            }
            return acc
        }
    }
    return 0
}
""")
    write_file(scratch_path("kf_mm3_publist_app/kf.toml"), """[project]
name = "publist_app"
kind = "bin"

[dependencies]
core = { path = "../kf_mm3_publist_libs/core" }
alloc = { path = "../kf_mm3_publist_libs/alloc" }
tree = { path = "../kf_mm3_publist" }
""")
    write_file(scratch_path("kf_mm3_publist_app/src/main.kf"), """import tree.*

fun main(): int32 {
    var kids = List.new<Node>()
    kids.push(item("x"))
    kids.push(item("y"))
    kids.push(item("x"))
    val g = group(kids)
    if weight(&g) == 2 { return 0 }
    return 1
}
""")
    return 0
}

@test
fun pub_lib_enum_with_list_payload_is_asan_leak_clean(): void {
    assert_eq(prepare_pub_list_enum_fixture(), 0, "fixture prepared")
    val built = build_project_separate(scratch_path("kf_mm3_publist_app"), "-fsanitize=address")
    assert_eq(built, 0, "consumer of a pub lib List-payload enum builds")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_mm3_publist_app/target/kflat/publist_app")}") }
    assert_eq(ran, 0, "a pub lib enum's List payload drops across the crate boundary")
}

@test
fun pub_lib_enum_glue_drops_its_list_payload(): void {
    val _p = prepare_pub_list_enum_fixture()
    val _b = build_project_separate(scratch_path("kf_mm3_publist_app"), "")
    val source = read_file(scratch_path("kf_mm3_publist_app/target/kflat/tree.c"))
    assert_eq(box_glue_contains(source.as_str(), "List__tree__Node__glue_drop(v.u.V_Group._0);"), true, "the pub enum's drop glue frees its List payload")
}

@test
fun enum_drop_glue_frees_box_payloads(): void {
    val _p = prepare_box_when_fixture()
    val _b = build_project_separate(scratch_path("kf_mm3_boxwhen"), "")
    val source = read_file(scratch_path("kf_mm3_boxwhen/target/kflat/boxwhen.c"))
    assert_eq(box_glue_contains(source.as_str(), "kf_free(v.u.V_Node._0); }"), true, "enum drop glue frees the recursive Box payload")
    assert_eq(box_glue_contains(source.as_str(), "kf_free(v.u.V_Tag._0); }"), true, "enum drop glue frees the Box<String> payload")
}
