// A consumer instantiates a dependency's exported generic with its own
// struct, compiled against the archive after the dependency's source is gone.
// A private dependency helper exercises the hidden support set.

import core.assert.assert_eq

import kf_codegen.*
import kf_tool.build.build_project_separate
import kf_tool.build.check_project_with_kflatc
import kf_integration.harness.compile_project_separate
import std.fs.scratch_path
import kf_core.diagnostic.new_diagnostics

extern "C" fun system(cmd: str): int32

fun prepare_generic_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc6_gen_dep")} ${scratch_path("kf_sc6_gen_app")} && mkdir -p ${scratch_path("kf_sc6_gen_dep/src")} ${scratch_path("kf_sc6_gen_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_sc6_gen_dep/kf.toml"), "[project]\nname = \"gen_dep\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc6_gen_dep/src/lib.kf"), """pub struct Pair<T> {
    pub val first: T
    pub val second: T
}

pub fun pair_of<T>(a: T, b: T): Pair<T> {
    note_pair()
    return Pair<T> { first: a, second: b }
}

fun note_pair(): void {
}
""")
    write_file(scratch_path("kf_sc6_gen_app/kf.toml"), """[project]
name = "gen_app"
kind = "bin"

[dependencies]
gen_dep = { path = "../kf_sc6_gen_dep" }
""")
    write_file(scratch_path("kf_sc6_gen_app/src/main.kf"), """import gen_dep.*

struct Score {
    val points: int32
}

fun main(): int32 {
    val p = pair_of<Score>(Score { points: 40 }, Score { points: 2 })
    if p.first.points + p.second.points == 42 { return 0 }
    return 1
}
""")
    return 0
}

fun build_generic_fixture(): int32 {
    val prep = prepare_generic_fixture()
    if prep != 0 { return prep }
    return build_project_separate(scratch_path("kf_sc6_gen_app"), "")
}

@test
fun generic_dependency_project_builds(): void {
    assert_eq(build_generic_fixture(), 0, "generic fixture builds separately from source")
}

@test
fun generic_consumer_checks_without_dependency_source(): void {
    val first = build_generic_fixture()
    val hidden = unsafe { system("mv ${scratch_path("kf_sc6_gen_dep/src")} ${scratch_path("kf_sc6_gen_dep/src.hidden")}") }
    val checked = check_project_with_kflatc(scratch_path("kf_sc6_gen_app"), false)
    val restored = unsafe { system("mv ${scratch_path("kf_sc6_gen_dep/src.hidden")} ${scratch_path("kf_sc6_gen_dep/src")}") }
    assert_eq(first == 0 && hidden == 0 && checked == 0 && restored == 0, true, "consumer instantiates a dependency generic from gen_dep.kfi alone")
}

@test
fun generic_consumer_builds_and_runs_without_dependency_source(): void {
    // All under ASan: instrumented artifacts must not be satisfied by plain.
    val prep = prepare_generic_fixture()
    val first = build_project_separate(scratch_path("kf_sc6_gen_app"), "-fsanitize=address")
    val hidden = unsafe { system("mv ${scratch_path("kf_sc6_gen_dep/src")} ${scratch_path("kf_sc6_gen_dep/src.hidden")}") }
    // Recompile the consumer against artifacts alone.
    val _fresh = unsafe { system("rm -f ${scratch_path("kf_sc6_gen_app/target/kflat/gen_app.artifact.toml")}") }
    val rebuilt = build_project_separate(scratch_path("kf_sc6_gen_app"), "-fsanitize=address")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_sc6_gen_app/target/kflat/gen_app")}") }
    val restored = unsafe { system("mv ${scratch_path("kf_sc6_gen_dep/src.hidden")} ${scratch_path("kf_sc6_gen_dep/src")}") }
    assert_eq(prep == 0 && first == 0 && hidden == 0 && rebuilt == 0 && ran == 0 && restored == 0, true, "consumer instantiates a dependency generic on its own type from artifacts alone")
}

@test
fun generic_source_and_interface_consumer_c_are_identical(): void {
    // Against gen_dep.kfi and from dependency source, the consumer's C must
    // be identical.
    val first = build_generic_fixture()
    val interface_c = read_file(scratch_path("kf_sc6_gen_app/target/kflat/gen_app.c"))
    var errors = new_diagnostics()
    val outputs = compile_project_separate(scratch_path("kf_sc6_gen_app"), errors)
    val clean = errors.error_count() == 0
    val source_c = outputs.at(outputs.size() - 1).source
    val setup_ok = first == 0 && clean && outputs.size() > 0
    assert_eq(setup_ok && source_c.as_str() == interface_c.as_str(), true, "source-loaded and interface-loaded materialization emit identical consumer C")
}

fun prepare_diamond_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc6_dia_dep")} ${scratch_path("kf_sc6_dia_left")} ${scratch_path("kf_sc6_dia_right")} ${scratch_path("kf_sc6_dia_app")} && mkdir -p ${scratch_path("kf_sc6_dia_dep/src")} ${scratch_path("kf_sc6_dia_left/src")} ${scratch_path("kf_sc6_dia_right/src")} ${scratch_path("kf_sc6_dia_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_sc6_dia_dep/kf.toml"), "[project]\nname = \"dia_dep\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc6_dia_dep/src/lib.kf"), """pub struct Pair<T> {
    pub val first: T
    pub val second: T
}

pub fun pair_of<T>(a: T, b: T): Pair<T> {
    return Pair<T> { first: a, second: b }
}
""")
    write_file(scratch_path("kf_sc6_dia_left/kf.toml"), """[project]
name = "dia_left"
kind = "lib"

[dependencies]
dia_dep = { path = "../kf_sc6_dia_dep" }
""")
    write_file(scratch_path("kf_sc6_dia_left/src/lib.kf"), """import dia_dep.*

pub fun left_sum(): int32 {
    val p = pair_of<int32>(20, 1)
    return p.first + p.second
}
""")
    write_file(scratch_path("kf_sc6_dia_right/kf.toml"), """[project]
name = "dia_right"
kind = "lib"

[dependencies]
dia_dep = { path = "../kf_sc6_dia_dep" }
""")
    write_file(scratch_path("kf_sc6_dia_right/src/lib.kf"), """import dia_dep.*

pub fun right_sum(): int32 {
    val p = pair_of<int32>(20, 1)
    return p.first + p.second
}
""")
    write_file(scratch_path("kf_sc6_dia_app/kf.toml"), """[project]
name = "dia_app"
kind = "bin"

[dependencies]
dia_left = { path = "../kf_sc6_dia_left" }
dia_right = { path = "../kf_sc6_dia_right" }
""")
    write_file(scratch_path("kf_sc6_dia_app/src/main.kf"), """import dia_left.*
import dia_right.*

fun main(): int32 {
    if left_sum() + right_sum() == 42 { return 0 }
    return 1
}
""")
    return 0
}

@test
fun two_consumers_share_a_logical_instantiation(): void {
    val prep = prepare_diamond_fixture()
    val built = build_project_separate(scratch_path("kf_sc6_dia_app"), "-fsanitize=address")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_sc6_dia_app/target/kflat/dia_app")}") }
    assert_eq(prep == 0 && built == 0 && ran == 0, true, "two consumers each hold a static copy of pair_of<int32> and link cleanly")
}
