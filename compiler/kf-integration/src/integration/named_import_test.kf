// `import a.b.name` admits that one name, not the whole module. Two crates,
// since a same-crate declaration is visible by its own rules.

import core.assert.assert_eq
import kf_integration.harness.check_project
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

/// A dependency crate exporting `alpha` and `beta`, and an app crate whose
/// `main.kf` opens with `import_line` and returns `body`.
fun prepare_named_import_fixture(name: str, import_line: str, body: str): int32 {
    var cmd = "rm -rf ${scratch_root()}/${name}_dep ${scratch_root()}/${name}_app"
    cmd.append(" && mkdir -p ${scratch_root()}/${name}_dep/src ${scratch_root()}/${name}_app/src")
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }

    val dep_toml = "${scratch_root()}/${name}_dep/kf.toml"
    write_file(dep_toml.as_str(), """[project]
name = "ni_dep"
version = "0.1.0"
kind = "lib"
""")

    val dep_src = "${scratch_root()}/${name}_dep/src/lib.kf"
    write_file(dep_src.as_str(), """pub fun alpha(): int32 { return 1 }
pub fun beta(): int32 { return 2 }
""")

    val app_toml = "${scratch_root()}/${name}_app/kf.toml"
    write_file(app_toml.as_str(), """[project]
name = "ni_app"
version = "0.1.0"
kind = "bin"

[dependencies]
ni_dep = { path = "../${name}_dep" }
""".as_str())

    val main_path = "${scratch_root()}/${name}_app/src/main.kf"
    var main_src = String.from(import_line)
    main_src.append("\nfun main(): int32 { return ")
    main_src.append(body)
    main_src.append(" }\n")
    write_file(main_path.as_str(), main_src.as_str())
    return 0
}

fun check_named_fixture(name: str): int32 {
    val dir = "${scratch_root()}/${name}_app"
    return check_project(dir.as_str())
}

@test
fun a_wildcard_admits_every_name(): void {
    assert_eq(prepare_named_import_fixture("kf_ni_glob", "import ni_dep.*", "alpha() + beta() - 3"), 0,
        "fixture prepared")
    assert_eq(check_named_fixture("kf_ni_glob"), 0, "`.*` opens the whole module, as it always did")
}

@test
fun a_named_import_admits_the_name_it_spells(): void {
    assert_eq(prepare_named_import_fixture("kf_ni_named", "import ni_dep.alpha", "alpha() - 1"), 0,
        "fixture prepared")
    assert_eq(check_named_fixture("kf_ni_named"), 0, "the name the import spells resolves")
}

/// `beta` is `pub` in an imported module, and the import names only `alpha`.
@test
fun a_named_import_does_not_admit_the_rest_of_its_module(): void {
    assert_eq(prepare_named_import_fixture("kf_ni_other", "import ni_dep.alpha", "beta() - 2"), 0,
        "fixture prepared")
    assert_eq(check_named_fixture("kf_ni_other") != 0, true, "importing `alpha` does not bring `beta` with it")
}

/// Two named imports from one module: a miss keeps scanning.
@test
fun two_named_imports_of_one_module_both_apply(): void {
    assert_eq(prepare_named_import_fixture("kf_ni_both", """import ni_dep.alpha
import ni_dep.beta""", "alpha() + beta() - 3"), 0, "fixture prepared")
    assert_eq(check_named_fixture("kf_ni_both"), 0, "both names resolve when both are written")
}
