// Assigning to a place (a field, or through a dereference) drops the old
// owned value: aliased into a temp before the store, released after. Under
// ASan, since the leak is one allocation per assignment and invisible to the
// case corpus.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun prepare_place_assign_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_place_assign")} && mkdir -p ${scratch_path("kf_place_assign/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_place_assign/kf.toml"), "[project]\nname = \"placeassign\"\nkind = \"bin\"\n")
    write_file(scratch_path("kf_place_assign/src/main.kf"), """struct Holder { pub var s: String }

fun main(): int32 {
    var h = Holder { s: String.from("alpha") }
    h.s = String.from("beta")
    if !h.s.as_str().equals("beta") { return 1 }

    // Linear, not one-off: the leak was per assignment, so a loop is what
    // made it matter. Each iteration must drop the string it replaces.
    var i: int32 = 0
    while i < 8 {
        h.s = String.from("gamma")
        i = i + 1
    }
    if !h.s.as_str().equals("gamma") { return 2 }
    return 0
}
""")
    return 0
}

@test
fun field_assignment_drops_what_it_overwrites(): void {
    assert_eq(prepare_place_assign_fixture(), 0, "fixture prepared")
    val built = build_project_separate(scratch_path("kf_place_assign"), "-fsanitize=address")
    assert_eq(built, 0, "place-assignment project builds")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1 ${scratch_path("kf_place_assign/target/kflat/placeassign")}") }
    assert_eq(ran, 0, "assigning to a field drops the value it overwrites")
}
