// Crate qualification reaches every part of an assembled callee: a mono
// type-argument suffix, a trait tail's argument, an underscored owner, and a
// primitive receiver. A part left behind is a link failure after a clean
// `check`. Qualification runs only on build_project_separate.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32
extern "C" fun access(path: str, mode: int32): int32

fun prepare_qualification_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_qual_core")} ${scratch_path("kf_qual_alloc")} ${scratch_path("kf_qual_app")} && mkdir -p ${scratch_path("kf_qual_core/src")} ${scratch_path("kf_qual_core/native")} ${scratch_path("kf_qual_alloc/src")} ${scratch_path("kf_qual_app/src")} && cp -R libs/core/src/. ${scratch_path("kf_qual_core/src/")} && cp -R libs/alloc/src/. ${scratch_path("kf_qual_alloc/src/")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_qual_core/kf.toml"), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    val core_native = read_file("libs/core/native/core.c")
    write_file(scratch_path("kf_qual_core/native/core.c"), core_native.as_str())
    val core_hosted = read_file("libs/core/native/core_hosted.c")
    write_file(scratch_path("kf_qual_core/native/core_hosted.c"), core_hosted.as_str())
    write_file(scratch_path("kf_qual_alloc/kf.toml"), """[project]
name = "alloc"
kind = "lib"

[dependencies]
core = { path = "../kf_qual_core" }
""")
    write_file(scratch_path("kf_qual_app/kf.toml"), """[project]
name = "qual_app"
kind = "bin"

[dependencies]
core = { path = "../kf_qual_core" }
alloc = { path = "../kf_qual_alloc" }
""")

    var app = String.from("import core.*\nimport alloc.list.*\n\n")
    app.append("struct Decl { pub val n: int32 }\n\n")
    app.append("enum Color { Red\n             Blue }\n\n")
    app.append("impl Equal for Color {\n")
    app.append("    fun equals(other: &Color): bool {\n")
    app.append("        when (self) {\n")
    app.append("""            Red => { when (other) { Red => return true
                                    Blue => return false } }
""")
    app.append("""            Blue => { when (other) { Red => return false
                                     Blue => return true } }
""")
    app.append("        }\n    }\n}\n\n")
    app.append("struct Dbl { pub val k: int32 }\n\n")
    app.append("struct Holder { pub val n: int32 }\n\n")
    app.append("impl Holder {\n    pub fun with<F>(f: F): int32 { return self.n }\n}\n\n")
    // The `<owner>_<method>` boundary is one `_`, so an underscored owner
    // cannot be split by scanning.
    app.append("struct Step_2 { pub val unused: int32 }\n\n")
    app.append("impl Call1<int32> for Step_2 {\n")
    app.append("    type Out = int32\n")
    app.append("    fun call(a: int32): int32 { return a * 2 }\n")
    app.append("}\n\n")
    // A STATIC call on the same underscored type: `Step_2_from__From__int32`.
    app.append("impl From<int32> for Step_2 {\n")
    app.append("    static fun from(value: int32): Step_2 { return Step_2 { unused: value } }\n")
    app.append("}\n\n")

    // Distinct amounts, so the exit code names the failing group. A stored
    // lambda is rejected, so it is passed straight to a generic wrapper.
    app.append("fun apply1<F: Call1<int32>>(f: F, x: int32): int32 { return f(x) }\n")
    app.append("fun main(): int32 {\n")
    // A trait tail's type argument: `List__Decl_iter__Iterable__Decl`.
    app.append("    var xs = List.new<Decl>()\n")
    app.append("    xs.push(Decl { n: 10 })\n")
    app.append("    var listed: int32 = 0\n")
    app.append("    while d in xs { listed = listed + d.n }\n")
    app.append("    if listed != 10 { return 1 }\n")
    // A mono type-argument suffix: `Holder_with__Dbl`.
    app.append("    val h = Holder { n: 4 }\n")
    app.append("    if h.with<Dbl>(Dbl { k: 2 }) != 4 { return 2 }\n")
    // An underscored owner: `Step_2_call__Call1__int32`.
    app.append("    val s = Step_2 { unused: 0 }\n")
    app.append("    if s.call(7) != 14 { return 3 }\n")
    // A lambda's synthesized struct is named `Lambda_<fn>_<n>` — two more.
    app.append("    if apply1(|x: int32| x + 1, 41) != 42 { return 4 }\n")
    // A primitive receiver owns its methods: `int32_equals`.
    app.append("    if !(5).equals(5) { return 5 }\n")
    // An enum receiver likewise: `Color_equals`.
    app.append("    if !Color.Red.equals(Color.Red) { return 6 }\n")
    app.append("    val made = Step_2.from(3)\n")
    app.append("    if made.unused != 3 { return 7 }\n")
    app.append("    return 0\n}\n")
    write_file(scratch_path("kf_qual_app/src/main.kf"), app.as_str())
    return 0
}

@test
fun every_part_of_an_assembled_callee_is_crate_qualified(): void {
    val prepared = prepare_qualification_fixture()
    val built = build_project_separate(scratch_path("kf_qual_app"), "")
    val binary = unsafe { access(scratch_path("kf_qual_app/target/kflat/qual_app"), 0) }
    val ran = unsafe { system(scratch_path("kf_qual_app/target/kflat/qual_app")) }
    val ok = prepared == 0 && built == 0 && binary == 0 && ran == 0
    assert_eq(ok, true, "a callee assembled from owner, method and tail links and runs")
}
