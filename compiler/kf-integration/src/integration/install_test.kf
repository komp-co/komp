// `komp install` and `komp uninstall`: a program built from a `file://`
// index in scratch space, into an install home of its own.

import core.assert.assert_eq
import kf_tool.install.install_package
import kf_tool.install.installed_packages
import kf_tool.install.uninstall_package
import std.fs.exists

/// An index listing `name` 0.1.0 of `kind`, from a repository of its own;
/// the index's `file://` URL.
fun tool_index(name: str, kind: str): String {
    val repo = dir_of("${name}_repo".as_str())
    sh("rm -rf ${repo} && mkdir -p ${repo}/src".as_str())
    val manifest = "[project]\nname = \"${name}\"\nversion = \"0.1.0\"\nkind = \"${kind}\"\n"
    write_file("${repo}/kf.toml".as_str(), manifest.as_str())
    if kind == "bin" {
        write_file("${repo}/src/main.kf".as_str(), "fun main(): int32 { return 7 }\n")
    } else {
        write_file("${repo}/src/lib.kf".as_str(), "pub fun seven(): int32 { return 7 }\n")
    }
    sh("cd ${repo} && git init -q && git add . && ${git_commit()} -qm one".as_str())
    sh("cd ${repo} && git rev-parse HEAD > ${repo}.head".as_str())
    val rev = read_file("${repo}.head".as_str()).as_str().substring(0, 40)
    val index = dir_of("${name}_index".as_str())
    val file = "${index}/${name.substring(0, 2)}/${name.substring(2, 4)}"
    sh("rm -rf ${index} && mkdir -p ${file}".as_str())
    write_file("${index}/config.toml".as_str(), "schema = 1\n")
    val row = "\n[[version]]\nversion = \"0.1.0\"\nsource = { git = \"file://${repo}\", rev = \"${rev}\" }\n"
    write_file("${file}/${name}.toml".as_str(), "schema = 1\nname = \"${name}\"\n${row}".as_str())
    sh("cd ${index} && git init -q && git add . && ${git_commit()} -qm index".as_str())
    return "file://${index}"
}

fun fresh_home(name: str): String {
    val home = dir_of(name)
    sh("rm -rf ${home}".as_str())
    return home
}

@test
fun an_installed_program_runs_from_the_bin_directory(): void {
    val index = tool_index("komp_seven", "bin")
    val home = fresh_home("kf_install_home_a")
    val _done = install_package("komp_seven", "", index.as_str(), test_cache().as_str(), home.as_str())
    assert_eq(sh("${home}/bin/komp-seven".as_str()) / 256, 7, "komp-seven is the program, built")
}

@test
fun an_install_is_recorded(): void {
    val index = tool_index("komp_eight", "bin")
    val home = fresh_home("kf_install_home_b")
    val _done = install_package("komp_eight", "0.1", index.as_str(), test_cache().as_str(), home.as_str())
    val rows = installed_packages(home.as_str())
    assert_eq(rows.size() == 1 && rows[0].version.as_str() == "0.1.0", true, "komp_eight 0.1.0")
}

@test
fun uninstalling_removes_the_program_and_its_record(): void {
    val index = tool_index("komp_nine", "bin")
    val home = fresh_home("kf_install_home_c")
    val _done = install_package("komp_nine", "", index.as_str(), test_cache().as_str(), home.as_str())
    val error = uninstall_package("komp_nine", home.as_str())
    assert_eq(error.is_empty() && !exists("${home}/bin/komp-nine".as_str()) &&
            installed_packages(home.as_str()).is_empty(), true, "nothing left")
}

@test
fun uninstalling_what_is_not_installed_says_so(): void {
    val home = fresh_home("kf_install_home_d")
    assert_eq(uninstall_package("komp_never", home.as_str()).as_str(), "`komp_never` is not installed", "no row")
}

@test
fun a_library_is_not_installed(): void {
    val index = tool_index("kf_lib_ten", "lib")
    val home = fresh_home("kf_install_home_e")
    val done = install_package("kf_lib_ten", "", index.as_str(), test_cache().as_str(), home.as_str())
    assert_eq(done.error.contains("is a library"), true, "a library goes in [dependencies]")
}
