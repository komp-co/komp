// Emit C from a hand-built AST, compile it against the native tier, run it,
// and check exit code and stdout.
//
// Here rather than in kf-codegen: linking the native tier needs generated
// crate headers (`alloc.c` includes `alloc.h`, which includes `core.h`), and
// producing them takes a frontend. The headers are generated, never written
// by hand, so no second copy of the String layout exists.

import alloc.list.*
import std.fs.*
import std.process.*

import kf_codegen.*
import kf_codegen.runtime.emit_runtime_header
import kf_integration.harness.compile_project_separate
import kf_core.diagnostic.new_diagnostics

/// A directory nothing else writes, so no stray header is resolved.
fun link_dir(): str {
    return scratch_path("kf_codegen_link")
}

/// Creates the directory: `write_file` silently skips a missing one.
pub fun write_scratch(path: str, contents: str): void {
    val _made = create_dir_all(Path.new(link_dir()))
    write_file(path, contents)
}

/// From the ordinary separate build of `libs/core`.
pub fun write_core_header_into(dir: str): bool {
    return write_crate_artifacts_into(dir, "libs/core", "core")
}

/// The header and the object: public glue is exported from the crate's own
/// object, so the header alone leaves `<Type>__glue_drop` undefined.
fun write_crate_artifacts_into(dir: str, project: str, name: str): bool {
    var errors = new_diagnostics()
    val outs = compile_project_separate(project, &var errors)
    while o in &outs {
        if o.crate_name.as_str() == name {
            val _made = create_dir_all(Path.new(dir))
            var header = String.from(dir)
            header.append("/")
            header.append(name)
            header.append(".h")
            write_file(header.as_str(), o.header.as_str())
            var source = String.from(dir)
            source.append("/")
            source.append(name)
            source.append(".c")
            write_file(source.as_str(), o.source.as_str())
            return true
        }
    }
    return false
}

/// Alloc's too, which carries `String` and its glue.
pub fun write_alloc_header_into(dir: str): bool {
    if !write_core_header_into(dir) { return false }
    return write_crate_artifacts_into(dir, "libs/alloc", "alloc")
}

pub fun gcc_link(source: str, binary: str, asan: bool): int32 {
    var runtime_path = String.from(link_dir())
    runtime_path.append("/kf_runtime.h")
    write_scratch(runtime_path.as_str(), emit_runtime_header().as_str())
    if !write_alloc_header_into(link_dir()) { return 1 }
    var include_flag = String.from("-I")
    include_flag.append(link_dir())
    var compiler = Command.new("gcc")
    if asan { compiler.arg("-fsanitize=address") }
    compiler.arg("-D_GNU_SOURCE")
    compiler.arg(include_flag.as_str())
    // A crate naming `String` includes `alloc.h`; these hand-built modules
    // have no dependency list to say so.
    compiler.arg("-include")
    compiler.arg("alloc.h")
    var core_object = String.from(link_dir())
    core_object.append("/core.c")
    var alloc_object = String.from(link_dir())
    alloc_object.append("/alloc.c")
    compiler.arg(source)
    compiler.arg(core_object.as_str())
    compiler.arg(alloc_object.as_str())
    compiler.arg("libs/core/native/core.c")
    compiler.arg("libs/core/native/core_hosted.c")
    compiler.arg("libs/alloc/native/alloc.c")
    compiler.arg("libs/alloc/native/alloc_hosted.c")
    compiler.arg("libs/std/native/fs.c")
    compiler.arg("libs/std/native/process.c")
    compiler.arg("libs/std/native/env.c")
    compiler.arg("compiler/kf-core/native/compiler.c")
    compiler.arg("-o")
    compiler.arg(binary)
    // core.math calls libm.
    compiler.arg("-lm")
    return compiler.status().exit_code()
}

pub fun run_program(binary: str): int32 {
    return Command.new(binary).status().exit_code()
}

pub fun run_program_to_file(binary: str, output: str, disable_leaks: bool): int32 {
    var program = Command.new(binary)
    if disable_leaks { program.env("ASAN_OPTIONS", "detect_leaks=0") }
    program.stdout_to(Path.new(output))
    return program.status().exit_code()
}
