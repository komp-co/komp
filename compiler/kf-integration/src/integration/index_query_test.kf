// `komp search` and `komp info` over a scratch `file://` index listing
// `komp_alpha` (three versions, one yanked), `komp_beta` and `zed`. Listing
// reads only the index, so the sources it names need not exist.

import core.assert.assert_eq
import kf_tool.fetch.index_package
import kf_tool.fetch.search_index

fun catalog_index(name: str): String {
    val index = dir_of(name)
    sh("rm -rf ${index} && mkdir -p ${index}/ko/mp ${index}/3/z".as_str())
    write_file("${index}/config.toml".as_str(), "schema = 1\n")
    val row = "source = { git = \"file:///nowhere\", rev = \"0000000000000000000000000000000000000000\" }\n"
    var alpha = String.from("schema = 1\nname = \"komp_alpha\"\ndescription = \"The first letter\"\n")
    alpha.append("\n[[version]]\nversion = \"0.1.0\"\n${row}\n[[version]]\nversion = \"0.2.0\"\n${row}".as_str())
    alpha.append("\n[[version]]\nversion = \"0.2.1\"\n${row}yanked = true\n".as_str())
    write_file("${index}/ko/mp/komp_alpha.toml".as_str(), alpha.as_str())
    write_file("${index}/ko/mp/komp_beta.toml".as_str(),
        "schema = 1\nname = \"komp_beta\"\n\n[[version]]\nversion = \"1.0.0\"\n${row}".as_str())
    write_file("${index}/3/z/zed.toml".as_str(),
        "schema = 1\nname = \"zed\"\n\n[[version]]\nversion = \"0.0.1\"\n${row}".as_str())
    sh("cd ${index} && git init -q && git add . && ${git_commit()} -qm catalog".as_str())
    return "file://${index}"
}

@test
fun search_lists_every_package_sorted_by_name(): void {
    val found = search_index(catalog_index("kf_catalog_a").as_str(), "", test_cache().as_str())
    var names = ""
    while package in &found.packages { names.append("${package.name} ".as_str()) }
    assert_eq(names.as_str(), "komp_alpha komp_beta zed ", "every package, the index's own files left out")
}

@test
fun search_keeps_the_names_containing_the_query(): void {
    val found = search_index(catalog_index("kf_catalog_b").as_str(), "komp", test_cache().as_str())
    assert_eq(found.packages.size(), 2, "komp_alpha and komp_beta")
}

@test
fun the_newest_version_passes_over_a_yanked_one(): void {
    val found = search_index(catalog_index("kf_catalog_c").as_str(), "alpha", test_cache().as_str())
    assert_eq(found.packages[0].newest().as_str(), "0.2.0", "0.2.1 is yanked")
}

@test
fun info_lists_every_version_yanked_included(): void {
    val found = index_package(catalog_index("kf_catalog_d").as_str(), "komp_alpha", test_cache().as_str())
    assert_eq(found.packages[0].versions.size(), 3, "0.1.0, 0.2.0 and the yanked 0.2.1")
}

@test
fun info_on_a_package_the_index_lacks_says_so(): void {
    val found = index_package(catalog_index("kf_catalog_e").as_str(), "komp_gamma", test_cache().as_str())
    assert_eq(found.error.contains("has no package `komp_gamma`"), true, "names it")
}

@test
fun a_package_carries_its_description(): void {
    val found = search_index(catalog_index("kf_catalog_f").as_str(), "", test_cache().as_str())
    assert_eq("${found.packages[0].description}|${found.packages[1].description}".as_str(), "The first letter|",
        "komp_alpha's, and none for komp_beta")
}
