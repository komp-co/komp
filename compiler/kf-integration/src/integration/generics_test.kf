// User-declared generics through the full pipeline via compile_source,
// compiled by gcc and run.

import alloc.list.*
import core.assert.assert_eq
import std.fs.*
import std.process.*

import kf_integration.harness.compile_source
import kf_tool.build.build_project_separate

fun build_and_run(src: str, exe: str): int32 {
    val c = compile_source(src)
    write_file(scratch_path("komp_gen.c"), c.as_str())
    var gargs = List.new<str>()
    gargs.push(scratch_path("komp_gen.c"))
    gargs.push("-o")
    gargs.push(exe)
    val grc = run("gcc", gargs)
    if grc != 0 {
        return 0 - 1
    }
    val rargs = List.new<str>()
    return run(exe, rargs)
}

// Under ASan with leak detection off: LeakSanitizer cannot run while the test
// runner is traced.
fun build_and_run_leakcheck(src: str, exe: str): int32 {
    val c = compile_source(src)
    write_file(scratch_path("komp_leak.c"), c.as_str())
    var gargs = List.new<str>()
    gargs.push(scratch_path("komp_leak.c"))
    gargs.push("-fsanitize=address")
    gargs.push("-o")
    gargs.push(exe)
    val grc = run("gcc", gargs)
    if grc != 0 {
        return 0 - 1
    }
    var program = Command.new(exe)
    program.env("ASAN_OPTIONS", "detect_leaks=0")
    return program.status().exit_code()
}

// compile_source skips assembly, so core's generics need a real project.
fun build_and_run_with_core(src: str, asan: bool): int32 {
    var remove_args = List.new<str>()
    remove_args.push("-rf")
    remove_args.push(scratch_path("kf_core_generic_app"))
    remove_args.push(scratch_path("kf_core_generic_libs"))
    if run("rm", remove_args) != 0 { return 0 - 1 }
    var mkdir_args = List.new<str>()
    mkdir_args.push("-p")
    mkdir_args.push(scratch_path("kf_core_generic_app/src"))
    mkdir_args.push(scratch_path("kf_core_generic_libs"))
    if run("mkdir", mkdir_args) != 0 { return 0 - 1 }
    var copy_core = List.new<str>()
    copy_core.push("-R")
    copy_core.push("libs/core")
    copy_core.push(scratch_path("kf_core_generic_libs/core"))
    if run("cp", copy_core) != 0 { return 0 - 1 }
    var copy_alloc = List.new<str>()
    copy_alloc.push("-R")
    copy_alloc.push("libs/alloc")
    copy_alloc.push(scratch_path("kf_core_generic_libs/alloc"))
    if run("cp", copy_alloc) != 0 { return 0 - 1 }
    write_file(scratch_path("kf_core_generic_app/kf.toml"), """[project]
name = "core_generic_app"
kind = "bin"

[dependencies]
core = { path = "../kf_core_generic_libs/core" }
alloc = { path = "../kf_core_generic_libs/alloc" }
""")
    write_file(scratch_path("kf_core_generic_app/src/main.kf"), src)
    var flags = ""
    if asan { flags = String.from("-fsanitize=address") }
    val built = build_project_separate(scratch_path("kf_core_generic_app"), flags.as_str())
    if built != 0 { return built }
    var program = Command.new(scratch_path("kf_core_generic_app/target/kflat/core_generic_app"))
    if asan { program.env("ASAN_OPTIONS", "detect_leaks=0") }
    return program.status().exit_code()
}

// Pair<int32,int32> and id<int32>: 40 + 2 = 42.
@test fun integration_generic_pair_and_id(): void {
    val src = """struct Pair<A, B> { pub val a: A  pub val b: B }
fun id<T>(x: T): T { return x }
fun main(): int32 { val p = Pair<int32, int32> { a: 40, b: 2 }
return id<int32>(p.a) + p.b }"""
    val code = build_and_run(src, scratch_path("komp_gen_pair"))
    assert_eq(code == 42, true, "generic Pair + id<int32> → 42")
}

// unwrap<int32> constructs Wrap<T>, so Wrap__int32 is induced.
@test fun integration_generic_transitive(): void {
    val src = """struct Wrap<T> { pub val v: T }
fun unwrap<T: Copy>(x: T): T { val b = Wrap<T> { v: x }
return b.v }
fun main(): int32 { return unwrap<int32>(42) }"""
    val code = build_and_run(src, scratch_path("komp_gen_box"))
    assert_eq(code == 42, true, "unwrap<int32> → Wrap__int32 transitively → 42")
}

// `T.mk(x)` in a generic body dispatches to the concrete `Cel_mk`.
@test fun integration_generic_static_dispatch(): void {
    val src = """struct Cel { pub val v: int32 }
impl Cel { static fun mk(x: int32): Cel { return Cel { v: x } } }
fun build<T>(x: int32): T { return T.mk(x) }
fun main(): int32 { val c = build<Cel>(42)
return c.v }"""
    val code = build_and_run(src, scratch_path("komp_gen_static"))
    assert_eq(code == 42, true, "build<Cel> dispatches T.mk → Cel_mk → 42")
}

// Wrap<int32>.get() dispatches to Wrap__int32_get: 7 + 35 = 42.
@test fun integration_generic_inherent_method(): void {
    val src = """struct Wrap<T> { pub val v: T }
impl Wrap<T: Copy> { pub fun get(): T { return self.v } }
fun main(): int32 { val b = Wrap<int32> { v: 7 }
return b.get() + 35 }"""
    val code = build_and_run(src, scratch_path("komp_gen_method"))
    assert_eq(code == 42, true, "Wrap<int32>.get() dispatches → 42")
}

// Generic enums materialize their layout and constructors.
@test fun integration_generic_enum_constructor_and_match(): void {
    val src = """enum Maybe<T> { Some(T)  None }
fun choose(value: Maybe<int32>): int32 { when (value) { Some(number) => return number  None => return 0 }
return 0 }
fun main(): int32 { return choose(Maybe.Some(42)) }"""
    val code = build_and_run(src, scratch_path("komp_gen_enum"))
    assert_eq(code == 42, true, "generic enum constructor and match → 42")
}

// A method on a generic enum matching its own receiver: `(*self)` carries
// the monomorphized type and the receiver is passed by pointer.
@test fun integration_generic_enum_method_matches_self(): void {
    val src = """enum Maybe<T> { Some(T)  None }
impl Maybe<T> { pub fun is_some(): bool { when (self) { Some(_v) => return true  None => return false }
return false } }
fun main(): int32 { val a: Maybe<int32> = Maybe.Some(7)
if a.is_some() { return 42 }
return 0 }"""
    val code = build_and_run(src, scratch_path("komp_enum_self_match"))
    assert_eq(code == 42, true, "`when (self)` in a generic enum method → 42")
}

// `Res.Err("no")` binds T from the declared return type.
@test fun integration_enum_ctor_binds_from_return_type(): void {
    val src = """enum Res<T, E> { Ok(T)  Err(E) }
fun mk(flag: bool): Res<int32, str> { if flag { return Res.Ok(42) }
return Res.Err("no") }
fun main(): int32 { when (mk(true)) { Ok(v) => return v  Err(_m) => return 1 }
return 0 }"""
    val code = build_and_run(src, scratch_path("komp_enum_expected_ret"))
    assert_eq(code == 42, true, "Err(E) binds T from the declared return type")
}

// Same, through a typed let.
@test fun integration_enum_ctor_binds_from_let_annotation(): void {
    val src = """enum Res<T, E> { Ok(T)  Err(E) }
fun main(): int32 { val r: Res<int32, str> = Res.Err("x")
when (r) { Ok(_v) => return 1  Err(_m) => return 42 }
return 0 }"""
    val code = build_and_run(src, scratch_path("komp_enum_expected_let"))
    assert_eq(code == 42, true, "typed let binds the ctor's type args")
}

// Expectation must reach THROUGH an if-expression into both branches.
@test fun integration_expected_type_reaches_if_branches(): void {
    val src = """enum Res<T, E> { Ok(T)  Err(E) }
fun main(): int32 { val c = true
val r: Res<int32, str> = if c { Res.Ok(42) } else { Res.Err("n") }
when (r) { Ok(v) => return v  Err(_m) => return 1 }
return 0 }"""
    val code = build_and_run(src, scratch_path("komp_enum_expected_if"))
    assert_eq(code == 42, true, "expected type reaches both IfExpr branches")
}

// A user enum owning a String drops its payload once.
@test fun integration_enum_string_payload_drops_clean(): void {
    val src = """enum Holder { Has(String)  Empty }
fun main(): int32 { val h = Holder.Has(String.from("payload"))
when (h) { Has(s) => { if s.byte_len() > 0 { return 0 }
return 1 }  Empty => return 2 }
return 3 }"""
    val code = build_and_run_leakcheck(src, scratch_path("komp_enum_drop_canary"))
    assert_eq(code == 0, true, "enum String payload read via when-binding, ASan-clean")
}

// Point implements Show; p.show() dispatches to Point_show: 9 + 33 = 42.
@test fun integration_trait_concrete_dispatch(): void {
    val src = """struct Point { pub val x: int32 }
trait Show { fun show(): int32 }
impl Show for Point { fun show(): int32 { return self.x } }
fun main(): int32 { val p = Point { x: 9 }
return p.show() + 33 }"""
    val code = build_and_run(src, scratch_path("komp_trait_concrete"))
    assert_eq(code == 42, true, "Point.show() trait dispatch → 42")
}

// A generic function borrowing its type parameter (`app: &A`) binds A
// through the reference and passes the argument by address.
@test fun integration_generic_borrowed_param_explicit_targ(): void {
    val src = """trait Application { fun render(): int32 }
fun draw<A: Application>(app: &A): int32 { return (*app).render() }
struct DrawProbe { pub val tag: int32 }
impl Application for DrawProbe { fun render(): int32 { return self.tag } }
fun main(): int32 { val app = DrawProbe { tag: 42 }
return draw<DrawProbe>(&app) }"""
    val code = build_and_run(src, scratch_path("komp_generic_borrow_explicit"))
    assert_eq(code == 42, true, "draw<DrawProbe>(&app) passes a pointer → 42")
}

// Same with the type argument inferred.
@test fun integration_generic_borrowed_param_inferred_targ(): void {
    val src = """trait Application { fun render(): int32 }
fun draw<A: Application>(app: &A): int32 { return (*app).render() }
struct DrawProbe { pub val tag: int32 }
impl Application for DrawProbe { fun render(): int32 { return self.tag } }
fun main(): int32 { val app = DrawProbe { tag: 42 }
return draw(&app) }"""
    val code = build_and_run(src, scratch_path("komp_generic_borrow_inferred"))
    assert_eq(code == 42, true, "draw(&app) infers A = DrawProbe and borrows → 42")
}

// A generic method in an impl block is specialized as
// `Terminal_draw__DrawProbe`, its bounded call dispatching to the trait.
@test fun integration_generic_impl_method_explicit_targ(): void {
    val src = """trait Application { fun render(): int32 }
struct Terminal { pub val bias: int32 }
impl Terminal { pub fun draw<A: Application>(app: &A): int32 { return self.bias + (*app).render() } }
struct DrawProbe { pub val tag: int32 }
impl Application for DrawProbe { fun render(): int32 { return self.tag } }
fun main(): int32 { val app = DrawProbe { tag: 40 }
val t = Terminal { bias: 2 }
return t.draw<DrawProbe>(&app) }"""
    val code = build_and_run(src, scratch_path("komp_impl_method_explicit"))
    assert_eq(code == 42, true, "t.draw<DrawProbe>(&app) specializes the method → 42")
}

// Same with the method's type argument inferred.
@test fun integration_generic_impl_method_inferred_targ(): void {
    val src = """trait Application { fun render(): int32 }
struct Terminal { pub val bias: int32 }
impl Terminal { pub fun draw<A: Application>(app: &A): int32 { return self.bias + (*app).render() } }
struct DrawProbe { pub val tag: int32 }
impl Application for DrawProbe { fun render(): int32 { return self.tag } }
fun main(): int32 { val app = DrawProbe { tag: 40 }
val t = Terminal { bias: 2 }
return t.draw(&app) }"""
    val code = build_and_run(src, scratch_path("komp_impl_method_inferred"))
    assert_eq(code == 42, true, "t.draw(&app) infers A = DrawProbe → 42")
}

// Trait type arguments are part of an impl's identity: one target implements
// the conversion for int32 and bool.
@test fun integration_from_overloads_by_trait_type_arg(): void {
    // `Conv`, since core declares `From`.
    val src = """trait Conv<S> { static fun from(value: S): Self }
struct Cel { pub val value: int32 }
impl Conv<int32> for Cel { static fun from(value: int32): Cel { return Cel { value: value } } }
impl Conv<bool> for Cel { static fun from(value: bool): Cel { if value { return Cel { value: 1 } }
return Cel { value: 0 } } }
fun make<T: Conv<int32>>(value: int32): T { return T.from(value) }
fun main(): int32 { val a = Cel.from(40)
val b = Cel.from(true)
val c = make<Cel>(1)
return a.value + b.value + c.value }"""
    val code = build_and_run(src, scratch_path("komp_from_overloads"))
    assert_eq(code == 42, true, "From<int32> and From<bool> select distinct conversions")
}

// Two traits declaring one method for one type keep distinct symbols.
@test fun integration_trait_method_symbols_include_trait_identity(): void {
    val src = """trait First { fun label(): int32 }
trait Second { fun label(): int32 }
struct Item { pub val value: int32 }
impl First for Item { fun label(): int32 { return self.value } }
impl Second for Item { fun label(): int32 { return self.value + 1 } }
fun main(): int32 { return 42 }"""
    val code = build_and_run(src, scratch_path("komp_trait_identity"))
    assert_eq(code == 42, true, "same method in two traits emits distinct symbols")
}

// A generic trait impl dispatched on a concrete Pair<int32,int32>: 42.
@test fun integration_generic_trait_impl_clone(): void {
    // `dup`, since `clone` is reserved and `Clone` is core's.
    val src = """struct Pair<A, B> { pub val a: A  pub val b: B }
trait Dup<A, B> { fun dup(): Pair<A, B> }
impl Dup for Pair<A, B> { fun dup(): Pair<A, B> { return Pair<A, B> { a: self.a, b: self.b } } }
fun main(): int32 { val p = Pair<int32, int32> { a: 42, b: 1 }
val q = p.dup()
return q.a }"""
    val code = build_and_run(src, scratch_path("komp_gen_trait"))
    assert_eq(code == 42, true, "Pair<int32,int32>.clone() trait dispatch → 42")
}

// A value-position if/else chain: a=5 picks 40, plus 2 is 42.
@test fun integration_if_expression(): void {
    val src = "fun main(): int32 { val a = 5\nval k = if a > 3 { 40 } else if a > 1 { 20 } else { 0 }\nreturn k + 2 }"
    val code = build_and_run(src, scratch_path("komp_if_expr"))
    assert_eq(code == 42, true, "value-position if/else → ternary → 42")
}

// `continue` skips i==3, `break` exits at i==6: 1+2+4+5 = 12.
@test fun integration_break_continue(): void {
    val src = """fun main(): int32 { var i = 0
var sum = 0
while i < 10 { i = i + 1
if i == 3 { continue }
if i == 6 { break }
sum = sum + i }
return sum }"""
    val code = build_and_run(src, scratch_path("komp_break_cont"))
    assert_eq(code == 12, true, "while + continue@3 + break@6 → 12")
}

// An early return inside an `if` drops the sibling heap local.
@test fun leak_early_return_drops_sibling(): void {
    val src = "fun main(): int32 { val a = String.from(\"aaa\")\nif a.equals(a) { return 0 }\nreturn 1 }"
    val code = build_and_run_leakcheck(src, scratch_path("komp_leak_ret"))
    assert_eq(code == 0, true, "early return drops `a` under ASan (exit 0)")
}

// `break` must drop the loop-body heap local allocated that iteration.
@test fun leak_break_drops_loop_local(): void {
    val src = """fun main(): int32 { var i = 0
while i < 5 { val s = String.from("x")
i = i + 1
if i == 2 { break } }
return 0 }"""
    val code = build_and_run_leakcheck(src, scratch_path("komp_leak_brk"))
    assert_eq(code == 0, true, "break drops loop-body `s` under ASan (exit 0)")
}

// `continue` must drop the loop-body heap local on the skipped iteration.
@test fun leak_continue_drops_loop_local(): void {
    val src = """fun main(): int32 { var i = 0
while i < 5 { val s = String.from("x")
i = i + 1
if i == 2 { continue } }
return 0 }"""
    val code = build_and_run_leakcheck(src, scratch_path("komp_leak_cont"))
    assert_eq(code == 0, true, "continue drops loop-body `s` under ASan (exit 0)")
}

@test fun string_append_accepts_its_own_view_under_asan(): void {
    val src = """fun main(): int32 { var text = String.from("abcdefghijklmnopqrstuvwxyz")
var i = 0
while i < 12 { text.append(text.as_str())
i = i + 1 }
if text.byte_len() == 106496 { return 0 }
return 1 }"""
    val code = build_and_run_leakcheck(src, scratch_path("komp_string_self_append"))
    assert_eq(code == 0, true, "self-append remains valid when realloc moves the buffer")
}

// new_buffer<int32> returns Buffer<T>; the materialized body substitutes
// alloc_array<T> and Ptr<T>. 40 + 2 = 42.
@test fun integration_generic_buffer_full(): void {
    val src = """struct Buffer<T> { pub var data: Ptr<T>  pub var cap: uint64 }
fun new_buffer<T>(capacity: uint64): Buffer<T> { val d = unsafe { alloc_array<T>(capacity) }
return Buffer<T> { data: d, cap: capacity } }
impl Buffer<T: Copy> { pub fun get(index: uint64): T { return unsafe { *(self.data + index) } }  pub fun store(index: uint64, value: T): void { unsafe { *(self.data + index) = value } } }
fun main(): int32 { var b = new_buffer<int32>(4)
b.store(0, 40)
b.store(1, 2)
return b.get(0) + b.get(1) }"""
    val code = build_and_run(src, scratch_path("komp_gen_buffer_full"))
    assert_eq(code == 42, true, "Buffer<int32> full body materialization -> 42")
}

@test
fun inferred_borrows_mutate_without_consuming(): void {
    val source = read_file("tests/cases/mm1b_inferred_borrow.kf")
    val code = build_and_run_leakcheck(source.as_str(), scratch_path("komp_mm1b"))
    assert_eq(code == 0, true, "inferred shared and mutable borrows are ASan-clean")
}

@test
fun explicit_and_inferred_mutable_borrows_emit_identical_c(): void {
    val inferred = """struct Cell { var value: int32 }
fun bump(c: &var Cell): void { (*c).value = 1 }
fun main(): void { var c = Cell { value: 0 }
bump(c) }"""
    val explicit = """struct Cell { var value: int32 }
fun bump(c: &var Cell): void { (*c).value = 1 }
fun main(): void { var c = Cell { value: 0 }
bump(&var c) }"""
    val inferred_c = compile_source(inferred)
    val explicit_c = compile_source(explicit)
    assert_eq(inferred_c.as_str().equals(explicit_c.as_str()), true, "explicit and inferred mutable borrows emit identical C")
}

// `T?` is core's Option: `null` is None, a bare value is wrapped in Some.
@test fun integration_option_sugar_e2e(): void {
    val src = """fun find(flag: bool): int32? { if flag { return 42 }
return null }
fun main(): int32 { when (find(true)) { Some(v) => return v  None => return 1 }
return 0 }"""
    val code = build_and_run_with_core(src, false)
    assert_eq(code == 42, true, "T? + null + Some-wrap through the core enum")
}

// Option<String> frees its payload exactly once, under ASan.
@test fun integration_option_string_drops_clean(): void {
    val src = """fun pick(flag: bool): String? { if flag { return String.from("heap payload") }
return null }
fun main(): int32 { when (pick(true)) { Some(s) => { if s.byte_len() > 0 { return 0 }
return 1 }  None => return 2 }
return 3 }"""
    val code = build_and_run_with_core(src, true)
    assert_eq(code == 0, true, "Option<String> payload dropped exactly once (ASan-clean)")
}

// Result with an inferred Err: payload inference binds E, the return type T.
@test fun integration_result_inferred_err_e2e(): void {
    val src = """fun mk(flag: bool): Result<int32, str> { if flag { return Result.Ok(42) }
return Result.Err("no") }
fun main(): int32 { when (mk(true)) { Ok(v) => return v  Err(_m) => return 1 }
return 0 }"""
    val code = build_and_run_with_core(src, false)
    assert_eq(code == 42, true, "Result.Err binds T from the return slot; core-enum when path")
}

// Every slot knowing its type applies it before judging the value, or the
// Option rewrites never fire. The exit code is asserted: a failure shows up
// as gcc rejecting the C.
@test fun integration_option_wrap_reaches_every_slot(): void {
    val src = """struct Holder { pub val o: int32? }
fun consume(o: int32?): bool { return o.is_some() }
fun ret(): int32? { return 5 }
fun main(): int32 { if !consume(5) { return 1 }
 if !ret().is_some() { return 2 }
 val a: int32? = 5
 if !a.is_some() { return 3 }
 var v: int32? = null
 v = 5
 if !v.is_some() { return 4 }
 val h = Holder { o: 5 }
 if !h.o.is_some() { return 5 }
 val n = Holder { o: null }
 if !n.o.is_none() { return 6 }
 return 42 }"""
    val code = build_and_run_with_core(src, false)
    assert_eq(code == 42, true, "Some-wrap reaches arg, return, let, assign and struct-field slots")
}

// The wrap discriminates: `val a: int32? = "str"` is rejected.
@test fun integration_option_wrap_rejects_a_foreign_payload(): void {
    val src = "fun main(): int32 { val a: int32? = \"str\"\nreturn 0 }"
    val code = build_and_run_with_core(src, false)
    assert_eq(code != 0, true, "a str does not wrap into Option<int32>")
}

// `?:` bail shapes: unbraced, braced, newline continuation, two bindings at
// one block level, and a bail in a nested block.
@test fun integration_elvis_bail_shapes(): void {
    val src = """fun look(h: bool): int32? { if h { return 4 }
return null }
fun one(h: bool): int32 { val v = look(h) ?: return 0 - 1
return v }
fun braced(h: bool): int32 { val v = look(h) ?: {
 val n = 7
 return 0 - n
 }
 return v + 1 }
fun wrapped(h: bool): int32 { val v = look(h)
 ?: return 0 - 2
 return v + 2 }
fun twice(a: bool, b: bool): int32 { val x = look(a) ?: return 0 - 3
 val y = look(b) ?: return 0 - 4
 return x + y }
fun nested(h: bool): int32 { var acc = 0
 if true { val v = look(h) ?: return 0 - 5
 acc = v }
 return acc + 3 }
fun main(): int32 { if one(true) != 4 { return 1 }
 if one(false) != 0 - 1 { return 2 }
 if braced(true) != 5 { return 3 }
 if braced(false) != 0 - 7 { return 4 }
 if wrapped(true) != 6 { return 5 }
 if wrapped(false) != 0 - 2 { return 6 }
 if twice(true, true) != 8 { return 7 }
 if twice(true, false) != 0 - 4 { return 8 }
 if nested(true) != 7 { return 9 }
 if nested(false) != 0 - 5 { return 10 }
 return 42 }"""
    val code = build_and_run_with_core(src, false)
    assert_eq(code == 42, true, "`?:` bails in every binding shape")
}

// A bail must not fall through.
@test fun integration_elvis_rejects_a_falling_through_bail(): void {
    val src = """fun look(h: bool): int32? { if h { return 4 }
return null }
fun bad(h: bool): int32 { val v = look(h) ?: { val x = 1 }
return v }
fun main(): int32 { return bad(true) }"""
    val code = build_and_run_with_core(src, false)
    assert_eq(code != 0, true, "a non-diverging `?:` right-hand side is rejected")
}

// The payload shares the subject's backing: neither cloned nor dropped twice.
@test fun integration_elvis_move_only_payload_is_asan_clean(): void {
    val src = """fun pick(h: bool): String? { if h { return String.from("heap payload") }
return null }
fun grab(h: bool): int32 { val s = pick(h) ?: return 1
 if s.byte_len() == 12 { return 0 }
 return 2 }
fun main(): int32 { if grab(true) != 0 { return 3 }
 if grab(false) != 1 { return 4 }
 return 0 }"""
    val code = build_and_run_with_core(src, true)
    assert_eq(code == 0, true, "`?:` over Option<String> is ASan-clean on both paths")
}

// `while x in` over Option<String> drops each Some payload once.
@test fun integration_for_in_option_string_clean(): void {
    val src = """import alloc.list.*
fun main(): int32 { var xs = List.new<String>()
xs.push(String.from("alpha"))
xs.push(String.from("beta"))
var n = 0
while s in xs { n = n + 1 }
if n == 2 { if xs.size() == 2 { return 0 } }
return 1 }"""
    val code = build_and_run_with_core(src, true)
    assert_eq(code == 0, true, "while-in over List<String> (Option next) is ASan-clean, container intact")
}
