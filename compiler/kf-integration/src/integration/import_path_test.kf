// A wildcard import must name a module that exists. Build and check must
// agree: build reads file names from the `.kfi`, check from the SourceMap.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_tool.build.build_project_separate
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

/// A one-file binary crate whose `main.kf` opens with `import_line`.
fun prepare_import_fixture(name: str, import_line: str): int32 {
    val cmd = "rm -rf ${scratch_root()}/${name} && mkdir -p ${scratch_root()}/${name}/src"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }

    val toml_path = "${scratch_root()}/${name}/kf.toml"
    val toml = "[project]\nname = \"${name}\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    write_file(toml_path.as_str(), toml.as_str())

    val main_path = "${scratch_root()}/${name}/src/main.kf"
    var main_src = String.from(import_line)
    main_src.append("\nfun main(): int32 { return 0 }\n")
    write_file(main_path.as_str(), main_src.as_str())
    return 0
}

fun check_import_fixture(name: str): int32 {
    var dir = "${scratch_root()}/"
    dir.append(name)
    return check_project(dir.as_str())
}

/// Separate compilation, so `core` arrives as an interface.
fun build_import_fixture(name: str): int32 {
    var dir = "${scratch_root()}/"
    dir.append(name)
    return build_project_separate(dir.as_str(), "")
}

@test
fun a_wildcard_naming_no_module_and_no_file_is_rejected(): void {
    assert_eq(prepare_import_fixture("kf_imp_bogus", "import core.option.*\nimport core.memory.*\n"), 0, "fixture prepared")
    assert_eq(check_import_fixture("kf_imp_bogus") != 0, true, "`core.memory` names neither a module nor a file")
}

@test
fun a_wildcard_naming_a_real_file_resolves(): void {
    assert_eq(prepare_import_fixture("kf_imp_real", "import core.option.*\n"), 0, "fixture prepared")
    assert_eq(check_import_fixture("kf_imp_real"), 0, "`core.option` names the file option.kf inside core")
}

/// The interface carries the file names.
@test
fun a_separate_build_reads_file_names_from_the_interface(): void {
    assert_eq(prepare_import_fixture("kf_imp_iface", "import core.option.*\n"), 0, "fixture prepared")
    assert_eq(build_import_fixture("kf_imp_iface"), 0, "a real file path builds with core coming from its .kfi")
}

@test
fun build_and_check_agree_about_a_bogus_import(): void {
    assert_eq(prepare_import_fixture("kf_imp_agree", "import core.option.*\nimport core.memory.*\n"), 0, "fixture prepared")
    val checked = check_import_fixture("kf_imp_agree") != 0
    val built = build_import_fixture("kf_imp_agree") != 0
    assert_eq(checked && built, true, "both commands reject it, rather than one accepting what the other refuses")
}
