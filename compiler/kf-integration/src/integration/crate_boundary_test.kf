// A bin crate calls its dependency's public function, struct and method
// across a C translation-unit boundary; the app's C holds only calls against
// the library's header.

import alloc.list.*
import core.assert.assert_eq

import kf_codegen.*
import kf_codegen.runtime.emit_runtime_header
import kf_integration.harness.compile_project_separate
import std.fs.scratch_path
import kf_core.diagnostic.new_diagnostics

extern "C" fun system(cmd: str): int32

fun write_sc2_fixtures(): void {
    val _mk = unsafe { system("rm -rf ${scratch_path("kf_sc2_core")} ${scratch_path("kf_sc2_lib")} ${scratch_path("kf_sc2_app")} && mkdir -p ${scratch_path("kf_sc2_core/src")} ${scratch_path("kf_sc2_lib/src")} ${scratch_path("kf_sc2_app/src")} && cp -R libs/core/src/. ${scratch_path("kf_sc2_core/src/")}") }
    write_file(scratch_path("kf_sc2_core/kf.toml"), "[project]\nname = \"core\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc2_lib/kf.toml"), """[project]
name = "sc2lib"
kind = "lib"

[dependencies]
core = { path = "../kf_sc2_core" }
""")
    var lib_src = String.from("pub struct Point {\n    pub val x: int32\n    pub val y: int32\n}\n\n")
    lib_src.append("impl Point {\n    pub fun sum(): int32 { return self.x + self.y }\n}\n\n")
    lib_src.append("pub fun answer(): int32 {\n    val p = Point { x: 40, y: 2 }\n    return p.sum()\n}\n")
    write_file(scratch_path("kf_sc2_lib/src/lib.kf"), lib_src.as_str())
    write_file(scratch_path("kf_sc2_app/kf.toml"), """[project]
name = "sc2app"
kind = "bin"

[dependencies]
core = { path = "../kf_sc2_core" }
sc2lib = { path = "../kf_sc2_lib" }
""")
    var app_src = String.from("import sc2lib.*\n\n")
    app_src.append("""fun main(): int32 {
    val p = Point { x: 1, y: 2 }
    if answer() + p.sum() == 45 { return 0 }
    return 1
}
""")
    write_file(scratch_path("kf_sc2_app/src/main.kf"), app_src.as_str())
}

fun build_sc2(): List<CrateCodegenOutput> {
    write_sc2_fixtures()
    var errors = new_diagnostics()
    return compile_project_separate(scratch_path("kf_sc2_app"), &var errors)
}

// The library compiles first, the app last.
fun output_source(outs: &List<CrateCodegenOutput>, name: str): String {
    while o in &outs {
        if o.crate_name.as_str() == name {
            return o.source.clone()
        }
    }
    return ""
}

@test
fun non_generic_call_crosses_a_tu_boundary(): void {
    val outs = build_sc2()
    // This writes a `core.h`, so it gets its own directory: a stray one in a
    // shared include root shadows the real one.
    val _mk = unsafe { system("rm -rf ${scratch_path("kf_sc2_out")} && mkdir -p ${scratch_path("kf_sc2_out")}") }
    while o in &outs {
        val h_path = String.from(scratch_path("kf_sc2_out/")) + o.crate_name.clone() + String.from(".h")
        val c_path = String.from(scratch_path("kf_sc2_out/")) + o.crate_name.clone() + String.from(".c")
        write_file(h_path.as_str(), o.header.as_str())
        write_file(c_path.as_str(), o.source.as_str())
    }
    write_file(scratch_path("kf_sc2_out/kf_runtime.h"), emit_runtime_header().as_str())
    val rc = unsafe { system("cc -fsanitize=address -I${scratch_path("kf_sc2_out")} ${scratch_path("kf_sc2_out/core.c")} ${scratch_path("kf_sc2_out/sc2lib.c")} ${scratch_path("kf_sc2_out/sc2app.c")} libs/core/native/core.c libs/core/native/core_hosted.c -lm -o ${scratch_path("kf_sc2_out/bin")} && ${scratch_path("kf_sc2_out/bin")}") }
    assert_eq(rc, 0, "app TU calls the library TU through its header")
}

@test
fun consumer_source_has_no_dependency_bodies(): void {
    val outs = build_sc2()
    val app_c = output_source(&outs, "sc2app")
    assert_eq(sc2_contains(app_c.as_str(), "int32_t sc2lib__answer(void) {"), false, "imported declarations generate calls, not bodies")
}

@test
fun owner_source_carries_its_bodies(): void {
    val outs = build_sc2()
    val lib_c = output_source(&outs, "sc2lib")
    assert_eq(sc2_contains(lib_c.as_str(), "int32_t sc2lib__answer(void) {"), true, "the owning crate defines its functions")
}

@test
fun project_emission_is_deterministic(): void {
    val first = build_sc2()
    val second = build_sc2()
    val lib_same = output_source(&first, "sc2lib").as_str() == output_source(&second, "sc2lib").as_str()
    val app_same = output_source(&first, "sc2app").as_str() == output_source(&second, "sc2app").as_str()
    assert_eq(lib_same && app_same, true, "two clean builds emit byte-identical artifacts")
}

// A consumer struct holding a dependency's `Drop` type by value must drop it;
// ownership is asked of the merged module. `Res`'s drop exits 0 while `main`
// returns 3.
fun write_drop_member_fixtures(): void {
    val core_dir = scratch_path("kf_sc2_core")
    val lib_dir = scratch_path("kf_sc2_droplib")
    val app_dir = scratch_path("kf_sc2_dropapp")
    var mk = String.from("rm -rf")
    mk.append(" ${core_dir} ${lib_dir} ${app_dir}")
    mk.append(" && mkdir -p ${core_dir}/src ${lib_dir}/src ${app_dir}/src")
    mk.append(" && cp -R libs/core/src/. ${core_dir}/src/")
    val _mk = unsafe { system(mk.as_str()) }
    write_file(scratch_path("kf_sc2_core/kf.toml"), "[project]\nname = \"core\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc2_droplib/kf.toml"), """[project]
name = "sc2droplib"
kind = "lib"

[dependencies]
core = { path = "../kf_sc2_core" }
""")
    write_file(scratch_path("kf_sc2_droplib/src/lib.kf"), """extern "C" fun _exit(code: int32): void

pub struct Res {
    pub var tag: int32
}

impl Drop for Res {
    fun drop(): void { unsafe { _exit(0) } }
}

pub fun make_res(tag: int32): Res {
    return Res { tag: tag }
}
""")
    write_file(scratch_path("kf_sc2_dropapp/kf.toml"), """[project]
name = "sc2dropapp"
kind = "bin"

[dependencies]
core = { path = "../kf_sc2_core" }
sc2droplib = { path = "../kf_sc2_droplib" }
""")
    write_file(scratch_path("kf_sc2_dropapp/src/main.kf"), """import sc2droplib.*

pub struct Holder {
    pub var r: Res
}

struct Hidden {
    var r: Res
}

fun main(): int32 {
    val hidden = Hidden { r: make_res(1) }
    val holder = Holder { r: make_res(2) }
    if hidden.r.tag + holder.r.tag != 3 { return 1 }
    return 3
}
""")
}

fun build_drop_member(): List<CrateCodegenOutput> {
    write_drop_member_fixtures()
    var errors = new_diagnostics()
    return compile_project_separate(scratch_path("kf_sc2_dropapp"), &var errors)
}

@test
fun consumer_glue_drops_a_dependency_member(): void {
    val outs = build_drop_member()
    val app_c = output_source(&outs, "sc2dropapp")
    val public_path = sc2_contains(app_c.as_str(), "sc2dropapp__Holder v) {\n    sc2droplib__Res__glue_drop(v.r);")
    val private_path = sc2_contains(app_c.as_str(), "sc2dropapp__Hidden v) {\n    sc2droplib__Res__glue_drop(v.r);")
    assert_eq(public_path && private_path, true, "a pub and a private struct both drop the dependency's Drop member")
}

@test
fun a_dependency_drop_runs_inside_a_consumer_struct(): void {
    val outs = build_drop_member()
    val out = scratch_path("kf_sc2_dropout")
    val _mk = unsafe { system("rm -rf ${out} && mkdir -p ${out}") }
    while o in &outs {
        val h_path = String.from(scratch_path("kf_sc2_dropout/")) + o.crate_name.clone() + String.from(".h")
        val c_path = String.from(scratch_path("kf_sc2_dropout/")) + o.crate_name.clone() + String.from(".c")
        write_file(h_path.as_str(), o.header.as_str())
        write_file(c_path.as_str(), o.source.as_str())
    }
    write_file(scratch_path("kf_sc2_dropout/kf_runtime.h"), emit_runtime_header().as_str())
    var link = String.from("cc -fsanitize=address")
    link.append(" -I${out} ${out}/core.c ${out}/sc2droplib.c ${out}/sc2dropapp.c")
    link.append(" libs/core/native/core.c libs/core/native/core_hosted.c -lm")
    link.append(" -o ${out}/bin && ${out}/bin")
    val rc = unsafe { system(link.as_str()) }
    assert_eq(rc, 0, "the dependency's drop ran when main's scope released the consumer's struct")
}

fun sc2_contains(s: str, needle: str): bool {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return true }
    if sl < nl { return false }
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}
