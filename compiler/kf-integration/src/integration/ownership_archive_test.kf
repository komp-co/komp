import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun prepare_ownership_archive_fixture(early_return: bool): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc5_parcel_lib")} ${scratch_path("kf_sc5_parcel_app")} && mkdir -p ${scratch_path("kf_sc5_parcel_lib/src")} ${scratch_path("kf_sc5_parcel_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_sc5_parcel_lib/kf.toml"), "[project]\nname = \"parcel_lib\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc5_parcel_lib/src/lib.kf"), """pub struct Parcel {
    pub val label: String
}

pub fun make_parcel(label: String): Parcel {
    return Parcel { label: label }
}
""")
    write_file(scratch_path("kf_sc5_parcel_app/kf.toml"), """[project]
name = "parcel_app"
kind = "bin"

[dependencies]
parcel_lib = { path = "../kf_sc5_parcel_lib" }
""")
    if early_return {
        write_file(scratch_path("kf_sc5_parcel_app/src/main.kf"), """import parcel_lib.*

fun main(): int32 {
    if true {
        val parcel = make_parcel("early")
        val copy = parcel.clone()
        if copy.label.as_str() == "early" { return 0 }
    }
    return 1
}
""")
    } else {
        write_file(scratch_path("kf_sc5_parcel_app/src/main.kf"), """import parcel_lib.*

fun main(): int32 {
    val parcel = make_parcel("normal")
    val copy = parcel.clone()
    if copy.label.as_str() == "normal" { return 0 }
    return 1
}
""")
    }
    return 0
}

fun build_ownership_from_interface(early_return: bool): int32 {
    val prepared = prepare_ownership_archive_fixture(early_return)
    if prepared != 0 { return prepared }
    val first = build_project_separate(scratch_path("kf_sc5_parcel_app"), "-fsanitize=address")
    if first != 0 { return first }
    val hidden = unsafe { system("mv ${scratch_path("kf_sc5_parcel_lib/src")} ${scratch_path("kf_sc5_parcel_lib/src.hidden")}") }
    if hidden != 0 { return hidden }
    val rebuilt = build_project_separate(scratch_path("kf_sc5_parcel_app"), "-fsanitize=address")
    val ran = unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_path("kf_sc5_parcel_app/target/kflat/parcel_app")}") }
    val restored = unsafe { system("mv ${scratch_path("kf_sc5_parcel_lib/src.hidden")} ${scratch_path("kf_sc5_parcel_lib/src")}") }
    if rebuilt != 0 { return rebuilt }
    if restored != 0 { return restored }
    return ran
}

fun ownership_contains(source: str, needle: str): bool {
    return ownership_count(source, needle) > 0
}

fun ownership_count(source: str, needle: str): uint64 {
    val source_len = source.byte_len()
    val needle_len = needle.byte_len()
    if needle_len == 0 || source_len < needle_len { return 0 }
    var count: uint64 = 0
    var i: uint64 = 0
    while i + needle_len <= source_len {
        var matches = true
        var j: uint64 = 0
        while j < needle_len {
            if source.byte_at(i + j) != needle.byte_at(j) {
                matches = false
            }
            j = j + 1
        }
        if matches { count = count + 1 }
        i = i + 1
    }
    return count
}

@test
fun dependency_value_clone_and_scope_exit_are_asan_clean(): void {
    assert_eq(build_ownership_from_interface(false), 0, "cross-archive clone and scope cleanup are ASan-clean")
}

@test
fun dependency_value_early_return_is_asan_clean(): void {
    assert_eq(build_ownership_from_interface(true), 0, "cross-archive early-return cleanup is ASan-clean")
}

@test
fun dependency_source_owns_one_drop_definition(): void {
    val _built = build_ownership_from_interface(false)
    val source = read_file(scratch_path("kf_sc5_parcel_app/target/kflat/parcel_lib.c"))
    assert_eq(ownership_count(source.as_str(), "void parcel_lib__Parcel__glue_drop(parcel_lib__Parcel v) {"), 1, "dependency source owns one drop definition")
}

@test
fun consumer_calls_dependency_drop_symbol(): void {
    val _built = build_ownership_from_interface(false)
    val source = read_file(scratch_path("kf_sc5_parcel_app/target/kflat/parcel_app.c"))
    assert_eq(ownership_contains(source.as_str(), "parcel_lib__Parcel__glue_drop("), true, "consumer calls the dependency drop symbol")
}

@test
fun consumer_contains_no_dependency_drop_body(): void {
    val _built = build_ownership_from_interface(false)
    val source = read_file(scratch_path("kf_sc5_parcel_app/target/kflat/parcel_app.c"))
    assert_eq(ownership_contains(source.as_str(), "void parcel_lib__Parcel__glue_drop(parcel_lib__Parcel v) {"), false, "consumer contains no dependency drop body")
}

@test
fun dependency_header_declares_drop_symbol(): void {
    val _built = build_ownership_from_interface(false)
    val header = read_file(scratch_path("kf_sc5_parcel_app/target/kflat/parcel_lib.h"))
    assert_eq(ownership_contains(header.as_str(), "void parcel_lib__Parcel__glue_drop(parcel_lib__Parcel v);"), true, "dependency header declares drop")
}
