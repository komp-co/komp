// A `str` the callee keeps must not point into a temporary `String`.

import core.assert.assert_eq
import alloc.list.*
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module
import kf_integration.harness.typed_crate_for
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

/// Whether checking `source` as a one-file crate reports the kept temporary.
fun reports_kept_temporary(name: str, source: str): bool {
    val root = scratch_path(name)
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml".as_str(), "[project]\nname = \"str_probe\"\nkind = \"lib\"\n")
    val file = "${root}/src/lib.kf"
    write_file(file.as_str(), source)
    var crate = typed_crate_for(file.as_str())
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    val diags = typecheck_module(&var crate.module, &var table)
    while d in &diags {
        if d.primary.message.as_str().contains("which points into a `String` freed at the end of") { return true }
    }
    return false
}

@test
fun a_temporary_string_pushed_as_a_str_is_rejected(): void {
    val reported = reports_kept_temporary("kf_str_push", """import alloc.list.*
pub fun f(): uint64 {
    var names = ["T"]
    names.push(String.from("hello"))
    return names.size()
}
""")
    assert_eq(reported, true, "the list would point into freed text")
}

@test
fun a_string_kept_in_a_local_may_be_pushed_as_a_str(): void {
    val reported = reports_kept_temporary("kf_str_push_local", """import alloc.list.*
pub fun f(): uint64 {
    val kept = String.from("hello")
    var names = ["T"]
    names.push(kept)
    return names.size()
}
""")
    assert_eq(reported, false, "the local outlives the list's use of it")
}

@test
fun a_generic_method_keeping_a_temporary_string_is_rejected(): void {
    val reported = reports_kept_temporary("kf_str_method", """import alloc.list.*
struct Bag<T> { var items: List<T> }
impl Bag<T> {
    mutating fun add(item: T): void { self.items.push(item) }
}
pub fun f(): void {
    var bag = Bag<str> { items: List.new<str>() }
    bag.add(String.from("a"))
}
""")
    assert_eq(reported, true, "`T` is stored, and stands for `str`")
}

@test
fun a_generic_function_keeping_a_temporary_string_is_rejected(): void {
    val reported = reports_kept_temporary("kf_str_function", """import alloc.list.*
fun keep<T>(xs: &var List<T>, item: T): void { xs.push(item) }
pub fun f(): void {
    var xs = List.new<str>()
    keep(&var xs, String.from("b"))
}
""")
    assert_eq(reported, true, "`T` is stored, and stands for `str`")
}

@test
fun a_str_parameter_borrows_a_temporary_string(): void {
    val reported = reports_kept_temporary("kf_str_param", """fun width(s: str): uint64 { return s.byte_len() }
pub fun f(): uint64 { return width(String.from("abc")) }
""")
    assert_eq(reported, false, "the parameter only borrows for the call")
}

@test
fun a_generic_that_only_compares_keeps_nothing(): void {
    val reported = reports_kept_temporary("kf_str_compare", """fun same<T: Equal>(a: T, b: T): bool { return a == b }
pub fun f(): bool { return same("abc", String.from("abc").as_str()) }
pub fun g(name: str): bool { return same(name, String.from(name).as_str()) }
""")
    assert_eq(reported, false, "neither argument outlives the call")
}
