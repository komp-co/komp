// Two crates exporting the same function and type names compile to distinct
// crate-qualified C symbols and link into one binary against one runtime.

import core.assert.assert_eq

import kf_codegen.runtime.emit_runtime_header
import kf_integration.harness.compile_crate_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

/// A Point struct with a method, and `answer()` summing one.
fun write_fixture_crate(root: str, x: str, y: str): void {
    val mk = "mkdir -p ${root}/src"
    val _rc = unsafe { system(mk.as_str()) }
    var src = String.from("pub struct Point {\n    pub val x: int32\n    pub val y: int32\n}\n\n")
    src.append("impl Point {\n    pub fun first(): int32 { return self.x }\n}\n\n")
    src.append("pub fun answer(): int32 {\n    val p = Point { x: ")
    src.append(x)
    src.append(", y: ")
    src.append(y)
    src.append(" }\n    return p.first()\n}\n")
    val path = String.from(root) + String.from("/src/lib.kf")
    write_file(path.as_str(), src.as_str())
}

@test
fun same_names_in_two_crates_link_into_one_binary(): void {
    write_fixture_crate(scratch_path("kf_sc1_a"), "40", "2")
    write_fixture_crate(scratch_path("kf_sc1_b"), "3", "4")
    val ca = compile_crate_separate(scratch_path("kf_sc1_a"), "sc1a", false)
    val cb = compile_crate_separate(scratch_path("kf_sc1_b"), "sc1b", false)
    // Its own directory, since it is also the include root.
    val _mk = unsafe { system("mkdir -p ${scratch_path("kf_sc1_out")}") }
    // core's native tier includes the header declaring its entry points.
    assert_eq(write_core_header_into(scratch_path("kf_sc1_out")), true, "core's header is what its native tier compiles against")
    write_file(scratch_path("kf_sc1_out/a.c"), ca.as_str())
    write_file(scratch_path("kf_sc1_out/b.c"), cb.as_str())
    write_file(scratch_path("kf_sc1_out/kf_runtime.h"), emit_runtime_header().as_str())
    write_file(scratch_path("kf_sc1_out/main.c"), """#include <stdint.h>
int32_t sc1a__answer(void);
int32_t sc1b__answer(void);
int main(void) {
    if (sc1a__answer() != 40) { return 1; }
    if (sc1b__answer() != 3) { return 2; }
    return 0;
}
""")
    val rc = unsafe { system("cc -fsanitize=address -I${scratch_path("kf_sc1_out")} ${scratch_path("kf_sc1_out/a.c")} ${scratch_path("kf_sc1_out/b.c")} libs/core/native/core.c libs/core/native/core_hosted.c ${scratch_path("kf_sc1_out/main.c")} -o ${scratch_path("kf_sc1_out/bin")} && ${scratch_path("kf_sc1_out/bin")}") }
    assert_eq(rc, 0, "same-named exports from two crates link and run")
}

@test
fun generic_alloc_uses_the_qualified_crate_type(): void {
    val _mkdir = unsafe { system("mkdir -p ${scratch_path("kf_sc8_alloc/src")}") }
    write_file(scratch_path("kf_sc8_alloc/src/lib.kf"), """pub struct Point { pub val value: int32 }
pub fun allocate(): int32 { val p = unsafe { alloc<Point>() }
return 0 }
""")
    val generated = compile_crate_separate(scratch_path("kf_sc8_alloc"), "sc8_alloc", false)
    val _mkout = unsafe { system("mkdir -p ${scratch_path("kf_sc8_out")}") }
    write_file(scratch_path("kf_sc8_out/alloc.c"), generated.as_str())
    write_file(scratch_path("kf_sc8_out/kf_runtime.h"), emit_runtime_header().as_str())
    val rc = unsafe { system("cc -c ${scratch_path("kf_sc8_out/alloc.c")} -I${scratch_path("kf_sc8_out")} -o ${scratch_path("kf_sc8_out/alloc.o")} 2>/dev/null") }
    assert_eq(rc, 0, "generic alloc emits the qualified Point C type")
}
