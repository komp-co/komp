// An arm naming another arm's binder, and a `pub` signature naming a private
// type, are checker errors. Tested with `komp check`: a case saying
// `build: fail` passes even when gcc is what fails.

import core.assert.assert_eq

import kf_integration.harness.check_project
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

/// Named `arm_scope`: `_test.kf` files share one namespace, and
/// `editor/scope_test.kf` has `prepare_scope_fixture`.
fun prepare_arm_scope_fixture(name: str, body: str): int32 {
    val cmd = "rm -rf ${scratch_root()}/${name} && mkdir -p ${scratch_root()}/${name}/src"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }

    val toml_path = "${scratch_root()}/${name}/kf.toml"
    val toml = "[project]\nname = \"${name}\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    write_file(toml_path.as_str(), toml.as_str())

    val main_path = "${scratch_root()}/${name}/src/main.kf"
    write_file(main_path.as_str(), body)
    return 0
}

fun check_arm_scope_fixture(name: str): int32 {
    var dir = "${scratch_root()}/"
    dir.append(name)
    return check_project(dir.as_str())
}

/// `r` is bound by the first arm only.
@test
fun an_arm_cannot_name_another_arms_binder(): void {
    val src = """enum Shape { Circle(int32)
             Square(int32) }

fun probe(s: Shape): int32 {
    return when (s) {
        Circle(r) => 1
        Square(w) => r
    }
}

fun main(): int32 { return probe(Shape.Square(7)) }
"""
    assert_eq(prepare_arm_scope_fixture("kf_scope_leak", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_scope_leak") != 0, true, "a binder from another arm is not in scope")
}

/// The control: each arm using its own binder.
@test
fun an_arm_may_use_its_own_binder(): void {
    val src = """enum Shape { Circle(int32)
             Square(int32) }

fun probe(s: Shape): int32 {
    return when (s) {
        Circle(r) => r
        Square(w) => w
    }
}

fun main(): int32 { return probe(Shape.Square(0)) }
"""
    assert_eq(prepare_arm_scope_fixture("kf_scope_own", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_scope_own"), 0, "an arm's own binder is in scope for its body")
}

/// One name reused across arms.
@test
fun two_arms_may_reuse_one_binder_name(): void {
    val src = """fun clamp(v: int32): int32 {
    return when (v) {
        n if n > 100 => 100
        n => n
    }
}

fun main(): int32 { return clamp(7) - 7 }
"""
    assert_eq(prepare_arm_scope_fixture("kf_scope_reuse", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_scope_reuse"), 0, "the same binder name in two arms is not a shadow")
}

/// A private type in a `pub` signature: header and body would both define it,
/// legal in C23 and an error in C17.
@test
fun a_pub_signature_may_not_name_a_private_type(): void {
    val src = "struct Hidden { val n: int32 }\n\npub fun leaks_it(h: Hidden): int32 { return h.n }\n"
    assert_eq(prepare_arm_scope_fixture("kf_pub_private", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_pub_private") != 0, true, "a private type in a pub signature is rejected")
}

/// Through `List<Inst>` too.
@test
fun a_private_type_nested_in_a_generic_is_still_named(): void {
    val src = "struct Hidden { val n: int32 }\n\npub fun leaks_it(xs: List<Hidden>): int32 { return 0 }\n"
    assert_eq(prepare_arm_scope_fixture("kf_pub_nested", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_pub_nested") != 0, true, "a private type inside a type argument is still exported")
}

/// Controls, so a check rejecting everything cannot pass.
@test
fun a_private_function_may_name_a_private_type(): void {
    val src = """struct Hidden { val n: int32 }

fun keeps_it(h: Hidden): int32 { return h.n }

pub fun answer(): int32 { return keeps_it(Hidden { n: 42 }) }
"""
    assert_eq(prepare_arm_scope_fixture("kf_pub_ok_priv", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_pub_ok_priv"), 0, "a private signature is not exported, so nothing collides")
}

@test
fun a_pub_signature_may_name_a_pub_type(): void {
    val src = """pub struct Shown { val n: int32 }

pub fun shows_it(s: Shown): int32 { return s.n }
pub fun borrows_it(s: &Shown): int32 { return s.n }
"""
    assert_eq(prepare_arm_scope_fixture("kf_pub_ok_pub", src), 0, "fixture prepared")
    assert_eq(check_arm_scope_fixture("kf_pub_ok_pub"), 0, "a pub type in a pub signature is exactly what the header is for")
}
