import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun prepare_dyn_trait_archive_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_dyn_api")} ${scratch_path("kf_dyn_impl")} ${scratch_path("kf_dyn_app")} && mkdir -p ${scratch_path("kf_dyn_api/src")} ${scratch_path("kf_dyn_impl/src")} ${scratch_path("kf_dyn_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_dyn_api/kf.toml"), "[project]\nname = \"shape_api\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_dyn_api/src/lib.kf"), """pub trait Draw {
    fun draw(): int32
}

pub fun draw(value: &dyn Draw): int32 {
    return value.draw()
}
""")
    write_file(scratch_path("kf_dyn_impl/kf.toml"), """[project]
name = "shape_impl"
kind = "lib"

[dependencies]
shape_api = { path = "../kf_dyn_api" }
""")
    var implementation = String.from("import shape_api.*\n\nstruct Secret {\n    val amount: int32\n}\n\n")
    implementation.append("impl Draw for Secret {\n    fun draw(): int32 { return self.amount }\n}\n\n")
    implementation.append("pub struct ShapeHolder {\n    val secret: Secret\n}\n\n")
    implementation.append("""pub fun make_holder(): ShapeHolder {
    return ShapeHolder { secret: Secret { amount: 42 } }
}

""")
    implementation.append("pub fun draw_ref(holder: &ShapeHolder): &dyn Draw {\n    return holder.secret\n}\n")
    write_file(scratch_path("kf_dyn_impl/src/lib.kf"), implementation.as_str())
    write_file(scratch_path("kf_dyn_app/kf.toml"), """[project]
name = "shape_app"
kind = "bin"

[dependencies]
shape_api = { path = "../kf_dyn_api" }
shape_impl = { path = "../kf_dyn_impl" }
""")
    write_file(scratch_path("kf_dyn_app/src/main.kf"), """import shape_api.*
import shape_impl.*

fun main(): int32 {
    val holder = make_holder()
    val object = draw_ref(holder)
    if object.draw() == 42 { return 0 }
    return 1
}
""")
    return 0
}

fun dyn_archive_contains(text: str, needle: str): bool {
    val text_len = text.byte_len()
    val needle_len = needle.byte_len()
    if needle_len == 0 { return true }
    if text_len < needle_len { return false }
    var i: uint64 = 0
    while i + needle_len <= text_len {
        var matches = true
        var j: uint64 = 0
        while j < needle_len {
            if text.byte_at(i + j) != needle.byte_at(j) { matches = false }
            j = j + 1
        }
        if matches { return true }
        i = i + 1
    }
    return false
}

@test fun dyn_trait_archive_dispatches_without_dependency_sources(): void {
    val prepared = prepare_dyn_trait_archive_fixture()
    val first = build_project_separate(scratch_path("kf_dyn_app"), "")
    val hidden = unsafe { system("mv ${scratch_path("kf_dyn_api/src")} ${scratch_path("kf_dyn_api/src.hidden")} && mv ${scratch_path("kf_dyn_impl/src")} ${scratch_path("kf_dyn_impl/src.hidden")} && rm -f ${scratch_path("kf_dyn_app/target/kflat/shape_app.artifact.toml")}") }
    val rebuilt = build_project_separate(scratch_path("kf_dyn_app"), "")
    val ran = unsafe { system(scratch_path("kf_dyn_app/target/kflat/shape_app")) }
    val consumer = read_file(scratch_path("kf_dyn_app/target/kflat/shape_app.c"))
    val trait_header = read_file(scratch_path("kf_dyn_app/target/kflat/shape_api.h"))
    val implementation_header = read_file(scratch_path("kf_dyn_app/target/kflat/shape_impl.h"))
    val exported = unsafe { system("nm -g --defined-only ${scratch_path("kf_dyn_app/target/kflat/libshape_impl.a")} | grep -q ' DynVTableInstance__shape_impl__Secret__Draw$'") }
    val restored = unsafe { system("mv ${scratch_path("kf_dyn_api/src.hidden")} ${scratch_path("kf_dyn_api/src")} && mv ${scratch_path("kf_dyn_impl/src.hidden")} ${scratch_path("kf_dyn_impl/src")}") }
    val dispatch = dyn_archive_contains(consumer.as_str(), "vtable->draw(self.data)")
    val private_body = dyn_archive_contains(consumer.as_str(), "struct shape_impl__Secret {")
    val trait_layout = dyn_archive_contains(trait_header.as_str(), "struct DynVTable__Draw {")
    val external = dyn_archive_contains(implementation_header.as_str(), "extern const DynVTable__Draw DynVTableInstance__shape_impl__Secret__Draw;")
    assert_eq(prepared == 0 && first == 0 && hidden == 0 && rebuilt == 0 && ran == 0 && exported == 0 && restored == 0 && dispatch && !private_body && trait_layout && external, true, "dynamic dispatch links through archives with dependency sources absent")
}

fun prepare_generic_dyn_archive_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_dyn_gen_api")} ${scratch_path("kf_dyn_gen_dep")} ${scratch_path("kf_dyn_gen_left")} ${scratch_path("kf_dyn_gen_right")} ${scratch_path("kf_dyn_gen_app")} && mkdir -p ${scratch_path("kf_dyn_gen_api/src")} ${scratch_path("kf_dyn_gen_dep/src")} ${scratch_path("kf_dyn_gen_left/src")} ${scratch_path("kf_dyn_gen_right/src")} ${scratch_path("kf_dyn_gen_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_dyn_gen_api/kf.toml"), "[project]\nname = \"dyn_gen_api\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_dyn_gen_api/src/lib.kf"), "pub trait Describe {\n    fun describe(): int32\n}\n")
    write_file(scratch_path("kf_dyn_gen_dep/kf.toml"), """[project]
name = "dyn_gen_dep"
kind = "lib"

[dependencies]
dyn_gen_api = { path = "../kf_dyn_gen_api" }
""")
    write_file(scratch_path("kf_dyn_gen_dep/src/lib.kf"), """import dyn_gen_api.*

pub struct Wrapper<T> {
    pub val value: T
}

impl Describe for Wrapper<T> {
    fun describe(): int32 { return 21 }
}

pub fun wrap<T>(value: T): Wrapper<T> {
    return Wrapper<T> { value: value }
}
""")
    write_file(scratch_path("kf_dyn_gen_left/kf.toml"), """[project]
name = "dyn_gen_left"
kind = "lib"

[dependencies]
dyn_gen_api = { path = "../kf_dyn_gen_api" }
dyn_gen_dep = { path = "../kf_dyn_gen_dep" }
""")
    write_file(scratch_path("kf_dyn_gen_left/src/lib.kf"), """import dyn_gen_api.*
import dyn_gen_dep.*

pub fun left(): int32 {
    val wrapped = wrap<int32>(1)
    val object: &dyn Describe = wrapped
    return object.describe()
}
""")
    write_file(scratch_path("kf_dyn_gen_right/kf.toml"), """[project]
name = "dyn_gen_right"
kind = "lib"

[dependencies]
dyn_gen_api = { path = "../kf_dyn_gen_api" }
dyn_gen_dep = { path = "../kf_dyn_gen_dep" }
""")
    write_file(scratch_path("kf_dyn_gen_right/src/lib.kf"), """import dyn_gen_api.*
import dyn_gen_dep.*

pub fun right(): int32 {
    val wrapped = wrap<int32>(2)
    val object: &dyn Describe = wrapped
    return object.describe()
}
""")
    write_file(scratch_path("kf_dyn_gen_app/kf.toml"), """[project]
name = "dyn_gen_app"
kind = "bin"

[dependencies]
dyn_gen_left = { path = "../kf_dyn_gen_left" }
dyn_gen_right = { path = "../kf_dyn_gen_right" }
""")
    write_file(scratch_path("kf_dyn_gen_app/src/main.kf"), """import dyn_gen_left.*
import dyn_gen_right.*

fun main(): int32 {
    if left() + right() == 42 { return 0 }
    return 1
}
""")
    return 0
}

@test fun generic_dyn_vtables_are_consumer_local(): void {
    val prepared = prepare_generic_dyn_archive_fixture()
    val first = build_project_separate(scratch_path("kf_dyn_gen_app"), "")
    val hidden = unsafe { system("mv ${scratch_path("kf_dyn_gen_api/src")} ${scratch_path("kf_dyn_gen_api/src.hidden")} && mv ${scratch_path("kf_dyn_gen_dep/src")} ${scratch_path("kf_dyn_gen_dep/src.hidden")} && rm -f ${scratch_path("kf_dyn_gen_left/target/kflat/dyn_gen_left.artifact.toml")} ${scratch_path("kf_dyn_gen_right/target/kflat/dyn_gen_right.artifact.toml")} ${scratch_path("kf_dyn_gen_app/target/kflat/dyn_gen_app.artifact.toml")}") }
    val rebuilt = build_project_separate(scratch_path("kf_dyn_gen_app"), "")
    val ran = unsafe { system(scratch_path("kf_dyn_gen_app/target/kflat/dyn_gen_app")) }
    val left = read_file(scratch_path("kf_dyn_gen_app/target/kflat/dyn_gen_left.c"))
    val right = read_file(scratch_path("kf_dyn_gen_app/target/kflat/dyn_gen_right.c"))
    val restored = unsafe { system("mv ${scratch_path("kf_dyn_gen_api/src.hidden")} ${scratch_path("kf_dyn_gen_api/src")} && mv ${scratch_path("kf_dyn_gen_dep/src.hidden")} ${scratch_path("kf_dyn_gen_dep/src")}") }
    val left_static = dyn_archive_contains(left.as_str(), "static const DynVTable__Describe")
    val right_static = dyn_archive_contains(right.as_str(), "static const DynVTable__Describe")
    assert_eq(prepared == 0 && first == 0 && hidden == 0 && rebuilt == 0 && ran == 0 && restored == 0 && left_static && right_static, true, "two consumers rebuild non-colliding generic vtables from artifacts")
}

// A library implementing a trait it never coerces itself: the vtable must be
// emitted though no single translation unit holds both impl and coercion.
fun prepare_unused_dyn_archive_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_dyn_quiet_lib")} ${scratch_path("kf_dyn_quiet_app")} && mkdir -p ${scratch_path("kf_dyn_quiet_lib/src")} ${scratch_path("kf_dyn_quiet_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_dyn_quiet_lib/kf.toml"), "[project]\nname = \"quiet_lib\"\nkind = \"lib\"\n")
    var library = String.from("pub trait Score {\n    fun score(): int32\n}\n\n")
    library.append("pub struct Token {\n    pub val value: int32\n}\n\n")
    library.append("impl Score for Token {\n    pub fun score(): int32 { return self.value + 1 }\n}\n\n")
    library.append("pub fun token(value: int32): Token {\n    return Token { value: value }\n}\n")
    write_file(scratch_path("kf_dyn_quiet_lib/src/lib.kf"), library.as_str())
    write_file(scratch_path("kf_dyn_quiet_app/kf.toml"), """[project]
name = "quiet_app"
kind = "bin"

[dependencies]
quiet_lib = { path = "../kf_dyn_quiet_lib" }
""")
    write_file(scratch_path("kf_dyn_quiet_app/src/main.kf"), """import quiet_lib.*

fun via_vtable(s: &dyn Score): int32 {
    return s.score()
}

fun main(): int32 {
    val item = token(41)
    if via_vtable(&item) == 42 { return 0 }
    return 1
}
""")
    return 0
}

@test fun a_dependency_defines_the_vtable_it_never_coerces(): void {
    val prepared = prepare_unused_dyn_archive_fixture()
    val built = build_project_separate(scratch_path("kf_dyn_quiet_app"), "")
    val ran = unsafe { system(scratch_path("kf_dyn_quiet_app/target/kflat/quiet_app")) }
    val library = read_file(scratch_path("kf_dyn_quiet_app/target/kflat/quiet_lib.c"))
    val library_header = read_file(scratch_path("kf_dyn_quiet_app/target/kflat/quiet_lib.h"))
    val defined = dyn_archive_contains(library.as_str(), "const DynVTable__Score DynVTableInstance__quiet_lib__Token__Score = {")
    val declared = dyn_archive_contains(library_header.as_str(), "extern const DynVTable__Score DynVTableInstance__quiet_lib__Token__Score;")
    assert_eq(prepared == 0 && built == 0 && ran == 0 && defined && declared, true, "the crate that owns an impl defines its vtable whether or not it coerces one")
}

// The adapter forwards to the crate-qualified symbol the defining crate
// emits.
@test fun a_dependencys_adapter_calls_the_crate_qualified_method(): void {
    val prepared = prepare_unused_dyn_archive_fixture()
    val built = build_project_separate(scratch_path("kf_dyn_quiet_app"), "")
    val library = read_file(scratch_path("kf_dyn_quiet_app/target/kflat/quiet_lib.c"))
    val forwards = dyn_archive_contains(library.as_str(), "return quiet_lib__Token_score__Score((quiet_lib__Token *)data);")
    assert_eq(prepared == 0 && built == 0 && forwards, true, "an adapter calls the definition, not the unqualified template name")
}
