// The four `List<T>` gcc-and-run tests, disabled: `List<T>` is materialized
// by kf-mono, so emitting a bare AST never defines `List__int32`. Enabling
// them means running mono, lower and codegen. They share codegen_link_test's
// harness.

import core.assert.assert_eq
import alloc.list.*
import std.fs.scratch_path

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.*
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_codegen.emit_module

fun pt_var_ptr(name: str): Ptr<Expr> {
    var v = Expr.new(no_span(), ExprKind.Variable(intern(name)))
    v.ty = Type { kind: TypeKind.Struct(intern("Pt")), provenance: Provenance.Inferred(no_span()) }
    return expr_ptr(v)
}

fun list_of(elem: str): Ptr<TypeRef> {
    var inner = List.new<TypeRef>()
    inner.push(TypeRef.new(no_span(), TypeRefKind.Named(intern(elem), List.new<TypeRef>())))
    val lt = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), inner))
    val lp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *lp = lt }
    return lp
}

@test_disabled fun integration_list_int32_defs_compile(): void {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("xs"), list_of("int32"), false, true))
    val holder = new_top_decl(no_span(), String.from("Holder"), TopDeclKind.Struct(fields, true))
    var decls = List.new<TopDecl>()
    decls.push(holder)
    val m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_list_int32.c"), out.as_str())
    val rc = gcc_link(scratch_path("kf_codegen_link/komp_list_int32.c"), scratch_path("kf_codegen_link/komp_list_int32"), false)
    assert_eq(rc == 0, true, "List<int32> container defs gcc-compile")
}

fun ncall_e(name: str, args: List<Expr>, mangled: str): Expr {
    var e = Expr.new(no_span(), ExprKind.Call(intern(name), args))
    e.mangled_callee = intern(mangled)
    return e
}

fun mcall_e(recv: Ptr<Expr>, method: str, margs: List<Expr>, mangled: str): Expr {
    var e = Expr.new(no_span(), ExprKind.MethodCall(recv, intern(method), margs))
    e.mangled_callee = intern(mangled)
    return e
}

@test_disabled fun integration_list_int32_runs(): void {
    val xs_init = expr_ptr(ncall_e("new_list", List.new<Expr>(), "new_list__int32"))
    val let_xs = Stmt.new(no_span(), StmtKind.LetVal(intern("xs"), list_of("int32"), xs_init))

    var pa1 = List.new<Expr>()
    pa1.push(lit_i(7))
    val s_push1 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa1, "List__int32_push"))))

    var pa2 = List.new<Expr>()
    pa2.push(lit_i(35))
    val s_push2 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa2, "List__int32_push"))))

    var ga = List.new<Expr>()
    ga.push(lit_i(0))
    val get0 = expr_ptr(mcall_e(var_p("xs"), "get", ga, "List__int32_get"))
    var gb = List.new<Expr>()
    gb.push(lit_i(1))
    val get1 = expr_ptr(mcall_e(var_p("xs"), "get", gb, "List__int32_get"))
    val ret = Stmt.new(no_span(), StmtKind.Return(ret_op(expr_ptr(Expr.new(no_span(), ExprKind.Binary(get0, BinOp.Add, get1))))))

    var stmts = List.new<Stmt>()
    stmts.push(let_xs)
    stmts.push(s_push1)
    stmts.push(s_push2)
    stmts.push(ret)
    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("int32"), stmts, true, false, false, false)
    val main_td = new_top_decl(no_span(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_list_run.c"), out.as_str())
    val rc = gcc_link(scratch_path("kf_codegen_link/komp_list_run.c"), scratch_path("kf_codegen_link/komp_list_run"), false)
    assert_eq(rc == 0, true, "List<int32> program gcc-compiles")
    val run_rc = run_program(scratch_path("kf_codegen_link/komp_list_run"))
    assert_eq(run_rc == 42, true, "7 + 35 from list = 42")
}

fun lit_str_e(s: str): Expr {
    return Expr.new(no_span(), ExprKind.LitStr(String.from(s)))
}

@test_disabled fun integration_list_string_asan_clean(): void {
    // val xs: List<String> = List.new<Sym>()
    val xs_init = expr_ptr(ncall_e("new_list", List.new<Expr>(), "new_list__String"))
    val let_xs = Stmt.new(no_span(), StmtKind.LetVal(intern("xs"), list_of("String"), xs_init))

    // xs.push("alpha"); xs.push("beta")
    var pa1 = List.new<Expr>()
    pa1.push(lit_str_e("alpha"))
    val s_push1 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa1, "List__String_push"))))
    var pa2 = List.new<Expr>()
    pa2.push(lit_str_e("beta"))
    val s_push2 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa2, "List__String_push"))))

    // val s: String = xs.get(0)
    var ga = List.new<Expr>()
    ga.push(lit_i(0))
    val get0 = expr_ptr(mcall_e(var_p("xs"), "get", ga, "List__String_get"))
    val let_s = Stmt.new(no_span(), StmtKind.LetVal(intern("s"), ty_ptr("String"), get0))

    // runtime_println(s.as_str())
    var pa = List.new<Expr>()
    var print_arg = Expr.new(no_span(), ExprKind.Variable(intern("s")))
    print_arg.coerce = coerce_to_cstr()
    pa.push(print_arg)
    val pstmt = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(Expr.new(no_span(), ExprKind.Call(intern("runtime_println"), pa)))))

    // Scope-exit disposal, which Lower would insert.
    val drop_s = Stmt.new(no_span(), StmtKind.Drop(intern("s")))
    val drop_xs = Stmt.new(no_span(), StmtKind.Drop(intern("xs")))

    var stmts = List.new<Stmt>()
    stmts.push(let_xs)
    stmts.push(s_push1)
    stmts.push(s_push2)
    stmts.push(let_s)
    stmts.push(pstmt)
    stmts.push(drop_s)
    stmts.push(drop_xs)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("void"), stmts, true, false, false, false)
    val main_td = new_top_decl(no_span(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_list_string.c"), out.as_str())
    val rc = gcc_link(scratch_path("kf_codegen_link/komp_list_string.c"), scratch_path("kf_codegen_link/komp_list_string"), true)
    assert_eq(rc == 0, true, "List<String> program gcc-compiles under ASan")
    val run_rc = run_program_to_file(scratch_path("kf_codegen_link/komp_list_string"), scratch_path("kf_codegen_link/komp_list_string.out"), true)
    assert_eq(run_rc == 0, true, "List<String> run is ASan-clean (no UAF)")
    val contents = read_file(scratch_path("kf_codegen_link/komp_list_string.out"))
    assert_eq(contents.as_str(), "alpha\n", "get(0) printed the first element")
}

@test_disabled fun integration_list_user_struct_asan_clean(): void {
    // struct Pair { val s: String }
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("s"), ty_ptr("String"), false, true))
    val pair_td = new_top_decl(no_span(), String.from("Pair"), TopDeclKind.Struct(fields, true))

    // val xs: List<Pair> = List.new<Pair>()
    val xs_init = expr_ptr(ncall_e("new_list", List.new<Expr>(), "new_list__Pair"))
    val let_xs = Stmt.new(no_span(), StmtKind.LetVal(intern("xs"), list_of("Pair"), xs_init))

    // xs.push(Pair { s: "alpha" }); xs.push(Pair { s: "beta" })
    var fi1 = List.new<FieldInit>()
    fi1.push(FieldInit.new(no_span(), String.from("s"), expr_ptr(lit_str_e("alpha"))))
    var pa1 = List.new<Expr>()
    pa1.push(Expr.new(no_span(), ExprKind.StructLit(intern("Pair"), fi1)))
    val s_push1 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa1, "List__Pair_push"))))
    var fi2 = List.new<FieldInit>()
    fi2.push(FieldInit.new(no_span(), String.from("s"), expr_ptr(lit_str_e("beta"))))
    var pa2 = List.new<Expr>()
    pa2.push(Expr.new(no_span(), ExprKind.StructLit(intern("Pair"), fi2)))
    val s_push2 = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(mcall_e(var_p("xs"), "push", pa2, "List__Pair_push"))))

    // val p: Pair = xs.get(0)
    var ga = List.new<Expr>()
    ga.push(lit_i(0))
    val get0 = expr_ptr(mcall_e(var_p("xs"), "get", ga, "List__Pair_get"))
    val let_p = Stmt.new(no_span(), StmtKind.LetVal(intern("p"), ty_ptr("Pair"), get0))

    // runtime_println(p.s.as_str())
    val pv = expr_ptr(Expr.new(no_span(), ExprKind.Variable(intern("p"))))
    var pfs = Expr.new(no_span(), ExprKind.FieldAccess(pv, intern("s")))
    pfs.coerce = coerce_to_cstr()
    var pa = List.new<Expr>()
    pa.push(pfs)
    val pstmt = Stmt.new(no_span(), StmtKind.Expression(expr_ptr(Expr.new(no_span(), ExprKind.Call(intern("runtime_println"), pa)))))

    val drop_p = Stmt.new(no_span(), StmtKind.Drop(intern("p")))
    val drop_xs = Stmt.new(no_span(), StmtKind.Drop(intern("xs")))

    var stmts = List.new<Stmt>()
    stmts.push(let_xs)
    stmts.push(s_push1)
    stmts.push(s_push2)
    stmts.push(let_p)
    stmts.push(pstmt)
    stmts.push(drop_p)
    stmts.push(drop_xs)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("void"), stmts, true, false, false, false)
    val main_td = new_top_decl(no_span(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(pair_td)
    decls.push(main_td)
    val m = Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_list_pair.c"), out.as_str())
    val rc = gcc_link(scratch_path("kf_codegen_link/komp_list_pair.c"), scratch_path("kf_codegen_link/komp_list_pair"), true)
    assert_eq(rc == 0, true, "List<Pair> (struct w/ String) gcc-compiles under ASan")
    val run_rc = run_program_to_file(scratch_path("kf_codegen_link/komp_list_pair"), scratch_path("kf_codegen_link/komp_list_pair.out"), true)
    assert_eq(run_rc == 0, true, "List<Pair> run is ASan-clean (deep element retain/drop balances)")
    val contents = read_file(scratch_path("kf_codegen_link/komp_list_pair.out"))
    assert_eq(contents.as_str(), "alpha\n", "get(0).s printed the first element's field")
}
