// Incremental reuse. A marker file touched after the first build and
// `test -nt` show which artifacts a second build regenerated.

import core.assert.assert_eq
import kf_tool.build.shell_quote
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun prepare_incremental_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc7_inc_dep")} ${scratch_path("kf_sc7_inc_app")} && mkdir -p ${scratch_path("kf_sc7_inc_dep/src")} ${scratch_path("kf_sc7_inc_app/src")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_sc7_inc_dep/kf.toml"), "[project]\nname = \"inc_dep\"\nkind = \"lib\"\n")
    write_file(scratch_path("kf_sc7_inc_dep/src/lib.kf"), incremental_dep_source(40).as_str())
    write_file(scratch_path("kf_sc7_inc_app/kf.toml"), """[project]
name = "inc_app"
kind = "bin"

[dependencies]
inc_dep = { path = "../kf_sc7_inc_dep" }
""")
    write_file(scratch_path("kf_sc7_inc_app/src/main.kf"), """import inc_dep.*

fun main(): int32 {
    val p = pair_of<int32>(1, 1)
    if magic() + p.first + p.second == 42 { return 0 }
    return 1
}
""")
    return 0
}

// The private body computes `secret`; its value never reaches the
// interface, so editing it must change only the archive.
fun incremental_dep_source(secret: int32): String {
    var out = String.from("""pub struct Pair<T> {
    pub val first: T
    pub val second: T
}

pub fun pair_of<T>(a: T, b: T): Pair<T> {
    return Pair<T> { first: a, second: b }
}

pub fun magic(): int32 {
    return secret()
}

fun secret(): int32 {
    return """)
    out.append(int_text(secret).as_str())
    out.append("\n}\n")
    return out
}

fun int_text(value: int32): String {
    if value < 10 {
        return digit_text(value)
    }
    return int_text(value / 10) + digit_text(value % 10)
}

fun digit_text(value: int32): String {
    if value == 0 { return String.from("0") }
    if value == 1 { return String.from("1") }
    if value == 2 { return String.from("2") }
    if value == 3 { return String.from("3") }
    if value == 4 { return String.from("4") }
    if value == 5 { return String.from("5") }
    if value == 6 { return String.from("6") }
    if value == 7 { return String.from("7") }
    if value == 8 { return String.from("8") }
    return String.from("9")
}

fun drop_marker(): int32 {
    return unsafe { system("touch ${scratch_path("kf_sc7_inc_marker")}") }
}

fun regenerated(path: str): bool {
    val cmd = "test ${shell_quote(path).as_str()} -nt ${scratch_path("kf_sc7_inc_marker")}"
    return unsafe { system(cmd.as_str()) } == 0
}

fun inc_artifact(name: str): String {
    var out = String.from(scratch_path("kf_sc7_inc_app/target/kflat/"))
    out.append(name)
    return out
}

@test
fun noop_build_invokes_no_tool(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    var untouched = !regenerated(inc_artifact("inc_dep.o").as_str())
    untouched = untouched && !regenerated(inc_artifact("inc_app.o").as_str())
    untouched = untouched && !regenerated(inc_artifact("inc_app").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && second == 0 && untouched, true, "a no-op rebuild compiles, archives, and links nothing")
}

@test
fun private_body_change_relinks_without_recompiling_consumers(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    // 39: magic() misses 42, so the relinked binary fails.
    write_file(scratch_path("kf_sc7_inc_dep/src/lib.kf"), incremental_dep_source(39).as_str())
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    var dep_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    dep_rebuilt = dep_rebuilt && regenerated(inc_artifact("libinc_dep.a").as_str())
    val app_reused = !regenerated(inc_artifact("inc_app.o").as_str())
    val relinked = regenerated(inc_artifact("inc_app").as_str())
    val ran = unsafe { system(scratch_path("kf_sc7_inc_app/target/kflat/inc_app")) }
    var ok = prep == 0 && first == 0 && marker == 0 && second == 0
    ok = ok && dep_rebuilt && app_reused && relinked && ran != 0
    assert_eq(ok, true, "a private body change rebuilds one archive and relinks the app")
}

@test
fun public_signature_change_recompiles_dependents(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    var widened = incremental_dep_source(40)
    widened.append("\npub fun bonus(): int32 {\n    return 0\n}\n")
    write_file(scratch_path("kf_sc7_inc_dep/src/lib.kf"), widened.as_str())
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    var both_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    both_rebuilt = both_rebuilt && regenerated(inc_artifact("inc_app.o").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && second == 0 && both_rebuilt, true, "an interface change recompiles the consumer")
}

@test
fun generic_body_change_recompiles_consumers(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    // The template body lives in the interface, the instance in the consumer.
    val swapped = """pub struct Pair<T> {
    pub val first: T
    pub val second: T
}

pub fun pair_of<T>(a: T, b: T): Pair<T> {
    return Pair<T> { first: b, second: a }
}

pub fun magic(): int32 {
    return secret()
}

fun secret(): int32 {
    return 40
}
"""
    write_file(scratch_path("kf_sc7_inc_dep/src/lib.kf"), swapped)
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val app_rebuilt = regenerated(inc_artifact("inc_app.o").as_str())
    val ran = unsafe { system(scratch_path("kf_sc7_inc_app/target/kflat/inc_app")) }
    assert_eq(prep == 0 && first == 0 && marker == 0 && second == 0 && app_rebuilt && ran == 0, true, "an exported generic-body change recompiles its consumers")
}

@test
fun profile_mismatch_rejects_reuse(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "-DKF_SC7_PROFILE_PROBE")
    var all_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    all_rebuilt = all_rebuilt && regenerated(inc_artifact("inc_app.o").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && second == 0 && all_rebuilt, true, "a profile change rebuilds every artifact")
}

@test
fun corrupted_interface_rejects_reuse(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    val corrupt = unsafe { system("printf x >> ${scratch_path("kf_sc7_inc_app/target/kflat/inc_dep.kfi")}") }
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val dep_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    val app_reused = !regenerated(inc_artifact("inc_app.o").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && corrupt == 0 && second == 0 && dep_rebuilt && app_reused, true, "a corrupted interface rebuilds its crate; the restored hash spares consumers")
}

@test
fun compiler_abi_mismatch_rejects_reuse(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    val tamper = unsafe { system("sed -i 's/^compiler_abi = .*/compiler_abi = \"komp-0\"/' ${scratch_path("kf_sc7_inc_app/target/kflat/inc_dep.artifact.toml")}") }
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val dep_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && tamper == 0 && second == 0 && dep_rebuilt, true, "a compiler ABI mismatch is never reused")
}

@test
fun target_mismatch_rejects_reuse(): void {
    val prep = prepare_incremental_fixture()
    val first = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val marker = drop_marker()
    val tamper = unsafe { system("sed -i 's/^target = .*/target = \"riscv64-linux-gnu\"/' ${scratch_path("kf_sc7_inc_app/target/kflat/inc_dep.artifact.toml")}") }
    val second = build_project_separate(scratch_path("kf_sc7_inc_app"), "")
    val dep_rebuilt = regenerated(inc_artifact("inc_dep.o").as_str())
    assert_eq(prep == 0 && first == 0 && marker == 0 && tamper == 0 && second == 0 && dep_rebuilt, true, "a target mismatch is never reused")
}
