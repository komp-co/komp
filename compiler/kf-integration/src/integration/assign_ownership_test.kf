// Assignment over an owning binding must drop the old value and own the new.
// A leak or double free does not change an exit code, so these run under
// ASan.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

fun prepare_assign_fixture(name: str, src: str): int32 {
    val cmd = "rm -rf ${scratch_root()}/${name} ${scratch_root()}/${name}_libs && mkdir -p ${scratch_root()}/${name}/src && cp -r libs ${scratch_root()}/${name}_libs"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }
    // Explicit core/alloc against a copied libs tree: the test binary's
    // sysroot cannot resolve the implicit-dep path.
    var toml = String.from("[project]\nname = \"")
    toml.append(name)
    toml.append("\"\nkind = \"bin\"\n\n[dependencies]\ncore = { path = \"../")
    toml.append(name)
    toml.append("_libs/core\" }\nalloc = { path = \"../")
    toml.append(name)
    toml.append("_libs/alloc\" }\n")
    val toml_path = "${scratch_root()}/${name}/kf.toml"
    write_file(toml_path.as_str(), toml.as_str())
    val src_path = "${scratch_root()}/${name}/src/main.kf"
    write_file(src_path.as_str(), src)
    return 0
}

fun run_asan(name: str): int32 {
    val cmd = "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${scratch_root()}/${name}/target/kflat/${name}"
    return unsafe { system(cmd.as_str()) }
}

fun build_asan(name: str): int32 {
    var dir = "${scratch_root()}/"
    dir.append(name)
    return build_project_separate(dir.as_str(), "-fsanitize=address")
}

// A loop, so the leak is linear in assignments.
@test
fun assigning_over_an_owned_value_is_leak_clean(): void {
    val src = """fun main(): int32 {
    var s = String.from("alpha")
    s = String.from("beta")
    var i: uint64 = 0
    while i < 50 {
        s = String.from("0123456789")
        i = i + 1
    }
    if !s.as_str().equals("0123456789") { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_over", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_over"), 0, "project builds")
    assert_eq(run_asan("kf_assign_over"), 0, "each overwritten value is dropped exactly once")
}

// A container reassigned as a whole takes the same path as a String.
@test
fun assigning_over_an_owned_container_is_leak_clean(): void {
    val src = """import alloc.list.*

fun main(): int32 {
    var l = List.new<String>()
    l.push(String.from("x"))
    l.push(String.from("y"))
    l = List.new<String>()
    if l.size() != 0 { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_list", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_list"), 0, "project builds")
    assert_eq(run_asan("kf_assign_list"), 0, "the overwritten list and its elements are freed")
}

// `*xs.at(0)` reads an element the list owns; assigned to an owning binding
// it must not be dropped twice.
@test
fun assigning_a_container_element_does_not_double_free(): void {
    val src = """import alloc.list.*

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("alpha"))
    xs.push(String.from("beta"))
    var s = String.from("")
    s = *xs.at(0)
    if !s.as_str().equals("alpha") { return 1 }
    if !xs.at(1).as_str().equals("beta") { return 2 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_elem", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_elem"), 0, "project builds")
    assert_eq(run_asan("kf_assign_elem"), 0, "the element is owned by the list alone")
}

// An RHS that reads the binding must not see it dropped first.
@test
fun assigning_from_the_binding_itself_does_not_dangle(): void {
    val src = """fun grow(s: String): String {
    var out = s
    out.append("!")
    return out
}

fun main(): int32 {
    var s = String.from("a")
    s = grow(s)
    s = grow(s)
    if !s.as_str().equals("a!!") { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_self", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_self"), 0, "project builds")
    assert_eq(run_asan("kf_assign_self"), 0, "a self-referential RHS reads a live value")
}

// `s = s + "x"` still leaks one buffer per assignment and is not gated here.

// `h.s = ...` names a place, so the old value is aliased into a temp and
// released after the store.
@test
fun assigning_over_an_owned_field_is_leak_clean(): void {
    val src = """struct Holder { pub var s: String }

fun main(): int32 {
    var h = Holder { s: String.from("alpha") }
    var i: uint64 = 0
    while i < 50 {
        h.s = String.from("0123456789")
        i = i + 1
    }
    if !h.s.as_str().equals("0123456789") { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_field", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_field"), 0, "project builds")
    assert_eq(run_asan("kf_assign_field"), 0, "each overwritten field value is dropped exactly once")
}

// `h.s = h.s` stores the field into itself; the drop is gated on an
// `OwnedFresh` right-hand side, or the temp frees what the field holds.
@test
fun self_assigning_a_field_does_not_dangle(): void {
    val src = """struct Holder { pub var s: String }

fun main(): int32 {
    var h = Holder { s: String.from("alpha") }
    h.s = h.s
    if !h.s.as_str().equals("alpha") { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_fieldself", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_fieldself"), 0, "project builds")
    assert_eq(run_asan("kf_assign_fieldself"), 0, "a field assigned from itself keeps its buffer")
}

// A fresh RHS reading the field: the old value is dropped after the read.
@test
fun appending_to_a_field_from_itself_is_leak_clean(): void {
    val src = """struct Holder { pub var s: String }

fun main(): int32 {
    var h = Holder { s: String.from("alpha") }
    h.s = h.s + "!"
    if !h.s.as_str().equals("alpha!") { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_assign_fieldadd", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_assign_fieldadd"), 0, "project builds")
    assert_eq(run_asan("kf_assign_fieldadd"), 0, "the replaced buffer is dropped and the RHS read is live")
}

// A fresh owned value only ever borrowed in an `if` condition is owned by
// nobody; `hoist_borrowed_temps` must name it. A loop, so the leak is linear.
@test
fun a_temporary_borrowed_in_a_condition_is_leak_clean(): void {
    val src = """fun name_of(i: uint64): String {
    if i == 0 { return String.from("zero") }
    return String.from("other")
}

fun main(): int32 {
    var hits: int32 = 0
    var i: uint64 = 0
    while i < 50 {
        if name_of(i).as_str().equals("zero") { hits = hits + 1 }
        i = i + 1
    }
    if hits != 1 { return 1 }
    return 0
}
"""
    assert_eq(prepare_assign_fixture("kf_cond_temp", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_cond_temp"), 0, "project builds")
    assert_eq(run_asan("kf_cond_temp"), 0, "the condition's temporary is dropped each time round")
}

// Dropped on every exit, including a `return` from the selected branch.
@test
fun a_condition_temporary_is_dropped_on_an_early_return(): void {
    val src = """fun make_name(): String { return String.from("hello") }

fun main(): int32 {
    if make_name().as_str().equals("hello") { return 0 }
    return 1
}
"""
    assert_eq(prepare_assign_fixture("kf_cond_ret", src), 0, "fixture prepared")
    assert_eq(build_asan("kf_cond_ret"), 0, "project builds")
    assert_eq(run_asan("kf_cond_ret"), 0, "the branch that returns drops the temporary too")
}
