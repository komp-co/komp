// `pub` carries a function across a module boundary, in a crate or out of
// one, whether or not the compilation writes imports. Needs two modules, so
// not a tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_tool.build.build_project_separate
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

/// `outer.inner` holds one `pub` and one private function; `main.kf` calls
/// whichever `body` names. No import line anywhere, on purpose.
fun prepare_visibility_fixture(name: str, body: str): int32 {
    val cmd = "rm -rf ${scratch_root()}/${name} ${scratch_root()}/${name}_libs && mkdir -p ${scratch_root()}/${name}/src/outer/inner && cp -r libs ${scratch_root()}/${name}_libs"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }

    // The `core` dependency is needed: a dependency-free project rejects the
    // private call on another path.
    var toml = String.from("[package]\nname = \"")
    toml.append(name)
    toml.append("\"\nversion = \"0.1.0\"\n\n[dependencies]\ncore = { path = \"../")
    toml.append(name)
    toml.append("_libs/core\" }\nalloc = { path = \"../")
    toml.append(name)
    toml.append("_libs/alloc\" }\n")
    val toml_path = "${scratch_root()}/${name}/kf.toml"
    write_file(toml_path.as_str(), toml.as_str())

    val deep_path = "${scratch_root()}/${name}/src/outer/inner/deep.kf"
    write_file(deep_path.as_str(), """fun private_value(): int32 { return 7 }
pub fun public_value(): int32 { return 42 }
""")

    val main_path = "${scratch_root()}/${name}/src/main.kf"
    write_file(main_path.as_str(), body)
    return 0
}

fun check_fixture(name: str): int32 {
    var dir = "${scratch_root()}/"
    dir.append(name)
    return check_project(dir.as_str())
}

@test
fun a_private_function_does_not_cross_a_module_boundary(): void {
    assert_eq(prepare_visibility_fixture("kf_vis_private", "fun main(): int32 { return private_value() }\n"), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_private") != 0, true, "a non-pub function in another module is not callable")
}

@test
fun a_public_function_crosses_a_module_boundary(): void {
    assert_eq(prepare_visibility_fixture("kf_vis_public", """fun main(): int32 {
    if public_value() != 42 { return 1 }
    return 0
}
"""), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_public"), 0, "a pub function in another module is callable")
}

/// A dependency crate holding one `pub fun answer`, and an app crate that
/// calls it. `import_line` is written verbatim above `main`, so passing ""
/// produces a crate with no import anywhere.
fun prepare_dependency_fixture(name: str, import_line: str): int32 {
    val cmd = "rm -rf ${scratch_root()}/${name}_dep ${scratch_root()}/${name}_app && mkdir -p ${scratch_root()}/${name}_dep/src ${scratch_root()}/${name}_app/src"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }

    val dep_toml = "${scratch_root()}/${name}_dep/kf.toml"
    write_file(dep_toml.as_str(), "[project]\nname = \"vis_dep\"\nversion = \"0.1.0\"\nkind = \"lib\"\n")

    val dep_src = "${scratch_root()}/${name}_dep/src/lib.kf"
    write_file(dep_src.as_str(), "pub fun answer(): int32 { return 42 }\n")

    val app_toml_path = "${scratch_root()}/${name}_app/kf.toml"
    val app_toml = "[project]\nname = \"vis_app\"\nversion = \"0.1.0\"\nkind = \"bin\"\n\n[dependencies]\nvis_dep = { path = \"../${name}_dep\" }\n"
    write_file(app_toml_path.as_str(), app_toml.as_str())

    val main_path = "${scratch_root()}/${name}_app/src/main.kf"
    var main_src = String.from(import_line)
    main_src.append("fun main(): int32 { return answer() - 42 }\n")
    write_file(main_path.as_str(), main_src.as_str())
    return 0
}

fun build_app_fixture(name: str): int32 {
    val dir = "${scratch_root()}/${name}_app"
    return build_project_separate(dir.as_str(), "")
}

/// Through `build`: check_project's import table is never empty, so only
/// separate compilation reaches the import-free path.
@test
fun an_import_free_build_still_checks_visibility(): void {
    assert_eq(prepare_dependency_fixture("kf_vis_noimport", ""), 0, "fixture prepared")
    assert_eq(build_app_fixture("kf_vis_noimport") != 0, true, "a dependency call with no import anywhere does not build")
}

@test
fun an_imported_dependency_call_builds(): void {
    assert_eq(prepare_dependency_fixture("kf_vis_import", "import vis_dep.*\n\n"), 0, "fixture prepared")
    assert_eq(build_app_fixture("kf_vis_import"), 0, "the same call builds once the import is written")
}
