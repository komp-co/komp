// Dead-stripped builds keep a method reached only through a vtable: under
// `--gc-sections` the vtable is the body's only reference. A property of cc
// and ld, so it is tested on a real build.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32
extern "C" fun access(path: str, mode: int32): int32

fun prepare_dyn_strip_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_dyn_strip_core")} ${scratch_path("kf_dyn_strip_app")} && mkdir -p ${scratch_path("kf_dyn_strip_core/src")} ${scratch_path("kf_dyn_strip_core/native")} ${scratch_path("kf_dyn_strip_app/src")} && cp -R libs/core/src/. ${scratch_path("kf_dyn_strip_core/src/")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_dyn_strip_core/kf.toml"), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    val core_native = read_file("libs/core/native/core.c")
    write_file(scratch_path("kf_dyn_strip_core/native/core.c"), core_native.as_str())
    val core_hosted = read_file("libs/core/native/core_hosted.c")
    write_file(scratch_path("kf_dyn_strip_core/native/core_hosted.c"), core_hosted.as_str())
    write_file(scratch_path("kf_dyn_strip_app/kf.toml"), """[project]
name = "dyn_strip_app"
kind = "bin"

[dependencies]
core = { path = "../kf_dyn_strip_core" }
""")

    // `score` is reached only through the trait object.
    var app = String.from("trait Score {\n    fun score(): int32\n}\n\n")
    app.append("struct Token {\n    val value: int32\n}\n\n")
    app.append("impl Score for Token {\n    fun score(): int32 { return self.value + 1 }\n}\n\n")
    app.append("fun via_vtable(s: &dyn Score): int32 {\n    return s.score()\n}\n\n")
    app.append("""fun main(): int32 {
    val item = Token { value: 41 }
    if via_vtable(&item) == 42 { return 0 }
    return 1
}
""")
    write_file(scratch_path("kf_dyn_strip_app/src/main.kf"), app.as_str())
    return 0
}

@test
fun a_vtable_only_method_survives_dead_stripping(): void {
    val prepared = prepare_dyn_strip_fixture()
    val built = build_project_separate(scratch_path("kf_dyn_strip_app"), "")
    val binary = unsafe { access(scratch_path("kf_dyn_strip_app/target/kflat/dyn_strip_app"), 0) }
    // Exit 0 means `score` ran through the vtable slot.
    val ran = unsafe { system(scratch_path("kf_dyn_strip_app/target/kflat/dyn_strip_app")) }
    val ok = prepared == 0 && built == 0 && binary == 0 && ran == 0
    assert_eq(ok, true, "a method reached only through a vtable survives --gc-sections")
}
