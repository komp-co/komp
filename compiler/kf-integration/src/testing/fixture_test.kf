import core.assert.assert_eq
import std.fs.scratch_path
import kf_integration.harness.copy_tree_by_content

extern "C" fun system(cmd: str): int32

@test
fun a_symlinked_source_is_copied_by_content(): void {
    val original = scratch_path("kf_copy_original")
    val link = scratch_path("kf_copy_link")
    val destination = scratch_path("kf_copy_destination")
    val prepared = unsafe { system("rm -rf ${original} ${link} ${destination}" +
            " && mkdir -p ${original} && echo content > ${original}/file.txt" +
            " && ln -s ${original} ${link}") }
    assert_eq(prepared, 0, "a symlink to a real directory is prepared")
    assert_eq(copy_tree_by_content(link, destination), 0, "the copy succeeds")
    // `test -L` succeeds only on a symlink.
    assert_eq(unsafe { system("test -L ${destination}") } != 0, true,
        "the destination is a real directory, not another link")
    assert_eq(unsafe { system("test -f ${destination}/file.txt") }, 0, "the copy carries the source's content")
}

@test
fun writing_into_the_copy_leaves_the_original_alone(): void {
    val original = scratch_path("kf_copy_src_original")
    val link = scratch_path("kf_copy_src_link")
    val destination = scratch_path("kf_copy_src_destination")
    val prepared = unsafe { system("rm -rf ${original} ${link} ${destination}" +
            " && mkdir -p ${original} && echo original > ${original}/kf.toml" +
            " && ln -s ${original} ${link}") }
    assert_eq(prepared, 0, "a symlink to a real directory is prepared")
    assert_eq(copy_tree_by_content(link, destination), 0, "the copy succeeds")
    write_file("${destination}/kf.toml".as_str(), "rewritten\n")
    assert_eq(read_file("${original}/kf.toml".as_str()).as_str(), "original\n", "the original project is untouched")
}
