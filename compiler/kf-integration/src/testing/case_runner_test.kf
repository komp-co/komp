// The case walker, plus unit tests for the parser in case_runner.kf. Failures
// are counted and summarised, not fatal. Paths are relative to the repo root.

import alloc.list.*
import core.assert.*

import kf_shared.walk_kf_files
import kf_tool.build.build_project_separate_in
import kf_integration.integration.run
import kf_integration.harness.*

@test
fun spec_reads_run_and_deps(): void {
    val src = "//! run: exit 3\n//! deps: core, alloc\nfun main(): int32 { return 3 }\n"
    val spec = parse_case_spec("demo", src)
    assert_eq(spec.expect_exit, 3, "run: exit 3 parses as 3")
    assert_eq(spec.expect_build_fail, false, "run: does not expect a build failure")
    assert_eq(spec.deps.equals("core, alloc"), true, "deps: keeps the raw list")
    assert_eq(spec.bad_directive.equals(""), true, "known keys leave no complaint")
}

@test
fun spec_reads_build_fail(): void {
    val src = "//! build: fail\nfun main(): int32 { val x: int32 = true\nreturn x }\n"
    val spec = parse_case_spec("bad", src)
    assert_eq(spec.expect_build_fail, true, "build: fail is a negative case")
    assert_eq(spec.deps.equals(""), true, "no deps directive means no dependencies")
}

@test
fun spec_stops_at_the_first_non_directive(): void {
    // A `//!` below source is not a directive.
    val src = "//! run: exit 1\n// prose\n//! run: exit 9\n"
    val spec = parse_case_spec("stops", src)
    assert_eq(spec.expect_exit, 1, "parsing stops at the first non-directive line")
}

@test
fun spec_reads_broken(): void {
    val src = "//! run: exit 0\n//! broken: printf prototype clash\nfun main(): int32 { return 0 }\n"
    val spec = parse_case_spec("rotten", src)
    assert_eq(spec.broken.equals("printf prototype clash"), true, "broken: keeps the tracked reason")
    assert_eq(spec.expect_exit, 0, "broken: does not disturb the other directives")
}

@test
fun spec_leaves_broken_empty_by_default(): void {
    val src = "//! run: exit 0\nfun main(): int32 { return 0 }\n"
    val spec = parse_case_spec("healthy", src)
    assert_eq(spec.broken.equals(""), true, "a case is not broken unless it says so")
}

@test
fun spec_flags_an_unknown_key(): void {
    val src = "//! rn: exit 0\nfun main(): int32 { return 0 }\n"
    val spec = parse_case_spec("typo", src)
    assert_eq(spec.bad_directive.equals("rn"), true, "a typo'd key is reported, not ignored")
}

@test
fun manifest_wires_each_dep_to_libs(): void {
    val toml = case_manifest("demo", "core, alloc")
    assert_eq(toml.contains("name = \"demo\""), true, "the project takes the case name")
    assert_eq(toml.contains("core = { path = \"../../../libs/core\" }"), true, "core resolves to libs/core")
    assert_eq(toml.contains("alloc = { path = \"../../../libs/alloc\" }"), true, "alloc resolves to libs/alloc")
}

@test
fun manifest_omits_the_dependencies_table_when_there_are_none(): void {
    val toml = case_manifest("bare", "")
    assert_eq(toml.contains("[dependencies]"), false, "no deps means no [dependencies] table")
}

@test
fun case_name_strips_directory_and_suffix(): void {
    val name = case_name_from_path("tests/cases/when_scalar.kf")
    assert_eq(name.equals("when_scalar"), true, "the case name is the bare stem")
}

/// How many case builds run at once. Each is its own process, and the host's
/// other cores are otherwise idle during the walk.
fun case_jobs(): uint64 { return 2 }

/// Builds each directory in a child process, `case_jobs()` at a time, and
/// answers each build's exit status in order. The child is this binary
/// re-exec'd (`/proc/$PPID/exe` from the shell), so the suite tests the
/// compiler built from the tree; its output goes to `<dir>/build.log`.
fun build_cases_out_of_process(dirs: &List<String>): List<int32> {
    var statuses = List.new<int32>()
    var at: uint64 = 0
    while at < dirs.size() {
        var script = String.from("")
        var k: uint64 = 0
        while k < case_jobs() && at + k < dirs.size() {
            val d = dirs.at(at + k).as_str()
            script.append("( \"/proc/$PPID/exe\" --run-test case_build_worker --build-case '${d}'")
            script.append(" > '${d}/build.log' 2>&1; echo $? > '${d}/build.status' ) & ")
            k = k + 1
        }
        script.append("wait")
        var args = List.new<str>()
        args.push("-c")
        args.push(script.as_str())
        val _waited = run("/bin/sh", args)
        while j in 0..k {
            val d = dirs.at(at + j).as_str()
            runtime_println(read_file("${d}/build.log").as_str())
            val status = read_file("${d}/build.status")
            val trimmed = status.trim()
            statuses.push(if trimmed.byte_len() == 0 { 1 } else { case_parse_int32(trimmed.as_str()) })
        }
        at = at + k
    }
    return statuses
}

// The child half; a no-op without `--build-case`.
@test fun case_build_worker(): void {
    val dir = case_build_arg()
    if dir.byte_len() == 0 { return }
    if build_project_separate_in(dir, "", false, case_target_dir().as_str()) != 0 { fail("case build failed") }
}

/// Writes the case's project, or answers why it cannot be built.
fun prepare_case(path: str, spec: &CaseSpec): String {
    if spec.bad_directive.byte_len() > 0 {
        return "unknown directive `${spec.bad_directive.as_str()}`"
    }
    val dir = case_project_dir(spec.name.as_str())
    var rm_args = List.new<str>()
    rm_args.push("-rf")
    rm_args.push(dir.as_str())
    val _cleaned = run("rm", rm_args)

    var mkdir_args = List.new<str>()
    mkdir_args.push("-p")
    mkdir_args.push("${dir}/src".as_str())
    if run("mkdir", mkdir_args) != 0 {
        return String.from("could not create the case project directory")
    }
    write_file("${dir}/kf.toml".as_str(), case_manifest(spec.name.as_str(), spec.deps.as_str()).as_str())
    // The `//!` header is a plain comment to the lexer.
    write_file("${dir}/src/main.kf".as_str(), read_file(path).as_str())
    return ""
}

/// Why a built case misses its directive, or "".
fun CaseSpec.finish_case(built: int32): String {
    if self.expect_build_fail {
        if built == 0 { return String.from("expected the build to fail, but it succeeded") }
        return ""
    }
    if built != 0 { return String.from("the build failed") }
    val code = run(case_binary_path(self.name.as_str()).as_str(), List.new<str>())
    if code != self.expect_exit {
        return "expected exit ${String.of(&((self.expect_exit as int64))).as_str()}, got ${String.of(&((code as int64))).as_str()}"
    }
    return ""
}

@test
fun every_case_meets_its_directive(): void {
    var paths = List.new<String>()
    walk_kf_files("tests/cases", &var paths)
    val filter = case_filter_arg()

    var specs = List.new<CaseSpec>()
    var chosen = List.new<String>()
    var whys = List.new<String>()
    var dirs = List.new<String>()
    var slots = List.new<uint64>()
    while path in &paths {
        if !path.as_str().contains(filter) { continue }
        val name = case_name_from_path(path.as_str())
        val spec = parse_case_spec(name.as_str(), read_file(path.as_str()).as_str())
        val why = prepare_case(path.as_str(), &spec)
        if why.byte_len() == 0 {
            slots.push(dirs.size())
            dirs.push(case_project_dir(name.as_str()))
        } else {
            slots.push(18446744073709551615)
        }
        whys.push(why)
        chosen.push(path.clone())
        specs.push(spec)
    }
    val statuses = build_cases_out_of_process(&dirs)

    // Repeated at the end, since a truncated log keeps only the tail.
    var failed_lines = ""
    var failures: int32 = 0
    var broken_count: int32 = 0
    while c in 0..chosen.size() {
        val spec = specs.at(c)
        val slot = *slots.at(c)
        val why = if slot < statuses.size() {
            spec.finish_case(*statuses.at(slot))
        } else {
            whys.at(c).clone()
        }
        var line = String.from("  case ")
        line.append(chosen.at(c).as_str())
        if spec.broken.byte_len() > 0 {
            if why.byte_len() == 0 {
                // Fixed: fail until the marker is removed.
                line.append(" ... FIXED — drop the `broken` directive (")
                line.append(spec.broken.as_str())
                line.append(")")
                failures = failures + 1
                failed_lines = failed_lines + line.clone() + String.from("\n")
            } else {
                line.append(" ... broken, tracked (${spec.broken.as_str()}): ${why.as_str()}")
                broken_count = broken_count + 1
            }
        } else if why.byte_len() == 0 {
            line.append(" ... ok")
        } else {
            line.append(" ... FAILED: ${why.as_str()}")
            failures = failures + 1
            failed_lines = failed_lines + line.clone() + String.from("\n")
        }
        runtime_println(line.as_str())
    }

    val ran = chosen.size() as int64
    runtime_println("  cases: ${ran} run, ${failures as int64} failed, ${broken_count as int64} known-broken")
    if failures > 0 {
        runtime_println("  case failures:")
        runtime_println(failed_lines.as_str())
    }

    // An empty walk or a `--case` matching nothing must not pass.
    assert(paths.size() > 0, "tests/cases contains at least one case")
    assert(ran > 0, "the case filter matches at least one case")
    assert_eq(failures, 0, "every case in tests/cases meets its directive")
}
