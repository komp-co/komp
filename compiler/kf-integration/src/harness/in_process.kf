/// One source string to C, without assembly. Assumes well-typed input.
pub fun compile_source(src: str): String {
    var smap = fresh_source_map()
    val fid = unsafe { smap.add_file(new_source_file(String.from("<input>"), String.from(src))) }
    val toks = tokenize(src, fid)
    var p = new_parser(toks)
    val source_module = p.parse_module(List.new<String>())
    while diag in &p.diags {
        val text = render(diag, smap)
        runtime_println(text.as_str())
    }
    var errors = new_diagnostics()
    val libs = bundled_libs_root(".")
    val core_root = join_path(libs.as_str(), "core")
    var core_diags = new_diagnostics()
    val core_crate = assemble_crate(core_root.as_str(), String.from("core"), smap, &var core_diags)
    val alloc_root = join_path(libs.as_str(), "alloc")
    val alloc_crate = assemble_crate(alloc_root.as_str(), String.from("alloc"), smap, &var core_diags)
    var modules = core_crate.modules.clone()
    while module in &alloc_crate.modules {
        modules.push(module.clone())
    }
    modules.push(source_module)
    var merged = merge_modules(modules)
    val generated = merged.compile_module(true, &var errors, smap)
    // Both native tiers of core and alloc, named since there is no manifest;
    // always hosted.
    var native = read_file(join_path(libs.as_str(), "core/native/core.c").as_str())
    native.append("\n")
    native.append(read_file(join_path(libs.as_str(), "core/native/core_hosted.c").as_str()).as_str())
    native.append("\n")
    native.append(read_file(join_path(libs.as_str(), "alloc/native/alloc.c").as_str()).as_str())
    native.append("\n")
    native.append(read_file(join_path(libs.as_str(), "alloc/native/alloc_hosted.c").as_str()).as_str())
    return compose_unity_text(generated, native).text
}

/// One crate to per-crate C, from source, without its dependencies.
pub fun compile_crate_separate(crate_root: str, crate_name: str, is_bin: bool): String {
    val crate_name_s = String.from(crate_name)
    val smap = fresh_source_map()
    var pd = new_diagnostics()
    val c = assemble_crate(crate_root, crate_name_s, smap, &var pd)
    var merged = merge_modules(c.modules)
    var errors = new_diagnostics()
    return merged.compile_module_separate(is_bin, &var errors, smap)
}

pub fun check_project(root_dir: str): int32 {
    val graph = build_crate_graph(root_dir)
    if graph.error.as_str() != "" {
        runtime_println(graph.error.as_str())
        return 1
    }
    val smap = fresh_source_map()
    var pdiags = new_diagnostics()
    var merged = assemble_project(root_dir, smap, &var pdiags)
    val perrs = report_parse_errors(&var pdiags, smap, false)
    var cfg_diags = List.new<Diagnostic>()
    var cfg = lint_config_from_manifest(&manifest_of(root_dir), &var cfg_diags)
    cfg.apply_cli_lint_flags(&var cfg_diags)
    val cerrs = report_config_diags(&cfg_diags, smap, false)
    return perrs + cerrs + merged.check_module_leveled(smap, &cfg)
}

/// The project's crates assembled and merged into one module, the root's
/// `_test.kf` files included and the root marked as the crate under check.
pub fun assemble_project(root_dir: str, smap: Ptr<SourceMap>, pdiags: &var Diagnostics): Module {
    val crates = crate_sources(&project_crates(root_dir))
    val none = no_overlay()
    var merged = merge_module_list(assemble_crate_list(&crates, smap, &var pdiags, true, &none))
    if crates.size() > 0 { merged.crate = new_crate_id(crates.at(crates.size() - 1).name.as_str()) }
    return merged
}

/// From the `[lint]` table. A row naming an unknown lint or level is reported
/// and skipped: a misspelled suppression silently suppresses nothing.
pub fun Manifest.lint_config_from_manifest(diags: &var List<Diagnostic>): LintConfig {
    var cfg = new_lint_config()
    while i in 0..self.lint_names.size() {
        cfg.apply_table_lint("kf.toml [lint]", self.lint_names.at(i).as_str(), self.lint_levels.at(i).as_str(), diags)
    }
    return cfg
}

/// Per-crate C artifacts, dependencies first, crate-qualified. Empty on a
/// dependency cycle.
pub fun compile_project_separate(root_dir: str, errors: &var Diagnostics): List<CrateCodegenOutput> {
    val graph = build_crate_graph(root_dir)
    return graph.compile_graph_outputs(errors)
}

/// Only the root crate (last) may carry `main`.
pub fun BuildGraph.compile_graph_outputs(errors: &var Diagnostics): List<CrateCodegenOutput> {
    val interfaces: Ptr<List<String>> = unsafe { alloc<List<String>>() }
    unsafe { *interfaces = List.new<String>() }
    return self.compile_graph_outputs_with_interfaces(errors, interfaces)
}

fun BuildGraph.compile_graph_outputs_with_interfaces(errors: &var Diagnostics,
    interfaces: Ptr<List<String>>): List<CrateCodegenOutput> {
    var out = List.new<CrateCodegenOutput>()
    if self.error.as_str() != "" {
        runtime_println(self.error.as_str())
        errors.count_errors(1)
        return out
    }
    if self.cycle.as_str().byte_len() > 0 {
        var msg = String.from("error: dependency cycle: ")
        msg.append(self.cycle.as_str())
        runtime_println(msg.as_str())
        errors.count_errors(1)
        return out
    }
    val smap = fresh_source_map()
    var pdiags = new_diagnostics()
    var all_modules = List.new<Module>()
    while bc in &self.crates {
        val c = assemble_crate(bc.root.as_str(), String.from(bc.name.as_str()), smap, &var pdiags)
        while j in 0..c.modules.size() {
            all_modules.push(deep_clone_module(c.modules.at(j)))
        }
    }
    var perrs = 0
    var pi = 0
    while pi < pdiags.size() {
        val d = pdiags.at(pi)
        val text = render(d, smap)
        runtime_println(text.as_str())
        perrs = perrs + 1
        pi = pi + 1
    }
    errors.count_errors(perrs)
    var merged = merge_module_list(all_modules)
    // The root crate id marks separate mode for Mono: instances become per-TU
    // static support.
    if self.crates.size() > 0 {
        merged.crate = new_crate_id(self.crates.at(self.crates.size() - 1).name.as_str())
    }
    merged.run_interface_passes(errors, smap)
    var emitted_names = List.new<String>()
    var emitted_hashes = List.new<String>()
    while interface_crate in &self.crates {
        val dependency_hashes = dependency_interface_hashes(&interface_crate.deps, &emitted_names, &emitted_hashes)
        val closure_errors = export_closure_diagnostics(&merged, new_crate_id(interface_crate.name.as_str()))
        while closure_index in 0..closure_errors.size() {
            runtime_println(closure_errors.at(closure_index).as_str())
            errors.count_errors(1)
        }
        val encoded = emit_interface_full(&merged, String.from(interface_crate.name.as_str()), &interface_crate.deps,
            &dependency_hashes, smap)
        emitted_names.push(String.from(interface_crate.name.as_str()))
        emitted_hashes.push(content_hash(encoded.as_str()))
        unsafe { interfaces.push(encoded) }
    }
    if !merged.run_middle_passes(separate_passes(), errors, smap) { return out }
    while k in 0..self.crates.size() {
        val bc = self.crates.at(k)
        val is_root = k + 1 == self.crates.size()
        out.push(emit_crate(&merged, String.from(bc.name.as_str()), clone_string_list(&bc.deps), is_root && bc.is_bin))
    }
    return out
}

fun dependency_interface_hashes(dependencies: &List<String>, names: &List<String>,
    hashes: &List<String>): List<String> {
    var out = List.new<String>()
    while dependency in &dependencies {
        out.push(interface_hash_lookup(dependency.as_str(), names, hashes))
    }
    return out
}

fun clone_string_list(source: &List<String>): List<String> {
    var out = List.new<String>()
    while item in &source {
        out.push(item.clone())
    }
    return out
}

/// Path from the first module, or empty.
fun merge_modules(modules: &List<Module>): Module {
    var path = List.new<String>()
    if modules.size() > 0 {
        val source_path = modules.at(0)
        while item in &source_path.path {
            path.push(item.clone())
        }
    }
    var all_decls = List.new<TopDecl>()
    var all_imports = List.new<Import>()
    while m in &modules {
        while j in 0..m.decls.size() {
            all_decls.push(deep_clone_top_decl(m.decls.at(j)))
        }
        while k in 0..m.imports.size() {
            all_imports.push((m.imports.at(k)).deep_clone_import())
        }
    }
    return Module { crate: crate_id_poison(), path: path, decls: all_decls, imports: all_imports }
}

/// As the file sits on disk, in the project around it. For tests, which
/// have no komp to name the crates.
pub fun typed_crate_for(file_path: str): TypedCrate {
    return typed_crate_staged(file_path, "", false, &crate_sources(&project_crates_around(file_path)))
}

/// With `buffer` standing in for the file's text, so offsets match the
/// document the editor shows.
pub fun typed_crate_for_overlay(file_path: str, buffer: str): TypedCrate {
    return typed_crate_staged(file_path, buffer, true, &crate_sources(&project_crates_around(file_path)))
}

fun crate_sources(crates: &List<BuildCrate>): List<CrateSource> {
    var out = List.new<CrateSource>()
    while item in &crates {
        out.push(CrateSource { name: item.name.clone(), root: item.root.clone() })
    }
    return out
}
