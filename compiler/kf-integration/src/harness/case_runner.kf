// Directive-driven end-to-end cases: the spec and its parser. A case is one
// .kf under `tests/cases/`; its leading `//!` lines say what should happen,
// and the rest is the case's `main.kf`.
//
//     run: exit N    build and run it, requiring exit code N
//     build: fail    the build must fail
//     deps: a, b     libs/<a>, libs/<b> go in the manifest
//     broken: WHY    not yet meeting its directive: reported, not failed, and
//                    a failure once it passes
//
// An unknown key is recorded in `bad_directive` and fails the case. Cases
// build under `target/case_tmp/<name>/`, the depth `../../../libs/<dep>` is
// relative to.
//
// CONSTRAINT: a plain module because `CaseSpec` is declared here, and a test
// file's structs get no C type. The walker is in case_runner_test.kf.

import core.text.*

/// "" in an ordinary run. The walker re-execs the test binary with it, one
/// process per case.
pub fun case_build_arg(): str {
    return value_after("--build-case")
}

/// Read at run time, so narrowing needs no rebuild.
pub fun case_filter_arg(): str {
    return value_after("--case")
}

/// The argument after the first `flag`, or "".
fun value_after(flag: str): str {
    while i in 0..arg_count() {
        if arg_at(i) == flag { return arg_at(i + 1) }
    }
    return ""
}

/// Fields are assigned once from locals, so no String is move-assigned over.
pub struct CaseSpec {
    pub var name: String
    pub var deps: String
    pub var expect_build_fail: bool
    pub var expect_exit: int32
    pub var bad_directive: String
    /// Non-empty for `broken: <reason>`.
    pub var broken: String
}

/// Optionally signed; stops at the first non-digit.
pub fun case_parse_int32(s: str): int32 {
    val n: uint64 = s.byte_len()
    val zero: uint8 = 48 as uint8
    val nine: uint8 = 57 as uint8
    val minus: uint8 = 45 as uint8
    var i = 0
    var negative = false
    if n > 0 {
        val c0: uint8 = s.byte_at(0)
        if c0 == minus {
            negative = true
            i = 1
        }
    }
    var acc = 0
    while i < n {
        val c: uint8 = s.byte_at(i)
        if c < zero || c > nine {
            break
        }
        val digit: int32 = (c - zero) as int32
        acc = acc * 10 + digit
        i = i + 1
    }
    if negative {
        return 0 - acc
    }
    return acc
}

/// `tests/cases/when_scalar.kf` -> `when_scalar`.
pub fun case_name_from_path(path: str): String {
    val slash = path.last_index_of("/")
    val start = if slash.is_some() { slash!! + 1 } else { 0 }
    val end = if path.ends_with(".kf") { path.byte_len() - 3 } else { path.byte_len() }
    return path.substring(start, end)
}

/// Stops at the first line that is not a directive, so the header leads the
/// file.
pub fun parse_case_spec(name: str, source: str): CaseSpec {
    var deps = ""
    var bad = ""
    var broken = ""
    var expect_build_fail = false
    var expect_exit = 0
    val lines = source.lines()
    while line in &lines {
        if !line.starts_with("//!") { break }
        val body = line.slice_from(3).trim()
        val colon = body.index_of(":") ?: continue
        val key = body.substring(0, colon).trim()
        val value = body.slice_from(colon + 1).trim()
        when key {
            "deps" => deps = value.clone()
            "broken" => broken = value.clone()
            "build" => {
                if value == "fail" {
                    expect_build_fail = true
                } else {
                    bad = String.from("build")
                }
            }
            "run" => {
                if value.starts_with("exit") {
                    expect_exit = case_parse_int32(value.slice_from(4).trim().as_str())
                } else {
                    bad = String.from("run")
                }
            }
            _ => bad = key.clone()
        }
    }
    return CaseSpec {
        name: String.from(name),
        deps: deps,
        expect_build_fail: expect_build_fail,
        expect_exit: expect_exit,
        bad_directive: bad,
        broken: broken
    }
}

/// `deps` is the raw directive value; each becomes a path dependency on
/// libs/<name>.
pub fun case_manifest(name: str, deps: str): String {
    var out = "[project]\nname = \"${name}\"\nversion = \"0.1.0\"\n"
    if deps.is_empty() { return out }
    out.append("\n[dependencies]\n")
    val segments = deps.split(",")
    while seg_raw in &segments {
        val seg = seg_raw.trim()
        if !seg.is_empty() {
            out.append("${seg} = { path = \"../../../libs/${seg}\" }\n")
        }
    }
    return out
}

/// Under target/, so gitignored; repo-relative, since the suite runs at the
/// root.
pub fun case_project_dir(name: str): String {
    var out = String.from("target/case_tmp/")
    out.append(name)
    return out
}

/// One artifact directory for every case, so `core` is built once and not
/// per case. Artifacts are named per crate.
pub fun case_target_dir(): String {
    return String.from("target/case_shared/kflat")
}

pub fun case_binary_path(name: str): String {
    var out = case_target_dir()
    out.append("/")
    out.append(name)
    return out
}
