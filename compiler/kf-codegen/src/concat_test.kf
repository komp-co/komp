import core.assert.assert_eq
import alloc.list.*

import kf_codegen.*

@test fun concat_basic(): void {
    val a = String.from("foo")
    val b = String.from("bar")
    val c = concat(a, b)
    assert_eq(c.as_str(), "foobar", "concat two strings")
}

@test fun concat3_basic(): void {
    val a = String.from("one ")
    val b = String.from("two ")
    val c = String.from("three")
    val out = concat3(a, b, c)
    assert_eq(out.as_str(), "one two three", "concat3 chains correctly")
}

@test fun concat_empty_left(): void {
    val a = ""
    val b = String.from("hi")
    val c = concat(a, b)
    assert_eq(c.as_str(), "hi", "empty left")
}

@test fun concat_with_newlines(): void {
    val a = String.from("line1\n")
    val b = String.from("line2\n")
    val c = concat(a, b)
    assert_eq(c.as_str(), "line1\nline2\n", "newlines preserved")
}

@test fun concat4_chains(): void {
    val out = concat4(String.from("a"), String.from("b"), String.from("c"), String.from("d"))
    assert_eq(out.as_str(), "abcd", "concat4 chains correctly")
}

@test fun concat_all_joins_in_order(): void {
    var parts = List.new<String>()
    parts.push(String.from("one "))
    parts.push(String.from("two "))
    parts.push(String.from("three"))
    assert_eq(concat_all(parts).as_str(), "one two three", "fragments join in order")
}

@test fun concat_all_of_nothing_is_empty(): void {
    val parts = List.new<String>()
    assert_eq(concat_all(parts).as_str(), "", "no fragments, no output")
}

// Many fragments, as `concat_all` sees over a whole translation unit; the
// buffer must survive repeated growth. The cost is pinned by check.sh's
// memory budget.
@test fun concat_all_survives_repeated_growth(): void {
    var parts = List.new<String>()
    var i: uint64 = 0
    while i < 2000 {
        parts.push(String.from("0123456789"))
        i = i + 1
    }
    val out = concat_all(parts)
    assert_eq(out.byte_len(), 20000, "every fragment lands exactly once")
    assert_eq(out.as_str().byte_at(19999), 57, "and the last byte is the last fragment's")
}
