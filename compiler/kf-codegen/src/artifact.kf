// Per-crate codegen output. `emit_crate` renders one crate's C artifacts from
// a qualified, monomorphized, lowered merged module and returns them; the
// driver decides where they land. `emit_module_kind` is the unity adapter.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_codegen.emit.unit.emit_crate_header_supported
import kf_codegen.emit.unit.emit_crate_source_supported
import kf_codegen.emit.glue.collect_exported_glue_symbols
import kf_codegen.emit.glue.deep_clone_top_decl
import kf_codegen.emit.dyn_traits.collect_exported_dyn_vtable_symbols

pub struct CrateCodegenOutput {
    pub val crate_name: String
    /// `<crate>.h` — the compiled crate's C export surface.
    pub val header: String
    /// `<crate>.c` — definitions owned by this crate, and nothing else.
    pub val source: String
    /// The final link must provide exactly one kf_runtime implementation.
    pub val needs_runtime: bool
    /// Direct dependency crate names, in include order.
    pub val dep_headers: List<String>
    /// Public function and method symbols this crate's objects export.
    pub val exported_symbols: List<String>
}

pub fun Module.emit_crate(crate_name: String, deps: List<String>, is_bin: bool): CrateCodegenOutput {
    return self.emit_crate_named(crate_name.clone(), crate_name, deps, is_bin)
}

/// `crate_name` decides which declarations this TU emits; `artifact_name`
/// only names the files. They differ for `komp test`, whose
/// `<crate>_tests.c` must include `<crate>_tests.h`, not the library header.
pub fun Module.emit_crate_named(crate_name: String, artifact_name: String, deps: List<String>, is_bin: bool): CrateCodegenOutput {
    val view = self.crate_view(new_crate_id(crate_name.as_str()))
    val header = view.emit_crate_header_supported(self, artifact_name.clone(), &deps)
    val source = view.emit_crate_source_supported(self, artifact_name.clone(), is_bin)
    var symbols = view.collect_exported_symbols()
    val glue_symbols = view.collect_exported_glue_symbols()
    while glue_symbol in &glue_symbols {
        symbols.push(glue_symbol)
    }
    val vtable_symbols = view.collect_exported_dyn_vtable_symbols()
    while vtable_symbol in &vtable_symbols {
        symbols.push(vtable_symbol)
    }
    return CrateCodegenOutput {
        crate_name: crate_name,
        header: header,
        source: source,
        needs_runtime: true,
        dep_headers: deps,
        exported_symbols: symbols
    }
}

/// The declarations `crate` owns, in merged order. Generic instances belong
/// to no crate; each TU pulls the ones it uses (instance_support.kf).
pub fun Module.crate_view(crate: CrateId): Module {
    var decls = List.new<TopDecl>()
    while td in &self.decls {
        if td.crate.raw == crate.raw {
            if !td.linkage.is_template() {
                decls.push(td.deep_clone_top_decl())
            }
        }
    }
    return Module { crate: crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

pub fun Module.collect_exported_symbols(): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            Function(_p, _r, _b, is_pub, _u, _mut, _st) => {
                if is_pub && td.name.as_str() != "main" {
                    out.push(td.name.as_string())
                }
            }
            ImplBlock(methods) => {
                while mth in &methods {
                    when (mth.kind) {
                        Function(_p2, _r2, _b2, m_pub, _u2, _m2, _s2) => {
                            if m_pub {
                                out.push(td.name.as_string() + String.from("_") + mth.name.as_string())
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
    }
    return out
}
