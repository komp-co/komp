// In a separate build every TU emits static copies of the generic instances
// its code references, so any number of crates can hold copies and an
// instance around a consumer's type lands where that layout is visible.
//
// CONSTRAINT: everything comes from one reference scan, so source-loaded and
// interface-loaded builds of a consumer emit identical C.

import alloc.list.*

import kf_core.ast.CrateId
import kf_core.ast.Import
import kf_core.ast.Module
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*

import kf_codegen.emit.*
import kf_core.ast.subst.subst_type_ref
import kf_core.ast.subst.subst_stmt_list
import kf_codegen.concat_all
import kf_codegen.emit.glue.deep_clone_top_decl

pub struct InstanceSupport {
    /// Instances this TU reaches, emitted static.
    pub var instances: Module
    /// Out-of-view functions the instances call; prototypes only.
    pub var callee_fns: Module
    /// Out-of-view impls of referenced types; method prototypes only.
    pub var callee_impls: Module
    /// Referenced private out-of-view types; local layouts and glue.
    pub var private_types: Module
}

pub fun Module.collect_instance_support(m: &Module): InstanceSupport {
    var callees = NameSet.new()
    var type_refs = NameSet.new()
    while decl in &self.decls {
        decl.scan_decl_references(&var callees, &var type_refs)
    }
    // Instances closed transitively. Prototypes and private layouts come only
    // from instance bodies; self code is served by dependency headers.
    var instance_callees = NameSet.new()
    var instance_types = NameSet.new()
    var instance_names = NameSet.new()
    var progress = true
    while progress {
        progress = false
        while td in &m.decls {
            if td.linkage.is_template() {
                if instance_is_referenced(td, &callees, &type_refs) {
                    // Every declaration of the name is scanned: layout,
                    // inherent impl and trait impl.
                    if !instance_names.has(td.name.as_str()) {
                        instance_names.add(td.name.as_string())
                        progress = true
                    }
                    td.scan_decl_references(&var instance_callees, &var instance_types)
                    callees.add_all(&instance_callees)
                    type_refs.add_all(&instance_types)
                }
            }
        }
    }
    var instances = List.new<TopDecl>()
    var callee_fns = List.new<TopDecl>()
    var callee_impls = List.new<TopDecl>()
    var private_types = List.new<TopDecl>()
    val view_crate = self.crate
    while td in &m.decls {
        if td.linkage.is_template() {
            if instance_names.has(td.name.as_str()) {
                instances.push(td.deep_clone_top_decl())
            }
        } else {
            if td.crate.raw != view_crate.raw {
                classify_out_of_view(td, &instance_callees, &instance_types, &var callee_fns, &var callee_impls, &var private_types)
            }
        }
    }
    // One more round covers types named by method signatures and private
    // fields.
    m.close_over_private_fields(view_crate, &var private_types)
    return InstanceSupport {
        instances: support_module(instances, view_crate),
        callee_fns: support_module(callee_fns, view_crate),
        callee_impls: support_module(callee_impls, view_crate),
        private_types: support_module(private_types, view_crate)
    }
}

fun support_module(decls: List<TopDecl>, crate: CrateId): Module {
    return Module { crate: crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun instance_is_referenced(td: TopDecl, callees: &NameSet, type_refs: &NameSet): bool {
    when (td.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => return callees.has(td.name.as_str())
        Struct(_f, _p) => {
            if type_refs.has(td.name.as_str()) { return true }
            return callee_prefix_matches(callees, td.name.as_str())
        }
        EnumDecl(_v, _p) => {
            if type_refs.has(td.name.as_str()) { return true }
            return callee_prefix_matches(callees, td.name.as_str())
        }
        ImplBlock(_methods) => {
            if type_refs.has(td.name.as_str()) { return true }
            return callee_prefix_matches(callees, td.name.as_str())
        }
        _ => return false
    }
}

fun classify_out_of_view(td: TopDecl, callees: &NameSet, type_refs: &NameSet, callee_fns: &var List<TopDecl>, callee_impls: &var List<TopDecl>, private_types: &var List<TopDecl>): void {
    when (td.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => {
            if callees.has(td.name.as_str()) {
                callee_fns.push(td.deep_clone_top_decl())
            }
        }
        ImplBlock(methods) => {
            // Exactly the methods the instances call.
            var matched = List.new<TopDecl>()
            while method in &methods {
                val symbol = td.name.as_string() + String.from("_") + method.name.as_string()
                if callees.has(symbol.as_str()) {
                    matched.push(method.deep_clone_top_decl())
                }
            }
            if matched.size() > 0 {
                var filtered = new_top_decl(td.span, td.name.as_string(), TopDeclKind.ImplBlock(matched))
                filtered.crate = td.crate
                callee_impls.push(filtered)
            }
        }
        Struct(_f, is_pub) => {
            // Public layouts come from the dependency header.
            if !is_pub {
                if type_refs.has(td.name.as_str()) {
                    private_types.push(td.deep_clone_top_decl())
                }
            }
        }
        EnumDecl(_v, is_pub) => {
            if !is_pub {
                if type_refs.has(td.name.as_str()) {
                    private_types.push(td.deep_clone_top_decl())
                }
            }
        }
        _ => {}
    }
}

// To a fixpoint.
fun Module.close_over_private_fields(view_crate: CrateId, private_types: &var List<TopDecl>): void {
    var progress = true
    while progress {
        progress = false
        var extra = NameSet.new()
        while private_type in &private_types {
            var callees = NameSet.new()
            private_type.scan_decl_references(&var callees, &var extra)
        }
        while td in &self.decls {
            if td.crate.raw != view_crate.raw {
                if !td.linkage.is_template() {
                    if extra.has(td.name.as_str()) {
                        if !support_decl_list_has(private_types, td.name.as_str()) {
                            when (td.kind) {
                                Struct(_f, is_pub) => {
                                    if !is_pub {
                                        private_types.push(td.deep_clone_top_decl())
                                        progress = true
                                    }
                                }
                                EnumDecl(_v, is_pub) => {
                                    if !is_pub {
                                        private_types.push(td.deep_clone_top_decl())
                                        progress = true
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                }
            }
        }
    }
}

fun support_decl_list_has(decls: &List<TopDecl>, name: str): bool {
    while decl in &decls {
        if decl.name.as_str() == name { return true }
    }
    return false
}

/// Out-of-view functions and every method of referenced out-of-view impls.
/// Duplicating a header's prototype is legal C.
pub fun InstanceSupport.emit_support_protos(): String {
    var parts = List.new<String>()
    while decl in &self.callee_fns.decls {
        parts.push(emit_fn_forward(decl))
    }
    while td in &self.callee_impls.decls {
        when (td.kind) {
            ImplBlock(methods) => {
                while method in &methods {
                    if method.method_emits_code() {
                        parts.push(emit_method_forward(td.name.as_string(), method))
                    }
                }
            }
            _ => {}
        }
    }
    if parts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

/// Internal linkage throughout.
pub fun InstanceSupport.emit_instance_forwards(): String {
    var parts = List.new<String>()
    while td in &self.instances.decls {
        when (td.kind) {
            Function(_p, _r, _b, _pub, _u, _mut, _st) => {
                parts.push(String.from("static "))
                parts.push(emit_fn_forward(td))
            }
            ImplBlock(methods) => {
                while method in &methods {
                    if method.method_emits_code() {
                        parts.push(String.from("static "))
                        parts.push(emit_method_forward(td.name.as_string(), method))
                    }
                }
            }
            _ => {}
        }
    }
    if parts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

pub fun InstanceSupport.emit_instance_bodies(payloads: &ArmPayloads): String {
    var parts = List.new<String>()
    while td in &self.instances.decls {
        // Each emission gets a deep copy: emit_fn and emit_method consume and
        // rewrite their argument.
        when (td.kind) {
            Function(_p, _r, _b, _pub, _u, _mut, _st) => {
                parts.push(String.from("static "))
                parts.push(emit_fn(td.deep_copy_support_fn(), payloads))
            }
            ImplBlock(methods) => {
                while method in &methods {
                    if method.method_emits_code() {
                        parts.push(String.from("static "))
                        parts.push(emit_method(td.name.as_string(), method.deep_copy_support_fn(), payloads))
                    }
                }
            }
            _ => {}
        }
    }
    return concat_all(parts)
}

// A deep copy through the substitution walk with empty tables; every
// side-channel is preserved.
fun TopDecl.deep_copy_support_fn(): TopDecl {
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            var nparams = List.new<Param>()
            while p in &params {
                val nty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *nty = subst_type_ref(&*p.ty, &var names, &var repls) }
                nparams.push(new_param(p.span, p.name.as_string(), nty))
            }
            val nret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *nret = subst_type_ref(&*ret, &var names, &var repls) }
            val nbody = subst_stmt_list(body, &var names, &var repls)
            var nd = new_top_decl(self.span, self.name.as_string(), TopDeclKind.Function(nparams, nret, nbody, is_pub, is_unsafe, is_mutating, is_static))
            nd.crate = self.crate
            nd.linkage = self.linkage
            return nd
        }
        _ => return new_top_decl(self.span, "", TopDeclKind.Poison)
    }
}
