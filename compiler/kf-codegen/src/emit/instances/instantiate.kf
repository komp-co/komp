// The container instantiations a module uses, as mangled names
// (`List__Expr`, `Option__DeclId`), deduplicated and ordered so an element
// type precedes any container of it. Collected from written TypeRefs (fields,
// payloads, signatures, annotations) and from inferred Types.

import kf_core.ast.*

import kf_core.ast.dyn_meta.dyn_trait_identity

/// A mangled element name's C type: primitives map (`int32` -> `int32_t`);
/// everything else is its own C name.
pub fun cname_of_mangle(elem: str): String {
    when elem {
        "int8" => return String.from("int8_t")
        "int16" => return String.from("int16_t")
        "int32" => return String.from("int32_t")
        "int64" => return String.from("int64_t")
        "uint8" => return String.from("uint8_t")
        "uint16" => return String.from("uint16_t")
        "uint32" => return String.from("uint32_t")
        "uint64" => return String.from("uint64_t")
        "float32" => return String.from("float")
        "float64" => return String.from("double")
        "char" => return String.from("uint32_t")
        "str" => return String.from("const char*")
        _ => { }
    }
    // A borrow's C type is `X*`, with no release or clone, so a container of
    // borrows does not own the pointees. Mutability lives in the fragment, not
    // in C.
    val borrowed = borrow_frag_inner(elem)
    if borrowed.as_str().byte_len() > 0 {
        var out = cname_of_mangle(borrowed.as_str())
        out.append("*")
        return out
    }
    return String.from(elem)
}

/// Mirrors Mono's `ty_to_mangle`, kept local to avoid depending on kf_mono.
pub fun type_mangle(t: Type): String {
    val tk = t.kind
    when (tk) {
        Int8 => return String.from("int8")
        Int16 => return String.from("int16")
        Int32 => return String.from("int32")
        Int64 => return String.from("int64")
        UInt8 => return String.from("uint8")
        UInt16 => return String.from("uint16")
        UInt32 => return String.from("uint32")
        UInt64 => return String.from("uint64")
        Float32 => return String.from("float32")
        Float64 => return String.from("float64")
        Bool => return String.from("bool")
        Char => return String.from("char")
        StrTy => return String.from("str")
        Void => return String.from("void")
        Never => return String.from("never")
        Struct(n) => return type_identity_display(n)
        EnumTy(n) => return type_identity_display(n)
        TraitTy(n) => return type_identity_display(n)
        DynTraitTy(_) => return dyn_trait_identity(&t).as_string()
        Generic(n) => return String.from(n.as_str())
        PtrTo(p) => {
            val inner = type_mangle(unsafe { *p })
            var result = String.from("Ptr__")
            result.append(inner.as_str())
            return result
        }
        BoxOf(p) => {
            val inner = type_mangle(unsafe { *p })
            var result = String.from("Box__")
            result.append(inner.as_str())
            return result
        }
        RefTo(is_mut, p) => {
            val borrowed = unsafe { *p }
            when (borrowed.kind) {
                DynTraitTy(_) => {
                    return "Dyn__${dyn_trait_identity(&borrowed).as_string()}"
                }
                _ => { }
            }
            val inner = type_mangle(borrowed)
            return borrow_frag(is_mut, inner.as_str())
        }
        FnTy(_s) => return String.from("fn")
        Projection(owner, member) => {
            val inner = type_mangle(unsafe { *owner })
            return projection_mangle_frag(inner.as_str(), member.as_str())
        }
        Poison => return String.from("poison")
    }
}
