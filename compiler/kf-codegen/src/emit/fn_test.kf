import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

import kf_codegen.emit.*
import kf_codegen.emit.stmt.no_arm_payloads

fun fn_ty_ptr(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(no_span(), TypeRefKind.Named(intern(s), List.new<TypeRef>())) }
    return rp
}

fun mk_fn_no_params(name: str, ret: str): TopDecl {
    val fkind = TopDeclKind.Function(List.new<Param>(), fn_ty_ptr(ret), List.new<Stmt>(), true, false, false, false)
    return new_top_decl(no_span(), String.from(name), fkind)
}

@test fun proto_void_no_params(): void {
    val td = mk_fn_no_params("foo", "void")
    val out = emit_fn_proto(td)
    assert_eq(out.as_str(), "void foo(void)", "void foo(void)")
}

@test fun forward_decl_ends_with_semicolon(): void {
    val td = mk_fn_no_params("bar", "int32")
    val out = emit_fn_forward(td)
    assert_eq(out.as_str(), "int32_t bar(void);\n", "forward decl")
}

@test fun main_uses_platform_signature(): void {
    val td = mk_fn_no_params("main", "int32")
    val out = emit_fn(td, &no_arm_payloads())
    val have = out.as_str().contains("int main(int argc, char** argv)")
    assert_eq(have, true, "main uses platform sig")
}

@test fun main_initializes_the_shared_runtime(): void {
    val td = mk_fn_no_params("main", "int32")
    val out = emit_fn(td, &no_arm_payloads())
    val have = out.as_str().contains("kf_arg_init(argc, argv)")
    assert_eq(have, true, "main initializes runtime arguments")
}

@test fun non_main_uses_lowered_sig(): void {
    val td = mk_fn_no_params("greet", "void")
    val out = emit_fn(td, &no_arm_payloads())
    val have = out.as_str().contains("void greet(void) {")
    assert_eq(have, true, "non-main keeps lowered sig")
}

// An associated-type binding emits no C.

@test fun a_method_emits_code(): void {
    val td = new_top_decl(no_span(), String.from("get"), TopDeclKind.Function(List.new<Param>(), fn_ty_ptr("int32"), List.new<Stmt>(), true, false, false, false))
    assert_eq(td.method_emits_code(), true, "a method is emitted")
}

@test fun an_assoc_type_binding_emits_nothing(): void {
    val td = new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocTypeBinding(fn_ty_ptr("int32")))
    assert_eq(td.method_emits_code(), false, "a binding has no runtime form")
}

// A trait's associated-type declaration emits nothing either.
@test fun an_assoc_type_declaration_emits_nothing(): void {
    val td = new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocType(List.new<TypeRef>()))
    assert_eq(td.method_emits_code(), false, "a declaration has no runtime form")
}
