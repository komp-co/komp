// An enum's tag enum, its C body, and its drop, clone and retain functions.

import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all
import kf_codegen.concat
import kf_codegen.emit.*


pub fun Module.emit_enum_tags(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            EnumDecl(variants, _p) => {
                if !td.linkage.is_template() { parts.push(emit_enum_tag(td.name.as_string(), variants)) }
            }
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_enum_tag(name: String, variants: List<Variant>): String {
    var parts = List.new<String>()
    // An enum with no variants is uninhabited; C has no empty enum, so the tag
    // gets some nameable type. The field stays for `<E>_drop` to switch on.
    if variants.size() == 0 {
        return "typedef int ${enum_tag_type(name.as_str())};\n\n"
    }
    parts.push(String.from("typedef enum "))
    parts.push(enum_tag_type(name.as_str()))
    parts.push(String.from(" {\n"))
    while i in 0..variants.size() {
        val v = *variants.at(i)
        parts.push(String.from("    "))
        parts.push(enum_tag_const(name.as_str(), v.name.as_str()))
        if i + 1 < variants.size() { parts.push(String.from(",")) }
        parts.push(String.from("\n"))
    }
    parts.push(String.from("} "))
    parts.push(enum_tag_type(name.as_str()))
    parts.push(String.from(";\n\n"))
    return concat_all(parts)
}

fun emit_enum_body(name: String, variants: List<Variant>): String {
    var parts = List.new<String>()
    val tag_type = enum_tag_type(name.as_str())
    // Nor an empty union; a switch with no cases is valid.
    if variants.size() == 0 {
        return "typedef struct ${name} {\n    ${tag_type} tag;\n} ${name};\n\n"
    }
    parts.push("typedef struct ${name} {\n    ${tag_type} tag;\n    union {\n")
    while v in &variants {
        parts.push(String.from("        struct {\n"))
        if v.payloads.size() == 0 {
            parts.push(String.from("            char __unused;\n"))
        } else {
            while j in 0..v.payloads.size() {
                val pt = *v.payloads.at(j)
                val jstr = "${j}"
                parts.push("            ${pt.c_value_type()} _${jstr};\n")
            }
        }
        parts.push("        } V_${v.name.as_string()};\n")
    }
    parts.push("    } u;\n} ${name};\n\n")
    return concat_all(parts)
}

pub fun Module.emit_enum_drops(lookup: &Module): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            EnumDecl(variants, _p) => parts.push(emit_enum_drop(td.name.as_string(), variants, lookup))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_enum_drop(name: String, variants: List<Variant>, m: &Module): String {
    var parts = List.new<String>()
    parts.push("static inline void ${name}__glue_drop(${name} v) {\n")
    if type_has_user_drop(name, m) {
        parts.push("    ${name}_drop(&v);\n")
    }
    parts.push(String.from("    switch (v.tag) {\n"))
    while v in &variants {
        parts.push("        case ${enum_tag_const(name.as_str(), v.name.as_str())}:\n")
        var j = 0
        while j < v.payloads.size() {
            val pt = *v.payloads.at(j)
            val jstr = "${j}"
            val lval = "v.u.V_${v.name.as_string()}._${jstr}"
            if is_box_tref(pt) {
                // A Box payload: drop the pointee, then free the box.
                val inner = box_inner_tref(pt)
                val inner_drop = release_fn_for_ctype(inner.c_type().as_str())
                parts.push("            if (${lval}) { ")
                if inner_drop.as_str().byte_len() > 0 {
                    parts.push("${inner_drop}((*${lval})); ")
                }
                parts.push("kf_free(${lval}); }\n")
            } else {
                // A Box one level down (`Opt(Box<T>?)`) is dropped on the shallow
                // walk too.
                val needs = ty_needs_drop_deep(pt, m) || tref_wraps_box(pt)
                if needs {
                    val drop_fn = release_fn_for_ctype(pt.c_type().as_str())
                    parts.push("            ${drop_fn}(${lval});\n")
                }
            }
            j = j + 1
        }
        parts.push(String.from("            break;\n"))
    }
    parts.push(String.from("    }\n}\n\n"))
    return concat_all(parts)
}

// Deep retain, so containers can retain an enum element through
// `<Enum>_retain`.
pub fun Module.emit_enum_retains(lookup: &Module): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            EnumDecl(variants, _p) => parts.push(emit_enum_retain(td.name.as_string(), variants, lookup))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_enum_retain(name: String, variants: List<Variant>, m: &Module): String {
    var parts = List.new<String>()
    parts.push(String.from("static inline "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(type_retain_fn(name.as_str()))
    parts.push(String.from("("))
    parts.push(name.clone())
    parts.push(String.from(" v) {\n    switch (v.tag) {\n"))
    while v in &variants {
        parts.push(String.from("        case "))
        parts.push(enum_tag_const(name.as_str(), v.name.as_str()))
        parts.push(String.from(":\n"))
        var j = 0
        while j < v.payloads.size() {
            val pt = *v.payloads.at(j)
            val needs = ty_needs_drop_deep(pt, m)
            if needs {
                val jstr = "${j}"
                val ct = pt.c_type()
                parts.push(String.from("            v.u.V_"))
                parts.push(v.name.as_string())
                parts.push(String.from("._"))
                parts.push(jstr.clone())
                parts.push(String.from(" = "))
                parts.push(type_retain_fn(ct.as_str()))
                parts.push(String.from("(v.u.V_"))
                parts.push(v.name.as_string())
                parts.push(String.from("._"))
                parts.push(jstr)
                parts.push(String.from(");\n"))
            }
            j = j + 1
        }
        parts.push(String.from("            break;\n"))
    }
    parts.push(String.from("    }\n    return v;\n}\n\n"))
    return concat_all(parts)
}

// Deep clone: each payload gets its own copy; a Box payload a fresh
// allocation holding a clone of the pointee.
pub fun Module.emit_enum_clones(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            EnumDecl(variants, _p) => parts.push(emit_enum_clone(td.name.as_string(), variants, self))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_enum_clone(name: String, variants: List<Variant>, m: &Module): String {
    var parts = List.new<String>()
    parts.push(String.from("static inline "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(name.clone())
    parts.push(String.from("__glue_clone("))
    parts.push(name.clone())
    parts.push(String.from(" v) {\n    switch (v.tag) {\n"))
    while v in &variants {
        parts.push(String.from("        case "))
        parts.push(enum_tag_const(name.as_str(), v.name.as_str()))
        parts.push(String.from(":\n"))
        var j = 0
        while j < v.payloads.size() {
            val pt = *v.payloads.at(j)
            val jstr = "${j}"
            // lval = v.u.V_<variant>._<j>
            var lval = String.from("v.u.V_")
            lval = concat(lval, v.name.as_string())
            lval = concat(lval, String.from("._"))
            lval = concat(lval, jstr)
            if is_box_tref(pt) {
                val inner = box_inner_tref(pt)
                val inner_ct = inner.c_type()
                val inner_clone = clone_fn_for_ctype(inner_ct.as_str())
                parts.push(String.from("            if ("))
                parts.push(lval.clone())
                parts.push(String.from(") { "))
                parts.push(inner_ct.clone())
                parts.push(String.from("* __c = ("))
                parts.push(inner_ct.clone())
                parts.push(String.from("*)kf_alloc(sizeof("))
                parts.push(inner_ct.clone())
                parts.push(String.from(")); *__c = "))
                if inner_clone.as_str().byte_len() > 0 {
                    parts.push(inner_clone.clone())
                    parts.push(String.from("(*"))
                    parts.push(lval.clone())
                    parts.push(String.from(")"))
                } else {
                    parts.push(String.from("*"))
                    parts.push(lval.clone())
                }
                parts.push(String.from("; "))
                parts.push(lval.clone())
                parts.push(String.from(" = __c; }\n"))
            } else {
                val cf = clone_fn_for_ctype(pt.c_type().as_str())
                if cf.as_str().byte_len() > 0 {
                    parts.push(String.from("            "))
                    parts.push(lval.clone())
                    parts.push(String.from(" = "))
                    parts.push(cf.clone())
                    parts.push(String.from("("))
                    parts.push(lval.clone())
                    parts.push(String.from(");\n"))
                }
            }
            j = j + 1
        }
        parts.push(String.from("            break;\n"))
    }
    parts.push(String.from("    }\n    return v;\n}\n\n"))
    // The default by-pointer `<E>_clone`, which a `T: Clone` bound calls.
    // Skipped when the enum writes its own `clone`.
    if !type_has_user_clone(name.clone(), m) {
        parts.push("static inline ${name} ${name}_clone(${name}* __self) { return ${name}__glue_clone(*__self); }\n\n")
    }
    return concat_all(parts)
}
