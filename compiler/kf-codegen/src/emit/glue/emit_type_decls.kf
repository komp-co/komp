// C declarations for user types: forward declarations, bodies, and the glue
// prototypes. A struct held by value must be complete where it is used, so
// bodies are emitted in dependency order; cycles go through `Ptr<T>`.

import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all
import kf_codegen.emit.mangle_named
import kf_codegen.emit.type_has_user_drop
import kf_codegen.emit.type_has_user_clone

pub fun Module.emit_type_forward_decls(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(_f, _p) => parts.push(forward_decl(td.name.as_string()))
            EnumDecl(_v, _p) => parts.push(forward_decl(td.name.as_string()))
            _ => {}
        }
    }
    if parts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

fun forward_decl(name: String): String {
    var parts = List.new<String>()
    parts.push(String.from("typedef struct "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(name.clone())
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

// Struct and enum bodies interleaved in dependency order, by DFS post-order
// over by-value edges. Pointer and reference fields add no edge.
pub fun Module.emit_type_bodies_ordered(): String {
    var visited = List.new<String>()
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(_f, _p) => visit_type_body(td.name.as_string(), self, &var visited, &var parts)
            EnumDecl(_v, _p) => visit_type_body(td.name.as_string(), self, &var visited, &var parts)
            _ => {}
        }
    }
    return concat_all(parts)
}

fun visit_type_body(name: String, m: &Module, visited: &var List<String>, parts: &var List<String>): void {
    if list_contains_str(visited, name) { return }
    visited.push(name.clone())
    val deps = by_value_type_deps(name, m)
    while dep in &deps {
        visit_type_body(dep, m, visited, parts)
    }
    parts.push(emit_type_body_for(name, m))
}

fun list_contains_str(xs: &List<String>, name: String): bool {
    while item in &xs {
        if item.as_str().equals(name.as_str()) { return true }
    }
    return false
}

pub fun by_value_type_deps(name: String, m: &Module): List<String> {
    var deps = List.new<String>()
    val decls = m.decls
    while td in &decls {
        val match = td.name.as_str().equals(name.as_str())
        if match {
            val k = td.kind
            when (k) {
                Struct(fields, _p) => {
                    while f in &fields {
                        val ftyp = f.ty
                        add_byval_dep(&var deps, unsafe { *ftyp }, m)
                    }
                }
                EnumDecl(variants, _p) => {
                    while v in &variants {
                        while payload in &v.payloads {
                            add_byval_dep(&var deps, payload, m)
                        }
                    }
                }
                _ => {}
            }
        }
    }
    return deps
}

// A by-value field adds an edge to the user type it names, or to a generic
// instance's mangled name (`List__Label`). `Ptr<T>`/`Box<T>` mangle to no
// user decl and add none.
fun add_byval_dep(deps: &var List<String>, tr: TypeRef, m: &Module): void {
    when (tr.kind) {
        Named(n, args) => {
            if args.size() == 0 {
                if is_user_type_name(n.as_string(), m) { deps.push(n.as_string()) }
            } else {
                val mangled = mangle_named(n.as_string(), args)
                if is_user_type_name(mangled, m) { deps.push(mangled) }
            }
        }
        _ => {}
    }
}

fun is_user_type_name(name: String, m: &Module): bool {
    val decls = m.decls
    while td in &decls {
        val match = td.name.as_str().equals(name.as_str())
        if match {
            val k = td.kind
            when (k) {
                Struct(_f, _p) => return true
                EnumDecl(_v, _p) => return true
                _ => {}
            }
        }
    }
    return false
}

fun emit_type_body_for(name: String, m: &Module): String {
    val decls = m.decls
    while td in &decls {
        val match = td.name.as_str().equals(name.as_str())
        if match {
            val k = td.kind
            when (k) {
                Struct(fields, _p) => {
                    val body = emit_struct_body(td.name.as_string(), fields)
                    if td.linkage.is_template() { return guard_generic_layout(td.name.as_string(), body) }
                    return body
                }
                EnumDecl(variants, _p) => {
                    val body = emit_enum_body(td.name.as_string(), variants)
                    if td.linkage.is_template() {
                        val tag = emit_enum_tag(td.name.as_string(), variants)
                        return guard_generic_layout(td.name.as_string(), tag + body)
                    }
                    return body
                }
                _ => {}
            }
        }
    }
    return ""
}

fun guard_generic_layout(name: String, body: String): String {
    var out = "#ifndef KF_GENERIC_LAYOUT_${name}\n#define KF_GENERIC_LAYOUT_${name}\n"
    out.append(body.as_str())
    out.append("#endif\n")
    return out
}

// Prototypes for every user type's retain and drop, after the bodies and
// before any definition, so definitions can reference each other in any
// order.
pub fun Module.emit_type_op_protos(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(_f, _p) => {
                parts.push(op_protos_for(td.name.as_string()))
                if type_has_user_drop(td.name.as_string(), self) { parts.push(user_drop_proto(td.name.as_string())) }
                if type_has_user_clone(td.name.as_string(), self) { parts.push(user_clone_proto(td.name.as_string())) }
            }
            EnumDecl(_v, _p) => {
                parts.push(op_protos_for(td.name.as_string()))
                if type_has_user_drop(td.name.as_string(), self) { parts.push(user_drop_proto(td.name.as_string())) }
            }
            _ => {}
        }
    }
    if parts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

// `void <T>_drop(<T>* __self);`, which `<T>__glue_drop` calls.
fun user_drop_proto(name: String): String {
    var parts = List.new<String>()
    parts.push(String.from("void "))
    parts.push(name.clone())
    parts.push(String.from("_drop("))
    parts.push(name.clone())
    parts.push(String.from("* __self);\n"))
    return concat_all(parts)
}

// `<T> <T>_clone(<T>* __self);`, which `<T>__glue_clone` calls.
fun user_clone_proto(name: String): String {
    var parts = List.new<String>()
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(name.clone())
    parts.push(String.from("_clone("))
    parts.push(name.clone())
    parts.push(String.from("* __self);\n"))
    return concat_all(parts)
}

fun op_protos_for(name: String): String {
    var parts = List.new<String>()
    parts.push(String.from("static inline "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(type_retain_fn(name.as_str()))
    parts.push(String.from("("))
    parts.push(name.clone())
    parts.push(String.from(" v);\n"))
    parts.push(String.from("static inline void "))
    parts.push(name.clone())
    parts.push(String.from("__glue_drop("))
    parts.push(name.clone())
    parts.push(String.from(" v);\n"))
    parts.push(String.from("static inline "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(name.clone())
    parts.push(String.from("__glue_clone("))
    parts.push(name.clone())
    parts.push(String.from(" v);\n"))
    return concat_all(parts)
}

// Every user type a field or payload names, through pointers and generic
// arguments too. Unlike `by_value_type_deps`, a header must declare a type
// even when only a pointer to it is stored.
pub fun named_type_deps(name: String, m: &Module): List<String> {
    var deps = List.new<String>()
    val decls = m.decls
    while td in &decls {
        val match = td.name.as_str().equals(name.as_str())
        if match {
            val k = td.kind
            when (k) {
                Struct(fields, _p) => {
                    while f in &fields {
                        val ftyp = f.ty
                        add_named_dep(&var deps, unsafe { *ftyp }, m)
                    }
                }
                EnumDecl(variants, _p) => {
                    while v in &variants {
                        while payload in &v.payloads {
                            add_named_dep(&var deps, payload, m)
                        }
                    }
                }
                _ => {}
            }
        }
    }
    return deps
}

// Arguments first, so an inner layout is declared before what points at it.
fun add_named_dep(deps: &var List<String>, tr: TypeRef, m: &Module): void {
    when (tr.kind) {
        Named(n, args) => {
            while arg in &args {
                add_named_dep(deps, arg, m)
            }
            if args.size() == 0 {
                if is_user_type_name(n.as_string(), m) { deps.push(n.as_string()) }
            } else {
                val mangled = mangle_named(n.as_string(), args)
                if is_user_type_name(mangled, m) { deps.push(mangled) }
            }
        }
        Reference(_mut, inner) => add_named_dep(deps, unsafe { *inner }, m)
        _ => {}
    }
}
