// A struct's C body and its __new, drop, clone and retain functions: one walk
// of the field list, which must agree on which fields own their contents.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.c_field_name
import kf_core.ast.type_retain_fn
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.Field

import kf_codegen.concat_all
import kf_codegen.emit.*
import kf_core.ast.c_local_name

fun emit_struct_body(name: String, fields: List<Field>): String {
    var parts = List.new<String>()
    parts.push(String.from("typedef struct "))
    parts.push(name.clone())
    parts.push(String.from(" {\n"))
    while f in &fields {
        val fname = c_field_name(f.name.as_str())
        val slot = f.glue_slot()
        parts.push(String.from("    "))
        parts.push(slot.ty.c_type())
        parts.push(String.from(" "))
        parts.push(fname)
        parts.push(slot.extent)
        parts.push(String.from(";\n"))
    }
    parts.push(String.from("} "))
    parts.push(name.clone())
    parts.push(String.from(";\n\n"))
    return concat_all(parts)
}

pub fun Module.emit_struct_news(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(fields, _p) => parts.push(emit_struct_new(td.name.as_string(), fields))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_struct_new(name: String, fields: List<Field>): String {
    var parts = List.new<String>()
    parts.push("static inline ${name} __${name}_new(")
    var first = true
    while f in &fields {
        // An array's storage is no parameter: C passes no array by value.
        if f.is_array_storage() { continue }
        if !first { parts.push(String.from(", ")) }
        first = false
        val fty = unsafe { *(f.ty) }
        parts.push("${fty.c_value_type()} ${c_local_name(f.name.as_str())}")
    }
    // Zeroed elements, so a drop before the first store frees nothing.
    val zeroed = if fields.any_array_storage() { " = {0}" } else { "" }
    parts.push(") {\n    ${name} v${zeroed};\n")
    while field in &fields {
        if field.is_array_storage() { continue }
        val fsrc = field.name.as_string()
        val fname = c_field_name(fsrc.as_str())
        parts.push("    v.${fname} = ${c_local_name(fsrc.as_str())};\n")
    }
    parts.push(String.from("    return v;\n}\n\n"))
    return concat_all(parts)
}

pub fun Module.emit_struct_drops(lookup: &Module): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(fields, _p) => parts.push(emit_struct_drop(td.name.as_string(), fields, lookup))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_struct_drop(name: String, fields: List<Field>, m: &Module): String {
    var parts = List.new<String>()
    parts.push("static inline void ${name}__glue_drop(${name} v) {\n")
    if type_has_user_drop(name, m) {
        parts.push("    ${name}_drop(&v);\n")
    }
    while f in &fields {
        val ftyp = f.ty
        val fty = unsafe { *ftyp }
        if is_box_tref(fty) {
            // A Box field: drop the pointee if it has a drop, then free the box.
            val inner = box_inner_tref(fty)
            val inner_drop = release_fn_for_ctype(inner.c_type().as_str())
            val fname = c_field_name(f.name.as_str())
            parts.push("    if (v.${fname}) { ")
            if inner_drop.as_str().byte_len() > 0 {
                parts.push("${inner_drop}((*v.${fname})); ")
            }
            parts.push("kf_free(v.${fname}); }\n")
        } else {
            val slot = f.glue_slot()
            if ty_needs_drop_deep(slot.ty, m) {
                val drop_fn = release_fn_for_ctype(slot.ty.c_type().as_str())
                val fname = c_field_name(f.name.as_str())
                parts.push("    ${slot.open}${drop_fn}(v.${fname}${slot.index});${slot.close}\n")
            }
        }
    }
    parts.push(String.from("    (void)v;\n}\n\n"))
    return concat_all(parts)
}

pub fun Module.emit_struct_clones(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(fields, _p) => parts.push(emit_struct_clone(td.name.as_string(), fields, self))
            _ => {}
        }
    }
    return concat_all(parts)
}

// Deep copy: bit-copy, then replace each owned field with its own copy.
fun emit_struct_clone(name: String, fields: List<Field>, m: &Module): String {
    var parts = List.new<String>()
    parts.push("static inline ${name} ${name}__glue_clone(${name} v) {\n    ")
    if type_has_user_clone(name, m) {
        parts.push("return ${name}_clone(&v);\n}\n\n")
        return concat_all(parts)
    }
    parts.push("${name} r = v;\n")
    while f in &fields {
        val ftyp = f.ty
        val fty = unsafe { *ftyp }
        if is_box_tref(fty) {
            val inner = box_inner_tref(fty)
            val inner_ct = inner.c_type()
            val inner_clone = clone_fn_for_ctype(inner_ct.as_str())
            val fname = c_field_name(f.name.as_str())
            parts.push("    if (v.${fname}) { r.${fname} = (${inner_ct}*)kf_alloc(sizeof(${inner_ct})); *r.${fname} = ")
            if inner_clone.as_str().byte_len() > 0 {
                parts.push("${inner_clone}(*v.${fname})")
            } else {
                parts.push("*v.${fname}")
            }
            parts.push(String.from("; }\n"))
        } else {
            val slot = f.glue_slot()
            val cf = clone_fn_for_ctype(slot.ty.c_type().as_str())
            if cf.as_str().byte_len() > 0 {
                val fname = c_field_name(f.name.as_str())
                parts.push("    ${slot.open}r.${fname}${slot.index} = ${cf}(v.${fname}${slot.index});${slot.close}\n")
            }
        }
    }
    parts.push(String.from("    return r;\n}\n\n"))
    // The default by-pointer `<T>_clone`, forwarding to the by-value glue.
    parts.push("static inline ${name} ${name}_clone(${name}* __self) { return ${name}__glue_clone(*__self); }\n\n")
    return concat_all(parts)
}

pub fun is_box_tref(fty: TypeRef): bool {
    when (fty.kind) {
        Named(n, args) => {
            if !n.as_str().equals("Box") { return false }
            return args.size() == 1
        }
        _ => return false
    }
}

/// A Box anywhere in a type argument (`Option<Box<T>>`) owns heap at any
/// glue depth.
pub fun tref_wraps_box(t: TypeRef): bool {
    when (t.kind) {
        Named(_n, args) => {
            while a in &args {
                if is_box_tref(a) { return true }
                if tref_wraps_box(a) { return true }
            }
            return false
        }
        _ => return false
    }
}

// `Inner` of `Box<Inner>`, or a poison TypeRef.
fun box_inner_tref(fty: TypeRef): TypeRef {
    when (fty.kind) {
        Named(n, args) => {
            if n.as_str().equals("Box") {
                if args.size() == 1 { return *args.at(0) }
            }
            return TypeRef.new(fty.span, TypeRefKind.Poison)
        }
        _ => return TypeRef.new(fty.span, TypeRefKind.Poison)
    }
}

pub fun Module.emit_struct_retains(lookup: &Module): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            Struct(fields, _p) => parts.push(emit_struct_retain(td.name.as_string(), fields, lookup))
            _ => {}
        }
    }
    return concat_all(parts)
}

fun emit_struct_retain(name: String, fields: List<Field>, m: &Module): String {
    var parts = List.new<String>()
    parts.push(String.from("static inline "))
    parts.push(name.clone())
    parts.push(String.from(" "))
    parts.push(type_retain_fn(name.as_str()))
    parts.push(String.from("("))
    parts.push(name.clone())
    parts.push(String.from(" v) {\n"))
    // A user-written `clone` is used as is.
    if type_has_user_clone(name.clone(), m) {
        parts.push(String.from("    return "))
        parts.push(name.clone())
        parts.push(String.from("__glue_clone(v);\n}\n\n"))
        return concat_all(parts)
    }
    while f in &fields {
        val slot = f.glue_slot()
        if ty_needs_drop_deep(slot.ty, m) {
            val place = "v.${c_field_name(f.name.as_str())}${slot.index}"
            val retain = type_retain_fn(slot.ty.c_type().as_str())
            parts.push("    ${slot.open}${place} = ${retain}(${place});${slot.close}\n")
        }
    }
    parts.push(String.from("    return v;\n}\n\n"))
    return concat_all(parts)
}

/// Where a field's glue reaches: the field itself, or, for an array's
/// storage, each element inside a loop over the length.
struct GlueSlot {
    /// The type the glue is for: the field's, or the element's.
    val ty: TypeRef
    /// `[N]` after the field's name in the struct body.
    val extent: String
    val open: String
    val index: String
    val close: String
}

fun Field.glue_slot(): GlueSlot {
    val fty = (*self.ty).clone()
    when (fty.kind) {
        Array(element, length) => {
            return GlueSlot {
                ty: (*element).clone(), extent: "[${length}]",
                open: "for (uint64_t i = 0; i < ${length}; i++) { ", index: "[i]", close: " }"
            }
        }
        _ => return GlueSlot { ty: fty, extent: "", open: "", index: "", close: "" }
    }
}

fun Field.is_array_storage(): bool {
    return when (self.ty.kind) {
        Array(_element, _length) => true
        _ => false
    }
}

fun List<Field>.any_array_storage(): bool {
    while f in &self {
        if f.is_array_storage() { return true }
    }
    return false
}
