import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.Field
import kf_core.ast.declaration.new_field

fun named_ref(name: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun storage_field(element: str, length: uint64): Field {
    val storage = TypeRef.new(no_span(), TypeRefKind.Array(Box.new(named_ref(element)), length))
    return new_field(no_span(), String.from("items"), Box.new(storage), true, false)
}

@test
fun array_storage_is_laid_out_inline(): void {
    var fields = List.new<Field>()
    fields.push(storage_field("int32", 3))
    val body = emit_struct_body(String.from("Array__int32__3"), fields)
    assert_eq(body.contains("int32_t items[3];"), true, "`T items[N]`, not a pointer")
}

@test
fun array_glue_runs_once_per_element(): void {
    val slot = storage_field("String", 2).glue_slot()
    assert_eq(slot.open.contains("i < 2"), true, "a loop over the length")
}

@test
fun a_plain_field_is_its_own_slot(): void {
    val f = new_field(no_span(), String.from("x"), Box.new(named_ref("int32")), false, false)
    assert_eq(f.glue_slot().index.as_str(), "", "no element index")
}
