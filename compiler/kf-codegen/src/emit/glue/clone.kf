import alloc.list.*

import kf_core.ast.Import
import kf_core.ast.Module
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import kf_core.ast.subst.clone_type_ref
import kf_core.ast.subst.subst_stmt_list
import kf_core.ast.subst.clone_tref_vec
import kf_core.ast.dyn_meta.clone_dyn_layout_list
import kf_core.ast.dyn_meta.clone_dyn_vtable_list

pub fun Module.deep_clone_module(): Module {
    var path = List.new<String>()
    while item in &self.path {
        path.push(item.clone())
    }
    var decls = List.new<TopDecl>()
    while decl in &self.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    var imports = List.new<Import>()
    while k in 0..self.imports.size() {
        imports.push((self.imports.at(k)).deep_clone_import())
    }
    return Module { crate: self.crate, path: path, decls: decls, imports: imports }
}

pub fun Import.deep_clone_import(): Import {
    var path = List.new<String>()
    while item in &self.path {
        path.push(item.clone())
    }
    return Import { span: self.span, path: path, wildcard: self.wildcard, alias: self.alias.clone(),
        is_pub: self.is_pub, owner: self.owner.clone(), exposed: self.exposed.clone() }
}

pub fun TopDecl.deep_clone_top_decl(): TopDecl {
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            var names = List.new<String>()
            var repls = List.new<TypeRef>()
            var clone_params = List.new<Param>()
            while param in &params {
                val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *ty = clone_type_ref(&*param.ty) }
                clone_params.push(new_param(param.span, param.name.as_string(), ty))
            }
            val clone_ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *clone_ret = clone_type_ref(&*ret) }
            return self.copied_top_decl(TopDeclKind.Function(clone_params, clone_ret, subst_stmt_list(&body, &var names, &var repls), is_pub, is_unsafe, is_mutating, is_static))
        }
        Struct(fields, is_pub) => {
            var clone_fields = List.new<Field>()
            while field in &fields {
                val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *ty = clone_type_ref(&*field.ty) }
                var copied = new_field(field.span, field.name.as_string(), ty, field.is_var, field.is_pub)
                copied.annotations = field.annotations.clone()
                clone_fields.push(copied)
            }
            return self.copied_top_decl(TopDeclKind.Struct(clone_fields, is_pub))
        }
        EnumDecl(variants, is_pub) => {
            var clone_variants = List.new<Variant>()
            while variant in &variants {
                var copied = new_variant(variant.span, variant.name.as_string(), clone_tref_vec(&variant.payloads))
                copied.annotations = variant.annotations.clone()
                clone_variants.push(copied)
            }
            return self.copied_top_decl(TopDeclKind.EnumDecl(clone_variants, is_pub))
        }
        Extern(params, ret, is_pub, is_unsafe) => {
            var clone_params = List.new<Param>()
            while param in &params {
                val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                unsafe { *ty = clone_type_ref(&*param.ty) }
                clone_params.push(new_param(param.span, param.name.as_string(), ty))
            }
            val clone_ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *clone_ret = clone_type_ref(&*ret) }
            return self.copied_top_decl(TopDeclKind.Extern(clone_params, clone_ret, is_pub, is_unsafe))
        }
        ImplBlock(methods) => return self.copied_top_decl(TopDeclKind.ImplBlock(deep_clone_methods(&methods)))
        // The bounds are owned TypeRefs and are copied too.
        AssocType(bounds) => return self.copied_top_decl(TopDeclKind.AssocType(clone_tref_vec(&bounds)))
        AssocTypeBinding(chosen) => {
            val clone_chosen: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *clone_chosen = clone_type_ref(&*chosen) }
            return self.copied_top_decl(TopDeclKind.AssocTypeBinding(clone_chosen))
        }
        AnnotationDecl(params, target, is_pub) => {
            return self.copied_top_decl(TopDeclKind.AnnotationDecl(params.clone(), target.clone(), is_pub))
        }
        TraitDecl(methods, is_pub, supers) => {
            // Cloned, not shared: the source module is dropped afterwards.
            var cloned_supers = List.new<TypeRef>()
            while super in &supers {
                cloned_supers.push(clone_type_ref(super))
            }
            return self.copied_top_decl(TopDeclKind.TraitDecl(deep_clone_methods(&methods), is_pub, cloned_supers))
        }
        TraitImpl(trait_ref, methods) => {
            val clone_trait_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *clone_trait_ref = clone_type_ref(&*trait_ref) }
            return self.copied_top_decl(TopDeclKind.TraitImpl(clone_trait_ref, deep_clone_methods(&methods)))
        }
        Template(kind, marked, body) => return self.copied_top_decl(TopDeclKind.Template(kind, marked, deep_clone_methods(&body)))
        Poison => return self.copied_top_decl(TopDeclKind.Poison)
    }
}

fun deep_clone_methods(methods: &List<TopDecl>): List<TopDecl> {
    var out = List.new<TopDecl>()
    while method in &methods {
        out.push(method.deep_clone_top_decl())
    }
    return out
}

fun TopDecl.copied_top_decl(kind: TopDeclKind): TopDecl {
    var out = new_top_decl(self.span, self.name.as_string(), kind)
    out.crate = self.crate
    out.module_path = self.module_path
    out.decl = self.decl
    out.generics = deep_clone_type_params(&self.generics)
    out.annotations = self.annotations.clone()
    out.from_trait_impl = self.from_trait_impl
    out.linkage = self.linkage
    out.link_name = self.link_name
    out.dyn_layouts = clone_dyn_layout_list(&self.dyn_layouts)
    out.dyn_vtables = clone_dyn_vtable_list(&self.dyn_vtables)
    out.decl_end = self.decl_end
    out.name_span = self.name_span
    out.ext_name = self.ext_name
    out.resolves_in = self.resolves_in
    out.is_sealed = self.is_sealed
    out.is_view = self.is_view
    out.implemented_lang_trait = self.implemented_lang_trait
    return out
}

fun deep_clone_type_params(params: &List<TypeParam>): List<TypeParam> {
    var out = List.new<TypeParam>()
    while param in &params {
        out.push(TypeParam { span: param.span, name: param.name, bounds: clone_tref_vec(&param.bounds) })
    }
    return out
}
