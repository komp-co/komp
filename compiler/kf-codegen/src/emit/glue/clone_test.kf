import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import kf_core.ast.annotation.new_annotation
import kf_codegen.emit.glue.deep_clone_top_decl

fun skip_annotation(): Annotation {
    return new_annotation(no_span(), "skip", List.new<String>())
}

@test fun a_cloned_field_keeps_its_annotations(): void {
    var field = new_field(no_span(), String.from("id"), Box.new(TypeRef.new_poison(no_span())), false, true)
    field.annotations.push(skip_annotation())
    var fields = List.new<Field>()
    fields.push(field)
    val source = new_top_decl(no_span(), String.from("User"), TopDeclKind.Struct(fields, true))
    val count = when (source.deep_clone_top_decl().kind) {
        Struct(copied, _pub) => copied.at(0).annotations.size()
        _ => 0
    }
    assert_eq(count, 1, "the field's use survives the clone")
}

@test fun a_cloned_variant_keeps_its_annotations(): void {
    var variant = new_variant(no_span(), String.from("Circle"), List.new<TypeRef>())
    variant.annotations.push(skip_annotation())
    var variants = List.new<Variant>()
    variants.push(variant)
    val source = new_top_decl(no_span(), String.from("Shape"), TopDeclKind.EnumDecl(variants, true))
    val count = when (source.deep_clone_top_decl().kind) {
        EnumDecl(copied, _pub) => copied.at(0).annotations.size()
        _ => 0
    }
    assert_eq(count, 1, "the variant's use survives the clone")
}
