import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all
import kf_codegen.emit.type_has_user_clone

pub fun Module.emit_public_glue_declarations(): String {
    var parts = List.new<String>()
    parts.push(replace_glue_storage(self.emit_type_op_protos().as_str(), "static inline ", ""))
    parts.push(self.emit_synthesized_clone_method_declarations())
    return concat_all(parts)
}

pub fun Module.emit_public_glue_definitions(lookup: &Module): String {
    val bodies = self.emit_all_glue_definitions(lookup)
    return replace_glue_storage(bodies.as_str(), "static inline ", "")
}

pub fun Module.emit_private_glue_definitions(lookup: &Module): String {
    return self.emit_all_glue_definitions(lookup)
}

// Glue walks ownership deeply, through owner-qualified glue symbols in
// separate emission. `view` picks which types get glue;
// `lookup` answers whether a member owns heap, since its `Drop` may live in a
// dependency.
fun Module.emit_all_glue_definitions(lookup: &Module): String {
    var parts = List.new<String>()
    parts.push(self.emit_struct_retains(lookup))
    parts.push(self.emit_enum_retains(lookup))
    parts.push(self.emit_struct_drops(lookup))
    parts.push(self.emit_enum_drops(lookup))
    parts.push(self.emit_struct_clones())
    parts.push(self.emit_enum_clones())
    return concat_all(parts)
}

pub fun Module.collect_exported_glue_symbols(): List<String> {
    val public_view = self.header_type_view()
    var out = List.new<String>()
    while td in &public_view.decls {
        when (td.kind) {
            Struct(_fields, _is_pub) => append_glue_symbols(td.name.as_string(), &var out)
            EnumDecl(_variants, _is_pub) => append_glue_symbols(td.name.as_string(), &var out)
            _ => {}
        }
    }
    return out
}

fun append_glue_symbols(name: String, out: &var List<String>): void {
    out.push(type_retain_fn(name.as_str()))
    out.push(name.clone() + String.from("__glue_drop"))
    out.push(name + String.from("__glue_clone"))
}

fun Module.emit_synthesized_clone_method_declarations(): String {
    var out = ""
    while td in &self.decls {
        when (td.kind) {
            Struct(_fields, _is_pub) => {
                if !type_has_user_clone(td.name.as_string(), self) {
                    out.append(synthesized_clone_declaration(td.name.as_string()).as_str())
                }
            }
            // A consumer calling an enum's default `clone` through a bound has
            // only this declaration.
            EnumDecl(_variants, _is_pub) => {
                if !type_has_user_clone(td.name.as_string(), self) {
                    out.append(synthesized_clone_declaration(td.name.as_string()).as_str())
                }
            }
            _ => {}
        }
    }
    return out
}

/// `<T> <T>_clone(<T>* __self);`
fun synthesized_clone_declaration(name: String): String {
    var out = ""
    out.append(name.as_str())
    out.append(" ")
    out.append(name.as_str())
    out.append("_clone(")
    out.append(name.as_str())
    out.append("* __self);\n")
    return out
}

fun replace_glue_storage(source: str, needle: str, replacement: str): String {
    var out = ""
    val source_len = source.byte_len()
    val needle_len = needle.byte_len()
    var start = 0
    var i = 0
    while i + needle_len <= source_len {
        if glue_starts_with_at(source, needle, i) {
            if i > start {
                val before = source.substring(start, i)
                out.append(before.as_str())
            }
            out.append(replacement)
            i = i + needle_len
            start = i
        } else {
            i = i + 1
        }
    }
    if start < source_len {
        val tail = source.substring(start, source_len)
        out.append(tail.as_str())
    }
    return out
}

fun glue_starts_with_at(source: str, needle: str, at: uint64): bool {
    val needle_len = needle.byte_len()
    var i = 0
    while i < needle_len {
        if source.byte_at(at + i) != needle.byte_at(i) {
            return false
        }
        i = i + 1
    }
    return true
}
