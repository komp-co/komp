import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

import kf_codegen.emit_module_body
import kf_codegen.emit.unit.*

fun glue_header_output(): String {
    val view = hdr_view()
    return view.emit_crate_header(String.from("aa"), &List.new<String>())
}

fun glue_source_output(): String {
    val view = hdr_view()
    return view.emit_crate_source(String.from("aa"), false)
}

@test
fun public_retain_is_declared_without_a_header_body(): void {
    val header = glue_header_output()
    val declared = hdr_contains(header.as_str(), "Point kf__retain__Point(Point v);")
    val body = hdr_contains(header.as_str(), "kf__retain__Point(Point v) {")
    assert_eq(declared && !body, true, "header declares retain without defining it")
}

@test
fun synthesized_clone_method_entry_is_declared(): void {
    val header = glue_header_output()
    assert_eq(hdr_contains(header.as_str(), "Point Point_clone(Point* __self);"), true, "header declares synthesized clone method entry")
}

@test
fun public_drop_is_defined_in_the_owner_source(): void {
    val source = glue_source_output()
    assert_eq(hdr_contains(source.as_str(), "void Point__glue_drop(Point v) {"), true, "owner source defines drop")
}

@test
fun public_clone_is_defined_in_the_owner_source(): void {
    val source = glue_source_output()
    assert_eq(hdr_contains(source.as_str(), "Point Point__glue_clone(Point v) {"), true, "owner source defines clone")
}

@test
fun nested_public_drop_calls_the_qualified_owner_symbol(): void {
    var point_fields = List.new<Field>()
    val label_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *label_type = TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    point_fields.push(new_field(no_span(), String.from("label"), label_type, false, true))
    var fields = List.new<Field>()
    val point_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *point_type = TypeRef.new(no_span(), TypeRefKind.Named(intern("sample__Point"), List.new<TypeRef>())) }
    fields.push(new_field(no_span(), String.from("point"), point_type, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("sample__Point"), TopDeclKind.Struct(point_fields, true)))
    decls.push(glue_string_drop_impl())
    decls.push(new_top_decl(no_span(), String.from("sample__Envelope"), TopDeclKind.Struct(fields, true)))
    val view = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val source = view.emit_crate_source(String.from("sample"), false)
    assert_eq(hdr_contains(source.as_str(), "sample__Point__glue_drop(v.point);"), true, "nested glue calls the qualified owner symbol")
}

fun string_owner_source(): String {
    var fields = List.new<Field>()
    val label_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *label_type = TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    fields.push(new_field(no_span(), String.from("label"), label_type, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Parcel"), TopDeclKind.Struct(fields, true)))
    decls.push(glue_string_drop_impl())
    val view = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    return view.emit_crate_source(String.from("sample"), false)
}

@test
fun string_field_drop_uses_its_own_glue(): void {
    val source = string_owner_source()
    assert_eq(hdr_contains(source.as_str(), "String__glue_drop(v.label);"), true, "a String field releases like any other owning field")
}

@test
fun string_field_retain_deep_clones_the_value(): void {
    val source = string_owner_source()
    assert_eq(hdr_contains(source.as_str(), "v.label = kf__retain__String(v.label);"), true, "String field retain produces an independent owner")
}

@test
fun string_retain_glue_calls_its_declared_clone(): void {
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    var methods = List.new<TopDecl>()
    val clone_kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    methods.push(new_top_decl(no_span(), String.from("clone"), clone_kind))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("String"), TopDeclKind.Struct(List.new<Field>(), true)))
    decls.push(new_top_decl(no_span(), String.from("String"), TopDeclKind.ImplBlock(methods)))
    val view = Module { crate: new_crate_id("core"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val source = view.emit_crate_source(String.from("core"), false)
    assert_eq(hdr_contains(source.as_str(), "return String__glue_clone(v);"), true, "public String retain glue creates an independent owner")
}

// Dyn layouts are emitted before type bodies, so a member naming `String`
// relies on the forward declaration.
fun string_module(): Module {
    var fields = List.new<Field>()
    val u8p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *u8p = TypeRef.new(no_span(), TypeRefKind.Named(intern("uint8"), List.new<TypeRef>())) }
    fields.push(new_field(no_span(), String.from("len"), u8p, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("String"), TopDeclKind.Struct(fields, true)))
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

@test
fun string_is_forward_declared_like_any_other_type(): void {
    val m = string_module()
    val out = m.emit_type_forward_decls()
    assert_eq(hdr_contains(out.as_str(), "typedef struct String String;"), true, "String gets a forward declaration")
}

@test
fun the_string_forward_declaration_precedes_its_layout(): void {
    val m = string_module()
    val body = m.emit_module_body(false)
    var ok = false
    when (body.as_str().index_of("typedef struct String String;")) {
        Some(fwd) => {
            when (body.as_str().index_of("typedef struct String {")) {
                Some(layout) => { ok = fwd < layout }
                None => { }
            }
        }
        None => { }
    }
    assert_eq(ok, true, "the declaration comes before the definition")
}

/// alloc's `impl Drop for String` after mono folds it into an impl block.
fun glue_string_drop_impl(): TopDecl {
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = TypeRef.new(no_span(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    var methods = List.new<TopDecl>()
    val drop_kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    methods.push(new_top_decl(no_span(), String.from("drop"), drop_kind))
    return new_top_decl(no_span(), String.from("String"), TopDeclKind.ImplBlock(methods))
}
