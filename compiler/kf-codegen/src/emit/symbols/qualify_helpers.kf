import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr

import kf_core.ast.subst.subst_mangled_name
import kf_core.ast.subst.monomorphized_type_name

/// `matched` false: not spelled `<owner>_<method>` at all, as opposed to an
/// empty tail.
pub struct CalleeTail {
    pub val matched: bool
    pub val tail: String
}

fun qualified_method_owner(t: Type): String {
    return when (t.kind) {
        Struct(n) => type_identity_display(n)
        // `impl Equal for Color` defines `Color_equals`.
        EnumTy(n) => type_identity_display(n)
        PtrTo(p) => qualified_method_owner(unsafe { *p })
        BoxOf(p) => qualified_method_owner(unsafe { *p })
        RefTo(_, p) => qualified_method_owner(unsafe { *p })
        _ => primitive_method_owner(t)
    }
}

/// The owner of a callee Mono has yet to complete: the type parameter, or the
/// `.` left for an associated type's owner. "" when already concrete.
fun bound_method_owner(t: Type, callee: str): String {
    if callee.starts_with("._") { return "." }
    return when (t.kind) {
        Generic(n) => n.as_string()
        RefTo(_, p) => bound_method_owner(unsafe { *p }, callee)
        _ => ""
    }
}

/// `impl Equal for int32` defines `int32_equals`, so scalars own methods.
/// Scalars only; a trait receiver names no owner.
fun primitive_method_owner(t: Type): String {
    return t.scalar_frag()
}

/// Everything before the first single `_`, mono suffix intact:
/// `Box__int32_new` is `Box__int32`. Empty without a method segment.
pub fun static_callee_owner_mangled(callee: str): String {
    val n = callee.byte_len()
    var us: uint64 = n
    var i = 0
    while i < n {
        if callee.byte_at(i) == 95 {
            // `__` is a compound delimiter, not the boundary.
            if i + 1 < n && callee.byte_at(i + 1) == 95 {
                i = i + 2
            } else {
                us = i
                i = n
            }
        } else {
            i = i + 1
        }
    }
    if us == n { return "" }
    return callee.substring(0, us)
}

/// `Cel_from__From__int32` is `Cel`, `Box__int32_new` is `Box`.
pub fun static_callee_owner(callee: str): String {
    val prefix = static_callee_owner_mangled(callee)
    val pn = prefix.as_str().byte_len()
    var k: uint64 = 0
    while k + 1 < pn {
        val d0 = prefix.as_str().byte_at(k)
        val d1 = prefix.as_str().byte_at(k + 1)
        if d0 == 95 && d1 == 95 {
            return prefix.as_str().substring(0, k)
        }
        k = k + 1
    }
    return prefix
}

/// The static call's receiver names the callee's type (`Cel.from(x)`), not a
/// trait (`First.label(item)` calls `Item_label__First`). Unstamped callees
/// take the rebuild path.
pub fun callee_targets_receiver(callee: str, receiver: str, method: str): bool {
    if callee.byte_len() == 0 { return true }
    if receiver.byte_len() == 0 { return true }
    // Tested against the known owner, since a scan cannot see an owner
    // containing `_`.
    if callee_method_tail(callee, receiver, method).matched { return true }
    // A monomorphized owner (`Box__int32`) needs the normalizing compare.
    val owner = static_callee_owner(callee)
    if owner.as_str().byte_len() == 0 { return true }
    return owner.as_str().equals(receiver)
}

/// The instance-call twin of `callee_targets_receiver`: true only when the
/// callee is spelled around the receiver's type, trait tail included, so an
/// unknown shape is left alone.
pub fun instance_callee_targets_receiver(callee: str, method: str, recv_ty: str): bool {
    if callee.byte_len() == 0 { return false }
    if recv_ty.byte_len() == 0 { return false }
    val split = callee_method_tail(callee, recv_ty, method)
    if !split.matched { return false }
    // A generic-instance method's argument may gain a prefix, so every callee
    // this receiver owns is rebuilt.
    return true
}

/// Splits `<owner>_<method><tail>` at an owner the caller knows. The single-`_`
/// separator cannot be found by scanning: `Lambda_main_0_call` has false ones
/// inside the owner. `matched` false leaves an unknown shape alone.
pub fun callee_method_tail(callee: str, owner: str, method: str): CalleeTail {
    var needle = String.from(owner)
    needle.append("_")
    needle.append(method)
    if !callee.starts_with(needle.as_str()) { return no_callee_tail() }
    val n = callee.byte_len()
    val m = needle.as_str().byte_len()
    val rest = callee.substring(m, n)
    val rest_len = rest.as_str().byte_len()
    if rest_len == 0 { return CalleeTail { matched: true, tail: rest } }
    // The method segment ends the name or is followed by `__`.
    if rest_len < 2 { return no_callee_tail() }
    if rest.as_str().byte_at(0) != 95 { return no_callee_tail() }
    if rest.as_str().byte_at(1) != 95 { return no_callee_tail() }
    return CalleeTail { matched: true, tail: rest }
}

fun no_callee_tail(): CalleeTail {
    return CalleeTail { matched: false, tail: "" }
}

pub fun static_callee_tail(callee: str, method: str): String {
    val found = method_segment_at(callee, method) ?: return ""
    return callee.substring(found + method.byte_len() + 1, callee.byte_len())
}

/// Everything before the method segment: `List__is_shown_new` under `new` is
/// `List__is_shown`, where the first single `_` would cut the argument. ""
/// when the method is absent.
pub fun static_callee_owner_before(callee: str, method: str): String {
    val found = method_segment_at(callee, method) ?: return ""
    return callee.substring(0, found)
}

/// Where the last `_<method>` starts: the trait tail follows the method
/// segment.
fun method_segment_at(callee: str, method: str): uint64? {
    val n = callee.byte_len()
    var needle = String.from("_")
    needle.append(method)
    val m = needle.as_str().byte_len()
    if m > n { return null }
    var found: uint64? = null
    var i = 0
    while i + m <= n {
        if callee.substring(i, i + m).as_str() == needle.as_str() { found = i }
        i = i + 1
    }
    return found
}

/// "" unless the receiver is a bare type or trait name.
fun static_recv_variable_name(recv: Ptr<Expr>): String {
    val receiver = unsafe { *recv }
    return when (receiver.kind) {
        Variable(name) => name.as_string()
        _ => ""
    }
}

/// What `owner` has past `base`. `matched` false when `owner` is not `base`
/// plus a suffix.
pub struct MangleSuffix {
    pub val matched: bool
    pub val text: String
}

pub fun mangle_suffix_after(owner: str, base: str): MangleSuffix {
    val on = owner.byte_len()
    val bn = base.byte_len()
    if on == 0 { return MangleSuffix { matched: false, text: "" } }
    if bn == 0 { return MangleSuffix { matched: false, text: "" } }
    if bn > on { return MangleSuffix { matched: false, text: "" } }
    var i = 0
    while i < bn {
        if owner.byte_at(i) != base.byte_at(i) {
            return MangleSuffix { matched: false, text: "" }
        }
        i = i + 1
    }
    return MangleSuffix { matched: true, text: owner.substring(bn, on) }
}

fun rebuild_static_callee(ep: Ptr<Expr>, recv: Ptr<Expr>, method: Sym, recv_before: &String, names: &var List<String>, repls: &var List<TypeRef>): void {
    val receiver = unsafe { *recv }
    when (receiver.kind) {
        Variable(name) => {
            var concrete = name.as_string()
            // The receiver's type arguments come from the callee, where
            // typecheck already split them from the method's own: folding the
            // whole written list in gave `B__int32_of__int32` for `B_of__int32`.
            val owner_mangled = static_callee_owner_before(unsafe { ep.mangled_callee.as_str() }, method.as_str())
            val recv_suffix = mangle_suffix_after(owner_mangled.as_str(), recv_before.as_str())
            if recv_suffix.matched {
                concrete.append(subst_mangled_name(recv_suffix.text.as_str(), names, repls).as_str())
            } else {
                // No callee to split: the written list, which is the receiver's
                // whenever the method declares no parameters.
                val args = unsafe { ep.type_args }
                if args.size() > 0 {
                    concrete = String.from(monomorphized_type_name(String.from(concrete.as_str()), &args).as_str())
                }
            }
            // The tail's type names take the prefix too.
            val raw_tail = static_callee_tail(unsafe { ep.mangled_callee.as_str() }, method.as_str())
            val tail = subst_mangled_name(raw_tail.as_str(), names, repls)
            var rebuilt = concrete + String.from("_") + method.as_string()
            rebuilt.append(tail.as_str())
            unsafe { ep.mangled_callee = intern(rebuilt.as_str()) }
        }
        _ => {}
    }
}

fun qualify_expr_args(args: &var List<Expr>, names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    while i in 0..args.size() {
        val ap: Ptr<Expr> = unsafe { args.at_mut(i) as Ptr<Expr> }
        qualify_expr_ptr(ap, names, repls, rename_types)
    }
}

fun qualify_type_args(type_args: &var List<TypeRef>, names: &var List<String>, repls: &var List<TypeRef>): void {
    while i in 0..type_args.size() {
        val tp: Ptr<TypeRef> = unsafe { type_args.at_mut(i) as Ptr<TypeRef> }
        qualify_tyref_ptr(tp, names, repls)
    }
}

/// Respells type names inside a resolved Type. Kind-preserving: an EnumTy
/// stays one, which codegen's enum paths need.
pub fun qualify_type(t: Type, names: &var List<String>, repls: &var List<TypeRef>): Type {
    when (t.kind) {
        Struct(n) => return Type { kind: TypeKind.Struct(n.qualify_type_name(names, repls)), provenance: t.provenance }
        EnumTy(n) => return Type { kind: TypeKind.EnumTy(n.qualify_type_name(names, repls)), provenance: t.provenance }
        TraitTy(n) => return Type { kind: TypeKind.TraitTy(n.qualify_type_name(names, repls)), provenance: t.provenance }
        PtrTo(p) => {
            qualify_type_ptr(p, names, repls)
            return t
        }
        BoxOf(p) => {
            qualify_type_ptr(p, names, repls)
            return t
        }
        RefTo(_mut, p) => {
            qualify_type_ptr(p, names, repls)
            return t
        }
        FnTy(_signature) => {
            // Rebuilt rather than respelled in place: the signature is shared
            // with every copy of the type.
            val parts = t.fn_parts() ?: return t
            var params = List.new<Type>()
            while param in &parts.params {
                params.push(qualify_type(param, names, repls))
            }
            return Type.new_fn(params, qualify_type(parts.ret, names, repls), t.provenance)
        }
        _ => return t
    }
}

fun qualify_type_ptr(p: Ptr<Type>, names: &var List<String>, repls: &var List<TypeRef>): void {
    val cur: Type = unsafe { *p }
    val next = qualify_type(cur, names, repls)
    unsafe { *p = next }
}

// An exact table key, or a compound (`List__Point`) respelled per segment.
fun Sym.qualify_type_name(names: &var List<String>, repls: &var List<TypeRef>): Sym {
    val hit = rename_lookup(self.as_str(), names, repls)
    if hit.as_str().byte_len() > 0 {
        return intern_string(hit)
    }
    if is_mangled_decl_name(self.as_str()) {
        return intern(subst_mangled_name(self.as_str(), names, repls).as_str())
    }
    return Sym { id: self.id }
}
