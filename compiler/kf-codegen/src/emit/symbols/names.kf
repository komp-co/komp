// Crate-qualified C symbol naming. Separate compilation prefixes ordinary
// symbols with their crate (`json__json_quote`); unity builds keep bare names.
// The rename table is parallel lists (old name, replacement TypeRef) so it
// plugs into kf-core's substitution helpers. The walks live in qualify.kf.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.subst.mangle_tyref

pub fun push_rename(old: String, new_name: String, names: &var List<String>, repls: &var List<TypeRef>): void {
    names.push(old)
    repls.push(TypeRef.new(no_span(), TypeRefKind.Named(intern(new_name.as_str()), List.new<TypeRef>())))
}

/// "" on a miss.
pub fun rename_lookup(name: str, names: &var List<String>, repls: &var List<TypeRef>): String {
    while i in 0..names.size() {
        if names.at(i).as_str() == name {
            if i < repls.size() {
                val item = *repls.at(i)
                return String.from(mangle_tyref(&item).as_str())
            }
        }
    }
    return ""
}

/// Every non-generic struct/enum with an owner maps to `<crate>__<name>`,
/// keyed by its bare name and by its canonical identity.
///
/// CONSTRAINT: this module's own types first. `rename_lookup` answers with
/// the first entry, so a dependency's type of the same name would otherwise
/// capture the program's.
pub fun Module.collect_type_renames(names: &var List<String>, repls: &var List<TypeRef>): void {
    self.collect_type_renames_pass(false, names, repls)
    self.collect_type_renames_pass(true, names, repls)
}

fun Module.collect_type_renames_pass(imported: bool, names: &var List<String>, repls: &var List<TypeRef>): void {
    val list_name = self.lang_type_name(lang_list_key())
    val option_name = self.lang_type_name(lang_option_key())
    val decls = self.decls
    while td in &decls {
        if td.linkage.is_imported() == imported {
            if type_decl_qualifies(td, list_name, option_name) {
                val prefixed_name = td.crate.symbol_prefix()
                var new_name = prefixed_name.clone()
                new_name.append(td.name.as_str())
                // A resolved type may already carry the final C name; it is
                // matched first so it is not prefixed twice.
                push_rename(String.from(new_name.as_str()), String.from(new_name.as_str()), names, repls)
                push_rename(td.name.as_string(), String.from(new_name.as_str()), names, repls)
                val canon = canonical_type_identity(TypeIdentity.new(td.crate, td.module_path, td.name))
                push_rename(canon.as_string(), String.from(new_name.as_str()), names, repls)
            }
        }
    }
}

fun type_decl_qualifies(td: TopDecl, list_name: Sym, option_name: Sym): bool {
    var is_type = false
    when (td.kind) {
        Struct(_f, _p) => { is_type = true }
        EnumDecl(_v, _p) => { is_type = true }
        _ => {}
    }
    if !is_type { return false }
    if td.crate.is_poison() { return false }
    if td.generics.size() > 0 { return false }
    val s = td.name.as_str()
    if is_runtime_type_name(s) || is_container_type_name(s, list_name, option_name) { return false }
    if is_mangled_decl_name(s) { return false }
    if (&td).has_annotation("no_mangle") { return false }
    return true
}

/// Every non-generic free function with an owner, except `main`. Externs
/// keep their foreign names. A globally unique inherent method is included as
/// a fallback for calls that lost their receiver type; ambiguous ones are not.
pub fun Module.collect_fn_renames(names: &var List<String>, repls: &var List<TypeRef>): void {
    val decls = self.decls
    // CONSTRAINT: this module's own functions first, as `find_imported_signature`
    // does in the typechecker; otherwise an imported function of the same name
    // renames the program's definition.
    while td in &decls {
        if !td.linkage.is_imported() {
            if fn_decl_qualifies(td) {
                var new_name = td.crate.symbol_prefix()
                new_name.append(td.name.as_str())
                push_rename(td.name.as_string(), String.from(new_name.as_str()), names, repls)
            }
        }
    }
    // An interface-loaded declaration already has its link name.
    while td in &decls {
        if td.linkage.is_imported() {
            if td.link_name.as_str().byte_len() > 0 {
                push_rename(td.name.as_string(), td.link_name.as_string(), names, repls)
            }
        }
    }
    self.collect_unique_method_renames(names, repls)
    self.collect_method_value_renames(names, repls)
}

fun Module.collect_unique_method_renames(names: &var List<String>, repls: &var List<TypeRef>): void {
    while owner in &self.decls {
        when (owner.kind) {
            ImplBlock(methods) => {
                while method in &methods {
                    val raw_name = method_source_name(method.name.as_string())
                    if !method_name_is_runtime_owned(raw_name.as_str()) && self.method_name_count(raw_name.as_str()) == 1 && !self.module_has_free_symbol(raw_name.as_str()) {
                        val link = self.method_link_name(owner, method)
                        if link.as_str() != "" {
                            push_rename(raw_name, link, names, repls)
                        }
                    }
                }
            }
            _ => {}
        }
    }
}

/// `Counter_get`, the name a method value is checked under, for every method
/// of a non-generic impl.
/// CONSTRAINT: after qualify_type_symbols, so the owner's name may carry its
/// crate prefix, which the checked name does not.
fun Module.collect_method_value_renames(names: &var List<String>, repls: &var List<TypeRef>): void {
    while owner in &self.decls {
        if owner.generics.size() > 0 { continue }
        when (owner.kind) {
            ImplBlock(methods) => self.push_method_value_renames(owner, &methods, names, repls)
            TraitImpl(_trait, methods) => self.push_method_value_renames(owner, &methods, names, repls)
            _ => {}
        }
    }
}

fun Module.push_method_value_renames(owner: &TopDecl, methods: &List<TopDecl>, names: &var List<String>,
    repls: &var List<TypeRef>): void {
    val checked_owner = owner.unprefixed_name()
    while method in &methods {
        val link = self.method_link_name(owner, method)
        if link.as_str() != "" {
            push_rename("${checked_owner.as_str()}_${method.name.as_str()}", link, names, repls)
        }
    }
}

/// The type's name without the crate prefix qualify_type_symbols gave it.
fun TopDecl.unprefixed_name(): String {
    val prefix = self.crate.symbol_prefix()
    val name = self.name.as_str()
    if prefix.byte_len() == 0 || !name.starts_with(prefix.as_str()) { return self.name.as_string() }
    return name.substring(prefix.byte_len(), name.byte_len())
}

/// The method's C symbol; "" for an impl with no owning crate.
fun Module.method_link_name(owner: &TopDecl, method: &TopDecl): String {
    val link = method.link_name.as_string()
    if link.as_str() != "" || owner.crate.is_poison() { return link }
    val list_name = self.lang_type_name(lang_list_key())
    val option_name = self.lang_type_name(lang_option_key())
    // A builtin type's impls are emitted unprefixed (`int8_add__Add`).
    val unprefixed = is_mangled_decl_name(owner.name.as_str()) || is_runtime_type_name(owner.name.as_str()) ||
        is_container_type_name(owner.name.as_str(), list_name, option_name) ||
        self.type_is_no_mangle(owner.name.as_str())
    val prefix = if unprefixed { String.from("") } else { String.from(owner.crate.symbol_prefix().as_str()) }
    return prefix + owner.name.as_string() + String.from("_") + method.name.as_string()
}

// A method-name rename is unsafe when a free function or extern shares the
// name: it would retarget a call to the extern.
fun Module.module_has_free_symbol(name: str): bool {
    while td in &self.decls {
        when (td.kind) {
            Function(_p, _r, _b, _pub, _u, _mm, _s) => { if td.name.as_str() == name { return true } }
            Extern(_p, _r, _pub, _u) => { if td.name.as_str() == name { return true } }
            _ => {}
        }
    }
    return false
}

fun Module.method_name_count(name: str): uint64 {
    var count: uint64 = 0
    while owner in &self.decls {
        when (owner.kind) {
            ImplBlock(methods) => {
                while method in &methods {
                    val raw_name = method_source_name(method.name.as_string())
                    if raw_name.as_str() == name { count = count + 1 }
                }
            }
            _ => {}
        }
    }
    return count
}

// `score__Score` still answers the call `score()`.
fun method_source_name(name: String): String {
    val source = name.as_str()
    val length = source.byte_len()
    var i: uint64 = 0
    while i + 1 < length {
        if source.byte_at(i) == 95 && source.byte_at(i + 1) == 95 {
            return source.substring(0, i)
        }
        i = i + 1
    }
    return name
}

fun method_name_is_runtime_owned(name: str): bool {
    return when name {
        "clone" => true
        "as_str" => true
        "equals" => true
        "byte_len" => true
        "len" => true
        "append" => true
        "display" => true
        "get" => true
        "at" => true
        "at_mut" => true
        "size" => true
        "is_empty" => true
        "push" => true
        "set" => true
        _ => false
    }
}

fun fn_decl_qualifies(td: TopDecl): bool {
    var is_fn = false
    when (td.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => { is_fn = true }
        _ => {}
    }
    if !is_fn { return false }
    if td.crate.is_poison() { return false }
    if td.generics.size() > 0 { return false }
    val s = td.name.as_str()
    if s == "main" { return false }
    if is_mangled_decl_name(s) { return false }
    return true
}
