// Rewrites one function body so every type spelling matches the renamed
// declarations, and in the function phase retargets Call mangled_callees.
// Mutates in place; only a type-name Variable receiver is replaced whole.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*

import kf_core.ast.subst.subst_mangled_name
import kf_core.ast.subst.subst_static_callee

pub fun qualify_stmt_list(stmts: &var List<Stmt>, names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    while i in 0..stmts.size() {
        // In place, so the module sees the rewrite.
        (stmts.at_mut(i)).qualify_stmt(names, repls, rename_types)
    }
}

mutating fun Stmt.qualify_stmt(names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    when (self.kind) {
        LetVal(_n, ty_p, init_p) => {
            qualify_tyref_ptr(ty_p.view(), names, repls)
            qualify_expr_ptr_opt(init_p.view(), names, repls, rename_types)
        }
        LetVar(_n, ty_p, init_p) => {
            qualify_tyref_ptr(ty_p.view(), names, repls)
            qualify_expr_ptr_opt(init_p.view(), names, repls, rename_types)
        }
        Assign(_n, ep) => qualify_expr_ptr(ep, names, repls, rename_types)
        AssignTo(pp, ep) => {
            qualify_expr_ptr(pp, names, repls, rename_types)
            qualify_expr_ptr(ep, names, repls, rename_types)
        }
        Return(ep) => {
            val p = ep ?: return
            qualify_expr_ptr(p, names, repls, rename_types)
        }
        If(cp, then_body, else_body) => {
            qualify_expr_ptr(cp, names, repls, rename_types)
            qualify_stmt_list(then_body, names, repls, rename_types)
            qualify_stmt_list(else_body, names, repls, rename_types)
        }
        While(cp, body) => {
            qualify_expr_ptr(cp, names, repls, rename_types)
            qualify_stmt_list(body, names, repls, rename_types)
        }
        When(subj, arms) => {
            qualify_expr_ptr(subj, names, repls, rename_types)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                qualify_expr_ptr_opt(a.guard.view(), names, repls, rename_types)
                qualify_stmt_list(&var a.body, names, repls, rename_types)
            }
        }
        Switch(subj, sarms) => {
            qualify_expr_ptr(subj, names, repls, rename_types)
            while i in 0..sarms.size() {
                var sa = sarms.at_mut(i)
                qualify_expr_ptr_opt(sa.guard.view(), names, repls, rename_types)
                qualify_stmt_list(&var sa.guard_prelude, names, repls, rename_types)
                qualify_stmt_list(&var sa.body, names, repls, rename_types)
            }
        }
        Expression(ep) => qualify_expr_ptr(ep, names, repls, rename_types)
        _ => return
    }
}

fun qualify_expr_ptr_opt(p_opt: Ptr<Expr>?, names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    val p = p_opt ?: return
    qualify_expr_ptr(p, names, repls, rename_types)
}

fun qualify_expr_ptr(ep: Ptr<Expr>, names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    val e = unsafe { *ep }
    unsafe { ep.ty = qualify_type(e.ty, names, repls) }
    if e.is_dynamic_call {
        val layout = subst_mangled_name(e.dynamic_layout.as_str(), names, repls)
        unsafe { ep.dynamic_layout = intern(layout.as_str()) }
    }
    var ta = e.type_args
    qualify_type_args(&var ta, names, repls)
    when (e.kind) {
        Variable(vn) => {
            if !rename_types { return }
            val hit = rename_lookup(vn.as_str(), names, repls)
            if hit.as_str().byte_len() == 0 { return }
            // A type-name receiver is respelled so codegen's receiver-name
            // comparison still matches.
            val sp: Span = e.span
            unsafe { *ep = new_expr(sp, ExprKind.Variable(intern_string(hit))) }
        }
        Binary(lp, _op, rp) => {
            qualify_expr_ptr(lp, names, repls, rename_types)
            qualify_expr_ptr(rp, names, repls, rename_types)
        }
        Unary(_o, ip) => qualify_expr_ptr(ip, names, repls, rename_types)
        Deref(ip) => qualify_expr_ptr(ip, names, repls, rename_types)
        Call(_n, args) => {
            qualify_expr_args(args, names, repls, rename_types)
            if rename_types {
                if is_mangled_decl_name(e.mangled_callee.as_str()) {
                    unsafe { ep.mangled_callee = intern(subst_mangled_name(e.mangled_callee.as_str(), names, repls).as_str()) }
                }
            } else {
                val lookup_name = if e.mangled_callee.as_str() == "" { _n.as_string() } else { e.mangled_callee.as_string() }
                val hit = rename_lookup(lookup_name.as_str(), names, repls)
                if hit.as_str().byte_len() > 0 {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        MethodCall(rp, _mn, args) => {
            // Read before qualifying: compared against the callee's
            // unqualified owner.
            val recv_before = static_recv_variable_name(rp)
            val recv_ty_before = qualified_method_owner(unsafe { rp.ty })
            val recv_param = bound_method_owner(unsafe { rp.ty }, e.mangled_callee.as_str())
            val via_bound = recv_param.byte_len() > 0 &&
                callee_method_tail(e.mangled_callee.as_str(), recv_param.as_str(), _mn.as_str()).matched
            qualify_expr_ptr(rp, names, repls, rename_types)
            qualify_expr_args(args, names, repls, rename_types)
            if rename_types && e.is_static_call {
                if callee_targets_receiver(e.mangled_callee.as_str(), recv_before.as_str(), _mn.as_str()) {
                    rebuild_static_callee(ep, rp, _mn, &recv_before, names, repls)
                } else {
                    // A trait-qualified receiver names the trait; only the
                    // callee's type segment is respelled.
                    unsafe { ep.mangled_callee = intern(subst_static_callee(e.mangled_callee.as_str(), names, repls).as_str()) }
                }
            } else if rename_types && !e.mangled_callee.as_str().equals("") && !is_mangled_decl_name(e.mangled_callee.as_str()) {
                unsafe { ep.mangled_callee = intern(subst_static_callee(e.mangled_callee.as_str(), names, repls).as_str()) }
            } else if rename_types && instance_callee_targets_receiver(e.mangled_callee.as_str(), _mn.as_str(), recv_ty_before.as_str()) {
                // A trait-impl method through an instance call: rebuilt around
                // the qualified receiver type, trait tail kept.
                val owner = qualified_method_owner(unsafe { rp.ty })
                if owner.as_str() != "" {
                    // The tail's types take the prefix too.
                    val split = callee_method_tail(e.mangled_callee.as_str(), recv_ty_before.as_str(), _mn.as_str())
                    val tail = subst_mangled_name(split.tail.as_str(), names, repls)
                    var callee = owner
                    callee.append("_")
                    callee.append(_mn.as_str())
                    callee.append(tail.as_str())
                    unsafe { ep.mangled_callee = intern(callee.as_str()) }
                }
            } else if rename_types && via_bound {
                // Through a parameter's or associated type's bound: the owner is
                // left for Mono; the tail's trait arguments are qualified.
                val split = callee_method_tail(e.mangled_callee.as_str(), recv_param.as_str(), _mn.as_str())
                val tail = subst_mangled_name(split.tail.as_str(), names, repls)
                val callee = "${recv_param}_${_mn.as_str()}${tail}"
                unsafe { ep.mangled_callee = intern(callee.as_str()) }
            } else if rename_types && (e.mangled_callee.as_str() == "" || e.mangled_callee.as_str() == _mn.as_str()) {
                val receiver = unsafe { *rp }
                val owner = qualified_method_owner(receiver.ty)
                if owner.as_str() != "" {
                    var callee = owner
                    callee.append("_")
                    callee.append(_mn.as_str())
                    unsafe { ep.mangled_callee = intern(callee.as_str()) }
                }
            } else if !rename_types && (e.mangled_callee.as_str() == "" || e.mangled_callee.as_str() == _mn.as_str()) {
                val hit = rename_lookup(_mn.as_str(), names, repls)
                if hit.as_str() != "" {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        FieldAccess(rp, _f) => qualify_expr_ptr(rp, names, repls, rename_types)
        IfExpr(cp, tp, ep2) => {
            qualify_expr_ptr(cp, names, repls, rename_types)
            qualify_expr_ptr(tp, names, repls, rename_types)
            qualify_expr_ptr(ep2, names, repls, rename_types)
        }
        // Qualification runs before Lower, so the expression form is still here.
        WhenExpr(subj, arms) => {
            qualify_expr_ptr(subj, names, repls, rename_types)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                qualify_expr_ptr_opt(a.guard.view(), names, repls, rename_types)
                qualify_stmt_list(&var a.body, names, repls, rename_types)
            }
        }
        // Block values are still expressions here too.
        Block(stmts) => {
            while i in 0..stmts.size() {
                (stmts.at_mut(i)).qualify_stmt(names, repls, rename_types)
            }
        }
        StructLit(sn, finits) => {
            while fi in &finits {
                qualify_expr_ptr(fi.value, names, repls, rename_types)
            }
            // The renamed constructor goes through the mangled_callee override.
            // An existing value is looked up too: `Self { ... }` arrives with
            // the unqualified impl target. A Mono mangle never hits the table.
            if rename_types {
                var key = String.from(sn.as_str())
                if e.mangled_callee.as_str() != "" { key = e.mangled_callee.as_string() }
                val hit = rename_lookup(key.as_str(), names, repls)
                if hit.as_str().byte_len() > 0 {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        Cast(ip, tp) => {
            qualify_expr_ptr(ip, names, repls, rename_types)
            qualify_tyref_ptr(tp, names, repls)
        }
        DynCoerce(ip, vtable) => {
            // The vtable identity is a type name; the value is qualified.
            val concrete_vtable = subst_mangled_name(vtable.as_str(), names, repls)
            unsafe { ep.kind = ExprKind.DynCoerce(ip, intern(concrete_vtable.as_str())) }
            qualify_expr_ptr(unsafe { ip as Ptr<Expr> }, names, repls, rename_types)
        }
        Retain(ip) => qualify_expr_ptr(ip, names, repls, rename_types)
        _ => return
    }
}
