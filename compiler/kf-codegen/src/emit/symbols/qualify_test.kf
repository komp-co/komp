@test
fun type_phase_qualifies_a_stamped_generic_instance_method_callee(): void {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("option"))) }
    unsafe { (*recv).ty = Type { kind: TypeKind.EnumTy(intern("Option__Point")), provenance: Provenance.Inferred(no_span()) } }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern("is_none"), List.new<Expr>())) }
    unsafe { call.mangled_callee = intern("Option__Point_is_none") }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("use_option"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("void"), body, true, false, false, false))))
    var module = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    module.qualify_type_symbols()
    assert_eq(unsafe { call.mangled_callee.as_str() }, "Option__aa__Point_is_none", "stamped generic instance callees use qualified arguments")
}

@test
fun type_phase_qualifies_a_folded_generic_intrinsic(): void {
    var fixture = build_fixture()
    unsafe { (*fixture.call).mangled_callee = intern("alloc__Point") }
    unsafe { (*fixture.call).type_args.push(new_type_ref(no_span(), TypeRefKind.Named(intern("Point"), List.new<TypeRef>()))) }
    fixture.module.qualify_type_symbols()
    val callee_ok = unsafe { (*fixture.call).mangled_callee.as_str() } == "alloc__aa__Point"
    val arg = unsafe { *(*fixture.call).type_args.at(0) }
    var arg_ok = false
    when (arg.kind) {
        Named(name, _args) => { arg_ok = name.as_str() == "aa__Point" }
        _ => {}
    }
    assert_eq(callee_ok && arg_ok, true, "generic intrinsic fragments and type arguments use qualified types")
}

@test
fun type_phase_leaves_function_names_alone(): void {
    var f = build_fixture()
    f.module.qualify_type_symbols()
    assert_eq(f.module.decl_name_at(1), "answer", "function names wait for the function phase")
}

@test
fun function_phase_renames_free_functions(): void {
    var f = build_fixture()
    f.module.qualify_function_symbols()
    assert_eq(f.module.decl_name_at(1), "aa__answer", "free function gains its crate prefix")
}

@test
fun function_phase_retargets_call_mangles(): void {
    var f = build_fixture()
    unsafe { (*f.call).mangled_callee = intern("helper") }
    f.module.qualify_function_symbols()
    val e = unsafe { *f.call }
    assert_eq(e.mangled_callee.as_str(), "aa__helper", "call sites follow the renamed callee")
}

// A statement whose expressions hang off a Box payload is walked through the
// real AST, not a copy.
@test
fun call_nested_under_an_if_is_retargeted(): void {
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.Call(intern("helper"), List.new<Expr>())) }
    unsafe { call.mangled_callee = intern("helper") }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.If(call, List.new<Stmt>(), List.new<Stmt>())))
    val fn_kind = TopDeclKind.Function(List.new<Param>(), ty_ptr_named("int32"), body, true, false, false, false)
    val helper_kind = TopDeclKind.Function(List.new<Param>(), ty_ptr_named("int32"), List.new<Stmt>(), true, false, false, false)
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("checker"), fn_kind)))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("helper"), helper_kind)))
    var m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    m.qualify_function_symbols()
    val e = unsafe { *call }
    assert_eq(e.mangled_callee.as_str(), "aa__helper", "Box-payload statements walk the real AST")
}

@test
fun function_phase_ignores_unrelated_mangles(): void {
    var f = build_fixture()
    unsafe { (*f.call).mangled_callee = intern("runtime_println") }
    f.module.qualify_function_symbols()
    val e = unsafe { *f.call }
    assert_eq(e.mangled_callee.as_str(), "runtime_println", "runtime callees keep their names")
}

@test
fun function_phase_preserves_imported_method_links(): void {
    var f = build_fixture()
    unsafe { (*f.call).mangled_callee = intern("dep__Point_show_exact") }
    f.module.qualify_function_symbols()
    val e = unsafe { *f.call }
    assert_eq(e.mangled_callee.as_str(), "dep__Point_show_exact", "compiled method links remain exact")
}

@test
fun function_phase_recovers_a_unique_raw_method_call(): void {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("point"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern("sum"), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    val method = stamp_owner(new_top_decl(no_span(), String.from("sum"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("int32"), List.new<Stmt>(), true, false, false, false)))
    var methods = List.new<TopDecl>()
    methods.push(method)
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Point"), TopDeclKind.ImplBlock(methods))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("use_point"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("void"), body, true, false, false, false))))
    var module = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    module.qualify_function_symbols()
    assert_eq(unsafe { call.mangled_callee.as_str() }, "aa__Point_sum", "a unique raw method can recover its owner symbol")
}

@test
fun function_phase_recovers_a_normalized_trait_method_call(): void {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("point"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern("score"), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    val method = stamp_owner(new_top_decl(no_span(), String.from("score__Score"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("int32"), List.new<Stmt>(), true, false, false, false)))
    var methods = List.new<TopDecl>()
    methods.push(method)
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Point"), TopDeclKind.ImplBlock(methods))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("use_point"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("void"), body, true, false, false, false))))
    var module = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    module.qualify_function_symbols()
    assert_eq(unsafe { call.mangled_callee.as_str() }, "aa__Point_score__Score", "a normalized trait method retains its trait suffix")
}

@test
fun function_phase_does_not_guess_a_runtime_method_owner(): void {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("text"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern("as_str"), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    val method = stamp_owner(new_top_decl(no_span(), String.from("as_str"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("str"), List.new<Stmt>(), true, false, false, false)))
    var methods = List.new<TopDecl>()
    methods.push(method)
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Path"), TopDeclKind.ImplBlock(methods))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("use_text"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("void"), body, true, false, false, false))))
    var module = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    module.qualify_function_symbols()
    assert_eq(unsafe { call.mangled_callee.as_str() }, "", "runtime method names are never guessed from user declarations")
}

// A rebuilt static callee keeps its trait identity and type arguments.
@test fun static_callee_tail_keeps_the_trait_identity(): void {
    val t = static_callee_tail("Cel_from__From__int32", "from")
    assert_eq(t.equals("__From__int32"), true, "the trait tail survives the rebuild")
}

@test fun static_callee_tail_is_empty_for_an_inherent_static(): void {
    val t = static_callee_tail("Path_new", "new")
    assert_eq(t.equals(""), true, "an inherent static call has no tail")
}

// The trait tail follows the last `_<method>` segment.
@test fun static_callee_tail_takes_the_last_match(): void {
    val t = static_callee_tail("Wrap_from_from__From__bool", "from")
    assert_eq(t.equals("__From__bool"), true, "the last _<method> match bounds the tail")
}

@test fun static_callee_tail_is_empty_when_the_method_is_absent(): void {
    val t = static_callee_tail("Cel_into", "from")
    assert_eq(t.equals(""), true, "no match yields no tail")
}

// A trait-qualified receiver names the trait, not the callee's type.
@test fun callee_owner_is_the_type_segment(): void {
    assert_eq(static_callee_owner("Cel_from__From__int32").equals("Cel"), true, "the owner is the segment before the first single underscore")
}

@test fun callee_owner_strips_a_mono_suffix(): void {
    assert_eq(static_callee_owner("Box__int32_new").equals("Box"), true, "a monomorphized owner compares as its template")
}

@test fun an_ordinary_static_call_targets_its_receiver(): void {
    assert_eq(callee_targets_receiver("Cel_from__From__int32", "Cel", "from"), true, "Cel.from is rebuilt around Cel")
}

@test fun a_generic_static_call_targets_its_receiver(): void {
    assert_eq(callee_targets_receiver("Box__int32_new", "Box", "new"), true, "Box.new<int32> is rebuilt around Box")
}

@test fun a_trait_qualified_call_does_not_target_its_receiver(): void {
    assert_eq(callee_targets_receiver("Item_label__First", "First", "label"), false, "First.label is NOT rebuilt around the trait")
}

@test fun an_unstamped_callee_keeps_the_rebuild_path(): void {
    assert_eq(callee_targets_receiver("", "Path", "new"), true, "no stamped callee means rebuild as before")
}

// A trait-impl instance call carries the trait tail.
@test fun a_trait_impl_instance_call_targets_its_receiver(): void {
    assert_eq(instance_callee_targets_receiver("Item_make__Producer", "make", "Item"), true, "item.make() is rebuilt around Item")
}

@test fun an_instance_callee_for_another_type_is_left_alone(): void {
    assert_eq(instance_callee_targets_receiver("Other_make__Producer", "make", "Item"), false, "a callee owned by a different type is not rebuilt")
}

// Shapes the other branches handle.
@test fun an_unstamped_instance_callee_is_not_this_branch(): void {
    assert_eq(instance_callee_targets_receiver("", "make", "Item"), false, "an empty callee belongs to the owner-rebuild branch")
}

@test fun a_bare_method_name_callee_is_not_this_branch(): void {
    assert_eq(instance_callee_targets_receiver("make", "make", "Item"), false, "a bare method name belongs to the owner-rebuild branch")
}

@test fun a_monomorphized_instance_receiver_targets_its_callee(): void {
    assert_eq(instance_callee_targets_receiver("List__int32_push", "push", "List__int32"), true, "a mono receiver is rebuilt around its qualified spelling")
}

@test fun an_instance_callee_needs_a_receiver_type(): void {
    assert_eq(instance_callee_targets_receiver("Item_make__Producer", "make", ""), false, "an unresolved receiver type is never rebuilt around")
}

// A trait impl on a generic struct matches its owner as written.
@test fun a_trait_impl_on_a_generic_receiver_targets_it(): void {
    assert_eq(instance_callee_targets_receiver("Twice__Counter_pull__Src", "pull", "Twice__Counter"), true, "an adapter's trait method is rebuilt around its instance")
}

@test fun callee_owner_as_written_keeps_the_mono_suffix(): void {
    assert_eq(static_callee_owner_mangled("Box__int32_new").equals("Box__int32"), true, "the owner as written is the whole segment before the method")
}

// An owner may contain `_`: every lambda is `Lambda_<fn>_<n>`, and
// `Dbl_2.from(5)` stamps `Dbl_2_from__From__int32`.
@test fun a_static_owner_containing_an_underscore_still_matches(): void {
    assert_eq(callee_targets_receiver("Dbl_2_from__From__int32", "Dbl_2", "from"), true, "an underscore in the type name does not hide the static method boundary")
}

// Still not rebuilt around a trait receiver.
@test fun an_underscored_trait_receiver_is_still_left_alone(): void {
    assert_eq(callee_targets_receiver("Item_label__First_2", "First_2", "label"), false, "a trait receiver does not own the callee")
}

@test fun an_owner_containing_an_underscore_still_matches(): void {
    assert_eq(instance_callee_targets_receiver("Dbl_2_call__Call1__int32", "call", "Dbl_2"), true, "an underscore in the type name does not hide the method boundary")
}

@test fun a_lambda_owner_matches_its_own_callee(): void {
    assert_eq(instance_callee_targets_receiver("Lambda_main_0_call__Call1__int32", "call", "Lambda_main_0"), true, "a synthesized lambda owns its trait method")
}

@test fun an_underscored_owner_inside_a_mono_instance_matches(): void {
    assert_eq(instance_callee_targets_receiver("MapIter__Counter__Dbl_2_next__Iterator__int32", "next", "MapIter__Counter__Dbl_2"), true, "the instance is matched whole, not reassembled from segments")
}

// A longer type starting with the receiver's name must not match.
@test fun a_prefix_landing_mid_identifier_does_not_match(): void {
    assert_eq(instance_callee_targets_receiver("Items_make__Producer", "make", "Item"), false, "`Item` does not own `Items_make`")
}

@test fun a_matched_callee_reports_its_trait_tail(): void {
    val split = callee_method_tail("List__Decl_iter__Iterable__Decl", "List__Decl", "iter")
    assert_eq(split.matched, true, "the callee is spelled around its owner and method")
    assert_eq(split.tail.as_str(), "__Iterable__Decl", "the tail is everything past the method segment")
}

@test fun an_unmatched_callee_reports_no_tail(): void {
    val split = callee_method_tail("Other_make__Producer", "Item", "make")
    assert_eq(split.matched, false, "a callee owned by another type does not split")
}

// `impl Equal for int32` defines `int32_equals`.
@test fun a_primitive_receiver_owns_its_methods(): void {
    val ty = Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(no_span()) }
    assert_eq(qualified_method_owner(ty).as_str(), "int32", "an int32 receiver names int32 as its method owner")
}

@test fun an_enum_receiver_owns_its_methods(): void {
    val ty = Type { kind: TypeKind.EnumTy(intern("Color")), provenance: Provenance.Inferred(no_span()) }
    assert_eq(qualified_method_owner(ty).as_str(), "Color", "an enum names itself as its method owner")
}

@test fun a_str_receiver_owns_its_methods(): void {
    val ty = Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
    assert_eq(qualified_method_owner(ty).as_str(), "str", "a str receiver names str as its method owner")
}

// An associated-type binding is a type position: Mono reads it after this
// pass.

fun build_binding_fixture(): Module {
    var members = List.new<TopDecl>()
    members.push(stamp_owner(new_top_decl(no_span(), String.from("Out"), TopDeclKind.AssocTypeBinding(ty_ptr_named("Cursor")))))
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Cursor"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Widget"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Widget"), TopDeclKind.TraitImpl(ty_ptr_named("Producer"), members))))
    return Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun Module.binding_choice_name(): String {
    val td = *self.decls.at(2)
    when (td.kind) {
        TraitImpl(_tref, members) => {
            val member = *members.at(0)
            when (member.kind) {
                AssocTypeBinding(chosen) => {
                    val tr: TypeRef = unsafe { *chosen }
                    when (tr.kind) {
                        Named(n, _args) => return n.as_string()
                        _ => return ""
                    }
                }
                _ => return ""
            }
        }
        _ => return ""
    }
}

@test fun type_phase_qualifies_an_assoc_binding_choice(): void {
    var m = build_binding_fixture()
    assert_eq(m.binding_choice_name().as_str(), "Cursor", "the fixture starts unqualified")
    m.qualify_type_symbols()
    assert_eq(m.binding_choice_name().as_str(), "aa__Cursor", "the chosen type is renamed like any other type position")
}
