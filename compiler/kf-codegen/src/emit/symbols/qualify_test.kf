import alloc.list.*
import core.assert.assert_eq
import core.assert.fail

import kf_core.span.no_span
import kf_core.ast.*

@test
fun qualified_method_owner_returns_owned_str(): void {
    val ty = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Inferred(no_span()) }
    val owner: String = qualified_method_owner(ty)
    assert_eq(owner.as_str(), "Point", "qualified method owners are owned String values")
}

// Crate "aa":
//   struct Point { }
//   fun answer(p: Point): int32 { return helper() }
//   fun helper(): int32 { }
// The Call's Ptr is returned so a test can stamp its mangled_callee.
struct QualifyFixture {
    pub var module: Module
    pub val call: Ptr<Expr>
}

fun ty_ptr_named(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = new_type_ref(no_span(), TypeRefKind.Named(intern(s), List.new<TypeRef>())) }
    return rp
}

fun stamp_owner(td: TopDecl): TopDecl {
    var owned = td
    owned.crate = new_crate_id("aa")
    owned.module_path = intern("aa.lib")
    return owned
}

fun build_fixture(): QualifyFixture {
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.Call(intern("helper"), List.new<Expr>())) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Return(ret_op(call))))
    var params = List.new<Param>()
    params.push(new_param(no_span(), String.from("p"), ty_ptr_named("Point")))
    val answer_kind = TopDeclKind.Function(params, ty_ptr_named("int32"), body, true, false, false, false)
    val helper_kind = TopDeclKind.Function(List.new<Param>(), ty_ptr_named("int32"), List.new<Stmt>(), true, false, false, false)
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("answer"), answer_kind)))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("helper"), helper_kind)))
    val m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    return QualifyFixture { module: m, call: call }
}

fun Module.decl_name_at(i: uint64): str {
    return self.decls.at(i).name.as_str()
}

fun Module.answer_param_type_name(): String {
    val td = *self.decls.at(1)
    when (td.kind) {
        Function(params, _r, _b, _pub, _u, _mut, _st) => {
            val p = *params.at(0)
            val tr: TypeRef = unsafe { *p.ty }
            when (tr.kind) {
                Named(n, _args) => return n.as_string()
                _ => return ""
            }
        }
        _ => return ""
    }
}

@test
fun type_phase_renames_the_struct_decl(): void {
    var f = build_fixture()
    f.module.qualify_type_symbols()
    assert_eq(f.module.decl_name_at(0), "aa__Point", "struct decl gains its crate prefix")
}

@test
fun type_phase_rewrites_param_type_refs(): void {
    var f = build_fixture()
    f.module.qualify_type_symbols()
    assert_eq(f.module.answer_param_type_name().as_str(), "aa__Point", "param TypeRef follows the renamed struct")
}

@test
fun type_phase_preserves_an_already_qualified_resolved_type(): void {
    var f = build_fixture()
    unsafe {
        (*f.call).ty = Type {
            kind: TypeKind.Struct(intern("aa__Point")),
            provenance: Provenance.Inferred(no_span())
        }
    }
    f.module.qualify_type_symbols()
    val ty = unsafe { (*f.call).ty }
    when (ty.kind) {
        Struct(name) => assert_eq(name.as_str(), "aa__Point", "qualified resolved types stay stable")
        _ => fail("expected struct type")
    }
}

@test
fun type_phase_preserves_a_qualified_compound_type(): void {
    var fixture = build_fixture()
    unsafe {
        (*fixture.call).ty = Type {
            kind: TypeKind.Struct(intern("List__aa__Point")),
            provenance: Provenance.Inferred(no_span())
        }
    }
    fixture.module.qualify_type_symbols()
    val ty = unsafe { (*fixture.call).ty }
    when (ty.kind) {
        Struct(name) => assert_eq(name.as_str(), "List__aa__Point", "qualified compound types stay stable")
        _ => fail("expected struct type")
    }
}

@test
fun type_phase_rebuilds_a_generic_static_callee(): void {
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = new_expr(no_span(), ExprKind.Variable(intern("List"))) }
    val call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call = new_expr(no_span(), ExprKind.MethodCall(recv, intern("new"), List.new<Expr>())) }
    unsafe { call.is_static_call = true }
    unsafe { call.mangled_callee = intern("List__Point_new") }
    unsafe { call.type_args.push(new_type_ref(no_span(), TypeRefKind.Named(intern("Point"), List.new<TypeRef>()))) }
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Expression(call)))
    var decls = List.new<TopDecl>()
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(stamp_owner(new_top_decl(no_span(), String.from("make"), TopDeclKind.Function(List.new<Param>(), ty_ptr_named("void"), body, true, false, false, false))))
    var module = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    module.qualify_type_symbols()
    assert_eq(unsafe { call.mangled_callee.as_str() }, "List__aa__Point_new", "static generic callees use qualified type arguments")
}

