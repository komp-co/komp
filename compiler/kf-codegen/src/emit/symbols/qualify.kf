// Applies crate-qualified renames to a merged module in two phases:
//
//   qualify_type_symbols      after TypeCheck, before Mono, so every name
//                             Mono derives is built from qualified types.
//   qualify_function_symbols  after Lower, through each call's
//                             mangled_callee, which is assignable in place.
//
// Unity builds call neither. Folded intrinsic callees (`alloc__T`) keep
// unqualified fragments, and generic templates are not qualified.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.intern_string
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*

import kf_core.ast.subst.subst_dyn_layouts
import kf_core.ast.subst.subst_dyn_vtables
import kf_core.ast.subst.subst_type_ref

/// Structs and enums become `<crate>__<name>`, and every reference to them
/// is respelled.
pub mutating fun Module.qualify_type_symbols(): void {
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    self.collect_type_renames(&var names, &var repls)
    if names.size() == 0 { return }
    while i in 0..self.decls.size() {
        qualify_decl(self.decls.at_mut(i), &var names, &var repls, true)
    }
}

/// Free functions become `<crate>__<name>`, with matching Call callees.
pub mutating fun Module.qualify_function_symbols(): void {
    var names = List.new<String>()
    var repls = List.new<TypeRef>()
    self.collect_fn_renames(&var names, &var repls)
    if names.size() == 0 { return }
    while i in 0..self.decls.size() {
        qualify_decl(self.decls.at_mut(i), &var names, &var repls, false)
    }
}

// Signatures and bodies are walked in both phases; a table entry only
// matches its own phase's names.
mutating fun TopDecl.qualify_decl(names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    if rename_types {
        self.dyn_layouts = subst_dyn_layouts(&self.dyn_layouts, names, repls)
        self.dyn_vtables = subst_dyn_vtables(&self.dyn_vtables, names, repls)
    }
    when (self.kind) {
        Struct(fields, _pub) => {
            if !rename_types { return }
            self.rename_decl_if_mapped(names, repls)
            qualify_field_list(fields, names, repls)
        }
        EnumDecl(variants, _pub) => {
            if !rename_types { return }
            self.rename_decl_if_mapped(names, repls)
            qualify_variant_list(&var variants, names, repls)
        }
        Function(params, ret, body, _pub, _u, _mut, _st) => {
            if rename_types {
                qualify_param_list(params, names, repls)
                qualify_tyref_ptr(ret, names, repls)
            } else {
                self.rename_decl_if_mapped(names, repls)
            }
            qualify_stmt_list(body, names, repls, rename_types)
        }
        Extern(params, ret, _pub, _u) => {
            if !rename_types { return }
            qualify_param_list(params, names, repls)
            qualify_tyref_ptr(ret, names, repls)
        }
        ImplBlock(methods) => {
            if rename_types { self.rename_decl_if_mapped(names, repls) }
            qualify_method_list(methods, names, repls, rename_types)
        }
        TraitImpl(tref, methods) => {
            if rename_types { self.rename_decl_if_mapped(names, repls) }
            // The trait reference is a type position, and a literal argument
            // (`impl Call1<Point> for GetX`) is spelled only here. Mono builds
            // the dispatch suffix from it, so it must match the qualified call
            // sites.
            if rename_types { qualify_tyref_ptr(tref, names, repls) }
            qualify_method_list(methods, names, repls, rename_types)
        }
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        TraitDecl(_meths, _pub, _) => return
        Poison => return
    }
}

mutating fun TopDecl.rename_decl_if_mapped(names: &var List<String>, repls: &var List<TypeRef>): void {
    val hit = rename_lookup(self.name.as_str(), names, repls)
    if hit.as_str().byte_len() == 0 { return }
    self.name = intern_string(hit)
}

fun qualify_method_list(methods: &List<TopDecl>, names: &var List<String>, repls: &var List<TypeRef>, rename_types: bool): void {
    while mth in &methods {
        when (mth.kind) {
            Function(params, ret, body, _pub, _u, _mut, _st) => {
                if rename_types {
                    qualify_param_list(params, names, repls)
                    qualify_tyref_ptr(ret, names, repls)
                }
                qualify_stmt_list(body, names, repls, rename_types)
            }
            // A binding names a type, and Mono reads it after this pass.
            AssocTypeBinding(chosen) => { if rename_types { qualify_tyref_ptr(chosen, names, repls) } }
            _ => {}
        }
    }
}

fun qualify_field_list(fields: &List<Field>, names: &var List<String>, repls: &var List<TypeRef>): void {
    while f in &fields {
        qualify_tyref_ptr(f.ty, names, repls)
    }
}

fun qualify_variant_list(variants: &var List<Variant>, names: &var List<String>, repls: &var List<TypeRef>): void {
    while vi in 0..variants.size() {
        val v = variants.at_mut(vi)
        while j in 0..v.payloads.size() {
            val pp: Ptr<TypeRef> = unsafe { v.payloads.at_mut(j) as Ptr<TypeRef> }
            qualify_tyref_ptr(pp, names, repls)
        }
    }
}

fun qualify_param_list(params: &List<Param>, names: &var List<String>, repls: &var List<TypeRef>): void {
    while p in &params {
        qualify_tyref_ptr(p.ty, names, repls)
    }
}

/// A null (inferred) annotation passes through.
pub fun qualify_tyref_ptr(popt: Ptr<TypeRef>?, names: &var List<String>, repls: &var List<TypeRef>): void {
    val p = popt ?: return
    val next = subst_type_ref(unsafe { &*p }, names, repls)
    unsafe { *p = next }
}
