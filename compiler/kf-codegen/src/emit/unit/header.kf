// `<crate>.h`, what a consumer compiles against: complete layouts for public
// types and their by-value closure (C needs private embedded bytes), enum
// tags, static-inline glue for those types, generic layouts the surface
// references, and prototypes for public functions and methods. Never bodies.

import alloc.list.*

import kf_core.ast.CrateId
import kf_core.ast.Import
import kf_core.ast.Module
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl

import kf_codegen.concat_all
import kf_codegen.emit.mangle_named
import kf_codegen.emit.dyn_traits.*
import kf_codegen.emit.glue.*

pub fun Module.emit_crate_header(crate_name: String, deps: &List<String>): String {
    return self.emit_crate_header_supported(self, crate_name, deps)
}

/// A generic instance named by the public ABI must be complete here too.
pub fun Module.emit_crate_header_supported(m: &Module, crate_name: String, deps: &List<String>): String {
    var parts = List.new<String>()
    parts.push(header_guard_open(crate_name))
    parts.push(dep_include_lines(deps))
    parts.push(self.emit_owned_dyn_forward_decls())
    val hview = self.header_type_view()
    val layouts = self.header_layout_view(&hview, m)
    parts.push(layouts.emit_type_forward_decls())
    parts.push(layouts.emit_enum_tags())
    // After type forward decls and before bodies, as in the source. Instances
    // a vtable names appear nowhere else in the header.
    parts.push(self.emit_dyn_surface_forward_decls())
    parts.push(self.emit_owned_dyn_layouts())
    parts.push(self.emit_owned_dyn_vtable_declarations())
    parts.push(layouts.emit_type_bodies_ordered())
    parts.push(hview.emit_public_glue_declarations())
    parts.push(hview.emit_struct_news())
    parts.push(self.public_fn_protos())
    parts.push(String.from("#endif\n"))
    return concat_all(parts)
}

// Public types plus the generic layouts they embed or name. Dependency types
// stay in dependency headers.
pub fun Module.header_layout_view(hview: &Module, m: &Module): Module {
    var names = List.new<String>()
    while td in &hview.decls {
        when (td.kind) {
            Struct(_f, _p) => names.push(td.name.as_string())
            EnumDecl(_v, _p) => names.push(td.name.as_string())
            _ => {}
        }
    }
    self.collect_public_signature_layouts(m, &var names)
    var k = 0
    while k < names.size() {
        val dependencies = named_type_deps(*names.at(k), m)
        while dependency in &dependencies {
            if !name_list_contains(&names, dependency.as_str()) {
                if m.module_has_header_layout(dependency.as_str(), self.crate) {
                    names.push(dependency)
                }
            }
        }
        k = k + 1
    }
    var decls = List.new<TopDecl>()
    while td in &m.decls {
        if name_list_contains(&names, td.name.as_str()) {
            if header_layout_decl(td, self.crate) { decls.push(td.deep_clone_top_decl()) }
        }
    }
    return Module { crate: self.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun Module.module_has_header_layout(name: str, crate: CrateId): bool {
    while td in &self.decls {
        if td.name.as_str() == name && header_layout_decl(td, crate) { return true }
    }
    return false
}

fun header_layout_decl(td: TopDecl, crate: CrateId): bool {
    if !td.crate.is_poison() {
        if td.crate.raw != crate.raw && !td.linkage.is_template() { return false }
    }
    return when (td.kind) {
        Struct(_f, _p) => true
        EnumDecl(_v, _p) => true
        _ => false
    }
}

fun Module.collect_public_signature_layouts(m: &Module, names: &var List<String>): void {
    while td in &self.decls {
        when (td.kind) {
            Function(params, ret, _b, is_pub, _u, _mut, _st) => {
                if is_pub { collect_layout_signature(params, ret, m, self.crate, names) }
            }
            ImplBlock(methods) => {
                while method in &methods {
                    when (method.kind) {
                        Function(params, ret, _b, _pub, _u, _mut, _st) => {
                            if self.method_is_header_export(td.name.as_str(), method) {
                                collect_layout_signature(params, ret, m, self.crate, names)
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
    }
}

fun collect_layout_signature(params: &List<Param>, ret: Ptr<TypeRef>, m: &Module, crate: CrateId, names: &var List<String>): void {
    while param in &params {
        // CONSTRAINT: `at`, not `get`: a copied Param's shallow TypeRef read
        // points into a temporary that dies with the statement.
        collect_layout_tyref(unsafe { *param.ty }, m, crate, names)
    }
    collect_layout_tyref(unsafe { *ret }, m, crate, names)
}

fun collect_layout_tyref(ty: TypeRef, m: &Module, crate: CrateId, names: &var List<String>): void {
    when (ty.kind) {
        Named(name, args) => {
            while arg in &args {
                collect_layout_tyref(arg, m, crate, names)
            }
            val concrete = if args.size() == 0 { name.as_string() } else { mangle_named(name.as_string(), args) }
            if !name_list_contains(names, concrete.as_str()) {
                if m.module_has_header_layout(concrete.as_str(), crate) { names.push(concrete) }
            }
        }
        Reference(_mut, inner) => collect_layout_tyref(unsafe { *inner }, m, crate, names)
        Function(params, ret) => {
            while param in &params {
                collect_layout_tyref(param, m, crate, names)
            }
            collect_layout_tyref(unsafe { *ret }, m, crate, names)
        }
        _ => {}
    }
}

pub fun header_guard_open(crate_name: String): String {
    val out = "// generated by komp\n#ifndef KF_CRATE_${crate_name.as_str()}_H\n#define KF_CRATE_${crate_name.as_str()}_H\n\n#include \"kf_runtime.h\"\n"
    return out
}

pub fun dep_include_lines(deps: &List<String>): String {
    var out = ""
    while dep in &deps {
        out.append("#include \"")
        out.append(dep.as_str())
        out.append(".h\"\n")
    }
    out.append("\n")
    return out
}

/// Public types, their by-value closure, and every impl block as lookup
/// context for glue.
pub fun Module.header_type_view(): Module {
    var names = List.new<String>()
    while td in &self.decls {
        if type_decl_is_pub(td) {
            names.push(td.name.as_string())
        }
    }
    var k = 0
    while k < names.size() {
        val deps = by_value_type_deps(*names.at(k), self)
        while d in &deps {
            if !name_list_contains(&names, d.as_str()) {
                if self.module_has_type_decl(d.as_str()) {
                    names.push(d)
                }
            }
        }
        k = k + 1
    }
    var decls = List.new<TopDecl>()
    while td in &self.decls {
        var keep = false
        when (td.kind) {
            Struct(_f, _p) => { keep = name_list_contains(&names, td.name.as_str()) }
            EnumDecl(_v, _p) => { keep = name_list_contains(&names, td.name.as_str()) }
            ImplBlock(_m) => { keep = true }
            TraitImpl(_t, _m) => { keep = true }
            _ => {}
        }
        if keep {
            decls.push(td.deep_clone_top_decl())
        }
    }
    return Module { crate: self.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun type_decl_is_pub(td: TopDecl): bool {
    return when (td.kind) {
        Struct(_f, is_pub) => is_pub
        EnumDecl(_v, is_pub) => is_pub
        _ => false
    }
}

fun Module.module_has_type_decl(name: str): bool {
    while td in &self.decls {
        if td.name.as_str() == name {
            when (td.kind) {
                Struct(_f, _p) => return true
                EnumDecl(_v, _p) => return true
                _ => {}
            }
        }
    }
    return false
}

fun name_list_contains(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

/// Forward typedefs for instances a vtable slot names; a function pointer may
/// return an incomplete type.
fun Module.emit_dyn_surface_forward_decls(): String {
    val names = self.dyn_surface_instantiations()
    var seen = List.new<String>()
    var parts = List.new<String>()
    while n in &names {
        if !string_list_has(&seen, n.as_str()) {
            seen.push(n.clone())
            parts.push("typedef struct ${n} ${n};\n")
        }
    }
    if seen.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

fun string_list_has(xs: &List<String>, target: str): bool {
    while item in &xs {
        if item.as_str().equals(target) { return true }
    }
    return false
}

/// Every instance a vtable slot mentions must be declared where the vtable
/// struct lands.
fun Module.dyn_surface_instantiations(): List<String> {
    var out = List.new<String>()
    val layouts = self.collect_owned_codegen_dyn_layouts()
    while layout in &layouts {
        while slot in &layout.methods {
            slot.ret.collect_type_instance(&var out)
            while param in &slot.params {
                param.collect_type_instance(&var out)
            }
        }
    }
    return out
}

fun Type.collect_type_instance(out: &var List<String>): void {
    when (self.kind) {
        Struct(name) => out.push(name.as_string())
        EnumTy(name) => out.push(name.as_string())
        _ => { }
    }
}
