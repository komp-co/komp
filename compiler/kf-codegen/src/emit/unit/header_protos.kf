import alloc.list.*

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl

import kf_codegen.concat_all
import kf_codegen.emit.emit_fn_forward
import kf_codegen.emit.emit_method_forward
import kf_codegen.emit.method_emits_code

pub fun Module.public_fn_protos(): String {
    var parts = List.new<String>()
    while td in &self.decls {
        when (td.kind) {
            Function(_p, _r, _b, is_pub, _u, _mut, _st) => {
                if is_pub && td.name.as_str() != "main" { parts.push(emit_fn_forward(td)) }
            }
            Extern(_p, _r, is_pub, _u) => {
                // Only public externs are consumer ABI.
                if is_pub { parts.push(emit_fn_forward(td)) }
            }
            ImplBlock(methods) => self.append_public_method_protos(td.name.as_str(), &methods, &var parts)
            _ => { }
        }
    }
    parts.push(String.from("\n"))
    return concat_all(parts)
}

fun Module.append_public_method_protos(target: str, methods: &List<TopDecl>, parts: &var List<String>): void {
    while method in &methods {
        // Trait methods are exported without `pub`; private inherent methods
        // are not.
        if self.method_is_header_export(target, method) {
            parts.push(emit_method_forward(String.from(target), method))
        }
    }
}

fun Module.impl_target_is_pub(name: str): bool {
    if is_runtime_type_name(name) { return true }
    val list_name = self.lang_type_name(lang_list_key())
    val option_name = self.lang_type_name(lang_option_key())
    if is_container_type_name(name, list_name, option_name) { return true }
    while td in &self.decls {
        if td.name.as_str().equals(name) {
            when (td.kind) {
                Struct(_fields, is_pub) => return is_pub
                EnumDecl(_variants, is_pub) => return is_pub
                _ => { }
            }
        }
    }
    return false
}

fun Module.method_is_header_export(target: str, method: TopDecl): bool {
    return method.method_emits_code() && self.impl_target_is_pub(target) && (method_is_pub(method) || method.from_trait_impl)
}

pub fun method_is_pub(method: TopDecl): bool {
    return when (method.kind) {
        Function(_p, _r, _b, is_pub, _u, _mut, _st) => is_pub
        _ => false
    }
}
