import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

import kf_codegen.runtime.emit_runtime_header
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

// One crate's export surface:
//   pub struct Point { x: int32, inner: Inner, s: String }
//   struct Inner { v: int32 }          (private, embedded by value)
//   struct Hidden { v: int32 }         (private, unreferenced)
//   impl Point { pub fun sum(); fun secret() }
//   pub fun pick(o: Option<int32>): int32
//   fun internal(): int32

fun hdr_ty_ptr(name: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(no_span(), TypeRefKind.Named(intern(name), List.new<TypeRef>())) }
    return rp
}

fun hdr_option_int32_ptr(): Ptr<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(no_span(), TypeRefKind.Named(intern("Option"), args)) }
    return rp
}

fun hdr_struct(name: str, fields: List<Field>, is_pub: bool): TopDecl {
    return new_top_decl(no_span(), String.from(name), TopDeclKind.Struct(fields, is_pub))
}

fun hdr_fn(name: str, params: List<Param>, is_pub: bool): TopDecl {
    return new_top_decl(no_span(), String.from(name), TopDeclKind.Function(params, hdr_ty_ptr("int32"), List.new<Stmt>(), is_pub, false, false, false))
}

pub fun hdr_view(): Module {
    var point_fields = List.new<Field>()
    point_fields.push(new_field(no_span(), String.from("x"), hdr_ty_ptr("int32"), false, true))
    point_fields.push(new_field(no_span(), String.from("inner"), hdr_ty_ptr("Inner"), false, false))
    point_fields.push(new_field(no_span(), String.from("s"), hdr_ty_ptr("String"), false, true))
    var inner_fields = List.new<Field>()
    inner_fields.push(new_field(no_span(), String.from("v"), hdr_ty_ptr("int32"), false, true))
    var hidden_fields = List.new<Field>()
    hidden_fields.push(new_field(no_span(), String.from("v"), hdr_ty_ptr("int32"), false, true))
    var methods = List.new<TopDecl>()
    methods.push(hdr_fn("sum", List.new<Param>(), true))
    methods.push(hdr_fn("secret", List.new<Param>(), false))
    // What mono produces for `impl Equal for Point`: not pub, from_trait_impl.
    var trait_method = hdr_fn("equals", List.new<Param>(), false)
    trait_method.from_trait_impl = true
    methods.push(trait_method)
    var primitive_methods = List.new<TopDecl>()
    var primitive_trait_method = hdr_fn("display", List.new<Param>(), false)
    primitive_trait_method.from_trait_impl = true
    primitive_methods.push(primitive_trait_method)
    var pick_params = List.new<Param>()
    pick_params.push(new_param(no_span(), String.from("o"), hdr_option_int32_ptr()))
    var decls = List.new<TopDecl>()
    decls.push(hdr_struct("Point", point_fields, true))
    decls.push(hdr_struct("Inner", inner_fields, false))
    decls.push(hdr_struct("Hidden", hidden_fields, false))
    decls.push(new_top_decl(no_span(), String.from("Point"), TopDeclKind.ImplBlock(methods)))
    decls.push(new_top_decl(no_span(), String.from("int32"), TopDeclKind.ImplBlock(primitive_methods)))
    decls.push(hdr_fn("pick", pick_params, true))
    decls.push(hdr_fn("internal", List.new<Param>(), false))
    // The materialized Option__int32 named by `pick`.
    decls.push(hdr_option_int32_enum())
    return Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun hdr_option_int32_enum(): TopDecl {
    var some_pay = List.new<TypeRef>()
    some_pay.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())))
    var variants = List.new<Variant>()
    variants.push(new_variant(no_span(), String.from("Some"), some_pay))
    variants.push(new_variant(no_span(), String.from("None"), List.new<TypeRef>()))
    var td = new_top_decl(no_span(), String.from("Option__int32"), TopDeclKind.EnumDecl(variants, true))
    td.linkage = Linkage.GenericTemplate
    return td
}

fun emit_hdr(): String {
    val view = hdr_view()
    // `Point` has a `String` field, so the header includes `alloc.h`.
    var deps = List.new<String>()
    deps.push(String.from("alloc"))
    return view.emit_crate_header(String.from("aa"), &deps)
}

fun emit_private_method_hdr(): String {
    var fields = List.new<Field>()
    fields.push(new_field(no_span(), String.from("v"), hdr_ty_ptr("int32"), false, true))
    var methods = List.new<TopDecl>()
    methods.push(new_top_decl(no_span(), String.from("copy"), TopDeclKind.Function(List.new<Param>(), hdr_ty_ptr("Widget"), List.new<Stmt>(), true, false, false, false)))
    var decls = List.new<TopDecl>()
    decls.push(hdr_struct("Widget", fields, false))
    decls.push(new_top_decl(no_span(), String.from("Widget"), TopDeclKind.ImplBlock(methods)))
    val view = Module { crate: new_crate_id("private_method"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val deps = List.new<String>()
    return view.emit_crate_header(String.from("private_method"), &deps)
}

@test
fun header_carries_public_type_layouts(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "typedef struct Point {"), true, "public struct layout is ABI-visible")
}

@test
fun header_pulls_by_value_embedded_private_types(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "typedef struct Inner {"), true, "embedded private layout completes the public one")
}

@test
fun header_omits_unreferenced_private_types(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "Hidden"), false, "implementation-only types stay out")
}

@test
fun header_declares_external_glue(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "void Point__glue_drop(Point v);"), true, "consumers call ownership glue from the archive")
}

@test
fun header_declares_public_methods_only(): void {
    val h = emit_hdr()
    val has_pub = hdr_contains(h.as_str(), "Point_sum(Point* __self);")
    val has_priv = hdr_contains(h.as_str(), "secret")
    assert_eq(has_pub && !has_priv, true, "method protos follow method visibility")
}

@test
fun test_header_omits_private_target_method_surface(): void {
    val h = emit_private_method_hdr()
    val has_method = hdr_contains(h.as_str(), "Widget_copy")
    val has_type = hdr_contains(h.as_str(), "typedef struct Widget")
    assert_eq(!has_method && !has_type, true, "a private target and its method stay out of the public header")
}

@test
fun header_guards_generic_layouts_in_public_signatures(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "#ifndef KF_GENERIC_LAYOUT_Option__int32"), true, "generic layouts are include-guarded")
}

@test
fun generic_enum_guard_covers_the_tag_declaration(): void {
    val h = emit_hdr()
    val guarded_tag = """#ifndef KF_GENERIC_LAYOUT_Option__int32
#define KF_GENERIC_LAYOUT_Option__int32
typedef enum kf__tag__Option__int32"""
    assert_eq(hdr_contains(h.as_str(), guarded_tag), true, "a generic enum's tag shares the layout guard")
}

@test
fun header_compiles_standalone(): void {
    // A private scratch directory, since the header includes kf_runtime.h
    // from beside it.
    val _made = unsafe { system("mkdir -p ${scratch_path("kf_codegen_hdr")}") }
    write_file(scratch_path("kf_codegen_hdr/kf_runtime.h"), emit_runtime_header().as_str())
    // A stand-in `alloc.h` that only makes `String` complete; nothing links
    // against it.
    write_file(scratch_path("kf_codegen_hdr/alloc.h"), """#ifndef KF_CRATE_alloc_H
#define KF_CRATE_alloc_H
typedef struct String { uint8_t* data; uint64_t len; uint64_t cap; } String;
#endif
""")
    write_file(scratch_path("kf_codegen_hdr/kf_hdr_aa.h"), emit_hdr().as_str())
    val rc = unsafe { system("cc -fsyntax-only -Wall -Wextra -I${scratch_path("kf_codegen_hdr")} -x c ${scratch_path("kf_codegen_hdr/kf_hdr_aa.h")}") }
    assert_eq(rc, 0, "the export surface is a complete C unit")
}

pub fun hdr_contains(s: str, needle: str): bool {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return true }
    if sl < nl { return false }
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// A trait impl method has no `pub` but must still get a prototype.
@test
fun header_declares_trait_impl_methods_without_pub(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "Point_equals(Point* __self);"), true, "a non-pub trait method still reaches consumers")
}

@test
fun header_declares_primitive_trait_impl_methods(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "int32_display(int32_t* __self);"), true, "primitive trait methods reach consumers")
}

// Private inherent methods stay out.
@test
fun header_still_omits_private_inherent_methods(): void {
    val h = emit_hdr()
    assert_eq(hdr_contains(h.as_str(), "secret"), false, "a private inherent method stays out of the header")
}

// A pub struct holding `List<Boxed>`, `Boxed` private: the header writes
// `Boxed* data`, so `Boxed` must be declared.
fun hdr_pointer_reachable_view(): Module {
    var bag_rows = List.new<TypeRef>()
    bag_rows.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("Boxed"), List.new<TypeRef>())))
    val rows_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rows_ty = TypeRef.new(no_span(), TypeRefKind.Named(intern("List"), bag_rows)) }
    var bag_fields = List.new<Field>()
    bag_fields.push(new_field(no_span(), String.from("rows"), rows_ty, true, true))
    var boxed_fields = List.new<Field>()
    boxed_fields.push(new_field(no_span(), String.from("v"), hdr_ty_ptr("int32"), false, true))
    var ptr_args = List.new<TypeRef>()
    ptr_args.push(TypeRef.new(no_span(), TypeRefKind.Named(intern("Boxed"), List.new<TypeRef>())))
    val data_ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *data_ty = TypeRef.new(no_span(), TypeRefKind.Named(intern("Ptr"), ptr_args)) }
    var list_fields = List.new<Field>()
    list_fields.push(new_field(no_span(), String.from("data"), data_ty, true, true))
    var list_decl = hdr_struct("List__Boxed", list_fields, true)
    list_decl.linkage = Linkage.GenericTemplate
    var decls = List.new<TopDecl>()
    decls.push(hdr_struct("Bag", bag_fields, true))
    decls.push(hdr_struct("Boxed", boxed_fields, false))
    decls.push(list_decl)
    return Module { crate: new_crate_id("bb"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

@test
fun header_pulls_a_pointer_reachable_private_type(): void {
    val view = hdr_pointer_reachable_view()
    val deps = List.new<String>()
    val h = view.emit_crate_header(String.from("bb"), &deps)
    assert_eq(hdr_contains(h.as_str(), "typedef struct Boxed Boxed;"), true, "a pointer-reachable private type is declared")
}
