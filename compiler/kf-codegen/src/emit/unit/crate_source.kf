// `<crate>.c`: includes its own header, then emits what the header left out:
// implementation-only layouts, tags and glue, the container instantiations
// its code uses, forward declarations, and every body this crate owns.
// Dependency declarations are never re-emitted.
//
// Glue emission sees only this crate's user drop/clone impls.

import alloc.list.*

import kf_core.ast.*

import kf_codegen.*

/// A view with no merged-module context gets no instance or hidden support.
pub fun Module.emit_crate_source(crate_name: String, is_bin: bool): String {
    return self.emit_crate_source_supported(self, crate_name, is_bin)
}

pub fun Module.emit_crate_source_supported(m: &Module, crate_name: String, is_bin: bool): String {
    var parts = List.new<String>()
    parts.push("// generated by komp\n#include \"${crate_name}.h\"\n\n")
    val hview = self.header_type_view()
    // Static support this TU regenerates: referenced generic instances,
    // prototypes for the archive symbols they call, and private dependency
    // layouts they touch.
    val support = self.collect_instance_support(m)
    val header_layouts = self.header_layout_view(&hview, m)
    val private_view = self.source_type_view()
    val sview = support_merged_view(self.source_type_view(), &support, &header_layouts)
    val glueview = support_glue_view(self.source_type_view(), &support)
    val support_layouts = support.support_layout_view()
    val dynview = self.dynamic_support_view(&support)
    parts.push(dynview.emit_dyn_forward_decls())
    parts.push(sview.emit_type_forward_decls())
    parts.push(sview.emit_enum_tags())
    // After type forward decls, since a vtable slot may return a generic
    // instance; before type bodies, which may embed a `Dyn__T`.
    parts.push(dynview.emit_dyn_layouts())
    parts.push(sview.emit_type_bodies_ordered())
    parts.push(private_view.emit_type_op_protos())
    parts.push(support_layouts.emit_type_op_protos())
    parts.push(support.emit_support_protos())
    parts.push(support.emit_instance_forwards())
    parts.push(glueview.emit_struct_news())
    parts.push(emit_public_glue_definitions(&hview.public_glue_lookup_view(&support), m))
    parts.push(glueview.emit_private_glue_definitions(m))
    parts.push(self.emit_fn_forwards())
    parts.push(dynview.emit_dyn_adapters())
    parts.push(dynview.emit_dyn_vtables())
    parts.push(emit_dyn_dispatch_helpers(&dynview))
    // From the merged self, so monomorphized enum instances are included.
    var payloads = self.build_arm_payloads()
    payloads.add_arm_payloads(&sview)
    parts.push(self.emit_fn_bodies(&payloads))
    parts.push(support.emit_instance_bodies(&payloads))
    if is_bin {
        if !self.has_main() {
            parts.push(empty_main())
        }
    }
    return concat_all(parts)
}

fun Module.dynamic_support_view(support: &InstanceSupport): Module {
    var decls = List.new<TopDecl>()
    while decl in &self.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    while decl in &support.instances.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    return Module { crate: self.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

// The header ABI types plus the instance impl blocks, so a public type's glue
// can find a generic payload's Drop impl (`List__Widget`). Only impl blocks:
// the instance layouts' glue belongs to the private view.
fun Module.public_glue_lookup_view(support: &InstanceSupport): Module {
    var decls = List.new<TopDecl>()
    while decl in &self.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    while td in &support.instances.decls {
        when (td.kind) {
            ImplBlock(_m) => decls.push(td.deep_clone_top_decl())
            TraitImpl(_t, _m2) => decls.push(td.deep_clone_top_decl())
            _ => {}
        }
    }
    return Module { crate: self.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

// Generic impl method prototypes come from emit_instance_forwards.
fun InstanceSupport.support_layout_view(): Module {
    var decls = List.new<TopDecl>()
    while td in &self.instances.decls {
        when (td.kind) {
            Struct(_f, _p) => decls.push(td.deep_clone_top_decl())
            EnumDecl(_v, _p) => decls.push(td.deep_clone_top_decl())
            _ => {}
        }
    }
    while decl in &self.private_types.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    return Module { crate: self.instances.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

// An instance whose layout is in the public header still gets its glue and
// constructors here, without its layout.
fun support_glue_view(sview: Module, support: &InstanceSupport): Module {
    var decls = sview.decls
    while td in &support.instances.decls {
        when (td.kind) {
            Struct(_f, _p) => decls.push(td.deep_clone_top_decl())
            EnumDecl(_v, _p) => decls.push(td.deep_clone_top_decl())
            ImplBlock(_m) => decls.push(td.deep_clone_top_decl())
            _ => {}
        }
    }
    while decl in &support.private_types.decls {
        decls.push(decl.deep_clone_top_decl())
    }
    return Module { crate: sview.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

// Implementation-only types plus the instance and private dependency layouts
// to regenerate, in one module so the ordering walk sees every edge.
fun support_merged_view(sview: Module, support: &InstanceSupport, header_layouts: &Module): Module {
    // A type already in the header (via a public signature or exported
    // layout) must not have its layout emitted again; its impls still belong
    // here.
    var decls = List.new<TopDecl>()
    while td in &sview.decls {
        val dup = when (td.kind) {
            Struct(_f, _p) => header_layouts.source_module_has_layout(td.name.as_str())
            EnumDecl(_v, _p) => header_layouts.source_module_has_layout(td.name.as_str())
            _ => false
        }
        if !dup { decls.push(td.deep_clone_top_decl()) }
    }
    while td in &support.instances.decls {
        when (td.kind) {
            Struct(_f, _p) => {
                if !header_layouts.source_module_has_layout(td.name.as_str()) { decls.push(td.deep_clone_top_decl()) }
            }
            EnumDecl(_v, _p) => {
                if !header_layouts.source_module_has_layout(td.name.as_str()) { decls.push(td.deep_clone_top_decl()) }
            }
            ImplBlock(_m2) => decls.push(td.deep_clone_top_decl())
            _ => {}
        }
    }
    while td in &support.private_types.decls {
        if !header_layouts.source_module_has_layout(td.name.as_str()) { decls.push(td.deep_clone_top_decl()) }
    }
    return Module { crate: sview.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun Module.source_module_has_layout(name: str): bool {
    while td in &self.decls {
        if td.name.as_str() == name {
            when (td.kind) {
                Struct(_f, _p) => return true
                EnumDecl(_v, _p) => return true
                _ => {}
            }
        }
    }
    return false
}

// The crate's types minus the header's, with impl blocks kept as lookup
// context.
fun Module.source_type_view(): Module {
    val hview = self.header_type_view()
    var header_names = List.new<String>()
    while td in &hview.decls {
        when (td.kind) {
            Struct(_f, _p) => { header_names.push(td.name.as_string()) }
            EnumDecl(_v, _p) => { header_names.push(td.name.as_string()) }
            _ => {}
        }
    }
    var decls = List.new<TopDecl>()
    while td in &self.decls {
        var keep = false
        when (td.kind) {
            Struct(_f, _p) => { keep = !source_name_in(&header_names, td.name.as_str()) }
            EnumDecl(_v, _p) => { keep = !source_name_in(&header_names, td.name.as_str()) }
            ImplBlock(_m) => { keep = true }
            TraitImpl(_t, _m) => { keep = true }
            _ => {}
        }
        if keep {
            decls.push(td.deep_clone_top_decl())
        }
    }
    return Module { crate: self.crate, path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun source_name_in(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}
