// The per-function table of which C function releases each in-scope local.
// Lookups scan most-recent-first so a shadowing binding wins; an empty
// release function means none is needed; a Box local carries a
// `__BOX__<inner>` sentinel. Mistakes here silently drop no memory rather
// than failing to build.

import alloc.list.*

import kf_core.ast.types.Type

import kf_codegen.concat
import kf_codegen.emit.*
import kf_codegen.emit.stmt.*

/// Each in-scope local's release function, or "" when none is needed, in
/// parallel lists.
pub struct LocalEnv {
    pub var names: List<String>
    pub var rel_fns: List<String>
    // Break labels for enclosing loops with a targeting `break`: `break`
    // lowers to `goto` so it exits the loop from inside a C `switch`.
    pub var loop_labels: List<String>
    pub var label_counter: uint64
    // `void` is erased in return position, so `return <expr>` there evaluates
    // and returns nothing. From the signature: Mono leaves `Expr.ty`
    // unsubstituted.
    pub var ret_ctype: String
    // Release function per enum payload, for `when` arm binders. Empty
    // without a Module, so no payload is dropped.
    pub var arm_payloads: ArmPayloads
}

pub fun new_local_env(): LocalEnv {
    val ns = List.new<String>()
    val rs = List.new<String>()
    return LocalEnv {
        names: ns,
        rel_fns: rs,
        loop_labels: List.new<String>(),
        label_counter: 0,
        ret_ctype: "",
        arm_payloads: no_arm_payloads()
    }
}

pub mutating fun LocalEnv.env_bind(name: String, rel: String): void {
    self.names.push(name)
    self.rel_fns.push(rel)
}

pub mutating fun LocalEnv.env_release_fn(name: String): String {
    // From the end: the innermost binding owns the value. `n..0` runs zero
    // times, so this is a manual loop.
    var i: uint64 = self.names.size()
    while i > 0 {
        i = i - 1
        val nm = *self.names.at(i)
        if nm == name { return self.rel_fns.at(i).clone() }
    }
    return ""
}

/// `<CType>__glue_drop`, or "" for a type owning no heap.
pub fun release_fn_for_ctype(ct: str): String {
    if ctype_is_primitive(ct) { return "" }
    if ctype_has_star(ct) { return "" }
    return concat(String.from(ct), "__glue_drop")
}

/// The deep-copy function, or "" where a bit-copy suffices.
pub fun clone_fn_for_ctype(ct: str): String {
    if ctype_is_primitive(ct) { return "" }
    if ctype_has_star(ct) { return "" }
    return concat(String.from(ct), "__glue_clone")
}

fun ctype_is_primitive(ct: str): bool {
    return when ct {
        "void" => true
        // The unit value owns nothing.
        "kf_unit" => true
        "bool" => true
        "int8_t" => true
        "int16_t" => true
        "int32_t" => true
        "int64_t" => true
        "uint8_t" => true
        "uint16_t" => true
        "uint32_t" => true
        "uint64_t" => true
        "float" => true
        "double" => true
        _ => false
    }
}

fun ctype_has_star(ct: str): bool {
    while i in 0..ct.byte_len() {
        val c = ct.byte_at(i)
        if c == 42 { return true }
    }
    return false
}

/// A `Box<Inner>` gets a `__BOX__<inner_drop>` sentinel, decoded by
/// emit_release; everything else its type's release function.
pub fun box_or_normal_release(t: Type, ct: String): String {
    when (t.kind) {
        BoxOf(p) => {
            val innerct = c_type_of_type(unsafe { *p })
            val innerdrop = release_fn_for_ctype(innerct.as_str())
            return concat(String.from("__BOX__"), innerdrop)
        }
        _ => return release_fn_for_ctype(ct.as_str())
    }
}
