import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.declaration.TopDecl
import kf_core.ast.dyn_meta.*

fun Module.collect_codegen_dyn_layouts(): List<DynTraitLayout> {
    var result = List.new<DynTraitLayout>()
    val selected_tables = self.collect_codegen_dyn_vtables()
    while decl in &self.decls {
        decl.collect_codegen_dyn_layouts_decl(&selected_tables, &var result)
    }
    return self.drop_template_layouts(&result)
}

/// A layout whose arguments still name type parameters is a template and is
/// never emitted. The test is whether each argument names an existing type,
/// since imported layouts carry a parameter as `Struct("T")`.
fun Module.drop_template_layouts(layouts: &List<DynTraitLayout>): List<DynTraitLayout> {
    var kept = List.new<DynTraitLayout>()
    while layout in &layouts {
        if self.dyn_layout_is_concrete(&layout) { kept.push(clone_dyn_trait_layout(&layout)) }
    }
    return kept
}

fun Module.dyn_layout_is_concrete(layout: &DynTraitLayout): bool {
    while arg in &layout.args {
        if !self.dyn_arg_names_a_real_type(arg) { return false }
    }
    return true
}

/// A builtin or a declaration in this module; anything else is an
/// unsubstituted type parameter.
fun Module.dyn_arg_names_a_real_type(t: Type): bool {
    val name = t.mangle_frag()
    if is_runtime_type_name(name.as_str()) { return true }
    val list_name = self.lang_type_name(lang_list_key())
    val option_name = self.lang_type_name(lang_option_key())
    if is_container_type_name(name.as_str(), list_name, option_name) { return true }
    // A mangled instance (`List__int32`) is real whether or not it is declared.
    if is_mangled_decl_name(name.as_str()) { return true }
    while decl in &self.decls {
        if decl.name.as_str().equals(name.as_str()) { return true }
    }
    return false
}

fun TopDecl.collect_codegen_dyn_layouts_decl(selected_tables: &List<DynVTableInstance>, result: &var List<DynTraitLayout>): void {
    var impl_owner = false
    when (self.kind) {
        ImplBlock(_) => impl_owner = true
        _ => { }
    }
    while layout in &self.dyn_layouts {
        val selected = codegen_dyn_layout_is_selected(selected_tables, layout.identity)
        // An imported layout is emitted only when a vtable here selects it; its
        // own crate defines it. An argument-less trait's layout is its crate's
        // published ABI (`struct DynVTable__Draw` in the header), so it is
        // always emitted; a layout with arguments is materialized per consumer
        // and selection decides.
        val published = !impl_owner && layout.dyn_layout_is_exportable()
        val wanted = if layout.imported { selected } else { selected || published }
        if wanted && !codegen_dyn_layout_has(result, layout.identity) { result.push(clone_dyn_trait_layout(&layout)) }
    }
    when (self.kind) {
        ImplBlock(members) => collect_codegen_dyn_layouts_members(&members, selected_tables, result)
        _ => { }
    }
}

fun collect_codegen_dyn_layouts_members(members: &List<TopDecl>, selected_tables: &List<DynVTableInstance>, result: &var List<DynTraitLayout>): void {
    var i = 0
    while i < members.size() { collect_codegen_dyn_layouts_decl(members.at(i), selected_tables, result); i = i + 1 }
}

fun codegen_dyn_layout_has(layouts: &List<DynTraitLayout>, identity: Sym): bool {
    return find_codegen_dyn_layout(layouts, identity).is_some()
}

fun Module.collect_codegen_dyn_vtables(): List<DynVTableInstance> {
    var required = List.new<DynVTableInstance>()
    while decl in &self.decls {
        decl.collect_codegen_dyn_vtable_requirements(&var required)
    }
    val layouts = self.collect_declared_dyn_layouts()
    var result = List.new<DynVTableInstance>()
    while decl in &self.decls {
        decl.collect_codegen_dyn_vtable_definitions(&required, &var result, self.crate, &layouts)
    }
    return result
}

/// Every declared layout, unselected.
/// CONSTRAINT: not `collect_codegen_dyn_layouts`, which asks which vtables are
/// selected; calling it from here recurses without end.
fun Module.collect_declared_dyn_layouts(): List<DynTraitLayout> {
    var result = List.new<DynTraitLayout>()
    while decl in &self.decls {
        decl.collect_declared_dyn_layouts_decl(&var result)
    }
    return result
}

fun TopDecl.collect_declared_dyn_layouts_decl(result: &var List<DynTraitLayout>): void {
    while layout in &self.dyn_layouts {
        if !codegen_dyn_layout_has(result, layout.identity) { result.push(clone_dyn_trait_layout(&layout)) }
    }
    when (self.kind) {
        ImplBlock(members) => {
            var j = 0
            while j < members.size() { collect_declared_dyn_layouts_decl(members.at(j), result); j = j + 1 }
        }
        _ => { }
    }
}

/// An argument-less trait's layout, which every consumer sees through the
/// owner's header. A layout with arguments appears in no header and is
/// materialized per consumer, so its instances cannot be exported.
pub fun DynTraitLayout.dyn_layout_is_exportable(): bool {
    return self.args.size() == 0
}

fun DynVTableInstance.codegen_dyn_vtable_is_exportable(layouts: &List<DynTraitLayout>): bool {
    when (find_codegen_dyn_layout(layouts, self.layout)) {
        Some(layout) => return layout.dyn_layout_is_exportable()
        None => return false
    }
}

fun TopDecl.collect_codegen_dyn_vtable_requirements(required: &var List<DynVTableInstance>): void {
    while table in &self.dyn_vtables {
        if table.adapters.size() == 0 && !codegen_dyn_vtable_has(required, table.layout, table.receiver_identity) {
            required.push(clone_dyn_vtable_instance(&table))
        }
    }
    when (self.kind) {
        ImplBlock(members) => {
            var j = 0
            while j < members.size() { collect_codegen_dyn_vtable_requirements(members.at(j), required); j = j + 1 }
        }
        _ => { }
    }
}

/// The vtables this TU defines: those a coercion here asks for, and those this
/// crate owns whether coerced or not, since across crates the impl and the
/// coercion live in different TUs. Templates are emitted `static` per TU.
fun TopDecl.collect_codegen_dyn_vtable_definitions(required: &List<DynVTableInstance>, result: &var List<DynVTableInstance>, crate: CrateId, layouts: &List<DynTraitLayout>): void {
    while table in &self.dyn_vtables {
        // A poison crate owns nothing; otherwise the single-file pipeline would
        // claim every impl.
        val owned_here = !crate.is_poison() && table.owner.raw == crate.raw && !table.linkage.is_template() && table.codegen_dyn_vtable_is_exportable(layouts)
        // A dependency's table is defined and exported by that crate.
        val defined_by_owner = table.linkage.is_imported() && table.codegen_dyn_vtable_is_exportable(layouts)
        val wanted = !defined_by_owner && (owned_here || codegen_dyn_vtable_has(required, table.layout, table.receiver_identity))
        if table.adapters.size() > 0 && wanted && !codegen_dyn_vtable_has(result, table.layout, table.receiver_identity) {
            result.push(clone_dyn_vtable_instance(&table))
        }
    }
    when (self.kind) {
        ImplBlock(members) => {
            var j = 0
            while j < members.size() { collect_codegen_dyn_vtable_definitions(members.at(j), required, result, crate, layouts); j = j + 1 }
        }
        _ => { }
    }
}

fun codegen_dyn_layout_is_selected(tables: &List<DynVTableInstance>, layout: Sym): bool {
    while table in &tables {
        if table.layout.id == layout.id { return true }
    }
    return false
}

/// CONSTRAINT: compared by the identity codegen spells, not the recorded
/// Sym: an impl records `crate::module::A`, a coercion the bare `A`, and both
/// emit `DynVTableInstance__A__Show`.
fun codegen_dyn_vtable_has(tables: &List<DynVTableInstance>, layout: Sym, receiver: Sym): bool {
    val want_layout = layout.dyn_codegen_identity()
    val want_recv = receiver.dyn_codegen_identity()
    while table in &tables {
        if table.layout.dyn_codegen_identity().as_str().equals(want_layout.as_str()) {
            if table.receiver_identity.dyn_codegen_identity().as_str().equals(want_recv.as_str()) { return true }
        }
    }
    return false
}
