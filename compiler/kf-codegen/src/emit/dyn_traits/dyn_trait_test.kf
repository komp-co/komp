import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.dyn_meta.*

fun dyn_text_find(text: str, needle: str): uint64 {
    val text_len = text.byte_len()
    val needle_len = needle.byte_len()
    var i: uint64 = 0
    while i + needle_len <= text_len {
        var same = true
        var j: uint64 = 0
        while j < needle_len {
            if text.byte_at(i + j) != needle.byte_at(j) { same = false }
            j = j + 1
        }
        if same { return i }
        i = i + 1
    }
    return text_len + 1
}

fun codegen_dyn_ref(): Type {
    val dynamic = dyn_trait_type(intern("Display"), new_type_vec(), no_span())
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = dynamic }
    return Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Declared(no_span()) }
}

fun codegen_dyn_module(): Module {
    var methods = List.new<DynMethodSlot>()
    methods.push(DynMethodSlot { name: intern("display"), params: List.new<Type>(), ret: intern("String").lang_struct_ty(no_span()), is_mutating: false, slot: 0 })
    var compare_params = List.new<Type>()
    compare_params.push(int32_ty(no_span()))
    methods.push(DynMethodSlot { name: intern("compare"), params: compare_params, ret: bool_ty(no_span()), is_mutating: false, slot: 1 })
    val layout = DynTraitLayout {
        identity: intern("Display"), principal: intern("Display"), args: List.new<Type>(), methods: methods,
        owner: crate_id_poison(), imported: false
    }
    // The symbol typecheck records, which codegen copies verbatim.
    var adapters = List.new<Sym>()
    adapters.push(intern("Point_display__Display"))
    adapters.push(intern("Point_compare__Display"))
    val table = DynVTableInstance {
        layout: intern("Display"), receiver: Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) },
        receiver_identity: intern("Point"), symbol: intern("DynVTableInstance__Point__Display"), adapters: adapters,
        owner: crate_id_poison(), linkage: linkage_source()
    }
    var owner = new_top_decl(no_span(), String.from("use_display"), TopDeclKind.Poison)
    owner.dyn_layouts.push(layout)
    owner.dyn_vtables.push(table)
    owner.dyn_vtables.push(DynVTableInstance {
        layout: intern("Display"), receiver: Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) },
        receiver_identity: intern("Point"), symbol: intern("DynVTableInstance__Point__Display"), adapters: List.new<Sym>(),
        owner: crate_id_poison(), linkage: linkage_source()
    })
    var declarations = List.new<TopDecl>()
    declarations.push(owner)
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
}

@test fun dyn_trait_codegen_emits_forward_declarations(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_forward_decls()
    assert_eq(output.as_str().contains("typedef struct DynVTable__Display DynVTable__Display;") && output.as_str().contains("typedef struct Dyn__Display Dyn__Display;"), true, "dynamic wrapper types are forward-declared")
}

@test fun dyn_trait_codegen_emits_vtable_layout_in_slot_order(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_layouts()
    val display = dyn_text_find(output.as_str(), "String (*display)(void *data)")
    val compare = dyn_text_find(output.as_str(), "bool (*compare)(void *data, int32_t arg0)")
    assert_eq(compare > display && display < output.as_str().byte_len(), true, "vtable fields follow declaration order")
}

@test fun dyn_trait_codegen_emits_fat_wrapper_layout(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_layouts()
    assert_eq(output.as_str().contains("void *data;") && output.as_str().contains("const DynVTable__Display *vtable;"), true, "dynamic wrapper stores data and vtable pointers")
}

@test fun dyn_trait_codegen_emits_trivial_wrapper_clone(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_layouts()
    assert_eq(output.as_str().contains("Dyn__Display__glue_clone(Dyn__Display value) { return value; }"), true, "borrowed dynamic wrappers clone by copying two pointers")
}

@test fun dyn_trait_codegen_emits_concrete_adapter_cast(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_adapters()
    assert_eq(output.as_str().contains("Point_display__Display((Point *)data)"), true, "adapter casts erased data to its concrete receiver")
}

// The recorded symbol is used as-is.
@test fun dyn_trait_codegen_forwards_to_the_recorded_symbol(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_adapters()
    assert_eq(output.as_str().contains("Point_compare__Display((Point *)data"), true, "the adapter target is read from the table, not reconstructed")
}

@test fun dyn_trait_codegen_emits_vtable_initializer_order(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_vtables()
    val display = dyn_text_find(output.as_str(), ".display = DynAdapter__Point__Display__display")
    val compare = dyn_text_find(output.as_str(), ".compare = DynAdapter__Point__Display__compare")
    assert_eq(compare > display && display < output.as_str().byte_len(), true, "vtable initializer follows slot order")
}

@test fun dyn_trait_codegen_exports_non_generic_vtable(): void {
    val module = codegen_dyn_module()
    val output = module.emit_dyn_vtables()
    assert_eq(output.as_str().contains("const DynVTable__Display DynVTableInstance__Point__Display") && !output.as_str().contains("static const DynVTable__Display"), true, "implementation-owned vtables have external linkage")
}

@test fun dyn_trait_codegen_declares_exported_vtable(): void {
    val module = codegen_dyn_module()
    val output = module.emit_owned_dyn_vtable_declarations()
    assert_eq(output.as_str().contains("extern const DynVTable__Display DynVTableInstance__Point__Display;"), true, "implementation headers declare exported vtables")
}

@test fun dyn_trait_codegen_records_exported_vtable_symbol(): void {
    val module = codegen_dyn_module()
    val symbols = module.collect_exported_dyn_vtable_symbols()
    assert_eq(symbols.size() == 1 && symbols.at(0).as_str() == "DynVTableInstance__Point__Display", true, "artifact metadata records the exported vtable")
}

@test fun dyn_trait_codegen_emits_by_value_dispatch_helper(): void {
    val module = codegen_dyn_module()
    val output = emit_dyn_dispatch_helpers(&module)
    assert_eq(output.as_str().contains("Dyn__Display__display(Dyn__Display self)") && output.as_str().contains("self.vtable->display(self.data)"), true, "dispatch helper receives the fat object once by value")
}

@test fun dyn_trait_codegen_renders_reference_as_fat_value(): void {
    val output = c_type_of_type(&codegen_dyn_ref())
    assert_eq(output.as_str(), "Dyn__Display", "a borrowed dynamic trait uses its nominal fat value")
}

@test fun dyn_trait_codegen_emits_coercion_literal(): void {
    var source = new_expr(no_span(), ExprKind.Variable(intern("point")))
    source.ty = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(no_span()) }
    source.coerce = coerce_addr_of()
    val source_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *source_ptr = source }
    var coercion = new_expr(no_span(), ExprKind.DynCoerce(source_ptr, intern("DynVTableInstance__Point__Display")))
    coercion.ty = codegen_dyn_ref()
    val output = coercion.emit_expr()
    assert_eq(output.as_str().contains("(Dyn__Display){") && output.as_str().contains(".data = (void *)((&__point))") && output.as_str().contains(".vtable = &DynVTableInstance__Point__Display"), true, "coercion emits a fat-reference literal")
}

@test fun dyn_trait_codegen_emits_indirect_call_helper(): void {
    var receiver = new_expr(no_span(), ExprKind.Variable(intern("object")))
    receiver.ty = codegen_dyn_ref()
    val receiver_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *receiver_ptr = receiver }
    var call = new_expr(no_span(), ExprKind.MethodCall(receiver_ptr, intern("display"), List.new<Expr>()))
    call.ty = intern("String").lang_struct_ty(no_span())
    call.is_dynamic_call = true
    call.dynamic_layout = intern("Display")
    call.dynamic_slot = 0
    assert_eq(call.emit_expr().as_str(), "Dyn__Display__display(__object)", "dynamic calls route through their layout helper")
}

// A layout attached to a trait declaration that nothing dispatches through
// dynamically is not emitted.
fun unselected_trait_decl_module(layout_identity: str, args: List<Type>): Module {
    var methods = List.new<DynMethodSlot>()
    methods.push(DynMethodSlot { name: intern("next"), params: List.new<Type>(), ret: int32_ty(no_span()), is_mutating: false, slot: 0 })
    val layout = DynTraitLayout {
        identity: intern(layout_identity), principal: intern("Iterator"), args: args, methods: methods,
        owner: crate_id_poison(), imported: false
    }
    var declaration = new_top_decl(no_span(), String.from("Iterator"), TopDeclKind.TraitDecl(List.new<TopDecl>(), true, List.new<TypeRef>()))
    declaration.dyn_layouts.push(layout)
    var declarations = List.new<TopDecl>()
    declarations.push(declaration)
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
}

@test fun an_unselected_generic_trait_layout_is_not_emitted(): void {
    var args = List.new<Type>()
    args.push(int32_ty(no_span()))
    val module = unselected_trait_decl_module("Iterator__int32", args)
    val output = module.emit_dyn_layouts()
    assert_eq(output.as_str().contains("struct DynVTable__Iterator__int32 {"), false, "an instantiated layout is materialized per consumer, so nothing outside can be relying on it")
}

// An argument-less trait's layout is its crate's published ABI, so it is
// emitted even unselected.
@test fun an_unselected_plain_trait_layout_is_still_published(): void {
    val module = unselected_trait_decl_module("Iterator", List.new<Type>())
    val output = module.emit_dyn_layouts()
    assert_eq(output.as_str().contains("struct DynVTable__Iterator {"), true, "a trait's own crate publishes its layout whether or not it dispatches")
}

/// A vtable supplied by another crate's impl, with that declaration's
/// `linkage`, and a coercion here that asks for it.
fun coerced_dependency_vtable_module(linkage: Linkage): Module {
    var methods = List.new<DynMethodSlot>()
    methods.push(DynMethodSlot { name: intern("display"), params: List.new<Type>(), ret: void_ty(no_span()), is_mutating: false, slot: 0 })
    val layout = DynTraitLayout {
        identity: intern("Display"), principal: intern("Display"), args: List.new<Type>(), methods: methods,
        owner: new_crate_id("core"), imported: true
    }
    var adapters = List.new<Sym>()
    adapters.push(intern("Token_display__Display"))
    var dependency = new_top_decl(no_span(), String.from("Token"), TopDeclKind.Poison)
    dependency.linkage = linkage
    dependency.dyn_layouts.push(layout)
    dependency.dyn_vtables.push(DynVTableInstance {
        layout: intern("Display"), receiver: Type { kind: TypeKind.Struct(intern("Token")), provenance: Provenance.Declared(no_span()) },
        receiver_identity: intern("Token"), symbol: intern("DynVTableInstance__Token__Display"), adapters: adapters,
        owner: new_crate_id("lib"), linkage: linkage
    })
    var coercion = new_top_decl(no_span(), String.from("show"), TopDeclKind.Poison)
    coercion.dyn_vtables.push(DynVTableInstance {
        layout: intern("Display"), receiver: Type { kind: TypeKind.Struct(intern("Token")), provenance: Provenance.Declared(no_span()) },
        receiver_identity: intern("Token"), symbol: intern("DynVTableInstance__Token__Display"), adapters: List.new<Sym>(),
        owner: new_crate_id("app"), linkage: linkage_source()
    })
    var declarations = List.new<TopDecl>()
    declarations.push(dependency)
    declarations.push(coercion)
    return Module { crate: new_crate_id("app"), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
}

// The owner defines and exports it; defining it here too duplicates it.
@test fun a_dependencys_exported_vtable_is_referenced_not_defined(): void {
    val module = coerced_dependency_vtable_module(Linkage.ImportedCompiled)
    assert_eq(module.collect_codegen_dyn_vtables().size(), 0, "a table from a dependency's interface is not defined again")
}

// Guards the test above against a fixture that selects nothing.
@test fun the_same_coercion_selects_a_table_nothing_else_defines(): void {
    val module = coerced_dependency_vtable_module(linkage_source())
    assert_eq(module.collect_codegen_dyn_vtables().size(), 1, "a coercion still selects a source table")
}
