import alloc.list.*

import kf_core.ast.*
import kf_core.ast.dyn_meta.*

pub fun Module.emit_dyn_forward_decls(): String {
    val layouts = self.collect_codegen_dyn_layouts()
    return emit_dyn_forward_decl_list(&layouts)
}

pub fun Module.emit_owned_dyn_forward_decls(): String {
    val layouts = self.collect_owned_codegen_dyn_layouts()
    return emit_dyn_forward_decl_list(&layouts)
}

fun emit_dyn_forward_decl_list(layouts: &List<DynTraitLayout>): String {
    var parts = List.new<String>()
    while layout in &layouts {
        val identity = layout.identity.dyn_codegen_identity()
        parts.push("typedef struct DynVTable__${identity} DynVTable__${identity};\n")
        parts.push("typedef struct Dyn__${identity} Dyn__${identity};\n")
    }
    if layouts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

pub fun Module.emit_dyn_layouts(): String {
    val layouts = self.collect_codegen_dyn_layouts()
    return emit_dyn_layout_list(&layouts)
}

pub fun Module.emit_owned_dyn_layouts(): String {
    val layouts = self.collect_owned_codegen_dyn_layouts()
    return emit_dyn_layout_list(&layouts)
}

fun emit_dyn_layout_list(layouts: &List<DynTraitLayout>): String {
    var parts = List.new<String>()
    while layout in &layouts {
        val identity = layout.identity.dyn_codegen_identity()
        parts.push("#ifndef KF_DYN_LAYOUT_${identity}\n#define KF_DYN_LAYOUT_${identity}\n")
        parts.push("struct DynVTable__${identity} {\n")
        while method in &layout.methods {
            parts.push("    ${method.ret.c_type_of_type()} (*${method.name.as_string()})(void *data")
            append_dyn_c_params(&var parts, &method.params)
            parts.push(String.from(");\n"))
        }
        parts.push(String.from("};\n"))
        parts.push("struct Dyn__${identity} {\n    void *data;\n    const DynVTable__${identity} *vtable;\n};\n")
        parts.push("static inline Dyn__${identity} Dyn__${identity}__glue_clone(Dyn__${identity} value) { return value; }\n#endif\n\n")
    }
    return concat_all(parts)
}

pub fun Module.collect_owned_codegen_dyn_layouts(): List<DynTraitLayout> {
    val all = self.collect_codegen_dyn_layouts()
    var owned = List.new<DynTraitLayout>()
    while layout in &all {
        if layout.owner.raw == self.crate.raw { owned.push(layout) }
    }
    return owned
}

pub fun Module.emit_dyn_adapters(): String {
    val layouts = self.collect_codegen_dyn_layouts()
    val tables = self.collect_codegen_dyn_vtables()
    var parts = List.new<String>()
    while table in &tables {
        val layout = find_codegen_dyn_layout(&layouts, table.layout)
        when (layout) {
            Some(found) => emit_dyn_table_adapters(&var parts, &table, &found)
            None => { }
        }
    }
    return concat_all(parts)
}

pub fun Module.emit_dyn_vtables(): String {
    val layouts = self.collect_codegen_dyn_layouts()
    val tables = self.collect_codegen_dyn_vtables()
    var parts = List.new<String>()
    while table in &tables {
        when (find_codegen_dyn_layout(&layouts, table.layout)) {
            Some(layout) => {
                val storage = if table.linkage.is_template() { "static const " } else { "const " }
                parts.push(String.from(storage) + String.from("DynVTable__") + table.layout.dyn_codegen_identity() + String.from(" ") + table.dyn_vtable_c_symbol(&layout) + String.from(" = {\n"))
                while method in &layout.methods {
                    parts.push("    .${method.name.as_string()} = ${table.dyn_adapter_name(&layout, &method)},\n")
                }
                parts.push(String.from("};\n\n"))
            }
            None => { }
        }
    }
    return concat_all(parts)
}

pub fun Module.emit_owned_dyn_vtable_declarations(): String {
    val layouts = self.collect_codegen_dyn_layouts()
    val tables = self.collect_codegen_dyn_vtables()
    var parts = List.new<String>()
    while table in &tables {
        if table.owner.raw == self.crate.raw && !table.linkage.is_template() {
            when (find_codegen_dyn_layout(&layouts, table.layout)) {
                Some(layout) => {
                    val identity = table.layout.dyn_codegen_identity()
                    // CONSTRAINT: a layout another crate owns is declared by
                    // that crate's header only when that crate uses it, and
                    // the extern below names the type either way.
                    if layout.owner.raw != self.crate.raw {
                        parts.push("typedef struct DynVTable__${identity} DynVTable__${identity};\n")
                    }
                    parts.push("extern const DynVTable__${identity} ${table.dyn_vtable_c_symbol(&layout)};\n")
                }
                None => { }
            }
        }
    }
    if parts.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

pub fun Module.collect_exported_dyn_vtable_symbols(): List<String> {
    val layouts = self.collect_codegen_dyn_layouts()
    val tables = self.collect_codegen_dyn_vtables()
    var symbols = List.new<String>()
    while table in &tables {
        if table.owner.raw == self.crate.raw && !table.linkage.is_template() {
            when (find_codegen_dyn_layout(&layouts, table.layout)) {
                Some(layout) => symbols.push(table.dyn_vtable_c_symbol(&layout))
                None => { }
            }
        }
    }
    return symbols
}

pub fun emit_dyn_dispatch_helpers(m: &Module): String {
    val layouts = m.collect_codegen_dyn_layouts()
    var parts = List.new<String>()
    while layout in &layouts {
        while method in &layout.methods {
            val ret = method.ret.c_type_of_type()
            val identity = layout.identity.dyn_codegen_identity()
            parts.push("static ${ret} Dyn__${identity}__${method.name.as_string()}(Dyn__${identity} self")
            append_dyn_c_params(&var parts, &method.params)
            parts.push(String.from(") {\n    "))
            if !method.ret.dyn_codegen_type_is_void() { parts.push(String.from("return ")) }
            parts.push("self.vtable->${method.name.as_string()}(self.data")
            append_dyn_arg_names(&var parts, method.params.size())
            parts.push(String.from(");\n}\n\n"))
        }
    }
    return concat_all(parts)
}

pub fun Expr.emit_dyn_coerce(inner: Ptr<Expr>, vtable: Sym): String {
    var parts = List.new<String>()
    parts.push("(${self.ty.c_type_of_type()}){ .data = (void *)(")
    parts.push(emit_expr(unsafe { &*inner }))
    parts.push("), .vtable = &${self.dyn_coerce_vtable_symbol(unsafe { &*inner }, vtable)} }")
    return concat_all(parts)
}

pub fun Expr.emit_dyn_call(receiver: Ptr<Expr>, method: Sym, args: List<Expr>): String {
    var parts = List.new<String>()
    parts.push("Dyn__${self.dynamic_layout.dyn_codegen_identity()}__${method.as_string()}(")
    parts.push(emit_expr(unsafe { &*receiver }))
    while arg in &args {
        parts.push(String.from(", "))
        parts.push(arg.emit_expr())
    }
    parts.push(String.from(")"))
    return concat_all(parts)
}

fun emit_dyn_table_adapters(parts: &var List<String>, table: &DynVTableInstance, layout: &DynTraitLayout): void {
    while i in 0..layout.methods.size() {
        val method = *layout.methods.at(i)
        parts.push("static ${method.ret.c_type_of_type()} ${table.dyn_adapter_name(layout, &method)}(void *data")
        append_dyn_c_params(parts, &method.params)
        parts.push(String.from(") {\n    "))
        if !method.ret.dyn_codegen_type_is_void() { parts.push(String.from("return ")) }
        if i < table.adapters.size() {
            parts.push(table.dyn_adapter_target(i) + String.from("((") + table.receiver.c_type_of_type() + String.from(" *)data"))
            append_dyn_arg_names(parts, method.params.size())
            parts.push(String.from(");\n}\n\n"))
        } else {
            parts.push(String.from("/* missing dynamic adapter */;\n}\n\n"))
        }
    }
}

fun DynVTableInstance.dyn_adapter_name(layout: &DynTraitLayout, method: &DynMethodSlot): String {
    return "DynAdapter__${self.receiver_identity.dyn_codegen_identity()}__${layout.identity.dyn_codegen_identity()}__${method.name.as_string()}"
}

/// The real function an adapter forwards to, read from the table.
/// CONSTRAINT: never rebuilt here. Typecheck records it by rules codegen
/// cannot see: receiver mangling, the `__<Trait>` suffix and the traits
/// without one.
fun DynVTableInstance.dyn_adapter_target(index: uint64): String {
    return self.adapters.get(index).as_string()
}

fun Sym.dyn_codegen_identity(): String {
    return type_identity_display(Sym { id: self.id })
}

fun DynVTableInstance.dyn_vtable_c_symbol(layout: &DynTraitLayout): String {
    return "DynVTableInstance__${self.receiver_identity.dyn_codegen_identity()}__${layout.identity.dyn_codegen_identity()}"
}

fun Expr.dyn_coerce_vtable_symbol(inner: &Expr, fallback: Sym): String {
    val layout = self.ty.dyn_coerce_layout_identity()
    val receiver = inner.ty.dyn_coerce_receiver_identity()
    if layout.as_str() == "" || receiver.as_str() == "" { return fallback.as_string() }
    return "DynVTableInstance__${receiver}__${layout}"
}

fun Type.dyn_coerce_layout_identity(): String {
    when (self.kind) {
        RefTo(_, object) => {
            val dynamic = unsafe { *object }
            when (dynamic.kind) {
                DynTraitTy(_) => return dyn_trait_identity(&dynamic).dyn_codegen_identity()
                _ => return ""
            }
        }
        _ => return ""
    }
}

/// The receiver half of a vtable symbol at a coercion site, by type identity
/// to agree with `dyn_vtable_c_symbol`: `int32`, not the C name `int32_t`.
fun Type.dyn_coerce_receiver_identity(): String {
    return when (self.kind) {
        RefTo(_, inner) => dyn_coerce_receiver_identity(unsafe { &*inner })
        Struct(identity) => identity.dyn_codegen_identity()
        EnumTy(identity) => identity.dyn_codegen_identity()
        _ => self.clone().mangle_frag()
    }
}

fun append_dyn_c_params(parts: &var List<String>, params: &List<Type>): void {
    while i in 0..params.size() {
        parts.push(", ${c_type_of_type(params.at(i))} arg${i}")
    }
}

fun append_dyn_arg_names(parts: &var List<String>, count: uint64): void {
    var i = 0
    while i < count {
        parts.push(", arg${i}")
        i = i + 1
    }
}

fun Type.dyn_codegen_type_is_void(): bool {
    return when (self.kind) {
        Void => true
        _ => false
    }
}

fun find_codegen_dyn_layout(layouts: &List<DynTraitLayout>, identity: Sym): DynTraitLayout? {
    while layout in &layouts {
        if layout.identity.id == identity.id { return Option.Some(layout) }
    }
    return Option.None
}
