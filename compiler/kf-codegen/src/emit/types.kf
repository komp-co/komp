// TypeRef to C type. Generic instance names are already mangled.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.dyn_meta.dyn_trait_identity
import kf_codegen.concat

pub fun TypeRef.c_type(): String {
    val tk = self.kind
    when (tk) {
        Named(name, args) => return c_type_named(name.as_string(), args)
        DynTrait(_name, _args) => return String.from("/* poison */ void")
        Reference(_mut, inner_p) => {
            val inner = unsafe { *inner_p }
            when (inner.kind) {
                DynTrait(_, _) => return inner.tyref_mangle()
                _ => { }
            }
            val inner_c = inner.c_type()
            return concat(inner_c, String.from("*"))
        }
        Function(params, ret) => {
            var c_params = List.new<String>()
            while param in &params {
                c_params.push(param.c_type())
            }
            return fn_pointer_c_type(&c_params, ret.c_type().as_str())
        }
        Array(_element, _length) => return self.tyref_mangle()
        // Unresolved: emitted like poison.
        Projection(_owner, _member) => return String.from("/* poison */ void")
        Poison => return String.from("/* poison */ void")
    }
}

pub fun c_type_name(name: String): String {
    return c_type_named(name, List.new<TypeRef>())
}

fun c_type_named(name: String, args: List<TypeRef>): String {
    val s = name.as_str()
    when s {
        "void" => return String.from("void")
        "bool" => return String.from("bool")
        "int8" => return String.from("int8_t")
        "int16" => return String.from("int16_t")
        "int32" => return String.from("int32_t")
        "int64" => return String.from("int64_t")
        "uint8" => return String.from("uint8_t")
        "uint16" => return String.from("uint16_t")
        "uint32" => return String.from("uint32_t")
        "uint64" => return String.from("uint64_t")
        "float32" => return String.from("float")
        "float64" => return String.from("double")
        "char" => return String.from("uint32_t")
        "str" => return String.from("const char*")
        _ => { }
    }

    if s == "Ptr" {
        if args.size() == 1 {
            val inner = *args.at(0)
            return concat(inner.c_type(), String.from("*"))
        }
    }

    // Box<T> is `T*` too.
    if s == "Box" {
        if args.size() == 1 {
            val inner = *args.at(0)
            return concat(inner.c_type(), String.from("*"))
        }
    }

    // A mangled `Ptr__T` / `Box__T`, as arrives in generic arguments, has no
    // typedef: it is `T*`. Recognized by spelling, since mono flattened it.
    if args.size() == 0 {
        val pointee = mangled_pointer_pointee(s)
        if pointee.as_str().byte_len() > 0 {
            return concat(c_type_name(pointee), String.from("*"))
        }
    }

    // A function type flattened to its fragment, as a generic argument.
    if args.size() == 0 {
        val function = fn_frag_parts(s)
        if function != null {
            val parts = function!!
            var c_params = List.new<String>()
            while param in &parts.params {
                c_params.push(frag_c_type(param.as_str()))
            }
            return fn_pointer_c_type(&c_params, frag_c_type(parts.ret.as_str()).as_str())
        }
    }

    // A generic in type position is still `Named("List", [Expr])` and is
    // mangled to match the container body and call sites (`List__Expr`).
    if args.size() > 0 {
        return mangle_named(name, args)
    }

    // A canonical identity `crate::module::Name` renders as its last segment,
    // as `c_type_of_type` does; a no-op for a C identifier.
    return identity_display_of(s)
}

/// `mangle_named("List", [String])` is "List__String", matching Mono.
pub fun mangle_named(name: String, args: List<TypeRef>): String {
    var result = name.clone()
    while item in &args {
        result = concat(result, concat(String.from("__"), item.tyref_mangle()))
    }
    return result
}

/// The TypeRef twin of Mono's `ty_to_mangle`: `List<int32>` is "List__int32".
pub fun TypeRef.tyref_mangle(): String {
    val tk = self.kind
    when (tk) {
        Named(n, a) => {
            if a.size() == 0 { return n.as_string() }
            return mangle_named(n.as_string(), a)
        }
        DynTrait(n, a) => {
            return concat(String.from("Dyn__"), mangle_named(n.as_string(), a))
        }
        Reference(is_mut, inner_p) => {
            val inner = unsafe { *inner_p }
            when (inner.kind) {
                // A borrowed trait object uses the Dyn__Trait fragment, as Mono.
                DynTrait(_principal, _args) => return inner.tyref_mangle()
                _ => { }
            }
            return borrow_frag(is_mut, inner.tyref_mangle().as_str())
        }
        Function(params, ret) => {
            var frags = List.new<String>()
            while param in &params {
                frags.push(param.tyref_mangle())
            }
            return fn_frag(&frags, ret.tyref_mangle().as_str())
        }
        Array(element, length) => return array_mangle_frag(element.tyref_mangle().as_str(), length ?: 0)
        // Unresolved: emitted like poison.
        Projection(_owner, _member) => return String.from("poison")
        Poison => return String.from("poison")
    }
}

/// A resolved Type to C, for positions with no annotation.
pub fun Type.c_type_of_type(): String {
    val tk = self.kind
    when (tk) {
        Int8 => return String.from("int8_t")
        Int16 => return String.from("int16_t")
        Int32 => return String.from("int32_t")
        Int64 => return String.from("int64_t")
        UInt8 => return String.from("uint8_t")
        UInt16 => return String.from("uint16_t")
        UInt32 => return String.from("uint32_t")
        UInt64 => return String.from("uint64_t")
        Float32 => return String.from("float")
        Float64 => return String.from("double")
        Bool => return String.from("bool")
        Char => return String.from("uint32_t")
        StrTy => return String.from("const char*")
        Void => return String.from("void")
        Never => return String.from("void")
        // A mangled `Ptr<T>` also arrives as Struct; see
        // mangled_pointer_pointee.
        Struct(n) => return c_type_name(String.from(type_identity_display(n).as_str()))
        EnumTy(n) => return String.from(type_identity_display(n).as_str())
        TraitTy(n) => return String.from(type_identity_display(n).as_str())
        DynTraitTy(_) => return String.from("/* dyn trait */ void")
        Generic(n) => return n.as_string()
        PtrTo(p) => return concat(c_type_of_type(unsafe { *p }), String.from("*"))
        BoxOf(p) => return concat(c_type_of_type(unsafe { *p }), String.from("*"))
        ArrayOf(_p, _length) => return self.mangle_frag()
        RefTo(_m, p) => {
            val inner = unsafe { *p }
            when (inner.kind) {
                DynTraitTy(_) => return "Dyn__${type_identity_display(dyn_trait_identity(&inner))}"
                _ => return concat(inner.c_type_of_type(), String.from("*"))
            }
        }
        FnTy(_s) => {
            val parts = self.fn_parts() ?: return String.from("void")
            var c_params = List.new<String>()
            while param in &parts.params {
                c_params.push(param.c_type_of_type())
            }
            return fn_pointer_c_type(&c_params, parts.ret.c_type_of_type().as_str())
        }
        // Emitted like poison so cc rejects it; Mono resolves projections.
        Projection(_, _) => return String.from("/* projection */ void")
        Poison => return String.from("void")
    }
}

// An impl for `name` with a `drop` method; post-mono `impl Drop for T` is a
// plain ImplBlock.
pub fun type_has_user_drop(name: String, m: &Module): bool {
    val decls = m.decls
    while td in &decls {
        if td.name.as_str().equals(name.as_str()) {
            val k = td.kind
            when (k) {
                ImplBlock(methods) => {
                    while mth in &methods {
                        if mth.name.as_str() == "drop" { return true }
                    }
                }
                _ => {}
            }
        }
    }
    return false
}

// An impl for `name` with a `clone` method.
pub fun type_has_user_clone(name: String, m: &Module): bool {
    val decls = m.decls
    while td in &decls {
        if td.name.as_str().equals(name.as_str()) {
            val k = td.kind
            when (k) {
                ImplBlock(methods) => {
                    while mth in &methods {
                        if mth.name.as_str() == "clone" && (&mth).annotation_words("derive").size() == 0 { return true }
                    }
                }
                _ => {}
            }
        }
    }
    return false
}

pub fun ty_needs_drop(t: TypeRef, m: &Module): bool {
    val tk = t.kind
    when (tk) {
        Named(name, _args) => {
            val s = name.as_str()
            // `List_<T>` or `List__T_`.
            if s.starts_with("List_") { return true }
            if type_has_user_drop(name.as_string(), m) { return true }
            return false
        }
        DynTrait(_name, _args) => return false
        Reference(_, _) => return false
        Function(_, _) => return false
        Array(_, _) => return false
        // Unresolved: treated like poison.
        Projection(_owner, _member) => return false
        Poison => return false
    }
}

/// The transitive classification for glue: also true for a declared struct or
/// enum owning heap through by-value members.
pub fun ty_needs_drop_deep(t: TypeRef, m: &Module): bool {
    if ty_needs_drop(t, m) { return true }
    when (t.kind) {
        Named(name, args) => {
            if args.size() == 0 { return declared_type_owns_heap(name.as_str(), m) }
            // A generic's ownership lives on its materialized instance
            // (`List__crate__T`), structurally, with no container special-cased.
            val inst = t.c_type()
            if type_has_user_drop(inst.clone(), m) { return true }
            return declared_type_owns_heap(inst.as_str(), m)
        }
        Array(element, _length) => return member_owns_heap(*element, m)
        _ => return false
    }
}

// By-value embedding cannot cycle in a valid module, so this terminates.
//
// CONSTRAINT: an impl block carries its type's name and may come first, so
// only the struct or enum itself answers.
fun declared_type_owns_heap(name: str, m: &Module): bool {
    while td in &m.decls {
        if td.name.as_str() == name {
            when (td.kind) {
                Struct(fields, _is_pub) => {
                    while field in &fields {
                        val field_type = unsafe { *field.ty }
                        if member_owns_heap(field_type, m) { return true }
                    }
                    return false
                }
                EnumDecl(variants, _is_pub) => {
                    while variant in &variants {
                        val payloads = variant.payloads
                        while k in 0..payloads.size() {
                            if member_owns_heap(*payloads.at(k), m) { return true }
                        }
                    }
                    return false
                }
                _ => {}
            }
        }
    }
    return false
}

// A Box owns its allocation even when its pointee owns no heap.
fun member_owns_heap(t: TypeRef, m: &Module): bool {
    when (t.kind) {
        Named(name, args) => {
            if name.as_str() == "Box" {
                if args.size() == 1 { return true }
            }
        }
        _ => {}
    }
    return ty_needs_drop_deep(t, m)
}

/// Where a value is stored: `void` is a value and needs storage. In return
/// position `c_type` still gives C `void`.
pub fun TypeRef.c_value_type(): String {
    if type_ref_is_void(self) { return String.from("kf_unit") }
    return self.c_type()
}

pub fun Type.c_value_type_of_type(): String {
    if self.type_is_unit_valued() { return String.from("kf_unit") }
    return self.c_type_of_type()
}

/// `Void` and `Never` need storage but spell themselves `void`. Keyed on the
/// kind: `Poison` spells `void` too and must not read as a unit.
pub fun Type.type_is_unit_valued(): bool {
    // Keyed on the spelling, since `Void`, `Never`, and a `Struct` substituted
    // to `void` (a `when` binder over `Holder<void>`) all arrive as `void`;
    // `Poison` is excluded.
    //
    // CONSTRAINT: `val tk = self.kind` first. A `when` directly over a kind read
    // through a reference matches no arm.
    val tk = self.kind
    when (tk) {
        Poison => return false
        _ => { }
    }
    return self.c_type_of_type().as_str().equals("void")
}

/// `void`'s one value, yielded where a `void` expression is used as a value.
pub fun kf_unit_literal(): String {
    return String.from("(kf_unit){0}")
}

/// The pointee of a mangled `Ptr__T` / `Box__T`, or "". Both are `T*` with no
/// typedef.
pub fun mangled_pointer_pointee(name: str): String {
    val n = name.byte_len()
    if mangle_has_prefix(name, "Ptr__") { return name.substring(5, n) }
    if mangle_has_prefix(name, "Box__") { return name.substring(5, n) }
    return ""
}

fun mangle_has_prefix(name: str, prefix: str): bool {
    val pn = prefix.byte_len()
    if name.byte_len() <= pn { return false }
    var i = 0
    while i < pn {
        if name.byte_at(i) != prefix.byte_at(i) { return false }
        i = i + 1
    }
    return true
}

/// A function pointer as one type specifier, so it reads like any other C
/// type in a declaration, a field or a cast.
fun fn_pointer_c_type(params: &List<String>, ret: str): String {
    var out = "__typeof__(${ret} (*)("
    if params.size() == 0 { out.append("void") }
    while i in 0..params.size() {
        if i > 0 { out.append(", ") }
        out.append(params.at(i).as_str())
    }
    out.append("))")
    return out
}

/// A fragment inside a function fragment, where a borrow is spelled
/// structurally.
fun frag_c_type(frag: str): String {
    val borrowed = borrow_frag_inner(frag)
    if borrowed.byte_len() > 0 { return concat(frag_c_type(borrowed.as_str()), String.from("*")) }
    return c_type_name(String.from(frag))
}
