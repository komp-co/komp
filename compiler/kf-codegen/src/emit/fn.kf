// Function emission: prototype, forward declaration, body.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt

import kf_codegen.concat_all
import kf_codegen.emit.*
import kf_core.ast.subst.subst_stmt_list
import kf_codegen.emit.stmt.*

// A method takes `self` by pointer so field stores persist; every `self` read
// in the body becomes `(*self)`. `owner` is the monomorphized impl target
// (`MyOpt__int32`), stamped on the rewritten node so emit_switch can still
// tell an enum `when (self)` from an int one.

fun deref_self_expr_ptr(ep: Ptr<Expr>, owner: str): void {
    val e = unsafe { *ep }
    val k = e.kind
    when (k) {
        Variable(name) => {
            if name.as_str().equals("self") {
                val esp: Span = e.span
                val inner: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *inner = e }
                var d = Expr.new(esp, ExprKind.Deref(inner))
                d.ty = Type { kind: TypeKind.Struct(intern(owner)), provenance: Provenance.Inferred(esp) }
                unsafe { *ep = d }
            }
        }
        Binary(lp, _op, rp) => {
            deref_self_expr_ptr(lp, owner)
            deref_self_expr_ptr(rp, owner)
        }
        Unary(_o, ip) => deref_self_expr_ptr(ip, owner)
        Deref(ip) => deref_self_expr_ptr(ip, owner)
        Call(_n, args) => deref_self_args(args, owner)
        Intrinsic(_intrinsic, args) => deref_self_args(args, owner)
        CallValue(callee, args) => {
            deref_self_expr_ptr(callee, owner)
            deref_self_args(args, owner)
        }
        MethodCall(rp, _m, args) => {
            deref_self_expr_ptr(rp, owner)
            deref_self_args(args, owner)
        }
        FieldAccess(rp, _f) => deref_self_expr_ptr(rp, owner)
        IfExpr(cp, tp, ep2) => {
            deref_self_expr_ptr(cp, owner)
            deref_self_expr_ptr(tp, owner)
            deref_self_expr_ptr(ep2, owner)
        }
        StructLit(_s, fields) => {
            while fi in &fields {
                deref_self_expr_ptr(fi.value, owner)
            }
        }
        Cast(ip, _t) => deref_self_expr_ptr(ip, owner)
        DynCoerce(ip, _vtable) => deref_self_expr_ptr(ip, owner)
        Retain(ip) => deref_self_expr_ptr(ip, owner)
        _ => return
    }
}

// Arguments are stored by value; each is rewritten through a pointer into the
// list.
fun deref_self_args(args: &var List<Expr>, owner: str): void {
    while i in 0..args.size() {
        // CONSTRAINT: in place through at_mut; a get/set round-trip drops the
        // old element while the copy aliases it. Cast because the checker
        // tells `&var Expr` from `Ptr<Expr>`.
        val ap: Ptr<Expr> = unsafe { args.at_mut(i) as Ptr<Expr> }
        deref_self_expr_ptr(ap, owner)
    }
}

fun deref_self_stmt_list(stmts: &var List<Stmt>, owner: str): void {
    while i in 0..stmts.size() {
        (stmts.at_mut(i)).deref_self_stmt(owner)
    }
}

fun deref_self_opt_expr_ptr(ep: Ptr<Expr>?, owner: str): void {
    val p = ep ?: return
    deref_self_expr_ptr(p, owner)
}

mutating fun Stmt.deref_self_stmt(owner: str): void {
    when (self.kind) {
        LetVal(_n, _t, ip) => deref_self_opt_expr_ptr(ip.view(), owner)
        LetVar(_n, _t, ip) => deref_self_opt_expr_ptr(ip.view(), owner)
        Assign(_n, ep) => deref_self_expr_ptr(ep, owner)
        AssignTo(pp, ep) => {
            deref_self_expr_ptr(pp, owner)
            deref_self_expr_ptr(ep, owner)
        }
        Return(ep) => {
            val p = ep ?: return
            deref_self_expr_ptr(p, owner)
        }
        If(cp, tb, eb) => {
            deref_self_expr_ptr(cp, owner)
            deref_self_stmt_list(tb, owner)
            deref_self_stmt_list(eb, owner)
        }
        While(cp, body) => {
            deref_self_expr_ptr(cp, owner)
            deref_self_stmt_list(body, owner)
        }
        When(subj, arms) => {
            deref_self_expr_ptr(subj, owner)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                when (a.guard) {
                    Some(guard) => deref_self_expr_ptr(guard, owner)
                    None => { }
                }
                deref_self_stmt_list(&var a.body, owner)
            }
        }
        Switch(subj, sarms) => {
            deref_self_expr_ptr(subj, owner)
            while i in 0..sarms.size() {
                var sa = sarms.at_mut(i)
                when (sa.guard) {
                    Some(guard) => deref_self_expr_ptr(guard, owner)
                    None => { }
                }
                deref_self_stmt_list(&var sa.guard_prelude, owner)
                deref_self_stmt_list(&var sa.body, owner)
            }
        }
        Expression(ep) => deref_self_expr_ptr(ep, owner)
        _ => return
    }
}

/// `<ret> <name>(<params>)`, with no `;` or body.
pub fun emit_fn_proto(td: TopDecl): String {
    val tdk = td.kind
    when (tdk) {
        Function(params, ret, _b, _p, _u, _m, is_static) => {
            val ret_t = unsafe { *ret }
            return "${ret_t.c_type()} ${td.name.as_string()}(${emit_params(params)})"
        }
        Extern(params, ret, _p, _u) => {
            val ret_t = unsafe { *ret }
            return "${ret_t.c_type()} ${td.name.as_string()}(${emit_params(params)})"
        }
        _ => return String.from("/* non-fn top-decl */ void __unused()")
    }
}

fun emit_params(params: List<Param>): String {
    if params.size() == 0 { return String.from("void") }
    var parts = List.new<String>()
    while i in 0..params.size() {
        val p = *params.at(i)
        val p_name = p.name.as_string()
        val p_ty_ptr = p.ty
        val p_ty = unsafe { *p_ty_ptr }
        val ty_c = p_ty.c_value_type()
        if i > 0 { parts.push(String.from(", ")) }
        parts.push("${ty_c} ${c_local_name(p_name.as_str())}")
    }
    return concat_all(parts)
}

pub fun emit_fn_forward(td: TopDecl): String {
    return "${emit_fn_proto(td)};\n"
}

// `ret Struct_m(Struct* __self, args)`: the mangled name call sites use, with
// the receiver prepended.
pub fun emit_method_proto(struct_name: String, td: TopDecl): String {
    val tdk = td.kind
    when (tdk) {
        Function(params, ret, _b, _p, _u, _m, is_static) => {
            val ret_t = unsafe { *ret }
            val suffix = "_${td.name.as_string()}"
            val ps = emit_method_params(struct_name.clone(), params, is_static)
            val ret_c = emit_method_type(struct_name.clone(), ret_t)
            return "${ret_c} ${struct_name}" + suffix + "(${ps})"
        }
        _ => return String.from("/* non-fn method */ void __unused()")
    }
}

/// For a parameter: a `void` parameter is a unit the caller still passes, so
/// it needs storage. In return position `void` stays erased.
fun emit_method_value_type(struct_name: String, tref: TypeRef): String {
    if tref.is_void() { return String.from("kf_unit") }
    return emit_method_type(struct_name, tref)
}

fun emit_method_type(struct_name: String, tref: TypeRef): String {
    when (tref.kind) {
        Named(name, args) => {
            if name.as_str().equals("Self") && args.size() == 0 { return c_type_name(struct_name) }
        }
        _ => { }
    }
    return tref.c_type()
}

fun fn_is_static(td: TopDecl): bool {
    return when (td.kind) {
        Function(_p, _r, _b, _pub, _u, _m, is_static) => is_static
        _ => false
    }
}

// An instance method takes `Struct* __self`; a `static fun` takes only its
// declared params, `(void)` when there are none.
fun emit_method_params(struct_name: String, params: List<Param>, is_static: bool): String {
    var parts = List.new<String>()
    var first: bool = true
    if !is_static {
        parts.push("${c_type_name(struct_name.clone())}* __self")
        first = false
    }
    while p in &params {
        val p_ty_ptr = p.ty
        val p_ty = unsafe { *p_ty_ptr }
        if !first { parts.push(String.from(", ")) }
        first = false
        parts.push(emit_method_value_type(struct_name.clone(), p_ty))
        parts.push(String.from(" "))
        parts.push(c_local_name(p.name.as_str()))
    }
    if first { parts.push(String.from("void")) }
    return concat_all(parts)
}

pub fun emit_method_forward(struct_name: String, td: TopDecl): String {
    return "${emit_method_proto(struct_name, td)};\n"
}

pub fun emit_method(struct_name: String, td: TopDecl, payloads: &ArmPayloads): String {
    var body = td.extract_body()
    if !fn_is_static(td) {
        deref_self_stmt_list(&var body, struct_name.as_str())
    }
    var env = build_param_env(td, payloads)
    var parts = List.new<String>()
    parts.push("${emit_method_proto(struct_name, td)} {\n")
    parts.push(emit_block(body, 1, &var env))
    parts.push(String.from("}\n\n"))
    return concat_all(parts)
}

pub fun emit_fn(td: TopDecl, payloads: &ArmPayloads): String {
    val is_main = td.name.as_str() == "main"
    if is_main {
        return emit_main_fn(td, payloads)
    }
    val body = td.extract_body()
    var env = build_param_env(td, payloads)
    var parts = List.new<String>()
    parts.push("${emit_fn_proto(td)} {\n")
    parts.push(emit_block(body, 1, &var env))
    parts.push(String.from("}\n\n"))
    return concat_all(parts)
}

fun emit_main_fn(td: TopDecl, payloads: &ArmPayloads): String {
    val body = td.extract_body()
    val ends_with_return = body_ends_with_return(body)
    var env = build_param_env(td, payloads)
    var parts = List.new<String>()
    // argv is stored in the runtime so this main can be in a different TU.
    parts.push(String.from("int main(int argc, char** argv) {\n    kf_arg_init(argc, argv);\n"))
    parts.push(emit_block(body, 1, &var env))
    if !ends_with_return {
        parts.push(String.from("    return 0;\n"))
    }
    parts.push(String.from("}\n\n"))
    return concat_all(parts)
}

// Parameters seed the env, so a by-value heap param is released at scope
// exit; borrowed params are pointers and need none.
fun build_param_env(td: TopDecl, payloads: &ArmPayloads): LocalEnv {
    var env = new_local_env()
    env.arm_payloads = payloads.clone_arm_payloads()
    val tdk = td.kind
    when (tdk) {
        Function(params, ret_p, _b, _p, _u, _m, is_static) => {
            env.ret_ctype = (&unsafe { *ret_p }).c_type()
            while p in &params {
                val pp = p.ty
                val pty = unsafe { *pp }
                val ct = pty.c_type()
                val rel = release_fn_for_ctype(ct.as_str())
                env.env_bind(p.name.as_string(), rel)
            }
        }
        _ => return env
    }
    return env
}

fun TopDecl.extract_body(): List<Stmt> {
    when (self.kind) {
        Function(_p, _r, body, _pb, _u, _m, _s) => {
            var names = List.new<String>()
            var repls = List.new<TypeRef>()
            return subst_stmt_list(&body, &var names, &var repls)
        }
        _ => return List.new<Stmt>()
    }
}

fun body_ends_with_return(body: List<Stmt>): bool {
    if body.size() == 0 { return false }
    val last = *body.at(body.size() - 1)
    val lk = last.kind
    return when (lk) {
        Return(_) => true
        _ => false
    }
}

/// Associated-type bindings have no runtime form and emit nothing; a
/// placeholder function would be redefined by a second one.
pub fun TopDecl.method_emits_code(): bool {
    if self.name.as_str() == "clone" && self.annotation_words("derive").size() > 0 { return false }
    return when (self.kind) {
        Function(_p, _r, _b, _pub, _u, _m, _s) => true
        _ => false
    }
}
