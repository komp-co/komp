import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.*
import kf_codegen.emit.new_local_env

fun guard_expr(name: str): Ptr<Expr> {
    val g: Ptr<Expr> = unsafe { alloc<Expr>() }
    var e = Expr.new(no_span(), ExprKind.Variable(intern(name)))
    e.ty = Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(no_span()) }
    unsafe { *g = e }
    return g
}

fun guarded_arm(tag: SwitchTag, guard: Box<Expr>?): SwitchArm {
    return SwitchArm.new(no_span(), tag, List.new<Sym>(), guard, List.new<Stmt>())
}

fun guard_switch_c(arms: List<SwitchArm>): String {
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    var subj = Expr.new(no_span(), ExprKind.Variable(intern("x")))
    subj.ty = Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
    unsafe { *sp = subj }
    var env = new_local_env()
    return emit_stmt(Stmt.new(no_span(), StmtKind.Switch(sp, arms)), 0, &var env)
}

// Two arms, one guarded: the switch is gone and the guard is in the test.
@test fun a_guarded_arm_emits_no_switch(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(0), guard_expr("enabled")))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    assert_eq(guard_contains(guard_switch_c(arms).as_str(), "switch ("), false, "a guard rules out a C switch")
}

@test fun a_guarded_arm_tests_its_condition(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(0), guard_expr("enabled")))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    assert_eq(guard_contains(guard_switch_c(arms).as_str(), "__enabled"), true, "the guard reaches the emitted condition")
}

@test fun a_guarded_arm_still_tests_its_pattern(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(7), guard_expr("enabled")))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    assert_eq(guard_contains(guard_switch_c(arms).as_str(), "__when_subj == 7"), true, "the pattern is tested alongside the guard")
}

// A false guard falls to the next arm.
@test fun the_arms_become_an_else_chain(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(0), guard_expr("enabled")))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    assert_eq(guard_contains(guard_switch_c(arms).as_str(), "} else if ("), true, "a failed guard reaches the next arm")
}

@test fun two_arms_on_one_value_emit_no_duplicate_label(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(0), guard_expr("a")))
    arms.push(guarded_arm(SwitchTag.IntLit(0), null))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    assert_eq(guard_count(guard_switch_c(arms).as_str(), "case 0:"), 0, "no case label to duplicate")
}

@test fun an_unguarded_switch_is_untouched(): void {
    var arms = List.new<SwitchArm>()
    arms.push(guarded_arm(SwitchTag.IntLit(0), null))
    arms.push(guarded_arm(SwitchTag.Wildcard, null))
    val c = guard_switch_c(arms)
    assert_eq(guard_contains(c.as_str(), "switch ("), true, "still a switch")
    assert_eq(guard_contains(c.as_str(), "case 0:"), true, "still a case label")
}

// Local copy: the crate's substring helpers are file-private.
fun guard_contains(s: str, needle: str): bool {
    return guard_count(s, needle) > 0
}

fun guard_count(s: str, needle: str): uint64 {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return 0 }
    if sl < nl { return 0 }
    var found: uint64 = 0
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { found = found + 1 }
        i = i + 1
    }
    return found
}
