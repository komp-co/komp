// A `when` with guards cannot be a C `switch`: a false guard must fall on to
// the next candidate, and two guarded arms over one variant would repeat a
// label. It becomes an if/else-if chain, one branch per arm in source order.

import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all
import kf_codegen.emit.*

pub fun arms_have_guard(arms: List<SwitchArm>): bool {
    while arm in &arms {
        if switch_arm_has_guard(arm) { return true }
    }
    return false
}

/// `ename` and `through_ref` are unused for a scalar subject.
pub fun emit_guarded_chain(subj: Expr, ename: String, arms: List<SwitchArm>, is_enum: bool, through_ref: bool, indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(String.from("{\n"))
    parts.push(emit_indent(indent + 1))
    // Read once into a temp shared by conditions and bodies.
    if is_enum {
        parts.push("${subj.ty.c_type_of_type()} __when_subj = ${subj.emit_expr()};\n")
    } else {
        parts.push("__auto_type __when_subj = ${subj.emit_expr()};\n")
    }
    while i in 0..arms.size() {
        parts.push(emit_chain_arm(*arms.at(i), ename.clone(), through_ref, i > 0, indent + 1, env))
    }
    if arms.size() > 0 {
        parts.push(emit_indent(indent + 1))
        parts.push(String.from("}\n"))
    }
    parts.push(emit_indent(indent))
    parts.push(String.from("}\n"))
    return concat_all(parts)
}

fun emit_chain_arm(a: SwitchArm, ename: String, through_ref: bool, chained: bool, indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    if chained {
        parts.push(String.from("} else if ("))
    } else {
        parts.push(String.from("if ("))
    }
    parts.push(a.tag.chain_test(ename.as_str(), through_ref))
    parts.push(chain_guard_test(a, through_ref, indent + 1, env))
    parts.push(String.from(") {\n"))
    parts.push(join_decls(chain_binder_decls(a, through_ref), indent + 1))
    parts.push(emit_block(a.body, indent + 1, env))
    return concat_all(parts)
}

/// `&& ({ binders prelude (guard); })` for a guarded arm, empty otherwise.
/// Binders are plain reads of `__when_subj`, so declaring them again in the
/// body is free.
fun chain_guard_test(a: SwitchArm, through_ref: bool, indent: uint64, env: &var LocalEnv): String {
    if !switch_arm_has_guard(&a) { return "" }
    var parts = List.new<String>()
    parts.push(String.from(" && ({ "))
    val decls = chain_binder_decls(a, through_ref)
    while decl in &decls {
        parts.push(decl)
        parts.push(String.from(" "))
    }
    if a.guard_prelude.size() > 0 {
        parts.push(String.from("\n"))
        parts.push(emit_block(a.guard_prelude, indent + 1, env))
        parts.push(emit_indent(indent + 1))
    }
    val g = a.guard ?: return ""
    parts.push("(${emit_expr(unsafe { &*g })}); })")
    return concat_all(parts)
}

/// One `__auto_type __x = <read of __when_subj>;` per binder; `_` declares
/// nothing.
fun chain_binder_decls(a: SwitchArm, through_ref: bool): List<String> {
    var out = List.new<String>()
    while i in 0..a.binders.size() {
        val b = a.binders.get(i)
        if !b.as_str().equals("_") {
            out.push("__auto_type ${c_local_name(b.as_str())} = ${chain_binder_rhs(a.tag, through_ref, i)};")
        }
    }
    return out
}

/// A payload member for a variant arm, the whole subject for a wildcard.
fun chain_binder_rhs(tag: SwitchTag, through_ref: bool, idx: uint64): String {
    return when (tag) {
        Variant(name) => "__when_subj${member_access(through_ref)}u.V_${name}._${idx}"
        IntLit(_) => String.from("__when_subj")
        Range(_, _) => String.from("__when_subj")
        Alternatives(_) => String.from("__when_subj")
        Wildcard => String.from("__when_subj")
    }
}

fun join_decls(decls: List<String>, indent: uint64): String {
    var parts = List.new<String>()
    while decl in &decls {
        parts.push(emit_indent(indent))
        parts.push(decl)
        parts.push(String.from("\n"))
    }
    return concat_all(parts)
}
