// A `when` over a non-enum subject lowers to a plain C switch with a
// `case <n>:` per literal arm.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.*
import kf_codegen.emit.new_local_env

fun scalar_arm(tag: SwitchTag): SwitchArm {
    return SwitchArm.new(no_span(), tag, List.new<Sym>(), null, List.new<Stmt>())
}

// `switch (__x) { ... }` for a bare `uint64` subject named x.
fun scalar_switch_c(arms: List<SwitchArm>): String {
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    var subj = Expr.new(no_span(), ExprKind.Variable(intern("x")))
    subj.ty = Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
    unsafe { *sp = subj }
    var env = new_local_env()
    return emit_stmt(Stmt.new(no_span(), StmtKind.Switch(sp, arms)), 0, &var env)
}

@test fun an_integer_arm_emits_a_case_label(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.IntLit(7)))
    assert_eq(scalar_contains(scalar_switch_c(arms).as_str(), "case 7:"), true, "the literal becomes its case constant")
}

@test fun an_integer_arm_is_not_a_default_label(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.IntLit(7)))
    assert_eq(scalar_contains(scalar_switch_c(arms).as_str(), "default:"), false, "a literal arm is not the fallback")
}

// A `when` whose only arm is the catch-all emits no switch; the body runs
// unconditionally.
@test fun a_lone_wildcard_arm_emits_no_switch(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.Wildcard))
    val c = scalar_switch_c(arms)
    assert_eq(scalar_contains(c.as_str(), "switch"), false, "nothing is dispatched on")
    assert_eq(scalar_contains(c.as_str(), "default:"), false, "and so there is no label either")
}

// The subject is still evaluated.
@test fun a_lone_wildcard_arm_still_evaluates_its_subject(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.Wildcard))
    assert_eq(scalar_contains(scalar_switch_c(arms).as_str(), "__when_subj = __x"), true, "the subject is read once")
}

@test fun literal_arms_beside_a_wildcard_emit_one_default(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.IntLit(0)))
    arms.push(scalar_arm(SwitchTag.IntLit(1)))
    arms.push(scalar_arm(SwitchTag.Wildcard))
    assert_eq(scalar_count(scalar_switch_c(arms).as_str(), "default:"), 1, "exactly one default label")
}

// `true =>` / `false =>` arrive as 1 and 0.
@test fun a_bool_arm_emits_its_integer_case(): void {
    var arms = List.new<SwitchArm>()
    arms.push(scalar_arm(SwitchTag.IntLit(1)))
    assert_eq(scalar_contains(scalar_switch_c(arms).as_str(), "case 1:"), true, "`true` is case 1")
}

// Local copy: the crate's substring helpers are file-private.
fun scalar_contains(s: str, needle: str): bool {
    return scalar_count(s, needle) > 0
}

fun scalar_count(s: str, needle: str): uint64 {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return 0 }
    if sl < nl { return 0 }
    var found: uint64 = 0
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { found = found + 1 }
        i = i + 1
    }
    return found
}
