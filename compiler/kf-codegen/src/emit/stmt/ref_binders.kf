// A binder its arm writes through is the address of its payload. When any arm
// has one, `__when_subj` holds the subject's address instead of a copy, so the
// write reaches the subject.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.statement.SwitchArm

pub fun arms_have_ref_binders(arms: &List<SwitchArm>): bool {
    while arm in &arms {
        if arm.ref_binders.size() > 0 { return true }
    }
    return false
}

pub fun SwitchArm.binds_by_ref(b: Sym): bool {
    while r in &self.ref_binders {
        if r.as_str() == b.as_str() { return true }
    }
    return false
}

/// `<T> __when_subj = <subject>;`, or `<T>* __when_subj = &(<subject>);`.
pub fun when_subject_decl(c_type: String, subject: String, by_address: bool): String {
    if by_address { return "${c_type}* __when_subj = &(${subject});\n" }
    return "${c_type} __when_subj = ${subject};\n"
}

/// A payload read, or its address for a reference binder.
pub fun binder_init(read: String, by_ref: bool): String {
    if by_ref { return "&(${read})" }
    return read
}

/// The whole subject for a catch-all binder: the pointer for a reference
/// binder, the value otherwise.
pub fun whole_subject_read(by_ref: bool, by_address: bool): String {
    if by_ref { return if by_address { String.from("__when_subj") } else { String.from("&__when_subj") } }
    if by_address { return String.from("(*__when_subj)") }
    return String.from("__when_subj")
}
