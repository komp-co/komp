// The `case` labels an arm's tag becomes, and the same test as a condition
// for the if/else chain a guarded `when` lowers to.

import alloc.list.*

import kf_core.ast.enum_tag_const
import kf_core.ast.statement.SwitchTag

import kf_codegen.concat_all

/// `case 3:`, `case 0 ... 31:` (a GNU range), or one label per alternative.
/// A variant names its enum's tag constant when `ename` is set.
pub fun SwitchTag.case_labels(ename: str): String {
    return when (self) {
        Variant(name) => {
            val label = if ename.byte_len() > 0 { enum_tag_const(ename, name.as_str()) } else { name.clone() }
            "case ${label}: "
        }
        IntLit(n) => "case ${emit_case_value(n)}: "
        Range(low, high) => "case ${emit_case_value(low)} ... ${emit_case_value(high)}: "
        Alternatives(tags) => {
            var parts = List.new<String>()
            while tag in &tags {
                parts.push(tag.case_labels(ename))
            }
            concat_all(parts)
        }
        Wildcard => String.from("default: ")
    }
}

/// The tag as a C condition over `__when_subj`; a wildcard is `1`.
pub fun SwitchTag.chain_test(ename: str, through_ref: bool): String {
    return when (self) {
        Variant(name) => "__when_subj${member_access(through_ref)}tag == ${enum_tag_const(ename, name.as_str())}"
        IntLit(n) => "__when_subj == ${emit_case_value(n)}"
        Range(low, high) => "(__when_subj >= ${emit_case_value(low)} && __when_subj <= ${emit_case_value(high)})"
        Alternatives(tags) => {
            var parts = List.new<String>()
            while i in 0..tags.size() {
                if i > 0 { parts.push(String.from(" || ")) }
                parts.push(tags.at(i).chain_test(ename, through_ref))
            }
            "(${concat_all(parts)})"
        }
        Wildcard => String.from("1")
    }
}
