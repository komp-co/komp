// The C for one statement and the control flow built from statements. Every
// entry takes a `&var LocalEnv`, since emitting a binding records its release
// function and loops push `break` labels.

import alloc.list.*

import kf_core.ast.c_local_name
import kf_core.ast.view
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.type_identity_display
import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.SwitchArm

import kf_codegen.concat_all
import kf_codegen.emit.*
import kf_codegen.emit.expr.emit_expr
import kf_core.ast.enum_tag_const

pub fun emit_block(stmts: &List<Stmt>, indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    while i in 0..stmts.size() {
        val s = *stmts.at(i)
        parts.push(emit_stmt(s, indent, env))
    }
    return concat_all(parts)
}

pub fun emit_stmt(s: Stmt, indent: uint64, env: &var LocalEnv): String {
    return when (s.kind) {
        LetVal(name, ty_p, init_p) => emit_let(name.as_string(), ty_p.view(), init_p.view(), indent, env)
        LetVar(name, ty_p, init_p) => emit_let(name.as_string(), ty_p.view(), init_p.view(), indent, env)
        Assign(name, vp) => emit_assign(name.as_string(), vp, indent)
        AssignTo(pp, vp) => emit_assign_to(pp, vp, indent)
        Return(opt_p) => emit_return(opt_p.view(), indent, env)
        Expression(ep) => emit_expr_stmt(ep, indent)
        Release(name) => emit_release(name.as_string(), indent, env)
        Drop(name) => emit_release(name.as_string(), indent, env)
        If(cp, then_body, else_body) => emit_if(cp, then_body, else_body, indent, env)
        While(cp, body) => emit_while(cp, body, indent, env)
        // Lower rewrites it; reaching one means that pass was skipped.
        ForEach(_b, _s, _bd) => emit_unhandled("while-in", indent)
        Break => env.emit_break(indent)
        Continue => emit_jump("continue;", indent)
        When(_, _) => emit_unhandled("when", indent)
        Switch(sp, arms) => emit_switch(sp, arms, indent, env)
        Poison => emit_unhandled("poison", indent)
    }
}

fun emit_if(cp: Ptr<Expr>, then_body: List<Stmt>, else_body: List<Stmt>, indent: uint64, env: &var LocalEnv): String {
    val cond = unsafe { *cp }
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push("if (${cond.emit_expr()}) {\n")
    parts.push(emit_block(then_body, indent + 1, env))
    parts.push(emit_indent(indent))
    parts.push("}")
    if else_body.size() > 0 {
        parts.push(" else {\n")
        parts.push(emit_block(else_body, indent + 1, env))
        parts.push(emit_indent(indent))
        parts.push("}")
    }
    parts.push("\n")
    return concat_all(parts)
}

fun emit_while(cp: Ptr<Expr>, body: List<Stmt>, indent: uint64, env: &var LocalEnv): String {
    val cond = unsafe { *cp }
    // A targeting `break` lowers to `goto <label>` to escape a `switch`; the
    // label is emitted only when the body breaks.
    val needs_label = loop_body_breaks(body)
    var label = ""
    if needs_label {
        label = env.make_brk_label()
        env.loop_labels.push(label.clone())
    }
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push("while (${cond.emit_expr()}) {\n")
    parts.push(emit_block(body, indent + 1, env))
    parts.push(emit_indent(indent))
    parts.push(String.from("}\n"))
    if needs_label {
        env.pop_last_label()
        parts.push(emit_indent(indent))
        parts.push("${label}: ;\n")
    }
    return concat_all(parts)
}

mutating fun LocalEnv.make_brk_label(): String {
    val n = self.label_counter
    self.label_counter = n + 1
    val ns = "${n}"
    return "__brk_${ns}"
}

/// List has no pop, so the list is rebuilt without the last.
mutating fun LocalEnv.pop_last_label(): void {
    val labels = self.loop_labels
    val n = labels.size()
    if n == 0 { return }
    var fresh = List.new<String>()
    var i = 0
    while i < n - 1 {
        fresh.push(*labels.at(i))
        i = i + 1
    }
    self.loop_labels = fresh
}

/// A `break` targeting this loop, through if/when/switch but not a nested
/// `while`.
fun loop_body_breaks(body: &List<Stmt>): bool {
    while item in &body {
        if (item).stmt_has_break() { return true }
    }
    return false
}

fun Stmt.stmt_has_break(): bool {
    when (self.kind) {
        Break => return true
        If(_c, then_body, else_body) => {
            if loop_body_breaks(then_body) { return true }
            return loop_body_breaks(else_body)
        }
        Switch(_s, arms) => {
            while arm in &arms {
                if loop_body_breaks(arm.body) { return true }
            }
            return false
        }
        When(_s, arms) => {
            while arm in &arms {
                if loop_body_breaks(arm.body) { return true }
            }
            return false
        }
        While(_c, _b) => return false
        ForEach(_b2, _s2, _bd2) => return false
        Continue => return false
        LetVal(_n, _t, _i) => return false
        LetVar(_n, _t, _i) => return false
        Assign(_n, _v) => return false
        AssignTo(_p, _v) => return false
        Return(_v) => return false
        Expression(_e) => return false
        Drop(_n) => return false
        Release(_n) => return false
        Poison => return false
    }
}

/// `goto <nearest loop label>;`, or a bare `break;` outside one.
mutating fun LocalEnv.emit_break(indent: uint64): String {
    val n = self.loop_labels.size()
    if n == 0 {
        return emit_jump("break;", indent)
    }
    val label = *self.loop_labels.at(n - 1)
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push("goto ${label};\n")
    return concat_all(parts)
}

// An enum subject switches on its tag; any other subject is a plain value
// switch.
fun emit_switch(sp: Ptr<Expr>, arms: List<SwitchArm>, indent: uint64, env: &var LocalEnv): String {
    val subj = unsafe { *sp }
    val ename = when_subject_enum_name(subj.ty)
    val enl = ename.as_str().byte_len()
    // Enums arrive as Struct(name), so variant-tagged arms are what identify
    // an enum match.
    val is_enum = enl > 0 && arms_have_variant(arms)
    // A borrowed subject is already an address; see ref_binders.kf.
    val by_address = arms_have_ref_binders(&arms) && !ty_is_borrow(subj.ty)
    val through_ref = ty_is_borrow(subj.ty) || by_address
    // A guard makes a `case` label the wrong shape; see switch_guard.kf.
    if arms_have_guard(arms) {
        return emit_guarded_chain(subj, String.from(ename.as_str()), arms, is_enum, by_address, indent, env)
    }
    // Only catch-alls: no switch at all; see when_uncontested.kf.
    if arms_are_all_wildcards(arms) {
        return emit_uncontested_arm(subj, arms, by_address, indent, env)
    }
    if is_enum {
        return emit_enum_switch(subj, String.from(ename.as_str()), arms, through_ref, by_address, indent, env)
    }
    return emit_scalar_switch(subj, arms, indent, env)
}

// A whole-subject binder gets the block-scoped `__when_subj`; otherwise a bare
// `switch (<subject>)`.
fun emit_scalar_switch(subj: Expr, arms: List<SwitchArm>, indent: uint64, env: &var LocalEnv): String {
    val binds = arms_have_binders(arms)
    var parts = List.new<String>()
    var body_indent = indent
    if binds {
        parts.push(emit_indent(indent))
        parts.push(String.from("{\n"))
        body_indent = indent + 1
        parts.push(emit_indent(body_indent))
        parts.push("__auto_type __when_subj = ${subj.emit_expr()};\n")
    }
    parts.push(emit_indent(body_indent))
    parts.push(String.from("switch ("))
    if binds {
        parts.push(String.from("__when_subj"))
    } else {
        parts.push(subj.emit_expr())
    }
    parts.push(String.from(") {\n"))
    while a in &arms {
        parts.push(emit_arm(a, body_indent + 1, env))
    }
    parts.push(emit_indent(body_indent))
    parts.push(String.from("}\n"))
    if binds {
        parts.push(emit_indent(indent))
        parts.push(String.from("}\n"))
    }
    return concat_all(parts)
}

// The subject is bound once to a block-scoped `__when_subj`, then each arm is
// `case kf__tag__<Enum>__<Variant>:` plus its payload binds.
fun emit_enum_switch(subj: Expr, ename: String, arms: List<SwitchArm>, through_ref: bool, by_address: bool,
    indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(String.from("{\n"))
    parts.push(emit_indent(indent + 1))
    parts.push(when_subject_decl(subj.ty.c_type_of_type(), subj.emit_expr(), by_address))
    parts.push(emit_indent(indent + 1))
    parts.push("switch (__when_subj${member_access(through_ref)}tag) {\n")
    while arm in &arms {
        parts.push(emit_enum_arm(arm, ename.clone(), through_ref, by_address, indent + 2, env))
    }
    parts.push(emit_indent(indent + 1))
    parts.push(String.from("}\n"))
    parts.push(emit_indent(indent))
    parts.push(String.from("}\n"))
    return concat_all(parts)
}

fun emit_enum_arm(a: SwitchArm, ename: String, through_ref: bool, by_address: bool, indent: uint64,
    env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val tag = a.tag
    when (tag) {
        Variant(name) => {
            parts.push("case ${enum_tag_const(ename.as_str(), name.as_str())}: {\n")
            // Each payload binds through the union member; `__auto_type`
            // saves threading its C type.
            while bi in 0..a.binders.size() {
                val b = a.binders.get(bi)
                // A `_` binder emits nothing (several would collide as `___`),
                // but the index still advances.
                val is_wild = b.as_str().equals("_")
                if !is_wild {
                    val bstr = "${bi}"
                    parts.push(emit_indent(indent + 1))
                    val read = "__when_subj${member_access(through_ref)}u.V_${name}._${bstr}"
                    val by_ref = a.binds_by_ref(b)
                    parts.push("__auto_type ${c_local_name(b.as_str())} = ${binder_init(read, by_ref)};\n")
                    // Records the binder's release function, since the C type
                    // is only known to C. A reference owns nothing.
                    var rel = String.from("")
                    if !by_ref { rel = env.arm_payloads.arm_payload_release(ename.as_str(), name.as_str(), bi) }
                    env.env_bind(b.as_string(), rel)
                }
            }
        }
        // Only a mixed `when`, which typecheck rejects, reaches here with an
        // integer tag; an enum tag is an int, so a well-formed label is emitted.
        IntLit(_) => parts.push("${tag.case_labels(ename.as_str())}{\n")
        Range(_, _) => parts.push("${tag.case_labels(ename.as_str())}{\n")
        // Alternatives bind nothing.
        Alternatives(_) => parts.push("${tag.case_labels(ename.as_str())}{\n")
        Wildcard => {
            parts.push(String.from("default: {\n"))
            parts.push(emit_subject_binders(&a, by_address, indent + 1))
        }
    }
    parts.push(emit_block(a.body, indent + 1, env))
    parts.push(emit_indent(indent + 1))
    parts.push(String.from("break;\n"))
    parts.push(emit_indent(indent))
    parts.push(String.from("}\n"))
    return concat_all(parts)
}

/// `other => ...`; a `_` binds nothing.
fun emit_subject_binders(a: &SwitchArm, by_address: bool, indent: uint64): String {
    var parts = List.new<String>()
    while b in &a.binders {
        if !b.as_str().equals("_") {
            parts.push(emit_indent(indent))
            val read = whole_subject_read(a.binds_by_ref(b), by_address)
            parts.push("__auto_type ${c_local_name(b.as_str())} = ${read};\n")
        }
    }
    return concat_all(parts)
}

fun arms_have_binders(arms: List<SwitchArm>): bool {
    while arm in &arms {
        if arm.binders.size() > 0 { return true }
    }
    return false
}

/// Through a `&Kind` subject; Ptr and Box need an explicit deref.
fun when_subject_enum_name(t: Type): String {
    return when (t.kind) {
        RefTo(_m, p) => enum_name_of_type(unsafe { *p })
        _ => enum_name_of_type(t)
    }
}

fun ty_is_borrow(t: Type): bool {
    return when (t.kind) {
        RefTo(_m, _p) => true
        _ => false
    }
}

fun member_access(through_ref: bool): String {
    if through_ref { return String.from("->") }
    return String.from(".")
}

// The nominal name, or ""; callers decide enum versus struct.
pub fun enum_name_of_type(t: Type): String {
    return when (t.kind) {
        Struct(n) => type_identity_display(n)
        EnumTy(n) => type_identity_display(n)
        _ => ""
    }
}

fun arms_have_variant(arms: List<SwitchArm>): bool {
    while item in &arms {
        val tag = item.tag
        when (tag) {
            Variant(_) => return true
            Alternatives(tags) => {
                while alternative in &tags {
                    when (alternative) {
                        Variant(_) => return true
                        _ => {}
                    }
                }
            }
            // A scalar arm never makes it an enum match.
            IntLit(_) => {}
            Range(_, _) => {}
            Wildcard => {}
        }
    }
    return false
}

fun emit_arm(a: SwitchArm, indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val tag = a.tag
    when (tag) {
        Wildcard => {
            parts.push(String.from("default: {\n"))
            parts.push(emit_subject_binders(&a, false, indent + 1))
        }
        _ => parts.push("${tag.case_labels("")}{\n")
    }
    parts.push(emit_block(a.body, indent + 1, env))
    parts.push(emit_indent(indent + 1))
    parts.push(String.from("break;\n"))
    parts.push(emit_indent(indent))
    parts.push(String.from("}\n"))
    return concat_all(parts)
}

/// A `case` label's constant.
fun emit_case_value(n: int64): String {
    return "${n}"
}

fun emit_indent(n: uint64): String {
    var parts = List.new<String>()
    var i = 0
    while i < n {
        parts.push(String.from("    "))
        i = i + 1
    }
    return concat_all(parts)
}

fun emit_let(name: String, ty_p: Ptr<TypeRef>?, init_p: Ptr<Expr>?, indent: uint64, env: &var LocalEnv): String {
    // A null init is Lower's `var __whenN: T`, which always carries an
    // annotation. CONSTRAINT: a separate function, so the two `?:` do not
    // nest; a nested one swallows the rest of its block.
    val ip = init_p ?: return emit_uninitialized_let_opt(name, ty_p, indent, env)
    val ct = emit_let_type(ty_p, ip)
    val init0 = unsafe { *ip }
    val rel = box_or_normal_release(init0.ty, ct)
    env.env_bind(name.clone(), rel)
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(ct.clone())
    parts.push(String.from(" "))
    parts.push(c_local_name(name.as_str()))
    parts.push(String.from(" = "))
    val init = unsafe { *ip }
    // A `void` initializer is still called for its effects, yielding the
    // unit. Decided by the slot, not the expression: the `?` desugar's
    // `__payload` is a `void` call that is neither a Call nor a MethodCall.
    if ct.as_str().equals("kf_unit") {
        parts.push(String.from("({ "))
        parts.push(init.emit_expr())
        parts.push(String.from("; "))
        parts.push(kf_unit_literal())
        parts.push(String.from("; })"))
    } else {
        parts.push(init.emit_expr())
    }
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

/// `T __name = {0};`, bound with no release function: its value moves into
/// the binding that reads it, which releases it.
fun emit_uninitialized_let_opt(name: String, ty_p: Ptr<TypeRef>?, indent: uint64, env: &var LocalEnv): String {
    val ann_p = ty_p ?: return ""
    return emit_uninitialized_let(name, ann_p, indent, env)
}

fun emit_uninitialized_let(name: String, ty_p: Ptr<TypeRef>, indent: uint64, env: &var LocalEnv): String {
    val ann = unsafe { *ty_p }
    val ct = ann.c_type()
    env.env_bind(name.clone(), "")
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(ct)
    parts.push(String.from(" "))
    parts.push(c_local_name(name.as_str()))
    parts.push(String.from(" = {0};\n"))
    return concat_all(parts)
}

// The annotation, else the initializer's inferred `.ty`; a syntactic guess
// only when `.ty` is poison (hand-built test ASTs).
fun emit_let_type(ty_p: Ptr<TypeRef>?, init_p: Ptr<Expr>): String {
    when (ty_p) {
        Some(p) => {
            val ann = unsafe { *p }
            return ann.c_value_type()
        }
        None => { }
    }
    val init = unsafe { *init_p }
    val ity = init.ty
    val itk = ity.kind
    var is_poison = false
    when (itk) {
        Poison => is_poison = true
        _ => is_poison = false
    }
    if !is_poison { return ity.c_value_type_of_type() }
    val ek = init.kind
    when (ek) {
        StructLit(sname, _f) => return sname.as_string()
        Call(cname, _a) => {
            return String.from("int32_t")
        }
        LitStr(_) => return String.from("const char*")
        _ => return String.from("int32_t")
    }
}

// `*p = rhs` / `e.field = rhs`, the place emitted by emit_expr.
fun emit_assign_to(pp: Ptr<Expr>, vp: Ptr<Expr>, indent: uint64): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val place = unsafe { *pp }
    parts.push(place.emit_expr())
    parts.push(String.from(" = "))
    val v = unsafe { *vp }
    parts.push(v.emit_expr())
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

fun emit_assign(name: String, vp: Ptr<Expr>, indent: uint64): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(c_local_name(name.as_str()))
    parts.push(String.from(" = "))
    val v = unsafe { *vp }
    parts.push(v.emit_expr())
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

fun emit_return(opt_p: Ptr<Expr>?, indent: uint64, env: &var LocalEnv): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val ep = opt_p ?: return emit_bare_return(parts)
    val e = unsafe { *ep }
    // A `void` operand in a `void` function is evaluated for its effects and
    // nothing is returned (`Result<void, E>.unwrap`'s `return v`).
    if env.ret_ctype.as_str().equals("void") {
        parts.push(String.from("(void)("))
        parts.push(e.emit_expr())
        parts.push(String.from("); return;\n"))
        return concat_all(parts)
    }
    parts.push(String.from("return "))
    parts.push(e.emit_expr())
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

/// `return;`, onto an already-indented prefix.
fun emit_bare_return(parts: List<String>): String {
    var out = parts
    out.push(String.from("return;\n"))
    return concat_all(out)
}

fun emit_expr_stmt(ep: Ptr<Expr>, indent: uint64): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val e = unsafe { *ep }
    parts.push(e.emit_expr())
    parts.push(String.from(";\n"))
    return concat_all(parts)
}

fun emit_box_release(rel: String, name: String, indent: uint64): String {
    val rs = rel.as_str()
    val n = rs.byte_len()
    val innerdrop = rs.substring(7, n) // after "__BOX__"
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    val has_inner = innerdrop.as_str().byte_len() > 0
    if has_inner {
        parts.push(innerdrop.clone())
        parts.push(String.from("((*"))
        parts.push(c_local_name(name.as_str()))
        parts.push(String.from(")); "))
    }
    parts.push(String.from("kf_free("))
    parts.push(c_local_name(name.as_str()))
    parts.push(String.from(");\n"))
    return concat_all(parts)
}

fun emit_release(name: String, indent: uint64, env: &var LocalEnv): String {
    val rel = env.env_release_fn(name.clone())
    if rel.as_str().starts_with("__BOX__") {
        return emit_box_release(rel, name, indent)
    }
    val rl = rel.as_str().byte_len()
    if rl == 0 { return "" }
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(rel.clone())
    parts.push(String.from("("))
    parts.push(c_local_name(name.as_str()))
    parts.push(String.from(");\n"))
    return concat_all(parts)
}

// `break;` / `continue;`. Like `return`, skips the scope-end releases.
fun emit_jump(kw: str, indent: uint64): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(String.from(kw))
    parts.push(String.from("\n"))
    return concat_all(parts)
}

fun emit_unhandled(label: str, indent: uint64): String {
    var parts = List.new<String>()
    parts.push(emit_indent(indent))
    parts.push(String.from("/* unhandled stmt: "))
    parts.push(String.from(label))
    parts.push(String.from(" */\n"))
    return concat_all(parts)
}
