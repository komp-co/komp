import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all
import kf_codegen.emit.c_type_of_type
import kf_codegen.emit.clone_fn_for_ctype
import kf_codegen.emit.dyn_traits.emit_dyn_call
import kf_codegen.emit.dyn_traits.emit_dyn_coerce

// Converts an integer to the source text codegen emits into C.

// Applies the conversion TypeCheck recorded in `e.coerce`, so no emit site
// needs to know the slot it flows into.
pub fun Expr.emit_expr(): String {
    // To a `const char*` for a `str` slot. emit_cstr calls emit_expr_base, so
    // the coercion is not applied twice.
    if self.coerce == coerce_to_cstr() {
        return self.emit_cstr()
    }
    val base = self.emit_expr_base()
    // The address of a value passed to a `&T`/`&var T` parameter. A
    // non-lvalue is materialized as `(T[1]){ ... }`, which decays to `T*` and
    // lives to the end of the enclosing block (C99 6.5.2.5), past the call. No
    // drop is emitted for it, so a fresh owned rvalue borrowed this way leaks.
    if self.coerce == coerce_addr_of() {
        var parts = List.new<String>()
        if self.addr_operand_is_lvalue() {
            parts.push(String.from("(&"))
            parts.push(base)
            parts.push(String.from(")"))
            return concat_all(parts)
        }
        parts.push(String.from("(("))
        parts.push(self.ty.c_type_of_type())
        parts.push(String.from("[1]){ "))
        parts.push(base)
        parts.push(String.from(" })"))
        return concat_all(parts)
    }
    // An auto-clone the move checker marked: a deep copy, or the bare value
    // for a primitive or pointer.
    if self.coerce == coerce_clone() {
        when (self.ty.kind) {
            BoxOf(_) => return emit_box_copy(base, self.ty.c_type_of_type())
            _ => { }
        }
        val ct = self.ty.c_type_of_type()
        val cf = clone_fn_for_ctype(ct.as_str())
        if cf.as_str().byte_len() == 0 {
            return base
        }
        var parts = List.new<String>()
        parts.push(cf.clone())
        parts.push(String.from("("))
        parts.push(base)
        parts.push(String.from(")"))
        return concat_all(parts)
    }
    return base
}

/// A copied `Box` owns a fresh copy of its pointee: two owners of one
/// allocation would each free it.
fun emit_box_copy(base: String, box_ct: String): String {
    val ct = box_ct.as_str().substring(0, box_ct.byte_len() - 1)
    val cf = clone_fn_for_ctype(ct.as_str())
    val value = if cf.as_str().byte_len() > 0 { "${cf}(*__src)" } else { String.from("*__src") }
    return "({ ${ct}* __src = ${base}; ${ct}* __copy = __src ? (${ct}*)kf_alloc(sizeof(${ct})) : NULL; " +
        "if (__copy) { *__copy = ${value}; } __copy; })"
}

fun Expr.emit_expr_base(): String {
    when (self.kind) {
        LitInt(n) => return emit_lit_int(n)
        LitBool(b) => return emit_lit_bool(b)
        LitStr(s) => return emit_lit_str(s)
        LitFloat(text) => return emit_lit_float(text)
        LitChar(scalar) => return emit_lit_char(scalar)
        Variable(name) => return prefix_local(name.as_string())
        Binary(lp, op, rp) => return emit_binop(lp, op, rp)
        Unary(op, ip) => return emit_unop(op, ip)
        Deref(ip) => return emit_deref(ip)
        Call(name, args) => {
            if name.as_str() == array_literal_callee() { return self.emit_array_literal(&args) }
            if name.as_str() == array_data_callee() { return self.emit_array_data(&args) }
            return emit_call(name.as_string(), self.mangled_callee.as_string(), args, self.is_intrinsic)
        }
        FnRef(name) => return pick_callee(name.as_string(), self.mangled_callee.as_string())
        CallValue(callee_p, args) => return emit_call_value(callee_p, args)
        MethodCall(recv_p, mname, margs) => {
            if self.is_dynamic_call { return self.emit_dyn_call(recv_p, mname, margs) }
            val array_method = (*recv_p).emit_array_method(mname.as_str(), &margs)
            if array_method.byte_len() > 0 { return array_method }
            return self.emit_method_or_enum_ctor(recv_p, mname.as_string(), margs)
        }
        FieldAccess(recv_p, fname) => return self.emit_field_or_enum_ctor(recv_p, fname.as_string())
        StructLit(sname, finits) => return emit_struct_lit(self.struct_lit_name(sname.as_string()), finits)
        IfExpr(cp, tp, ep2) => return emit_if_expr(cp, tp, ep2)
        // Lower rewrites `when` values; reaching one is a bug.
        WhenExpr(_, _) => return String.from("/* unlowered when-expression */ 0")
        Cast(ip, typ) => return emit_cast(ip, typ)
        DynCoerce(ip, vtable) => return self.emit_dyn_coerce(ip, vtable)
        Retain(inner_p) => return emit_retain_expr(inner_p)
        Release(_) => return String.from("/* release-expr */ 0")
        // TypeCheck replaces every lambda; reaching one is a bug.
        Lambda(_, _) => return String.from("/* lambda */ 0")
        // Lower rewrites block values; reaching one is a bug.
        Block(_) => return String.from("/* unlowered block-expression */ 0")
        Poison => return String.from("/* poison */ 0")
    }
}

// `(c ? a : b)`.
fun emit_if_expr(cond_p: Ptr<Expr>, then_p: Ptr<Expr>, else_p: Ptr<Expr>): String {
    val c = emit_expr(unsafe { *cond_p })
    val t = emit_expr(unsafe { *then_p })
    val el = emit_expr(unsafe { *else_p })
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(c)
    parts.push(String.from(" ? "))
    parts.push(t)
    parts.push(String.from(" : "))
    parts.push(el)
    parts.push(String.from(")"))
    return concat_all(parts)
}

fun emit_lit_int(n: int64): String {
    return "${n}"
}

// The literal's own spelling, already valid C for a double.
fun emit_lit_float(text: String): String {
    return text.clone()
}

// A Unicode scalar as uint32_t; a C character constant stops at ASCII.
fun emit_lit_char(scalar: uint32): String {
    return "${scalar}"
}

fun emit_lit_bool(b: bool): String {
    if b { return String.from("true") }
    return String.from("false")
}

/// The AST holds the literal's decoded bytes; this re-spells them for C. The
/// named C escapes go out named, other control bytes as three-digit octal
/// (C's `\x` is greedy), bytes >= 0x80 unchanged.
fun emit_lit_str(s: String): String {
    var out = String.from("\"")
    val raw = s.as_str()
    val n: uint64 = raw.byte_len()
    var i = 0
    while i < n {
        val b: uint8 = raw.byte_at(i)
        if b == 34 {
            out.append("\\\"")
        } else if b == 92 {
            out.append("\\\\")
        } else if b == 7 {
            out.append("\\a")
        } else if b == 8 {
            out.append("\\b")
        } else if b == 9 {
            out.append("\\t")
        } else if b == 10 {
            out.append("\\n")
        } else if b == 11 {
            out.append("\\v")
        } else if b == 12 {
            out.append("\\f")
        } else if b == 13 {
            out.append("\\r")
        } else if b < 32 || b == 127 {
            out.append(c_octal_escape(b).as_str())
        } else {
            out.push_byte(b)
        }
        i = i + 1
    }
    out.append("\"")
    return out
}

/// `\NNN`, always three digits so the next byte cannot join the escape.
fun c_octal_escape(b: uint8): String {
    var out = String.from("\\")
    val hi: uint8 = b / 64
    val mid: uint8 = (b / 8) % 8
    val lo: uint8 = b % 8
    out.push_byte(48 + hi)
    out.push_byte(48 + mid)
    out.push_byte(48 + lo)
    return out
}

fun prefix_local(name: String): String {
    return c_local_name(name.as_str())
}

pub fun struct_ty_name(t: Type): String {
    return when (t.kind) {
        Struct(n) => type_identity_display(n)
        PtrTo(p) => struct_ty_name(unsafe { *p })
        BoxOf(p) => struct_ty_name(unsafe { *p })
        RefTo(_, p) => struct_ty_name(unsafe { *p })
        _ => ""
    }
}

// As a `const char*`: a literal raw, an owning string's `.data`, a `str` as is.
fun Expr.emit_cstr(): String {
    when (self.kind) {
        LitStr(s) => return emit_lit_str(s.clone())
        _ => {}
    }
    if self.coerce == coerce_to_cstr() {
        var parts = List.new<String>()
        parts.push(String.from("("))
        parts.push(self.emit_expr_base())
        parts.push(String.from(").data"))
        return concat_all(parts)
    }
    return self.emit_expr_base()
}
