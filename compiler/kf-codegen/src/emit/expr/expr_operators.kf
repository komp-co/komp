import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all

fun BinOp.binop_to_c(): String {
    return when (self) {
        Add => String.from("+")
        Sub => String.from("-")
        Mul => String.from("*")
        Div => String.from("/")
        Mod => String.from("%")
        Eq => String.from("==")
        NotEq => String.from("!=")
        Lt => String.from("<")
        Gt => String.from(">")
        LtEq => String.from("<=")
        GtEq => String.from(">=")
        AndAnd => String.from("&&")
        OrOr => String.from("||")
        Shl => String.from("<<")
        Shr => String.from(">>")
        BitAnd => String.from("&")
        BitOr => String.from("|")
        BitXor => String.from("^")
    }
}

// `expr as Type` is `(<c_type>)(<inner>)`, chiefly `0 as Ptr<T>` -> `(T*)(0)`.
fun emit_cast(ip: Ptr<Expr>, typ: Ptr<TypeRef>): String {
    val inner = unsafe { *ip }
    val tref = unsafe { *typ }
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(tref.c_type())
    parts.push(String.from(")("))
    parts.push(inner.emit_expr())
    parts.push(String.from(")"))
    return concat_all(parts)
}

// `(*<operand>)`, parenthesized against surrounding postfix operators.
fun emit_deref(ip: Ptr<Expr>): String {
    val inner = unsafe { *ip }
    val inner_c = inner.emit_expr()
    var parts = List.new<String>()
    parts.push(String.from("(*"))
    parts.push(inner_c)
    parts.push(String.from(")"))
    return concat_all(parts)
}

fun emit_unop(op: UnaryOp, ip: Ptr<Expr>): String {
    val inner = unsafe { *ip }
    val inner_c = inner.emit_expr()
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(unop_to_c(op))
    parts.push(inner_c)
    parts.push(String.from(")"))
    return concat_all(parts)
}

fun unop_to_c(op: UnaryOp): String {
    return when (op) {
        Neg => String.from("-")
        Not => String.from("!")
    }
}

// The monomorphized mangle, or the raw name where Mono set none.
fun pick_callee(raw: String, mangled: String): String {
    val ml = mangled.as_str().byte_len()
    if ml == 0 { return raw.clone() }
    return mangled.clone()
}

fun emit_call(name: String, mangled: String, args: List<Expr>, is_intrinsic: bool): String {
    val nstr = name.as_str()
    // Builtins dispatch on the raw name.
    when nstr {
        "panic" => return emit_runtime_cstr_call(name, args)
        "take" => {
            val arg0 = *args.at(0)
            return arg0.emit_expr()
        }
        "alloc_i32" => return emit_alloc("int32_t", args)
        "free_ptr" => return emit_free(args)
        _ => { }
    }
    // Memory intrinsics carry their type in the callee (`alloc__Expr`).
    // `take__T(x)` is an identity.
    //
    // CONSTRAINT: gated on the parser's flag, not the shape: `<crate>__<fn>`
    // looks the same in a crate named `alloc`.
    if is_intrinsic {
        val mangled_len = mangled.as_str().byte_len()
        if mangled_len > 0 {
            val mstr = mangled.as_str()
            if mstr.starts_with("alloc_array__") { return emit_alloc_array_generic(mstr, args) }
            if mstr.starts_with("realloc_array__") { return emit_realloc_array_generic(mstr, args) }
            if mstr.starts_with("drop_in_place__") { return emit_drop_in_place_generic(mstr, args) }
            if mstr.starts_with("ptr_read__") { return emit_ptr_read(args) }
            if mstr.starts_with("alloc__") { return emit_alloc_generic(mstr) }
            if mstr.starts_with("sizeof__") { return emit_sizeof_generic(mstr) }
            if mstr.starts_with("dealloc__") { return emit_free(args) }
            if mstr.starts_with("take__") {
                val arg0 = *args.at(0)
                return arg0.emit_expr()
            }
        }
        if nstr.starts_with("alloc_array__") { return emit_alloc_array_generic(nstr, args) }
        if nstr.starts_with("realloc_array__") { return emit_realloc_array_generic(nstr, args) }
        if nstr.starts_with("drop_in_place__") { return emit_drop_in_place_generic(nstr, args) }
        if nstr.starts_with("ptr_read__") { return emit_ptr_read(args) }
        if nstr.starts_with("clone_place__") { return emit_clone_place_generic(nstr, args) }
        if nstr.starts_with("alloc__") { return emit_alloc_generic(nstr) }
        if nstr.starts_with("sizeof__") { return emit_sizeof_generic(nstr) }
        if nstr.starts_with("dealloc__") { return emit_free(args) }
        if nstr.starts_with("take__") {
            val arg0 = *args.at(0)
            return arg0.emit_expr()
        }
    }
    val callee = pick_callee(name, mangled)
    var parts = List.new<String>()
    parts.push(callee)
    parts.push(String.from("("))
    while i in 0..args.size() {
        if i > 0 { parts.push(String.from(", ")) }
        val a = *args.at(i)
        parts.push(emit_value_expr(a))
    }
    parts.push(String.from(")"))
    return concat_all(parts)
}

fun emit_runtime_cstr_call(name: String, args: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(name)
    parts.push(String.from("("))
    if args.size() > 0 { parts.push(emit_cstr(args.at(0))) }
    parts.push(String.from(")"))
    return concat_all(parts)
}

// Prelude primitive methods taking self by value; user methods take it by
// pointer.
fun self_is_by_value(callee: str): bool {
    // A trait impl (`<Type>_<method>__<Trait>`) takes self by pointer, even
    // `str_display__Display`.
    if callee_is_trait_impl(callee) { return false }
    // The synthesized clone takes self by pointer for every type.
    if callee.ends_with("_clone") { return false }
    return callee.starts_with("str_")
}

fun callee_is_trait_impl(callee: str): bool {
    val n = callee.byte_len()
    if n < 2 { return false }
    var i: uint64 = 0
    while i + 1 < n {
        if callee.byte_at(i) == 95 {
            if callee.byte_at(i + 1) == 95 { return true }
        }
        i = i + 1
    }
    return false
}

// `callee(marg0, marg1, ...)`, no receiver.
fun build_static_call(callee: String, margs: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(callee)
    parts.push(String.from("("))
    while i in 0..margs.size() {
        if i > 0 { parts.push(String.from(", ")) }
        val arg = *margs.at(i)
        parts.push(emit_value_expr(arg))
    }
    parts.push(String.from(")"))
    return concat_all(parts)
}

// `callee(self_arg, marg0, marg1, ...)`.
fun build_method_call(callee: String, self_arg: String, margs: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(callee)
    parts.push(String.from("("))
    parts.push(self_arg)
    while marg in &margs {
        parts.push(String.from(", "))
        val a = marg
        parts.push(emit_call_arg(a))
    }
    parts.push(String.from(")"))
    return concat_all(parts)
}

// Whether `&` can apply to this expression's C: variables and derefs; a field
// access through a pointer or of an lvalue. Compound literals are treated as
// rvalues, which only costs an extra wrap.
fun Expr.addr_operand_is_lvalue(): bool {
    val k = self.kind
    return when (k) {
        Variable(_) => true
        Deref(_) => true
        // `(*p).f` is an lvalue however `p` was computed.
        FieldAccess(bp, _) => ty_is_pointer(unsafe { bp.ty }) || addr_operand_is_lvalue(unsafe { *bp })
        _ => false
    }
}
