// A binary operator in C, tried in order: C's own primitive operators, the
// `str` comparison, the operator traits, then the rest.

import alloc.list.*

import kf_core.ast.*

import kf_codegen.concat_all

// A primitive operator is the C operator: `a + b` is `a + b`.
//
// CONSTRAINT: only where C and core's `kf_prim_*` agree exactly:
//
//   - Ordered float comparison: core sorts NaN after every number, C makes
//     every comparison with NaN false, so `<`, `<=`, `>`, `>=` on floats go
//     through `Compare`. Equality agrees.
//   - Narrow integers: C promotes int8/int16 to `int`, so the result is cast
//     back to restore wrapping.
fun emit_primitive_binop(l: Expr, op: BinOp, r: Expr): String {
    if !l.ty.is_scalar_primitive() { return "" }
    if !r.ty.is_scalar_primitive() && !r.ty.operand_type_is_unknown() { return "" }
    if op.binop_is_ordered() && l.ty.ty_is_float() { return "" }
    if !op.binop_is_c_exact() { return "" }
    val body = "(${emit_operand_value(l)} ${op.binop_to_c().as_str()} ${emit_operand_value(r)})"
    if op.binop_answers_bool() { return String.from(body.as_str()) }
    return "((${l.ty.c_type_of_type().as_str()})${body.as_str()})"
}

// Only a trait call takes its operand by address; a C comparison takes it by
// value.
fun emit_operand_value(e: Expr): String {
    var value = e
    if value.coerce == coerce_addr_of() { value.coerce = coerce_none() }
    return value.emit_expr()
}

// Typecheck requires both operands to agree, so an unresolved right operand
// is the left one's primitive.
fun Type.operand_type_is_unknown(): bool {
    return when (self.kind) {
        Poison => true
        Generic(_) => true
        Projection(_, _) => true
        _ => false
    }
}

fun Type.is_scalar_primitive(): bool {
    return when (self.kind) {
        Int8 => true
        Int16 => true
        Int32 => true
        Int64 => true
        UInt8 => true
        UInt16 => true
        UInt32 => true
        UInt64 => true
        Float32 => true
        Float64 => true
        Bool => true
        Char => true
        _ => false
    }
}

fun Type.ty_is_float(): bool {
    return when (self.kind) {
        Float32 => true
        Float64 => true
        _ => false
    }
}

fun BinOp.binop_is_ordered(): bool {
    return when (self) {
        Lt => true
        LtEq => true
        Gt => true
        GtEq => true
        _ => false
    }
}

fun BinOp.binop_answers_bool(): bool {
    return when (self) {
        Eq => true
        NotEq => true
        _ => self.binop_is_ordered()
    }
}

// `&&` and `||` short-circuit and are not operator traits.
fun BinOp.binop_is_c_exact(): bool {
    return when (self) {
        AndAnd => false
        OrOr => false
        _ => true
    }
}

fun emit_binop(lp: Ptr<Expr>, op: BinOp, rp: Ptr<Expr>): String {
    val l = unsafe { *lp }
    val r = unsafe { *rp }
    val po = emit_primitive_binop(l, op, r)
    if po.as_str().byte_len() > 0 { return po }
    // Raw pointers and `str` keep their own comparisons below.
    val eo = emit_equal_binop(l, op, r)
    if eo.as_str().byte_len() > 0 { return eo }
    val se = emit_str_equal_binop(l, op, r)
    if se.as_str().byte_len() > 0 { return se }
    // The ordering is compared with zero for the relation asked.
    val co = emit_compare_binop(l, op, r)
    if co.as_str().byte_len() > 0 { return co }
    val ao = emit_arith_binop(l, op, r)
    if ao.as_str().byte_len() > 0 { return ao }
    val bo = emit_bitwise_binop(l, op, r)
    if bo.as_str().byte_len() > 0 { return bo }
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(emit_operand_value(l))
    parts.push(String.from(" "))
    parts.push(op.binop_to_c())
    parts.push(String.from(" "))
    parts.push(emit_operand_value(r))
    parts.push(String.from(")"))
    return concat_all(parts)
}

// `Base_<suffix>(&l, r)`. An rvalue `l` is bound to a temp inside a
// statement-expression that spans the call. "" when there is no base name.
fun emit_operator_trait_call(l: Expr, suffix: str, r: Expr, primitive: bool): String {
    var base = ""
    when (l.ty.kind) {
        Struct(n) => { base = String.from(type_identity_display(n).as_str()) }
        EnumTy(n) => { base = String.from(type_identity_display(n).as_str()) }
        Int8 => { if primitive { base = String.from("int8") } }
        Int16 => { if primitive { base = String.from("int16") } }
        Int32 => { if primitive { base = String.from("int32") } }
        Int64 => { if primitive { base = String.from("int64") } }
        UInt8 => { if primitive { base = String.from("uint8") } }
        UInt16 => { if primitive { base = String.from("uint16") } }
        UInt32 => { if primitive { base = String.from("uint32") } }
        UInt64 => { if primitive { base = String.from("uint64") } }
        Float32 => { if primitive { base = String.from("float32") } }
        Float64 => { if primitive { base = String.from("float64") } }
        Bool => { if primitive { base = String.from("bool") } }
        Char => { if primitive { base = String.from("char") } }
        _ => return ""
    }
    if base.as_str().byte_len() == 0 { return "" }
    val callee = "${base}${suffix}"
    var margs = List.new<Expr>()
    margs.push(r)
    val recv_c = l.emit_expr()
    if l.addr_operand_is_lvalue() {
        return build_method_call(callee, "&(${recv_c})", margs)
    }
    val inner = build_method_call(callee, String.from("&__self_op"), margs)
    return "({ ${l.ty.c_type_of_type()} __self_op = ${recv_c}; ${inner}; })"
}

// `l == r` on a struct calls `Name_equals(&l, r)` (negated for `!=`), with no
// `__Equal` suffix: Mono exempts Clone, Drop and Equal from renaming. "" when
// the left operand is not a struct.
fun emit_equal_binop(l: Expr, op: BinOp, r: Expr): String {
    var negate = false
    when (op) {
        Eq => {}
        NotEq => { negate = true }
        _ => return ""
    }
    val call = emit_operator_trait_call(l, "_equals", r, true)
    if call.as_str().byte_len() == 0 { return "" }
    if !negate { return call }
    var np = List.new<String>()
    np.push(String.from("(!"))
    np.push(call)
    np.push(String.from(")"))
    return concat_all(np)
}

// `str` equality compares content; `String` goes through `Equal` above.
fun emit_str_equal_binop(l: Expr, op: BinOp, r: Expr): String {
    var negate = false
    when (op) {
        Eq => {}
        NotEq => { negate = true }
        _ => return ""
    }
    when (l.ty.kind) {
        StrTy => {}
        _ => return ""
    }
    when (r.ty.kind) {
        StrTy => {}
        _ => return ""
    }
    var parts = List.new<String>()
    if negate { parts.push(String.from("(!str_equals(")) }
    else { parts.push(String.from("str_equals(")) }
    parts.push("${emit_operand_value(l)}, ")
    parts.push(emit_operand_value(r))
    if negate { parts.push(String.from("))")) }
    else { parts.push(String.from(")")) }
    return concat_all(parts)
}

// `Name_add__Add(&l, r)` and friends, returning Self by value. "" when the
// left operand is not a struct.
fun emit_arith_binop(l: Expr, op: BinOp, r: Expr): String {
    var suffix = ""
    when (op) {
        Add => { suffix = String.from("_add__Add") }
        Sub => { suffix = String.from("_sub__Sub") }
        Mul => { suffix = String.from("_mul__Mul") }
        Div => { suffix = String.from("_div__Div") }
        Mod => { suffix = String.from("_mod__Mod") }
        _ => return ""
    }
    return emit_operator_trait_call(l, suffix.as_str(), r, true)
}

fun emit_bitwise_binop(l: Expr, op: BinOp, r: Expr): String {
    var suffix = ""
    when (op) {
        BitAnd => { suffix = String.from("_bit_and__BitAnd") }
        BitOr => { suffix = String.from("_bit_or__BitOr") }
        BitXor => { suffix = String.from("_bit_xor__BitXor") }
        Shl => { suffix = String.from("_shl__Shl") }
        Shr => { suffix = String.from("_shr__Shr") }
        _ => return ""
    }
    return emit_operator_trait_call(l, suffix.as_str(), r, true)
}

fun emit_compare_binop(l: Expr, op: BinOp, r: Expr): String {
    var cop = ""
    when (op) {
        Lt => { cop = String.from("<") }
        LtEq => { cop = String.from("<=") }
        Gt => { cop = String.from(">") }
        GtEq => { cop = String.from(">=") }
        _ => return ""
    }
    val call = emit_operator_trait_call(l, "_compare__Compare", r, true)
    if call.as_str().byte_len() == 0 { return "" }
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(call)
    parts.push(String.from(" "))
    parts.push(cop)
    parts.push(String.from(" 0)"))
    return concat_all(parts)
}
