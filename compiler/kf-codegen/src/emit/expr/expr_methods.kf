import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr

import kf_codegen.concat_all
import kf_codegen.emit.*
import kf_codegen.emit.instances.type_mangle
import kf_codegen.emit.stmt.enum_name_of_type

/// The owner a method is emitted under when Mono left no mangled callee:
/// `type_mangle`'s spelling, so `x.clone()` on an int32 is `int32_clone_user`.
fun receiver_owner_name(t: Type): String {
    val named = struct_ty_name(t)
    if named.as_str() != "" { return named }
    return type_mangle(unwrap_receiver_ty(t))
}

/// A method on `&int32` belongs to `int32`.
fun unwrap_receiver_ty(t: Type): Type {
    return when (t.kind) {
        PtrTo(p) => unwrap_receiver_ty(unsafe { *p })
        BoxOf(p) => unwrap_receiver_ty(unsafe { *p })
        RefTo(_, p) => unwrap_receiver_ty(unsafe { *p })
        _ => t
    }
}

/// An expression where a value is required. A `void` call still emits as a C
/// `void` call, so it is evaluated and the unit yielded:
///
///     val b: Holder<void> = Holder.Full<void>(bump(&var c))
///
/// Only calls need it; wrapping a unit value would turn a place into a
/// non-place.
pub fun emit_value_expr(e: Expr): String {
    if !e.ty.type_is_unit_valued() { return e.emit_expr() }
    if !expr_is_call_shaped(e) { return e.emit_expr() }
    var parts = List.new<String>()
    parts.push(String.from("({ "))
    parts.push(e.emit_expr())
    parts.push(String.from("; "))
    parts.push(kf_unit_literal())
    parts.push(String.from("; })"))
    return concat_all(parts)
}

fun expr_is_call_shaped(e: Expr): bool {
    return when (e.kind) {
        Call(_n, _a) => true
        Intrinsic(_i, _a) => true
        MethodCall(_r, _m, _a) => true
        CallValue(_c, _a) => true
        _ => false
    }
}

fun emit_call_arg(a: Expr): String {
    val c = emit_value_expr(a)
    if !a.derefs_at_call { return c }
    var parts = List.new<String>()
    parts.push(String.from("(*("))
    parts.push(c)
    parts.push(String.from("))"))
    return concat_all(parts)
}

fun emit_method_call(recv_p: Ptr<Expr>, mname: String, mangled: String, margs: List<Expr>): String {
    val recv = unsafe { *recv_p }
    val recv_c = recv.emit_expr()
    // Mono's mangled callee, with the raw name as a fallback.
    var callee = pick_callee(mname.clone(), mangled)
    if callee.as_str() == mname.as_str() {
        val owner = receiver_owner_name(recv.ty)
        if owner.as_str() != "" {
            var fallback = owner
            fallback.append("_")
            fallback.append(mname.as_str())
            callee = String.from(fallback.as_str())
        }
    }
    // These take self by value, so a pointer receiver is dereferenced.
    if self_is_by_value(callee.as_str()) {
        if ty_is_pointer(recv.ty) {
            var dp = List.new<String>()
            dp.push(String.from("(*"))
            dp.push(recv_c)
            dp.push(String.from(")"))
            return build_method_call(callee, concat_all(dp), margs)
        }
        return build_method_call(callee, recv_c, margs)
    }
    // `<T>_clone` is already the by-pointer entry.
    val ecallee = callee
    // A receiver already a pointer in C is passed as self directly; `&(recv)`
    // would be a `T**`. Field access uses the same predicate.
    if ty_is_pointer(recv.ty) {
        return build_method_call(ecallee, recv_c, margs)
    }
    // An lvalue receiver takes `&(recv)`.
    if recv.addr_operand_is_lvalue() {
        var addr = List.new<String>()
        addr.push(String.from("&("))
        addr.push(recv_c)
        addr.push(String.from(")"))
        return build_method_call(ecallee, concat_all(addr), margs)
    }
    // An rvalue receiver lives in a compound literal, which lasts to the end
    // of the enclosing block: a borrow or view the method returns stays valid
    // for the whole statement. Mutating methods only take lvalues, so it is
    // read-only.
    val receiver = "((${recv.ty.c_type_of_type()}[1]){ ${recv_c} })"
    return build_method_call(ecallee, receiver, margs)
}

// `kf__retain__T` returns the independent copy; a no-op for a value type.
fun emit_retain_expr(inner_p: Ptr<Expr>): String {
    val inner = unsafe { *inner_p }
    val ct = inner.ty.c_type_of_type()
    val inner_c = inner.emit_expr()
    val rel = release_fn_for_ctype(ct.as_str())
    val rl = rel.as_str().byte_len()
    if rl == 0 {
        return inner_c
    }
    return type_retain_fn(ct.as_str()) + String.from("(") + inner_c + String.from(")")
}

// `Enum.Variant` parses as a FieldAccess and `Enum.Variant(args)` as a
// MethodCall on the bare enum name; both emit a tagged compound literal. The
// enum name, or "".
fun Expr.enum_ctor_name(recv_p: Ptr<Expr>): String {
    val ename = enum_name_of_type(self.ty)
    val n = ename.as_str().byte_len()
    if n == 0 { return "" }
    val recv = unsafe { *recv_p }
    when (recv.kind) {
        Variable(vn) => {
            if vn.as_str() == ename.as_str() { return String.from(ename.as_str()) }
            if enum_ctor_receiver_matches(ename.as_str(), vn.as_str()) { return String.from(ename.as_str()) }
            return ""
        }
        _ => return ""
    }
}

// `Option<int32>.Some` against the concrete `Option__int32`: compared up to
// the first `__`.
fun enum_ctor_receiver_matches(concrete: str, receiver: str): bool {
    val n = concrete.byte_len()
    var i = 0
    while i < n {
        val c = concrete.byte_at(i)
        if c == 95 {
            if i + 1 < n {
                val next = concrete.byte_at(i + 1)
                if next == 95 {
                    val base = concrete.substring(0, i)
                    return base.as_str().equals(receiver)
                }
            }
        }
        i = i + 1
    }
    return false
}

fun is_box_new(recv_p: Ptr<Expr>, mname: String): bool {
    val is_new = mname.as_str().equals("new")
    if !is_new { return false }
    val recv = unsafe { *recv_p }
    return when (recv.kind) {
        Variable(vn) => vn.as_str().equals("Box")
        _ => false
    }
}

fun box_inner_cg(t: Type): Type {
    return when (t.kind) {
        BoxOf(p) => unsafe { *p }
        _ => t
    }
}

// `Box.new(e)` -> ({ <Tc>* __bx = (<Tc>*)kf_alloc(sizeof(<Tc>)); *__bx = <e>; __bx; })
fun Expr.emit_box_new(margs: List<Expr>): String {
    val inner_ty = box_inner_cg(self.ty)
    val inner_c = inner_ty.c_type_of_type()
    val first_arg = *margs.at(0)
    return "({ ${inner_c}* __bx = (${inner_c}*)kf_alloc(sizeof(${inner_c})); *__bx = ${first_arg.emit_expr()}; __bx; })"
}

fun Expr.emit_field_or_enum_ctor(recv_p: Ptr<Expr>, fname: String): String {
    val ename = self.enum_ctor_name(recv_p)
    val n = ename.as_str().byte_len()
    if n > 0 {
        // (Enum){ .tag = kf__tag__Enum__Variant }
        var parts = List.new<String>()
        parts.push(String.from("("))
        parts.push(ename.clone())
        parts.push(String.from("){ .tag = "))
        parts.push(enum_tag_const(ename.as_str(), fname.as_str()))
        parts.push(String.from(" }"))
        return concat_all(parts)
    }
    return emit_field_access(recv_p, fname)
}

fun Expr.emit_method_or_enum_ctor(recv_p: Ptr<Expr>, mname: String, margs: List<Expr>): String {
    // `Type.method(args)`: no receiver argument.
    if self.is_static_call {
        return build_static_call(self.mangled_callee.as_string(), margs)
    }
    if is_box_new(recv_p, mname) {
        return self.emit_box_new(margs)
    }
    val ename = self.enum_ctor_name(recv_p)
    val n = ename.as_str().byte_len()
    if n > 0 {
        // (Enum){ .tag = kf__tag__E__V, .u.V_V._0 = a0, .u.V_V._1 = a1, ... }
        var parts = List.new<String>()
        parts.push(String.from("("))
        parts.push(ename.clone())
        parts.push(String.from("){ .tag = "))
        parts.push(enum_tag_const(ename.as_str(), mname.as_str()))
        while i in 0..margs.size() {
            parts.push(String.from(", .u.V_"))
            parts.push(mname.clone())
            parts.push(String.from("._"))
            parts.push("${i}")
            parts.push(String.from(" = "))
            val arg = *margs.at(i)
            parts.push(emit_value_expr(arg))
        }
        parts.push(String.from(" }"))
        return concat_all(parts)
    }
    return emit_method_call(recv_p, mname, self.mangled_callee.as_string(), margs)
}

// `(recv).field` for a value, `recv.field` for a pointer or reference
// receiver, so C sees the struct.
fun emit_field_access(recv_p: Ptr<Expr>, fname: String): String {
    val recv = unsafe { *recv_p }
    val recv_c = recv.emit_expr()
    val deref = ty_is_pointer(recv.ty)
    var parts = List.new<String>()
    if deref { parts.push(String.from("(*")) }
    else { parts.push(String.from("(")) }
    parts.push(recv_c)
    parts.push(String.from(")."))
    // A C keyword is escaped; see c_field_name.
    parts.push(c_field_name(fname.as_str()))
    return concat_all(parts)
}

fun ty_is_pointer(t: Type): bool {
    return when (t.kind) {
        PtrTo(_) => true
        BoxOf(_) => true
        RefTo(_, _) => true
        _ => false
    }
}
