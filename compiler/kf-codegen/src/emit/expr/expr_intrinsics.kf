import alloc.list.*

import kf_core.ast.Intrinsic
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.FieldInit

import kf_codegen.concat_all
import kf_codegen.emit.clone_fn_for_ctype
import kf_codegen.emit.release_fn_for_ctype
import kf_codegen.emit.c_type
import kf_codegen.emit.c_type_of_type

fun Expr.struct_lit_name(sname: String): String {
    if self.mangled_callee.as_str().equals("") {
        return sname
    }
    return self.mangled_callee.as_string()
}

fun emit_struct_lit(sname: String, finits: List<FieldInit>): String {
    var parts = List.new<String>()
    parts.push(String.from("__"))
    parts.push(sname.clone())
    parts.push(String.from("_new("))
    while i in 0..finits.size() {
        if i > 0 { parts.push(String.from(", ")) }
        val fi = *finits.at(i)
        val vp = fi.value
        val v = unsafe { *vp }
        parts.push(v.emit_expr())
    }
    parts.push(String.from(")"))
    return concat_all(parts)
}

/// A memory intrinsic's C. Its type argument is rendered as C, as any type
/// is: `int32` as `int32_t`. `annotated` was expanded by the checker.
fun Intrinsic.emit_intrinsic(type_args: &List<TypeRef>, args: List<Expr>): String {
    val cty = if type_args.size() == 1 {
        type_args.at(0).c_type()
    } else {
        String.from("/* poison */ void")
    }
    return when (self) {
        Alloc => emit_alloc(cty.as_str(), args)
        AllocArray => emit_alloc_array(cty.as_str(), args)
        ReallocArray => emit_realloc_array(cty.as_str(), args)
        Dealloc => emit_free(args)
        Sizeof => "sizeof(${cty})"
        // An identity.
        Take => args.at(0).emit_expr()
        DropInPlace => emit_drop_in_place(cty.as_str(), args)
        ClonePlace => emit_clone_place(cty.as_str(), args)
        PtrRead => emit_ptr_read(args)
        Annotated => String.from("/* poison */ 0")
    }
}

// `drop_in_place<T>(p)` runs T's destructor in place; a no-op for a
// primitive.
fun emit_drop_in_place(cty: str, args: List<Expr>): String {
    val rel = release_fn_for_ctype(cty)
    if rel.as_str().byte_len() == 0 {
        return String.from("((void)0)")
    }
    var parts = List.new<String>()
    parts.push(rel.clone())
    parts.push(String.from("(*"))
    val arg0 = *args.at(0)
    parts.push(arg0.emit_expr())
    parts.push(String.from(")"))
    return concat_all(parts)
}

// `ptr_read<T>(p)` is `(*(p))`: the bits move, and nothing is dropped.
fun emit_ptr_read(args: List<Expr>): String {
    val arg0 = *args.at(0)
    return "(*(${emit_expr(arg0).as_str()}))"
}

// `clone_place<T>(p)`: a deep copy of the pointee, or a plain copy for a
// primitive or pointer.
fun emit_clone_place(cty: str, args: List<Expr>): String {
    val cfn = clone_fn_for_ctype(cty)
    var parts = List.new<String>()
    val has_clone = cfn.as_str().byte_len() > 0
    if has_clone {
        parts.push(cfn.clone())
        parts.push(String.from("((*"))
        val arg0 = *args.at(0)
        parts.push(arg0.emit_expr())
        parts.push(String.from("))"))
        return concat_all(parts)
    }
    parts.push(String.from("(*"))
    val arg0b = *args.at(0)
    parts.push(arg0b.emit_expr())
    parts.push(String.from(")"))
    return concat_all(parts)
}

// `alloc_array<T>(n)` is `((<Tc>*)kf_alloc(sizeof(<Tc>) * (n)))`.
fun emit_alloc_array(cty: str, args: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(String.from("(("))
    parts.push(String.from(cty))
    parts.push(String.from("*)kf_alloc(sizeof("))
    parts.push(String.from(cty))
    parts.push(String.from(") * ("))
    val arg0 = *args.at(0)
    parts.push(arg0.emit_expr())
    parts.push(String.from(")))"))
    return concat_all(parts)
}

// `realloc_array<T>(ptr, n)` is
// `((<Tc>*)kf_realloc((ptr), sizeof(<Tc>) * (n)))`.
fun emit_realloc_array(cty: str, args: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(String.from("(("))
    parts.push(String.from(cty))
    parts.push(String.from("*)kf_realloc("))
    val arg0 = *args.at(0)
    parts.push(arg0.emit_expr())
    parts.push(String.from(", sizeof("))
    parts.push(String.from(cty))
    parts.push(String.from(") * ("))
    val arg1 = *args.at(1)
    parts.push(arg1.emit_expr())
    parts.push(String.from(")))"))
    return concat_all(parts)
}

fun emit_alloc(c_ty: str, args: List<Expr>): String {
    var parts = List.new<String>()
    parts.push(String.from("("))
    parts.push(String.from(c_ty))
    parts.push(String.from("*)kf_alloc(sizeof("))
    parts.push(String.from(c_ty))
    parts.push(String.from("))"))
    return concat_all(parts)
}

fun emit_free(args: List<Expr>): String {
    val a = *args.at(0)
    var parts = List.new<String>()
    parts.push(String.from("kf_free("))
    parts.push(a.emit_expr())
    parts.push(String.from(")"))
    return concat_all(parts)
}

/// `((W){ { a, b, c } })`: a compound literal of the array's C struct, whose
/// one member is the elements.
fun Expr.emit_array_literal(elements: &List<Expr>): String {
    var parts = List.new<String>()
    parts.push("((${self.ty.c_type_of_type()}){ { ")
    while i in 0..elements.size() {
        if i > 0 { parts.push(String.from(", ")) }
        parts.push(elements.at(i).emit_expr())
    }
    parts.push(String.from(" } })"))
    return concat_all(parts)
}
