import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

import kf_codegen.emit.*
import kf_codegen.emit.glue.deep_clone_top_decl

fun named(s: str): TypeRef {
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(s), List.new<TypeRef>()))
}

fun generic1(name: str, arg: TypeRef): TypeRef {
    var args = List.new<TypeRef>()
    args.push(arg)
    return TypeRef.new(no_span(), TypeRefKind.Named(intern(name), args))
}

fun empty_module(): Module {
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
}

@test fun c_type_void(): void {
    val t = named("void")
    val c = t.c_type()
    assert_eq(c.as_str(), "void", "void → void")
}

@test fun c_type_int32(): void {
    val t = named("int32")
    val c = t.c_type()
    assert_eq(c.as_str(), "int32_t", "int32 → int32_t")
}

@test fun c_type_bool(): void {
    val t = named("bool")
    val c = t.c_type()
    assert_eq(c.as_str(), "bool", "bool → bool")
}

@test fun c_type_str(): void {
    val t = named("str")
    val c = t.c_type()
    assert_eq(c.as_str(), "const char*", "str → const char*")
}

@test fun c_type_string(): void {
    val t = named("String")
    val c = t.c_type()
    assert_eq(c.as_str(), "String", "String source spelling uses its struct C type")
}

@test fun c_type_user_struct_name(): void {
    val t = named("Foo")
    val c = t.c_type()
    assert_eq(c.as_str(), "Foo", "user struct passes through")
}

@test fun c_type_ptr_int32(): void {
    var args = List.new<TypeRef>()
    args.push(named("int32"))
    val t = TypeRef.new(no_span(), TypeRefKind.Named(intern("Ptr"), args))
    val c = t.c_type()
    assert_eq(c.as_str(), "int32_t*", "Ptr<int32> → int32_t*")
}

@test fun c_type_reference(): void {
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = named("int32") }
    val t = TypeRef.new(no_span(), TypeRefKind.Reference(false, inner))
    val c = t.c_type()
    assert_eq(c.as_str(), "int32_t*", "&int32 → int32_t*")
}

@test fun c_type_list_string_mangles(): void {
    val t = generic1("List", named("String"))
    val c = t.c_type()
    assert_eq(c.as_str(), "List__String", "List<String> uses the owning element type")
}

@test fun c_type_list_int32_mangles(): void {
    val t = generic1("List", named("int32"))
    val c = t.c_type()
    assert_eq(c.as_str(), "List__int32", "List<int32> → List__int32")
}

@test fun c_type_option_user_struct_mangles(): void {
    val t = generic1("Option", named("DeclId"))
    val c = t.c_type()
    assert_eq(c.as_str(), "Option__DeclId", "Option<DeclId> → Option__DeclId")
}

@test fun c_type_nested_list_mangles(): void {
    val inner = generic1("List", named("int32"))
    val t = generic1("List", inner)
    val c = t.c_type()
    assert_eq(c.as_str(), "List__List__int32", "List<List<int32>> → List__List__int32")
}

@test fun c_type_ptr_still_pointer_not_mangled(): void {
    var args = List.new<TypeRef>()
    args.push(named("Expr"))
    val t = TypeRef.new(no_span(), TypeRefKind.Named(intern("Ptr"), args))
    assert_eq(t.c_type().as_str(), "Expr*", "Ptr<Expr> → Expr*")
}

@test fun c_type_option_dynamic_borrow_uses_fat_value_identity(): void {
    val dynamic = TypeRef.new(no_span(), TypeRefKind.DynTrait(intern("Score"), List.new<TypeRef>()))
    val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner = dynamic }
    val borrowed = TypeRef.new(no_span(), TypeRefKind.Reference(false, inner))
    val optional = generic1("Option", borrowed)
    assert_eq(optional.c_type().as_str(), "Option__Dyn__Score", "Option<&dyn Score> uses the fat wrapper instance")
}

@test fun needs_drop_string_true(): void {
    var decls = List.new<TopDecl>()
    decls.push(string_drop_impl())
    val imports = List.new<Import>()
    val m = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: imports }
    assert_eq(ty_needs_drop(named("String"), &m), true, "String needs drop because it declares one")
}

@test fun needs_drop_string_without_a_drop_impl_false(): void {
    val m = empty_module()
    assert_eq(ty_needs_drop(named("String"), &m), false, "the spelling String alone owns nothing")
}

@test fun needs_drop_int32_false(): void {
    val m = empty_module()
    assert_eq(ty_needs_drop(named("int32"), &m), false, "int32 value type")
}

@test fun needs_drop_list_int32_true(): void {
    val m = empty_module()
    assert_eq(ty_needs_drop(named("List_int32"), &m), true, "mangled List<T> needs drop")
}

@test fun needs_drop_unknown_user_type_false(): void {
    val m = empty_module()
    assert_eq(ty_needs_drop(named("Foo"), &m), false, "unknown user type has no available glue")
}

@test fun needs_drop_deep_empty_user_struct_false(): void {
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Foo"), TopDeclKind.Struct(List.new<Field>(), true)))
    val m = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    assert_eq(ty_needs_drop_deep(named("Foo"), &m), false, "empty user struct owns no nested value")
}

@test fun needs_drop_deep_owned_user_struct_true(): void {
    val m = string_field_struct_module()
    assert_eq(ty_needs_drop_deep(named("Foo"), &m), true, "user struct with an owned field needs its glue called")
}

@test fun needs_drop_deep_looks_past_an_impl_named_like_the_struct(): void {
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Foo"), TopDeclKind.ImplBlock(List.new<TopDecl>())))
    val owning = string_field_struct_module()
    while td in &owning.decls {
        decls.push(td.deep_clone_top_decl())
    }
    val m = Module {
        crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>()
    }
    assert_eq(ty_needs_drop_deep(named("Foo"), &m), true, "the struct's own fields decide, not its impl block")
}

@test fun needs_drop_owned_user_struct_stays_shallow_false(): void {
    // Unity emission keeps the shallow classification.
    val m = string_field_struct_module()
    assert_eq(ty_needs_drop(named("Foo"), &m), false, "shallow classification ignores nested ownership")
}

@test fun needs_drop_deep_boxed_field_struct_true(): void {
    var box_args = List.new<TypeRef>()
    box_args.push(named("int32"))
    var fields = List.new<Field>()
    val box_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *box_type = TypeRef.new(no_span(), TypeRefKind.Named(intern("Box"), box_args)) }
    fields.push(new_field(no_span(), String.from("value"), box_type, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Foo"), TopDeclKind.Struct(fields, true)))
    val m = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    assert_eq(ty_needs_drop_deep(named("Foo"), &m), true, "Box field owns its allocation")
}

@test fun needs_drop_deep_nested_owner_struct_true(): void {
    var inner_fields = List.new<Field>()
    val string_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *string_type = named("String") }
    inner_fields.push(new_field(no_span(), String.from("value"), string_type, false, true))
    var outer_fields = List.new<Field>()
    val inner_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *inner_type = named("Inner") }
    outer_fields.push(new_field(no_span(), String.from("inner"), inner_type, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Inner"), TopDeclKind.Struct(inner_fields, true)))
    decls.push(new_top_decl(no_span(), String.from("Outer"), TopDeclKind.Struct(outer_fields, true)))
    decls.push(string_drop_impl())
    val m = Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    assert_eq(ty_needs_drop_deep(named("Outer"), &m), true, "ownership classification follows by-value embedding")
}

fun string_field_struct_module(): Module {
    var fields = List.new<Field>()
    val string_type: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *string_type = named("String") }
    fields.push(new_field(no_span(), String.from("value"), string_type, false, true))
    var decls = List.new<TopDecl>()
    decls.push(new_top_decl(no_span(), String.from("Foo"), TopDeclKind.Struct(fields, true)))
    decls.push(string_drop_impl())
    return Module { crate: new_crate_id("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

// A canonical identity `crate::module::Name` must not reach C: a `when` value
// over a dependency's type once declared `dep::dep::DeclId ____when0`.
@test fun c_type_name_strips_a_canonical_identity(): void {
    val c = c_type_name(String.from("dep::dep::DeclId"))
    assert_eq(c.as_str(), "DeclId", "a canonical identity renders as its last segment")
}

// A qualified name has no `::` and is untouched.
@test fun c_type_name_leaves_a_qualified_name_alone(): void {
    val c = c_type_name(String.from("dep__DeclId"))
    assert_eq(c.as_str(), "dep__DeclId", "an already-qualified name is unchanged")
}

@test fun c_type_name_leaves_a_mono_instance_alone(): void {
    val c = c_type_name(String.from("List__int32"))
    assert_eq(c.as_str(), "List__int32", "a mono-suffixed instance is unchanged")
}

/// alloc's `impl Drop for String` after mono folds it into an impl block.
fun string_drop_impl(): TopDecl {
    val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ret = named("void") }
    var methods = List.new<TopDecl>()
    val drop_kind = TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false)
    methods.push(new_top_decl(no_span(), String.from("drop"), drop_kind))
    return new_top_decl(no_span(), String.from("String"), TopDeclKind.ImplBlock(methods))
}

@test fun a_function_type_is_one_c_type_specifier(): void {
    var params = List.new<Type>()
    params.push(Type.new_int32(no_span()))
    val function = Type.new_fn(params, Type.new_bool(no_span()), Provenance.Inferred(no_span()))
    assert_eq(function.c_type_of_type().as_str(), "__typeof__(bool (*)(int32_t))", "a pointer to the function")
}

@test fun a_function_of_nothing_takes_void_in_c(): void {
    val function = Type.new_fn(List.new<Type>(), Type.new_bool(no_span()), Provenance.Inferred(no_span()))
    val expected = "__typeof__(bool (*)(void))"
    assert_eq(function.c_type_of_type().as_str(), expected, "an empty C list would mean any arguments")
}
