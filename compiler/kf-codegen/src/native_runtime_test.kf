import core.assert.assert_eq

@test
fun checked_in_native_sources_own_runtime_symbols(): void {
    val core = read_file("libs/core/native/core.c")
    val core_hosted = read_file("libs/core/native/core_hosted.c")
    val std_process = read_file("libs/std/native/process.c")
    val compiler = read_file("compiler/kf-core/native/compiler.c")
    val has_core = core_hosted.as_str().contains("void runtime_println(")
    val has_alloc = core.as_str().contains("void* kf_alloc(")
    val has_std = std_process.as_str().contains("int32_t kf_process_status(")
    val has_compiler = compiler.as_str().contains("uint32_t kf_sym_intern(")
    val ok = has_core && has_alloc && has_std && has_compiler
    assert_eq(ok, true, "native functions live with their owning crates")
}

fun occurrences(hay: str, needle: str): uint64 {
    val n = hay.byte_len()
    val m = needle.byte_len()
    if m == 0 || m > n { return 0 }
    var found: uint64 = 0
    var i: uint64 = 0
    while i + m <= n {
        var j: uint64 = 0
        var same = true
        while j < m {
            if hay.byte_at(i + j) != needle.byte_at(j) {
                same = false
            }
            j = j + 1
        }
        if same { found = found + 1 }
        i = i + 1
    }
    return found
}

/// Every allocation entry point is weak, so a program can replace it. A strong
/// definition in `libcore.a`, which every program links, would collide.
@test
fun the_allocation_abi_is_replaceable(): void {
    val core = read_file("libs/core/native/core.c")
    val hosted = read_file("libs/core/native/core_hosted.c")
    // Freestanding half: kf_alloc_failed, kf_alloc, kf_realloc.
    assert_eq(occurrences(core.as_str(), "__attribute__((weak))"), 3,
        "the derived pair and the failure policy are overridable")
    // Hosted half: kf_try_alloc, kf_try_realloc, kf_free, which name libc.
    assert_eq(occurrences(hosted.as_str(), "__attribute__((weak))"), 3,
        "so is each primitive that reaches the C library")
}

/// The infallible pair is derived from the fallible pair, so replacing only
/// `kf_try_alloc` inherits the failure policy.
@test
fun the_infallible_allocators_are_wrappers_over_the_fallible_ones(): void {
    val text = read_file("libs/core/native/core.c")
    val core = text.as_str()
    assert_eq(core.contains("void* memory = kf_try_alloc(size);"), true,
        "kf_alloc goes through kf_try_alloc")
    assert_eq(core.contains("void* memory = kf_try_realloc(ptr, size);"), true,
        "kf_realloc goes through kf_try_realloc")
    assert_eq(occurrences(core, "kf_alloc_failed(size);"), 2,
        "and both route failure through the one replaceable handler")
}

/// `kf_alloc` never returns NULL, so `kf_alloc_failed` must never return.
@test
fun the_failure_handler_does_not_return(): void {
    val text = read_file("libs/core/native/core.c")
    val core = text.as_str()
    assert_eq(core.contains("panic(\"out of memory\");"), true, "it reports")
    // Not `abort`: that is libc's.
    assert_eq(core.contains("    __builtin_trap();"), true, "and it does not come back")
}

/// core allocates through the ABI it publishes, so a replaced allocator sees
/// every allocation. The only bare libc calls are inside the fallible
/// primitives.
@test
fun core_does_not_allocate_around_its_own_abi(): void {
    val text = read_file("libs/core/native/core_hosted.c")
    val hosted = text.as_str()
    // Names containing the libc name are subtracted.
    val bare_realloc = occurrences(hosted, "realloc(") - occurrences(hosted, "kf_realloc(") - occurrences(hosted, "kf_try_realloc(")
    val bare_free = occurrences(hosted, "free(") - occurrences(hosted, "kf_free(")
    assert_eq(occurrences(hosted, "malloc("), 1, "one bare malloc, inside kf_try_alloc")
    assert_eq(bare_realloc, 1, "one bare realloc, inside kf_try_realloc")
    assert_eq(bare_free, 1, "one bare free, inside kf_free")
}

/// The freestanding half includes only headers C guarantees a freestanding
/// implementation provides. Checked textually; the compile-time proof is
/// check.sh's `-ffreestanding -nostdinc` gate.
@test
fun the_freestanding_half_includes_no_hosted_header(): void {
    val text = read_file("libs/core/native/core.c")
    val core = text.as_str()
    val includes = occurrences(core, "#include <")
    val freestanding_includes = occurrences(core, "#include <stdbool.h>") + occurrences(core, "#include <stddef.h>") + occurrences(core, "#include <stdint.h>")
    assert_eq(includes, 3, "three includes")
    assert_eq(freestanding_includes, 3, "and all three are freestanding-guaranteed")
}

/// Libc names the freestanding half must never call. `memcpy` and `memmove`
/// go through `__builtin_`.
@test
fun the_freestanding_half_calls_no_c_library_function(): void {
    val text = read_file("libs/core/native/core.c")
    val core = text.as_str()
    val bare_free = occurrences(core, "free(") - occurrences(core, "kf_free(")
    assert_eq(occurrences(core, "malloc("), 0, "no malloc")
    assert_eq(bare_free, 0, "no free")
    assert_eq(occurrences(core, "abort("), 0, "no abort")
    assert_eq(occurrences(core, "printf("), 0, "no printf family")
    assert_eq(occurrences(core, "strlen("), 0, "no strlen")
    assert_eq(occurrences(core, "strcmp("), 0, "no strcmp")
}
