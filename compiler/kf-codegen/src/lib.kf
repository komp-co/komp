// Emits C from the lowered module. Output is built as a list of fragments
// joined by concat_all.

import alloc.list.*

import kf_core.ast.*
import kf_codegen.emit.*
import kf_codegen.runtime.emit_runtime_header
import kf_codegen.runtime.runtime_header_declares
import kf_codegen.emit.stmt.*
import kf_codegen.emit.glue.*
import kf_codegen.emit.dyn_traits.*

/// A binary TU: `m.emit_module_kind(true)`.
pub fun Module.emit_module(): String {
    return self.emit_module_kind(true)
}

/// A binary gets a C `main` (the user's, or an empty stub); a library gets
/// none.
pub fun Module.emit_module_kind(is_bin: bool): String {
    var parts = List.new<String>()
    parts.push(emit_runtime_header())
    parts.push(self.emit_module_body(is_bin))
    return concat_all(parts)
}

/// A TU whose runtime declarations come from the shared ABI header.
pub fun Module.emit_module_unit(is_bin: bool): String {
    var parts = List.new<String>()
    parts.push(String.from("// generated by komp\n#include \"kf_runtime.h\"\n\n"))
    parts.push(self.emit_module_body(is_bin))
    return concat_all(parts)
}

pub fun Module.emit_module_body(is_bin: bool): String {
    var parts = List.new<String>()
    parts.push(self.emit_dyn_forward_decls())
    parts.push(self.emit_type_forward_decls())
    parts.push(self.emit_enum_tags())
    // Before user types, so structs may hold `&dyn Trait` fields.
    parts.push(self.emit_dyn_layouts())
    // Dependency-ordered, so a by-value embed follows the type it contains.
    parts.push(self.emit_type_bodies_ordered())
    // Prototypes, so the glue definitions below can reference each other in
    // any order.
    parts.push(self.emit_type_op_protos())
    // Function and extern prototypes too: the glue calls String entry points
    // core declares.
    parts.push(self.emit_fn_forwards())
    parts.push(self.emit_struct_news())
    parts.push(self.emit_struct_retains(self))
    parts.push(self.emit_enum_retains(self))
    parts.push(self.emit_struct_drops(self))
    parts.push(self.emit_enum_drops(self))
    parts.push(self.emit_struct_clones())
    parts.push(self.emit_enum_clones())
    parts.push(self.emit_dyn_adapters())
    parts.push(self.emit_dyn_vtables())
    parts.push(emit_dyn_dispatch_helpers(self))
    val payloads = self.build_arm_payloads()
    parts.push(self.emit_fn_bodies(&payloads))
    if is_bin {
        val has_user_main = self.has_main()
        if !has_user_main {
            parts.push(empty_main())
        }
    }
    return concat_all(parts)
}

pub fun Module.emit_fn_forwards(): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        // An imported declaration's prototype comes from its header and its
        // body from the archive.
        if !td.linkage.is_imported() {
            val k = td.kind
            when (k) {
                Function(_, _, _, _, _, _, _) => {
                    if td.name.as_str() != "main" {
                        parts.push(emit_fn_forward(td))
                    }
                }
                // A source-local extern still needs its prototype here.
                Extern(_, _, _, _) => {
                    // Unless kf_runtime.h declares it: a second prototype may
                    // conflict with the header's C type.
                    if !runtime_header_declares(td.name.as_str()) {
                        parts.push(emit_fn_forward(td))
                    }
                }
                ImplBlock(methods) => {
                    while method in &methods {
                        if method.method_emits_code() {
                            parts.push(emit_method_forward(td.name.as_string(), method))
                        }
                    }
                }
                _ => { }
            }
        }
    }
    if decls.size() > 0 { parts.push(String.from("\n")) }
    return concat_all(parts)
}

pub fun Module.emit_fn_bodies(payloads: &ArmPayloads): String {
    var parts = List.new<String>()
    val decls = self.decls
    while td in &decls {
        if !td.linkage.is_imported() {
            val k = td.kind
            when (k) {
                Function(_, _, _, _, _, _, _) => parts.push(emit_fn(td, &payloads))
                ImplBlock(methods) => {
                    while method in &methods {
                        if method.method_emits_code() {
                            parts.push(emit_method(td.name.as_string(), method, &payloads))
                        }
                    }
                }
                _ => { }
            }
        }
    }
    return concat_all(parts)
}

pub fun empty_main(): String {
    return String.from("int main(int argc, char** argv) {\n    (void)argc; (void)argv;\n    return 0;\n}\n")
}

pub fun Module.has_main(): bool {
    val decls = self.decls
    while td in &decls {
        if td.name.as_str() == "main" { return true }
    }
    return false
}
