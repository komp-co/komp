import alloc.list.*
import core.assert.*
import kf_core.span.no_span
import kf_core.ast.*
import kf_codegen.*
import kf_codegen.emit.stmt.emit_stmt
import kf_codegen.emit.expr.emit_expr

// Emitted text only; linking and running C lives in kf-driver's
// `codegen_link_test`, which has a frontend.

fun ty_ptr(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    val tr = new_type_ref(no_span(), TypeRefKind.Named(intern(s), List.new<TypeRef>()))
    unsafe { *rp = tr }
    return rp
}

fun expr_ptr(e: Expr): Ptr<Expr> {
    val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ep = e }
    return ep
}

// `outer<inner>` as a Ptr<TypeRef>: ("Ptr","Expr") is Ptr<Expr>.
fun ty_ptr_generic(outer: str, inner: str): Ptr<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(new_type_ref(no_span(), TypeRefKind.Named(intern(inner), List.new<TypeRef>())))
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = new_type_ref(no_span(), TypeRefKind.Named(intern(outer), args)) }
    return rp
}

@test fun emit_deref_wraps_operand(): void {
    val p = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("p"))))
    val d = new_expr(no_span(), ExprKind.Deref(p))
    val c = d.emit_expr()
    assert_eq(c.as_str(), "(*__p)", "deref emits (*operand)")
}

@test fun emit_if_expr_is_ternary(): void {
    val c = expr_ptr(new_expr(no_span(), ExprKind.LitBool(true)))
    val t = expr_ptr(new_expr(no_span(), ExprKind.LitInt(1)))
    val el = expr_ptr(new_expr(no_span(), ExprKind.LitInt(2)))
    val ife = new_expr(no_span(), ExprKind.IfExpr(c, t, el))
    val out = ife.emit_expr()
    assert_eq(out.as_str(), "(true ? 1 : 2)", "if-expr → ternary")
}

// `*p = x` emits `(*__p) = __x;`.
@test fun emit_assign_to_deref_store(): void {
    val pvar = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("p"))))
    val place = expr_ptr(new_expr(no_span(), ExprKind.Deref(pvar)))
    val rhs = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("x"))))
    val s = new_stmt(no_span(), StmtKind.AssignTo(place, rhs))
    var env = new_local_env()
    val c = emit_stmt(s, 0, &var env)
    assert_eq(c.as_str(), "(*__p) = __x;\n", "deref store emits place = rhs")
}

fun int_has_sub(s: str, needle: str): bool {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return true }
    if sl < nl { return false }
    var i: uint64 = 0
    while i + nl <= sl {
        var j: uint64 = 0
        var ok: bool = true
        while j < nl {
            val sb = s.byte_at(i + j)
            val nb = needle.byte_at(j)
            if sb != nb { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// A `_` payload binder emits no binding.
@test fun emit_enum_arm_skips_wildcard_binder(): void {
    var subj = new_expr(no_span(), ExprKind.Variable(intern("v")))
    subj.ty = Type { kind: TypeKind.Struct(intern("MyEnum")), provenance: Provenance.Inferred(no_span()) }
    var binders = List.new<Sym>()
    binders.push(intern("a"))
    binders.push(intern("_"))
    var arms = List.new<SwitchArm>()
    arms.push(new_switch_arm(no_span(), SwitchTag.Variant(String.from("Foo")), binders, null, List.new<Stmt>()))
    val s = new_stmt(no_span(), StmtKind.Switch(expr_ptr(subj), arms))
    var env = new_local_env()
    val c = emit_stmt(s, 0, &var env)
    assert_eq(int_has_sub(c.as_str(), "__auto_type __a ="), true, "named binder a is bound")
    assert_eq(int_has_sub(c.as_str(), "___"), false, "wildcard binder emits no ___")
}

// `ctx.sigs` on a `&var TypeCtx` emits `recv.field`.
@test fun emit_field_access_through_pointer(): void {
    var recv = new_expr(no_span(), ExprKind.Variable(intern("ctx")))
    val inner_t: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner_t = Type { kind: TypeKind.Struct(intern("TypeCtx")), provenance: Provenance.Inferred(no_span()) } }
    recv.ty = Type { kind: TypeKind.PtrTo(inner_t), provenance: Provenance.Inferred(no_span()) }
    val fa = new_expr(no_span(), ExprKind.FieldAccess(expr_ptr(recv), intern("sigs")))
    val c = fa.emit_expr()
    assert_eq(c.as_str(), "(*__ctx).sigs", "pointer receiver derefs before field")
}

@test fun emit_method_proto_prepends_self(): void {
    val ret = ty_ptr("int32")
    val area = new_top_decl(no_span(), String.from("area"), TopDeclKind.Function(List.new<Param>(), ret, List.new<Stmt>(), true, false, false, false))
    val c = emit_method_proto(String.from("Foo"), area)
    assert_eq(c.as_str(), "int32_t Foo_area(Foo* __self)", "method proto mangles name + prepends self")
}

@test fun emit_primitive_method_proto_uses_the_c_receiver_type(): void {
    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("String"), List.new<Stmt>(), true, false, false, false)
    val method = new_top_decl(no_span(), String.from("display"), fkind)
    val proto = emit_method_proto(String.from("int32"), method)
    assert_eq(int_has_sub(proto.as_str(), "int32_t* __self"), true, "primitive method receivers use their C type")
}

// `String.from(x)` is an ordinary static call.
@test fun emit_string_from_method_call(): void {
    val recv = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("String"))))
    var margs = List.new<Expr>()
    margs.push(new_expr(no_span(), ExprKind.Variable(intern("x"))))
    var e = new_expr(no_span(), ExprKind.MethodCall(recv, intern("from"), margs))
    e.is_static_call = true
    e.mangled_callee = intern("String_from")
    val c = e.emit_expr()
    assert_eq(c.as_str(), "String_from(__x)", "String.from calls its static method")
}

fun string_method_expr(name: str, args: List<Expr>): Expr {
    var recv_expr = new_expr(no_span(), ExprKind.Variable(intern("s")))
    recv_expr.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    return new_expr(no_span(), ExprKind.MethodCall(expr_ptr(recv_expr), intern(name), args))
}

// String's methods are called like any struct's.
@test fun emit_string_as_str_calls_the_method(): void {
    val c = emit_expr(string_method_expr("as_str", List.new<Expr>()))
    assert_eq(c.as_str(), "String_as_str(&(__s))", "String.as_str dispatches to alloc")
}

@test fun emit_string_byte_len_calls_the_method(): void {
    val c = emit_expr(string_method_expr("byte_len", List.new<Expr>()))
    assert_eq(c.as_str(), "String_byte_len(&(__s))", "String.byte_len dispatches to alloc")
}

@test fun emit_string_clone_calls_the_method(): void {
    val c = emit_expr(string_method_expr("clone", List.new<Expr>()))
    assert_eq(c.as_str(), "String_clone(&(__s))", "String.clone dispatches to alloc")
}

@test fun emit_string_equals_dispatches_to_trait(): void {
    var args = List.new<Expr>()
    var from_args = List.new<Expr>()
    from_args.push(new_expr(no_span(), ExprKind.LitStr(String.from("x"))))
    val from_recv = new_expr(no_span(), ExprKind.Variable(intern("String")))
    var arg = new_expr(no_span(), ExprKind.MethodCall(expr_ptr(from_recv), intern("from"), from_args))
    arg.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    arg.mangled_callee = intern("String_from__From__str")
    arg.is_static_call = true
    args.push(arg)
    val c = emit_expr(string_method_expr("equals", args))
    assert_eq(c.as_str(), "String_equals(&(__s), String_from__From__str(\"x\"))", "String.equals calls Equal")
}

@test fun emit_string_append_calls_the_method(): void {
    var args = List.new<Expr>()
    args.push(new_expr(no_span(), ExprKind.LitStr(String.from("x"))))
    val c = emit_expr(string_method_expr("append", args))
    assert_eq(c.as_str(), "String_append(&(__s), \"x\")", "String.append dispatches to alloc")
}

@test fun emit_string_retain_calls_its_retain_glue(): void {
    var inner = new_expr(no_span(), ExprKind.Variable(intern("s")))
    inner.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    val retained = new_expr(no_span(), ExprKind.Retain(expr_ptr(inner)))
    val c = retained.emit_expr()
    assert_eq(c.as_str(), "kf__retain__String(__s)", "direct String retain creates an independent owner")
}

@test fun emit_cast_null_ptr(): void {
    val zero = expr_ptr(new_expr(no_span(), ExprKind.LitInt(0)))
    val target = ty_ptr_generic("Ptr", "Expr")
    val e = new_expr(no_span(), ExprKind.Cast(zero, target))
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(Expr*)(0)", "null ptr cast emits (T*)(0)")
}

@test fun emit_alloc_generic_call(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("alloc__Expr"), List.new<Expr>()))
    // The flag, not the name, makes it an intrinsic.
    e.is_intrinsic = true
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(Expr*)kf_alloc(sizeof(Expr))", "alloc emits the typed allocation ABI")
}

// The fragment is a KFlat type name and is mapped to C.
@test fun emit_alloc_generic_maps_a_primitive_to_its_c_name(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("alloc__int32"), List.new<Expr>()))
    e.is_intrinsic = true
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(int32_t*)kf_alloc(sizeof(int32_t))", "alloc maps int32 to int32_t")
}

// float64 proves a real mapping, not a `_t` suffix.
@test fun emit_alloc_generic_maps_float64_to_double(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("alloc__float64"), List.new<Expr>()))
    e.is_intrinsic = true
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(double*)kf_alloc(sizeof(double))", "alloc maps float64 to double")
}

@test fun emit_sizeof_generic_maps_a_primitive_to_its_c_name(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("sizeof__uint64"), List.new<Expr>()))
    e.is_intrinsic = true
    val c = e.emit_expr()
    assert_eq(c.as_str(), "sizeof(uint64_t)", "sizeof maps uint64 to uint64_t")
}

@test fun emit_alloc_prefers_the_qualified_mangle(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("alloc__Point"), List.new<Expr>()))
    e.is_intrinsic = true
    e.mangled_callee = intern("alloc__aa__Point")
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(aa__Point*)kf_alloc(sizeof(aa__Point))", "alloc uses its qualified folded callee")
}

// The same folded shape unmarked is an ordinary call: qualification produces
// it for a free function in a crate named `alloc`.
@test fun a_crate_qualified_name_is_not_an_intrinsic(): void {
    val e = new_expr(no_span(), ExprKind.Call(intern("alloc__trivial"), List.new<Expr>()))
    val c = e.emit_expr()
    assert_eq(c.as_str(), "alloc__trivial()", "an unmarked call is an ordinary call")
}

@test fun emit_sizeof_generic_call(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("sizeof__Type"), List.new<Expr>()))
    e.is_intrinsic = true
    val c = e.emit_expr()
    assert_eq(c.as_str(), "sizeof(Type)", "sizeof emits sizeof(T)")
}

fun pt_var_ptr(name: str): Ptr<Expr> {
    var v = new_expr(no_span(), ExprKind.Variable(intern(name)))
    v.ty = Type { kind: TypeKind.Struct(intern("Pt")), provenance: Provenance.Inferred(no_span()) }
    return expr_ptr(v)
}

// `break` lowers to `goto <loop-label>`, which escapes a switch.
@test fun while_with_break_lowers_to_goto(): void {
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Break))
    val cond = expr_ptr(new_expr(no_span(), ExprKind.LitBool(true)))
    val whl = new_stmt(no_span(), StmtKind.While(cond, body))
    var env = new_local_env()
    val c = emit_stmt(whl, 0, &var env)
    assert_eq(int_has_sub(c.as_str(), "goto __brk_0;"), true, "break → goto __brk_0;")
    assert_eq(int_has_sub(c.as_str(), "__brk_0: ;"), true, "loop emits its break-label")
}

@test fun while_without_break_has_no_label(): void {
    val nv = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("n"))))
    val one = expr_ptr(new_expr(no_span(), ExprKind.LitInt(1)))
    val plus = expr_ptr(new_expr(no_span(), ExprKind.Binary(nv, BinOp.Add, one)))
    var body = List.new<Stmt>()
    body.push(new_stmt(no_span(), StmtKind.Assign(intern("n"), plus)))
    val cond = expr_ptr(new_expr(no_span(), ExprKind.LitBool(true)))
    val whl = new_stmt(no_span(), StmtKind.While(cond, body))
    var env = new_local_env()
    val c = emit_stmt(whl, 0, &var env)
    assert_eq(int_has_sub(c.as_str(), "__brk"), false, "no label when loop has no break")
}

@test fun addr_of_lvalue_takes_plain_address(): void {
    var e = new_expr(no_span(), ExprKind.Variable(intern("x")))
    e.ty = int32_ty(no_span())
    e.coerce = coerce_addr_of()
    val c = e.emit_expr()
    assert_eq(c.as_str(), "(&__x)", "lvalue borrow emits (&x)")
}

// An rvalue argument cannot take `&(f())`; it becomes `((int32_t[1]){ mk() })`.
@test fun addr_of_rvalue_materializes_compound_literal(): void {
    var e = new_expr(no_span(), ExprKind.Call(intern("mk"), List.new<Expr>()))
    e.ty = int32_ty(no_span())
    e.coerce = coerce_addr_of()
    val c = e.emit_expr()
    assert_eq(c.as_str(), "((int32_t[1]){ mk() })", "rvalue borrow emits array compound literal")
}

// `x.f` borrows directly; `mk().f` goes through the compound-literal temp.
@test fun addr_of_field_of_rvalue_materializes_temp(): void {
    val base = expr_ptr(new_expr(no_span(), ExprKind.Call(intern("mk"), List.new<Expr>())))
    var e = new_expr(no_span(), ExprKind.FieldAccess(base, intern("f")))
    e.ty = int32_ty(no_span())
    e.coerce = coerce_addr_of()
    val c = e.emit_expr()
    assert_eq(c.as_str(), "((int32_t[1]){ (mk()).f })", "field-of-rvalue borrow goes through the temp")

    val vbase = expr_ptr(new_expr(no_span(), ExprKind.Variable(intern("x"))))
    var e2 = new_expr(no_span(), ExprKind.FieldAccess(vbase, intern("f")))
    e2.ty = int32_ty(no_span())
    e2.coerce = coerce_addr_of()
    val c2 = e2.emit_expr()
    assert_eq(c2.as_str(), "(&(__x).f)", "field-of-lvalue borrows directly")
}

pub fun ret_op(p: Ptr<Expr>): Box<Expr>? {
    return p
}
