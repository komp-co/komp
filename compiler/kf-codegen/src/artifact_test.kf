import alloc.list.*
import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt

import kf_codegen.*
import kf_codegen.emit.unit.header_type_view

// Crate "aa" owns a public struct, a public function and a private function;
// "bb" owns one function. No instance methods: emit_method mutates the AST,
// which would break the repeat-emission determinism check.

fun artifact_ty_ptr(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(no_span(), TypeRefKind.Named(intern(s), List.new<TypeRef>())) }
    return rp
}

fun owned_decl(crate_name: str, td: TopDecl): TopDecl {
    var owned = td
    owned.crate = new_crate_id(crate_name)
    owned.module_path = intern(crate_name)
    return owned
}

fun fn_decl(name: str, is_pub: bool): TopDecl {
    val fkind = TopDeclKind.Function(List.new<Param>(), artifact_ty_ptr("int32"), List.new<Stmt>(), is_pub, false, false, false)
    return new_top_decl(no_span(), String.from(name), fkind)
}

fun two_crate_module(): Module {
    var decls = List.new<TopDecl>()
    decls.push(owned_decl("aa", new_top_decl(no_span(), String.from("Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(owned_decl("aa", fn_decl("answer", true)))
    decls.push(owned_decl("aa", fn_decl("helper", false)))
    decls.push(owned_decl("bb", fn_decl("other", true)))
    return Module { crate: crate_id_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun emit_aa(): CrateCodegenOutput {
    val m = two_crate_module()
    var deps = List.new<String>()
    deps.push(String.from("bb"))
    return m.emit_crate(String.from("aa"), deps, false)
}

@test
fun repeated_emission_is_byte_identical(): void {
    val first = emit_aa()
    val second = emit_aa()
    val same_header = first.header.as_str() == second.header.as_str()
    val same_source = first.source.as_str() == second.source.as_str()
    assert_eq(same_header && same_source, true, "emit_crate output is deterministic")
}

@test
fun view_construction_keeps_the_source_ast_owned(): void {
    val m = two_crate_module()
    val view = m.crate_view(new_crate_id("aa"))
    val header_view = view.header_type_view()
    val out = m.emit_crate(String.from("aa"), List.new<String>(), false)
    assert_eq(header_view.decls.size() == 1 && artifact_contains(out.header.as_str(), "Point"), true, "views own cloned declarations and leave the source module usable")
}

@test
fun header_declares_public_functions(): void {
    val out = emit_aa()
    assert_eq(artifact_contains(out.header.as_str(), "int32_t answer(void);"), true, "public fn proto is exported")
}

@test
fun header_omits_private_functions(): void {
    val out = emit_aa()
    assert_eq(artifact_contains(out.header.as_str(), "helper"), false, "private fn stays out of the header")
}

@test
fun header_includes_runtime_and_dependencies(): void {
    val out = emit_aa()
    val has_runtime = artifact_contains(out.header.as_str(), "#include \"kf_runtime.h\"")
    val has_dep = artifact_contains(out.header.as_str(), "#include \"bb.h\"")
    assert_eq(has_runtime && has_dep, true, "header pulls the runtime and direct deps")
}

@test
fun source_includes_its_own_header(): void {
    val out = emit_aa()
    assert_eq(artifact_contains(out.source.as_str(), "#include \"aa.h\""), true, "source starts from its export surface")
}

@test
fun source_excludes_other_crates_definitions(): void {
    val out = emit_aa()
    assert_eq(artifact_contains(out.source.as_str(), "other"), false, "another crate's decls never reach this source")
}

@test
fun exported_symbols_include_public_ownership_glue(): void {
    val out = emit_aa()
    val count = out.exported_symbols.size() == 4
    val named = out.exported_symbols.at(3).as_str() == "Point__glue_clone"
    assert_eq(count && named, true, "metadata carries functions and ownership glue")
}

@test
fun header_carries_concrete_generic_layouts_used_by_public_types(): void {
    var owner_fields = List.new<Field>()
    owner_fields.push(new_field(no_span(), String.from("items"), artifact_ty_ptr("List__aa__Point"), false, true))
    var decls = List.new<TopDecl>()
    decls.push(owned_decl("aa", new_top_decl(no_span(), String.from("aa__Point"), TopDeclKind.Struct(List.new<Field>(), true))))
    decls.push(owned_decl("aa", new_top_decl(no_span(), String.from("aa__Owner"), TopDeclKind.Struct(owner_fields, true))))
    var instance = owned_decl("aa", new_top_decl(no_span(), String.from("List__aa__Point"), TopDeclKind.Struct(List.new<Field>(), true)))
    instance.linkage = Linkage.GenericTemplate
    decls.push(instance)
    val m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val out = m.emit_crate(String.from("aa"), List.new<String>(), false)
    val header_has_layout = artifact_contains(out.header.as_str(), "typedef struct List__aa__Point {")
    val header_guards_layout = artifact_contains(out.header.as_str(), "#ifndef KF_GENERIC_LAYOUT_List__aa__Point")
    val source_redefines_layout = artifact_contains(out.source.as_str(), "typedef struct List__aa__Point {")
    assert_eq(header_has_layout && header_guards_layout && !source_redefines_layout, true, "the public generic layout is guarded and defined only by the header")
}

@test
fun source_closes_transitive_generic_signature_support(): void {
    var owner_fields = List.new<Field>()
    owner_fields.push(new_field(no_span(), String.from("items"), artifact_ty_ptr("List__aa__Point"), false, true))
    var decls = List.new<TopDecl>()
    decls.push(owned_decl("aa", new_top_decl(no_span(), String.from("aa__Owner"), TopDeclKind.Struct(owner_fields, true))))
    var list_layout = owned_decl("alloc", new_top_decl(no_span(), String.from("List__aa__Point"), TopDeclKind.Struct(List.new<Field>(), true)))
    list_layout.linkage = Linkage.GenericTemplate
    decls.push(list_layout)
    val iter_method = new_top_decl(no_span(), String.from("iter"), TopDeclKind.Function(List.new<Param>(), artifact_ty_ptr("ListIter__aa__Point"), List.new<Stmt>(), true, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(iter_method)
    var list_impl = owned_decl("alloc", new_top_decl(no_span(), String.from("List__aa__Point"), TopDeclKind.ImplBlock(methods)))
    list_impl.linkage = Linkage.GenericTemplate
    decls.push(list_impl)
    var iter_layout = owned_decl("alloc", new_top_decl(no_span(), String.from("ListIter__aa__Point"), TopDeclKind.Struct(List.new<Field>(), true)))
    iter_layout.linkage = Linkage.GenericTemplate
    decls.push(iter_layout)
    val m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val out = m.emit_crate(String.from("aa"), List.new<String>(), false)
    assert_eq(artifact_contains(out.source.as_str(), "typedef struct ListIter__aa__Point {"), true, "instance signatures pull transitive layouts into the source")
}

@test
fun source_emits_glue_for_a_header_carried_generic_layout(): void {
    var owner_fields = List.new<Field>()
    owner_fields.push(new_field(no_span(), String.from("items"), artifact_ty_ptr("List__aa__Point"), false, true))
    var decls = List.new<TopDecl>()
    decls.push(owned_decl("aa", new_top_decl(no_span(), String.from("aa__Owner"), TopDeclKind.Struct(owner_fields, true))))
    var instance = owned_decl("alloc", new_top_decl(no_span(), String.from("List__aa__Point"), TopDeclKind.Struct(List.new<Field>(), true)))
    instance.linkage = Linkage.GenericTemplate
    decls.push(instance)
    val drop_method = new_top_decl(no_span(), String.from("drop"), TopDeclKind.Function(List.new<Param>(), artifact_ty_ptr("void"), List.new<Stmt>(), false, false, false, false))
    var methods = List.new<TopDecl>()
    methods.push(drop_method)
    var instance_impl = owned_decl("alloc", new_top_decl(no_span(), String.from("List__aa__Point"), TopDeclKind.ImplBlock(methods)))
    instance_impl.linkage = Linkage.GenericTemplate
    decls.push(instance_impl)
    val m = Module { crate: new_crate_id("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    val out = m.emit_crate(String.from("aa"), List.new<String>(), false)
    val has_clone = artifact_contains(out.source.as_str(), "List__aa__Point__glue_clone(List__aa__Point v)")
    val static_drop = artifact_contains(out.source.as_str(), "static void List__aa__Point_drop(")
    val external_drop = artifact_contains(out.source.as_str(), "\nvoid List__aa__Point_drop(")
    assert_eq(has_clone && static_drop && !external_drop, true, "generic glue and user methods keep TU-local linkage")
}

fun artifact_contains(s: str, needle: str): bool {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return true }
    if sl < nl { return false }
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// A crate's name and its artifact's filename are different questions: the
// test TU must include `<crate>_tests.h`.
@test
fun the_source_includes_its_own_artifact_not_its_crate(): void {
    val m = two_crate_module()
    val out = m.emit_crate_named(String.from("aa"), String.from("aa_tests"), List.new<String>(), false)
    assert_eq(artifact_contains(out.source.as_str(), "#include \"aa_tests.h\""), true, "the source includes the artifact it was written beside")
    assert_eq(artifact_contains(out.source.as_str(), "#include \"aa.h\""), false, "and not the crate's own header")
}

@test
fun a_renamed_artifact_still_belongs_to_its_crate(): void {
    // Crate identity does not follow the artifact name.
    val plain = emit_crate(&m_for_naming(), String.from("aa"), List.new<String>(), false)
    val named = emit_crate_named(&m_for_naming(), String.from("aa"), String.from("aa_tests"), List.new<String>(), false)
    assert_eq(named.crate_name.as_str(), "aa", "the crate name is unchanged")
    assert_eq(artifact_contains(named.header.as_str(), "Point"), artifact_contains(plain.header.as_str(), "Point"), "the same declarations are exported")
}

fun m_for_naming(): Module {
    return two_crate_module()
}
