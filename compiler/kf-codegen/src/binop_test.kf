// How a binary operator is emitted: the C operators, the `str` comparison,
// and the operator traits.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*

import kf_codegen.*
import kf_codegen.emit.expr.emit_expr

fun str_var_ptr(name: str): Ptr<Expr> {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name)))
    e.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(no_span()) }
    return expr_ptr(e)
}

fun prim_var_ptr(name: str, k: TypeKind): Ptr<Expr> {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name)))
    e.ty = Type { kind: k, provenance: Provenance.Inferred(no_span()) }
    return expr_ptr(e)
}

fun emit_prim_binop(k: TypeKind, op: BinOp): String {
    val e = new_expr(no_span(), ExprKind.Binary(prim_var_ptr("a", k), op, prim_var_ptr("b", k)))
    return e.emit_expr()
}

// A primitive operator is the C operator, which an optimizer can see through.
@test fun a_primitive_operator_emits_the_c_operator(): void {
    assert_eq(emit_prim_binop(TypeKind.Int32, BinOp.Add).as_str(), "((int32_t)(__a + __b))", "+")
    assert_eq(emit_prim_binop(TypeKind.Int32, BinOp.Shl).as_str(), "((int32_t)(__a << __b))", "<<")
    assert_eq(emit_prim_binop(TypeKind.Int32, BinOp.Eq).as_str(), "(__a == __b)", "==")
    assert_eq(emit_prim_binop(TypeKind.Int32, BinOp.Lt).as_str(), "(__a < __b)", "<")
    assert_eq(emit_prim_binop(TypeKind.UInt64, BinOp.Mod).as_str(), "((uint64_t)(__a % __b))", "%")
    assert_eq(emit_prim_binop(TypeKind.Bool, BinOp.Eq).as_str(), "(__a == __b)", "bool ==")
}

// C promotes narrow operands to `int`, so the result is cast back to wrap.
@test fun a_narrow_result_is_cast_back_to_its_own_width(): void {
    assert_eq(emit_prim_binop(TypeKind.Int8, BinOp.Add).as_str(), "((int8_t)(__a + __b))", "int8")
    assert_eq(emit_prim_binop(TypeKind.UInt16, BinOp.Mul).as_str(), "((uint16_t)(__a * __b))", "uint16")
    assert_eq(emit_prim_binop(TypeKind.Int8, BinOp.Lt).as_str(), "(__a < __b)", "no cast on a bool answer")
}

// core orders NaN after every number; C's comparisons against NaN are all
// false. Ordered float comparisons keep going through `Compare`.
@test fun an_ordered_float_comparison_keeps_its_trait_call(): void {
    assert_eq(emit_prim_binop(TypeKind.Float64, BinOp.Lt).as_str(),
        "(float64_compare__Compare(&(__a), __b) < 0)", "<")
    assert_eq(emit_prim_binop(TypeKind.Float64, BinOp.GtEq).as_str(),
        "(float64_compare__Compare(&(__a), __b) >= 0)", ">=")
    assert_eq(emit_prim_binop(TypeKind.Float64, BinOp.Eq).as_str(), "(__a == __b)", "==")
    assert_eq(emit_prim_binop(TypeKind.Float64, BinOp.Add).as_str(), "((double)(__a + __b))", "+")
}

// `a + b` on String operands dispatches through its `Add` impl.
@test fun emit_string_add_dispatches_to_trait(): void {
    val e = new_expr(no_span(), ExprKind.Binary(str_var_ptr("a"), BinOp.Add, str_var_ptr("b")))
    val c = e.emit_expr()
    assert_eq(c.as_str(), "String_add__Add(&(__a), __b)", "String + calls Add")
}

@test fun emit_pointer_to_struct_add_uses_pointer_arithmetic(): void {
    val pointee: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *pointee = Type { kind: TypeKind.Struct(intern("Type")), provenance: Provenance.Inferred(no_span()) } }
    var data = new_expr(no_span(), ExprKind.Variable(intern("data")))
    data.ty = Type { kind: TypeKind.PtrTo(pointee), provenance: Provenance.Inferred(no_span()) }
    var len = new_expr(no_span(), ExprKind.Variable(intern("len")))
    len.ty = Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(no_span()) }
    val e = new_expr(no_span(), ExprKind.Binary(expr_ptr(data), BinOp.Add, expr_ptr(len)))
    assert_eq(e.emit_expr().as_str(), "(__data + __len)", "pointer arithmetic does not dispatch pointee Add")
}

// `a == b` on String operands dispatches through its `Equal` impl.
@test fun emit_string_equality_dispatches_to_trait(): void {
    val e = new_expr(no_span(), ExprKind.Binary(str_var_ptr("a"), BinOp.Eq, str_var_ptr("b")))
    val c = e.emit_expr()
    assert_eq(c.as_str(), "String_equals(&(__a), __b)", "String == calls Equal")
}

// `==` on a struct calls `Pt_equals`, with no `__Equal` suffix: Clone, Drop
// and Equal are exempt from trait-method renaming.
@test fun emit_struct_equality_has_no_trait_suffix(): void {
    val e = new_expr(no_span(), ExprKind.Binary(pt_var_ptr("p"), BinOp.Eq, pt_var_ptr("q")))
    assert_eq(e.emit_expr().as_str(), "Pt_equals(&(__p), __q)", "struct == calls the unsuffixed Equal impl")
}

@test fun emit_struct_inequality_negates_the_same_call(): void {
    val e = new_expr(no_span(), ExprKind.Binary(pt_var_ptr("p"), BinOp.NotEq, pt_var_ptr("q")))
    assert_eq(e.emit_expr().as_str(), "(!Pt_equals(&(__p), __q))", "struct != negates the same call")
}

// Other operator traits keep their suffix.
@test fun emit_struct_add_keeps_its_trait_suffix(): void {
    val e = new_expr(no_span(), ExprKind.Binary(pt_var_ptr("p"), BinOp.Add, pt_var_ptr("q")))
    assert_eq(e.emit_expr().as_str(), "Pt_add__Add(&(__p), __q)", "struct + keeps the __Add suffix")
}

// `s == "literal"` feeds both as C strings to str_equals.
@test fun emit_str_vs_literal_eq(): void {
    var lhs = new_expr(no_span(), ExprKind.Variable(intern("s")))
    lhs.ty = Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
    var rhs = new_expr(no_span(), ExprKind.LitStr(String.from("new_list")))
    rhs.ty = Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(no_span()) }
    val e = new_expr(no_span(), ExprKind.Binary(expr_ptr(lhs), BinOp.Eq, expr_ptr(rhs)))
    val c = e.emit_expr()
    assert_eq(c.as_str(), "str_equals(__s, \"new_list\")", "str vs literal uses raw cstrings")
}

fun borrowed_var_ptr(name: str, k: TypeKind): Ptr<Expr> {
    var e = new_expr(no_span(), ExprKind.Variable(intern(name)))
    e.ty = Type { kind: k, provenance: Provenance.Inferred(no_span()) }
    e.coerce = coerce_addr_of()
    return expr_ptr(e)
}

// Typecheck borrows the right operand for a by-reference trait; the C
// operator still takes it by value.
@test fun a_c_operator_takes_a_borrowed_operand_by_value(): void {
    val a = prim_var_ptr("a", TypeKind.Int32)
    val b = borrowed_var_ptr("b", TypeKind.Int32)
    val add = new_expr(no_span(), ExprKind.Binary(a, BinOp.Add, b))
    assert_eq(add.emit_expr().as_str(), "((int32_t)(__a + __b))", "a borrowed operand stays a value under +")
}

// A struct operator is a trait call, and there the borrow is the argument.
@test fun an_operator_trait_call_passes_a_borrowed_operand_by_address(): void {
    val p = TypeKind.Struct(intern("P"))
    val eq = new_expr(no_span(), ExprKind.Binary(prim_var_ptr("a", p), BinOp.Eq, borrowed_var_ptr("b", p)))
    assert_eq(eq.emit_expr().as_str(), "P_equals(&(__a), (&__b))", "the operand arrives as an address")
}

// A generic `T: Equal` at `str` reaches `str_equals`, which takes C strings.
@test fun a_str_comparison_takes_a_borrowed_operand_by_value(): void {
    val a = prim_var_ptr("a", TypeKind.StrTy)
    val b = borrowed_var_ptr("b", TypeKind.StrTy)
    val eq = new_expr(no_span(), ExprKind.Binary(a, BinOp.Eq, b))
    assert_eq(eq.emit_expr().as_str(), "str_equals(__a, __b)", "a borrowed str operand stays a value")
}

// Beside a primitive, an unresolved operand is that primitive.
@test fun a_primitive_operator_beside_an_untyped_operand_is_the_c_operator(): void {
    val a = prim_var_ptr("a", TypeKind.Int32)
    val b = prim_var_ptr("b", TypeKind.Poison)
    val add = new_expr(no_span(), ExprKind.Binary(a, BinOp.Add, b))
    assert_eq(add.emit_expr().as_str(), "((int32_t)(__a + __b))", "an untyped right operand stays a C operand")
}
