import core.assert.assert_eq

@test
fun a_comment_just_above_documents(): void {
    val text = "/// Adds.\nfun add(): void { }\n"
    assert_eq(has_doc_comment(text, 10), true, "the line above is `///`")
}

@test
fun a_comment_above_an_annotation_documents(): void {
    val text = "/// Adds.\n@inline\nfun add(): void { }\n"
    assert_eq(has_doc_comment(text, 18), true, "annotations between are passed over")
}

@test
fun a_plain_comment_does_not_document(): void {
    val text = "// Adds.\nfun add(): void { }\n"
    assert_eq(has_doc_comment(text, 9), false, "two slashes are a remark, not a doc")
}

@test
fun the_first_line_has_nothing_above_it(): void {
    assert_eq(has_doc_comment("fun add(): void { }\n", 0), false, "the start of the file")
}
