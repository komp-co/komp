// The naming lints: functions and variables in lower_snake_case, types and
// enum variants in UpperCamelCase. A function taking nothing stands for a
// constant, so UPPER_SNAKE_CASE also names it.

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

/// Lowercase letters, digits and `_`.
pub fun is_snake_case(name: str): bool {
    while i in 0..name.byte_len() {
        val byte = name.byte(i)
        val lower = byte >= 97 && byte <= 122
        val digit = byte >= 48 && byte <= 57
        if !lower && !digit && byte != 95 { return false }
    }
    return true
}

/// Uppercase letters, digits and `_`: a constant's name.
pub fun is_upper_snake_case(name: str): bool {
    while i in 0..name.byte_len() {
        val byte = name.byte(i)
        val upper = byte >= 65 && byte <= 90
        val digit = byte >= 48 && byte <= 57
        if !upper && !digit && byte != 95 { return false }
    }
    return true
}

/// An uppercase letter, then letters and digits.
pub fun is_camel_case(name: str): bool {
    if name.byte_len() == 0 { return true }
    val first = name.byte(0)
    if first < 65 || first > 90 { return false }
    while i in 0..name.byte_len() {
        val byte = name.byte(i)
        val letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        val digit = byte >= 48 && byte <= 57
        if !letter && !digit { return false }
    }
    return true
}

/// A function taking nothing may be named as the constant it stands for.
pub fun check_function_name(name: str, takes_nothing: bool, at: Span, walk: &var LintWalk): void {
    if is_snake_case(name) || (takes_nothing && is_upper_snake_case(name)) { return }
    walk.found.push(lint_at("non_snake_case_function", at, "function `${name}` should be named in lower_snake_case"))
}

pub fun check_type_name(name: str, at: Span, walk: &var LintWalk): void {
    if is_camel_case(name) { return }
    walk.found.push(lint_at("non_camel_case_type", at, "type `${name}` should be named in UpperCamelCase"))
}

pub fun check_variant_name(name: str, at: Span, walk: &var LintWalk): void {
    if is_camel_case(name) { return }
    walk.found.push(lint_at("non_camel_case_variant", at, "variant `${name}` should be named in UpperCamelCase"))
}

pub fun check_variable_name(name: Sym, at: Span, walk: &var LintWalk): void {
    val text = name.as_str()
    if is_snake_case(text) { return }
    walk.found.push(lint_at("non_snake_case_variable", at, "variable `${text}` should be named in lower_snake_case"))
}
