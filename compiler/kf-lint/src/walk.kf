// One pass over a function's body, handing each statement and expression to
// the lints that look at it.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

/// What the walk has found, and where it is.
pub struct LintWalk {
    pub val options: LintOptions
    pub var found: List<Diagnostic>
    /// How many blocks enclose the statement being walked.
    var depth: int64
    /// Whether this function's nesting has been reported, so it is once.
    var nesting_reported: bool
    var locals: LocalUses
    /// Whether the function stands for a constant or is a test, whose
    /// literals are the point of it.
    var numbers_allowed: bool
    /// How many range bounds and indexes enclose the expression, whose
    /// literals read plainly.
    var numbers_shielded: int64
}

pub fun new_lint_walk(options: &LintOptions): LintWalk {
    return LintWalk {
        options: options.clone(), found: List.new<Diagnostic>(), depth: 0, nesting_reported: false, locals: no_locals(),
        numbers_allowed: false, numbers_shielded: 0
    }
}

impl LintWalk {
    /// Walks one function's body, reporting its locals when it is done.
    /// `own_signature` is false where the parameters are another
    /// declaration's to name, as in a trait's impl, so none is reported unread.
    pub mutating fun function(
        params: &List<Param>, body: &List<Stmt>, own_signature: bool, numbers_allowed: bool
    ): void {
        self.depth = 0
        self.nesting_reported = false
        self.locals = no_locals()
        self.numbers_allowed = numbers_allowed
        while param in &params {
            if param.name.as_str() == "self" { continue }
            check_variable_name(param.name, param.span, self)
            if own_signature && !body.is_empty() { self.locals.declare_parameter(param.name, param.span) }
        }
        body.visit(self)
        self.locals.report(&var self.found)
        self.locals.report_vars(&var self.found)
    }

    /// Into a block, reporting `deep_nesting` the first time the function
    /// goes past its limit.
    mutating fun enter(at: Span): void {
        self.depth = self.depth + 1
        val max = self.options.get("deep_nesting", "max_depth")
        if self.depth <= max || self.nesting_reported { return }
        self.nesting_reported = true
        self.found.push(lint_at("deep_nesting", at, "blocks nest ${self.depth} deep here; the most is ${max}"))
    }

    mutating fun leave(): void {
        self.depth = self.depth - 1
    }

    mutating fun block(at: Span, body: &List<Stmt>): void {
        self.enter(at)
        body.visit(self)
        self.leave()
    }

    fun numbers_checked(): bool {
        return !self.numbers_allowed && self.numbers_shielded == 0
    }

    /// A call's arguments; `shielded` for a range's bounds or an index,
    /// whose numbers are not reported.
    mutating fun visit_arguments(args: &List<Expr>, shielded: bool): void {
        if shielded { self.numbers_shielded = self.numbers_shielded + 1 }
        while arg in &args { arg.visit(self) }
        if shielded { self.numbers_shielded = self.numbers_shielded - 1 }
    }

    mutating fun local(name: Sym, at: Span): void {
        check_variable_name(name, at, self)
        if self.locals.declare(name, at) {
            self.found.push(lint_at("shadowed_variable", at, "`${name.as_str()}` is already bound in this function"))
        }
    }
}

/// `unreachable_code` once per block: a statement after one that leaves it.
fun List<Stmt>.visit(walk: &var LintWalk): void {
    var left = false
    while s in &self {
        if left {
            walk.found.push(lint_at("unreachable_code", s.span,
                String.from("this is never reached: the statement before it leaves the block")))
            left = false
        }
        s.visit(walk)
        if s.leaves_the_block() { left = true }
    }
}

fun Stmt.visit(walk: &var LintWalk): void {
    when (self.kind) {
        LetVal(name, _ty, init) => {
            walk.local(name, self.binder)
            visit_optional(&init, walk)
        }
        LetVar(name, _ty, init) => {
            walk.local(name, self.binder)
            walk.locals.declare_var(name, self.binder)
            visit_optional(&init, walk)
        }
        Assign(name, value) => {
            check_self_assignment(name, value.kind_is_variable(name), self.span, walk)
            walk.locals.change(name.id as int64)
            value.visit(walk)
        }
        AssignTo(place, value) => {
            walk.locals.change(place.root_variable())
            place.visit(walk)
            value.visit(walk)
        }
        Return(value) => visit_optional(&value, walk)
        If(cond, then_body, else_body) => {
            check_if_shape(self.span, &then_body, &else_body, walk)
            check_needless_bool(self.span, then_body.returned_bool(), else_body.returned_bool(), walk)
            cond.visit(walk)
            walk.block(self.span, &then_body)
            // `else if` is a chain, not a level deeper.
            if else_body.size() == 1 && else_body[0].is_if() {
                else_body[0].visit(walk)
            } else if !else_body.is_empty() {
                walk.block(self.span, &else_body)
            }
        }
        While(cond, body) => {
            check_manual_index_loop(self.span, cond.counted_below(), &body, walk)
            cond.visit(walk)
            walk.block(self.span, &body)
        }
        ForEach(binder, subject, body) => {
            subject.visit(walk)
            walk.local(binder, if self.binder.is_none() { self.span } else { self.binder })
            walk.block(self.span, &body)
        }
        When(subject, arms) => {
            subject.visit(walk)
            visit_arms(&arms, walk)
        }
        Expression(e) => e.visit(walk)
        _ => {}
    }
}

fun Stmt.is_if(): bool {
    return when (self.kind) {
        If(_c, _t, _e) => true
        _ => false
    }
}

fun visit_optional(value: &Box<Expr>?, walk: &var LintWalk): void {
    when (value) {
        Some(e) => e.visit(walk)
        None => {}
    }
}

fun visit_arms(arms: &List<Arm>, walk: &var LintWalk): void {
    while arm in &arms {
        visit_optional(&arm.guard, walk)
        walk.block(arm.span, &arm.body)
    }
}

fun Expr.visit(walk: &var LintWalk): void {
    // A borrow may be handed to something that changes it, as `&var x.body`
    // or a `&list` a function fills; which do is the callee's to say.
    if self.coerce == coerce_written_amp() || self.coerce == coerce_written_amp_var() {
        walk.locals.change(self.root_variable())
    }
    when (self.kind) {
        Variable(name) => walk.locals.use_name(name)
        LitInt(value) => {
            if walk.numbers_checked() { check_magic_number(self.span, value, walk) }
        }
        LitFloat(spelling) => {
            if walk.numbers_checked() { check_magic_float(self.span, spelling.as_str(), walk) }
        }
        Binary(left, op, right) => {
            check_bool_comparison(self.span, &op, left.kind_is_bool(), right.kind_is_bool(), walk)
            check_identity_op(self.span, &op, left.literal_int(), right.literal_int(), walk)
            check_self_comparison(self.span, &op, left.variable_id(), right.variable_id(), walk)
            check_len_zero(self.span, &op, left.is_length_call(), right.literal_int(), walk)
            left.visit(walk)
            right.visit(walk)
        }
        Unary(op, inner) => {
            check_double_negation(self.span, &op, inner.is_not(), walk)
            inner.visit(walk)
        }
        Deref(inner) => inner.visit(walk)
        Call(name, args) => {
            walk.locals.use_name(name)
            val shield = name.as_str() == "range" || name.as_str() == "range_inclusive"
            walk.visit_arguments(&args, shield)
        }
        MethodCall(receiver, name, args) => {
            // Conservatively a change: which methods mutate is the type's to say.
            walk.locals.change(receiver.root_variable())
            receiver.visit(walk)
            walk.visit_arguments(&args, name.as_str() == "index")
        }
        FieldAccess(inner, _field) => inner.visit(walk)
        IfExpr(cond, then_value, else_value) => {
            check_needless_bool(self.span, then_value.kind_is_bool(), else_value.kind_is_bool(), walk)
            cond.visit(walk)
            then_value.visit(walk)
            else_value.visit(walk)
        }
        WhenExpr(subject, arms) => {
            subject.visit(walk)
            visit_arms(&arms, walk)
        }
        StructLit(_name, inits) => {
            while init in &inits { init.value.visit(walk) }
        }
        Cast(inner, _ty) => inner.visit(walk)
        Lambda(_params, body) => walk.block(self.span, &body)
        Block(body) => body.visit(walk)
        _ => {}
    }
}

fun Expr.kind_is_variable(name: Sym): bool {
    return when (self.kind) {
        Variable(other) => other.id == name.id
        _ => false
    }
}

/// `true`, `false`, or neither as -1.
fun Expr.kind_is_bool(): int32 {
    return when (self.kind) {
        LitBool(value) => if value { 1 } else { 0 }
        _ => -1
    }
}

/// A literal integer's value, or null.
fun Expr.literal_int(): int64? {
    return when (self.kind) {
        LitInt(value) => Option.Some(value)
        _ => null
    }
}

/// A variable's symbol id, or -1.
fun Expr.variable_id(): int64 {
    return when (self.kind) {
        Variable(name) => name.id as int64
        _ => -1
    }
}

fun Expr.is_not(): bool {
    return when (self.kind) {
        Unary(op, _inner) => when (op) {
            Not => true
            _ => false
        }
        _ => false
    }
}

/// `true` or `false` returned by a branch that holds only that `return`,
/// as 1 or 0; -1 for any other branch.
fun List<Stmt>.returned_bool(): int32 {
    if self.size() != 1 { return -1 }
    return when (self[0].kind) {
        Return(value) => bool_of(&value)
        _ => -1
    }
}

fun bool_of(value: &Box<Expr>?): int32 {
    return when (value) {
        Some(e) => e.kind_is_bool()
        None => -1
    }
}

/// The variable a `while` condition counts below a bound, as in `i < n`,
/// or -1.
fun Expr.counted_below(): int64 {
    return when (self.kind) {
        Binary(left, op, _right) => when (op) {
            Lt => left.variable_id()
            LtEq => left.variable_id()
            _ => -1
        }
        _ => -1
    }
}

/// The variable an lvalue or receiver ends at, as `x` in `x.a[i]`, by
/// symbol id; -1 when it ends at something else.
fun Expr.root_variable(): int64 {
    return when (self.kind) {
        Variable(name) => name.id as int64
        FieldAccess(inner, _field) => inner.root_variable()
        MethodCall(receiver, _name, _args) => receiver.root_variable()
        Deref(inner) => inner.root_variable()
        _ => -1
    }
}

/// `xs.size()` or `s.byte_len()`, taking nothing.
fun Expr.is_length_call(): bool {
    return when (self.kind) {
        MethodCall(_receiver, name, args) => args.is_empty() && (name.as_str() == "size" || name.as_str() == "byte_len")
        _ => false
    }
}
