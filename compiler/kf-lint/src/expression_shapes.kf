// Lints on the shape of one statement or expression: a boolean literal
// compared or returned, a variable assigned to or compared with itself, an
// operation that changes nothing, a `!` of a `!`, and a number nobody named.

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*

/// `bool_comparison`: `x == true` and its kin. `left` and `right` are 1 for
/// `true`, 0 for `false` and -1 for anything else.
pub fun check_bool_comparison(at: Span, op: &BinOp, left: int32, right: int32, walk: &var LintWalk): void {
    val equal = when (op) {
        Eq => 1
        NotEq => 0
        _ => -1
    }
    if equal < 0 || (left < 0 && right < 0) { return }
    val literal = if left >= 0 { left } else { right }
    val same = (literal == 1) == (equal == 1)
    val advice = if same { "write the condition itself" } else { "negate the condition with `!`" }
    val written = if literal == 1 { "true" } else { "false" }
    walk.found.push(lint_at("bool_comparison", at, "comparing with `${written}`: ${advice}"))
}

/// `self_assignment`: `x = x`.
pub fun check_self_assignment(name: Sym, reads_itself: bool, at: Span, walk: &var LintWalk): void {
    if !reads_itself { return }
    walk.found.push(lint_at("self_assignment", at, "`${name.as_str()}` is assigned to itself"))
}

/// `needless_bool`: branches yielding `true` and `false`, which is the
/// condition or its negation. 1 and 0 for the literals, -1 otherwise.
pub fun check_needless_bool(at: Span, then_value: int32, else_value: int32, walk: &var LintWalk): void {
    if then_value < 0 || else_value < 0 || then_value == else_value { return }
    val advice = if then_value == 1 { "the condition itself" } else { "the condition negated with `!`" }
    walk.found.push(lint_at("needless_bool", at, "the branches give `true` and `false`: use ${advice}"))
}

/// `self_comparison`: `x == x` and its kin, which always give one answer.
pub fun check_self_comparison(at: Span, op: &BinOp, left: int64, right: int64, walk: &var LintWalk): void {
    if left < 0 || left != right { return }
    val compares = when (op) {
        Eq => true
        NotEq => true
        Lt => true
        Gt => true
        LtEq => true
        GtEq => true
        _ => false
    }
    if !compares { return }
    walk.found.push(lint_at("self_comparison", at,
        String.from("a variable compared with itself always gives the same answer")))
}

/// `identity_op`: `x + 0`, `x - 0`, `x * 1`, `x / 1` and `0 + x`, `1 * x`.
pub fun check_identity_op(at: Span, op: &BinOp, left: int64?, right: int64?, walk: &var LintWalk): void {
    val right_value = right ?: -1
    val left_value = left ?: -1
    val identity = when (op) {
        Add => right_value == 0 || left_value == 0
        Sub => right_value == 0
        Mul => right_value == 1 || left_value == 1
        Div => right_value == 1
        _ => false
    }
    if !identity { return }
    walk.found.push(lint_at("identity_op", at, String.from("this operation leaves the value as it is")))
}

/// `double_negation`: `!(!x)`.
pub fun check_double_negation(at: Span, op: &UnaryOp, inner_is_not: bool, walk: &var LintWalk): void {
    val outer_is_not = when (op) {
        Not => true
        _ => false
    }
    if !outer_is_not || !inner_is_not { return }
    walk.found.push(lint_at("double_negation", at, String.from("this negates twice; write the value itself")))
}

/// `magic_number`: an integer past `max_plain` written where it is used,
/// rather than named by a constant.
pub fun check_magic_number(at: Span, value: int64, walk: &var LintWalk): void {
    if value >= 0 && value <= walk.options.get("magic_number", "max_plain") { return }
    walk.found.push(lint_at("magic_number", at, "`${value}` has no name; give it one with a constant"))
}

/// As `check_magic_number`, for a float: only a whole number up to
/// `max_plain`, as `1.0`, reads plainly.
pub fun check_magic_float(at: Span, spelling: str, walk: &var LintWalk): void {
    val dot = spelling.index_of(".") ?: spelling.byte_len()
    var whole: int64 = 0
    var plain = dot > 0 && dot <= 9
    while i in 0..spelling.byte_len() {
        val byte = spelling.byte(i)
        if i < dot {
            if byte < 48 || byte > 57 { plain = false } else if plain { whole = whole * 10 + (byte - 48) as int64 }
        } else if i > dot && byte != 48 {
            plain = false
        }
    }
    if plain && whole <= walk.options.get("magic_number", "max_plain") { return }
    walk.found.push(lint_at("magic_number", at, "`${spelling}` has no name; give it one with a constant"))
}

/// `len_zero`: `xs.size() == 0` and its kin, which `is_empty()` says.
pub fun check_len_zero(at: Span, op: &BinOp, left_is_length: bool, right: int64?, walk: &var LintWalk): void {
    if !left_is_length || (right ?: -1) != 0 { return }
    val compares = when (op) {
        Eq => true
        NotEq => true
        Gt => true
        _ => false
    }
    if !compares { return }
    walk.found.push(lint_at("len_zero", at, String.from("comparing a length with zero; write `is_empty()`")))
}
