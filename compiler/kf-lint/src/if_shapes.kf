// Lints on the shape of an `if` statement: one with nothing in it, one that
// holds only another `if`, and an `else` after a branch that cannot fall
// through.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.statement.Stmt
import kf_core.diagnostic.*

pub fun check_if_shape(at: Span, then_body: &List<Stmt>, else_body: &List<Stmt>, walk: &var LintWalk): void {
    if then_body.is_empty() && else_body.is_empty() {
        walk.found.push(lint_at("empty_if", at, String.from("this `if` does nothing whichever way it goes")))
        return
    }
    if else_body.is_empty() && then_body.size() == 1 && then_body[0].is_bare_if() {
        walk.found.push(lint_at("collapsible_if", at,
            String.from("this `if` holds only another `if`; join the two conditions with `&&`")))
    }
    if !else_body.is_empty() && !then_body.is_empty() && then_body[then_body.size() - 1].leaves_the_block() {
        walk.found.push(lint_at("redundant_else", at,
            String.from("the `if` branch cannot fall through, so its `else` can be taken out of the block")))
    }
}

/// An `if` without an `else`.
fun Stmt.is_bare_if(): bool {
    return when (self.kind) {
        If(_c, _t, else_body) => else_body.is_empty()
        _ => false
    }
}

fun Stmt.leaves_the_block(): bool {
    return when (self.kind) {
        Return(_value) => true
        Break => true
        Continue => true
        _ => false
    }
}
