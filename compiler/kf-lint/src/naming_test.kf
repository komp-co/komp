import core.assert.assert_eq

@test
fun snake_case_takes_lowercase_digits_and_underscores(): void {
    assert_eq(is_snake_case("_parse_expr2"), true, "a leading underscore too")
}

@test
fun snake_case_refuses_an_uppercase_letter(): void {
    assert_eq(is_snake_case("parseExpr"), false, "camel case is not snake case")
}

@test
fun camel_case_starts_with_an_uppercase_letter(): void {
    assert_eq(is_camel_case("typeKind"), false, "a lowercase start")
}

@test
fun camel_case_refuses_an_underscore(): void {
    assert_eq(is_camel_case("Type_Kind"), false, "underscores are snake case's")
}

@test
fun camel_case_takes_letters_and_digits(): void {
    assert_eq(is_camel_case("Utf8Error"), true, "digits after the first letter")
}

@test
fun upper_snake_case_is_a_constant_name(): void {
    assert_eq(is_upper_snake_case("TAG_INT8"), true, "uppercase, digits, underscores")
}
