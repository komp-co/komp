// The checks the typed walk makes: a `Result` or `Option` dropped on the
// floor, a clone of a value whose type derives `Copy`, a cast to the type a
// value already has, and floats compared for equality.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.Type
import kf_core.ast.expression.BinOp
import kf_core.diagnostic.*

/// `unused_result` and `unused_option`: an expression statement whose value
/// says whether it worked, or whether there was one.
pub fun check_dropped_value(at: Span, ty: &Type, walk: &var TypedWalk): void {
    val name = ty.named()
    if name.as_str() == "Result" || name.as_str().starts_with("Result__") {
        walk.found.push(lint_at("unused_result", at,
            String.from("this `Result` is dropped; handle the error, or bind it to `_` to say so")))
    } else if name.as_str() == "Option" || name.as_str().starts_with("Option__") {
        walk.found.push(lint_at("unused_option", at,
            String.from("this `Option` is dropped; bind it to `_` if that is meant")))
    }
}

/// `clone_on_copy`: `.clone()` on a value whose type derives `Copy`.
pub fun check_clone_on_copy(at: Span, receiver: String, walk: &var TypedWalk): void {
    if receiver.is_empty() || !walk.copy_types.holds_name(receiver.as_str()) { return }
    walk.found.push(lint_at("clone_on_copy", at,
        "`${receiver}` derives `Copy`, so this value is copied anyway; `.clone()` adds nothing"))
}

fun List<String>.holds_name(name: str): bool {
    while item in &self {
        if item.as_str() == name { return true }
    }
    return false
}

/// `redundant_cast`: `x as T` where `x` is a `T` already.
pub fun check_redundant_cast(at: Span, from: &Type, to: &Type, walk: &var TypedWalk): void {
    val code = primitive_code(from)
    if code < 0 || code != primitive_code(to) { return }
    walk.found.push(lint_at("redundant_cast", at, String.from("this value already has the type it is cast to")))
}

/// `float_equality`: `==` or `!=` on floats, which rounding makes unreliable.
/// Comparing with zero is exact, and left alone.
pub fun check_float_equality(at: Span, op: &BinOp, on_floats: bool, with_zero: bool, walk: &var TypedWalk): void {
    val equality = when (op) {
        Eq => true
        NotEq => true
        _ => false
    }
    if !equality || !on_floats || with_zero { return }
    walk.found.push(lint_at("float_equality", at,
        String.from("floats compared for equality; compare their difference with a tolerance")))
}

/// A number for each primitive type, or -1 for any other.
fun primitive_code(ty: &Type): int32 {
    return when (ty.kind) {
        Int8 => 1
        Int16 => 2
        Int32 => 3
        Int64 => 4
        UInt8 => 5
        UInt16 => 6
        UInt32 => 7
        UInt64 => 8
        Float32 => 9
        Float64 => 10
        Bool => 11
        Char => 12
        _ => -1
    }
}
