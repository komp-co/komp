// The lexer's contract is the shape it emits: a parenthesised chain.

import core.assert.ptr_is_null
import core.assert.assert_eq
import alloc.list.*

fun literal_parts(toks: &List<Token>): String {
    var out = String.from("")
    var first = true
    while t in &toks {
        when (t.kind) {
            StringLiteral(s) => {
                if !first { out.append("|") }
                first = false
                out.append(s.as_str())
            }
            _ => { }
        }
    }
    return out
}

fun ident_trail(toks: &List<Token>): String {
    var out = String.from("")
    while t in &toks {
        when (t.kind) {
            Identifier(sym) => {
                out.append(sym.as_str())
                out.append(".")
            }
            _ => { }
        }
    }
    return out
}

@test fun a_multiline_slot_expands_to_the_concatenation(): void {
    // Source: """a ${x}
    // b"""
    val toks = tokenize("\"\"\"a \${x}\nb\"\"\"", 1)
    assert_eq(literal_parts(&toks).as_str(), "a |\nb", "the segments either side of the slot, newline kept")
    assert_eq((ident_trail(&toks).as_str()).contains("lang::string.from.lang::string.of.x."), true,
        "a `from` segment on the lang string, then its `of` over the slot expression")
}

// Only `${` is special; other backslashes stay.
@test fun a_multiline_slot_leaves_other_escapes_alone(): void {
    // Source: """x\ny ${v}"""   (backslash-n typed literally)
    val toks = tokenize("\"\"\"x\\ny \${v}\"\"\"", 1)
    assert_eq(literal_parts(&toks).as_str(), "x\\ny ", "the backslash-n is two content bytes, not a newline")
}

@test fun a_multiline_escaped_dollar_is_literal(): void {
    val toks = tokenize("\"\"\"\\\${a} and \${b}\"\"\"", 1)
    assert_eq(literal_parts(&toks).as_str(), "\${a} and ", "the escaped slot is content; the other one opens")
    assert_eq((ident_trail(&toks).as_str()).contains("b."), true, "only the unescaped slot becomes an expression")
}

// `\$` reduces even without a slot.
@test fun an_escaped_dollar_reduces_without_any_slot(): void {
    val toks = tokenize("\"\"\"\\\${a}\"\"\"", 1)
    assert_eq(toks.size(), 2, "no slot, so still one literal token")
    assert_eq(literal_parts(&toks).as_str(), "\${a}", "the escape is consumed")
}

@test fun a_multiline_without_a_slot_is_still_one_token(): void {
    val toks = tokenize("\"\"\"a\nb\"\"\"", 1)
    assert_eq(toks.size(), 2, "one StringLiteral + EOF")
    assert_eq(literal_parts(&toks).as_str(), "a\nb", "content unchanged")
}

// Three quotes close the literal, so a leading quote is content, after a slot
// too.
@test fun a_multiline_slot_keeps_the_four_quote_rule(): void {
    val toks = tokenize("\"\"\"say \"hi\" to \${w}\"\"\"", 1)
    assert_eq(literal_parts(&toks).as_str(), "say \"hi\" to ", "the bare quotes are content")
}
