// The punctuation table. To add an operator: a variant, its spelling in
// `op_str`, an entry in `operator_at`, and its bytes in `read_operator`.
// `every_operator_round_trips_through_its_spelling` catches a mismatch.

/// One variant per syntactic token; spellings live in `op_str`.
pub enum Operator {
    Plus
    Minus
    Star
    Slash
    Eq
    EqEq
    BangEq
    Lt
    Gt
    LtEq
    GtEq
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Comma
    Colon
    Dot
    DotDot
    /// `a..=b`: one token, so it cannot be read as an assignment to a range.
    DotDotEq
    /// The when-arm arrow `=>`.
    Arrow
    Amp
    AmpAmp
    Pipe
    PipePipe
    Caret
    Percent
    /// `>>` is not a token: it stays two `Gt` so nested generics close, and
    /// `peek_binop` recombines them.
    Shl
    Bang
    Semicolon
    Question
    Elvis
    At
    /// `opt!!`. Two characters, so a panic is greppable and never confused
    /// with `!` or `!=`.
    BangBang
    /// `opt?.field`, `opt?.method(args)`. One token, unlike `(a?).b`.
    SafeCall
}

/// The one place an operator's spelling is written. The editor-grammar
/// generator in komp-co/kf-extensions reads these arms.
pub fun op_str(o: Operator): str {
    return when (o) {
        Plus => "+"
        Minus => "-"
        Star => "*"
        Slash => "/"
        Eq => "="
        EqEq => "=="
        BangEq => "!="
        Lt => "<"
        Gt => ">"
        LtEq => "<="
        GtEq => ">="
        LParen => "("
        RParen => ")"
        LBrace => "{"
        RBrace => "}"
        LBracket => "["
        RBracket => "]"
        Comma => ","
        Colon => ":"
        Dot => "."
        DotDot => ".."
        DotDotEq => "..="
        Arrow => "=>"
        Amp => "&"
        AmpAmp => "&&"
        Pipe => "|"
        PipePipe => "||"
        Caret => "^"
        Percent => "%"
        Shl => "<<"
        Bang => "!"
        Semicolon => ";"
        Question => "?"
        Elvis => "?:"
        At => "@"
        BangBang => "!!"
        SafeCall => "?."
    }
}

/// Ordinal to operator, `null` past the end: kf cannot enumerate an enum's
/// variants.
pub fun operator_at(i: uint64): Operator? {
    return when (i) {
        0 => Operator.Plus
        1 => Operator.Minus
        2 => Operator.Star
        3 => Operator.Slash
        4 => Operator.Eq
        5 => Operator.EqEq
        6 => Operator.BangEq
        7 => Operator.Lt
        8 => Operator.Gt
        9 => Operator.LtEq
        10 => Operator.GtEq
        11 => Operator.LParen
        12 => Operator.RParen
        13 => Operator.LBrace
        14 => Operator.RBrace
        15 => Operator.LBracket
        16 => Operator.RBracket
        17 => Operator.Comma
        18 => Operator.Colon
        19 => Operator.Dot
        20 => Operator.DotDot
        21 => Operator.DotDotEq
        22 => Operator.Arrow
        23 => Operator.Amp
        24 => Operator.AmpAmp
        25 => Operator.Pipe
        26 => Operator.PipePipe
        27 => Operator.Caret
        28 => Operator.Percent
        29 => Operator.Shl
        30 => Operator.Bang
        31 => Operator.Semicolon
        32 => Operator.Question
        33 => Operator.Elvis
        34 => Operator.At
        35 => Operator.BangBang
        36 => Operator.SafeCall
        _ => null
    }
}

impl Lexer {
    // Longest match first.
    pub mutating fun read_operator(): Operator? {
        val b: uint8 = self.peek()
        val b2: uint8 = self.peek_at(1)

        if b == 61 && b2 == 61 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.EqEq
        }
        if b == 33 && b2 == 61 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.BangEq
        }
        // `!!` before `!`. `a!!=b` reads as `a!! = b`.
        if b == 33 && b2 == 33 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.BangBang
        }
        if b == 60 && b2 == 61 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.LtEq
        }
        if b == 62 && b2 == 61 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.GtEq
        }
        // `=>` (bytes 61, 62).
        if b == 61 && b2 == 62 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.Arrow
        }
        // `&&` and `||` before `&` and `|`.
        if b == 38 && b2 == 38 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.AmpAmp
        }
        if b == 124 && b2 == 124 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.PipePipe
        }
        // `<<` before `<`.
        if b == 60 && b2 == 60 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.Shl
        }
        // `..=` before `..`.
        if b == 46 && b2 == 46 && self.peek_at(2) == 61 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.DotDotEq
        }
        // `..` before `.`.
        if b == 46 && b2 == 46 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.DotDot
        }

        if b == 43 {
            unsafe { self.advance() }
            return Operator.Plus
        }
        if b == 45 {
            unsafe { self.advance() }
            return Operator.Minus
        }
        if b == 42 {
            unsafe { self.advance() }
            return Operator.Star
        }
        if b == 47 {
            unsafe { self.advance() }
            return Operator.Slash
        }
        if b == 61 {
            unsafe { self.advance() }
            return Operator.Eq
        }
        if b == 60 {
            unsafe { self.advance() }
            return Operator.Lt
        }
        if b == 62 {
            unsafe { self.advance() }
            return Operator.Gt
        }
        if b == 40 {
            unsafe { self.advance() }
            return Operator.LParen
        }
        if b == 41 {
            unsafe { self.advance() }
            return Operator.RParen
        }
        if b == 123 {
            unsafe { self.advance() }
            return Operator.LBrace
        }
        if b == 125 {
            unsafe { self.advance() }
            return Operator.RBrace
        }
        if b == 91 {
            unsafe { self.advance() }
            return Operator.LBracket
        }
        if b == 93 {
            unsafe { self.advance() }
            return Operator.RBracket
        }
        if b == 44 {
            unsafe { self.advance() }
            return Operator.Comma
        }
        if b == 58 {
            unsafe { self.advance() }
            return Operator.Colon
        }
        if b == 46 {
            unsafe { self.advance() }
            return Operator.Dot
        }
        if b == 38 {
            unsafe { self.advance() }
            return Operator.Amp
        }
        if b == 124 {
            unsafe { self.advance() }
            return Operator.Pipe
        }
        if b == 94 {
            unsafe { self.advance() }
            return Operator.Caret
        }
        if b == 37 {
            unsafe { self.advance() }
            return Operator.Percent
        }
        if b == 33 {
            unsafe { self.advance() }
            return Operator.Bang
        }
        if b == 59 {
            unsafe { self.advance() }
            return Operator.Semicolon
        }
        // `?:` before `?`.
        if b == 63 && b2 == 58 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.Elvis
        }
        // `?.` before `?`. Only when adjacent: `? .` is two tokens.
        if b == 63 && b2 == 46 {
            unsafe { self.advance() }
            unsafe { self.advance() }
            return Operator.SafeCall
        }
        if b == 63 {
            unsafe { self.advance() }
            return Operator.Question
        }
        if b == 64 {
            unsafe { self.advance() }
            return Operator.At
        }

        return null
    }
}
