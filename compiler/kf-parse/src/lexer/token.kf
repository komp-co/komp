import kf_core.span.*
import kf_core.ast.Sym

// CONSTRAINT: TokenKind and Token share this file so their typedefs are
// emitted in source order.

/// A LexError carries a message the parser reports, so a bad byte does not
/// abort the compilation.
pub enum TokenKind {
    KeywordTok(Keyword)
    /// Interned: one allocation per distinct name.
    Identifier(Sym)
    Op(Operator)
    IntLiteral(int64)
    /// Carried as its spelling, which codegen writes verbatim.
    FloatLiteral(String)
    CharLiteral(uint32)
    StringLiteral(String)
    Newline
    Eof
    LexError(String)
}

pub struct Token {
    pub val kind: TokenKind
    pub val span: Span
}

pub fun new_token(kind: TokenKind, span: Span): Token {
    return Token { kind: kind, span: span }
}
