import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern

/// Tokenizer. Errors become `LexError` tokens, which the parser reports.
pub struct Lexer {
    pub var src:     String
    pub var len:     uint64
    pub var pos:     uint64
    pub var file_id: uint32
}

pub fun new_lexer(src: str, file_id: uint32): Lexer {
    val n: uint64 = src.byte_len()
    return Lexer { src: String.from(src), len: n, pos: 0, file_id: file_id }
}

impl Lexer {
    pub fun peek(): uint8 {
        if self.pos >= self.len {
            return 0
        }
        return self.src.as_str().byte_at(self.pos)
    }

    pub fun peek_at(offset: uint64): uint8 {
        val p: uint64 = self.pos + offset
        if p >= self.len {
            return 0
        }
        return self.src.as_str().byte_at(p)
    }

    pub fun at_end(): bool {
        return self.pos >= self.len
    }

    pub mutating fun advance(): uint8 {
        val b: uint8 = self.peek()
        self.pos = self.pos + 1
        return b
    }

    pub mutating fun skip_inline_whitespace(): void {
        while !(self.at_end()) {
            val b: uint8 = self.peek()
            if b == 32 || b == 9 {
                self.pos = self.pos + 1
            } else {
                return
            }
        }
    }

    /// Skips a `//` or `///` comment up to, not including, the newline.
    /// False if there was none.
    pub mutating fun skip_line_comment(): bool {
        if self.at_end() {
            return false
        }
        val b0: uint8 = self.peek()
        val b1: uint8 = self.peek_at(1)
        if b0 != 47 || b1 != 47 {
            return false
        }
        while !(self.at_end()) && self.peek() != 10 {
            self.pos = self.pos + 1
        }
        return true
    }

    mutating fun next_token(): Token {
        val fid: uint32 = self.file_id
        val start: uint32 = self.pos as uint32
        val b: uint8 = self.peek()

        if b == 10 {
            unsafe { self.advance() }
            val nl_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            return new_token(TokenKind.Newline, nl_span)
        }

        if is_ident_start(b) {
            return self.read_ident_or_keyword(start)
        }

        if is_digit(b) {
            return self.read_number(start)
        }

        if b == 39 {
            return self.read_char(start)
        }

        if b == 34 {
            if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
                return self.read_multiline_string(start)
            }
            return self.read_string(start)
        }

        return self.read_operator_or_error(start, b)
    }

    mutating fun read_ident_or_keyword(start: uint32): Token {
        val fid: uint32 = self.file_id
        while !(self.at_end()) && is_ident_continue(self.peek()) {
            unsafe { self.advance() }
        }
        val end: uint32 = self.pos as uint32
        val lex_str = slice_to_string(self.src.as_str(), start, end)
        val span = Span { file_id: fid, start: start, end: end }
        // CONSTRAINT: one return, so `lex_str` reaches the end of scope and is
        // dropped; returning from the arms skips its drop.
        val kind = when (keyword_from_str(lex_str.as_str())) {
            Some(kw) => TokenKind.KeywordTok(kw)
            None => TokenKind.Identifier(intern(lex_str.as_str()))
        }
        return new_token(kind, span)
    }

    mutating fun read_number(start: uint32): Token {
        if self.peek() == 48 {
            val marker: uint8 = self.peek_at(1)
            if marker == 120 || marker == 88 { return self.read_radix_int(start, 16) }
            if marker == 98 || marker == 66 { return self.read_radix_int(start, 2) }
        }
        return self.read_decimal_number(start)
    }

    mutating fun read_radix_int(start: uint32, radix: int64): Token {
        val fid: uint32 = self.file_id
        unsafe { self.advance() }
        unsafe { self.advance() }
        var v = 0
        var digits: uint64 = 0
        while !(self.at_end()) {
            val b: uint8 = self.peek()
            if b == 95 {
                if digit_value(self.peek_at(1), radix) < 0 { break }
                unsafe { self.advance() }
            } else {
                val d: int64 = digit_value(b, radix)
                if d < 0 { break }
                v = v * radix + d
                digits = digits + 1
                unsafe { self.advance() }
            }
        }
        val end: uint32 = self.pos as uint32
        val span = Span { file_id: fid, start: start, end: end }
        if digits == 0 {
            var msg = String.from("expected at least one digit after `")
            val prefix = slice_to_string(self.src.as_str(), start, start + 2)
            msg.append(prefix.as_str())
            msg.append("`")
            return new_token(TokenKind.LexError(msg), span)
        }
        return new_token(TokenKind.IntLiteral(v), span)
    }

    mutating fun read_decimal_number(start: uint32): Token {
        val fid: uint32 = self.file_id
        val v: int64 = self.read_decimal_digits()
        // A fraction needs a digit after the point, or `5.equals(x)` would
        // start a float.
        val has_fraction = self.peek() == 46 && is_digit(self.peek_at(1))
        if has_fraction {
            unsafe { self.advance() }
            val _frac: int64 = self.read_decimal_digits()
        }
        val has_exponent = self.read_exponent()
        if has_fraction || has_exponent {
            val fend: uint32 = self.pos as uint32
            val fspan = Span { file_id: fid, start: start, end: fend }
            return new_token(TokenKind.FloatLiteral(digits_text(self.src.as_str(), start, fend)), fspan)
        }
        val end: uint32 = self.pos as uint32
        val span = Span { file_id: fid, start: start, end: end }
        return new_token(TokenKind.IntLiteral(v), span)
    }

    /// `e` or `E`, an optional sign, then digits. Taken only when a digit
    /// follows, so `1e` stays `1` and the name `e`.
    mutating fun read_exponent(): bool {
        val marker: uint8 = self.peek()
        if marker != 101 && marker != 69 { return false }
        val sign: uint8 = self.peek_at(1)
        val signed = sign == 43 || sign == 45
        val first_digit: uint8 = if signed { self.peek_at(2) } else { sign }
        if !is_digit(first_digit) { return false }
        self.advance_n(if signed { 2 } else { 1 })
        val _exponent: int64 = self.read_decimal_digits()
        return true
    }

    mutating fun read_decimal_digits(): int64 {
        var v: int64 = 0
        while !(self.at_end()) {
            val b: uint8 = self.peek()
            if b == 95 {
                if !is_digit(self.peek_at(1)) { break }
                unsafe { self.advance() }
            } else {
                if !is_digit(b) { break }
                v = v * 10 + ((b - 48) as int64)
                unsafe { self.advance() }
            }
        }
        return v
    }

    mutating fun read_char(start: uint32): Token {
        val fid: uint32 = self.file_id
        unsafe { self.advance() }
        if self.at_end() {
            val eof_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            return new_token(TokenKind.LexError(String.from("unterminated char literal")), eof_span)
        }
        var scalar = 0
        if self.peek() == 92 {
            // The same decoder a string uses, so both accept the same escapes.
            val src = self.src.as_str()
            val esc = decode_escape(src, self.pos, src.byte_len())
            if esc.width == 0 {
                val bad_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
                return new_token(TokenKind.LexError(String.from("unknown escape in char literal")), bad_span)
            }
            var consumed = 0
            while consumed < esc.width + 1 {
                unsafe { self.advance() }
                consumed = consumed + 1
            }
            scalar = esc.value as uint32
        } else {
            scalar = self.read_utf8_scalar()
        }
        if self.peek() != 39 {
            val bad_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            if self.at_end() || self.peek() == 10 {
                return new_token(TokenKind.LexError(String.from("unterminated char literal")), bad_span)
            }
            return new_token(TokenKind.LexError(String.from("a char literal holds exactly one character")), bad_span)
        }
        unsafe { self.advance() }
        val end: uint32 = self.pos as uint32
        val span = Span { file_id: fid, start: start, end: end }
        return new_token(TokenKind.CharLiteral(scalar), span)
    }

    /// Decodes one UTF-8 sequence through `core.utf8` and advances past it.
    /// A malformed sequence yields whatever was read; the closing-`'` test
    /// that follows rejects it with a span.
    mutating fun read_utf8_scalar(): uint32 {
        val d = self.src.as_str().decode_at(self.pos)
        self.pos = self.pos + d.width
        return d.scalar as uint32
    }

    mutating fun read_string(start: uint32): Token {
        val fid: uint32 = self.file_id
        unsafe { self.advance() }
        val content_start: uint32 = self.pos as uint32
        while !(self.at_end()) && self.peek() != 34 {
            // `\"` does not end the string.
            val is_escape: bool = self.peek() == 92
            unsafe { self.advance() }
            if is_escape && !(self.at_end()) {
                unsafe { self.advance() }
            }
        }
        val content_end: uint32 = self.pos as uint32
        val ended: bool = self.at_end()
        if ended {
            val err_span = Span { file_id: fid, start: start, end: content_end }
            return new_token(TokenKind.LexError(String.from("unterminated string literal")), err_span)
        }
        unsafe { self.advance() }
        val end: uint32 = self.pos as uint32
        val span = Span { file_id: fid, start: start, end: end }
        val bad = literal_bad_escape_at(self.src.as_str(), content_start, content_end)
        if bad >= 0 {
            val bad_span = Span { file_id: fid, start: bad as uint32, end: end }
            return new_token(TokenKind.LexError(String.from("unknown escape in string literal")), bad_span)
        }
        return new_token(TokenKind.StringLiteral(literal_body(self.src.as_str(), content_start, content_end)), span)
    }

    // `"a ${x} b"` expands here into the tokens of the concatenation it means:
    //
    //     (String.from("a ") + String.of(&(x)) + String.from(" b"))
    //
    // with `String` a placeholder the type checker names. A slot's own tokens
    // come from the ordinary lexer, so it may hold any expression.
    //
    // CONSTRAINT: slots go through `String.of`, not a method on the value, so
    // the desugaring does not fix what `Display` looks like. The slot is
    // borrowed.

    /// One token for a string without slots, the whole concatenation for one
    /// with. False, position untouched, if this is not such a string.
    mutating fun push_interpolated(toks: &var List<Token>): bool {
        if self.peek() != 34 { return false }
        if self.peek_at(1) == 34 && self.peek_at(2) == 34 {
            if !self.multiline_has_slot() { return false }
            return self.push_interpolated_multiline(toks)
        }
        val start: uint32 = self.pos as uint32
        if !self.string_has_slot() {
            toks.push(self.read_string(start))
            return true
        }
        unsafe { self.advance() }
        val fid: uint32 = self.file_id
        self.push_op(toks, Operator.LParen)
        var seg_start: uint32 = self.pos as uint32
        var first: bool = true
        while !(self.at_end()) && self.peek() != 34 {
            if self.at_slot_open() {
                val seg_end: uint32 = self.pos as uint32
                self.push_segment(toks, seg_start, seg_end, &var first)
                unsafe { self.advance() }
                unsafe { self.advance() }
                self.push_slot_expr(toks)
                seg_start = self.pos as uint32
            } else {
                // `\"` does not end the string; `\${` is a literal dollar-brace.
                val is_escape: bool = self.peek() == 92
                unsafe { self.advance() }
                if is_escape && !(self.at_end()) { unsafe { self.advance() } }
            }
        }
        if self.at_end() {
            val err_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            toks.push(new_token(TokenKind.LexError(String.from("unterminated string literal")), err_span))
            return true
        }
        val tail_end: uint32 = self.pos as uint32
        unsafe { self.advance() }
        // A string that is nothing but slots still needs one string operand.
        if tail_end > seg_start || first {
            self.push_segment(toks, seg_start, tail_end, &var first)
        }
        self.push_op(toks, Operator.RParen)
        return true
    }

    /// Pure lookahead for a `${`.
    mutating fun string_has_slot(): bool {
        var i = 1
        while self.peek_at(i) != 0 {
            val b: uint8 = self.peek_at(i)
            if b == 34 { return false }
            if b == 92 {
                i = i + 2
            } else {
                if b == 36 && self.peek_at(i + 1) == 123 { return true }
                i = i + 1
            }
        }
        return false
    }

    pub mutating fun at_slot_open(): bool {
        if self.peek() != 36 { return false }
        return self.peek_at(1) == 123
    }

    /// `<lang string>.from("<literal>")`, joined with `+`.
    mutating fun push_segment(toks: &var List<Token>, from: uint32, to: uint32, first: &var bool): void {
        if !(*first) { self.push_op(toks, Operator.Plus) }
        (*first) = false
        val sp = self.here()
        toks.push(lang_string_token(sp))
        self.push_op(toks, Operator.Dot)
        toks.push(new_token(TokenKind.Identifier(intern("from")), sp))
        self.push_op(toks, Operator.LParen)
        if literal_bad_escape_at(self.src.as_str(), from, to) >= 0 {
            toks.push(new_token(TokenKind.LexError(String.from("unknown escape in string literal")), sp))
        } else {
            toks.push(new_token(TokenKind.StringLiteral(literal_body(self.src.as_str(), from, to)), sp))
        }
        self.push_op(toks, Operator.RParen)
    }

    /// `<lang string>.of(&(<slot tokens>))`, through the closing `}`.
    pub mutating fun push_slot_expr(toks: &var List<Token>): void {
        self.push_op(toks, Operator.Plus)
        toks.push(lang_string_token(self.here()))
        self.push_op(toks, Operator.Dot)
        toks.push(new_token(TokenKind.Identifier(intern("of")), self.here()))
        self.push_op(toks, Operator.LParen)
        self.push_op(toks, Operator.Amp)
        self.push_op(toks, Operator.LParen)
        var depth = 0
        var closed: bool = false
        while !(self.at_end()) && !closed {
            self.skip_inline_whitespace()
            if self.at_end() { break }
            if self.peek() == 125 && depth == 0 {
                unsafe { self.advance() }
                closed = true
            } else if !self.push_interpolated(toks) {
                val t = self.next_token()
                when (t.kind) {
                    Op(o) => {
                        when (o) {
                            LBrace => { depth = depth + 1 }
                            RBrace => { depth = depth - 1 }
                            _ => { }
                        }
                    }
                    _ => { }
                }
                toks.push(t)
            }
        }
        self.push_op(toks, Operator.RParen)
        self.push_op(toks, Operator.RParen)
    }

    /// Synthesized tokens keep the position they came from, so diagnostics
    /// inside an interpolation point into the literal.
    pub mutating fun here(): Span {
        val p: uint32 = self.pos as uint32
        return Span { file_id: self.file_id, start: p, end: p }
    }

    pub mutating fun push_op(toks: &var List<Token>, o: Operator): void {
        toks.push(new_token(TokenKind.Op(o), self.here()))
    }

    /// `"""..."""`: every byte between the delimiters is content, raw. The
    /// token carries the bytes as they are; codegen spells them for C.
    mutating fun read_multiline_string(start: uint32): Token {
        val fid: uint32 = self.file_id
        unsafe { self.advance() }
        unsafe { self.advance() }
        unsafe { self.advance() }
        val content_start: uint32 = self.pos as uint32
        var content_end: uint32 = content_start
        var closed: bool = false
        while !(self.at_end()) && !closed {
            if self.peek() == 34 {
                // Four or more quotes end with the delimiter; the leading ones
                // are content.
                val run = self.quote_run_len()
                if run >= 3 {
                    content_end = (self.pos as uint32) + (run - 3)
                    self.advance_n(run as uint64)
                    closed = true
                } else {
                    self.advance_n(run as uint64)
                }
            } else {
                unsafe { self.advance() }
            }
        }
        if !closed {
            val err_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            return new_token(TokenKind.LexError(String.from("unterminated multiline string literal (no closing `\"\"\"`)")), err_span)
        }
        val span = Span { file_id: fid, start: start, end: self.pos as uint32 }
        // `\$` reduces to `$` here too, so a literal `${` is spelled the same
        // with or without slots.
        val body = raw_literal_body(self.src.as_str(), content_start, content_end)
        return new_token(TokenKind.StringLiteral(body), span)
    }

    pub mutating fun quote_run_len(): uint32 {
        var n: uint32 = 0
        while self.peek_at(n as uint64) == 34 { n = n + 1 }
        return n
    }

    pub mutating fun advance_n(n: uint64): void {
        var i = 0
        while i < n {
            unsafe { self.advance() }
            i = i + 1
        }
    }

    mutating fun read_operator_or_error(start: uint32, b: uint8): Token {
        val fid: uint32 = self.file_id
        val op_opt = self.read_operator()
        when (op_opt) {
            Some(o) => {
                val end: uint32 = self.pos as uint32
                val span = Span { file_id: fid, start: start, end: end }
                return new_token(TokenKind.Op(o), span)
            }
            None => {
                unsafe { self.advance() }
                val end: uint32 = self.pos as uint32
                val span = Span { file_id: fid, start: start, end: end }
                return new_token(TokenKind.LexError(build_unexpected_byte_msg(b)), span)
            }
        }
    }
}

/// Tokens plus the comment extents the compiler discards. Comments are kept
/// beside the stream, not as a TokenKind, so the parser's arm lists need no
/// case for them. Both lists are in source order.
pub struct TokenizeResult {
    pub val toks: List<Token>
    pub val comments: List<Span>
}

/// The compiler's entry point: comments discarded.
pub fun tokenize(source: str, file_id: uint32): List<Token> {
    var sink = List.new<Span>()
    return tokenize_inner(source, file_id, &var sink, false)
}

/// For tooling: the same tokens, plus every `//` comment's extent from the
/// first `/` to before the newline.
pub fun tokenize_with_comments(source: str, file_id: uint32): TokenizeResult {
    var comments = List.new<Span>()
    val toks = tokenize_inner(source, file_id, &var comments, true)
    return TokenizeResult { toks: toks, comments: comments }
}

fun tokenize_inner(source: str, file_id: uint32, comments: &var List<Span>, keep_comments: bool): List<Token> {
    var l = new_lexer(source, file_id)
    var toks = List.new<Token>()
    var done: bool = false
    while !done {
        l.skip_inline_whitespace()
        var comment_start: uint32 = l.pos as uint32
        var skipped: bool = l.skip_line_comment()
        while skipped {
            if keep_comments {
                comments.push(Span { file_id: file_id, start: comment_start, end: l.pos as uint32 })
            }
            l.skip_inline_whitespace()
            comment_start = l.pos as uint32
            skipped = l.skip_line_comment()
        }
        if l.at_end() {
            done = true
        } else if !l.push_interpolated(&var toks) {
            toks.push(l.next_token())
        }
    }
    val pos_end: uint32 = l.pos as uint32
    val eof_span = Span { file_id: file_id, start: pos_end, end: pos_end }
    toks.push(new_token(TokenKind.Eof, eof_span))
    return toks
}

fun digit_value(b: uint8, radix: int64): int64 {
    var v = -1
    if b >= 48 && b <= 57 { v = (b - 48) as int64 }
    if b >= 97 && b <= 102 { v = ((b - 97) as int64) + 10 }
    if b >= 65 && b <= 70 { v = ((b - 65) as int64) + 10 }
    if v >= radix { return -1 }
    return v
}

fun digits_text(src: str, from: uint32, to: uint32): String {
    var out = ""
    var seg: uint32 = from
    var i: uint32 = from
    while i < to {
        if src.byte_at(i as uint64) == 95 {
            val chunk = slice_to_string(src, seg, i)
            out.append(chunk.as_str())
            seg = i + 1
        }
        i = i + 1
    }
    val tail = slice_to_string(src, seg, to)
    out.append(tail.as_str())
    return out
}

/// Where the first undecodable escape starts in the source, or -1.
///
/// CONSTRAINT: separate from `literal_body`. A String returned inside a
/// struct and read out of its field does not survive the trip.
fun literal_bad_escape_at(src: str, from: uint32, to: uint32): int64 {
    var i: uint64 = from as uint64
    val end: uint64 = to as uint64
    while i < end {
        if src.byte_at(i) != 92 {
            i = i + 1
        } else {
            val esc = decode_escape(src, i, end)
            if esc.width == 0 { return i as int64 }
            i = i + 1 + esc.width
        }
    }
    return 0 - 1
}

/// The bytes the literal denotes, escapes decoded. Callers check
/// `literal_bad_escape_at` first.
fun literal_body(src: str, from: uint32, to: uint32): String {
    var out = String.from("")
    var i: uint64 = from as uint64
    val end: uint64 = to as uint64
    while i < end {
        val b: uint8 = src.byte_at(i)
        if b != 92 {
            out.push_byte(b)
            i = i + 1
        } else {
            val esc = decode_escape(src, i, end)
            if esc.width == 0 { return out }
            out.push_byte(esc.value)
            i = i + 1 + esc.width
        }
    }
    return out
}

fun build_unexpected_byte_msg(b: uint8): String {
    // Printable ASCII shows itself; anything else is shown numerically.
    if b >= 33 {
        if b <= 126 {
            val buf: Ptr<uint8> = unsafe { alloc_array<uint8>(2) }
            unsafe { *buf = b }
            unsafe { *(buf + 1) = 0 as uint8 }
            val cmsg = "unexpected character `${unsafe { buf as str }}`"
            return cmsg
        }
    }
    var msg = String.from("unexpected byte ")
    msg.append(String.of(&((b as int64))))
    return msg
}

fun is_digit(b: uint8): bool {
    return b >= 48 && b <= 57
}

fun is_ident_start(b: uint8): bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fun is_ident_continue(b: uint8): bool {
    return is_ident_start(b) || is_digit(b)
}

fun slice_to_string(s: str, start: uint32, end: uint32): String {
    return s.substring(start as uint64, end as uint64)
}
