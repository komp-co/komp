import core.assert.assert_eq
import core.assert.fail
import core.assert.assert

@test fun lexes_simple_identifier(): void {
    val toks = tokenize("add", 1)
    assert_eq(toks.size(), 2, "token count")
    when (unsafe { toks.at(0).kind }) {
        Identifier(s) => assert_eq(s.as_str(), "add", "identifier text")
        KeywordTok(_) => fail("expected Identifier, got KeywordTok")
        Op(_) => fail("expected Identifier, got Op")
        IntLiteral(_) => fail("expected Identifier, got IntLiteral")
        StringLiteral(_) => fail("expected Identifier, got StringLiteral")
        FloatLiteral(_) => fail("expected Identifier, got FloatLiteral")
        CharLiteral(_) => fail("expected Identifier, got CharLiteral")
        Newline => fail("expected Identifier, got Newline")
        Eof => fail("expected Identifier, got Eof")
        LexError(_) => fail("expected Identifier, got LexError")
    }
}

@test fun tokenize_empty_emits_only_eof(): void {
    val toks = tokenize("", 1)
    assert_eq(toks.size(), 1, "single EOF token")
}

@test fun tokenize_one_keyword_emits_two_tokens(): void {
    val toks = tokenize("fun", 1)
    assert_eq(toks.size(), 2, "keyword + EOF")
}

// An escaped quote does not end the string.
@test fun tokenize_string_with_escaped_quote(): void {
    val toks = tokenize("\"a\\\"b\"", 1)
    assert_eq(toks.size(), 2, "StringLiteral + EOF (the escaped quote does not end the string)")
    when (unsafe { toks.at(0).kind }) {
        StringLiteral(s) => assert_eq(s.as_str(), "a\"b", "the content is decoded")
        Identifier(_) => fail("expected StringLiteral, got Identifier")
        FloatLiteral(_) => fail("expected StringLiteral, got FloatLiteral")
        CharLiteral(_) => fail("expected StringLiteral, got CharLiteral")
        KeywordTok(_) => fail("expected StringLiteral, got KeywordTok")
        Op(_) => fail("expected StringLiteral, got Op")
        IntLiteral(_) => fail("expected StringLiteral, got IntLiteral")
        Newline => fail("expected StringLiteral, got Newline")
        Eof => fail("expected StringLiteral, got Eof")
        LexError(_) => fail("expected StringLiteral, got LexError")
    }
}

@test fun tokenize_keyword_recognized(): void {
    val toks = tokenize("fun", 1)
    when (unsafe { toks.at(0).kind }) {
        KeywordTok(kw) => assert_eq(is_fun_keyword(kw), true, "first token is Fun")
        Identifier(_) => fail("expected KeywordTok, got Identifier")
        Op(_) => fail("expected KeywordTok, got Op")
        IntLiteral(_) => fail("expected KeywordTok, got IntLiteral")
        StringLiteral(_) => fail("expected KeywordTok, got StringLiteral")
        FloatLiteral(_) => fail("expected KeywordTok, got FloatLiteral")
        CharLiteral(_) => fail("expected KeywordTok, got CharLiteral")
        Newline => fail("expected KeywordTok, got Newline")
        Eof => fail("expected KeywordTok, got Eof")
        LexError(_) => fail("expected KeywordTok, got LexError")
    }
}

// `=>` is one Arrow token.
@test fun tokenize_fat_arrow_is_single_arrow_op(): void {
    val toks = tokenize("=>", 1)
    assert_eq(toks.size(), 2, "Arrow + EOF (not Eq, Gt, EOF)")
    when (unsafe { toks.at(0).kind }) {
        Op(o) => assert_eq(is_arrow_op(o), true, "first token is Arrow")
        Identifier(_) => fail("expected Op, got Identifier")
        KeywordTok(_) => fail("expected Op, got KeywordTok")
        IntLiteral(_) => fail("expected Op, got IntLiteral")
        StringLiteral(_) => fail("expected Op, got StringLiteral")
        FloatLiteral(_) => fail("expected Op, got FloatLiteral")
        CharLiteral(_) => fail("expected Op, got CharLiteral")
        Newline => fail("expected Op, got Newline")
        Eof => fail("expected Op, got Eof")
        LexError(_) => fail("expected Op, got LexError")
    }
}

// `&&` and `||` are each one token.
@test fun tokenize_logical_and_is_single_op(): void {
    val toks = tokenize("&&", 1)
    assert_eq(toks.size(), 2, "AmpAmp + EOF (not Amp, Amp, EOF)")
    when (unsafe { toks.at(0).kind }) {
        Op(o) => assert_eq(is_ampamp_op(o), true, "first token is AmpAmp")
        Identifier(_) => fail("expected Op, got Identifier")
        KeywordTok(_) => fail("expected Op, got KeywordTok")
        IntLiteral(_) => fail("expected Op, got IntLiteral")
        StringLiteral(_) => fail("expected Op, got StringLiteral")
        FloatLiteral(_) => fail("expected Op, got FloatLiteral")
        CharLiteral(_) => fail("expected Op, got CharLiteral")
        Newline => fail("expected Op, got Newline")
        Eof => fail("expected Op, got Eof")
        LexError(_) => fail("expected Op, got LexError")
    }
}

@test fun tokenize_logical_or_is_single_op(): void {
    val toks = tokenize("||", 1)
    assert_eq(toks.size(), 2, "PipePipe + EOF (not LexError)")
    when (unsafe { toks.at(0).kind }) {
        Op(o) => assert_eq(is_pipepipe_op(o), true, "first token is PipePipe")
        Identifier(_) => fail("expected Op, got Identifier")
        KeywordTok(_) => fail("expected Op, got KeywordTok")
        IntLiteral(_) => fail("expected Op, got IntLiteral")
        StringLiteral(_) => fail("expected Op, got StringLiteral")
        FloatLiteral(_) => fail("expected Op, got FloatLiteral")
        CharLiteral(_) => fail("expected Op, got CharLiteral")
        Newline => fail("expected Op, got Newline")
        Eof => fail("expected Op, got Eof")
        LexError(_) => fail("expected Op, got LexError")
    }
}

fun is_ampamp_op(o: Operator): bool {
    when (o) {
        AmpAmp => return true
        _ => return false
    }
}

fun is_pipepipe_op(o: Operator): bool {
    when (o) {
        PipePipe => return true
        _ => return false
    }
}

fun is_arrow_op(o: Operator): bool {
    when (o) {
        Arrow => return true
        _ => return false
    }
}

// kf_parse.parser cannot be imported here without a cycle.
fun is_fun_keyword(k: Keyword): bool {
    when (k) {
        Fun => return true
        Val => return false
        Var => return false
        Return => return false
        If => return false
        Else => return false
        While => return false
        True => return false
        False => return false
        Import => return false
        Pub => return false
        Struct => return false
        Enum => return false
        Impl => return false
        Extern => return false
        When => return false
        Mutating => return false
        Static => return false
        Unsafe => return false
        As => return false
        Break => return false
        Continue => return false
        For => return false
        In => return false
        Trait => return false
        TypeKw => return false
        Dyn => return false
    }
}

fun is_at_op(o: Operator): bool {
    when (o) {
        At => return true
        _ => return false
    }
}

@test fun lexes_at_as_op_at(): void {
    val toks = tokenize("@", 1)
    when (toks.at(0).kind) {
        Op(o) => assert_eq(is_at_op(o), true, "@ lexes as Operator.At")
        _ => assert_eq(false, true, "expected Op(At) for @")
    }
}

fun is_dotdot_op(o: Operator): bool {
    when (o) {
        DotDot => return true
        _ => return false
    }
}

@test fun tokenize_dotdot_is_one_token(): void {
    val toks = tokenize("..", 1)
    assert_eq(toks.size(), 2, "DotDot + EOF")
    when (toks.at(0).kind) {
        Op(o) => assert_eq(is_dotdot_op(o), true, ".. lexes to Op(DotDot)")
        _ => assert_eq(false, true, "expected Op(DotDot) for ..")
    }
}

@test fun tokenize_range_lexes_int_dotdot_int(): void {
    val toks = tokenize("0..3", 1)
    assert_eq(toks.size(), 4, "IntLiteral DotDot IntLiteral EOF")
}

fun is_trait_keyword(k: Keyword): bool {
    when (k) {
        Trait => return true
        _ => return false
    }
}

@test fun tokenize_trait_keyword(): void {
    val toks = tokenize("trait", 1)
    when (toks.at(0).kind) {
        KeywordTok(k) => assert_eq(is_trait_keyword(k), true, "`trait` lexes to Keyword.Trait")
        _ => assert_eq(false, true, "expected KeywordTok(Trait)")
    }
}

@test fun comments_are_captured_for_tooling(): void {
    val r = tokenize_with_comments("// hi\nfun", 1)
    assert_eq(r.comments.size(), 1, "one comment span")
}

@test fun comment_span_starts_at_the_first_slash(): void {
    val r = tokenize_with_comments("val x\n// hi\n", 1)
    val c = r.comments.get(0)
    assert_eq(c.start, 6, "span starts at the `//`, not the line start")
}

@test fun comment_span_stops_before_the_newline(): void {
    val r = tokenize_with_comments("// hi\nfun", 1)
    val c = r.comments.get(0)
    assert_eq(c.end, 5, "span ends after `hi`, leaving the newline its own token")
}

@test fun doc_comments_are_captured_too(): void {
    val r = tokenize_with_comments("/// doc\nfun", 1)
    assert_eq(r.comments.size(), 1, "`///` is a comment, not an operator run")
}

@test fun stacked_comments_are_captured_separately(): void {
    val r = tokenize_with_comments("// one\n// two\nfun", 1)
    assert_eq(r.comments.size(), 2, "one span per comment line")
}

@test fun trailing_comment_after_code_is_captured(): void {
    val r = tokenize_with_comments("fun // tail\n", 1)
    assert_eq(r.comments.size(), 1, "a comment following code on the same line")
}

// The compiler path never sees comments.
@test fun tokenize_still_drops_comments(): void {
    val toks = tokenize("// hi\nfun", 1)
    assert_eq(toks.size(), 3, "Newline + `fun` + EOF, no comment token")
}

@test fun both_entries_agree_on_the_token_stream(): void {
    val r = tokenize_with_comments("// hi\nfun", 1)
    assert_eq(r.toks.size(), tokenize("// hi\nfun", 1).size(), "comment capture does not perturb tokens")
}

fun begins_with_two_slashes(s: str): bool {
    if s.byte_len() < 2 { return false }
    if s.byte_at(0) != 47 { return false }
    return s.byte_at(1) == 47
}

// Every span slices back to real comment text.
@test fun every_comment_span_slices_back_to_comment_text(): void {
    val src: str = "fun f() {\n    val x = 1 // trailing\n    // leading\n}\n/// doc\n"
    val r = tokenize_with_comments(src, 1)
    var all_comments = r.comments.size() == 3
    while c in &r.comments {
        val text = src.substring(c.start as uint64, c.end as uint64)
        if !begins_with_two_slashes(text.as_str()) { all_comments = false }
    }
    assert_eq(all_comments, true, "all three spans slice to text beginning with `//`")
}

// `"""..."""` is one token carrying the literal's own bytes.
@test fun tokenize_multiline_string(): void {
    // Source: """a
    // b"""
    val toks = tokenize("\"\"\"a\nb\"\"\"", 1)
    assert_eq(toks.size(), 2, "one StringLiteral + EOF — the newline is content, not a Newline token")
    when (unsafe { toks.at(0).kind }) {
        StringLiteral(s) => assert_eq(s.as_str(), "a\nb", "the raw newline is content, kept as one byte")
        Identifier(_) => fail("expected StringLiteral, got Identifier")
        FloatLiteral(_) => fail("expected StringLiteral, got FloatLiteral")
        CharLiteral(_) => fail("expected StringLiteral, got CharLiteral")
        KeywordTok(_) => fail("expected StringLiteral, got KeywordTok")
        Op(_) => fail("expected StringLiteral, got Op")
        IntLiteral(_) => fail("expected StringLiteral, got IntLiteral")
        Newline => fail("expected StringLiteral, got Newline")
        Eof => fail("expected StringLiteral, got Eof")
        LexError(_) => fail("expected StringLiteral, got LexError")
    }
}

@test fun tokenize_multiline_string_is_raw(): void {
    // Source: """x\ny"z"""   (backslash-n typed literally)
    val toks = tokenize("\"\"\"x\\ny\"z\"\"\"", 1)
    when (unsafe { toks.at(0).kind }) {
        StringLiteral(s) => assert_eq(s.as_str(), "x\\ny\"z", "the backslash and the quote are content, neither interpreted")
        Identifier(_) => fail("expected StringLiteral, got Identifier")
        FloatLiteral(_) => fail("expected StringLiteral, got FloatLiteral")
        CharLiteral(_) => fail("expected StringLiteral, got CharLiteral")
        KeywordTok(_) => fail("expected StringLiteral, got KeywordTok")
        Op(_) => fail("expected StringLiteral, got Op")
        IntLiteral(_) => fail("expected StringLiteral, got IntLiteral")
        Newline => fail("expected StringLiteral, got Newline")
        Eof => fail("expected StringLiteral, got Eof")
        LexError(_) => fail("expected StringLiteral, got LexError")
    }
}

@test fun tokenize_multiline_string_empty(): void {
    val toks = tokenize("\"\"\"\"\"\"", 1)
    assert_eq(toks.size(), 2, "six quotes are one empty multiline literal")
    when (unsafe { toks.at(0).kind }) {
        StringLiteral(s) => assert_eq(s.as_str(), "", "no content")
        Identifier(_) => fail("expected StringLiteral, got Identifier")
        FloatLiteral(_) => fail("expected StringLiteral, got FloatLiteral")
        CharLiteral(_) => fail("expected StringLiteral, got CharLiteral")
        KeywordTok(_) => fail("expected StringLiteral, got KeywordTok")
        Op(_) => fail("expected StringLiteral, got Op")
        IntLiteral(_) => fail("expected StringLiteral, got IntLiteral")
        Newline => fail("expected StringLiteral, got Newline")
        Eof => fail("expected StringLiteral, got Eof")
        LexError(_) => fail("expected StringLiteral, got LexError")
    }
}

@test fun tokenize_multiline_string_unterminated(): void {
    val toks = tokenize("\"\"\"oops\n", 1)
    when (unsafe { toks.at(0).kind }) {
        LexError(_) => assert(true, "an unclosed multiline literal is a lex error")
        StringLiteral(_) => fail("expected LexError, got StringLiteral")
        FloatLiteral(_) => fail("expected LexError, got FloatLiteral")
        CharLiteral(_) => fail("expected LexError, got CharLiteral")
        Identifier(_) => fail("expected LexError, got Identifier")
        KeywordTok(_) => fail("expected LexError, got KeywordTok")
        Op(_) => fail("expected LexError, got Op")
        IntLiteral(_) => fail("expected LexError, got IntLiteral")
        Newline => fail("expected LexError, got Newline")
        Eof => fail("expected LexError, got Eof")
    }
}

// The closing `"""` is the last three of a run of four.
@test fun tokenize_multiline_string_trailing_quote(): void {
    // Source: """a""""   ->  content is  a"
    val toks = tokenize("\"\"\"a\"\"\"\"", 1)
    assert_eq(toks.size(), 2, "one StringLiteral + EOF — the extra quote does not start a second string")
    when (unsafe { toks.at(0).kind }) {
        StringLiteral(s) => assert_eq(s.as_str(), "a\"", "the leading quote of the run is content")
        Identifier(_) => fail("expected StringLiteral, got Identifier")
        FloatLiteral(_) => fail("expected StringLiteral, got FloatLiteral")
        CharLiteral(_) => fail("expected StringLiteral, got CharLiteral")
        KeywordTok(_) => fail("expected StringLiteral, got KeywordTok")
        Op(_) => fail("expected StringLiteral, got Op")
        IntLiteral(_) => fail("expected StringLiteral, got IntLiteral")
        Newline => fail("expected StringLiteral, got Newline")
        Eof => fail("expected StringLiteral, got Eof")
        LexError(_) => fail("expected StringLiteral, got LexError")
    }
}

fun int_value_of(src: str): int64 {
    val toks = tokenize(src, 1)
    when (unsafe { toks.at(0).kind }) {
        IntLiteral(v) => return v
        _ => return -1
    }
}

fun float_text_of(src: str): String {
    val toks = tokenize(src, 1)
    when (unsafe { toks.at(0).kind }) {
        FloatLiteral(t) => return t.clone()
        _ => return ""
    }
}

@test fun a_digit_separator_groups_a_decimal(): void {
    assert_eq(int_value_of("1_000_000"), 1000000, "separators carry no value")
}

@test fun a_hex_literal_reads_base_sixteen(): void {
    assert_eq(int_value_of("0xff"), 255, "0xff is 255")
    assert_eq(int_value_of("0XFF"), 255, "the prefix and digits are case-insensitive")
}

@test fun a_binary_literal_reads_base_two(): void {
    assert_eq(int_value_of("0b1010"), 10, "0b1010 is 10")
}

@test fun a_separator_groups_a_radix_literal(): void {
    assert_eq(int_value_of("0xff_ff"), 65535, "separators group hex digits too")
}

// `_` is consumed only before a digit of the same radix.
@test fun a_trailing_separator_is_not_part_of_the_number(): void {
    val toks = tokenize("1_", 1)
    assert_eq(int_value_of("1_"), 1, "the number ends before a dangling separator")
    assert_eq(toks.size(), 3, "the `_` lexes on its own, then EOF")
}

@test fun a_radix_prefix_needs_a_digit(): void {
    val toks = tokenize("0x", 1)
    when (unsafe { toks.at(0).kind }) {
        LexError(_) => assert_eq(true, true, "a bare radix prefix is an error")
        _ => fail("expected LexError for `0x`")
    }
}

@test fun a_float_literal_keeps_its_spelling(): void {
    assert_eq(float_text_of("3.5").as_str(), "3.5", "the literal carries its own text")
}

@test fun a_float_literal_drops_its_separators(): void {
    assert_eq(float_text_of("1_000.5").as_str(), "1000.5", "separators are not part of the spelling")
}

@test fun a_point_before_a_name_is_member_access(): void {
    val toks = tokenize("5.equals", 1)
    assert_eq(int_value_of("5.equals"), 5, "the integer ends at the point")
    assert_eq(toks.size(), 4, "IntLiteral, `.`, identifier, EOF")
}

@test fun a_range_of_integers_is_not_a_float(): void {
    assert_eq(int_value_of("0..5"), 0, "`..` does not open a fraction")
}
