// The escape language, for both string and char literals.
//
//     \a \b \f \n \r \t \v    C's simple escapes, minus `\?`
//     \\ \' \"                the delimiters and the backslash
//     \$                      a literal `${`, so interpolation can be escaped
//     \NNN                    octal, one to three digits, at most 255
//     \xNN                    hex, exactly two digits
//
// Every escape is bounded: unlike C's greedy `\x`, `"\x41B"` is two bytes.
// `\0` is the one-digit octal escape.

/// A decoded escape's byte and how many source bytes followed the backslash.
/// `width == 0` means it is not an escape.
pub struct Escape {
    pub val value: uint8
    pub val width: uint64
}

fun no_escape(): Escape {
    return Escape { value: 0 as uint8, width: 0 }
}

/// The scalar a named escape denotes, or -1.
pub fun named_escape(b: uint8): int64 {
    if b == 97 { return 7 } // \a  bell
    if b == 98 { return 8 } // \b  backspace
    if b == 102 { return 12 } // \f  form feed
    if b == 110 { return 10 } // \n  newline
    if b == 114 { return 13 } // \r  carriage return
    if b == 116 { return 9 } // \t  tab
    if b == 118 { return 11 } // \v  vertical tab
    if b == 92 { return 92 } // \\
    if b == 39 { return 39 } // \'
    if b == 34 { return 34 } // \"
    if b == 36 { return 36 } // \$ — a literal `${`
    return 0 - 1
}

// CONSTRAINT: prefixed. A unity build puts every crate in one C namespace, so
// a bare `hex_digit` collides with json's.
fun escape_octal_digit(b: uint8): int64 {
    if b >= 48 && b <= 55 { return (b - 48) as int64 }
    return 0 - 1
}

fun escape_hex_digit(b: uint8): int64 {
    if b >= 48 && b <= 57 { return (b - 48) as int64 }
    if b >= 97 && b <= 102 { return (b - 97 + 10) as int64 }
    if b >= 65 && b <= 70 { return (b - 65 + 10) as int64 }
    return 0 - 1
}

/// The escape whose backslash is at `at`, reading no further than `to`. A
/// numeric escape that runs off the end or past 255 is not an escape; the
/// caller reports it.
pub fun decode_escape(src: str, at: uint64, to: uint64): Escape {
    if at + 1 >= to { return no_escape() }
    val lead: uint8 = src.byte_at(at + 1)

    val named = named_escape(lead)
    if named >= 0 { return Escape { value: named as uint8, width: 1 } }

    // \xNN: exactly two digits.
    if lead == 120 {
        if at + 3 >= to { return no_escape() }
        val h1 = escape_hex_digit(src.byte_at(at + 2))
        val h2 = escape_hex_digit(src.byte_at(at + 3))
        if h1 < 0 { return no_escape() }
        if h2 < 0 { return no_escape() }
        return Escape { value: ((h1 * 16) + h2) as uint8, width: 3 }
    }

    // \NNN: one to three octal digits, at most 255.
    val d1 = escape_octal_digit(lead)
    if d1 < 0 { return no_escape() }
    var value: int64 = d1
    var width: uint64 = 1
    while width < 3 {
        val next = at + 1 + width
        if next >= to { break }
        val d = escape_octal_digit(src.byte_at(next))
        if d < 0 { break }
        value = (value * 8) + d
        width = width + 1
    }
    if value > 255 { return no_escape() }
    return Escape { value: value as uint8, width: width }
}
