// Char literals. Their escapes are decoded by `escape_scalar`, the same set a
// string literal accepts.

import core.assert.assert_eq
import core.assert.fail

fun char_scalar_of(src: str): int64 {
    val toks = tokenize(src, 1)
    when (unsafe { toks.at(0).kind }) {
        CharLiteral(c) => return c as int64
        _ => return -1
    }
}

@test fun a_char_literal_carries_its_scalar(): void {
    assert_eq(char_scalar_of("'A'"), 65, "'A' is 65")
}

@test fun a_char_literal_decodes_an_escape(): void {
    assert_eq(char_scalar_of("'\\n'"), 10, "'\\n' is a newline")
    assert_eq(char_scalar_of("'\\''"), 39, "an escaped quote does not terminate")
}

// Every UTF-8 width: the width is what the cursor advances by, so a wrong one
// fails to find the closing `'`.
@test fun a_char_literal_decodes_utf8(): void {
    assert_eq(char_scalar_of("'é'"), 233, "two bytes, U+00E9")
    assert_eq(char_scalar_of("'€'"), 8364, "three bytes, U+20AC")
    assert_eq(char_scalar_of("'😀'"), 128512, "four bytes, U+1F600")
}

@test fun a_char_literal_holds_one_character(): void {
    val toks = tokenize("'AB'", 1)
    when (unsafe { toks.at(0).kind }) {
        LexError(_) => assert_eq(true, true, "two characters is an error")
        _ => fail("expected LexError for `'AB'`")
    }
}
