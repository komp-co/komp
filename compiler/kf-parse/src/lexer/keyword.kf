// The reserved-word table. To add a keyword: a variant, its spelling in
// `kw_str`, and an entry in `keyword_at`. `keyword_from_str` derives from
// `kw_str`, so a keyword lexes and prints under one spelling. The test
// `every_keyword_is_reachable` catches a missing `keyword_at` entry.

pub enum Keyword {
    Fun
    Val
    Var
    Return
    If
    Else
    While
    True
    False
    Import
    Pub
    Struct
    Enum
    Impl
    Extern
    When
    Mutating
    Static
    Unsafe
    As
    Break
    Continue
    For
    In
    Trait
    /// `type Item` in a trait body, `type Item = int32` in an impl body.
    TypeKw
    Dyn
}

/// The one place a keyword's spelling is written.
pub fun kw_str(k: Keyword): str {
    return when (k) {
        Fun => "fun"
        Val => "val"
        Var => "var"
        Return => "return"
        If => "if"
        Else => "else"
        While => "while"
        True => "true"
        False => "false"
        Import => "import"
        Pub => "pub"
        Struct => "struct"
        Enum => "enum"
        Impl => "impl"
        Extern => "extern"
        When => "when"
        Mutating => "mutating"
        Static => "static"
        Unsafe => "unsafe"
        As => "as"
        Break => "break"
        Continue => "continue"
        For => "for"
        In => "in"
        Trait => "trait"
        TypeKw => "type"
        Dyn => "dyn"
    }
}

/// Ordinal to keyword, `null` past the end: kf cannot enumerate an enum's
/// variants. An if-chain, because integer-literal `when` arms all lower to
/// `default:`.
pub fun keyword_at(i: uint64): Keyword? {
    if i == 0 { return Keyword.Fun }
    if i == 1 { return Keyword.Val }
    if i == 2 { return Keyword.Var }
    if i == 3 { return Keyword.Return }
    if i == 4 { return Keyword.If }
    if i == 5 { return Keyword.Else }
    if i == 6 { return Keyword.While }
    if i == 7 { return Keyword.True }
    if i == 8 { return Keyword.False }
    if i == 9 { return Keyword.Import }
    if i == 10 { return Keyword.Pub }
    if i == 11 { return Keyword.Struct }
    if i == 12 { return Keyword.Enum }
    if i == 13 { return Keyword.Impl }
    if i == 14 { return Keyword.Extern }
    if i == 15 { return Keyword.When }
    if i == 16 { return Keyword.Mutating }
    if i == 17 { return Keyword.Static }
    if i == 18 { return Keyword.Unsafe }
    if i == 19 { return Keyword.As }
    if i == 20 { return Keyword.Break }
    if i == 21 { return Keyword.Continue }
    if i == 22 { return Keyword.For }
    if i == 23 { return Keyword.In }
    if i == 24 { return Keyword.Trait }
    if i == 25 { return Keyword.TypeKw }
    if i == 26 { return Keyword.Dyn }
    return null
}

/// `null` for an ordinary identifier. Hot: runs for every identifier-shaped
/// token.
pub fun keyword_from_str(s: str): Keyword? {
    var i = 0
    while true {
        when (keyword_at(i)) {
            Some(k) => {
                if s.equals(kw_str(k)) { return k }
            }
            None => return null
        }
        i = i + 1
    }
    return null
}
