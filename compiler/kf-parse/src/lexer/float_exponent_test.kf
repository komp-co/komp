import core.assert.assert_eq

@test fun an_exponent_after_a_fraction_is_one_float(): void {
    assert_eq(float_text_of("6.022e23").as_str(), "6.022e23", "the exponent is part of the literal")
}

@test fun an_exponent_alone_makes_a_float(): void {
    assert_eq(float_text_of("1e10").as_str(), "1e10", "1e10 is a float, not 1 and a name")
}

@test fun an_exponent_takes_a_sign(): void {
    assert_eq(float_text_of("2.5E-3").as_str(), "2.5E-3", "a capital E and a minus sign")
}

@test fun an_exponent_takes_a_plus_sign(): void {
    assert_eq(float_text_of("1e+9").as_str(), "1e+9", "an explicit plus")
}

@test fun an_exponent_drops_its_separators(): void {
    assert_eq(float_text_of("1e1_0").as_str(), "1e10", "separators are not part of the spelling")
}

@test fun an_e_without_digits_is_a_name(): void {
    val toks = tokenize("1e", 1)
    assert_eq(toks.size(), 3, "IntLiteral, identifier `e`, EOF")
}

@test fun a_signed_e_without_digits_is_not_an_exponent(): void {
    val toks = tokenize("1e-x", 1)
    assert_eq(toks.size(), 5, "IntLiteral, `e`, `-`, `x`, EOF")
}
