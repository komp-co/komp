import alloc.list.*

import kf_core.span.*
import kf_core.ast.expression.*
import kf_core.ast.statement.Stmt
import kf_parse.lexer.*
import kf_parse.parser.*

/// An `if` statement read as a value:
///
///     one-expression branch  ->  that expression (a C ternary)
///     `else if`              ->  a nested IfExpr
///     anything longer        ->  a Block, whose value is its tail
fun if_stmt_as_expr(s: Stmt): Expr {
    when (s.kind) {
        If(cond_ptr, then_body, else_body) => {
            val then_ptr = branch_as_expr(&then_body, s.span)
            val else_ptr = else_as_expr(&else_body, s.span)
            return Expr.new(s.span, ExprKind.IfExpr(cond_ptr, then_ptr, else_ptr))
        }
        _ => return Expr.new_poison(s.span)
    }
    return Expr.new_poison(s.span)
}

fun branch_as_expr(stmts: &List<Stmt>, span: Span): Ptr<Expr> {
    val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
    if stmts.size() == 1 {
        when (stmts.at(0).kind) {
            Expression(ip) => {
                unsafe { *ep = *ip }
                return ep
            }
            _ => { }
        }
    }
    unsafe { *ep = Expr.new(span, ExprKind.Block(copy_stmt_list(stmts))) }
    return ep
}

/// No `else` becomes an empty block, which `check_expr` reports.
fun else_as_expr(stmts: &List<Stmt>, span: Span): Ptr<Expr> {
    if stmts.size() == 1 {
        when (stmts.at(0).kind) {
            If(_c, _t, _e) => {
                val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *ep = if_stmt_as_expr(*stmts.at(0)) }
                return ep
            }
            _ => { }
        }
    }
    return branch_as_expr(stmts, span)
}

/// Element by element: taking the `when` binder by value would make the arm
/// drop statements the new node still points at.
fun copy_stmt_list(stmts: &List<Stmt>): List<Stmt> {
    var out = List.new<Stmt>()
    while stmt in &stmts {
        out.push(stmt)
    }
    return out
}

impl Parser {
    mutating fun parse_primary(): Expr {
        val t = self.peek()
        when (t.kind) {
            IntLiteral(n) => {
                unsafe { self.advance() }
                // Postfix runs so `0 as Ptr<T>` parses its `as`.
                return self.parse_postfix(Expr.new(t.span, ExprKind.LitInt(n)))
            }
            StringLiteral(s) => {
                unsafe { self.advance() }
                return self.parse_postfix(Expr.new(t.span, ExprKind.LitStr(s.clone())))
            }
            FloatLiteral(text) => {
                unsafe { self.advance() }
                return self.parse_postfix(Expr.new(t.span, ExprKind.LitFloat(text.clone())))
            }
            CharLiteral(scalar) => {
                unsafe { self.advance() }
                return self.parse_postfix(Expr.new(t.span, ExprKind.LitChar(scalar)))
            }
            KeywordTok(kw) => {
                return self.parse_keyword_primary(kw, t.span)
            }
            Identifier(name) => {
                unsafe { self.advance() }
                return self.parse_after_identifier(name, t.span)
            }
            Op(o) => {
                return self.parse_op_primary(o, t.span)
            }
            Newline => {
                self.expr_expected_err(t.span, String.from("end of line"))
                unsafe { self.advance() }
                return Expr.new_poison(t.span)
            }
            Eof => {
                self.expr_expected_err(t.span, String.from("end of file"))
                return Expr.new_poison(t.span)
            }
            LexError(_) => {
                // Already reported by report_lex_errors.
                unsafe { self.advance() }
                return Expr.new_poison(t.span)
            }
        }
    }

    /// `if` in value position: `parse_if_stmt`'s result wrapped as an
    /// expression. A missing `else` is reported by `check_expr`.
    mutating fun parse_if_expr(span: Span): Expr {
        return if_stmt_as_expr(self.parse_if_stmt(span))
    }

    /// A `when` nested in a larger expression; Lower hoists its temporary.
    mutating fun when_as_nested_value(span: Span): Expr {
        return self.parse_postfix(self.parse_when_expr(span))
    }

    mutating fun parse_keyword_primary(kw: Keyword, span: Span): Expr {
        when (kw) {
            True => {
                unsafe { self.advance() }
                return self.parse_postfix(Expr.new(span, ExprKind.LitBool(true)))
            }
            False => {
                unsafe { self.advance() }
                return self.parse_postfix(Expr.new(span, ExprKind.LitBool(false)))
            }
            Fun => return self.kw_expr_err(kw, span)
            Val => return self.kw_expr_err(kw, span)
            Var => return self.kw_expr_err(kw, span)
            Return => return self.kw_expr_err(kw, span)
            If => return self.parse_if_expr(span)
            Else => return self.kw_expr_err(kw, span)
            While => return self.kw_expr_err(kw, span)
            Import => return self.kw_expr_err(kw, span)
            Pub => return self.kw_expr_err(kw, span)
            Struct => return self.kw_expr_err(kw, span)
            Enum => return self.kw_expr_err(kw, span)
            Impl => return self.kw_expr_err(kw, span)
            Extern => return self.kw_expr_err(kw, span)
            When => return self.when_as_nested_value(span)
            Mutating => return self.kw_expr_err(kw, span)
            Static => return self.kw_expr_err(kw, span)
            Unsafe => {
                // `unsafe { EXPR }` is transparent in the AST.
                return self.parse_unsafe_expr(span)
            }
            As => return self.kw_expr_err(kw, span)
            Break => return self.kw_expr_err(kw, span)
            Continue => return self.kw_expr_err(kw, span)
            For => return self.kw_expr_err(kw, span)
            In => return self.kw_expr_err(kw, span)
            Trait => return self.kw_expr_err(kw, span)
            TypeKw => return self.kw_expr_err(kw, span)
            Dyn => return self.kw_expr_err(kw, span)
        }
    }

    mutating fun kw_expr_err(kw: Keyword, span: Span): Expr {
        self.expr_expected_err(span, "keyword `${kw_str(kw)}`")
        return Expr.new_poison(span)
    }

    mutating fun parse_op_primary(o: Operator, span: Span): Expr {
        when (o) {
            LParen => {
                unsafe { self.advance() }
                // Inside the parens a `{` can only be a struct literal.
                val saved = self.no_struct_lit
                self.no_struct_lit = false
                val inner = self.parse_expr()
                self.no_struct_lit = saved
                val _rp = self.expect_op(Operator.RParen, "to close this parenthesized expression")
                // A group can take postfix operators: `(x).field`.
                return self.parse_postfix(inner)
            }
            Minus => {
                unsafe { self.advance() }
                val operand = self.parse_primary()
                val operand_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *operand_ptr = operand }
                return Expr.new(span, ExprKind.Unary(UnaryOp.Neg, operand_ptr))
            }
            Bang => {
                unsafe { self.advance() }
                val operand = self.parse_primary()
                val operand_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *operand_ptr = operand }
                return Expr.new(span, ExprKind.Unary(UnaryOp.Not, operand_ptr))
            }
            // `|a, b| expr`. `|` is otherwise only infix.
            Pipe => return self.parse_lambda(span)
            // `||` is one token: a zero-parameter lambda.
            PipePipe => return self.parse_lambda_no_params(span)
            // Operators that cannot begin an expression are skipped so the
            // enclosing loop progresses. Closing tokens are left for the
            // caller.
            Plus => return self.advance_and_poison_expr(span)
            DotDot => return self.advance_and_poison_expr(span)
            DotDotEq => return self.advance_and_poison_expr(span)
            // `*ptr`: binds tighter than binary operators and `as`.
            Star => {
                unsafe { self.advance() } // consume `*`
                val operand = self.parse_prefix_operand()
                val operand_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                unsafe { *operand_ptr = operand }
                return self.cast_prefixed(Expr.new(span, ExprKind.Deref(operand_ptr)))
            }
            Slash => return self.advance_and_poison_expr(span)
            Eq => return self.advance_and_poison_expr(span)
            EqEq => return self.advance_and_poison_expr(span)
            BangEq => return self.advance_and_poison_expr(span)
            Lt => return self.advance_and_poison_expr(span)
            Gt => return self.advance_and_poison_expr(span)
            LtEq => return self.advance_and_poison_expr(span)
            GtEq => return self.advance_and_poison_expr(span)
            Dot => return self.advance_and_poison_expr(span)
            Arrow => return self.advance_and_poison_expr(span)
            // `&expr`, `&var expr`: there is no reference node, so the inner
            // expression is returned tagged; an un-annotated `val b = &xs`
            // would otherwise move.
            Amp => {
                unsafe { self.advance() } // consume `&`
                var written = coerce_written_amp()
                if is_keyword(self.peek(), Keyword.Var) {
                    unsafe { self.advance() }
                    written = coerce_written_amp_var()
                }
                if is_keyword(self.peek(), Keyword.Val) {
                    unsafe { self.advance() }
                }
                var inner = self.parse_prefix_operand()
                inner.coerce = written
                // `&*ptr` vouches that a raw pointer is live, so a reference
                // slot accepts it.
                return self.cast_prefixed(inner)
            }
            Semicolon => return self.advance_and_poison_expr(span)
            AmpAmp => return self.advance_and_poison_expr(span)
            Caret => return self.advance_and_poison_expr(span)
            Percent => return self.advance_and_poison_expr(span)
            Shl => return self.advance_and_poison_expr(span)
            Question => return self.advance_and_poison_expr(span)
            // A valid `?:` is consumed by parse_let; reaching one here is
            // malformed.
            Elvis => return self.advance_and_poison_expr(span)
            SafeCall => return self.advance_and_poison_expr(span)
            ThinArrow => return self.advance_and_poison_expr(span)
            At => return self.advance_and_poison_expr(span)
            // `!!` needs a value on its left.
            BangBang => return self.advance_and_poison_expr(span)
            RParen => return Expr.new_poison(span)
            LBrace => return Expr.new_poison(span)
            RBrace => return Expr.new_poison(span)
            LBracket => {
                val literal = self.parse_list_literal(span)
                return self.parse_postfix(literal)
            }
            RBracket => return Expr.new_poison(span)
            Comma => return Expr.new_poison(span)
            Colon => return Expr.new_poison(span)
        }
    }

    /// The operand of a prefix `&`, `&var` or `*`, stopping before `as`.
    mutating fun parse_prefix_operand(): Expr {
        val saved = self.cast_after_prefix
        self.cast_after_prefix = true
        val operand = self.parse_primary()
        self.cast_after_prefix = saved
        return operand
    }

    /// `prefixed` with the `as` casts that follow it, unless it is itself the
    /// operand of an enclosing prefix, which takes them.
    mutating fun cast_prefixed(prefixed: Expr): Expr {
        if self.cast_after_prefix || !is_keyword(self.peek(), Keyword.As) { return prefixed }
        return self.parse_postfix(prefixed)
    }

    mutating fun advance_and_poison_expr(span: Span): Expr {
        self.expr_expected_err(span, tok_str(self.peek()))
        unsafe { self.advance() }
        return Expr.new_poison(span)
    }

    /// `unsafe { EXPR }`; `unsafe` already consumed.
    mutating fun parse_unsafe_expr(span: Span): Expr {
        unsafe { self.advance() } // consume `unsafe`
        val _ob = self.expect_op(Operator.LBrace, "after `unsafe`")
        val inner = self.parse_expr()
        self.skip_newlines()
        val _cb = self.expect_op(Operator.RBrace, "to close the `unsafe` block")
        return self.parse_postfix(inner)
    }
}
