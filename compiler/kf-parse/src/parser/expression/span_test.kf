// A node's span covers the text it owns.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_parse.parser.parser_for

/// Read through a borrow: a copied Stmt aliases its Expr pointers.
fun first_stmt_span(src: str): Span {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    var out = no_span()
    if m.decls.size() == 0 { return out }
    val td = *m.decls.at(0)
    when (td.kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => {
            if body.size() > 0 { out = body.at(0).span }
        }
        _ => {}
    }
    return out
}

fun first_expr_span(src: str): Span {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    var out = no_span()
    if m.decls.size() == 0 { return out }
    val td = *m.decls.at(0)
    when (td.kind) {
        Function(_p, _r, body, _pub, _u, _mut, _st) => {
            if body.size() > 0 {
                when (body.at(0).kind) {
                    Expression(e) => out = unsafe { e.span }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    return out
}

@test
fun a_call_span_reaches_past_its_arguments(): void {
    // `fun f(): void { g(1, 2) }` — `g` at 16 to the byte after `)` at 23.
    val span = first_expr_span("fun f(): void { g(1, 2) }")
    assert_eq(span.end, 23 as uint32, "a call ends after its closing parenthesis")
}

@test
fun a_call_span_still_starts_at_the_callee(): void {
    val span = first_expr_span("fun f(): void { g(1, 2) }")
    assert_eq(span.start, 16 as uint32, "a call still starts where its name does")
}

@test
fun a_method_call_span_reaches_past_its_arguments(): void {
    // `fun f(): void { a.m(1) }` — receiver at 16, `)` ends at 22.
    val span = first_expr_span("fun f(): void { a.m(1) }")
    assert_eq(span.end, 22 as uint32, "a method call ends after its closing parenthesis")
}

@test
fun a_method_call_span_starts_at_the_receiver(): void {
    val span = first_expr_span("fun f(): void { a.m(1) }")
    assert_eq(span.start, 16 as uint32, "a method call starts where its receiver does")
}

@test
fun a_generic_call_span_reaches_past_its_arguments(): void {
    // `fun f(): void { g<int32>(1) }` — `)` ends at 27.
    val span = first_expr_span("fun f(): void { g<int32>(1) }")
    assert_eq(span.end, 27 as uint32, "a call with type arguments ends at its parenthesis too")
}

@test
fun a_statement_span_covers_the_whole_statement(): void {
    // `fun f(): void { val x = 1 }` — `val` at 16, the `1` ends at 25.
    val span = first_stmt_span("fun f(): void { val x = 1 }")
    assert_eq(span.end, 25 as uint32, "a binding ends after its initializer")
}

@test
fun a_statement_span_still_starts_at_its_keyword(): void {
    val span = first_stmt_span("fun f(): void { val x = 1 }")
    assert_eq(span.start, 16 as uint32, "a binding still starts at `val`")
}

@test
fun a_block_statement_span_covers_its_body(): void {
    // `fun f(): void { while true { g() } }` — `while` at 16, `}` ends at 34.
    val span = first_stmt_span("fun f(): void { while true { g() } }")
    assert_eq(span.end, 34 as uint32, "a loop ends after its closing brace")
}
