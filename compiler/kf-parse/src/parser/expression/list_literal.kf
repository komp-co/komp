// `[a, b, c]` in value position; kf_core's list_literal.kf has the shape it
// becomes.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.expression.Expr
import kf_parse.parser.*

impl Parser {
    /// `[` is next. Newlines inside are whitespace, and a trailing comma is
    /// allowed.
    mutating fun parse_list_literal(span: Span): Expr {
        val _lb = self.expect_op(Operator.LBracket, "to open the list")
        // Inside `]`, a `{` opens a struct literal.
        val saved = self.no_struct_lit
        self.no_struct_lit = false
        var elements = List.new<Expr>()
        self.skip_newlines()
        while !is_op(self.peek(), Operator.RBracket) && !self.at_eof() {
            elements.push(self.parse_expr())
            self.skip_newlines()
            if !is_op(self.peek(), Operator.Comma) { break }
            val _comma = self.expect_op(Operator.Comma, "between elements")
            self.skip_newlines()
        }
        val _rb = self.expect_op(Operator.RBracket, "to close the list")
        self.no_struct_lit = saved
        return Expr.new_list_literal(self.span_through_last(span), &elements)
    }
}
