import core.assert.assert_eq
import alloc.list.*
import kf_parse.parser.parser_for

fun expression_syntax_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun struct_literal_fields_may_be_newline_separated(): void {
    assert_eq(expression_syntax_diags("""struct Pair { val left: int32 val right: int32 } fun f(): Pair { return Pair { left: 1
right: 2 } }"""), 0, "a newline separates struct-literal fields")
}

@test fun a_struct_literal_field_may_omit_its_value(): void {
    assert_eq(expression_syntax_diags("""struct Pair { val left: int32 val right: int32 } fun f(): Pair { val left = 1
val right = 2
return Pair { left, right } }"""), 0, "a bare name is shorthand for `name: name`")
}

@test fun shorthand_and_written_fields_mix_in_one_literal(): void {
    assert_eq(expression_syntax_diags("""struct Pair { val left: int32 val right: int32 } fun f(): Pair { val left = 1
return Pair { left, right: 2 } }"""), 0, "shorthand does not have to be all-or-nothing")
}

@test fun unsafe_expression_may_have_a_postfix_method_call(): void {
    assert_eq(expression_syntax_diags("fun f(): void { val x = unsafe { receiver }.method() }"), 0, "postfix parsing continues after an unsafe expression")
}

fun first_syntax_message(src: str): String {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    if p.diags.size() == 0 { return String.from("") }
    return p.diags.at(0).primary.message.clone()
}

@test fun an_intrinsic_type_list_open_at_the_end_of_the_file_is_reported(): void {
    assert_eq(first_syntax_message("fun f(): void { val p = unsafe { alloc<int32"),
        "unclosed type-argument list: missing `>`", "named first, and the parse ends")
}

@test fun an_intrinsic_type_list_stops_at_a_token_no_type_starts_with(): void {
    val source = "fun f(): void { val p = unsafe { alloc<int32 ; > }\n}"
    assert_eq(expression_syntax_diags(source) > 0, true, "the parse ends")
}

@test fun an_operator_needs_a_right_operand_before_a_closing_paren(): void {
    val diags = expression_syntax_diags("fun f(n: int32): int32 { return (n +) }")
    assert_eq(diags, 1, "`(n +)` is missing its right operand")
}

@test fun an_interpolation_slot_needs_its_right_operand(): void {
    val diags = expression_syntax_diags("fun f(n: int32): void { val s = \"x \${n +}\" }")
    assert_eq(diags, 1, "the slot is cut off by its operator")
}

@test fun a_closing_token_after_an_operator_is_reported_once(): void {
    val diags = expression_syntax_diags("fun f(n: int32): void { g(n *, 1) }")
    assert_eq(diags, 1, "the comma ends the operand that `*` needs")
}

@test fun an_empty_index_is_reported_once(): void {
    val diags = expression_syntax_diags("fun f(): void {\n    var names = String[]\n}")
    assert_eq(diags, 1, "`[]` after a name holds no index")
}
