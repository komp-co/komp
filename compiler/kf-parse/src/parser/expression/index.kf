// `a[i]`: a borrow, not a copy, and never across a newline.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_parse.parser.*

impl Parser {
    /// `a[i]` is `*(a.index(i))`; typecheck switches to `index_mut` where it
    /// is written through. A borrow, since a copy of an owning element would
    /// be a non-owning view. A store drops the element it overwrites and
    /// copies a borrowed right-hand side. A `[` opening the next line is not
    /// a subscript.
    mutating fun parse_index(recv: Expr): Expr {
        val open_span = self.peek().span
        unsafe { self.advance() } // consume `[`
        // Inside `]`, a `{` opens a struct literal.
        val saved = self.no_struct_lit
        self.no_struct_lit = false
        self.skip_newlines()
        if is_op(self.peek(), Operator.RBracket) {
            self.parse_err(self.peek().span, String.from(
                "an index goes between `[` and `]`; an empty list is `[]` where its type is known, or `List.new<T>()`"))
            val _rb = self.expect_op(Operator.RBracket, "to close the index")
            self.no_struct_lit = saved
            return Expr.new_poison(recv.span.merge(open_span))
        }
        val key = self.parse_expr()
        self.skip_newlines()
        val _rb = self.expect_op(Operator.RBracket, "to close the index")
        self.no_struct_lit = saved
        val recv_span = recv.span
        val full_span: Span = recv_span.merge(open_span)
        val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *recv_ptr = take<Expr>(recv) }
        var args = List.new<Expr>()
        args.push(key)
        var call = Expr.new(full_span, ExprKind.MethodCall(recv_ptr, intern("index"), args))
        call.name_span = open_span
        val call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *call_ptr = take<Expr>(call) }
        return Expr.new(full_span, ExprKind.Deref(call_ptr))
    }
}
