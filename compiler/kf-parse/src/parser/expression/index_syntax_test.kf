import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.expression.Expr
import kf_core.ast.statement.Stmt
import kf_core.span.no_span
import kf_parse.parser.parser_for

fun index_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

fun index_msg(src: str): String {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    if p.diags.size() == 0 { return String.from("") }
    return p.diags.at(0).primary.message.clone()
}

/// `index`, `index_mut`, or "" when the first statement is no subscript.
fun index_accessor(src: str): String {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    var body = List.new<Stmt>()
    when (m.decls.at(0).kind) {
        Function(_ps, _r, b, _p, _u, _mu, _st) => { body = b }
        _ => return ""
    }
    var subscript = Expr.new_poison(no_span())
    when (body.at(0).kind) {
        AssignTo(place, _rhs) => { subscript = unsafe { *place } }
        Return(value) => {
            val vp = value ?: return ""
            subscript = unsafe { *vp }
        }
        _ => return ""
    }
    when (subscript.kind) {
        Deref(call) => {
            when (unsafe { call.kind }) {
                MethodCall(_recv, name, _args) => return name.as_string()
                _ => return ""
            }
        }
        _ => return ""
    }
}

@test fun a_subscript_parses_as_an_expression(): void {
    assert_eq(index_diags("fun f(): int32 {\nreturn xs[0]\n}"), 0, "a read subscripts")
    assert_eq(index_diags("fun f(): int32 {\nreturn xs[i] + xs[j]\n}"), 0, "twice in one expression")
    assert_eq(index_diags("fun f(): int32 {\nreturn xs[ys[0]]\n}"), 0, "and nests")
}

@test fun an_unclosed_subscript_is_reported(): void {
    val m = index_msg("fun f(): int32 {\nreturn xs[0\n}")
    assert_eq(m.as_str().contains("to close the index"), true, "the `]` is named")
}

// Which accessor a store borrows through is typecheck's call.
@test fun an_indexed_store_parses_as_a_store(): void {
    assert_eq(index_diags("fun f(): void {\nxs[0] = 5\n}"), 0, "a store parses")
    val store = index_accessor("fun f(): void {\nxs[0] = 5\n}")
    assert_eq(store.as_str(), "index", "through the shared accessor, for typecheck to promote")
    val read = index_accessor("fun f(): int32 {\nreturn xs[0]\n}")
    assert_eq(read.as_str(), "index", "as a read is")
}

fun statements_in_first_fn(src: str): uint64 {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    return when (m.decls.at(0).kind) {
        Function(_params, _ret, body, _pub, _unsafe, _mutating, _static) => body.size()
        _ => 0
    }
}

// A `[` opening a line does not subscript the line above: it starts a list
// literal of its own.
@test fun a_bracket_opening_a_line_does_not_subscript(): void {
    assert_eq(statements_in_first_fn("fun f(): void {\nval a = ys\n[0]\n}"), 2,
        "the binding, then the literal as a statement")
}

@test fun a_bracket_on_the_same_line_subscripts(): void {
    assert_eq(index_diags("fun f(): void {\nval a = ys[0]\n}"), 0, "on the same line it is a subscript")
}

@test fun a_subscript_follows_a_wrapped_chain(): void {
    assert_eq(index_diags("fun f(): int32 {\nreturn xs\n.field[0]\n}"), 0,
        "the `.` continues the line, then the subscript applies")
}
