import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.expression.BinOp
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_parse.lexer.*
import kf_parse.parser.*

/// `..` sits below `||`, so both endpoints absorb whatever they contain and
/// nothing but an assignment or a comma can end one.
fun range_prec(): int32 {
    return 0
}

fun lhs_ptr_span(p: Ptr<Expr>): Span {
    return unsafe { p.span }
}

fun rhs_ptr_span(p: Ptr<Expr>): Span {
    return unsafe { p.span }
}

// `t2` is a `Gt` starting where `t1` ends: the source has `>>`.
fun Token.is_adjacent_gt(t2: &Token): bool {
    val second_is_gt = t2.is_op(Operator.Gt)
    if !second_is_gt { return false }
    return self.span.end == t2.span.start
}

/// An operator that cannot begin an expression, so one at the head of a line
/// means the previous line continues.
fun Token.op_may_open_a_continuation_line(): bool {
    return when (self.kind) {
        Op(o) => operator_is_infix_only(o)
        _ => false
    }
}

fun operator_is_infix_only(o: Operator): bool {
    return when (o) {
        Minus => false
        Star => false
        Amp => false
        // Infix-only, though not in the BinOp table.
        DotDot => true
        DotDotEq => true
        _ => op_to_binop(o).is_some()
    }
}

impl Parser {
    /// Precedence climbing on top of `parse_primary`.
    pub mutating fun parse_expr(): Expr {
        val saved = self.cast_after_prefix
        self.cast_after_prefix = false
        val e = self.parse_elvis()
        self.cast_after_prefix = saved
        return e
    }

    /// `a ?: D`: the payload, or a default. Lowest precedence and
    /// right-associative. Becomes
    ///
    ///     when (a) { Some(__elv_N) => __elv_N  None => D }
    ///
    /// The bailing form (`?: return e`) needs a statement, so it is left for
    /// `parse_let`.
    mutating fun parse_elvis(): Expr {
        val lhs = self.parse_binary(0)
        if !self.peek_is_elvis() { return lhs }
        if self.elvis_rhs_is_a_bail() { return lhs }
        self.skip_newlines()
        unsafe { self.advance() } // consume `?:`
        self.skip_newlines()
        val rhs = self.parse_elvis()
        return self.build_defaulting_elvis(lhs, rhs)
    }

    /// A jump or a braced block after `?:`: a bail, which `parse_let` owns.
    mutating fun elvis_rhs_is_a_bail(): bool {
        var off = 0
        while tok_is_newline(self.peek_at(off)) { off = off + 1 }
        off = off + 1 // step over the `?:` itself
        while tok_is_newline(self.peek_at(off)) { off = off + 1 }
        val t = self.peek_at(off)
        if t.is_keyword(Keyword.Return) { return true }
        if t.is_keyword(Keyword.Break) { return true }
        if t.is_keyword(Keyword.Continue) { return true }
        if t.is_op(Operator.LBrace) { return true }
        return false
    }

    /// `when (SUBJECT) { Some(__elv_N) => __elv_N  None => DEFAULT }`. The
    /// binder as the arm's value moves a move-only payload out.
    mutating fun build_defaulting_elvis(subject: Expr, default: Expr): Expr {
        val span: Span = subject.span.merge(default.span)
        val binder = "__elv_${self.elv_ctr}"
        self.elv_ctr = self.elv_ctr + 1
        val bsym = intern(binder.as_str())

        var some_payloads = List.new<Pattern>()
        some_payloads.push(new_pattern(span, PatternKind.Identifier(bsym)))
        val some_pat: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *some_pat = new_pattern(span, PatternKind.Variant(intern("Some"), some_payloads)) }
        val carry: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *carry = Expr.new(span, ExprKind.Variable(bsym)) }
        var some_body = List.new<Stmt>()
        some_body.push(Stmt.new(span, StmtKind.Expression(carry)))

        val none_pat: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *none_pat = new_pattern(span, PatternKind.Variant(intern("None"), List.new<Pattern>())) }
        val dflt: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *dflt = default }
        var none_body = List.new<Stmt>()
        none_body.push(Stmt.new(span, StmtKind.Expression(dflt)))

        var arms = List.new<Arm>()
        arms.push(new_arm(span, some_pat, null, some_body))
        arms.push(new_arm(span, none_pat, null, none_body))

        val subj: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *subj = subject }
        return Expr.new(span, ExprKind.WhenExpr(subj, arms))
    }

    /// Precedence climbing, left-associative.
    mutating fun parse_binary(min_prec: int32): Expr {
        var lhs = self.parse_primary()
        var more: bool = true
        while more {
            // An infix-only operator may open the next line:
            //
            //     val ok = a
            //         && b
            self.skip_newlines_before_a_continuing_operator()
            // `..` builds a call and binds looser than arithmetic and
            // comparison, so `a + 1 .. b - 1` is one range.
            // CONSTRAINT: written with a trailing operator, because the seed
            // must parse this file and predates leading-operator continuation.
            val opens_range: bool = is_op(self.peek(), Operator.DotDot) ||
                is_op(self.peek(), Operator.DotDotEq)
            if opens_range && range_prec() >= min_prec {
                lhs = self.parse_range_rest(lhs, is_op(self.peek(), Operator.DotDotEq))
            } else {
                val op_opt = self.peek_binop()
                when (op_opt) {
                    Some(op_info) => {
                        val prec: int32 = op_info.prec
                        if prec < min_prec {
                            more = false
                        } else {
                            unsafe { self.advance() }
                            when (op_info.op) {
                                Shr => unsafe { self.advance() }
                                _ => {}
                            }
                            // A line break after an operator continues the expression.
                            self.skip_newlines()
                            if self.peek().ends_an_operand() {
                                self.expr_expected_err(self.peek().span, tok_str(self.peek()))
                            }
                            val rhs = self.parse_binary(prec + 1)
                            val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                            unsafe { *lhs_ptr = lhs }
                            val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                            unsafe { *rhs_ptr = rhs }
                            val span = lhs_ptr_span(lhs_ptr).merge(rhs_ptr_span(rhs_ptr))
                            lhs = Expr.new(span, ExprKind.Binary(lhs_ptr, op_info.op, rhs_ptr))
                        }
                    }
                    None => more = false
                }
            }
        }
        return lhs
    }

    /// `a..b` is `range(a, b, 1)`, `a..=b` is `range_inclusive(a, b, 1)`. A
    /// call, not a `Range { }` literal: a generic function infers its type
    /// argument, and the literal `1` takes the endpoints' type.
    mutating fun parse_range_rest(lhs: Expr, inclusive: bool): Expr {
        unsafe { self.advance() } // consume `..` or `..=`
        self.skip_newlines()
        val rhs = self.parse_binary(range_prec() + 1)
        self.used_range = true
        val span = lhs.span.merge(rhs.span)
        var args = List.new<Expr>()
        args.push(lhs)
        args.push(rhs)
        args.push(Expr.new(span, ExprKind.LitInt(1)))
        var callee = "range"
        if inclusive { callee = "range_inclusive" }
        return Expr.new(span, ExprKind.Call(intern(callee), args))
    }

    mutating fun peek_binop(): BinOpInfo? {
        val t = self.peek()
        when (t.kind) {
            Op(o) => {
                // Two adjacent `Gt` in infix position are `>>`; parse_binary
                // consumes the second.
                when (o) {
                    Gt => {
                        val t2 = self.peek_at(1)
                        if t.is_adjacent_gt(t2) {
                            return BinOpInfo { op: BinOp.Shr, prec: 8 }
                        }
                        return op_to_binop(o)
                    }
                    _ => return op_to_binop(o)
                }
            }
            KeywordTok(_) => return null
            Identifier(_) => return null
            IntLiteral(_) => return null
            StringLiteral(_) => return null
            FloatLiteral(_) => return null
            CharLiteral(_) => return null
            Newline => return null
            Eof => return null
            LexError(_) => return null
        }
    }

    // Precedence follows C, higher binding tighter: `* / %` > `+ -` > shifts >
    // relational > equality > `&` > `^` > `|` > `&&` > `||`.
    /// Treats a line break as whitespace when the next line opens with an
    /// infix-only operator. Not `-`, `*` or `&`, which are also prefix:
    ///
    ///     val x = y
    ///     *ptr = 3        // a deref assignment, not `y * ptr`
    mutating fun skip_newlines_before_a_continuing_operator(): void {
        if !tok_is_newline(self.peek()) { return }
        var ahead = 0
        while tok_is_newline(self.peek_at(ahead)) {
            ahead = ahead + 1
        }
        if op_may_open_a_continuation_line(self.peek_at(ahead)) {
            self.skip_newlines()
        }
    }
}

/// A token that closes what surrounds an expression, so no right operand
/// starts here. The primary parser turns one into poison without a word, for
/// callers that report the gap themselves.
fun Token.ends_an_operand(): bool {
    return when (self.kind) {
        Op(o) => when (o) {
            RParen => true
            RBrace => true
            RBracket => true
            Comma => true
            Colon => true
            _ => false
        }
        _ => false
    }
}
