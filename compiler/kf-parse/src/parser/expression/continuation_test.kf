// An expression may span lines; a statement may not.

import core.assert.assert_eq
import alloc.list.*

import kf_parse.parser.parser_for

fun continuation_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

/// A continued expression stays one statement; a bare second line becomes
/// another.
fun body_stmt_count(src: str): uint64 {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => return body.size()
        _ => return 0
    }
}

@test fun a_call_argument_list_may_break_after_a_comma(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = g(1,\n2)\nreturn a\n}"), 0, "the list cannot end before its `)`")
}

@test fun a_call_argument_list_may_break_before_the_close(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = g(1\n)\nreturn a\n}"), 0, "the `)` may sit on its own line")
}

@test fun an_empty_argument_list_may_break(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = g(\n)\nreturn a\n}"), 0, "an empty list breaks too")
}

@test fun a_method_argument_list_may_break(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = x.m(1,\n2)\nreturn a\n}"), 0, "a method call shares the argument-list parser")
}

@test fun a_parameter_list_may_break_after_a_comma(): void {
    assert_eq(continuation_diags("fun g(a: int32,\nb: int32): int32 { return a }"), 0, "a declaration breaks like a call")
}

@test fun a_parameter_list_may_break_before_the_close(): void {
    assert_eq(continuation_diags("fun g(a: int32\n): int32 { return a }"), 0, "the `)` may sit on its own line")
}

@test fun a_trailing_operator_continues_the_expression(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = 1 +\n2\nreturn a\n}"), 0, "an operator cannot end a statement")
}

@test fun a_leading_dot_continues_the_chain(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = s\n.m()\nreturn a\n}"), 0, "`.` cannot start a statement")
}

@test fun several_chained_lines_continue(): void {
    assert_eq(continuation_diags("""fun f(): int32 {
val a = s
.m()
.n()
return a
}"""), 0, "each `.` line continues the one before")
}

// `+ 2` on its own line continues the expression.
@test fun a_leading_infix_only_operator_now_continues(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = 1\n+ 2\nreturn a\n}"), 0, "`+` cannot start an expression, so the line before it was unfinished")
}

@test fun a_continued_expression_stays_one_statement(): void {
    assert_eq(body_stmt_count("fun f(): int32 {\nval a = 1 +\n2\nreturn a\n}"), 2, "the binding and the return, with `1 + 2` spanning two lines")
}

// `2` alone is a legal expression statement, so nothing is reported.
@test fun a_bare_second_line_is_a_separate_statement(): void {
    assert_eq(body_stmt_count("fun f(): int32 {\nval a = 1\n2\nreturn a\n}"), 3, "a newline still ends a statement")
}

@test fun leftovers_on_one_line_are_still_reported(): void {
    assert_eq(continuation_diags("fun f(): int32 {\nval a = 1 2\nreturn a\n}"), 1, "continuing across lines does not loosen the line itself")
}

// A leading operator continues the line only if it cannot start an
// expression.

@test fun a_leading_andand_continues_the_expression(): void {
    assert_eq(continuation_diags("""fun f(a: bool, b: bool, c: bool): bool {
val ok = a
&& b
&& c
return ok
}"""), 0, "the style the issue asks for")
}

@test fun a_leading_andand_is_one_statement(): void {
    assert_eq(body_stmt_count("fun f(a: bool, b: bool): bool {\nval ok = a\n&& b\nreturn ok\n}"), 2, "the continuation joins, so the body is the binding plus the return")
}

@test fun a_leading_oror_continues_the_expression(): void {
    assert_eq(continuation_diags("""fun f(a: bool, b: bool): bool {
val ok = a
|| b
return ok
}"""), 0, "`||` is infix-only too")
}

@test fun a_leading_comparison_continues_the_expression(): void {
    assert_eq(continuation_diags("""fun f(a: int32, b: int32): bool {
val ok = a
== b
return ok
}"""), 0, "`==` is infix-only")
}

@test fun a_leading_plus_continues_the_expression(): void {
    assert_eq(continuation_diags("""fun f(a: int32, b: int32): int32 {
val n = a
+ b
return n
}"""), 0, "`+` has no prefix form in komp")
}

@test fun a_leading_operator_works_inside_parentheses(): void {
    assert_eq(continuation_diags("""fun f(a: bool, c: bool): bool {
val ok = (a
&& c)
return ok
}"""), 0, "newlines are whitespace inside `(...)` either way")
}

@test fun a_leading_star_stays_its_own_statement(): void {
    assert_eq(body_stmt_count("""fun f(y: int32, ptr: Ptr<int32>): int32 {
val x = y
unsafe { *ptr = 3 }
return x
}"""), 3, "`*` opens a deref statement — continuing it would rewrite the program")
}

@test fun a_leading_minus_stays_its_own_statement(): void {
    assert_eq(body_stmt_count("fun f(y: int32): int32 {\nval x = y\n-5\nreturn x\n}"), 3, "`-` is prefix too, so the line stands alone")
}
