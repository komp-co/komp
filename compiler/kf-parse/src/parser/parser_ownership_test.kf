// Parser helper ownership across temporary token destruction.

import core.assert.assert_eq
import alloc.list.*

@test
fun expected_identifier_name_survives_temporary_token_drop(): void {
    var parser = parser_for("stable_name")
    val name = parser.expect_name("test")
    var churn = List.new<String>()
    var i: uint64 = 0
    while i < 128 {
        churn.push(String.from("replacement"))
        i = i + 1
    }
    assert_eq(name.as_str(), "stable_name", "returned identifier owns its string")
}

@test
fun annotation_name_survives_temporary_token_drop(): void {
    var parser = parser_for("@stable_name\nfun run(): void { }")
    val declaration = parser.parse_top_decl()
    var churn = List.new<String>()
    var i: uint64 = 0
    while i < 128 {
        churn.push(String.from("replacement"))
        i = i + 1
    }
    assert_eq(declaration.annotations.at(0).as_str(), "stable_name", "annotation owns its name")
}

@test
fun a_run_of_annotations_is_kept_in_source_order(): void {
    var parser = parser_for("@test\n@allow(unused_import)\nfun run(): void { }")
    val td = parser.parse_top_decl()
    assert_eq(td.annotations.size(), 2, "both are recorded, not just the first")
    assert_eq(td.annotations.at(0).as_str(), "test", "source order, so a reader can match what they wrote")
    assert_eq(td.annotations.at(1).as_str(), "allow(unused_import)", "arguments captured verbatim")
}

@test
fun the_order_written_does_not_decide_which_survives(): void {
    // `@allow(...)` above `@test` must not unregister the test.
    var parser = parser_for("@allow(unused_import)\n@test\nfun run(): void { }")
    val td = parser.parse_top_decl()
    assert_eq((&td).has_annotation("test"), true, "the test still registers")
    assert_eq((&td).has_annotation("allow"), true, "and the suppression is still there")
}

@test
fun an_annotation_with_arguments_answers_to_its_name(): void {
    var parser = parser_for("@derive(Clone,Equal)\nstruct P { val a: int32 }")
    val td = parser.parse_top_decl()
    assert_eq((&td).has_annotation("derive"), true, "`derive(...)` is a `derive`")
    assert_eq((&td).has_annotation("deriv"), false, "a prefix of the name is not the name")
    assert_eq((&td).annotation_text("derive").as_str(), "derive(Clone,Equal)", "and the text comes back whole")
}

@test
fun a_decl_with_no_annotations_has_an_empty_list(): void {
    var parser = parser_for("fun run(): void { }")
    val td = parser.parse_top_decl()
    assert_eq(td.annotations.size(), 0, "not one empty string")
    assert_eq((&td).has_annotation("test"), false, "and nothing answers")
}

@test
fun a_string_literal_annotation_argument_is_kept(): void {
    var parser = parser_for("@lang(\"string\")\nstruct Text { val a: int32 }")
    val td = parser.parse_top_decl()
    assert_eq((&td).annotation_text("lang").as_str(), "lang(string)", "the literal's contents are the argument")
    assert_eq((&td).lang_key_of().as_str(), "string", "and read back as the lang key")
}
