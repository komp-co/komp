import core.assert.assert_eq

import kf_core.ast.types.TypeRef
import kf_core.span.no_span

fun dyn_type_mutability(src: str): int32 {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => {
            val ty = unsafe { *params.at(0).ty }
            when (ty.kind) {
                Reference(is_mutable, _) => {
                    if is_mutable { return 1 }
                    return 0
                }
                _ => return -1
            }
        }
        _ => return -1
    }
}

fun dyn_type_has_principal(src: str, expected: str): bool {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => {
            val ty = unsafe { *params.at(0).ty }
            when (ty.kind) {
                Reference(_, inner) => {
                    val object_ty = unsafe { *inner }
                    when (object_ty.kind) {
                        DynTrait(name, _) => return name.as_str() == expected
                        _ => return false
                    }
                }
                _ => return false
            }
        }
        _ => return false
    }
}

fun dyn_type_argument_count(src: str): uint64 {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => {
            val ty = unsafe { *params.at(0).ty }
            when (ty.kind) {
                Reference(_, inner) => {
                    val object_ty = unsafe { *inner }
                    when (object_ty.kind) {
                        DynTrait(_, args) => return args.size()
                        _ => return 0
                    }
                }
                _ => return 0
            }
        }
        _ => return 0
    }
}

fun dyn_type_diagnostic_count(src: str): uint64 {
    var p = parser_for(src)
    val _td = p.parse_top_decl()
    return p.diags.size()
}

@test fun dyn_type_shared_borrow_is_immutable(): void {
    assert_eq(dyn_type_mutability("fun show(value: &dyn Display): void { }"), 0, "shared dynamic borrow stays immutable")
}

@test fun dyn_type_mutable_borrow_is_mutable(): void {
    assert_eq(dyn_type_mutability("fun reset(value: &var dyn Resettable): void { }"), 1, "mutable dynamic borrow stays mutable")
}

@test fun dyn_type_preserves_principal_name(): void {
    assert_eq(dyn_type_has_principal("fun show(value: &dyn Display): void { }", "Display"), true, "dynamic type records Display")
}

@test fun dyn_type_preserves_generic_arguments(): void {
    assert_eq(dyn_type_argument_count("fun send(value: &dyn Sink<int32>): void { }"), 1, "dynamic type records its trait argument")
}

@test fun dyn_type_requires_a_principal_name(): void {
    assert_eq(dyn_type_diagnostic_count("fun show(value: &dyn): void { }"), 1, "bare dyn produces one diagnostic")
}

@test fun dyn_type_rejects_multiple_principals(): void {
    assert_eq(dyn_type_diagnostic_count("fun show(value: &dyn Read + Write): void { }"), 1, "a second principal is invalid trailing syntax")
}

fun first_param_type(src: str): TypeRef {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => return unsafe { *params.at(0).ty }
        _ => return TypeRef.new_poison(no_span())
    }
}

@test fun a_function_type_names_its_parameters(): void {
    val ty = first_param_type("fun f(g: (int32, str) -> bool): void { }")
    val count = when (ty.kind) {
        Function(params, _) => params.size()
        _ => 99
    }
    assert_eq(count, 2, "two parameter types before the arrow")
}

@test fun a_parenthesized_type_is_the_type(): void {
    val ty = first_param_type("fun f(g: (int32)): void { }")
    val grouped = when (ty.kind) {
        Named(name, _) => name.as_str() == "int32"
        _ => false
    }
    assert_eq(grouped, true, "`(T)` with no arrow groups `T`")
}

@test fun a_function_type_needs_its_arrow(): void {
    var p = parser_for("fun f(g: (int32, bool)): void { }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "two types in parentheses without `->` are an error")
}

/// The value of the `index`th type argument of the first parameter's type.
fun value_argument_of(src: str, index: uint64): int64? {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => {
            val ty = unsafe { *params.at(0).ty }
            when (ty.kind) {
                Named(_, args) => {
                    when (args.at(index).kind) {
                        Value(v) => return v
                        _ => return null
                    }
                }
                _ => return null
            }
        }
        _ => return null
    }
}

@test
fun an_integer_type_argument_is_a_value(): void {
    assert_eq(value_argument_of("fun f(r: Residue<int32, 7>): void {}", 1) ?: 0, 7, "`7` in a type-argument list")
}

@test
fun a_negative_type_argument_is_a_value(): void {
    assert_eq(value_argument_of("fun f(r: Residue<int64, -3>): void {}", 1) ?: 0, -3, "`-3` in a type-argument list")
}

@test
fun a_type_argument_is_not_a_value(): void {
    assert_eq(value_argument_of("fun f(r: Residue<int32, 7>): void {}", 0) == null, true, "`int32` is a type")
}

/// The head and argument count of the first parameter's type.
fun first_param_shape(src: str): String {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(params, _, _, _, _, _, _) => {
            val ty = unsafe { *params.at(0).ty }
            return when (ty.kind) {
                Named(name, args) => "${name.lang_placeholder_key()}/${args.size()}"
                _ => String.from("?")
            }
        }
        _ => return String.from("?")
    }
}

@test
fun an_array_suffix_names_the_array_lang_item(): void {
    assert_eq(first_param_shape("fun f(xs: int32[3]): void {}").as_str(), "array/2", "`T[N]` is `Array<T, N>`")
}

@test
fun an_empty_array_suffix_leaves_the_length_out(): void {
    assert_eq(first_param_shape("fun f(xs: int32[]): void {}").as_str(), "array/2", "`T[]` is `Array<T, _>`")
}

@test
fun a_borrow_of_an_array_of_no_length_is_a_slice(): void {
    assert_eq(first_param_shape("fun f(xs: &int32[]): void {}").as_str(), "slice/1", "`&T[]` is `Slice<T>`")
}

@test
fun a_mutable_borrow_of_an_array_of_no_length_is_a_mutable_slice(): void {
    val shape = first_param_shape("fun f(xs: &var int32[]): void {}")
    assert_eq(shape.as_str(), "slice_mut/1", "`&var T[]` is `SliceMut<T>`")
}

@test
fun a_borrow_of_a_sized_array_stays_a_borrow(): void {
    assert_eq(first_param_shape("fun f(xs: &int32[3]): void {}").as_str(), "?", "`&T[N]` borrows the array")
}

@test
fun an_optional_array_is_an_option_of_the_array(): void {
    assert_eq(first_param_shape("fun f(xs: int32[3]?): void {}").as_str(), "option/1", "`[N]` binds before `?`")
}

@test
fun a_type_argument_list_may_span_lines(): void {
    var p = parser_for("<int32,\n    str\n>")
    var args = List.new<TypeRef>()
    val _ = p.parse_type_argument_list(&var args, false)
    assert_eq(args.size(), 2, "the newlines are whitespace")
}

@test
fun a_speculative_list_left_open_fails(): void {
    var p = parser_for("<int32, str")
    var args = List.new<TypeRef>()
    assert_eq(p.parse_type_argument_list(&var args, true), false, "no `>`, so no list")
}

@test
fun a_speculative_list_left_open_reports_nothing(): void {
    var p = parser_for("<int32, str")
    var args = List.new<TypeRef>()
    val _ = p.parse_type_argument_list(&var args, true)
    assert_eq(p.diags.size(), 0, "the caller rewinds and reads `<` as a comparison")
}

@test
fun a_list_left_open_is_reported(): void {
    var p = parser_for("<int32, str")
    var args = List.new<TypeRef>()
    val _ = p.parse_type_argument_list(&var args, false)
    assert_eq(p.diags.size(), 1, "missing `>`")
}

@test
fun a_comparison_is_not_a_type_argument_list(): void {
    var p = parser_for("< b) + 1")
    var args = List.new<TypeRef>()
    assert_eq(p.parse_type_argument_list(&var args, true), false, "`)` cannot follow a type argument")
}

/// The head name of `t`, "poison" for a poisoned one, "" for any other shape.
fun head_of(t: &TypeRef): String {
    return when (t.kind) {
        Named(name, _args) => name.as_string()
        Poison => String.from("poison")
        _ => String.from("")
    }
}

@test
fun a_parameter_without_a_type_reads_as_poison(): void {
    var p = parser_for("fun f(x) {}")
    val td = p.parse_top_decl()
    val head = when (td.kind) {
        Function(params, _, _, _, _, _, _) => head_of(&*params.at(0).ty)
        _ => String.from("not a function")
    }
    assert_eq(head.as_str(), "poison", "the missing annotation")
}

@test
fun an_extern_without_a_result_reads_as_poison(): void {
    var p = parser_for("extern \"C\" fun f(x: int32)")
    val td = p.parse_top_decl()
    val head = when (td.kind) {
        Extern(_, ret, _, _) => head_of(&*ret)
        _ => String.from("not an extern")
    }
    assert_eq(head.as_str(), "poison", "the missing result")
}
