// `|a, b| expr` and `|| expr`. An unannotated parameter has a null TypeRef.
// The body, one expression or a block, is a statement list whose last
// expression statement is the value.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.new_param
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

impl Parser {
    pub mutating fun parse_lambda(span: Span): Expr {
        unsafe { self.advance() } // consume the opening `|`
        var params = List.new<Param>()
        if is_op(self.peek(), Operator.Pipe) {
            unsafe { self.advance() }
            return self.finish_lambda(params, span)
        }
        while true {
            params.push(self.parse_lambda_param())
            if is_op(self.peek(), Operator.Comma) {
                unsafe { self.advance() }
            } else {
                break
            }
        }
        val _cp = self.expect_op(Operator.Pipe, "to close the lambda parameter list")
        return self.finish_lambda(params, span)
    }

    /// `||` arrives as one token.
    pub mutating fun parse_lambda_no_params(span: Span): Expr {
        unsafe { self.advance() } // consume `||`
        return self.finish_lambda(List.new<Param>(), span)
    }

    mutating fun finish_lambda(params: List<Param>, span: Span): Expr {
        if is_op(self.peek(), Operator.LBrace) {
            return Expr.new(span, ExprKind.Lambda(params, self.parse_block()))
        }
        val body = self.parse_expr()
        val body_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *body_ptr = body }
        var stmts = List.new<Stmt>()
        stmts.push(Stmt.new(span, StmtKind.Expression(body_ptr)))
        return Expr.new(span, ExprKind.Lambda(params, stmts))
    }

    mutating fun parse_lambda_param(): Param {
        val span = self.peek().span
        val name = self.expect_name("lambda parameter")
        unsafe { self.advance() }
        if is_op(self.peek(), Operator.Colon) {
            unsafe { self.advance() }
            return new_param(span, name, self.parse_type_ref_ptr())
        }
        // TypeCheck infers it from the expected `Call` bound.
        val inferred: Ptr<TypeRef> = unsafe { 0 as Ptr<TypeRef> }
        return new_param(span, name, inferred)
    }
}
