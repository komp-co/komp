import core.assert.assert_eq

import kf_core.ast.*
import kf_core.span.no_span

/// The written length, -1 for `[]`, -2 for anything not an array.
fun array_length_of(ty: &TypeRef): int64 {
    return when (ty.kind) {
        Array(_element, length) => if length == null { 0 - 1 } else { (length ?: 0) as int64 }
        _ => 0 - 2
    }
}

fun element_of(ty: &TypeRef): TypeRef {
    return when (ty.kind) {
        Array(element, _length) => (*element).clone()
        _ => type_ref_poison(no_span())
    }
}

@test fun a_suffix_names_the_length(): void {
    assert_eq(array_length_of(&first_param_type("fun f(xs: int32[3]): void { }")), 3, "`int32[3]`")
}

@test fun the_generic_spelling_is_the_same_type(): void {
    assert_eq(array_length_of(&first_param_type("fun f(xs: Array<int32, 4>): void { }")), 4, "`Array<int32, 4>`")
}

@test fun an_empty_suffix_leaves_the_length_open(): void {
    assert_eq(array_length_of(&first_param_type("fun f(xs: int32[]): void { }")), 0 - 1, "`int32[]`")
}

@test fun a_second_suffix_holds_the_first(): void {
    val outer = first_param_type("fun f(grid: int32[2][3]): void { }")
    assert_eq(array_length_of(&element_of(&outer)), 2, "`int32[2][3]` is three `int32[2]`")
}

@test fun an_optional_element_comes_before_the_length(): void {
    val ty = first_param_type("fun f(xs: int32?[2]): void { }")
    assert_eq(array_length_of(&ty), 2, "`int32?[2]` holds two options")
}

@test fun an_optional_array_wraps_the_array(): void {
    val ty = first_param_type("fun f(xs: int32[2]?): void { }")
    assert_eq(array_length_of(&ty), 0 - 2, "`int32[2]?` is an option")
}

@test fun a_length_is_an_integer_literal(): void {
    assert_eq(dyn_type_diagnostic_count("fun f(xs: int32[n]): void { }"), 1, "a name is not a length")
}
