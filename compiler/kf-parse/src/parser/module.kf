import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_parse.lexer.*

/// A module writing `..` gets `core.range` imported, since `..` calls its
/// `range`. A duplicate import is harmless.
fun core_range_path(): List<String> {
    var p = List.new<String>()
    p.push(String.from("core"))
    p.push(String.from("range"))
    return p
}

fun path_is_core_range(path: &List<String>): bool {
    if path.size() != 2 { return false }
    if !path.at(0).as_str().equals("core") { return false }
    return path.at(1).as_str().equals("range")
}

impl Parser {
    /// Imports and exports come before the first other top-level item.
    pub mutating fun parse_module(path: List<String>): Module {
        // Every lexer error once, including in code the parser never reaches.
        self.report_lex_errors()
        var imports = List.new<Import>()
        var decls = List.new<TopDecl>()
        var phase_imports: bool = true

        while true {
            self.skip_newlines()
            if self.at_eof() { break }
            if phase_imports && is_keyword(self.peek(), Keyword.Import) {
                // A pathless import was reported, and would name nothing.
                val imported = self.parse_import()
                if imported.path.size() > 0 { imports.push(imported) }
            } else if phase_imports && self.at_word("export") {
                val exported = self.parse_export()
                while imp in &exported { imports.push(imp.clone_import()) }
            } else if phase_imports && is_keyword(self.peek(), Keyword.Pub) && is_keyword(self.peek_at(1), Keyword.Import) {
                self.parse_err(self.peek().span, "a re-export is written `export <names> from <module>`")
                self.sync_to_newline()
            } else {
                phase_imports = false
                decls.push(self.parse_top_decl())
            }
        }

        if self.used_range && !path_is_core_range(&path) {
            imports.push(new_import(self.module_file_span(), core_range_path(), true))
        }
        return Module { crate: crate_id_poison(), path: path, decls: decls, imports: imports }
    }

    /// `export <names> from <module>`: `*`, or names each optionally `as` a
    /// new one. One import per name, marked `pub`; its owner is stamped
    /// with the file's module.
    mutating fun parse_export(): List<Import> {
        val start = self.peek().span
        self.advance()
        var out = List.new<Import>()
        var names = List.new<String>()
        var exposed = List.new<String>()
        val wildcard = is_op(self.peek(), Operator.Star)
        if wildcard {
            self.advance()
        } else {
            while true {
                names.push(self.expect_name("exported"))
                self.advance()
                var shown = ""
                if is_keyword(self.peek(), Keyword.As) {
                    self.advance()
                    shown = self.expect_name("exported")
                    self.advance()
                }
                exposed.push(shown)
                if !is_op(self.peek(), Operator.Comma) { break }
                self.advance()
            }
        }
        if !self.at_word("from") {
            val found = tok_str(self.peek())
            self.parse_err(self.peek().span, "expected `from <module>` after the exported names, found ${found}")
            self.sync_to_newline()
            return out
        }
        self.advance()
        val module = self.parse_dotted_path()
        val span = Span { file_id: start.file_id, start: start.start, end: self.peek().span.start }
        if wildcard {
            out.push(new_reexport(span, module, true, ""))
            return out
        }
        while i in 0..names.size() {
            var path = module.clone()
            path.push(names.at(i).clone())
            out.push(new_renaming_reexport(span, path, exposed.at(i).clone()))
        }
        return out
    }

    /// `a.b.c`, stopping at the first token that does not continue it.
    mutating fun parse_dotted_path(): List<String> {
        var path = List.new<String>()
        path.push(self.expect_name("module"))
        self.advance()
        while is_op(self.peek(), Operator.Dot) {
            self.advance()
            path.push(self.expect_name("module"))
            self.advance()
        }
        return path
    }

    /// The current token is the identifier `word`.
    pub fun at_word(word: str): bool {
        return when (self.peek().kind) {
            Identifier(s) => s.as_str() == word
            _ => false
        }
    }

    /// A synthesized import must carry its file id, or import validation
    /// drops it silently.
    mutating fun module_file_span(): Span {
        if self.toks.size() == 0 { return no_span() }
        val fid = self.toks.at(0).span.file_id
        return Span { file_id: fid, start: 0, end: 0 }
    }

    mutating fun report_lex_errors(): void {
        while t in &self.toks {
            when (t.kind) {
                LexError(m) => {
                    self.parse_err(t.span, m.clone())
                }
                _ => { }
            }
        }
    }

    /// `import a.b.c` or `import a.b.*`, consuming `import`.
    pub mutating fun parse_import(): Import {
        val start_span = self.peek().span
        unsafe { self.advance() } // consume `import`

        var path = List.new<String>()
        var wildcard: bool = false

        if !is_identifier(self.peek()) {
            self.parse_err(self.peek().span, "expected a module path after `import`, found ${tok_str(self.peek())}")
            self.sync_to_newline()
        }
        val first = self.peek()
        when (first.kind) {
            Identifier(s) => {
                path.push(s.as_string())
                unsafe { self.advance() }
            }
            KeywordTok(_) => {}
            Op(_) => {}
            IntLiteral(_) => {}
            StringLiteral(_) => {}
            FloatLiteral(_) => {}
            CharLiteral(_) => {}
            Newline => {}
            Eof => {}
            LexError(_) => {}
        }

        while true {
            if is_op(self.peek(), Operator.Dot) {
                unsafe { self.advance() }
                if is_op(self.peek(), Operator.Star) {
                    unsafe { self.advance() }
                    wildcard = true
                    break
                }
                val next = self.peek()
                when (next.kind) {
                    Identifier(s) => {
                        path.push(s.as_string())
                        unsafe { self.advance() }
                    }
                    KeywordTok(_) => break
                    Op(_) => break
                    IntLiteral(_) => break
                    StringLiteral(_) => break
                    FloatLiteral(_) => break
                    CharLiteral(_) => break
                    Newline => break
                    Eof => break
                    LexError(_) => break
                }
            } else {
                break
            }
        }

        var alias = ""
        if is_keyword(self.peek(), Keyword.As) {
            val as_span = self.peek().span
            self.advance()
            alias = when (self.peek().kind) {
                Identifier(s) => s.as_string()
                _ => ""
            }
            if alias.as_str() == "" {
                self.parse_err(self.peek().span, "expected a name after `as`, found ${tok_str(self.peek())}")
            } else {
                self.advance()
            }
            if wildcard {
                self.parse_err(as_span, "`as` names a module, not its contents: drop the `.*`")
            }
        }

        val end_pos: uint32 = self.peek().span.start
        val span = Span {
            file_id: start_span.file_id,
            start: start_span.start,
            end: end_pos
        }
        if alias.as_str() != "" && !wildcard { return new_aliased_import(span, path, alias) }
        return new_import(span, path, wildcard)
    }
}
