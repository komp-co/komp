import alloc.list.*
import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_parse.lexer.*
/// Recursive descent over a token stream. Grammar lives in sibling files.
pub struct Parser {
    pub var toks: List<Token>
    pub var pos: uint64
    /// Set in an `if`/`while` condition, where `Name { ... }` is not a struct
    /// literal: the `{` opens the body.
    pub var no_struct_lit: bool
    /// Recovery substitutes a `_` placeholder and continues.
    pub var diags: List<Diagnostic>
    /// Set while probing whether `x < y` is a generic call; errors are
    /// suppressed because the probe rewinds.
    pub var speculative: bool
    /// Set by the `?:` desugar, which consumes the rest of its block including
    /// the `}`, so parse_block stops instead of running past its end.
    pub var block_done: bool
    /// A `..` was desugared to `range(...)`, so the module gets
    /// `import core.range.*`.
    pub var used_range: bool
    /// Postfix `?`s awaiting their `when`, in source order: the bail arm needs
    /// the function's return type and the carry-on arm the rest of the block.
    /// `parse_one_block_stmt` drains its own statement's entries.
    pub var pending_try: List<PendingTry>
    /// Makes each `?`'s binder pair unique.
    pub var try_ctr: uint64
    /// Makes each defaulting `?:`'s `__elv_N` binder unique.
    pub var elv_ctr: uint64
    /// Makes each safe call's `__sc_N` binder unique.
    pub var sc_ctr: uint64
    /// The enclosing function's declared return type, empty outside one. A
    /// `?` bails with `Result.from_residual<bool, int32>(r)` built from it.
    pub var fn_ret: List<TypeRef>
    /// Returned by `peek` past the end; a borrow needs storage that outlives
    /// the call.
    pub val eof: Token
}

/// A postfix `?` not yet desugared: its subject and the carry-on binder name.
@derive(Clone)
pub struct PendingTry {
    pub val name: String
    pub val subject: Expr
    pub val span: Span
}

pub fun new_parser(toks: List<Token>): Parser {
    return Parser { toks: toks, pos: 0, no_struct_lit: false, diags: List.new<Diagnostic>(), speculative: false, block_done: false, used_range: false, pending_try: List.new<PendingTry>(), try_ctr: 0, elv_ctr: 0, sc_ctr: 0, fn_ret: List.new<TypeRef>(), eof: new_token(TokenKind.Eof, no_span()) }
}

/// For "found X" messages.
pub fun Token.tok_str(): String {
    return when (self.kind) {
        KeywordTok(k) => "keyword `${kw_str(k)}`"
        Identifier(n) => "`${n.as_string()}`"
        Op(o) => "`${op_str(o)}`"
        IntLiteral(_) => String.from("an integer literal")
        StringLiteral(_) => String.from("a string literal")
        FloatLiteral(_) => String.from("a float literal")
        CharLiteral(_) => String.from("a char literal")
        Newline => String.from("end of line")
        Eof => String.from("end of file")
        LexError(m) => "unrecognizable input `${m}`"
    }
}

impl Parser {
    /// Eof past the end.
    pub fun peek(): &Token {
        if self.pos >= self.toks.size() {
            return &self.eof
        }
        return self.toks.at(self.pos)
    }

    /// Eof past the end.
    pub fun peek_at(offset: uint64): &Token {
        val p: uint64 = self.pos + offset
        if p >= self.toks.size() {
            return &self.eof
        }
        return self.toks.at(p)
    }

    /// The token stays in `toks`; read it with `peek` first.
    pub mutating fun advance(): void {
        self.pos = self.pos + 1
    }

    /// End offset of the last consumed token; 0 before the first.
    pub fun last_consumed_end(): uint32 {
        if self.pos == 0 { return 0 }
        if self.pos > self.toks.size() { return 0 }
        return self.toks.at(self.pos - 1).span.end
    }

    pub fun at_newline(): bool {
        return when (self.peek().kind) {
            Newline => true
            KeywordTok(_) => false
            Identifier(_) => false
            Op(_) => false
            IntLiteral(_) => false
            StringLiteral(_) => false
            FloatLiteral(_) => false
            CharLiteral(_) => false
            Eof => false
            LexError(_) => false
        }
    }

    pub fun at_eof(): bool {
        return when (self.peek().kind) {
            Eof => true
            KeywordTok(_) => false
            Identifier(_) => false
            Op(_) => false
            IntLiteral(_) => false
            StringLiteral(_) => false
            FloatLiteral(_) => false
            CharLiteral(_) => false
            Newline => false
            LexError(_) => false
        }
    }

    pub mutating fun skip_newlines(): void {
        while true {
            if self.at_newline() {
                unsafe { self.advance() }
            } else {
                break
            }
        }
    }

    /// The current identifier's name, not consumed. Anything else is reported
    /// (a keyword with its own message) and yields "_".
    pub mutating fun expect_name(what: str): String {
        val t = self.peek()
        when (t.kind) {
            Identifier(name) => {
                val owned_name = name.as_string()
                return owned_name
            }
            KeywordTok(k) => {
                val msg = "`${kw_str(k)}` is a keyword and cannot be used as a ${what} name"
                self.diags.push(error_at(t.span, msg))
                return String.from("_")
            }
            Op(_) => return self.name_err(t.span, what)
            IntLiteral(_) => return self.name_err(t.span, what)
            StringLiteral(_) => return self.name_err(t.span, what)
            FloatLiteral(_) => return self.name_err(t.span, what)
            CharLiteral(_) => return self.name_err(t.span, what)
            Newline => return self.name_err(t.span, what)
            Eof => return self.name_err(t.span, what)
            LexError(_) => return self.name_err(t.span, what)
        }
    }

    mutating fun name_err(span: Span, what: str): String {
        val msg = "expected a ${what} name here, found ${tok_str(self.peek())}"
        self.diags.push(error_at(span, msg))
        return String.from("_")
    }

    /// Every caller recovers and continues.
    pub mutating fun parse_err(span: Span, msg: String): void {
        if self.speculative { return }
        self.diags.push(error_at(span, msg))
    }

    /// Consumes `o` and returns true, or reports "expected `<o>` <ctx>" and
    /// returns false without consuming, since the token may simply be missing.
    pub mutating fun expect_op(o: Operator, ctx: str): bool {
        val t = self.peek()
        val sp = t.span
        if t.is_op(o) {
            unsafe { self.advance() }
            return true
        }
        val msg = "expected `${op_str(o)}` ${ctx}, found ${tok_str(self.peek())}"
        self.parse_err(sp, msg)
        return false
    }

    pub mutating fun expr_expected_err(span: Span, found: String): void {
        self.parse_err(span, "expected an expression, found ${found}")
    }
}

pub fun Token.is_keyword(kw: Keyword): bool {
    return when (self.kind) {
        KeywordTok(k) => keyword_eq(k, kw)
        Identifier(_) => false
        Op(_) => false
        IntLiteral(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        CharLiteral(_) => false
        Newline => false
        Eof => false
        LexError(_) => false
    }
}

pub fun Token.is_identifier(): bool {
    return when (self.kind) {
        Identifier(_) => true
        KeywordTok(_) => false
        Op(_) => false
        IntLiteral(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        CharLiteral(_) => false
        Newline => false
        Eof => false
        LexError(_) => false
    }
}

pub fun Token.is_int_literal(): bool {
    return when (self.kind) {
        IntLiteral(_) => true
        Identifier(_) => false
        KeywordTok(_) => false
        Op(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        CharLiteral(_) => false
        Newline => false
        Eof => false
        LexError(_) => false
    }
}

/// 0 unless an IntLiteral.
pub fun Token.int_literal_value(): int64 {
    return when (self.kind) {
        IntLiteral(n) => n
        Identifier(_) => 0
        KeywordTok(_) => 0
        Op(_) => 0
        StringLiteral(_) => 0
        FloatLiteral(_) => 0
        CharLiteral(_) => 0
        Newline => 0
        Eof => 0
        LexError(_) => 0
    }
}

pub fun Token.is_char_literal(): bool {
    return when (self.kind) {
        CharLiteral(_) => true
        IntLiteral(_) => false
        Identifier(_) => false
        KeywordTok(_) => false
        Op(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        Newline => false
        Eof => false
        LexError(_) => false
    }
}

/// The text of a plain string literal; an interpolated one never lexes as one.
pub fun Token.string_literal_text(): String? {
    return when (self.kind) {
        StringLiteral(text) => text.clone()
        _ => null
    }
}

/// 0 unless a CharLiteral.
pub fun Token.char_literal_value(): uint32 {
    return when (self.kind) {
        CharLiteral(c) => c
        IntLiteral(_) => 0
        Identifier(_) => 0
        KeywordTok(_) => 0
        Op(_) => 0
        StringLiteral(_) => 0
        FloatLiteral(_) => 0
        Newline => 0
        Eof => 0
        LexError(_) => 0
    }
}

pub fun Token.is_op(op: Operator): bool {
    return when (self.kind) {
        Op(o) => op_eq(o, op)
        KeywordTok(_) => false
        Identifier(_) => false
        IntLiteral(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        CharLiteral(_) => false
        Newline => false
        Eof => false
        LexError(_) => false
    }
}

fun op_eq(a: Operator, b: Operator): bool {
    return op_tag(a) == op_tag(b)
}

fun op_tag(o: Operator): int32 {
    return when (o) {
        Plus => 1
        Minus => 2
        Star => 3
        Slash => 4
        Eq => 5
        EqEq => 6
        BangEq => 7
        Lt => 8
        Gt => 9
        LtEq => 10
        GtEq => 11
        LParen => 12
        RParen => 13
        LBrace => 14
        RBrace => 15
        LBracket => 16
        RBracket => 17
        Comma => 18
        Colon => 19
        Dot => 20
        DotDot => 29
        DotDotEq => 37
        Arrow => 21
        Amp => 22
        Bang => 23
        Semicolon => 24
        AmpAmp => 25
        PipePipe => 26
        Question => 27
        Elvis => 34
        BangBang => 35
        SafeCall => 36
        At => 28
        Pipe => 30
        Caret => 31
        Percent => 32
        Shl => 33
    }
}
