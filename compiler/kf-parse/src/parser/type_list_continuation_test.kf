// A newline is whitespace inside `<...>`.

import core.assert.assert_eq
import alloc.list.*

fun type_list_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun a_funs_type_parameters_may_break(): void {
    assert_eq(type_list_diags("fun g<A,\nB>(a: A, b: B): int32 { return 0 }"), 0, "type parameters of a `fun`")
}

@test fun a_structs_type_parameters_may_break(): void {
    assert_eq(type_list_diags("struct Pair<A,\nB> { pub val a: A\npub val b: B }"), 0, "type parameters of a `struct`")
}

@test fun an_enums_type_parameters_may_break(): void {
    assert_eq(type_list_diags("enum Either<A,\nB> { Left(A)  Right(B) }"), 0, "type parameters of an `enum`")
}

@test fun type_arguments_at_a_call_may_break(): void {
    assert_eq(type_list_diags("""fun g<A, B>(a: A, b: B): int32 { return 0 }
fun f(): int32 {
return g<int32,
int32>(1, 2)
}"""), 0, "type arguments at a call")
}

@test fun a_break_after_the_open_angle(): void {
    assert_eq(type_list_diags("fun g<\nA, B>(a: A, b: B): int32 { return 0 }"), 0, "after `<`")
}

@test fun a_break_before_the_close_angle(): void {
    assert_eq(type_list_diags("fun g<A, B\n>(a: A, b: B): int32 { return 0 }"), 0, "before `>`")
}

@test fun a_bound_list_may_break(): void {
    assert_eq(type_list_diags("""trait Show { fun show(): int32 }
trait Ord { fun cmp(): int32 }
fun g<A: Show
+ Ord>(a: A): int32 { return 0 }"""), 0, "between bounds")
}

// A `<` opening a line is a comparison, so the probe never crosses a newline.

@test fun a_comparison_is_not_read_as_a_type_argument_list(): void {
    assert_eq(type_list_diags("""fun f(n: int32): int32 {
if n < 3 {
return 1
}
return 0
}"""), 0, "the probe must rewind, as it always did")
}

@test fun a_comparison_broken_after_the_operator_still_works(): void {
    assert_eq(type_list_diags("fun f(n: int32): bool {\nval b = n <\n3\nreturn b\n}"), 0, "trailing-operator continuation of a comparison")
}
