// `|a, b| expr` parses, and `|` keeps its infix meanings.

import core.assert.*
import alloc.list.*

fun lambda_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

/// The payload is matched with `_`: binding a List out would double-free.
fun first_init_is_lambda(src: str): bool {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            if body.size() == 0 { return false }
            val s0 = *body.at(0)
            when (s0.kind) {
                LetVal(_n, _t, init_ptr) => {
                    when (unsafe { (init_ptr!!).kind }) {
                        Lambda(_, _) => return true
                        _ => return false
                    }
                }
                _ => return false
            }
        }
        _ => return false
    }
}

@test fun an_annotated_parameter_parses(): void {
    assert_eq(lambda_diags("fun f(): int32 {\nval g = |x: int32| x * 2\nreturn 0\n}"), 0, "`|x: int32| x * 2` parses")
}

@test fun an_unannotated_parameter_parses(): void {
    assert_eq(lambda_diags("fun f(): int32 {\nval g = |x| x * 2\nreturn 0\n}"), 0, "the annotation is optional")
}

@test fun two_parameters_parse(): void {
    assert_eq(lambda_diags("""fun f(): int32 {
val g = |a: int32, b: int32| a + b
return 0
}"""), 0, "parameters are comma-separated")
}

@test fun no_parameters_parses(): void {
    // `||` is one token.
    assert_eq(lambda_diags("fun f(): int32 {\nval g = || 42\nreturn 0\n}"), 0, "`||` opens an empty parameter list")
}

@test fun a_lambda_builds_a_lambda_node(): void {
    assert_eq(first_init_is_lambda("fun f(): int32 {\nval g = |x: int32| x * 2\nreturn 0\n}"), true, "the initializer is a Lambda, not a binary `|`")
}

@test fun an_unclosed_parameter_list_is_an_error(): void {
    assert_eq(lambda_diags("""fun f(): int32 {
val g = |x: int32 x * 2
return 0
}""") > 0, true, "the closing `|` is required")
}

@test fun bitwise_or_still_parses(): void {
    assert_eq(lambda_diags("fun f(): int32 {\nval a: int32 = 6 | 1\nreturn a\n}"), 0, "infix `|` is unaffected")
}

@test fun logical_or_still_parses(): void {
    assert_eq(lambda_diags("""fun f(): int32 {
if true || false { return 0 }
return 1
}"""), 0, "infix `||` is unaffected")
}

@test fun a_bitwise_or_is_not_a_lambda(): void {
    assert_eq(first_init_is_lambda("fun f(): int32 {\nval a: int32 = 6 | 1\nreturn a\n}"), false, "`6 | 1` stays a binary expression")
}
