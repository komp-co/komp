// What an operator or token means, apart from how it is parsed.
//
// CONSTRAINT: every `when` here must list every variant; the compiler does
// not require it on a `when` with a value, and a missing arm returns garbage.

import kf_core.ast.*
import kf_parse.lexer.*

/// Precedence and AST op; higher binds tighter.
pub struct BinOpInfo {
    pub val op:   BinOp
    pub val prec: int32
}

pub fun op_to_binop(o: Operator): BinOpInfo? {
    return when (o) {
        Star => BinOpInfo { op: BinOp.Mul, prec: 10 }
        Slash => BinOpInfo { op: BinOp.Div, prec: 10 }
        Percent => BinOpInfo { op: BinOp.Mod, prec: 10 }
        Plus => BinOpInfo { op: BinOp.Add, prec: 9 }
        Minus => BinOpInfo { op: BinOp.Sub, prec: 9 }
        Shl => BinOpInfo { op: BinOp.Shl, prec: 8 }
        Lt => BinOpInfo { op: BinOp.Lt, prec: 7 }
        Gt => BinOpInfo { op: BinOp.Gt, prec: 7 }
        LtEq => BinOpInfo { op: BinOp.LtEq, prec: 7 }
        GtEq => BinOpInfo { op: BinOp.GtEq, prec: 7 }
        EqEq => BinOpInfo { op: BinOp.Eq, prec: 6 }
        BangEq => BinOpInfo { op: BinOp.NotEq, prec: 6 }
        Amp => BinOpInfo { op: BinOp.BitAnd, prec: 5 }
        Caret => BinOpInfo { op: BinOp.BitXor, prec: 4 }
        Pipe => BinOpInfo { op: BinOp.BitOr, prec: 3 }
        AmpAmp => BinOpInfo { op: BinOp.AndAnd, prec: 2 }
        PipePipe => BinOpInfo { op: BinOp.OrOr, prec: 1 }
        Eq => null
        LParen => null
        RParen => null
        LBrace => null
        RBrace => null
        LBracket => null
        RBracket => null
        Comma => null
        Colon => null
        Dot => null
        DotDot => null
        DotDotEq => null
        Arrow => null
        Bang => null
        Semicolon => null
        Question => null
        // `?:` is handled by parse_let after the initializer; parse_expr stops
        // before it.
        Elvis => null
        // `@` is never infix.
        At => null
        // Postfix, consumed by parse_postfix.
        BangBang => null
        // Postfix, consumed by parse_postfix.
        SafeCall => null
    }
}

pub fun is_op_rbrace(o: Operator): bool {
    return when (o) {
        RBrace => true
        Plus => false
        Minus => false
        Star => false
        Slash => false
        Eq => false
        EqEq => false
        BangEq => false
        Lt => false
        Gt => false
        LtEq => false
        GtEq => false
        LParen => false
        RParen => false
        LBrace => false
        LBracket => false
        RBracket => false
        Comma => false
        Colon => false
        Dot => false
        DotDot => false
        DotDotEq => false
        Arrow => false
        Amp => false
        AmpAmp => false
        PipePipe => false
        Bang => false
        Semicolon => false
        Question => false
        Pipe => false
        Caret => false
        Percent => false
        Shl => false
        Elvis => false
        At => false
        BangBang => false
        SafeCall => false
    }
}

pub fun Token.tok_is_newline(): bool {
    return when (self.kind) {
        Newline => true
        KeywordTok(_) => false
        Identifier(_) => false
        Op(_) => false
        IntLiteral(_) => false
        StringLiteral(_) => false
        FloatLiteral(_) => false
        CharLiteral(_) => false
        Eof => false
        LexError(_) => false
    }
}

impl Parser {
    /// The next non-newline token is `?:`. The elvis may open a continuation
    /// line; nothing else starts with `?:`, so looking past newlines cannot
    /// swallow the next statement.
    pub mutating fun peek_is_elvis(): bool {
        var off = 0
        var found = false
        var scanning = true
        while scanning {
            val t = self.peek_at(off)
            if t.is_op(Operator.Elvis) {
                found = true
                scanning = false
            } else if t.tok_is_newline() {
                off = off + 1
            } else {
                scanning = false
            }
        }
        return found
    }
}
