// `impl<T: Show> Show for Box<T>` declares the impl's parameters up front; the
// target then only uses them. Both spellings reach the same generics: the
// target's parameters, carrying the bounds the list gives them.

import alloc.list.*

import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TypeParam
import kf_parse.parser.*

impl Parser {
    /// Every target parameter must be declared, every declared one used by the
    /// target or lifted from the trait's arguments, and each bounded in one
    /// place only.
    mutating fun merge_declared_params(declared: &List<TypeParam>, target: &List<TypeParam>,
        by_trait: &List<TypeParam>): List<TypeParam> {
        var merged = List.new<TypeParam>()
        while used in &target {
            val found = declared_named(declared, used.name)
            when (found) {
                Some(param) => {
                    if used.bounds.size() > 0 && param.bounds.size() > 0 {
                        val message = "`${used.name.as_str()}` is bounded twice; keep its bounds in `impl<...>`"
                        self.parse_err(used.span, message)
                    }
                    val bounds = if param.bounds.size() > 0 { param.bounds.clone() } else { used.bounds.clone() }
                    merged.push(TypeParam { span: used.span, name: used.name, bounds: bounds })
                }
                None => {
                    val message = "`${used.name.as_str()}` is not declared in `impl<...>`; add it to the list"
                    self.parse_err(used.span, message)
                    merged.push(used.clone())
                }
            }
        }
        while param in &declared {
            if declared_named(target, param.name).is_none() && declared_named(by_trait, param.name).is_none() {
                val message = "`${param.name.as_str()}` is declared in `impl<...>` but neither the target " +
                    "nor the trait's arguments use it"
                self.parse_err(param.span, message)
            }
        }
        return merged
    }
}

fun declared_named(params: &List<TypeParam>, name: Sym): TypeParam? {
    while param in &params {
        if param.name.as_str().equals(name.as_str()) { return param.clone() }
    }
    return null
}

/// `N` in `impl<T, N: uint64> From<T[N]> for List<T>`: a parameter only the
/// trait's arguments name. Each method takes it as its own, so one impl
/// serves every `N`. Returned so the caller can tell it apart from an unused
/// one.
fun lift_trait_arg_params(declared: &List<TypeParam>, target: &List<TypeParam>, trait_args: &List<TypeRef>,
    methods: &var List<TopDecl>): List<TypeParam> {
    var lifted = List.new<TypeParam>()
    while param in &declared {
        if declared_named(target, param.name).is_some() { continue }
        var named = false
        while arg in &trait_args {
            if arg.mentions_name(param.name) { named = true }
        }
        if named { lifted.push(param.clone()) }
    }
    if lifted.size() == 0 { return lifted }
    while i in 0..methods.size() {
        val method = methods.at_mut(i)
        when (method.kind) {
            Function(_params, _ret, _body, _pub, _unsafe, _mutating, _static) => {
                while param in &lifted { method.generics.push(param.clone()) }
            }
            _ => { }
        }
    }
    return lifted
}

/// Whether `name` appears anywhere in this type, its arguments included.
fun TypeRef.mentions_name(name: Sym): bool {
    when (self.kind) {
        Named(head, args) => {
            if head.id == name.id && args.size() == 0 { return true }
            while arg in &args {
                if arg.mentions_name(name) { return true }
            }
            return false
        }
        Reference(_mutable, inner) => return inner.mentions_name(name)
        _ => return false
    }
}
