import core.assert.assert_eq
import core.assert.fail
import alloc.list.*

import kf_core.ast.*
import kf_parse.parser.*

@test fun parse_generic_struct_records_type_params(): void {
    var p = parser_for("struct Pair<A, B> { val a: A val b: B }")
    val td = p.parse_top_decl()
    assert_eq(td.name.as_str(), "Pair", "struct name")
    assert_eq(td.generics.size(), 2, "two type params")
    val tp0 = *td.generics.at(0)
    val tp1 = *td.generics.at(1)
    assert_eq(tp0.name.as_str(), "A", "first param A")
    assert_eq(tp1.name.as_str(), "B", "second param B")
}

@test fun parse_generic_fn_records_type_params(): void {
    var p = parser_for("fun id<T>(x: T): T { return x }")
    val td = p.parse_top_decl()
    assert_eq(td.name.as_str(), "id", "fn name")
    assert_eq(td.generics.size(), 1, "one type param")
    val tp0 = *td.generics.at(0)
    assert_eq(tp0.name.as_str(), "T", "param T")
}

@test fun parse_non_generic_struct_has_no_type_params(): void {
    var p = parser_for("struct Foo { val a: int32 }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 0, "no <> → empty generics")
}

@test fun parse_use_site_generic_call_records_type_args(): void {
    var p = parser_for("id<int32>(5)")
    val e = p.parse_expr()
    assert_eq(e.type_args.size(), 1, "id<int32> → one type arg")
}

@test fun parse_use_site_generic_struct_lit_records_type_args(): void {
    var p = parser_for("Pair<int32, int32> { a: 1, b: 2 }")
    val e = p.parse_expr()
    assert_eq(e.type_args.size(), 2, "Pair<int32,int32> → two type args")
}

@test fun parse_projection_type_arg_is_a_type_arg_list(): void {
    var p = parser_for("List.new<F.Out>()")
    val e = p.parse_expr()
    assert_eq(e.type_args.size(), 1, "List.new<F.Out> → one type arg, not a comparison")
}

@test fun parse_comparison_not_treated_as_generic(): void {
    var p = parser_for("a < b")
    val e = p.parse_expr()
    assert_eq(e.type_args.size(), 0, "a < b → comparison, no type args")
}

@test fun parse_break_stmt(): void {
    var p = parser_for("break")
    val s = p.parse_stmt()
    var is_break: bool = false
    when (s.kind) {
        Break => is_break = true
        _ => is_break = false
    }
    assert_eq(is_break, true, "break → StmtKind.Break")
}

@test fun parse_continue_stmt(): void {
    var p = parser_for("continue")
    val s = p.parse_stmt()
    var is_cont: bool = false
    when (s.kind) {
        Continue => is_cont = true
        _ => is_cont = false
    }
    assert_eq(is_cont, true, "continue → StmtKind.Continue")
}

// `..` is an ordinary binary operator, valid anywhere an expression is.
@test fun parse_range_expression(): void {
    var p = parser_for("0..3")
    val e = p.parse_expr()
    var is_range_call: bool = false
    var argc: uint64 = 0
    when (e.kind) {
        Call(n, args) => {
            is_range_call = n.as_str().equals("range")
            argc = args.size()
        }
        _ => is_range_call = false
    }
    assert_eq(is_range_call, true, "`a..b` builds a `range` call")
    assert_eq(argc, 3, "start, end, and the step that supplies `one`")
}

@test fun a_range_endpoint_takes_a_whole_expression(): void {
    var p = parser_for("1 + 1..2 * 3")
    val e = p.parse_expr()
    when (e.kind) {
        Call(n, args) => {
            assert_eq(n.as_str().equals("range"), true, "still a range call")
            when (args.at(0).kind) {
                Binary(_, _, _) => assert_eq(true, true, "start is `1 + 1`")
                _ => fail("start should be the whole additive expression")
            }
        }
        _ => fail("expected a range call")
    }
}

@test fun parse_if_as_expression(): void {
    var p = parser_for("if c { 1 } else { 2 }")
    val e = p.parse_expr()
    var is_ifexpr: bool = false
    when (e.kind) {
        IfExpr(_, _, _) => is_ifexpr = true
        _ => is_ifexpr = false
    }
    assert_eq(is_ifexpr, true, "if/else in value position → IfExpr")
}

@test fun parse_if_else_if_chain_nests(): void {
    // `else if` nests as another IfExpr.
    var p = parser_for("if a { 1 } else if b { 2 } else { 3 }")
    val e = p.parse_expr()
    var ok: bool = false
    when (e.kind) {
        IfExpr(_, _, else_ptr) => {
            val inner = unsafe { *else_ptr }
            when (inner.kind) {
                IfExpr(_, _, _) => ok = true
                _ => ok = false
            }
        }
        _ => ok = false
    }
    assert_eq(ok, true, "else if nests as an IfExpr else-branch")
}

// Two block-body `when` arms once hung the parser.
@test fun parse_when_with_block_body_arms(): void {
    var p = parser_for("fun f(): int32 { when (1) { 1 => { return 10 } 2 => { return 20 } } return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_method_call(): void {
    var p = parser_for("fun f(): int32 { val x = a.b(c) return x }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

// A method call as a `when` subject once hung the parser.
@test fun parse_when_method_call_subject(): void {
    var p = parser_for("fun f(): int32 { when (a.b(c)) { 1 => { return 1 } 2 => { return 2 } } return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_reference_argument(): void {
    var p = parser_for("fun f(): void { g(&var out, x) }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_import_simple_dotted(): void {
    var p = parser_for("import std.io")
    val imp = p.parse_import()
    assert_eq(imp.path.size(), 2, "two segments")
    assert_eq(imp.wildcard, false, "no wildcard")
}

@test fun parse_import_wildcard(): void {
    var p = parser_for("import std.io.*")
    val imp = p.parse_import()
    assert_eq(imp.path.size(), 2, "two segments before .*")
    assert_eq(imp.wildcard, true, "wildcard flag set")
}

@test fun parse_import_single_segment(): void {
    var p = parser_for("import std")
    val imp = p.parse_import()
    assert_eq(imp.path.size(), 1, "one segment")
    assert_eq(imp.wildcard, false, "no wildcard")
}

@test fun parse_import_three_segments(): void {
    var p = parser_for("import kf_core.ast.expression")
    val imp = p.parse_import()
    assert_eq(imp.path.size(), 3, "three segments")
    assert_eq(imp.wildcard, false, "no wildcard")
}

@test fun parse_module_empty_input(): void {
    var p = parser_for("")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.imports.size(), 0, "no imports")
    assert_eq(m.decls.size(), 0, "no decls")
}

@test fun parse_module_only_imports(): void {
    var p = parser_for("import std.io.*\nimport core.option.*")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.imports.size(), 2, "two imports")
    assert_eq(m.decls.size(), 0, "no decls")
}

@test fun parse_module_imports_then_fun(): void {
    var p = parser_for("import std.io.*\nfun f(): int32 { return 1 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.imports.size(), 1, "one import")
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_module_multiple_funs(): void {
    var p = parser_for("fun a(): int32 { return 1 } fun b(): int32 { return 2 } fun c(): int32 { return 3 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.imports.size(), 0, "no imports")
    assert_eq(m.decls.size(), 3, "three decls")
}

// `import` once hung parse_module.
@test fun parse_module_import_does_not_hang(): void {
    var p = parser_for("import x.y")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.imports.size(), 1, "import recognized as Import keyword")
    assert_eq(m.decls.size(), 0, "no decls — import not misrouted to parse_top_decl")
}

fun first_decl(m: Module): TopDecl {
    return *m.decls.at(0)
}

fun is_struct_kind(td: TopDecl): bool {
    when (td.kind) {
        Struct(_, _) => return true
        _ => return false
    }
}

@test fun parse_module_struct_empty_body(): void {
    var p = parser_for("struct Empty {}")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_struct_kind(first_decl(m)), true, "kind is Struct")
}

@test fun parse_module_struct_one_field(): void {
    var p = parser_for("struct Point { val x: int32 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_struct_kind(first_decl(m)), true, "kind is Struct")
}

@test fun parse_module_struct_multiple_fields(): void {
    var p = parser_for("struct Point { val x: int32 val y: int32 val z: int32 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_module_pub_struct(): void {
    var p = parser_for("pub struct Span { val file_id: uint32 val start: uint32 val end: uint32 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_struct_kind(first_decl(m)), true, "kind is Struct")
}

@test fun parse_module_struct_then_fun(): void {
    var p = parser_for("struct Point { val x: int32 } fun len(): int32 { return 1 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 2, "two decls")
}

fun is_enum_kind(td: TopDecl): bool {
    when (td.kind) {
        EnumDecl(_, _) => return true
        _ => return false
    }
}

@test fun parse_module_enum_simple_variants(): void {
    var p = parser_for("enum Color { Red, Green, Blue }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_enum_kind(first_decl(m)), true, "kind is EnumDecl")
}

@test fun parse_module_enum_with_payload(): void {
    var p = parser_for("enum Tok { Ident(int32), Eof }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_enum_kind(first_decl(m)), true, "kind is EnumDecl")
}

@test fun parse_module_pub_enum(): void {
    var p = parser_for("pub enum Severity { Error, Warning, Note }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_enum_kind(first_decl(m)), true, "kind is EnumDecl")
}

@test fun parse_module_mixed_struct_enum_fun(): void {
    var p = parser_for("struct A { val x: int32 } enum B { Foo } fun c(): int32 { return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 3, "three decls")
}

fun is_impl_kind(td: TopDecl): bool {
    when (td.kind) {
        ImplBlock(_) => return true
        _ => return false
    }
}

fun impl_method_count(td: TopDecl): uint64 {
    when (td.kind) {
        ImplBlock(methods) => return methods.size()
        _ => return 0
    }
}

@test fun parse_fun_records_source_extent(): void {
    val src = "fun id<T>(x: T): T { return x }"
    var p = parser_for(src)
    val td = p.parse_top_decl()
    assert_eq(td.decl_end, 31 as uint32, "decl_end lands just past the closing brace")
}

@test fun parse_pub_struct_extent_starts_at_pub(): void {
    val src = "pub struct Pair<A> { val a: A }"
    var p = parser_for(src)
    val td = p.parse_top_decl()
    assert_eq(td.span.start, 0 as uint32, "span starts at `pub`")
}

@test fun parse_second_decl_extent_is_its_own(): void {
    val src = "fun a(): void { }\nfun b(): void { }"
    var p = parser_for(src)
    val _first = p.parse_top_decl()
    p.skip_newlines()
    val second = p.parse_top_decl()
    assert_eq(second.decl_end, 35 as uint32, "second decl extent ends at its own brace")
}

@test fun parse_annotated_decl_extent_covers_the_decl(): void {
    val src = "@test\nfun t(): void { }"
    var p = parser_for(src)
    val td = p.parse_top_decl()
    assert_eq(td.decl_end, 23 as uint32, "annotation body ends at the decl's brace")
}

@test fun a_decl_diagnostic_points_at_the_name_not_the_keyword(): void {
    // `td.span` opens at `pub`; the diagnostic points at `take`.
    var p = parser_for("pub fun take(): void { }")
    val td = p.parse_top_decl()
    assert_eq(td.span.start, 0 as uint32, "the decl still starts at `pub`")
    assert_eq(td.decl_name_span().start, 8 as uint32, "but a diagnostic about it points at `take`")
}

@test fun an_impl_diagnostic_points_at_the_target_type(): void {
    var p = parser_for("impl Pair { fun a(): void { } }")
    val td = p.parse_top_decl()
    assert_eq(td.decl_name_span().start, 5 as uint32, "past `impl `")
}

@test fun a_trait_impl_points_at_what_it_implements_for(): void {
    var p = parser_for("impl Clone for Pair { fun a(): void { } }")
    val td = p.parse_top_decl()
    assert_eq(td.decl_name_span().start, 15 as uint32, "past `impl Clone for `")
}

@test fun a_decl_with_no_written_name_falls_back_to_its_span(): void {
    // A synthesized declaration has no name span.
    val td = new_top_decl(Span { file_id: 1, start: 7, end: 9 }, String.from("s"), TopDeclKind.Poison)
    assert_eq(td.decl_name_span().start, 7 as uint32, "falls back rather than reporting no location")
}
