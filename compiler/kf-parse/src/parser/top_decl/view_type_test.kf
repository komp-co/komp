// `view struct` and `view enum`; `view` is a word only before them.

import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for

fun view_decl_of(src: str): TopDecl {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    return *m.decls.at(0)
}

fun view_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun a_view_struct_is_a_view(): void {
    assert_eq(view_decl_of("view struct Window { val text: str }").is_view_type(), true, "the modifier marks the type")
}

@test fun a_public_view_enum_is_a_view(): void {
    assert_eq(view_decl_of("pub view enum Piece { Word(str) }").is_view_type(), true, "after `pub`, before `enum`")
}

@test fun a_plain_struct_is_not_a_view(): void {
    assert_eq(view_decl_of("struct Window { val n: int32 }").is_view_type(), false, "nothing is invented")
}

@test fun an_annotated_view_struct_parses(): void {
    val decl = view_decl_of("@derive(Clone)\nview struct Window { val n: int32 }")
    assert_eq(decl.is_view_type(), true, "annotations come first")
}

@test fun view_stays_a_name_elsewhere(): void {
    val source = "fun f(): int32 {\n    val view = 1\n    return view\n}"
    assert_eq(view_diags(source), 0, "only `view struct` and `view enum` read it")
}
