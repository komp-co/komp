// A struct with no fields may leave out its braces.

import core.assert.assert_eq
import alloc.list.*

import kf_parse.parser.parser_for

fun bodiless_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

fun first_struct_field_count(src: str): uint64 {
    var p = parser_for(src)
    val m = p.parse_module(List.new<String>())
    return when (m.decls.at(0).kind) {
        Struct(fields, _) => fields.size()
        _ => 99
    }
}

@test fun a_struct_may_end_at_its_name(): void {
    assert_eq(bodiless_diags("pub struct Geometry\nfun f(): int32 { return 1 }"), 0, "no braces, no fields")
}

@test fun a_struct_may_end_at_the_file(): void {
    assert_eq(bodiless_diags("struct Geometry"), 0, "the end of the file closes it too")
}

@test fun a_bodiless_struct_has_no_fields(): void {
    assert_eq(first_struct_field_count("struct Geometry\n"), 0, "the same declaration as `struct Geometry {}`")
}

@test fun a_generic_struct_may_be_bodiless(): void {
    assert_eq(bodiless_diags("struct Marker<T>\n"), 0, "type parameters come before the missing body")
}

@test fun a_stray_token_after_the_name_is_reported(): void {
    assert_eq(bodiless_diags("struct Geometry x\n") > 0, true, "only the end of the line may stand in for the body")
}
