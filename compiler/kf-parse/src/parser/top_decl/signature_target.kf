import alloc.list.*

import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.MarkTarget
import kf_core.ast.declaration.default_mark_target
import kf_parse.parser.*

impl Parser {
    /// `(A, B) -> R` at the `(`: an exact function type, or a signature
    /// pattern when `_` or a trailing `..` appears in it.
    pub mutating fun parse_signature_target(): MarkTarget {
        val span = self.peek().span
        unsafe { self.advance() } // consume `(`
        var params = List.new<TypeRef>()
        var has_rest = false
        while !is_op(self.peek(), Operator.RParen) && !self.at_eof() {
            if has_rest { self.parse_err(self.peek().span, String.from("`..` must come last: `(bool, ..)`")) }
            if self.take_op(Operator.DotDot) {
                has_rest = true
            } else {
                params.push(self.parse_type_ref())
            }
            if !self.take_op(Operator.Comma) { break }
        }
        if !self.take_op(Operator.RParen) {
            self.parse_err(self.peek().span, String.from("unclosed function type: missing `)`"))
            return default_mark_target(span)
        }
        if !self.take_op(Operator.ThinArrow) {
            self.parse_err(span, String.from("expected a function type after `on`, such as `(Request) -> Response`"))
            return default_mark_target(span)
        }
        val ret = self.parse_type_ref()
        self.reject_misplaced_wildcards(&params, &ret)
        if !has_rest && !params.any_wildcard_slot() && !ret.is_wildcard_slot() {
            return MarkTarget.Function(Box.new(TypeRef.new(span, TypeRefKind.Function(params, Box.new(ret)))))
        }
        return MarkTarget.Signature(params, has_rest, Box.new(ret))
    }

    mutating fun reject_misplaced_wildcards(params: &List<TypeRef>, ret: &TypeRef): void {
        while param in &params {
            self.reject_misplaced_wildcard(param)
        }
        self.reject_misplaced_wildcard(ret)
    }

    mutating fun reject_misplaced_wildcard(slot: &TypeRef): void {
        if slot.is_wildcard_slot() || !slot.mentions_wildcard() { return }
        val why = "`_` stands for a whole parameter or result, or for one behind `&`"
        self.parse_err(slot.span, "${why}")
    }
}

fun List<TypeRef>.any_wildcard_slot(): bool {
    while item in &self {
        if item.is_wildcard_slot() { return true }
    }
    return false
}
