import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.ast.declaration.*
import kf_parse.parser.*

impl Parser {
    /// `template` is a keyword only at the head of `template NAME on`, so it
    /// stays usable as an identifier everywhere else.
    fun at_template_decl(): bool {
        if !self.at_word("template") { return false }
        val named = when (self.peek_at(1).kind) {
            Identifier(_) => true
            _ => false
        }
        if !named { return false }
        return when (self.peek_at(2).kind) {
            Identifier(word) => word.as_str() == "on"
            _ => false
        }
    }

    /// `template NAME on KIND T { declarations }`, consuming `template`.
    mutating fun parse_template_decl(span: Span): TopDecl {
        self.advance() // consume `template`
        val name_at = self.peek().span
        val name = self.expect_name("template")
        self.advance()
        self.advance() // consume `on`
        val kind_at = self.peek().span
        val kind = self.peek_mark_kind()
        if kind == null {
            val found = tok_str(self.peek())
            self.parse_err(kind_at, "expected the kind a template adds to, such as `struct`, found ${found}")
        } else {
            self.advance()
        }
        val marked = self.expect_name("template parameter")
        self.advance()
        val body = self.parse_template_body()
        val template = TopDeclKind.Template(kind ?: MarkKind.Struct, intern(marked.as_str()), body)
        var td = new_top_decl(span, name, template)
        td.name_span = name_at
        return td
    }

    mutating fun parse_template_body(): List<TopDecl> {
        var body = List.new<TopDecl>()
        if !self.take_op(Operator.LBrace) {
            val found = tok_str(self.peek())
            self.parse_err(self.peek().span, "expected `{` to open the template's declarations, found ${found}")
            return body
        }
        while true {
            self.skip_newlines()
            if self.take_op(Operator.RBrace) { break }
            if self.at_eof() {
                self.parse_err(self.peek().span, String.from("unclosed template: missing `}` before the file ends"))
                break
            }
            body.push(self.parse_top_decl())
        }
        return body
    }
}
