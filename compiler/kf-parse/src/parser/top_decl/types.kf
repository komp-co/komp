import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_parse.parser.*

impl Parser {
    mutating fun parse_trait(span: Span, is_pub: bool): TopDecl {
        unsafe { self.advance() } // consume `trait`
        // Read before the name is interned; a Sym has no position.
        val name_at = self.peek().span
        val name = self.expect_name("trait")
        unsafe { self.advance() }
        val tps = self.parse_type_params() // optional <...> on the trait
        val supers = self.parse_supertraits() // optional `: A, B`
        val methods = self.parse_brace_methods()
        var td = new_top_decl(span, name, TopDeclKind.TraitDecl(methods, is_pub, supers))
        td.name_span = name_at
        td.generics = tps
        return td
    }

    /// `: A + B<T>`, or empty. `+`-separated like bounds; a supertrait is a
    /// full TypeRef so it can carry arguments (`Call1<A>: CallMut1<A>`).
    mutating fun parse_supertraits(): List<TypeRef> {
        var supers = List.new<TypeRef>()
        if !is_op(self.peek(), Operator.Colon) {
            return supers
        }
        unsafe { self.advance() } // consume `:`
        while true {
            val sref = self.parse_type_ref_ptr()
            supers.push(unsafe { *sref })
            if is_op(self.peek(), Operator.Plus) {
                unsafe { self.advance() } // consume `+`, next supertrait
            } else if is_op(self.peek(), Operator.Comma) {
                // The old `,` spelling: one error per list, consumed.
                val at = self.peek().span
                unsafe { self.advance() }
                val why = "a trait's requirements are separated by `+`, as a bound's are"
                self.parse_err(at, "${why}: `trait Sortable: Compare + Clone`")
            } else {
                break
            }
        }
        return supers
    }

    /// `<A, B: Bound + Other<A>>`, or empty.
    mutating fun parse_type_params(): List<TypeParam> {
        var params = List.new<TypeParam>()
        if !is_op(self.peek(), Operator.Lt) {
            return params
        }
        unsafe { self.advance() } // consume `<`
        // Newlines are whitespace inside `<...>`.
        while true {
            self.skip_newlines()
            val name_span = self.peek().span
            val name = self.expect_name("type parameter")
            unsafe { self.advance() }
            var tp = new_type_param(name_span, name)
            self.skip_newlines()
            if is_op(self.peek(), Operator.Colon) {
                unsafe { self.advance() } // consume `:`
                while true {
                    self.skip_newlines()
                    val bref = self.parse_type_ref_ptr()
                    tp.bounds.push(unsafe { *bref })
                    self.skip_newlines()
                    if is_op(self.peek(), Operator.Plus) {
                        unsafe { self.advance() } // consume `+`, next bound
                    } else {
                        break
                    }
                }
            }
            params.push(tp)
            self.skip_newlines()
            if is_op(self.peek(), Operator.Comma) {
                unsafe { self.advance() }
            } else {
                break
            }
        }
        self.skip_newlines()
        val _gt = self.expect_op(Operator.Gt, "to close the type-parameter list")
        return params
    }

    /// `fun name(params): ret { body }`.
    mutating fun parse_fun(span: Span, is_pub: bool, is_mutating: bool, is_static: bool): TopDecl {
        unsafe { self.advance() } // consume `fun`
        // `<...>` before the name declares the receiver's parameters.
        val receiver_generics = self.parse_type_params()
        if self.starts_extension() {
            return self.parse_extension_fun(span, is_pub, is_mutating, is_static, receiver_generics)
        }
        if receiver_generics.size() > 0 {
            val why = "a type-parameter list before the name declares an extension receiver's parameters"
            val fix = "a plain function declares its own after the name, as `fun name<T>(...)`"
            self.parse_err(receiver_generics.at(0).span, "${why}; ${fix}")
        }
        var has_name = false
        when (self.peek().kind) {
            Identifier(_name) => { has_name = true }
            _ => { }
        }
        val name_at = self.peek().span
        val name = self.expect_name("function")
        // Only a following `(` is kept after a missing name; other tokens are
        // consumed to stay in sync.
        if has_name || !is_op(self.peek(), Operator.LParen) { unsafe { self.advance() } }

        var tps = receiver_generics // empty, unless the line above reported them
        val own = self.parse_type_params() // optional <T, ...>
        while item in &own {
            tps.push(item)
        }

        val params = self.parse_param_list()
        val ret = self.parse_fun_ret(span)
        val body = self.parse_fun_body(ret)
        var td = new_top_decl(span, name, TopDeclKind.Function(params, ret, body, is_pub, false, is_mutating, is_static))
        td.name_span = name_at
        td.generics = tps
        if !has_name { return new_top_decl(span, "", TopDeclKind.Poison) }
        return td
    }

    /// An omitted `: T` means `void`.
    mutating fun parse_fun_ret(span: Span): Ptr<TypeRef> {
        if is_op(self.peek(), Operator.Colon) {
            unsafe { self.advance() }
            return self.parse_type_ref_ptr()
        }
        val ret: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        unsafe { *ret = new_type_ref(span, TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
        return ret
    }

    /// `?` in the body bails by rebuilding the return type. Saved and restored,
    /// since a lambda body is parsed inside another function's.
    mutating fun parse_fun_body(ret: Ptr<TypeRef>): List<Stmt> {
        val outer_ret = self.fn_ret
        var inner_ret = List.new<TypeRef>()
        inner_ret.push(unsafe { *ret })
        self.fn_ret = inner_ret
        val body = self.parse_block()
        self.fn_ret = outer_ret
        return body
    }

    /// `(a: T, b: U)`. Newlines inside are whitespace.
    mutating fun parse_param_list(): List<Param> {
        var params = List.new<Param>()
        if !is_op(self.peek(), Operator.LParen) {
            self.parse_err(self.peek().span, "expected `(` to open the parameter list, found ${tok_str(self.peek())}")
            return params
        }
        unsafe { self.advance() }
        self.skip_newlines()
        if is_op(self.peek(), Operator.RParen) {
            unsafe { self.advance() }
            return params
        }
        while true {
            self.skip_newlines()
            params.push(self.parse_param())
            self.skip_newlines()
            if is_op(self.peek(), Operator.Comma) {
                unsafe { self.advance() }
            } else {
                break
            }
        }
        self.skip_newlines()
        val _rp = self.expect_op(Operator.RParen, "to close the parameter list")
        return params
    }

    mutating fun parse_param(): Param {
        val name_tok_span = self.peek().span
        val name = self.expect_name("parameter")
        unsafe { self.advance() }
        var ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        if is_op(self.peek(), Operator.Colon) {
            unsafe { self.advance() }
            ty = self.parse_type_ref_ptr()
        } else {
            self.parse_err(self.peek().span, String.from("expected `:` and a type after the parameter name (every parameter needs a type annotation)"))
            unsafe { *ty = type_ref_poison(name_tok_span) }
        }
        return new_param(name_tok_span, name, ty)
    }

    /// `struct Name { val field1: Type, var field2: Type }`, consuming
    /// `struct`.
    mutating fun parse_struct(span: Span, is_pub: bool): TopDecl {
        unsafe { self.advance() } // consume `struct`
        val name_at = self.peek().span
        val name = self.expect_name("struct")
        unsafe { self.advance() }

        val tps = self.parse_type_params() // optional <T, ...>

        var fields = List.new<Field>()

        if is_op(self.peek(), Operator.LBrace) {
            unsafe { self.advance() }
            while true {
                self.skip_newlines()
                if is_op(self.peek(), Operator.RBrace) {
                    unsafe { self.advance() }
                    break
                }
                if self.at_eof() {
                    self.parse_err(self.peek().span, String.from("unclosed struct body: missing `}` before the end of the file"))
                    break
                }
                fields.push(self.parse_field())
                self.skip_newlines()
                if is_op(self.peek(), Operator.Comma) {
                    unsafe { self.advance() }
                }
            }
        } else {
            self.parse_err(self.peek().span, "expected `{` to open the struct body, found ${tok_str(self.peek())}")
        }

        var td = new_top_decl(span, name, TopDeclKind.Struct(fields, is_pub))
        td.name_span = name_at
        td.generics = tps
        return td
    }

    /// `enum Name { Variant, Variant(Type, Type) }`, consuming `enum`.
    mutating fun parse_enum(span: Span, is_pub: bool): TopDecl {
        unsafe { self.advance() } // consume `enum`
        val name_at = self.peek().span
        val name = self.expect_name("enum")
        unsafe { self.advance() }

        val tps = self.parse_type_params() // optional <T, ...>

        var variants = List.new<Variant>()

        if is_op(self.peek(), Operator.LBrace) {
            unsafe { self.advance() }
            while true {
                self.skip_newlines()
                if is_op(self.peek(), Operator.RBrace) {
                    unsafe { self.advance() }
                    break
                }
                if self.at_eof() {
                    self.parse_err(self.peek().span, String.from("unclosed enum body: missing `}` before the end of the file"))
                    break
                }
                variants.push(self.parse_variant())
                self.skip_newlines()
                if is_op(self.peek(), Operator.Comma) {
                    unsafe { self.advance() }
                }
            }
        } else {
            self.parse_err(self.peek().span, "expected `{` to open the enum body, found ${tok_str(self.peek())}")
        }

        var td = new_top_decl(span, name, TopDeclKind.EnumDecl(variants, is_pub))
        td.name_span = name_at
        td.generics = tps
        return td
    }

    mutating fun parse_variant(): Variant {
        val name_span = self.peek().span
        val name = self.expect_name("variant")
        unsafe { self.advance() }

        var payloads = List.new<TypeRef>()
        if is_op(self.peek(), Operator.LParen) {
            unsafe { self.advance() }
            if is_op(self.peek(), Operator.RParen) {
                unsafe { self.advance() }
            } else {
                while true {
                    val tr_ptr = self.parse_type_ref_ptr()
                    payloads.push(unsafe { *tr_ptr })
                    unsafe { dealloc<TypeRef>(tr_ptr) }
                    if is_op(self.peek(), Operator.Comma) {
                        unsafe { self.advance() }
                    } else {
                        break
                    }
                }
                val _rp = self.expect_op(Operator.RParen, "to close the variant's payload list")
            }
        }

        return new_variant(name_span, name, payloads)
    }

    /// `[pub] (val|var) name: Type`.
    mutating fun parse_field(): Field {
        var is_field_pub: bool = false
        if is_keyword(self.peek(), Keyword.Pub) {
            is_field_pub = true
            unsafe { self.advance() }
        }

        var is_var: bool = false
        if is_keyword(self.peek(), Keyword.Var) {
            is_var = true
            unsafe { self.advance() }
        } else if is_keyword(self.peek(), Keyword.Val) {
            unsafe { self.advance() }
        } else {
            // Mutability is never inferred from an omission.
            self.parse_err(self.peek().span, String.from("expected `val` or `var` before the field name — a field declares its own mutability"))
        }

        val name_span = self.peek().span
        val name = self.expect_name("field")
        unsafe { self.advance() }

        var ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        if is_op(self.peek(), Operator.Colon) {
            unsafe { self.advance() }
            ty = self.parse_type_ref_ptr()
        } else {
            self.parse_err(self.peek().span, String.from("expected `:` and a type after the field name (every field needs a type annotation)"))
            unsafe { *ty = type_ref_poison(name_span) }
        }

        return new_field(name_span, name, ty, is_var, is_field_pub)
    }
}
