import core.assert.assert_eq

import kf_core.ast.declaration.Annotation
import kf_parse.parser.parser_for

fun first_annotation(src: str): Annotation {
    var p = parser_for(src)
    return p.parse_top_decl().annotations.at(0).clone()
}

@test fun a_named_argument_keeps_its_name(): void {
    val a = first_annotation("@bench(iterations = 100)\nfun f(): void {}")
    assert_eq(a.args.at(0).name.as_str(), "iterations", "the label before `=`")
}

@test fun a_positional_argument_has_no_name(): void {
    val a = first_annotation("@bench(100)\nfun f(): void {}")
    assert_eq(a.args.at(0).name.as_str(), "", "no label")
}

@test fun an_integer_argument_is_an_expression(): void {
    val a = first_annotation("@bench(iterations = 100, label = \"sort\")\nfun f(): void {}")
    assert_eq(a.to_source().as_str(), "bench(iterations = 100, label = \"sort\")", "both arguments survive")
}

@test fun arguments_may_span_lines(): void {
    val a = first_annotation("@derive(\n    Clone,\n    Equal\n)\nstruct P { val a: int32 }")
    assert_eq(a.words().size(), 2, "newlines inside the parentheses are skipped")
}

@test fun empty_parentheses_are_recorded(): void {
    val a = first_annotation("@bench()\nfun f(): void {}")
    assert_eq(a.has_parens, true, "`@bench()` is not `@bench`")
}

@test fun a_bare_annotation_has_no_parentheses(): void {
    val a = first_annotation("@bench\nfun f(): void {}")
    assert_eq(a.has_parens, false, "no argument list at all")
}

@test fun a_missing_close_paren_is_an_error(): void {
    var p = parser_for("@bench(1 2)\nfun f(): void {}")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "two arguments without a comma")
}
