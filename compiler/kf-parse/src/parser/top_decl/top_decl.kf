import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_parse.lexer.*
import kf_parse.parser.*

impl Parser {
    /// Records each declaration's full extent (`decl_end`), which interfaces
    /// use to slice template bodies.
    pub mutating fun parse_top_decl(): TopDecl {
        var td = self.parse_top_decl_kinded()
        td.decl_end = self.last_consumed_end()
        return td
    }

    mutating fun parse_top_decl_kinded(): TopDecl {
        if is_op(self.peek(), Operator.At) {
            return self.parse_annotated_decl()
        }
        val t = self.peek()
        when (t.kind) {
            KeywordTok(kw) => return self.parse_top_keyword(kw, t.span)
            Identifier(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            Op(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            IntLiteral(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            StringLiteral(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            FloatLiteral(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            CharLiteral(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            Newline => {
                unsafe { self.advance() }
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
            Eof => return new_top_decl(t.span, "", TopDeclKind.Poison)
            LexError(_) => {
                self.parse_err(t.span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(t.span, "", TopDeclKind.Poison)
            }
        }
    }

    /// The run of annotations above a declaration, each recorded verbatim;
    /// unknown names are left for typecheck. Collected in a loop so the list
    /// stays in source order.
    mutating fun parse_annotated_decl(): TopDecl {
        var names = List.new<String>()
        while is_op(self.peek(), Operator.At) {
            unsafe { self.advance() } // consume `@`
            names.push(self.parse_annotation_name())
            self.skip_newlines()
        }
        var td = self.parse_top_decl() // parse the decl they annotate
        td.annotations = names
        return td
    }

    /// "" without an identifier. Arguments are captured verbatim:
    /// `@derive(Default, Equal)` records `"derive(Default,Equal)"`.
    mutating fun parse_annotation_name(): String {
        val t = self.peek()
        when (t.kind) {
            Identifier(s) => {
                val owned_name = s.as_string()
                unsafe { self.advance() }
                if is_op(self.peek(), Operator.LParen) {
                    return owned_name + self.parse_annotation_args()
                }
                return owned_name
            }
            KeywordTok(_) => return ""
            Op(_) => return ""
            IntLiteral(_) => return ""
            StringLiteral(_) => return ""
            FloatLiteral(_) => return ""
            CharLiteral(_) => return ""
            Newline => return ""
            Eof => return ""
            LexError(_) => return ""
        }
    }

    /// `(a, b)` as `"(a,b)"`, stopping at `)` or EOF.
    mutating fun parse_annotation_args(): String {
        unsafe { self.advance() } // consume `(`
        var out = String.from("(")
        var first = true
        while true {
            val t = self.peek()
            if t.is_op(Operator.RParen) { break }
            var done = false
            when (t.kind) {
                Eof => { done = true }
                Identifier(a) => {
                    if !first { out = out + String.from(",") }
                    out = out + a.as_string()
                    first = false
                }
                StringLiteral(text) => {
                    if !first { out = out + String.from(",") }
                    out = out + text
                    first = false
                }
                _ => {}
            }
            if done { break }
            unsafe { self.advance() } // ident, comma, or stray token
        }
        if is_op(self.peek(), Operator.RParen) {
            unsafe { self.advance() } // consume `)`
        }
        return out + String.from(")")
    }

    mutating fun parse_top_keyword(kw: Keyword, span: Span): TopDecl {
        when (kw) {
            Fun => return self.parse_fun(span, false, false, false)
            Pub => {
                unsafe { self.advance() }
                return self.parse_pub_top(span)
            }
            // Unsupported keywords still advance, or parse_module would loop.
            Struct => return self.parse_struct(span, false)
            Enum => return self.parse_enum(span, false)
            Impl => return self.parse_impl(span)
            Extern => return self.parse_extern(span, false)
            Val => return self.advance_and_poison(span)
            Var => return self.advance_and_poison(span)
            Return => return self.advance_and_poison(span)
            If => return self.advance_and_poison(span)
            Else => return self.advance_and_poison(span)
            While => return self.advance_and_poison(span)
            True => return self.advance_and_poison(span)
            False => return self.advance_and_poison(span)
            // An import after a declaration: state the rule.
            Import => {
                self.parse_err(span, String.from("imports must precede the first declaration — move this `import` to the top of the file"))
                unsafe { self.advance() }
                self.sync_to_newline()
                return new_top_decl(span, "", TopDeclKind.Poison)
            }
            When => return self.advance_and_poison(span)
            Mutating => return self.parse_top_mutating(span, false)
            Static => return self.advance_and_poison(span)
            Unsafe => return self.advance_and_poison(span)
            As => return self.advance_and_poison(span)
            Break => return self.advance_and_poison(span)
            Continue => return self.advance_and_poison(span)
            For => return self.advance_and_poison(span)
            In => return self.advance_and_poison(span)
            Trait => return self.parse_trait(span, false)
            // Only valid in a trait or impl body.
            TypeKw => return self.advance_and_poison(span)
            Dyn => return self.advance_and_poison(span)
        }
    }

    /// `mutating` at top level is only for an extension, which has a receiver.
    mutating fun parse_top_mutating(span: Span, is_pub: bool): TopDecl {
        if !is_keyword(self.peek_at(1), Keyword.Fun) { return self.advance_and_poison(span) }
        unsafe { self.advance() } // consume `mutating`
        val decl = self.parse_fun(span, is_pub, true, false)
        if decl.ext_name.as_str().equals("") {
            val message = "only a method or an extension function (`mutating fun Type.name()`) can be `mutating`"
            self.parse_err((&decl).decl_name_span(), message)
        }
        return decl
    }

    mutating fun advance_and_poison(span: Span): TopDecl {
        self.parse_err(span, "expected a declaration (`fun`, `struct`, `enum`, `impl`, `trait`, `extern`, `import`), found ${tok_str(self.peek())}")
        unsafe { self.advance() }
        self.sync_to_newline()
        return new_top_decl(span, "", TopDeclKind.Poison)
    }

    /// One bad line, one error.
    pub mutating fun sync_to_newline(): void {
        while true {
            val t = self.peek()
            when (t.kind) {
                Newline => return
                Eof => return
                _ => { unsafe { self.advance() } }
            }
        }
    }

    mutating fun parse_pub_top(span: Span): TopDecl {
        if is_keyword(self.peek(), Keyword.Fun) {
            return self.parse_fun(span, true, false, false)
        }
        if is_keyword(self.peek(), Keyword.Mutating) {
            return self.parse_top_mutating(span, true)
        }
        if is_keyword(self.peek(), Keyword.Struct) {
            return self.parse_struct(span, true)
        }
        if is_keyword(self.peek(), Keyword.Enum) {
            return self.parse_enum(span, true)
        }
        if is_keyword(self.peek(), Keyword.Extern) {
            return self.parse_extern(span, true)
        }
        if is_keyword(self.peek(), Keyword.Trait) {
            return self.parse_trait(span, true)
        }
        return new_top_decl(span, "", TopDeclKind.Poison)
    }
}
