import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import kf_core.ast.annotation.any_kind_target
import kf_parse.parser.*

impl Parser {
    /// `annotation` is a keyword only at the head of a declaration followed
    /// by a name or its type parameters, so it stays usable as an identifier
    /// everywhere else.
    fun at_annotation_decl(): bool {
        if !self.at_word("annotation") { return false }
        if self.peek_at(1).is_op(Operator.Lt) { return true }
        return when (self.peek_at(1).kind) {
            Identifier(_) => true
            _ => false
        }
    }

    /// `annotation NAME`, with optional `<T: Bound>` before the name,
    /// `(p: T, ...)` and `on TARGET`, consuming `annotation`.
    mutating fun parse_annotation_decl(span: Span, is_pub: bool): TopDecl {
        unsafe { self.advance() } // consume `annotation`
        val type_params = self.parse_type_params()
        val name_at = self.peek().span
        val name = self.expect_name("annotation")
        unsafe { self.advance() }
        val params = if is_op(self.peek(), Operator.LParen) { self.parse_param_list() } else { List.new<Param>() }
        val target = if self.at_word("on") { self.parse_mark_target() } else { default_mark_target(name_at) }
        var td = new_top_decl(span, name, TopDeclKind.AnnotationDecl(params, target, is_pub))
        td.name_span = name_at
        td.generics = type_params
        return td
    }

    /// `on (A, _, ..) -> R`, `on any`, `on KIND, KIND` or `on <KIND: Bound, KIND>`,
    /// consuming `on`. A kind with a bound in a list needs the brackets.
    mutating fun parse_mark_target(): MarkTarget {
        unsafe { self.advance() } // consume `on`
        val at = self.peek().span
        if is_op(self.peek(), Operator.LParen) { return self.parse_signature_target() }
        if self.at_word("any") {
            unsafe { self.advance() }
            return any_kind_target()
        }
        val bracketed = self.take_op(Operator.Lt)
        var kinds = List.new<KindTarget>()
        while self.parse_kind_target(&var kinds) && self.take_op(Operator.Comma) {}
        if bracketed {
            if !self.take_op(Operator.Gt) {
                val found = tok_str(self.peek())
                self.parse_err(self.peek().span, "expected `,` or `>` in the list of kinds, found ${found}")
            }
        } else if kinds.size() > 1 && kinds.any_bound() {
            val example = "`on <struct: Plugin, enum>`"
            self.parse_err(at, "a list of kinds with a bound goes in brackets: ${example}")
        }
        if kinds.size() == 0 { return default_mark_target(at) }
        return MarkTarget.Kinds(kinds)
    }

    /// `KIND` or `KIND: Bound + Bound` onto `kinds`; false, reported, when
    /// the token is not a kind.
    mutating fun parse_kind_target(kinds: &var List<KindTarget>): bool {
        val at = self.peek().span
        val kind = self.peek_mark_kind()
        if kind == null {
            val found = tok_str(self.peek())
            val expected = "a function type, `any`, `fun`, `struct`, `enum`, `trait`, `field` or `variant`"
            self.parse_err(at, "expected ${expected} after `on`, found ${found}")
            return false
        }
        val marked = kind ?: return false
        unsafe { self.advance() }
        var bounds = List.new<TypeRef>()
        if self.take_op(Operator.Colon) {
            while true {
                bounds.push(self.parse_type_ref())
                if !self.take_op(Operator.Plus) { break }
            }
            if !marked.takes_bounds() {
                val why = "only a struct or an enum implements a trait"
                self.parse_err(at, "a `${marked.word()}` target takes no bound: ${why}")
            }
        }
        while listed in &kinds {
            if listed.kind == marked { self.parse_err(at, "`${marked.word()}` is listed twice") }
        }
        kinds.push(KindTarget { kind: marked, bounds: bounds })
        return true
    }

    fun peek_mark_kind(): MarkKind? {
        when (self.peek().kind) {
            Identifier(word) => return when word.as_str() {
                "field" => MarkKind.Field
                "variant" => MarkKind.Variant
                _ => null
            }
            KeywordTok(k) => return when (k) {
                Fun => MarkKind.Function
                Struct => MarkKind.Struct
                Enum => MarkKind.Enum
                Trait => MarkKind.Trait
                _ => null
            }
            _ => return null
        }
    }
}

fun MarkKind.takes_bounds(): bool {
    return when (self) {
        Struct => true
        Enum => true
        _ => false
    }
}

fun List<KindTarget>.any_bound(): bool {
    while listed in &self {
        if listed.bounds.size() > 0 { return true }
    }
    return false
}
