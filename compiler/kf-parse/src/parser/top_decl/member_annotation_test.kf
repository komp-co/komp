import core.assert.assert_eq

import kf_core.ast.declaration.Annotation
import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for

/// The names on the member at `index`, joined by spaces.
fun TopDecl.member_annotation_names(index: uint64): String {
    var out = String.from("")
    val annotations = when (self.kind) {
        Struct(fields, _pub) => fields.at(index).annotations.clone()
        EnumDecl(variants, _pub) => variants.at(index).annotations.clone()
        _ => List.new<Annotation>()
    }
    while annotation in &annotations {
        if out.byte_len() > 0 { out.append(" ") }
        out.append(annotation.to_source().as_str())
    }
    return out
}

@test fun a_field_keeps_its_annotation_run(): void {
    var p = parser_for("struct User {\n    @rename(\"id\")\n    @skip\n    val id: int64\n}")
    val names = p.parse_top_decl().member_annotation_names(0)
    assert_eq(names.as_str(), "rename(\"id\") skip", "both uses, in order")
}

@test fun a_field_without_annotations_has_none(): void {
    var p = parser_for("struct User {\n    @skip\n    val id: int64\n    val name: String\n}")
    val names = p.parse_top_decl().member_annotation_names(1)
    assert_eq(names.as_str(), "", "the run belongs to the field below it")
}

@test fun a_variant_keeps_its_annotation_run(): void {
    var p = parser_for("enum Shape {\n    Square\n    @tag(-1)\n    Circle(float64)\n}")
    val names = p.parse_top_decl().member_annotation_names(1)
    assert_eq(names.as_str(), "tag(-1)", "the negative argument as written")
}

@test fun member_annotations_parse_without_error(): void {
    var p = parser_for("enum Shape {\n    @tag(1) Circle\n}\nstruct P {\n    @skip val x: int32\n}")
    val _shape = p.parse_top_decl()
    val _point = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "a use on the member's own line too")
}

@test fun on_field_and_variant_parse_as_kinds(): void {
    var p = parser_for("annotation either on <field, variant>")
    val parsed = p.parse_top_decl()
    val kinds = when (parsed.kind) {
        AnnotationDecl(_params, target, _pub) => target.kinds().size()
        _ => 0
    }
    assert_eq(kinds, 2, "two kinds")
}
