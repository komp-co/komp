import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for

@test fun a_declared_list_gives_the_target_its_bounds(): void {
    var p = parser_for("impl<A: Show, B> Show for Pair<A, B> {}")
    val m = p.parse_module(List.new<String>())
    assert_eq(first_decl(m).generics.at(0).bounds.size(), 1, "A carries Show from the list")
}

@test fun a_declared_list_on_an_inherent_impl_parses_clean(): void {
    var p = parser_for("impl<T: Copy> Cell<T> { fun get(): T { return self.it } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "the list form of an inherent impl")
}

@test fun a_target_param_missing_from_the_list_is_reported(): void {
    var p = parser_for("impl<A> Show for Pair<A, B> {}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "B is not declared")
}

@test fun a_declared_param_the_target_does_not_use_is_reported(): void {
    var p = parser_for("impl<A, B> Show for Pair<A> {}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "B is declared for nothing")
}

@test fun a_param_bounded_in_both_places_is_reported(): void {
    var p = parser_for("impl<A: Show> Show for Pair<A: Show> {}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "one place for a bound")
}

@test fun a_param_only_the_trait_arguments_name_parses_clean(): void {
    var p = parser_for("impl<T, N: uint64> From<T[N]> for Row<T> { static fun from(items: T[N]): Row<T> { } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "N is named by `From<T[N]>`")
}

@test fun a_param_only_the_trait_arguments_name_is_each_methods_own(): void {
    var p = parser_for("impl<T, N: uint64> From<T[N]> for Row<T> { static fun from(items: T[N]): Row<T> { } }")
    val m = p.parse_module(List.new<String>())
    val methods = when (first_decl(m).kind) {
        TraitImpl(_tref, members) => members
        _ => List.new<TopDecl>()
    }
    assert_eq(methods.at(0).generics.at(0).name.as_str(), "N", "`from` takes N as its own")
}

@test fun a_param_only_the_trait_arguments_name_leaves_the_impl(): void {
    var p = parser_for("impl<T, N: uint64> From<T[N]> for Row<T> { static fun from(items: T[N]): Row<T> { } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(first_decl(m).generics.size(), 1, "the impl keeps only the target's T")
}
