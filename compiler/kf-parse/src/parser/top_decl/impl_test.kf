// Impl and extern parsing, plus when-arm, reference and deref expressions.
// Shares helpers with top_decl_test.kf.

import core.assert.*
import alloc.list.*

import kf_core.ast.*
import kf_parse.parser.parser_for

@test fun parse_module_impl_empty_body(): void {
    var p = parser_for("impl Foo {}")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_impl_kind(first_decl(m)), true, "kind is ImplBlock")
}

@test fun parse_module_impl_one_method(): void {
    var p = parser_for("impl Foo { fun bar(): int32 { return 1 } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(impl_method_count(first_decl(m)), 1, "one method")
}

@test fun parse_module_impl_two_methods(): void {
    var p = parser_for("impl Foo { fun bar(): int32 { return 1 } fun baz(): int32 { return 2 } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(impl_method_count(first_decl(m)), 2, "two methods")
}

@test fun parse_module_struct_then_impl(): void {
    var p = parser_for("struct Foo { val x: int32 } impl Foo { fun get_x(): int32 { return 0 } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 2, "struct + impl")
}

@test fun parse_module_impl_pub_method(): void {
    var p = parser_for("impl Foo { pub fun bar(): int32 { return 1 } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(impl_method_count(first_decl(m)), 1, "pub fun counts as method")
}

fun first_method_decl_end(td: TopDecl): uint32 {
    when (td.kind) {
        ImplBlock(methods) => {
            if methods.size() == 0 { return 0 }
            return methods.at(0).decl_end
        }
        _ => return 0
    }
}

@test fun parse_impl_method_records_source_extent(): void {
    var p = parser_for("impl Foo { fun bar(): int32 { return 1 } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(first_method_decl_end(first_decl(m)), 40 as uint32, "method extent ends at its own brace")
}

fun is_extern_kind(td: TopDecl): bool {
    when (td.kind) {
        Extern(_, _, _, _) => return true
        _ => return false
    }
}

@test fun parse_module_extern_c_fun_no_args(): void {
    var p = parser_for("extern \"C\" fun puts(): int32")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_extern_kind(first_decl(m)), true, "kind is Extern")
}

@test fun parse_module_extern_c_fun_one_arg(): void {
    var p = parser_for("extern \"C\" fun puts(s: str): int32")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_extern_kind(first_decl(m)), true, "kind is Extern")
}

@test fun parse_module_pub_extern(): void {
    var p = parser_for("pub extern \"C\" fun malloc(size: uint64): int32")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    assert_eq(is_extern_kind(first_decl(m)), true, "pub extern is Extern")
}

@test fun parse_when_with_wildcard(): void {
    var p = parser_for("fun f(): int32 { when (1) { _ => return 0 } return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_when_with_int_arms(): void {
    var p = parser_for("fun f(): int32 { when (1) { 1 => return 10, 2 => return 20, _ => return 0 } return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

@test fun parse_when_with_bool_arms(): void {
    var p = parser_for("fun f(): int32 { when (true) { true => return 1, false => return 0 } return 0 }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
}

// `&T` / `&var T` in a parameter type.
@test fun parse_reference_param_type(): void {
    var p = parser_for("fun f(out: &var String, n: uint32): void { }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(params, _r, _b, _pb, _u, _mv, _s) => {
            assert_eq(params.size(), 2, "both params survive the &var type")
            val p0 = *params.at(0)
            val tp = p0.ty
            val typ = unsafe { *tp }
            when (typ.kind) {
                Reference(_mut, _inner) => assert_eq(true, true, "first param is a reference type")
                _ => assert_eq(false, true, "first param should be Reference, not poison")
            }
        }
        _ => assert_eq(false, true, "expected a Function decl")
    }
}

@test fun parse_omitted_return_is_void(): void {
    var p = parser_for("fun f(n: uint32) { }")
    val m = p.parse_module(List.new<String>())
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, ret, _b, _pb, _u, _mv, _s) => {
            val rt = unsafe { *ret }
            when (rt.kind) {
                Named(nm, _a) => assert_eq(nm.as_str(), "void", "omitted return type is void")
                _ => assert_eq(false, true, "omitted return should be Named(void)")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `List.new<T>()` is a MethodCall with type args on the side channel.
@allow(deref_through_temporary)
@test fun parse_new_list_generic_call(): void {
    var p = parser_for("fun f(): void { val xs = List.new<int32>() }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            assert_eq(body.size(), 1, "one stmt")
            val s = *body.at(0)
            val sk = s.kind
            when (sk) {
                LetVal(_n, _ty, init_p) => {
                    val init = unsafe { *(init_p!!) }
                    val ik = init.kind
                    when (ik) {
                        MethodCall(_rcv, mn, cargs) => {
                            assert_eq(mn.as_str(), "new", "method is new")
                            assert_eq(cargs.size(), 0, "no value args")
                            assert_eq(init.type_args.size(), 1, "one type arg")
                        }
                        _ => assert_eq(false, true, "init should be a MethodCall")
                    }
                }
                _ => assert_eq(false, true, "stmt should be LetVal")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `unsafe { *p }` is a Deref.
@allow(deref_through_temporary)
@test fun parse_unsafe_deref_read(): void {
    var p = parser_for("fun f(): void { val x = unsafe { *p } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            val sk = s.kind
            when (sk) {
                LetVal(_n, _ty, init_p) => {
                    val init = unsafe { *(init_p!!) }
                    when (init.kind) {
                        Deref(_inner) => assert_eq(true, true, "init is a Deref")
                        _ => assert_eq(false, true, "init should be Deref, not poison")
                    }
                }
                _ => assert_eq(false, true, "stmt should be LetVal")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `(*p).field` is a FieldAccess on a Deref.
@allow(deref_through_temporary)
@test fun parse_paren_deref_field(): void {
    var p = parser_for("fun f(): void { val x = (*p).field }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            val sk = s.kind
            when (sk) {
                LetVal(_n, _ty, init_p) => {
                    val init = unsafe { *(init_p!!) }
                    when (init.kind) {
                        FieldAccess(recv_p, fname) => {
                            assert_eq(fname.as_str(), "field", "field name")
                            val recv = unsafe { *recv_p }
                            when (recv.kind) {
                                Deref(_inner) => assert_eq(true, true, "receiver is a Deref")
                                _ => assert_eq(false, true, "receiver should be Deref")
                            }
                        }
                        _ => assert_eq(false, true, "init should be FieldAccess")
                    }
                }
                _ => assert_eq(false, true, "stmt should be LetVal")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `0 as T` as an argument keeps its cast and every argument.
@test fun parse_literal_cast_arg_keeps_all_args(): void {
    var p = parser_for("fun f(): void { g(0 as int32, y) }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            when (s.kind) {
                Expression(ep) => {
                    val e = unsafe { *ep }
                    when (e.kind) {
                        Call(cn, cargs) => {
                            assert_eq(cn.as_str(), "g", "callee g")
                            assert_eq(cargs.size(), 2, "both args survive the cast")
                        }
                        _ => assert_eq(false, true, "stmt should be a Call")
                    }
                }
                _ => assert_eq(false, true, "stmt should be Expression")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `&var *p` stays a dereference, tagged as the borrow the author wrote.
@test fun parse_amp_deref_keeps_the_deref(): void {
    var p = parser_for("fun f(): void { g(&var *p) }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            when (s.kind) {
                Expression(ep) => {
                    val e = unsafe { *ep }
                    when (e.kind) {
                        Call(_cn, cargs) => {
                            assert_eq(cargs.size(), 1, "one arg")
                            val a0 = *cargs.at(0)
                            when (a0.kind) {
                                Deref(_) => assert_eq(a0.coerce, coerce_written_amp_var(), "arg is the tagged deref")
                                _ => assert_eq(false, true, "arg should be the Deref of p")
                            }
                        }
                        _ => assert_eq(false, true, "stmt expr should be a Call")
                    }
                }
                _ => assert_eq(false, true, "stmt should be Expression")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `alloc<Expr>()` folds to the callee `alloc__Expr`.
@allow(deref_through_temporary)
@test fun parse_alloc_generic_call(): void {
    var p = parser_for("fun f(): void { val q = unsafe { alloc<Expr>() } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            when (s.kind) {
                LetVal(_n, _ty, init_p) => {
                    val init = unsafe { *(init_p!!) }
                    when (init.kind) {
                        Call(cn, cargs) => {
                            assert_eq(cn.as_str(), "alloc__Expr", "callee folds type arg")
                            assert_eq(cargs.size(), 0, "no value args")
                        }
                        _ => assert_eq(false, true, "init should be a Call")
                    }
                }
                _ => assert_eq(false, true, "stmt should be LetVal")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

// `unsafe { *p = rhs }` is an AssignTo on a Deref.
@test fun parse_unsafe_deref_store(): void {
    var p = parser_for("fun f(): void { unsafe { *p = x } }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            when (s.kind) {
                AssignTo(place_p, _rhs) => {
                    val place = unsafe { *place_p }
                    when (place.kind) {
                        Deref(_inner) => assert_eq(true, true, "place is a Deref")
                        _ => assert_eq(false, true, "place should be Deref")
                    }
                }
                _ => assert_eq(false, true, "stmt should be AssignTo")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}
