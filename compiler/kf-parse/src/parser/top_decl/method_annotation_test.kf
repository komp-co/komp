import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.declaration.Annotation
import kf_parse.parser.parser_for

/// The annotations on the first member of the first declaration.
fun first_member_annotations(src: str): List<Annotation> {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    return when (td.kind) {
        ImplBlock(methods) => methods.at(0).annotations.clone()
        TraitDecl(members, _pub, _supers) => members.at(0).annotations.clone()
        _ => List.new<Annotation>()
    }
}

fun member_count(src: str): uint64 {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    return when (td.kind) {
        ImplBlock(methods) => methods.size()
        _ => 0
    }
}

@test fun an_impl_method_keeps_its_annotation(): void {
    val annotations = first_member_annotations("impl Counter {\n    @bench\n    fun tick(): void {}\n}")
    assert_eq(annotations.at(0).name.as_str(), "bench", "recorded on the method, not skipped")
}

@test fun a_trait_method_keeps_its_annotation(): void {
    val annotations = first_member_annotations("trait Shown {\n    @allow(unused_import)\n    fun show(): String\n}")
    assert_eq(annotations.at(0).to_source().as_str(), "allow(unused_import)", "with its arguments")
}

@test fun a_run_of_annotations_on_a_method_stays_in_order(): void {
    val annotations = first_member_annotations("impl Counter {\n    @a\n    @b(1)\n    fun tick(): void {}\n}")
    assert_eq(annotations.at(1).name.as_str(), "b", "the second is second")
}

@test fun an_annotation_is_not_taken_for_a_member(): void {
    val count = member_count("impl Counter {\n    @bench\n    fun tick(): void {}\n}")
    assert_eq(count, 1 as uint64, "one method, not two")
}

@test fun an_unannotated_method_after_an_annotated_one_has_none(): void {
    var p = parser_for("impl Counter {\n    @bench\n    fun tick(): void {}\n    fun tock(): void {}\n}")
    val td = p.parse_top_decl()
    val second = when (td.kind) {
        ImplBlock(methods) => methods.at(1).annotations.size()
        _ => 99 as uint64
    }
    assert_eq(second, 0 as uint64, "the run belongs to the first method only")
}
