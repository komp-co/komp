// `fun Receiver.name(...)`: parsed as an ordinary function whose first
// parameter is `self`, under a hidden name so several extensions of one name
// coexist; `TopDecl.ext_name` keeps the written name. Typecheck decides which
// receiver names are type parameters, except those declared in a list before
// the receiver (`fun <T: Add> Iterable<T>.sum()`), the one place such a
// parameter can be bounded.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.subst.clone_type_ref
import kf_parse.parser.*

fun TypeRef.type_ref_head_name(): String {
    when (self.kind) {
        Named(name, _args) => return name.as_string()
        _ => return String.from("")
    }
}

/// Names in the receiver with no type arguments: the possible type parameters.
fun TypeRef.collect_receiver_names(out: &var List<String>): void {
    when (self.kind) {
        Named(name, args) => {
            if args.size() == 0 { out.push(name.as_string()) }
            while arg in &args {
                arg.collect_receiver_names(out)
            }
        }
        _ => { }
    }
}

fun receiver_mentions(names: &List<String>, wanted: str): bool {
    while n in &names {
        if n.as_str().equals(wanted) { return true }
    }
    return false
}

/// By value for types copied anyway (numbers, `bool`, `char`, `str`, `Ptr`),
/// by reference otherwise, `&var` for a `mutating` extension.
fun TypeRef.receiver_param(is_mutating: bool): Param {
    val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    if !is_mutating && self.receiver_is_copied() {
        unsafe { *ty = clone_type_ref(self) }
    } else {
        val inner: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        unsafe { *inner = clone_type_ref(self) }
        unsafe { *ty = new_type_ref(self.span, TypeRefKind.Reference(is_mutating, inner)) }
    }
    return new_param(self.span, String.from("self"), ty)
}

fun TypeRef.receiver_is_copied(): bool {
    when (self.kind) {
        Named(name, _args) => {
            val n = name.as_str()
            if n == "int8" || n == "int16" || n == "int32" || n == "int64" { return true }
            if n == "uint8" || n == "uint16" || n == "uint32" || n == "uint64" { return true }
            return n == "float32" || n == "float64" || n == "bool" || n == "char" || n == "str" || n == "Ptr"
        }
        _ => return false
    }
}

/// `<name>_ext_<receiver>`, single underscores only (`area_ext_List_Point`):
/// `__` is the generic-instance separator.
pub fun extension_link_name(name: str, receiver: &TypeRef): String {
    var out = String.from(name)
    out.append("_ext_")
    out.append(receiver.receiver_spelling().as_str())
    return out
}

fun TypeRef.receiver_spelling(): String {
    when (self.kind) {
        Named(name, args) => {
            var out = name.as_string().replace("__", "_")
            while arg in &args {
                out.append("_")
                out.append(arg.receiver_spelling().as_str())
            }
            return out
        }
        _ => return String.from("x")
    }
}

impl Parser {
    /// A name, an optional `<...>`, then `.name`. A plain function has `(` or
    /// `<...>(` after its name.
    mutating fun starts_extension(): bool {
        when (self.peek().kind) {
            Identifier(_name) => { }
            _ => return false
        }
        var at: uint64 = 1
        if is_op(self.peek_at(at), Operator.Lt) {
            var depth: uint64 = 0
            while true {
                val tok = self.peek_at(at)
                if tok.is_op(Operator.Lt) { depth = depth + 1 }
                if tok.is_op(Operator.Gt) {
                    depth = depth - 1
                    if depth == 0 { break }
                }
                when (tok.kind) {
                    Eof => return false
                    Newline => return false
                    _ => { }
                }
                if tok.is_op(Operator.LBrace) || tok.is_op(Operator.LParen) { return false }
                at = at + 1
            }
            at = at + 1
        }
        return is_op(self.peek_at(at), Operator.Dot)
    }

    /// `fun <Recv> Receiver.name<Own>(params): Ret { body }`, with `fun` and the
    /// receiver's parameter list already consumed.
    mutating fun parse_extension_fun(span: Span, is_pub: bool, is_mutating: bool, is_static: bool, receiver_generics: List<TypeParam>): TopDecl {
        val receiver_at = self.peek().span
        val receiver_name = self.expect_name("receiver type")
        unsafe { self.advance() }
        val receiver_args = self.parse_receiver_arguments(receiver_name.as_str())
        val receiver = new_type_ref(receiver_at, TypeRefKind.Named(intern(receiver_name.as_str()), receiver_args))
        unsafe { self.advance() } // consume `.`
        val name_at = self.peek().span
        val name = self.expect_name("extension function")
        unsafe { self.advance() }
        if is_static {
            self.parse_err(name_at, String.from("an extension function is called on a value, so it cannot be `static`"))
        }
        val own_generics = self.parse_type_params()
        self.reject_redeclared_receiver_params(&receiver, &own_generics)
        self.reject_unused_receiver_generics(&receiver, &receiver_generics)
        val written = self.parse_param_list()
        var params = List.new<Param>()
        params.push(receiver.receiver_param(is_mutating))
        while item in &written {
            params.push(item)
        }
        val ret = self.parse_fun_ret(span)
        val body = self.parse_fun_body(ret)
        val kind = TopDeclKind.Function(params, ret, body, is_pub, false, false, false)
        var td = new_top_decl(span, extension_link_name(name.as_str(), &receiver), kind)
        td.name_span = name_at
        // The function's own parameters come first, so an explicit type
        // argument at a call site means one of them.
        var generics = own_generics
        while receiver_generic in &receiver_generics {
            generics.push(receiver_generic)
        }
        td.generics = generics
        td.ext_name = intern(name.as_str())
        return td
    }

    /// A bound written here is reported and skipped rather than cascading.
    mutating fun parse_receiver_arguments(receiver_name: str): List<TypeRef> {
        var args = List.new<TypeRef>()
        if !is_op(self.peek(), Operator.Lt) { return args }
        unsafe { self.advance() } // consume `<`
        while true {
            if is_op(self.peek(), Operator.Gt) {
                unsafe { self.advance() }
                break
            }
            if self.at_eof() {
                self.parse_err(self.peek().span, String.from("unclosed type-argument list: missing `>`"))
                break
            }
            val before: uint64 = self.pos
            val arg_ptr = self.parse_type_ref_ptr()
            val arg: TypeRef = unsafe { *arg_ptr }
            unsafe { dealloc<TypeRef>(arg_ptr) }
            if is_op(self.peek(), Operator.Colon) { self.report_receiver_bound(&arg, receiver_name) }
            args.push(arg)
            if is_op(self.peek(), Operator.Comma) {
                unsafe { self.advance() }
            }
            if self.pos == before { break }
        }
        return args
    }

    /// `fun Iterable<T: Add>.sum()`: names the list that can carry the bound.
    mutating fun report_receiver_bound(arg: &TypeRef, receiver_name: str): void {
        val at = self.peek().span
        unsafe { self.advance() } // consume `:`
        var shown = String.from("")
        while true {
            val bound_ptr = self.parse_type_ref_ptr()
            if shown.byte_len() == 0 { shown = (unsafe { &*bound_ptr }).type_ref_head_name() }
            unsafe { dealloc<TypeRef>(bound_ptr) }
            if !is_op(self.peek(), Operator.Plus) { break }
            unsafe { self.advance() } // consume `+`, next bound
        }
        if shown.byte_len() == 0 { shown = String.from("Bound") }
        val n = arg.type_ref_head_name()
        val decl = "${n.as_str()}: ${shown.as_str()}"
        val why = "`${receiver_name}`'s arguments name types, not bounds"
        val fix = "declare `${decl.as_str()}` in a list before the receiver, as `fun <${decl.as_str()}> ...`"
        self.parse_err(at, "${why}; ${fix}")
    }

    /// A parameter the receiver introduces may not be declared again after
    /// the name.
    mutating fun reject_redeclared_receiver_params(receiver: &TypeRef, own: &List<TypeParam>): void {
        var names = List.new<String>()
        receiver.collect_receiver_names(&var names)
        while tp in &own {
            val n = tp.name.as_str()
            if receiver_mentions(&names, n) {
                var shown = String.from("Bound")
                if tp.bounds.size() > 0 { shown = (tp.bounds.at(0)).type_ref_head_name() }
                val why = "`${n}` is introduced by the receiver, so the list after the name cannot declare it again"
                val fix = "declare it before the receiver instead, as `fun <${n}: ${shown.as_str()}> ...`"
                self.parse_err(tp.span, "${why}; ${fix}")
            }
        }
    }

    /// A parameter the receiver does not use belongs in the function's own
    /// list.
    mutating fun reject_unused_receiver_generics(receiver: &TypeRef, front: &List<TypeParam>): void {
        var names = List.new<String>()
        receiver.collect_receiver_names(&var names)
        while tp in &front {
            val n = tp.name.as_str()
            if !receiver_mentions(&names, n) {
                val why = "`${n}` is not used by the receiver, so it is this function's own type parameter"
                self.parse_err(tp.span, "${why}; declare it after the name, as `fun ... .name<${n}>(...)`")
            }
        }
    }
}
