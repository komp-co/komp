import core.assert.assert_eq

import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for

fun TopDecl.first_param_type(): TypeRef {
    when (self.kind) {
        Function(params, _ret, _body, _is_pub, _is_unsafe, _is_mutating, _is_static) => {
            return unsafe { *params.at(0).ty }
        }
        _ => return TypeRef.new_poison(self.span)
    }
}

fun TopDecl.param_count(): uint64 {
    when (self.kind) {
        Function(params, _ret, _body, _is_pub, _is_unsafe, _is_mutating, _is_static) => return params.size()
        _ => return 0
    }
}

fun TypeRef.is_reference(mutable: bool): bool {
    when (self.kind) {
        Reference(m, _inner) => return m == mutable
        _ => return false
    }
}

@test fun an_extension_keeps_its_name_and_gets_a_hidden_one(): void {
    var p = parser_for("fun List<Point>.area(): int32 { return 0 }")
    val td = p.parse_top_decl()
    assert_eq(td.ext_name.as_str(), "area", "the name it is called by")
    assert_eq(td.name.as_str(), "area_ext_List_Point", "the name it is registered under")
    assert_eq(p.diags.size(), 0, "no parse errors")
}

@test fun an_extension_takes_its_receiver_as_self(): void {
    var p = parser_for("fun Point.dist(other: Point): int32 { return 0 }")
    val td = p.parse_top_decl()
    assert_eq(td.param_count(), 2, "self, then the written parameter")
    assert_eq(is_reference(&td.first_param_type(), false), true, "a struct receiver is borrowed")
}

@test fun a_mutating_extension_borrows_its_receiver_mutably(): void {
    var p = parser_for("mutating fun Counter.bump(): void { }")
    val td = p.parse_top_decl()
    assert_eq(is_reference(&td.first_param_type(), true), true, "`&var self`")
    assert_eq(p.diags.size(), 0, "`mutating` is allowed on an extension")
}

@test fun a_number_receiver_is_passed_by_value(): void {
    var p = parser_for("fun int32.twice(): int32 { return self * 2 }")
    val td = p.parse_top_decl()
    when (td.first_param_type().kind) {
        Named(name, _args) => assert_eq(name.as_str(), "int32", "self is the number itself")
        _ => assert_eq(false, true, "self is the number itself")
    }
}

@test fun an_extension_declares_only_its_own_type_parameters(): void {
    var p = parser_for("fun List<T>.map_to<U>(x: U): U { return x }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 1, "the receiver's `T` is left to typecheck")
    assert_eq(td.generics.at(0).name.as_str(), "U", "the function's own parameter")
}

@test fun a_generic_function_is_not_an_extension(): void {
    var p = parser_for("fun id<T>(x: T): T { return x }")
    val td = p.parse_top_decl()
    assert_eq(td.ext_name.as_str(), "", "`<T>(` is a plain generic function")
    assert_eq(td.name.as_str(), "id", "under its own name")
}

@test fun a_static_extension_is_rejected(): void {
    var p = parser_for("impl Point { static fun int32.x(): int32 { return 1 } }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "an extension has a receiver, so it cannot be static")
}

@test fun mutating_needs_a_receiver(): void {
    var p = parser_for("mutating fun plain(): void { }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "a plain function has nothing to mutate")
}

@test fun a_list_before_the_receiver_declares_its_parameters(): void {
    var p = parser_for("fun <T: Add> Iterable<T>.sum(zero: T): T { return zero }")
    val td = p.parse_top_decl()
    assert_eq(td.ext_name.as_str(), "sum", "still an extension")
    assert_eq(td.generics.size(), 1, "the receiver's `T`, declared in front")
    assert_eq(td.generics.at(0).bounds.size(), 1, "carrying its bound")
    assert_eq(p.diags.size(), 0, "no parse errors")
}

@test fun the_receivers_parameters_come_after_the_functions_own(): void {
    var p = parser_for("fun <T: Clone> T.take_if<F: Call1<T>>(keep: F): T? { return null }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 2, "both lists")
    assert_eq(td.generics.at(0).name.as_str(), "F", "an explicit type argument means the function's own")
    assert_eq(td.generics.at(1).name.as_str(), "T", "the receiver's follows it")
}

@test fun a_receiver_parameter_is_not_declared_twice(): void {
    var p = parser_for("fun T.level<T: Loud>(): int32 { return 0 }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "the receiver already introduced `T`")
}

@test fun a_parameter_the_receiver_does_not_use_belongs_after_the_name(): void {
    var p = parser_for("fun <U> List<T>.count_all(): uint64 { return 0 }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "`U` is the function's own")
}

@test fun a_plain_function_declares_its_parameters_after_its_name(): void {
    var p = parser_for("fun <T> id(x: T): T { return x }")
    val td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "the list before the name is an extension's")
    assert_eq(td.generics.size(), 1, "and is kept, so the body still reads")
}

@test fun a_bound_in_a_receiver_names_the_list_it_belongs_in(): void {
    var p = parser_for("fun Iterable<T: Add>.sum(): T { return self }")
    val td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "one error, not a cascade through the signature")
    assert_eq(td.ext_name.as_str(), "sum", "and the rest of the signature still parses")
}
