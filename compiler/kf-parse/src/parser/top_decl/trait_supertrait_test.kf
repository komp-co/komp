import core.assert.assert_eq
import core.assert.fail
import alloc.list.*
import kf_parse.parser.parser_for

@test fun parse_trait_records_one_supertrait(): void {
    var p = parser_for("trait Compare: Equal { fun compare(other: Self): int32 }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitDecl(methods, _pub, supers) => {
            assert_eq(supers.size(), 1, "one supertrait")
            assert_eq(tyref_named_name(*supers.at(0)).as_str(), "Equal", "supertrait is Equal")
            assert_eq(methods.size(), 1, "the body still parses")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_trait_records_several_supertraits(): void {
    var p = parser_for("trait Sortable: Compare + Clone { }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitDecl(_methods, _pub, supers) => {
            assert_eq(supers.size(), 2, "two supertraits")
            assert_eq(tyref_named_name(*supers.at(0)).as_str(), "Compare", "first is Compare")
            assert_eq(tyref_named_name(*supers.at(1)).as_str(), "Clone", "second is Clone")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_supertrait_carries_type_args(): void {
    var p = parser_for("trait Call1<A>: CallMut1<A> { fun call(a: A): int32 }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 1, "trait param A")
    when (td.kind) {
        TraitDecl(_methods, _pub, supers) => {
            assert_eq(supers.size(), 1, "one supertrait")
            assert_eq(tyref_named_name(*supers.at(0)).as_str(), "CallMut1", "supertrait head is CallMut1")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_trait_without_supertraits_is_empty(): void {
    var p = parser_for("trait Equal { fun equals(other: Self): bool }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitDecl(_methods, _pub, supers) => assert_eq(supers.size(), 0, "no supertraits")
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun a_comma_between_requirements_names_the_separator(): void {
    var p = parser_for("trait Sortable: Compare, Clone { }")
    val td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "one error for the list, not a cascade")
    when (td.kind) {
        TraitDecl(_methods, _pub, supers) => assert_eq(supers.size(), 2, "and both requirements still parse")
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}
