// Annotation, trait, impl-for, mutating, bound and while-in parse tests.
// Shares helpers with top_decl_test.kf.

import core.assert.assert_eq
import core.assert.fail
import alloc.list.*

import kf_core.ast.*
import kf_parse.parser.parser_for

// `e.field = rhs` is an AssignTo on a FieldAccess.
@test fun parse_deref_field_store(): void {
    var p = parser_for("fun f(): void { (*e).ty = t }")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "one decl")
    val td = *m.decls.at(0)
    val k = td.kind
    when (k) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            val s = *body.at(0)
            when (s.kind) {
                AssignTo(place_p, _rhs) => {
                    val place = unsafe { *place_p }
                    when (place.kind) {
                        FieldAccess(recv_p, fname) => {
                            assert_eq(fname.as_str(), "ty", "field name")
                            val recv = unsafe { *recv_p }
                            when (recv.kind) {
                                Deref(_inner) => assert_eq(true, true, "place receiver is a Deref")
                                _ => assert_eq(false, true, "place receiver should be Deref")
                            }
                        }
                        _ => assert_eq(false, true, "place should be FieldAccess")
                    }
                }
                _ => assert_eq(false, true, "stmt should be AssignTo")
            }
        }
        _ => assert_eq(false, true, "expected Function")
    }
}

@test fun parse_test_annotation_recorded(): void {
    var p = parser_for("@test fun foo(): void {}")
    val td = p.parse_top_decl()
    assert_eq(td.annotations.at(0).as_str(), "test", "@test → annotation == test")
}

@test fun parse_unannotated_fun_has_empty_annotation(): void {
    var p = parser_for("fun foo(): void {}")
    val td = p.parse_top_decl()
    assert_eq(td.annotations.size(), 0, "plain fun → no annotations")
}

@test fun parse_unknown_annotation_recorded_not_rejected(): void {
    var p = parser_for("@inline fun foo(): void {}")
    val td = p.parse_top_decl()
    assert_eq(td.annotations.at(0).as_str(), "inline", "@inline recorded verbatim, not rejected")
}

@test fun parse_derive_annotation_captures_args(): void {
    var p = parser_for("@derive(Default) struct S { var x: int32 }")
    val td = p.parse_top_decl()
    assert_eq(td.annotations.at(0).as_str(), "derive(Default)", "@derive(Default) → annotation carries the arg")
}

@test fun parse_derive_annotation_multiple_traits(): void {
    var p = parser_for("@derive(Default, Equal) struct S { var x: int32 }")
    val td = p.parse_top_decl()
    assert_eq(td.annotations.at(0).as_str(), "derive(Default,Equal)", "@derive lists comma-joined traits")
}

@test fun parse_trait_records_required_method(): void {
    var p = parser_for("trait Clone { fun clone(): int32 }")
    val td = p.parse_top_decl()
    assert_eq(td.name.as_str(), "Clone", "trait name")
    when (td.kind) {
        TraitDecl(methods, _pub, _) => {
            assert_eq(methods.size(), 1, "one required method")
            val m0 = *methods.at(0)
            assert_eq(m0.name.as_str(), "clone", "method name clone")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_trait_impl_for_type(): void {
    var p = parser_for("impl Clone for Pair<A, B> { fun clone(): int32 { return 0 } }")
    val td = p.parse_top_decl()
    assert_eq(td.name.as_str(), "Pair", "impl target is Pair")
    assert_eq(td.generics.size(), 2, "impl generics A,B")
    when (td.kind) {
        TraitImpl(tref, methods) => {
            assert_eq(tyref_named_name(unsafe { *tref }).as_str(), "Clone", "trait ref is Clone")
            assert_eq(methods.size(), 1, "one method")
        }
        _ => assert_eq(false, true, "expected TraitImpl")
    }
}

@test fun parse_inherent_impl_still_implblock(): void {
    var p = parser_for("impl Pair<A, B> { fun first(): int32 { return 0 } }")
    val td = p.parse_top_decl()
    when (td.kind) {
        ImplBlock(_) => assert_eq(true, true, "inherent impl stays ImplBlock")
        _ => assert_eq(false, true, "expected ImplBlock")
    }
}

fun tyref_named_name(tr: TypeRef): String {
    when (tr.kind) {
        Named(n, _args) => return n.as_string()
        _ => return ""
    }
}

// A keyword where a name is required is an error, not a silent "_".

@test fun keyword_as_variable_name_is_a_parse_error(): void {
    var p = parser_for("fun main(): int32 {\nval when = 5\nreturn 0\n}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "one parse error for `val when`")
}

@test fun keyword_as_fun_and_struct_name_are_parse_errors(): void {
    var p = parser_for("struct impl { val a: int32 }\nfun return(): int32 { return 0 }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 2, "struct `impl` + fun `return`")
}

@test fun keyword_error_names_the_keyword(): void {
    var p = parser_for("fun main(): int32 {\nval fun = 1\nreturn 0\n}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "one error")
    val d = *p.diags.at(0)
    assert_eq(d.primary.message.as_str(), "`fun` is a keyword and cannot be used as a variable name", "message names the keyword and the role")
}

@test fun valid_names_produce_no_parse_errors(): void {
    var p = parser_for("struct Pair { val a: int32 }\nfun main(): int32 {\nval x = 1\nreturn x\n}")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "clean program parses with zero diags")
}

fun diag_count(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun missing_eq_in_binding_is_an_error(): void {
    assert_eq(diag_count("fun f(): int32 {\nval x 5\nreturn x\n}"), 1, "val x 5 -> missing `=`")
}

@test fun missing_init_expr_is_an_error(): void {
    assert_eq(diag_count("fun f(): int32 {\nval x =\nreturn 0\n}"), 1, "val x = <eol> -> missing expression")
}

@test fun missing_struct_brace_is_an_error(): void {
    assert_eq(diag_count("struct P\nfun f(): int32 { return 0 }") > 0, true, "struct without body")
}

@test fun unclosed_fn_block_is_an_error(): void {
    assert_eq(diag_count("fun f(): int32 {\nreturn 0\n") > 0, true, "missing closing brace")
}

@test fun missing_param_type_is_an_error(): void {
    assert_eq(diag_count("fun f(a): int32 { return a }"), 1, "param without `: type`")
}

@test fun missing_when_arrow_is_an_error(): void {
    assert_eq(diag_count("""fun f(x: int32): int32 {
when (x) {
1 { return 1 }
_ => { return 0 }
}
return 0
}"""), 1, "arm without =>")
}

@test fun stray_token_at_top_level_is_one_error(): void {
    // One diagnostic per garbage line.
    assert_eq(diag_count("42 + 17 foo bar\nfun f(): int32 { return 0 }"), 1, "one error per garbage line")
}

@test fun import_without_path_is_an_error(): void {
    assert_eq(diag_count("import 42\nfun f(): int32 { return 0 }"), 1, "import needs a module path")
}

@test fun unclosed_call_paren_is_an_error(): void {
    assert_eq(diag_count("""fun g(a: int32): int32 { return a }
fun f(): int32 {
return g(1
}""") > 0, true, "missing `)` on call")
}

@test fun keyword_in_expression_position_is_an_error(): void {
    assert_eq(diag_count("fun f(): int32 {\nval x = struct\nreturn 0\n}"), 1, "keyword where an expression belongs")
}

@test fun clean_source_still_zero_diags(): void {
    val src = """import a.b.*
struct P<T> { val x: T }
enum E { A, B(int32) }
impl P<int32> { fun get(): int32 { return self.x } }
fun f(n: int32): int32 {
var acc = 0
while i in 0..n {
acc = acc + i
}
when (acc) {
0 => return 0
_ => return acc
}
return acc
}"""
    assert_eq(diag_count(src), 0, "representative valid syntax parses clean")
}

@test fun lex_error_is_reported_up_front(): void {
    assert_eq(diag_count("fun f(): int32 {\nval x = 1 $ 2\nreturn 0\n}") > 0, true, "bad character diagnosed")
}

@test fun unterminated_string_is_reported(): void {
    assert_eq(diag_count("fun f(): str {\nreturn \"oops\n}") > 0, true, "unterminated string diagnosed")
}

@test fun bad_type_annotation_is_an_error(): void {
    assert_eq(diag_count("fun f(a: 42): int32 { return 0 }") > 0, true, "integer literal is not a type")
}

@test fun unclosed_generic_type_terminates_with_error(): void {
    // `List<int32` without `>` once hung the compiler.
    assert_eq(diag_count("fun f(): int32 {\nval x: List<int32\nreturn 0\n}") > 0, true, "unclosed type args diagnosed, no hang")
}

@test fun comparison_is_not_a_type_error(): void {
    // The probe for `n < 3` as a generic call must not report.
    assert_eq(diag_count("""fun f(n: int32): int32 {
if n < 3 {
return 1
}
return 0
}"""), 0, "comparison parses clean")
}

@test fun nested_comparison_in_while_is_clean(): void {
    assert_eq(diag_count("""fun f(xs: List<int32>): int32 {
var i: uint64 = 0
while i < xs.size() {
i = i + 1
}
return 0
}"""), 0, "while i < call() parses clean")
}

fun impl_method_is_mutating(td: TopDecl, i: uint64): bool {
    when (td.kind) {
        ImplBlock(methods) => {
            val m = *methods.at(i)
            when (m.kind) {
                Function(_, _, _, _, _, is_mut, _) => return is_mut
                _ => return false
            }
        }
        _ => return false
    }
}

@test fun parse_impl_mutating_flag_lands_on_ast(): void {
    var p = parser_for("impl Foo { mutating fun bump(): void { } fun peek(): int32 { return 1 } pub mutating fun grow(): void { } }")
    val m = p.parse_module(List.new<String>())
    val td = first_decl(m)
    assert_eq(impl_method_is_mutating(td, 0), true, "mutating fun -> is_mutating")
    assert_eq(impl_method_is_mutating(td, 1), false, "plain fun -> not mutating")
    assert_eq(impl_method_is_mutating(td, 2), true, "pub mutating fun -> is_mutating")
}

fun bound_head_name(tr: TypeRef): String {
    when (tr.kind) {
        Named(n, _) => return n.as_string()
        _ => return ""
    }
}

@test fun parse_type_param_single_bound(): void {
    var p = parser_for("fun show_all<T: Display>(x: T): void { }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 1, "one type param")
    val tp = *td.generics.at(0)
    assert_eq(tp.name.as_str(), "T", "param T")
    assert_eq(tp.bounds.size(), 1, "one bound")
    assert_eq(bound_head_name(*tp.bounds.at(0)).as_str(), "Display", "bound is Display")
}

@test fun parse_type_param_plus_bounds_and_generic_bound(): void {
    // The second bound's `>` is half of a `>>` pair.
    var p = parser_for("fun sort<T: Drop + Compare<T>>(xs: List<T>): void { }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 1, "one type param")
    val tp = *td.generics.at(0)
    assert_eq(tp.bounds.size(), 2, "two bounds")
    assert_eq(bound_head_name(*tp.bounds.at(0)).as_str(), "Drop", "first bound Drop")
    assert_eq(bound_head_name(*tp.bounds.at(1)).as_str(), "Compare", "second bound Compare<T>")
}

@test fun parse_struct_type_param_bound(): void {
    var p = parser_for("struct SortedList<T: Compare<T>> { val items: List<T> }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.size(), 1, "one type param")
    val tp = *td.generics.at(0)
    assert_eq(tp.bounds.size(), 1, "one bound")
    assert_eq(bound_head_name(*tp.bounds.at(0)).as_str(), "Compare", "bound Compare<T>")
}

@test fun parse_unbounded_param_has_no_bounds(): void {
    var p = parser_for("fun id<T>(x: T): T { return x }")
    val td = p.parse_top_decl()
    assert_eq(td.generics.at(0).bounds.size(), 0, "no bounds")
}

@test fun collection_while_in_keeps_the_loop(): void {
    var p = parser_for("while x in xs { }")
    val s = p.parse_stmt()
    when (s.kind) {
        ForEach(binder, _subj, _body) => assert_eq(binder.as_str(), "x", "the binder is kept as written")
        _ => fail("the collection form should parse to a ForEach")
    }
}

// A range is an ordinary value; both forms parse to one node.
@test fun range_while_in_parses_like_a_collection(): void {
    var p = parser_for("while i in 0..3 { }")
    val s = p.parse_stmt()
    when (s.kind) {
        ForEach(binder, _subj, _body) => assert_eq(binder.as_str(), "i", "the binder is kept as written")
        _ => fail("the range form should parse to a ForEach")
    }
}

// The loop survives to typecheck, which checks the subject is `Iterable`.
@test fun while_in_body_is_not_expanded_by_the_parser(): void {
    var p = parser_for("while x in xs { return }")
    val s = p.parse_stmt()
    when (s.kind) {
        ForEach(_binder, _subj, body) => {
            assert_eq(body.size(), 1, "the body is the source body, not a desugared one")
            val only = *body.at(0)
            when (only.kind) {
                Return(_) => assert_eq(true, true, "the body statement is what was written")
                _ => fail("expected the written `return`")
            }
        }
        _ => fail("expected ForEach")
    }
}

// Associated types: AST shape only. Inspections stay inside their `when`
// arm, since returning a bound List escapes a Drop payload.

@test fun parse_assoc_type_declaration(): void {
    var p = parser_for("trait Producer { type Out\n fun make(): int32 }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitDecl(members, _pub, _) => {
            assert_eq(members.size(), 2, "the associated type and the method are both members")
            val first = *members.at(0)
            assert_eq(first.name.as_str(), "Out", "the associated type keeps its name")
            val second = *members.at(1)
            assert_eq(second.name.as_str(), "make", "the method follows it")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_assoc_type_with_bounds(): void {
    var p = parser_for("trait Iterable { type Iter: Iterator + Clone\n fun iter(): int32 }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitDecl(members, _pub, _) => {
            val first = *members.at(0)
            when (first.kind) {
                AssocType(bounds) => assert_eq(bounds.size(), 2, "both bounds are recorded")
                _ => assert_eq(false, true, "expected an AssocType member")
            }
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun parse_assoc_type_binding_in_an_impl(): void {
    var p = parser_for("impl Producer for Widget { type Out = int32\n fun make(): int32 { return 1 } }")
    val td = p.parse_top_decl()
    when (td.kind) {
        TraitImpl(_tref, members) => {
            val binding = *members.at(0)
            assert_eq(binding.name.as_str(), "Out", "the binding names the associated type")
            when (binding.kind) {
                AssocTypeBinding(chosen) => {
                    when (unsafe { chosen.kind }) {
                        Named(n, _a) => assert_eq(n.as_str(), "int32", "the chosen type is recorded")
                        _ => assert_eq(false, true, "expected a Named chosen type")
                    }
                }
                _ => assert_eq(false, true, "expected an AssocTypeBinding member")
            }
        }
        _ => assert_eq(false, true, "expected a TraitImpl")
    }
}

// `C.Iter` in type position is a projection.
@test fun parse_projection_in_a_return_type(): void {
    var p = parser_for("fun first(items: C): C.Iter { return items }")
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(_params, ret, _b, _pb, _u, _mv, _s) => {
            when (unsafe { ret.kind }) {
                Projection(owner, member) => {
                    assert_eq(member.as_str(), "Iter", "the projected name is kept")
                    when (unsafe { owner.kind }) {
                        Named(n, _a) => assert_eq(n.as_str(), "C", "the owner is kept")
                        _ => assert_eq(false, true, "expected a Named owner")
                    }
                }
                _ => assert_eq(false, true, "expected a Projection return type")
            }
        }
        _ => assert_eq(false, true, "expected a Function")
    }
}
