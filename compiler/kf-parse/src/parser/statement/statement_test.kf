// A token with no pattern form is reported rather than silently matching
// everything.

import core.assert.*
import alloc.list.*

import kf_core.span.*
import kf_core.ast.expression.coerce_none
import kf_core.ast.expression.coerce_written_amp
import kf_core.ast.expression.coerce_written_amp_var
import kf_parse.parser.parser_for

@test fun a_string_pattern_parses_clean(): void {
    var p = parser_for("fun f(s: str): int32 { when (s) { \"a\" => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "a string literal is a supported pattern")
}

@test fun an_interpolated_string_pattern_is_reported(): void {
    var p = parser_for("fun f(s: str): int32 { when (s) { \"a\${s}\" => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size() > 0, true, "an interpolated string is not a pattern")
}

@test fun an_integer_pattern_still_parses_clean(): void {
    var p = parser_for("fun f(i: uint64): int32 { when (i) { 0 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "an integer literal is a supported pattern")
}

@test fun a_bool_pattern_still_parses_clean(): void {
    var p = parser_for("fun f(b: bool): int32 { when (b) { true => return 1  false => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "a bool literal is a supported pattern")
}

// `while` is the only loop keyword; a name followed by `in` selects iteration.

@test fun a_while_condition_still_parses_clean(): void {
    var p = parser_for("fun f(n: int32): int32 {\nvar i = 0\nwhile i < n { i = i + 1 }\nreturn i }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "the condition form is unchanged")
}

@test fun a_while_range_parses_clean(): void {
    var p = parser_for("fun f(n: int32): int32 {\nvar s = 0\nwhile i in 0..n { s = s + i }\nreturn s }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "the range form takes an iteration header")
}

@test fun a_while_collection_parses_clean(): void {
    var p = parser_for("fun f(xs: List<int32>): int32 {\nvar s = 0\nwhile x in xs { s = s + x }\nreturn s }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "the collection form takes an iteration header")
}

@test fun a_bare_name_condition_is_not_an_iteration_header(): void {
    var p = parser_for("fun f(b: bool): int32 {\nwhile b { return 1 }\nreturn 0 }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "`while b {` is a condition, not a header")
}

@test fun the_for_loop_is_reported(): void {
    var p = parser_for("fun f(n: int32): int32 {\nvar s = 0\nfor i in 0..n { s = s + i }\nreturn s }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "the `for` loop is gone, and costs one diagnostic")
}

@test fun impl_trait_for_type_still_parses(): void {
    var p = parser_for("""trait T { fun m(): int32 }
struct S { pub val v: int32 }
impl T for S { fun m(): int32 { return 1 } }""")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "`for` is still the impl keyword")
}

// `-1` is two tokens; a pattern folds the sign into the literal.
@test fun a_negative_integer_pattern_parses_clean(): void {
    var p = parser_for("fun f(i: int32): int32 { when (i) { -1 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "a negative integer literal is a supported pattern")
}

@test fun a_char_pattern_parses_clean(): void {
    var p = parser_for("fun f(c: char): int32 { when (c) { 'a' => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "a char literal is a supported pattern")
}

// One bad pattern is one diagnostic.
@test fun a_rejected_pattern_costs_one_diagnostic(): void {
    var p = parser_for("fun f(i: int32): int32 { when (i) { *y => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "the arm resyncs on `=>` instead of cascading")
}

@test fun an_unparenthesized_subject_parses_clean(): void {
    var p = parser_for("fun f(i: uint64): int32 { when i { 0 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "the subject needs no parens")
}

@test fun a_parenthesized_subject_still_parses_clean(): void {
    var p = parser_for("fun f(i: uint64): int32 { when (i) { 0 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "parens around the subject are still accepted")
}

// An un-annotated `val b = &xs` has no parameter type to recover `&` from, so
// the inner expression carries it (see coerce_written_amp).

fun first_let_init_coerce(src: str): uint8 {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    when (td.kind) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            if body.size() == 0 { return 255 as uint8 }
            val s0 = *body.at(0)
            when (s0.kind) {
                LetVal(_n, _t, init_ptr) => return unsafe { (init_ptr!!).coerce }
                LetVar(_n, _t, init_ptr) => return unsafe { (init_ptr!!).coerce }
                _ => return 254 as uint8
            }
        }
        _ => return 253 as uint8
    }
}

@test fun a_written_amp_is_tagged_on_the_initializer(): void {
    val c = first_let_init_coerce("fun f(): int32 { val b = &xs\nreturn 0 }")
    assert_eq(c, coerce_written_amp(), "`&xs` tags the inner expression")
}

@test fun a_written_amp_var_is_tagged_as_mutable(): void {
    val c = first_let_init_coerce("fun f(): int32 { val b = &var xs\nreturn 0 }")
    assert_eq(c, coerce_written_amp_var(), "`&var xs` tags a mutable borrow")
}

@test fun a_plain_initializer_carries_no_tag(): void {
    val c = first_let_init_coerce("fun f(): int32 { val b = xs\nreturn 0 }")
    assert_eq(c, coerce_none(), "no `&` written, no tag")
}

// `&var *p` keeps its tag; typecheck reads it.
@test fun a_borrowed_deref_is_tagged(): void {
    val c = first_let_init_coerce("fun f(): int32 { val b = &var *p\nreturn 0 }")
    assert_eq(c, coerce_written_amp_var(), "`&var *p` is a written borrow of `*p`")
}

/// `no_span()` when that statement binds nothing.
fun first_binder_span(src: str): Span {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    // Assigned into a local declared before the `when`: returning it from the
    // arm comes back with a garbage `file_id`.
    var found = no_span()
    when (td.kind) {
        Function(_params, _r, body, _pb, _u, _mv, _s) => {
            if body.size() > 0 { found = body.at(0).binder }
        }
        _ => {}
    }
    return found
}

@test fun a_val_records_where_its_name_is_written(): void {
    // "fun f(): int32 { val total = 1\nreturn total }"
    //                       ^21   ^26
    val b = first_binder_span("fun f(): int32 { val total = 1\nreturn total }")
    assert_eq(b.start, 21, "the binder starts at the name, not the keyword")
    assert_eq(b.end, 26, "and ends after it")
}

@test fun a_var_records_where_its_name_is_written(): void {
    val b = first_binder_span("fun f(): int32 { var n = 1\nreturn n }")
    assert_eq(b.start, 21, "`var` binds the same way `val` does")
    assert_eq(b.end, 22, "a one-character name is one byte long")
}

@test fun extra_space_moves_the_binder_with_the_name(): void {
    // Read from the token, so padding before the name shifts it.
    val b = first_binder_span("fun f(): int32 { val    total = 1\nreturn total }")
    assert_eq(b.start, 24, "three extra spaces move the name three bytes")
    assert_eq(b.end, 29, "and its end moves with it")
}

@test fun a_statement_that_binds_nothing_has_no_binder(): void {
    val b = first_binder_span("fun f(): int32 { return 1 }")
    assert_eq(b.is_none(), true, "`return` binds no name")
}

@test fun alternatives_parse_clean(): void {
    var p = parser_for("fun f(i: int32): int32 { when (i) { 1 | 2 | 3 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "`|` separates alternatives")
}

@test fun a_range_and_an_alternative_parse_clean(): void {
    val source = "fun f(i: int32): int32 { when (i) { -5..5 | 9 => return 1  'a'..='z' => return 2  _ => return 0 } }"
    var p = parser_for(source)
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 0, "`..` binds tighter than `|`")
}

@test fun an_empty_range_is_reported(): void {
    var p = parser_for("fun f(i: int32): int32 { when (i) { 5..5 => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size(), 1, "5..5 matches nothing")
}

@test fun a_range_bound_of_another_kind_is_reported(): void {
    var p = parser_for("fun f(i: int32): int32 { when (i) { 1..'z' => return 1  _ => return 0 } }")
    val _m = p.parse_module(List.new<String>())
    assert_eq(p.diags.size() > 0, true, "an integer range needs an integer upper bound")
}
