import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_parse.parser.*

/// A `?:` bail must not fall through, since the binding exists only on the
/// present path. Syntactic and conservative: the last statement is a jump,
/// or an `if` whose branches both diverge.
fun stmts_diverge(body: &List<Stmt>): bool {
    if body.size() == 0 { return false }
    val last = *body.at(body.size() - 1)
    when (last.kind) {
        Return(_) => return true
        Break => return true
        Continue => return true
        If(_c, tb, eb) => {
            if !stmts_diverge(&tb) { return false }
            return stmts_diverge(&eb)
        }
        _ => return false
    }
    return false
}

/// `return` with nothing after it.
fun bare_return(span: Span): Stmt {
    val none_operand: Box<Expr>? = null
    return Stmt.new(span, StmtKind.Return(none_operand))
}

impl Parser {
    mutating fun parse_let(span: Span, is_var: bool): Stmt {
        unsafe { self.advance() } // consume val/var
        // Taken before the name is interned, since a Sym has no position.
        val binder_span: Span = self.peek().span
        val name: String = self.expect_name("variable")
        unsafe { self.advance() }

        var ty_ptr: Box<TypeRef>? = null
        if is_op(self.peek(), Operator.Colon) {
            unsafe { self.advance() }
            ty_ptr = Option.Some<Box<TypeRef>>(self.parse_type_ref_ptr())
        }

        val _eq = self.expect_op(Operator.Eq, "after the variable name (a binding needs an initializer)")

        val init = self.parse_value_operand()

        // `val x = OPT ?: BAIL`: the rest of the block becomes the `Some` arm.
        if self.peek_is_elvis() {
            self.skip_newlines()
            unsafe { self.advance() } // consume `?:`
            return self.desugar_elvis(name, init, span, is_var)
        }

        val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *init_ptr = init }

        // Two branches: each consumes the move-once parts exactly once.
        if is_var {
            return Stmt.new_binding(span, binder_span, StmtKind.LetVar(intern(name.as_str()), ty_ptr, init_ptr))
        }
        return Stmt.new_binding(span, binder_span, StmtKind.LetVal(intern(name.as_str()), ty_ptr, init_ptr))
    }

    /// `val NAME = OPT ?: BAIL` and the rest of the enclosing block become
    ///
    ///     when (OPT) { Some(NAME) => { REST }  None => { BAIL } }
    ///
    /// Binding through the arm keeps ownership right: the payload is neither
    /// cloned nor dropped twice. Typecheck enforces that the bail diverges.
    mutating fun desugar_elvis(name: String, subject: Expr, span: Span, is_var: bool): Stmt {
        val bail = self.parse_elvis_bail()
        if !stmts_diverge(&bail) {
            self.parse_err(span, String.from("a braced `?:` right-hand side is a BAIL, so it must diverge (end it with `return`, `break` or `continue`) — after it the binding does not exist. To supply a default value instead, drop the braces: `?: <value>`"))
        }
        var rest = self.parse_block_remainder()

        // `val` binds the arm binder directly. `var` cannot, since a binder is
        // not assignable: it binds a temp and opens the arm with
        // `var NAME = __elvbail_N`, a move out of the arm.
        var binder = name.clone()
        if is_var {
            binder = "__elvbail_${self.elv_ctr}"
            self.elv_ctr = self.elv_ctr + 1
            val src: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *src = Expr.new(span, ExprKind.Variable(intern(binder.as_str()))) }
            var opened = List.new<Stmt>()
            opened.push(Stmt.new_binding(span, span, StmtKind.LetVar(intern(name.as_str()), null, src)))
            while item in &rest {
                opened.push(item)
            }
            rest = opened
        }

        var some_payloads = List.new<Pattern>()
        some_payloads.push(new_pattern(span, PatternKind.Identifier(intern(binder.as_str()))))
        val some_pat_box: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *some_pat_box = new_pattern(span, PatternKind.Variant(intern("Some"), some_payloads)) }
        val some_arm = new_arm(span, some_pat_box, null, rest)

        val none_pat_box: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *none_pat_box = new_pattern(span, PatternKind.Variant(intern("None"), List.new<Pattern>())) }
        val none_arm = new_arm(span, none_pat_box, null, bail)

        var arms = List.new<Arm>()
        arms.push(some_arm)
        arms.push(none_arm)
        val subj_box: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *subj_box = subject }
        return Stmt.new(span, StmtKind.When(subj_box, arms))
    }

    /// A braced block, or one unbraced statement (`?: return Type.new_poison()`),
    /// which must still end its line.
    mutating fun parse_elvis_bail(): List<Stmt> {
        self.skip_newlines()
        if is_op(self.peek(), Operator.LBrace) {
            return self.parse_block()
        }
        var one = List.new<Stmt>()
        val diags_before: uint64 = self.diags.size()
        one.push(self.parse_stmt())
        // A statement that already reported keeps its own wreckage.
        if self.diags.size() == diags_before { self.require_stmt_terminator() }
        return one
    }

    /// The rest of the enclosing block through its `}`. Sets `block_done` so
    /// the owning parse_block stops, and leaves it set so sibling `?:`s unwind
    /// to the same owner.
    mutating fun parse_block_remainder(): List<Stmt> {
        var rest = List.new<Stmt>()
        while true {
            self.skip_newlines()
            if self.at_eof() {
                self.parse_err(self.peek().span, String.from("unclosed block: missing `}` before the end of the file"))
                break
            }
            val before: uint64 = self.pos
            if !self.parse_one_block_stmt(&var rest) { break }
            if self.block_done { break }
            if self.pos == before {
                unsafe { self.advance() }
            }
        }
        self.block_done = true
        return rest
    }

    mutating fun value_return(span: Span): Stmt {
        val e = self.parse_value_operand()
        val e_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *e_ptr = e }
        val operand: Box<Expr>? = e_ptr
        return Stmt.new(span, StmtKind.Return(operand))
    }

    mutating fun parse_return(span: Span): Stmt {
        unsafe { self.advance() } // consume `return`
        val next = self.peek()
        when (next.kind) {
            Newline => return bare_return(span)
            Eof => return bare_return(span)
            Op(o) => {
                if is_op_rbrace(o) { return bare_return(span) }
                return self.value_return(span)
            }
            KeywordTok(_) => return self.value_return(span)
            Identifier(_) => return self.value_return(span)
            IntLiteral(_) => return self.value_return(span)
            StringLiteral(_) => return self.value_return(span)
            FloatLiteral(_) => return self.value_return(span)
            CharLiteral(_) => return self.value_return(span)
            LexError(_) => return bare_return(span)
        }
    }

    /// Wraps a statement that read a postfix `?`:
    ///
    ///     when (SUBJ.branch()) {
    ///         Continue(__try_N) => { STMT  REST }
    ///         Break(__tryr_N)   => { return RET.from_residual<Args>(__tryr_N) }
    ///     }
    ///
    /// Several `?` nest so they evaluate in written order. The bail is built
    /// from the declared return type; typecheck checks `FromResidual`.
    mutating fun desugar_pending_try(stmt: Stmt, from: uint64): Stmt {
        var rest = List.new<Stmt>()
        rest.push(stmt)
        // A `?:` in the same statement already took the block.
        if !self.block_done {
            val tail = self.parse_block_remainder()
            while item in &tail {
                rest.push(item)
            }
        }
        var i: uint64 = self.pending_try.size()
        while i > from {
            i = i - 1
            val pend = *self.pending_try.at(i)
            rest = self.wrap_in_try_when(pend, rest)
        }
        while self.pending_try.size() > from {
            self.pending_try.pop()
        }
        return *rest.at(0)
    }

    mutating fun wrap_in_try_when(pend: PendingTry, body: List<Stmt>): List<Stmt> {
        val span = pend.span

        val subj_box: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *subj_box = pend.subject }
        val branch_box: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *branch_box = Expr.new(span, ExprKind.MethodCall(subj_box, intern("branch"), List.new<Expr>())) }

        var cont_payloads = List.new<Pattern>()
        cont_payloads.push(new_pattern(span, PatternKind.Identifier(intern(pend.name.as_str()))))
        val cont_pat: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *cont_pat = new_pattern(span, PatternKind.Variant(intern("Continue"), cont_payloads)) }

        val residual = "${pend.name}_r"
        var break_payloads = List.new<Pattern>()
        break_payloads.push(new_pattern(span, PatternKind.Identifier(intern(residual.as_str()))))
        val break_pat: Ptr<Pattern> = unsafe { alloc<Pattern>() }
        unsafe { *break_pat = new_pattern(span, PatternKind.Variant(intern("Break"), break_payloads)) }

        var arms = List.new<Arm>()
        arms.push(new_arm(span, cont_pat, null, body))
        arms.push(new_arm(span, break_pat, null, self.try_bail_stmts(residual, span)))

        var out = List.new<Stmt>()
        out.push(Stmt.new(span, StmtKind.When(branch_box, arms)))
        return out
    }

    /// `return RET.from_residual<Args>(NAME)`. A parse error outside a
    /// function or when the return type has no name to call through.
    mutating fun try_bail_stmts(name: String, span: Span): List<Stmt> {
        var out = List.new<Stmt>()
        if self.fn_ret.size() == 0 {
            self.parse_err(span, String.from("postfix `?` needs an enclosing function whose return type implements `Try`"))
            return out
        }
        val ret = *self.fn_ret.at(0)
        var base = ""
        var targs = List.new<TypeRef>()
        when (ret.kind) {
            Named(n, a) => {
                base = n.as_string()
                targs = a
            }
            _ => { }
        }
        if base.as_str().byte_len() == 0 || base.as_str().equals("void") {
            self.parse_err(span, String.from("postfix `?` bails by rebuilding the enclosing function's return type — a `void` return has nothing to rebuild"))
            return out
        }
        val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *recv = Expr.new(span, ExprKind.Variable(intern(base.as_str()))) }
        var args = List.new<Expr>()
        args.push(Expr.new(span, ExprKind.Variable(intern(name.as_str()))))
        var call = Expr.new(span, ExprKind.MethodCall(recv, intern("from_residual"), args))
        call.type_args = targs
        val call_box: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *call_box = call }
        out.push(Stmt.new(span, StmtKind.Return(call_box)))
        return out
    }
}
