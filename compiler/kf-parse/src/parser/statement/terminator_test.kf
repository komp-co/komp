import core.assert.assert_eq
import alloc.list.*
import kf_parse.parser.parser_for

fun terminator_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun a_trailing_token_after_val_is_reported(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nval a = 1 2\nreturn a\n}"), 1, "`val a = 1 2` is not a program anyone meant")
}

@test fun a_trailing_token_after_var_is_reported(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nvar a = 1 2\nreturn a\n}"), 1, "`var` has the same hole as `val`")
}

@test fun a_trailing_token_after_return_is_reported(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nreturn 1 + 2 garbage\n}"), 1, "the operand ends, the line does not")
}

@test fun a_trailing_token_after_assignment_is_reported(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
var a = 1
a = 2 3
return a
}"""), 1, "an assignment owns its line too")
}

@test fun a_trailing_token_after_an_expression_stmt_is_reported(): void {
    assert_eq(terminator_diags("fun f(): void {\ng() 2\n}"), 1, "a call statement owns its line too")
}

@test fun a_trailing_token_after_a_braced_stmt_is_reported(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nif true { return 1 } return 2\n}"), 1, "a closing brace does not open a second statement")
}

@test fun a_trailing_token_after_while_is_reported(): void {
    assert_eq(terminator_diags("fun f(): void {\nwhile false { } 2\n}"), 1, "`while` ends at its `}`, and so does its line")
}

@test fun several_leftovers_report_once(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nval a = 1 2 3 4\nreturn a\n}"), 1, "the rest of the line is skipped, not re-reported")
}

@test fun a_statement_that_already_reported_is_not_reported_twice(): void {
    assert_eq(terminator_diags("fun f(): int32 {\nval x =\nreturn 0\n}"), 1, "the missing initializer is the error; its leftovers are not a second one")
}

@test fun a_semicolon_separates_two_statements(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
val a = 1; val b = 2
return a + b
}"""), 0, "`;` is an explicit terminator")
}

@test fun a_closing_brace_ends_the_last_statement(): void {
    assert_eq(terminator_diags("fun f(): int32 { return 1 }"), 0, "a one-statement body needs no newline before `}`")
}

@test fun an_elvis_may_open_a_continuation_line(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
val a = g()
?: return 0
return a
}"""), 0, "`?:` is allowed to start the next line")
}

// The unbraced `?:` bail is parsed outside the block loop and must still own
// its line.

@test fun a_trailing_token_after_an_unbraced_elvis_bail_is_reported(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
val z = 5
val v = g() ?: return z 12345
return v
}"""), 1, "`12345` belonged to nothing")
}

@test fun a_braced_elvis_bail_still_ends_at_its_brace(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
val v = g() ?: { return 0 }
return v
}"""), 0, "the braced form was never the hole")
}

@test fun an_unbraced_elvis_bail_alone_on_its_line_is_accepted(): void {
    assert_eq(terminator_diags("""fun f(): int32 {
val v = g() ?: return 0
return v
}"""), 0, "the ordinary bail must keep parsing")
}
