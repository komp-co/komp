import kf_core.span.*
import kf_core.ast.*
import kf_parse.lexer.*
import kf_parse.parser.*

impl Parser {
    /// Widens the span once here, rather than in every statement parser.
    pub mutating fun parse_stmt(): Stmt {
        var s = self.parse_stmt_kinded()
        s.span = self.stmt_span_through_last(s.span)
        return s
    }

    /// A span the parser never got past (the empty statement at EOF) is left
    /// as is.
    mutating fun stmt_span_through_last(span: Span): Span {
        val end = self.last_consumed_end()
        if end <= span.end { return span }
        return Span { file_id: span.file_id, start: span.start, end: end }
    }

    mutating fun parse_stmt_kinded(): Stmt {
        val t = self.peek()
        when (t.kind) {
            KeywordTok(kw) => return self.parse_keyword_stmt(kw, t.span)
            Identifier(_) => return self.parse_expr_or_assign()
            IntLiteral(_) => return self.parse_expr_stmt()
            StringLiteral(_) => return self.parse_expr_stmt()
            FloatLiteral(_) => return self.parse_expr_stmt()
            CharLiteral(_) => return self.parse_expr_stmt()
            // `*self = rhs`, or `self.method()` / `e.field = rhs`.
            Op(_) => return self.parse_expr_or_assign()
            Newline => {
                unsafe { self.advance() }
                return stmt_poison(t.span)
            }
            Eof => return stmt_poison(t.span)
            LexError(_) => {
                unsafe { self.advance() }
                return stmt_poison(t.span)
            }
        }
    }

    mutating fun parse_keyword_stmt(kw: Keyword, span: Span): Stmt {
        return when (kw) {
            Val => self.parse_let(span, false)
            Var => self.parse_let(span, true)
            Return => self.parse_return(span)
            If => self.parse_if_stmt(span)
            While => self.parse_while(span)
            When => self.parse_when_stmt(span)
            True => self.parse_expr_stmt()
            False => self.parse_expr_stmt()
            Break => self.parse_break_continue(span, false)
            Continue => self.parse_break_continue(span, true)
            For => self.for_loop_removed_err(span)
            In => self.advance_and_poison_stmt(span)
            Trait => self.advance_and_poison_stmt(span)
            // `type` is meaningful only in a trait or impl body.
            TypeKw => self.advance_and_poison_stmt(span)
            Dyn => self.advance_and_poison_stmt(span)
            // Not a statement start: skipped so the block loop progresses.
            Fun => self.advance_and_poison_stmt(span)
            Else => self.advance_and_poison_stmt(span)
            Import => self.advance_and_poison_stmt(span)
            Pub => self.advance_and_poison_stmt(span)
            Struct => self.advance_and_poison_stmt(span)
            Enum => self.advance_and_poison_stmt(span)
            Impl => self.advance_and_poison_stmt(span)
            Extern => self.advance_and_poison_stmt(span)
            Mutating => self.advance_and_poison_stmt(span)
            Static => self.advance_and_poison_stmt(span)
            Unsafe => self.parse_unsafe_block_stmt(span)
            As => self.advance_and_poison_stmt(span)
        }
    }

    /// `unsafe { STMT }`, transparent in the AST.
    mutating fun parse_unsafe_block_stmt(span: Span): Stmt {
        unsafe { self.advance() } // consume `unsafe`
        val _ob = self.expect_op(Operator.LBrace, "after `unsafe`")
        self.skip_newlines()
        val inner = self.parse_stmt()
        self.skip_newlines()
        val _cb = self.expect_op(Operator.RBrace, "to close the `unsafe` block")
        return inner
    }

    mutating fun advance_and_poison_stmt(span: Span): Stmt {
        unsafe { self.advance() }
        return stmt_poison(span)
    }

    /// `break` / `continue`. Like `return`, they skip the scope-end releases.
    mutating fun parse_break_continue(span: Span, is_continue: bool): Stmt {
        unsafe { self.advance() } // consume break/continue
        if is_continue {
            return new_stmt(span, StmtKind.Continue)
        }
        return new_stmt(span, StmtKind.Break)
    }

    mutating fun parse_expr_stmt(): Stmt {
        val e = self.parse_expr()
        val span = e.span
        val e_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *e_ptr = e }
        return new_stmt(span, StmtKind.Expression(e_ptr))
    }

    /// `place = rhs` or an expression statement. A bare-name target is
    /// `Assign`; `*p` or `e.field` is `AssignTo`.
    mutating fun parse_expr_or_assign(): Stmt {
        val span = self.peek().span
        val lhs = self.parse_expr()
        if is_op(self.peek(), Operator.Eq) {
            unsafe { self.advance() } // consume `=`
            val rhs = self.parse_expr()
            val rhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
            unsafe { *rhs_ptr = rhs }
            when (lhs.kind) {
                Variable(name) => return new_stmt(span, StmtKind.Assign(name, rhs_ptr))
                _ => {
                    val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
                    unsafe { *lhs_ptr = lhs }
                    return new_stmt(span, StmtKind.AssignTo(lhs_ptr, rhs_ptr))
                }
            }
        }
        val lhs_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
        unsafe { *lhs_ptr = lhs }
        return new_stmt(span, StmtKind.Expression(lhs_ptr))
    }

    /// `{ ... }`; empty on failure.
    pub mutating fun parse_block(): List<Stmt> {
        var body = List.new<Stmt>()
        if !(is_op(self.peek(), Operator.LBrace)) {
            return body
        }
        unsafe { self.advance() }
        while true {
            self.skip_newlines()
            if self.at_eof() {
                self.parse_err(self.peek().span, String.from("unclosed block: missing `}` before the end of the file"))
                break
            }
            val before: uint64 = self.pos
            if !self.parse_one_block_stmt(&var body) { break }
            // A `?:` binding took the rest of this block; this is the owner,
            // so it clears the flag.
            if self.block_done {
                self.block_done = false
                break
            }
            // Force progress, or an unparseable construct would loop forever.
            if self.pos == before {
                unsafe { self.advance() }
            }
        }
        return body
    }

    /// False when the block ends.
    mutating fun parse_one_block_stmt(body: &var List<Stmt>): bool {
        if is_op(self.peek(), Operator.RBrace) {
            unsafe { self.advance() }
            return false
        }
        val diags_before: uint64 = self.diags.size()
        val try_mark: uint64 = self.pending_try.size()
        val st = self.parse_stmt()
        if self.block_done {
            if self.pending_try.size() > try_mark {
                body.push(self.desugar_pending_try(st, try_mark))
                return true
            }
            body.push(st)
            return true
        }
        // A statement that already reported keeps its own wreckage.
        if self.diags.size() == diags_before { self.require_stmt_terminator() }
        // A postfix `?` takes the rest of the block into its `Continue` arm.
        if self.pending_try.size() > try_mark {
            body.push(self.desugar_pending_try(st, try_mark))
            return true
        }
        body.push(st)
        return true
    }
}
