import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_parse.lexer.*

/// "_" for anything but an identifier.
pub fun Token.ident_name_or_anon(): String {
    return when (self.kind) {
        Identifier(name) => name.as_string()
        KeywordTok(_) => String.from("_")
        Op(_) => String.from("_")
        IntLiteral(_) => String.from("_")
        StringLiteral(_) => String.from("_")
        FloatLiteral(_) => String.from("_")
        CharLiteral(_) => String.from("_")
        Newline => String.from("_")
        Eof => String.from("_")
        LexError(_) => String.from("_")
    }
}

/// A poison type in a slot the caller owns, for a missing annotation.
pub fun poison_type_ref_at(span: Span): Ptr<TypeRef> {
    val slot: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *slot = TypeRef.new_poison(span) }
    return slot
}

impl Parser {
    /// A type as written.
    pub mutating fun parse_type_ref(): TypeRef {
        val t = self.peek()
        var parsed = TypeRef.new_poison(t.span)
        when (t.kind) {
            Identifier(name) => {
                unsafe { self.advance() }
                val args = self.parse_type_arguments()
                var tr = TypeRef.new(t.span, TypeRefKind.Named(intern(name.as_str()), args))
                // `C.Iter`, `Self.Item`: a `.` in type position is a
                // projection. Chains fold left.
                while is_op(self.peek(), Operator.Dot) {
                    unsafe { self.advance() } // consume `.`
                    val member = self.peek()
                    // `field.type`, a template's fact, reads as a projection.
                    var mname = when (member.kind) {
                        Identifier(word) => word.as_string()
                        _ => String.from("")
                    }
                    if member.is_keyword(Keyword.TypeKw) { mname = String.from("type") }
                    if mname.byte_len() > 0 {
                        unsafe { self.advance() }
                        val owner_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
                        unsafe { *owner_ptr = tr }
                        tr = TypeRef.new(t.span, TypeRefKind.Projection(owner_ptr, intern(mname.as_str())))
                    } else {
                        self.parse_err(member.span, String.from("expected an associated type name after `.` in a type"))
                        tr = TypeRef.new_poison(t.span)
                    }
                }
                parsed = tr
            }
            KeywordTok(k) => {
                if t.is_keyword(Keyword.Dyn) {
                    unsafe { self.advance() }
                    val principal = self.peek()
                    when (principal.kind) {
                        Identifier(name) => {
                            unsafe { self.advance() }
                            val args = self.parse_type_arguments()
                            parsed = TypeRef.new(t.span, TypeRefKind.DynTrait(intern(name.as_str()), args))
                        }
                        _ => {
                            self.parse_err(principal.span, String.from("expected a trait name after `dyn`"))
                            parsed = TypeRef.new_poison(t.span)
                        }
                    }
                } else {
                    self.parse_err(t.span, "expected a type here, found keyword `${kw_str(k)}`")
                    parsed = TypeRef.new_poison(t.span)
                }
            }
            Op(op) => {
                // `&T` / `&var T`; any other operator is an error.
                when (op) {
                    Amp => {
                        unsafe { self.advance() } // consume `&`
                        var mutable: bool = false
                        if is_keyword(self.peek(), Keyword.Var) {
                            unsafe { self.advance() } // consume `var`
                            mutable = true
                        }
                        val inner: Box<TypeRef> = self.parse_type_ref_ptr()
                        parsed = borrow_type_ref(t.span, mutable, inner)
                    }
                    LParen => parsed = self.parse_function_type_ref()
                    _ => {
                        self.parse_err(t.span, "expected a type here, found `${op_str(op)}`")
                        parsed = TypeRef.new_poison(t.span)
                    }
                }
            }
            IntLiteral(_) => {
                self.parse_err(t.span, String.from("expected a type here, found an integer literal"))
                parsed = TypeRef.new_poison(t.span)
            }
            StringLiteral(_) => {
                self.parse_err(t.span, String.from("expected a type here, found a string literal"))
                parsed = TypeRef.new_poison(t.span)
            }
            FloatLiteral(_) => {
                self.parse_err(t.span, String.from("expected a type here, found a float literal"))
                parsed = TypeRef.new_poison(t.span)
            }
            CharLiteral(_) => {
                self.parse_err(t.span, String.from("expected a type here, found a char literal"))
                parsed = TypeRef.new_poison(t.span)
            }
            Newline => {
                self.parse_err(t.span, String.from("expected a type here, found end of line"))
                parsed = TypeRef.new_poison(t.span)
            }
            Eof => {
                self.parse_err(t.span, String.from("expected a type here, found end of file"))
                parsed = TypeRef.new_poison(t.span)
            }
            LexError(_) => {
                // Already reported by report_lex_errors.
                parsed = TypeRef.new_poison(t.span)
            }
        }
        val type_span = t.span
        parsed = self.parse_array_suffixes(parsed)
        // `T?` is `Option<T>`, an ordinary generic enum.
        if is_op(self.peek(), Operator.Question) {
            unsafe { self.advance() }
            val base = parsed
            var oargs = List.new<TypeRef>()
            oargs.push(base)
            parsed = TypeRef.new(type_span, TypeRefKind.Named(lang_placeholder(lang_option_key()), oargs))
        }
        return parsed
    }

    /// The same, in a slot the caller owns.
    pub mutating fun parse_type_ref_ptr(): Ptr<TypeRef> {
        val parsed: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
        unsafe { *parsed = self.parse_type_ref() }
        return parsed
    }

    /// `<A, B>` after a type name; empty when no `<` follows.
    pub mutating fun parse_type_arguments(): List<TypeRef> {
        var args = List.new<TypeRef>()
        if is_op(self.peek(), Operator.Lt) {
            val _ = self.parse_type_argument_list(&var args, false)
        }
        return args
    }

    /// `<A, B>`, at the `<`, into `out`. Newlines inside are whitespace.
    ///
    /// Speculative, it reports nothing and answers false unless every argument
    /// parsed and `>` closed the list; the caller rewinds, and `<` is read as a
    /// comparison. Otherwise errors are reported and what parsed is kept.
    pub mutating fun parse_type_argument_list(out: &var List<TypeRef>, speculative: bool): bool {
        unsafe { self.advance() } // `<`
        val was_speculative = self.speculative
        if speculative { self.speculative = true }
        var ok = true
        while true {
            self.skip_newlines()
            if is_op(self.peek(), Operator.Gt) {
                unsafe { self.advance() }
                break
            }
            if self.at_eof() {
                if !speculative {
                    self.parse_err(self.peek().span, String.from("unclosed type-argument list: missing `>`"))
                }
                ok = false
                break
            }
            val before: uint64 = self.pos
            val arg = self.parse_type_argument()
            // A token no type starts with was reported and not consumed.
            if self.pos == before || (speculative && tyref_is_poison(arg)) {
                ok = false
                break
            }
            out.push(arg)
            self.skip_newlines()
            if is_op(self.peek(), Operator.Comma) {
                unsafe { self.advance() }
            } else if speculative && !is_op(self.peek(), Operator.Gt) {
                ok = false
                break
            }
        }
        self.speculative = was_speculative
        return ok
    }

    /// `T[N]` is `Array<T, N>`, and `T[]` is `Array<T, _>`, its length taken
    /// from what initializes it. Both name core's array by its lang key.
    mutating fun parse_array_suffixes(element: TypeRef): TypeRef {
        var parsed = element
        while is_op(self.peek(), Operator.LBracket) {
            val span = self.peek().span
            self.advance()
            val length = if is_op(self.peek(), Operator.RBracket) {
                TypeRef.new(span, TypeRefKind.Named(intern("_"), List.new<TypeRef>()))
            } else {
                self.parse_type_argument()
            }
            if !is_op(self.peek(), Operator.RBracket) {
                self.parse_err(self.peek().span, String.from("expected `]` to close an array's length"))
                return parsed
            }
            self.advance()
            var args = List.new<TypeRef>()
            args.push(parsed)
            args.push(length)
            parsed = TypeRef.new(span, TypeRefKind.Named(lang_placeholder(lang_array_key()), args))
        }
        return parsed
    }

    /// A type, or the value a value parameter takes: `7`, `-7`.
    pub mutating fun parse_type_argument(): TypeRef {
        val negative = is_op(self.peek(), Operator.Minus)
        val start = self.peek().span
        val literal = if negative { self.peek_at(1) } else { self.peek() }
        val span = start.merge(literal.span)
        val magnitude = when (literal.kind) {
            IntLiteral(v) => v
            _ => -1
        }
        if magnitude >= 0 {
            self.advance()
            if negative { self.advance() }
            val value = if negative { 0 - magnitude } else { magnitude }
            return TypeRef.new(span, TypeRefKind.Value(value))
        }
        return self.parse_type_ref()
    }

    /// `(A, B) -> R`, at the `(`. `(T)` with no arrow is `T`, grouped, so
    /// `((int32) -> bool)?` can be written.
    mutating fun parse_function_type_ref(): TypeRef {
        val span = self.peek().span
        unsafe { self.advance() } // consume `(`
        var params = List.new<TypeRef>()
        while !is_op(self.peek(), Operator.RParen) && !self.at_eof() {
            val before: uint64 = self.pos
            params.push(self.parse_type_ref())
            if is_op(self.peek(), Operator.Comma) { unsafe { self.advance() } } else if self.pos == before { break }
        }
        if !is_op(self.peek(), Operator.RParen) {
            self.parse_err(self.peek().span, String.from("unclosed function type: missing `)`"))
            return TypeRef.new_poison(span)
        }
        unsafe { self.advance() } // consume `)`
        if !is_op(self.peek(), Operator.ThinArrow) {
            if params.size() == 1 { return params.remove(0) ?: TypeRef.new_poison(span) }
            self.parse_err(self.peek().span, String.from("expected `->` and a result type after a function type's parameters"))
            return TypeRef.new_poison(span)
        }
        unsafe { self.advance() } // consume `->`
        val ret = self.parse_type_ref_ptr()
        return TypeRef.new(span, TypeRefKind.Function(params, ret))
    }
}

/// `&T` or `&var T`, except that a borrow of `T[]`, an array of no stated
/// length, is a slice: `&T[]` is `Slice<T>` and `&var T[]` is `SliceMut<T>`,
/// named by their lang keys.
fun borrow_type_ref(span: Span, mutable: bool, inner: Box<TypeRef>): TypeRef {
    val element = inner.unsized_array_element() ?: return TypeRef.new(span, TypeRefKind.Reference(mutable, inner))
    val key = if mutable { lang_slice_mut_key() } else { lang_slice_key() }
    var args = List.new<TypeRef>()
    args.push(element)
    return TypeRef.new(span, TypeRefKind.Named(lang_placeholder(key), args))
}

/// `T` when this is `T[]`.
fun TypeRef.unsized_array_element(): TypeRef? {
    when (self.kind) {
        Named(head, args) => {
            if head.id != lang_placeholder(lang_array_key()).id || args.size() != 2 { return null }
            if !args.at(1).is_wildcard() { return null }
            return args.at(0).clone()
        }
        _ => return null
    }
}

fun tyref_is_poison(tr: TypeRef): bool {
    return when (tr.kind) {
        Named(_n, _a) => false
        DynTrait(_n, _a) => false
        Reference(_m, _i) => false
        Function(_p, _r) => false
        Array(_e, _n) => false
        // `List.new<F.Out>()` is a type-argument list; the owner is the
        // checker's concern.
        Projection(_owner, _member) => false
        Value(_v) => false
        Poison => true
    }
}
