fun initialized(): Server {
    var server = Server.new()
    val _reply = server.handle("{\"id\":1,\"method\":\"initialize\",\"params\":{}}")
    return server
}

fun reply_to(server: &var Server, body: str): String {
    return server.handle(body).reply ?: ""
}

@test
fun initialize_names_the_server(): void {
    var server = Server.new()
    val reply = reply_to(&var server, "{\"id\":1,\"method\":\"initialize\",\"params\":{}}")
    assert_eq(reply.as_str().contains("\"name\":\"kflat-lsp\""), true, "serverInfo")
}

@test
fun a_request_before_initialize_is_refused(): void {
    var server = Server.new()
    val reply = reply_to(&var server, "{\"id\":1,\"method\":\"textDocument/hover\"}")
    assert_eq(reply.as_str().contains("-32002"), true, "not initialized")
}

@test
fun an_unknown_request_is_method_not_found(): void {
    var server = initialized()
    val reply = reply_to(&var server, "{\"id\":2,\"method\":\"textDocument/hover\"}")
    assert_eq(reply.as_str().contains("-32601"), true, "method not found")
}

@test
fun a_notification_gets_no_reply(): void {
    var server = initialized()
    assert_eq(server.handle("{\"method\":\"initialized\",\"params\":{}}").reply.is_none(), true, "no reply")
}

@test
fun shutdown_answers_null(): void {
    var server = initialized()
    val reply = reply_to(&var server, "{\"id\":2,\"method\":\"shutdown\"}")
    assert_eq(reply.as_str(), "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}", "null result")
}

@test
fun a_request_after_shutdown_is_invalid(): void {
    var server = initialized()
    val _shutdown = server.handle("{\"id\":2,\"method\":\"shutdown\"}")
    val reply = reply_to(&var server, "{\"id\":3,\"method\":\"textDocument/hover\"}")
    assert_eq(reply.as_str().contains("-32600"), true, "invalid request")
}

@test
fun exit_after_shutdown_succeeds(): void {
    var server = initialized()
    val _shutdown = server.handle("{\"id\":2,\"method\":\"shutdown\"}")
    assert_eq(server.handle("{\"method\":\"exit\"}").exit_code ?: -1, 0, "clean exit")
}

@test
fun exit_without_shutdown_fails(): void {
    var server = initialized()
    assert_eq(server.handle("{\"method\":\"exit\"}").exit_code ?: -1, 1, "exit code 1")
}

@test
fun a_body_that_is_not_json_is_a_parse_error(): void {
    var server = initialized()
    val reply = reply_to(&var server, "not json")
    assert_eq(reply.as_str().contains("-32700"), true, "parse error")
}
