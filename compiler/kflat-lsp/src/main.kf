import core.display.print

/// Serves one client over stdin and stdout until it says `exit`.
fun main(): int32 {
    var server = Server.new()
    while true {
        val body = read_message() ?: return 1
        val outcome = server.handle(body.as_str())
        when (outcome.reply) {
            Some(text) => print(framed(text.as_str()).as_str())
            None => {}
        }
        when (outcome.exit_code) {
            Some(code) => return code
            None => {}
        }
    }
    return 1
}
