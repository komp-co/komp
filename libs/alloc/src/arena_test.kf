import core.assert.assert
import core.assert.assert_eq
import alloc.arena.*

@test
fun a_new_arena_is_empty(): void {
    val arena = Arena.new<int32>()
    assert(arena.is_empty(), "nothing put")
}

@test
fun put_counts_each_value(): void {
    var arena = Arena.new<int32>()
    while i in 0..40 { val _p = arena.put(i) }
    assert_eq(arena.size(), 40 as uint64, "every put counted")
}

@test
fun a_pointer_reads_back_its_value(): void {
    var arena = Arena.new<int32>()
    val p = arena.put(7)
    assert_eq(unsafe { *p }, 7, "the value put")
}

@test
fun a_pointer_survives_the_chunks_after_it(): void {
    var arena = Arena.new<int32>()
    val first = arena.put(1)
    while i in 0..5000 { val _p = arena.put(i) }
    assert_eq(unsafe { *first }, 1, "the first chunk does not move")
}

@test
fun owning_values_read_back(): void {
    var arena = Arena.new<String>()
    val p = arena.put(String.from("kept"))
    while _i in 0..20 { val _q = arena.put(String.from("more")) }
    assert_eq(unsafe { (*p).as_str() }, "kept", "a String past a chunk boundary")
}

@test
fun chunks_double_to_a_ceiling(): void {
    assert_eq(arena_chunk_capacity(0), 16 as uint64, "the first chunk")
}

@test
fun chunks_stop_doubling_at_4096(): void {
    assert_eq(arena_chunk_capacity(20), 4096 as uint64, "the ceiling")
}
