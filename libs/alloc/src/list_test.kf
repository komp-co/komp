// Ordinary List tests. They also fail to build if the `alloc<T>()` intrinsic
// shape is ever mistaken for a crate-qualified `alloc__<name>`.

import core.assert.assert_eq
import alloc.list.*

@test
fun a_new_list_is_empty(): void {
    val xs = List.new<int32>()
    assert_eq(xs.size(), 0, "a fresh list has no elements")
    assert_eq(xs.is_empty(), true, "and reports itself empty")
}

@test
fun push_appends_in_order(): void {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    xs.push(30)
    assert_eq(xs.size(), 3, "three pushes, three elements")
    assert_eq(xs.get(0), 10, "first stays first")
    assert_eq(xs.get(2), 30, "last stays last")
}

@test
fun set_replaces_in_place(): void {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.set(1, 99)
    assert_eq(xs.get(1), 99, "set overwrites the element")
    assert_eq(xs.size(), 2, "and does not change the length")
}

@test
fun pop_removes_the_last_element(): void {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.pop()
    assert_eq(xs.size(), 1, "pop shortens by one")
    assert_eq(xs.get(0), 1, "and leaves the front alone")
}

@test
fun at_borrows_without_copying(): void {
    var xs = List.new<String>()
    xs.push(String.from("hello"))
    val borrowed = xs.at(0)
    assert_eq(borrowed.as_str(), "hello", "at() reads through a borrow")
    assert_eq(xs.size(), 1, "and leaves the list owning its element")
}

@test
fun clone_is_independent(): void {
    var xs = List.new<int32>()
    xs.push(1)
    var copy = xs.clone()
    copy.push(2)
    assert_eq(xs.size(), 1, "the original is untouched")
    assert_eq(copy.size(), 2, "the copy grew on its own")
}

@test
fun iter_walks_every_element(): void {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    var total: int32 = 0
    while x in xs {
        total = total + x
    }
    assert_eq(total, 6, "the iterator yields each element once")
}

// A free function beside the tests hits the same shape.
fun doubled(v: int32): int32 {
    return v * 2
}

@test
fun a_free_helper_in_this_crate_is_callable(): void {
    assert_eq(doubled(21), 42, "a plain free function resolves here")
}

// `xs[i]` borrows, so an owning element is read in place.
@test fun an_index_reads_an_element(): void {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    xs.push(30)
    assert_eq(xs[0], 10, "the first element")
    assert_eq(xs[2], 30, "the last")
    assert_eq(xs[0] + xs[1], 30, "in an expression")
}

@test fun an_index_takes_a_computed_position(): void {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    val k: uint64 = 1
    assert_eq(xs[k], 20, "a variable index")
    var ix = List.new<uint64>()
    ix.push(0)
    assert_eq(xs[ix[0]], 10, "an index that is itself an index")
}

// A bit-copy would not see the mutation.
@test fun an_index_borrows_rather_than_copies(): void {
    var names = List.new<String>()
    names.push(String.from("aaa"))
    assert_eq(names[0] == "aaa", true, "reads the element")
    *(names.at_mut(0)) = String.from("zzz")
    assert_eq(names[0] == "zzz", true, "and sees the list's own storage")
}

@test fun index_and_index_mut_are_callable_directly(): void {
    var xs = List.new<int32>()
    xs.push(1)
    assert_eq(*(xs.index(0)), 1, "the shared accessor")
    *(xs.index_mut(0)) = 9
    assert_eq(xs[0], 9, "the mutable accessor")
}
