extern "C" fun kf_free(p: Ptr<void>): void

/// Values that live as long as the arena and are dropped together with it.
/// `put` moves a value in and hands back a pointer to it, which stays valid
/// until the arena is dropped: values sit in chunks that never move. Nothing
/// is freed on its own; for that, use `Box`.
pub struct Arena<T> {
    /// Each chunk's address, a `Ptr<T>`.
    var chunks: List<uint64>
    /// How many values the last chunk holds.
    var used: uint64
    var len: uint64
}

/// Chunk `i` holds 16 values, doubling to at most 4096.
fun arena_chunk_capacity(i: uint64): uint64 {
    var capacity: uint64 = 16
    var k: uint64 = 0
    while k < i && capacity < 4096 {
        capacity = capacity * 2
        k = k + 1
    }
    return capacity
}

impl Arena<T> {
    /// No allocation until the first `put`.
    pub static fun new(): Arena<T> {
        return Arena<T> { chunks: List.new<uint64>(), used: 0, len: 0 }
    }

    /// The arena owns `value` until it is dropped.
    pub mutating fun put(value: T): Ptr<T> {
        val count = self.chunks.size()
        if count == 0 || self.used == arena_chunk_capacity(count - 1) {
            val chunk: Ptr<T> = unsafe { alloc_array<T>(arena_chunk_capacity(count)) }
            self.chunks.push(chunk as uint64)
            self.used = 0
        }
        val last = self.chunks.get(self.chunks.size() - 1) as Ptr<T>
        val slot = unsafe { last + self.used }
        unsafe { *slot = value }
        self.used = self.used + 1
        self.len = self.len + 1
        return slot
    }

    pub fun size(): uint64 {
        return self.len
    }

    pub fun is_empty(): bool {
        return self.len == 0
    }
}

impl Drop for Arena<T> {
    fun drop(): void {
        val count = self.chunks.size()
        while i in 0..count {
            val chunk = self.chunks.get(i) as Ptr<T>
            val filled = if i + 1 == count { self.used } else { arena_chunk_capacity(i) }
            while k in 0..filled { unsafe { drop_in_place<T>(chunk + k) } }
            unsafe { kf_free(chunk as Ptr<void>) }
        }
    }
}
