// `String` answers as a view of it does; `push` reverses `chars()`.

import core.assert.assert_eq
import core.text.*

@test fun push_appends_a_whole_character(): void {
    var s = String.from("")
    s.push('h')
    s.push('é')
    assert_eq(s.byte_len(), 3, "one byte plus two")
    assert_eq(s.char_count(), 2, "two characters")
    assert_eq(s.as_str().equals("hé"), true, "and the bytes are in the right order")
    // A scalar UTF-8 cannot represent appends nothing rather than U+FFFD.
    s.push(55296 as char)
    assert_eq(s.char_count(), 2, "a surrogate appends nothing")
}

@test fun characters_round_trip_through_push(): void {
    var joined = String.from("")
    while c in "日本語".chars() { joined.push(c) }
    assert_eq(joined.as_str().equals("日本語"), true, "decode then encode is identity")
}

@test fun a_string_answers_as_its_view_does(): void {
    val owned = String.from("héllo")
    assert_eq(owned.char_count(), 5, "count")
    assert_eq(owned.char_at(1) == 'é', true, "char_at")
    assert_eq(owned.byte_len(), 6, "bytes disagree, which is the point")
    var n = 0
    while _ in owned.chars() { n = n + 1 }
    assert_eq(n, 5, "chars")
}
