extern "C" fun kf_free(p: Ptr<void>): void

// A growable, single-owner container: `val b = a` moves. `xs.at(i)` borrows an
// element; `xs.get(i)` copies one that is Copy.
/// The language finds the list type by key, not name.
@lang("list")
pub struct List<T> {
    var data: Ptr<T>
    var len: uint64
    var cap: uint64
}

impl List<T> {
    // No allocation until the first push.
    pub static fun new(): List<T> {
        return List<T> { data: unsafe { 0 as Ptr<T> }, len: 0, cap: 0 }
    }
    // Room for one more element; `len` is the caller's to advance.
    //
    // CONSTRAINT: takes no `T`: a self-call to a method taking the impl's
    // type parameter mangles with the type appended and does not link.
    mutating fun reserve_one(): void {
        if self.cap == 0 {
            self.cap = 4
            self.data = unsafe { alloc_array<T>(self.cap) }
        } else if self.len == self.cap {
            self.cap = self.cap * 2
            self.data = unsafe { realloc_array<T>(self.data, self.cap) }
        }
    }

    // The List now owns `item`.
    pub mutating fun push(item: T): void {
        self.reserve_one()
        unsafe { *(self.data + self.len) = item }
        self.len = self.len + 1
    }
    // A shared borrow into the buffer, read in place.
    pub fun at(i: uint64): &T {
        return unsafe { &*(self.data + i) }
    }
    // A mutable borrow into the buffer, mutated in place.
    pub fun at_mut(i: uint64): &var T {
        return unsafe { &var *(self.data + i) }
    }
    pub fun size(): uint64 {
        return self.len
    }
    pub fun is_empty(): bool {
        return self.len == 0
    }
    /// Independently owned buffer and elements.
    pub fun clone(): List<T> {
        var out = List<T> { data: unsafe { 0 as Ptr<T> }, len: 0, cap: 0 }
        var i = 0
        while i < self.len {
            out.push(unsafe { clone_place<T>(self.data + i) })
            i = i + 1
        }
        return out
    }
    // Drops the old element and moves `item` in.
    pub mutating fun set(i: uint64, item: T): void {
        unsafe { drop_in_place<T>(self.data + i) }
        unsafe { *(self.data + i) = item }
    }
    // Drops the last element; a no-op when empty. The buffer is kept.
    pub mutating fun pop(): void {
        if self.len == 0 { return }
        self.len = self.len - 1
        unsafe { drop_in_place<T>(self.data + self.len) }
    }
    // Moves the last element out to the caller; the slot is forgotten, not
    // dropped.
    pub mutating fun take_last(): T? {
        if self.len == 0 { return null }
        self.len = self.len - 1
        return unsafe { ptr_read<T>(self.data + self.len) }
    }

    // O(1) and order-breaking: drops slot `i`, bit-moves the last element
    // into it, and shrinks without dropping the vacated slot.
    pub mutating fun swap_remove(i: uint64): void {
        if i >= self.len { return }
        unsafe { drop_in_place<T>(self.data + i) }
        val last = self.len - 1
        if i != last {
            unsafe { *(self.data + i) = ptr_read<T>(self.data + last) }
        }
        self.len = last
    }
    // Exchanges slots `i` and `j` by raw slot moves; nothing is dropped or
    // cloned. Out of range on either index is a no-op.
    pub mutating fun swap(i: uint64, j: uint64): void {
        if i == j { return }
        if i >= self.len { return }
        if j >= self.len { return }
        // Annotated: an unannotated local in a generic body types as `int32`.
        val tmp: T = unsafe { ptr_read<T>(self.data + i) }
        unsafe { *(self.data + i) = ptr_read<T>(self.data + j) }
        unsafe { *(self.data + j) = tmp }
    }
    // The cursor for `while x in xs`. Borrows the buffer, so the List must
    // outlive the loop.
    pub fun iter(): ListIter<T> {
        return ListIter<T> { data: self.data, len: self.len, index: 0 }
    }
}

impl Iterable<T> for List<T> {
    type Iter = ListIter<T>
    fun iter(): ListIter<T> {
        return ListIter<T> { data: self.data, len: self.len, index: 0 }
    }
}

// A forward cursor over a List's buffer, not owning: valid only while the
// List is alive and unmodified.
pub struct ListIter<T> {
    var data: Ptr<T>
    var len: uint64
    var index: uint64
}

impl ListIter<T> {
    /// The next element's address, or null once exhausted; what
    /// `while x in &xs` desugars against.
    ///
    /// CONSTRAINT: points into the source buffer, valid only while the list is
    /// alive and unmodified, which binding it as `&T` enforces.
    pub mutating fun next_ptr(): Ptr<T> {
        if self.index >= self.len {
            return ptr_null<T>()
        }
        val p: Ptr<T> = self.data + self.index
        self.index = self.index + 1
        return p
    }

    pub mutating fun next(): T? {
        if self.index >= self.len {
            return null
        }
        // An owned deep copy; a bit-copy would share the element's heap and
        // the Option's drop would free it.
        val item: T = unsafe { clone_place<T>(self.data + self.index) }
        self.index = self.index + 1
        return item
    }
}

impl Iterator<T> for ListIter<T> {
    mutating fun next(): T? {
        if self.index >= self.len {
            return null
        }
        val item: T = unsafe { clone_place<T>(self.data + self.index) }
        self.index = self.index + 1
        return item
    }
}

/// Its own cursor, so `while x in xs.iter()` works.
impl Iterable<T> for ListIter<T> {
    type Iter = ListIter<T>
    fun iter(): ListIter<T> {
        return ListIter<T> { data: self.data, len: self.len, index: self.index }
    }
}

impl Drop for List<T> {
    fun drop(): void {
        var i = 0
        while i < self.len {
            unsafe { drop_in_place<T>(self.data + i) }
            i = i + 1
        }
        if self.cap > 0 { unsafe { kf_free(self.data as Ptr<void>) } }
    }
}

// `xs[i]` and `xs[i] = v`, through the borrowing accessors: a `get` bit-copy
// would free what `xs[i] = xs[j]` reads.
//
// Spelled `&Self.Out`: `&T` is rejected, since the associated type is not
// resolved behind a borrow.
impl Index<uint64> for List<T> {
    type Out = T
    fun index(k: uint64): &Self.Out {
        return self.at(k)
    }
}

impl IndexMut<uint64> for List<T> {
    mutating fun index_mut(k: uint64): &var Self.Out {
        return self.at_mut(k)
    }
}
