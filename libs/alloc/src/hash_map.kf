// A hash map: a generic struct over `List`s, keyed by `core.hash.Hash`.
//
// Storage is flat. Every entry lives at an index in `keys`/`vals` and the
// chains are indices: `heads[b]` starts bucket `b`, `next[i]` follows `i`,
// and `NONE` ends a chain:
//
//     heads: [ 2, NONE, 0, ... ]
//     next:  [ 1, NONE, NONE, ... ]      bucket 0: 2 -> nothing
//                                        bucket 2: 0 -> 1 -> nothing
//
// Iteration order is unspecified and changes on resize.
//
// CONSTRAINT: `hash_map.kf` sorts before `list.kf`, which keeps a consumer
// from emitting this crate's `Iterator__T` unsubstituted.

import core.hash.*
import core.entry.*

pub struct HashMap<K, V> {
    // Entry `i` is `keys[i]` -> `vals[i]`; the three entry arrays move
    // together.
    var keys: List<K>
    var vals: List<V>
    var next: List<uint64>
    // Per bucket, the index of its first entry.
    var heads: List<uint64>
}

/// The end of a chain, and "not found": 0 is a real index.
pub fun none_index(): uint64 { return 18446744073709551615 }

// Bounded on the impl, so a map can be held and dropped without the bound.
impl HashMap<K: Hash + Equal, V> {
    pub static fun new(): HashMap<K, V> {
        var hs = List.new<uint64>()
        var i: uint64 = 0
        while i < 8 {
            hs.push(none_index())
            i = i + 1
        }
        return HashMap<K, V> {
            keys: List.new<K>(), vals: List.new<V>(),
            next: List.new<uint64>(), heads: hs
        }
    }

    // `(*k).hash()`: a trait method on a `&K` receiver of a bounded generic
    // is not statically dispatched and emits a bare `hash(...)`.
    fun bucket_of(k: &K): uint64 {
        return (*k).hash() % self.heads.size()
    }

    /// `none_index()` when absent.
    fun find(k: &K): uint64 {
        val b = self.bucket_of(k)
        var i = self.heads.get(b)
        while i != none_index() {
            if self.keys.at(i) == k { return i }
            i = self.next.get(i)
        }
        return none_index()
    }

    /// An existing entry has its value replaced and dropped.
    pub mutating fun insert(k: K, v: V): void {
        val at = self.find(&k)
        if at != none_index() {
            self.vals.set(at, v)
            return
        }
        val b = self.bucket_of(&k)
        // Onto the front of the chain; `find` proved `k` absent.
        val idx = self.keys.size()
        self.keys.push(k)
        self.vals.push(v)
        self.next.push(self.heads.get(b))
        self.heads.set(b, idx)
        // Grow past an average chain of 3/4, without floats.
        if self.keys.size() * 4 > self.heads.size() * 3 {
            self.grow()
        }
    }

    /// A borrow of the value under `k`, or `None`. A caller wanting it owned
    /// clones it.
    ///
    /// `Option<&V>`, not `&V?`, which is `&Option<V>`.
    pub fun get(k: &K): Option<&V> {
        val at = self.find(k)
        if at == none_index() { return Option.None }
        return Option.Some(self.vals.at(at))
    }

    pub fun contains(k: &K): bool {
        return self.find(k) != none_index()
    }

    /// Drops the key and value. True if there was one.
    pub mutating fun remove(k: &K): bool {
        val b = self.bucket_of(k)
        var i = self.heads.get(b)
        var prev = none_index()
        while i != none_index() {
            if self.keys.at(i) == k {
                // Unlinked first, so the fix-up never walks through it.
                if prev == none_index() {
                    self.heads.set(b, self.next.get(i))
                } else {
                    self.next.set(prev, self.next.get(i))
                }
                self.compact(i)
                return true
            }
            prev = i
            i = self.next.get(i)
        }
        return false
    }

    /// Drops entry `i` and closes the hole: `swap_remove` moves the last
    /// entry into `i`, so whatever pointed at the last index is repointed.
    /// The caller has unlinked `i`.
    mutating fun compact(i: uint64): void {
        val last = self.keys.size() - 1
        if i != last {
            // Walked fresh, so an unlink in the same bucket is accounted for.
            val lb = self.bucket_of(self.keys.at(last))
            if self.heads.get(lb) == last {
                self.heads.set(lb, i)
            } else {
                var q = self.heads.get(lb)
                while q != none_index() {
                    if self.next.get(q) == last {
                        self.next.set(q, i)
                        q = none_index()
                    } else {
                        q = self.next.get(q)
                    }
                }
            }
        }
        // `next[i]` becomes the moved entry's own link.
        self.keys.swap_remove(i)
        self.vals.swap_remove(i)
        self.next.swap_remove(i)
    }

    pub fun size(): uint64 { return self.keys.size() }

    pub fun is_empty(): bool { return self.keys.size() == 0 }

    /// Unspecified order, changing across a resize.
    pub fun keys(): ListIter<K> { return self.keys.iter() }

    /// In the order `keys()` walks.
    pub fun values(): ListIter<V> { return self.vals.iter() }

    /// In the order `keys()` and `values()` walk.
    pub fun entries(): HashMapEntries<K, V> {
        return HashMapEntries<K, V> { ks: self.keys.iter(), vs: self.vals.iter() }
    }

    /// Doubles the buckets and rebuilds the chains; entries keep their
    /// indices.
    mutating fun grow(): void {
        // Refilled in place: assigning the field would leak the old buffer.
        val wanted = self.heads.size() * 2
        while !self.heads.is_empty() {
            self.heads.pop()
        }
        var i = 0
        while i < wanted {
            self.heads.push(none_index())
            i = i + 1
        }
        var e = 0
        while e < self.keys.size() {
            val b = (*self.keys.at(e)).hash() % self.heads.size()
            self.next.set(e, self.heads.get(b))
            self.heads.set(b, e)
            e = e + 1
        }
    }
}

/// `while e in map` walks entries, as `m.entries()` does: two `ListIter`s in
/// lockstep.
impl Iterable<Entry<K, V>> for HashMap<K: Hash + Equal, V> {
    type Iter = HashMapEntries<K, V>
    fun iter(): HashMapEntries<K, V> {
        return self.entries()
    }
}

pub struct HashMapEntries<K, V> {
    var ks: ListIter<K>
    var vs: ListIter<V>
}

impl Iterator<Entry<K, V>> for HashMapEntries<K, V> {
    mutating fun next(): Entry<K, V>? {
        val k = self.ks.next() ?: return null
        val v = self.vs.next() ?: return null
        return Entry<K, V> { key: k, value: v }
    }
}

/// Its own cursor, so `while e in m.entries()` works.
impl Iterable<Entry<K, V>> for HashMapEntries<K, V> {
    type Iter = HashMapEntries<K, V>
    fun iter(): HashMapEntries<K, V> {
        return HashMapEntries<K, V> { ks: self.ks, vs: self.vs }
    }
}
