// Lines and counted runs of bytes over a stream, buffering whatever arrives
// between them.

/// `take_*` answer from what is buffered and never block; `read_*` wait on
/// the stream for the rest. Owns its stream.
///
/// CONSTRAINT: a line already buffered is ready although its stream may not
/// be, so drain `take_line`/`take_bytes` before waiting on the stream.
pub struct Reader {
    var source: Stream
    var buffer: String
    var ended: bool
    var failure: IoError?
}

impl Reader {
    pub static fun new(source: Stream): Reader {
        return Reader { source: source, buffer: "", ended: false, failure: null }
    }

    /// The stream, to register with a `Poll`.
    pub fun stream(): &Stream {
        return &self.source
    }

    /// The stream has ended or failed, and nothing is left in the buffer.
    pub fun at_end(): bool {
        return self.ended && self.buffer.is_empty()
    }

    /// Why the stream stopped, when it was not a clean end.
    pub fun error(): IoError? {
        return self.failure.clone()
    }

    /// Moves whatever the stream has waiting into the buffer without
    /// blocking; false when nothing came.
    pub mutating fun fill(): bool {
        if self.ended { return false }
        when (self.source.read_available(65536)) {
            Data(bytes) => {
                self.buffer.append(bytes.as_str())
                return true
            }
            Pending => return false
            End => self.ended = true
            Failed(error) => {
                self.ended = true
                self.failure = Option.Some(error.clone())
            }
        }
        return false
    }

    /// The next complete line, without its newline; at the end, the text
    /// after the last newline counts as a line.
    pub mutating fun take_line(): String? {
        when (self.buffer.index_of("\n")) {
            Some(end) => return Option.Some(self.split_off(end, end + 1))
            None => {}
        }
        if self.ended && !self.buffer.is_empty() {
            val length = self.buffer.byte_len()
            return Option.Some(self.split_off(length, length))
        }
        return null
    }

    /// Exactly `count` bytes once that many are buffered; at the end, what
    /// is left, if anything.
    pub mutating fun take_bytes(count: uint64): String? {
        if self.buffer.byte_len() >= count { return Option.Some(self.split_off(count, count)) }
        if self.ended && !self.buffer.is_empty() {
            val length = self.buffer.byte_len()
            return Option.Some(self.split_off(length, length))
        }
        return null
    }

    /// The next line, waiting for it; `null` once the stream has ended.
    pub mutating fun read_line(): String? {
        while true {
            val line = self.take_line()
            if line != null || self.ended { return line }
            self.wait_for_more()
        }
        return null
    }

    /// Exactly `count` bytes, waiting for them; fewer only at the end.
    pub mutating fun read_bytes(count: uint64): String? {
        while true {
            val bytes = self.take_bytes(count)
            if bytes != null || self.ended { return bytes }
            self.wait_for_more()
        }
        return null
    }

    mutating fun wait_for_more(): void {
        var poll = Poll.new()
        poll.add(&self.source, 0)
        val _ready = poll.wait(null)
        val _filled = self.fill()
    }

    /// The buffer's first `take` bytes, dropping `consumed` from its front.
    mutating fun split_off(take: uint64, consumed: uint64): String {
        val taken = self.buffer.substring(0, take)
        self.buffer = self.buffer.substring(consumed, self.buffer.byte_len())
        return taken
    }
}
