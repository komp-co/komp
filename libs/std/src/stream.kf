// Streams over operating-system descriptors: pipe ends, and this process's
// own standard streams. Reading never blocks; waiting is `Poll`'s.

extern "C" fun kf_stream_read(fd: int32, max: uint64): String
extern "C" fun kf_stream_write(fd: int32, data: str, len: uint64): int32
extern "C" fun kf_stream_close(fd: int32): void
extern "C" fun kf_stream_pipe(): int64
extern "C" fun kf_stream_last(): int32
extern "C" fun kf_stream_errno(): int32
extern "C" fun kf_stream_error_text(code: int32): String

/// What one read found.
pub enum ReadOutcome {
    /// Bytes that were waiting; never empty.
    Data(String)
    /// Nothing yet: the other end is open and has not written.
    Pending
    /// The other end closed; nothing more will come.
    End
    Failed(IoError)
}

/// One open descriptor. A stream this process opened closes when dropped;
/// the standard streams are borrowed and stay open.
pub struct Stream {
    var fd: int32
    var owned: bool
    val name: String
}

impl Stream {
    pub static fun stdin(): Stream { return Stream { fd: 0, owned: false, name: "stdin" } }

    pub static fun stdout(): Stream { return Stream { fd: 1, owned: false, name: "stdout" } }

    pub static fun stderr(): Stream { return Stream { fd: 2, owned: false, name: "stderr" } }

    /// A stream that is already closed: reads end and writes fail.
    pub static fun closed(): Stream { return Stream { fd: -1, owned: false, name: "closed stream" } }

    /// This stream, moved out; what is left behind is closed.
    pub mutating fun take(): Stream {
        val taken = Stream { fd: self.fd, owned: self.owned, name: self.name.clone() }
        self.fd = -1
        self.owned = false
        return taken
    }

    static fun owning(fd: int32, name: str): Stream {
        return Stream { fd: fd, owned: true, name: String.from(name) }
    }

    /// Whatever is waiting, up to `max` bytes, without blocking.
    pub fun read_available(max: uint64): ReadOutcome {
        if self.fd < 0 { return ReadOutcome.End }
        val bytes = kf_stream_read(self.fd, max)
        return when (kf_stream_last()) {
            0 => ReadOutcome.Data(bytes)
            1 => ReadOutcome.Pending
            2 => ReadOutcome.End
            _ => ReadOutcome.Failed(self.last_error())
        }
    }

    /// All of `text`, blocking until the other end has taken it. A reader
    /// that has gone is an error, not a signal that ends the process.
    pub fun write(text: str): Result<void, IoError> {
        if self.fd < 0 || kf_stream_write(self.fd, text, text.byte_len()) != 0 {
            return Result.Err(self.last_error())
        }
        return Result.Ok()
    }

    fun last_error(): IoError {
        val code = if self.fd < 0 { 9 } else { kf_stream_errno() }
        return IoError { path: self.name.clone(), code: code, message: kf_stream_error_text(code) }
    }
}

impl Drop for Stream {
    fun drop(): void {
        if self.owned { kf_stream_close(self.fd) }
    }
}

/// The two ends of a pipe: what is written to `writer` is read from
/// `reader`. A spawned child inherits neither.
pub struct Pipe {
    pub var reader: Stream
    pub var writer: Stream
}

pub fun pipe(): Result<Pipe, IoError> {
    val ends = kf_stream_pipe()
    if ends < 0 {
        val code = kf_stream_errno()
        return Result.Err(IoError { path: "pipe", code: code, message: kf_stream_error_text(code) })
    }
    val reader = Stream.owning((ends >> 32) as int32, "pipe")
    val writer = Stream.owning((ends & 4294967295) as int32, "pipe")
    return Result.Ok(Pipe { reader: reader, writer: writer })
}
