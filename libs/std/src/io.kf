// Standard input, and standard error. Reading returns an owned `String`, so it
// is here; `Stdout` and `print` are in `core.display`.

extern "C" fun runtime_println(s: str): void
extern "C" fun kf_stdin_read_line(): String
extern "C" fun kf_stdin_read_bytes(n: uint64): String
extern "C" fun kf_stdin_eof(): int32

/// The next line of standard input, without its newline; `null` once input
/// is exhausted, distinct from an empty line.
pub fun read_line(): String? {
    val line = kf_stdin_read_line()
    if unsafe { kf_stdin_eof() } != 0 {
        if line.is_empty() { return null }
    }
    return Option.Some(line)
}

/// Exactly `n` bytes of standard input, or fewer when input ends first;
/// `null` when nothing remains. Bytes, not characters.
pub fun read_bytes(n: uint64): String? {
    val chunk = kf_stdin_read_bytes(n)
    if chunk.is_empty() {
        if unsafe { kf_stdin_eof() } != 0 { return null }
    }
    return Option.Some(chunk)
}

/// Whether the last read reached the end of input.
pub fun at_end(): bool {
    return unsafe { kf_stdin_eof() } != 0
}

/// Standard error as a `Write` sink, for a program whose stdout is a protocol.
pub struct Stderr { }

impl Write for Stderr {
    mutating fun write_str(s: str): void {
        val _written = Stream.stderr().write(s)
    }
}

/// `v` on standard error, without a newline.
pub fun eprint(v: &dyn Display): void {
    var out = Stderr { }
    v.display(&var out)
}

/// `v` on standard error, followed by exactly one newline.
pub fun eprintln(v: &dyn Display): void {
    var out = Stderr { }
    v.display(&var out)
    out.write_str("\n")
}
