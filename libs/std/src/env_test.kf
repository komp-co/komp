import core.assert.assert_eq

@test
fun a_set_variable_is_read(): void {
    assert_eq(env_var("PATH").is_some(), true, "every process inherits a PATH")
}

@test
fun an_unset_variable_is_null(): void {
    assert_eq(env_var("KF_STD_ENV_TEST_NEVER_SET").is_none(), true, "not the empty string")
}

@test
fun a_variable_set_here_is_read_back(): void {
    set_env_var("KF_STD_ENV_TEST_SET", "yes")
    assert_eq(env_var("KF_STD_ENV_TEST_SET")?.as_str() ?: "", "yes", "the value just set")
}
