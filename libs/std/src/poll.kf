// Waiting on several streams at once, from one thread.

import alloc.list.*

extern "C" fun kf_stream_poll_clear(): void
extern "C" fun kf_stream_poll_add(fd: int32): int32
extern "C" fun kf_stream_poll(timeout_ms: int64): int32
extern "C" fun kf_stream_poll_ready(i: uint64): bool

/// Streams to wait on, each under a token the caller picks. `wait` reports
/// readiness and reads nothing: the caller reads from the streams it names.
///
/// CONSTRAINT: a stream stays open for as long as it is added; `remove` it
/// before dropping it.
pub struct Poll {
    var fds: List<int32>
    var tokens: List<uint64>
}

impl Poll {
    pub static fun new(): Poll {
        return Poll { fds: List.new<int32>(), tokens: List.new<uint64>() }
    }

    pub mutating fun add(stream: &Stream, token: uint64): void {
        self.fds.push(stream.fd)
        self.tokens.push(token)
    }

    /// Every stream added under `token`.
    pub mutating fun remove(token: uint64): void {
        var fds = List.new<int32>()
        var tokens = List.new<uint64>()
        while i in 0..self.tokens.size() {
            if self.tokens[i] != token {
                fds.push(self.fds[i])
                tokens.push(self.tokens[i])
            }
        }
        self.fds = fds
        self.tokens = tokens
    }

    /// The tokens whose stream has input waiting or has closed, in the order
    /// they were added; empty when `timeout` passed first. With no timeout,
    /// waits as long as it takes.
    pub fun wait(timeout: Duration?): Result<List<uint64>, IoError> {
        kf_stream_poll_clear()
        var added = 0
        while i in 0..self.fds.size() { added = added + kf_stream_poll_add(self.fds[i]) }
        val timeout_ms = timeout?.as_millis() ?: -1
        if added < 0 || kf_stream_poll(timeout_ms) < 0 {
            val code = kf_stream_errno()
            return Result.Err(IoError { path: "poll", code: code, message: kf_stream_error_text(code) })
        }
        var tokens = List.new<uint64>()
        while i in 0..self.tokens.size() {
            if kf_stream_poll_ready(i) { tokens.push(self.tokens[i]) }
        }
        return Result.Ok(tokens)
    }
}
