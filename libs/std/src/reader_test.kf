import core.assert.assert_eq

@test
fun a_line_is_taken_without_its_newline(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("first\nsecond\n")
    var reader = Reader.new(ends.reader.take())
    assert_eq(reader.read_line() ?: "", "first", "one line")
}

@test
fun a_partial_line_is_not_taken(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("unfinished")
    var reader = Reader.new(ends.reader.take())
    val _filled = reader.fill()
    assert_eq(reader.take_line().is_none(), true, "no newline yet")
}

@test
fun counted_bytes_follow_a_header_line(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("Content-Length: 5\r\n\r\nhello")
    var reader = Reader.new(ends.reader.take())
    val _header = reader.read_line()
    val _blank = reader.read_line()
    assert_eq(reader.read_bytes(5) ?: "", "hello", "the body")
}

@test
fun the_last_line_needs_no_newline_at_the_end(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("tail")
    ends.writer = Stream.closed()
    var reader = Reader.new(ends.reader.take())
    assert_eq(reader.read_line() ?: "", "tail", "the rest is a line")
}

@test
fun a_reader_ends_when_its_stream_does(): void {
    var ends = pipe().unwrap()
    ends.writer = Stream.closed()
    var reader = Reader.new(ends.reader.take())
    assert_eq(reader.read_line().is_none(), true, "nothing more")
}
