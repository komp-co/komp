// `a..b`: a half-open range over any type that can be compared and added to,
// and a value like any other. Lazy, so iterating allocates nothing.
//
// `step` is a field: core has no trait producing one at a type parameter.

pub struct Range<T> {
    pub val start: T
    pub val end: T
    pub val step: T
    /// Whether `end` is itself yielded. `0..n` is exclusive, `0..=n` is not.
    pub val inclusive: bool
    /// Which way `start` travels, never inferred from the operands, so `0..0`
    /// stays empty. `n..0` is empty; `(n..0).down()` counts down.
    pub val descending: bool
}

/// `start` up to but not including `end`, advancing by `step`. A free function
/// so `T` is inferred, which lets `..` desugar without knowing types.
@prelude
pub fun range<T: Compare + Add + Sub + Mod + Copy>(start: T, end: T, step: T): Range<T> {
    return Range<T> { start: start, end: end, step: step, inclusive: false, descending: false }
}

/// `start` up to and including `end`, advancing by `step`: what `a..=b`
/// spells.
@prelude
pub fun range_inclusive<T: Compare + Add + Sub + Mod + Copy>(start: T, end: T, step: T): Range<T> {
    return Range<T> { start: start, end: end, step: step, inclusive: true, descending: false }
}

impl Range<T: Compare + Add + Sub + Mod + Copy> {
    /// The same endpoints and step, travelled downward: `start`,
    /// `start - step`, and so on toward `end`.
    ///
    /// Not reversal: `(0..10).down()` is empty, while `(0..10).rev()` yields 9
    /// through 0.
    pub fun down(): Range<T> {
        return Range<T> {
            start: self.start, end: self.end, step: self.step,
            inclusive: self.inclusive, descending: true
        }
    }

    /// The same interval, strided by `step`.
    ///
    ///     while i in (0..n).by(2) { ... }        // 0, 2, 4, ...
    ///
    /// A zero step gives an empty range.
    pub fun by(step: T): Range<T> {
        val zero = step.sub(step)
        if !(zero < step) {
            return Range<T> {
                start: self.start, end: self.start, step: self.step,
                inclusive: false, descending: self.descending
            }
        }
        return Range<T> {
            start: self.start, end: self.end, step: step,
            inclusive: self.inclusive, descending: self.descending
        }
    }

    /// Whether this range yields nothing.
    pub fun is_empty(): bool {
        if self.descending {
            if self.inclusive { return self.start < self.end }
            return !(self.end < self.start)
        }
        if self.inclusive { return self.end < self.start }
        return !(self.start < self.end)
    }

    /// The same elements, in the opposite order. Unlike `down()` it starts at
    /// the last element: `range(0, 10, 3).rev()` is 9, 6, 3, 0.
    pub fun rev(): Range<T> {
        if self.is_empty() {
            return Range<T> {
                start: self.start, end: self.start, step: self.step,
                inclusive: false, descending: self.descending
            }
        }
        return Range<T> {
            start: self.last(), end: self.start, step: self.step,
            inclusive: true, descending: !self.descending
        }
    }

    /// This range's elements, then `other`'s.
    ///
    ///     while i in (0..5).chain(8..10) { ... }   // 0-4, then 8-9
    ///
    /// A third segment is reached by constructing `Chain` directly over
    /// another `Chain`.
    pub fun chain(other: Range<T>): Chain<RangeIter<T>, RangeIter<T>, T> {
        return Chain<RangeIter<T>, RangeIter<T>, T> {
            first: self.iter(), second: other.iter(), on_first: true
        }
    }

    /// Undefined when empty; `rev` checks first.
    ///
    /// `zero` is `end - end`: a literal has no type at a type parameter.
    fun last(): T {
        val zero = self.end.sub(self.end)
        if self.descending {
            val m = self.start.sub(self.end) % self.step
            // Landing on `end` of an exclusive range: the last is a step
            // short.
            if !(zero < m) {
                if self.inclusive { return self.end }
                return self.end.add(self.step)
            }
            return self.end.add(m)
        }
        val m = self.end.sub(self.start) % self.step
        if !(zero < m) {
            if self.inclusive { return self.end }
            return self.end.sub(self.step)
        }
        return self.end.sub(m)
    }
}

impl Iterable<T> for Range<T: Compare + Add + Sub + Mod + Copy> {
    type Iter = RangeIter<T>
    fun iter(): RangeIter<T> {
        return RangeIter<T> { cur: self.start, end: self.end, step: self.step, inclusive: self.inclusive, descending: self.descending, done: false }
    }
}

/// Holds its own copy of the endpoints, so it may outlive its `Range`.
pub struct RangeIter<T> {
    pub var cur: T
    pub var end: T
    pub val step: T
    pub val inclusive: bool
    /// See `Range.descending`.
    pub val descending: bool
    /// Latched after an inclusive range's final element: `0..=255` over
    /// `uint8` has no value after it to advance to.
    pub var done: bool
}

impl Iterator<T> for RangeIter<T: Compare + Add + Sub + Mod + Copy> {
    mutating fun next(): T? {
        if self.done { return null }
        // `>=`, not `.compare(..) >= 0`, which compares twice.
        if self.descending {
            if self.inclusive {
                if self.cur < self.end { return null }
            } else {
                if self.cur <= self.end { return null }
            }
        } else {
            if self.inclusive {
                if self.cur > self.end { return null }
            } else {
                if self.cur >= self.end { return null }
            }
        }
        val v = self.cur
        // Whether there is a next element is decided by the distance left, so
        // the out-of-range value is never computed and nothing wraps. The
        // guards above put `cur` on the near side of `end`, so neither
        // subtraction underflows.
        var room = self.end.sub(self.cur)
        if self.descending { room = self.cur.sub(self.end) }
        var has_next: bool = false
        if self.inclusive {
            // Room for at least one more step.
            has_next = !(room < self.step)
        } else {
            has_next = room > self.step
        }
        if has_next {
            if self.descending {
                self.cur = self.cur.sub(self.step)
            } else {
                self.cur = self.cur.add(self.step)
            }
        } else {
            self.done = true
        }
        return v
    }
}
