// Unix-epoch seconds to a calendar date and back, in UTC; reads no clock.
// Howard Hinnant's civil/days conversions, exact for the proleptic Gregorian
// calendar over int64 using only integer division.

import core.time.*
import core.primitives.write_uint64

/// Days from 1970-01-01 to `y-m-d`, negative before the epoch. March starts
/// the year, so the leap day ends the cycle.
pub fun days_from_civil(year: int64, month: int64, day: int64): int64 {
    var y = year
    if month <= 2 { y = y - 1 }
    var era: int64 = 0
    if y >= 0 { era = y / 400 } else { era = (y - 399) / 400 }
    val yoe = y - era * 400
    var mp = month + 9
    if month > 2 { mp = month - 3 }
    val doy = (153 * mp + 2) / 5 + day - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

pub struct Date {
    pub val year: int64
    pub val month: int64
    pub val day: int64
}

/// The date `days` after 1970-01-01.
pub fun civil_from_days(days: int64): Date {
    val z = days + 719468
    var era: int64 = 0
    if z >= 0 { era = z / 146097 } else { era = (z - 146096) / 146097 }
    val doe = z - era * 146097
    val yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    val y = yoe + era * 400
    val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    val mp = (5 * doy + 2) / 153
    val d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if mp >= 10 { m = mp - 9 }
    var out_year = y
    if m <= 2 { out_year = y + 1 }
    return Date { year: out_year, month: m, day: d }
}

/// Every fourth year, except centuries, except every fourth century.
pub fun is_leap_year(year: int64): bool {
    if year % 4 != 0 { return false }
    if year % 100 != 0 { return true }
    return year % 400 == 0
}

pub fun days_in_month(year: int64, month: int64): int64 {
    if month == 2 {
        if is_leap_year(year) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

impl Date {
    pub static fun of(year: int64, month: int64, day: int64): Date {
        return Date { year: year, month: month, day: day }
    }

    /// Days since 1970-01-01.
    pub fun to_days(): int64 { return days_from_civil(self.year, self.month, self.day) }

    /// 0 is Sunday.
    pub fun day_of_week(): int64 {
        val z = self.to_days()
        if z >= -4 { return (z + 4) % 7 }
        return (z + 5) % 7 + 6
    }

    /// 1 on the first of January.
    pub fun day_of_year(): int64 {
        return self.to_days() - days_from_civil(self.year, 1, 1) + 1
    }

    pub fun plus_days(n: int64): Date { return civil_from_days(self.to_days() + n) }

    /// `civil_from_days` always produces a valid date; a hand-built one may not
    /// be.
    pub fun is_valid(): bool {
        if self.month < 1 || self.month > 12 { return false }
        if self.day < 1 { return false }
        return self.day <= days_in_month(self.year, self.month)
    }
}

impl Equal for Date {
    fun equals(other: &Date): bool {
        return self.year == other.year && self.month == other.month && self.day == other.day
    }
}

impl Compare for Date {
    fun compare(other: &Date): int32 {
        val a = self.to_days()
        val b = other.to_days()
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
}

/// Zero-padded to `width`, the sign outside: -7 at width 3 is "-007". Never
/// truncates.
pub fun write_padded(out: &var dyn Write, value: int64, width: uint64): void {
    // In uint64: the most negative int64 has no positive counterpart.
    var magnitude = value as uint64
    if value < 0 {
        out.write_str("-")
        magnitude = 0 - (value as uint64)
    }
    var digits: uint64 = 1
    var rest = magnitude / 10
    while rest > 0 {
        digits = digits + 1
        rest = rest / 10
    }
    while digits < width {
        out.write_str("0")
        digits = digits + 1
    }
    write_uint64(out, magnitude)
}

/// ISO 8601: `2026-08-21`.
impl Display for Date {
    fun display(out: &var dyn Write): void {
        write_padded(out, self.year, 4)
        out.write_str("-")
        write_padded(out, self.month, 2)
        out.write_str("-")
        write_padded(out, self.day, 2)
    }
}

pub struct DateTime {
    pub val date: Date
    pub val hour: int64
    pub val minute: int64
    pub val second: int64
    pub val nano: int64
}

impl DateTime {
    pub static fun of(date: Date, hour: int64, minute: int64, second: int64): DateTime {
        return DateTime { date: date, hour: hour, minute: minute, second: second, nano: 0 }
    }

    /// The UTC date and time at `seconds` after the Unix epoch, flooring
    /// before the epoch: -1 is the last second of 1969.
    pub static fun from_unix(seconds: int64): DateTime {
        var days = seconds / seconds_per_day()
        var rem = seconds % seconds_per_day()
        if rem < 0 {
            days = days - 1
            rem = rem + seconds_per_day()
        }
        return DateTime {
            date: civil_from_days(days),
            hour: rem / seconds_per_hour(),
            minute: (rem % seconds_per_hour()) / seconds_per_minute(),
            second: rem % seconds_per_minute(),
            nano: 0
        }
    }

    /// Seconds since the Unix epoch.
    pub fun to_unix(): int64 {
        var total = self.date.to_days() * seconds_per_day()
        total = total + self.hour * seconds_per_hour()
        total = total + self.minute * seconds_per_minute()
        return total + self.second
    }

    pub fun plus(d: Duration): DateTime {
        return DateTime.from_unix(self.to_unix() + d.as_seconds())
    }

    /// The span from `earlier` to this.
    pub fun since(earlier: DateTime): Duration {
        return Duration.from_seconds(self.to_unix() - earlier.to_unix())
    }
}

impl Equal for DateTime {
    fun equals(other: &DateTime): bool { return self.to_unix() == other.to_unix() }
}

impl Compare for DateTime {
    fun compare(other: &DateTime): int32 {
        val a = self.to_unix()
        val b = other.to_unix()
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
}

/// ISO 8601 in UTC: `2026-08-21T12:34:56Z`.
impl Display for DateTime {
    fun display(out: &var dyn Write): void {
        self.date.display(out)
        out.write_str("T")
        write_padded(out, self.hour, 2)
        out.write_str(":")
        write_padded(out, self.minute, 2)
        out.write_str(":")
        write_padded(out, self.second, 2)
        out.write_str("Z")
    }
}
