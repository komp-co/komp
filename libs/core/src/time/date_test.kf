// Dates before the epoch, leap days, century boundaries and year-end.

import core.assert.*
import core.display.*
import core.time.*

fun padded_as(value: int64, width: uint64, expected: str): bool {
    var d = new_render_digest()
    write_padded(&var d, value, width)
    return digest_matches(&d, expected)
}

@test fun the_epoch_is_day_zero(): void {
    assert_eq(days_from_civil(1970, 1, 1), 0, "epoch")
    assert_eq(renders_as(&(civil_from_days(0)), "1970-01-01"), true, "back again")
}

@test fun civil_and_days_are_inverses(): void {
    // Across a leap day, a century, and a pre-epoch date.
    assert_eq(renders_as(&(civil_from_days(days_from_civil(2024, 2, 29))), "2024-02-29"), true, "leap day")
    assert_eq(renders_as(&(civil_from_days(days_from_civil(1900, 3, 1))), "1900-03-01"), true, "non-leap century")
    assert_eq(renders_as(&(civil_from_days(days_from_civil(2000, 2, 29))), "2000-02-29"), true, "leap century")
    assert_eq(renders_as(&(civil_from_days(days_from_civil(1969, 12, 31))), "1969-12-31"), true, "before the epoch")
    assert_eq(renders_as(&(civil_from_days(days_from_civil(1, 1, 1))), "0001-01-01"), true, "year one")
}

// 1900 is not a leap year and 2000 is.
@test fun leap_years_follow_the_gregorian_rule(): void {
    assert_eq(is_leap_year(2024), true, "ordinary leap year")
    assert_eq(is_leap_year(2023), false, "ordinary year")
    assert_eq(is_leap_year(1900), false, "century that is not")
    assert_eq(is_leap_year(2000), true, "century that is")
}

@test fun month_lengths(): void {
    assert_eq(days_in_month(2024, 2), 29, "february in a leap year")
    assert_eq(days_in_month(2023, 2), 28, "february otherwise")
    assert_eq(days_in_month(2023, 1), 31, "january")
    assert_eq(days_in_month(2023, 4), 30, "april")
    assert_eq(days_in_month(2023, 12), 31, "december")
}

@test fun validity_rejects_days_that_do_not_exist(): void {
    assert_eq(Date.of(2024, 2, 29).is_valid(), true, "leap day exists in 2024")
    assert_eq(Date.of(2023, 2, 29).is_valid(), false, "but not in 2023")
    assert_eq(Date.of(2023, 13, 1).is_valid(), false, "no thirteenth month")
    assert_eq(Date.of(2023, 0, 1).is_valid(), false, "no zeroth month")
    assert_eq(Date.of(2023, 4, 31).is_valid(), false, "april has thirty days")
    assert_eq(Date.of(2023, 1, 31).is_valid(), true, "january has thirty-one")
}

@test fun adding_days_rolls_over(): void {
    assert_eq(renders_as(&(Date.of(2026, 12, 31).plus_days(1)), "2027-01-01"), true, "year end")
    assert_eq(renders_as(&(Date.of(2024, 2, 28).plus_days(1)), "2024-02-29"), true, "into a leap day")
    assert_eq(renders_as(&(Date.of(2023, 2, 28).plus_days(1)), "2023-03-01"), true, "past a missing one")
    assert_eq(renders_as(&(Date.of(1970, 1, 1).plus_days(-1)), "1969-12-31"), true, "backwards over the epoch")
}

@test fun day_of_week(): void {
    // 1970-01-01 was a Thursday.
    assert_eq(Date.of(1970, 1, 1).day_of_week(), 4, "the epoch was a Thursday")
    assert_eq(Date.of(1969, 12, 31).day_of_week(), 3, "the day before, a Wednesday")
    assert_eq(Date.of(2000, 1, 1).day_of_week(), 6, "a Saturday")
}

@test fun day_of_year(): void {
    assert_eq(Date.of(2023, 1, 1).day_of_year(), 1, "first")
    assert_eq(Date.of(2023, 12, 31).day_of_year(), 365, "last of an ordinary year")
    assert_eq(Date.of(2024, 12, 31).day_of_year(), 366, "last of a leap year")
}

@test fun unix_time_round_trips(): void {
    assert_eq(renders_as(&(DateTime.from_unix(0)), "1970-01-01T00:00:00Z"), true, "epoch")
    assert_eq(DateTime.from_unix(0).to_unix(), 0, "back")
    assert_eq(DateTime.from_unix(1755777296).to_unix(), 1755777296, "an arbitrary instant")
}

// A second before the epoch is day -1, not day 0 hour -1.
@test fun times_before_the_epoch_floor_rather_than_truncate(): void {
    assert_eq(renders_as(&(DateTime.from_unix(-1)), "1969-12-31T23:59:59Z"), true, "one second before")
    assert_eq(renders_as(&(DateTime.from_unix(-86400)), "1969-12-31T00:00:00Z"), true, "one day before")
    assert_eq(DateTime.from_unix(-1).to_unix(), -1, "and back")
}

@test fun datetime_arithmetic(): void {
    val start = DateTime.from_unix(0)
    assert_eq(renders_as(&(start.plus(Duration.from_hours(25))), "1970-01-02T01:00:00Z"), true, "past midnight")
    val later = DateTime.from_unix(3600)
    assert_eq(later.since(start).as_seconds(), 3600, "difference")
    assert_eq(start.since(later).as_seconds(), -3600, "and its negation")
}

@test fun formatting_is_iso_8601_with_the_zone(): void {
    assert_eq(renders_as(&(DateTime.of(Date.of(2026, 8, 21), 12, 34, 56)),
        "2026-08-21T12:34:56Z"), true, "full timestamp")
    assert_eq(renders_as(&(Date.of(2026, 1, 2)), "2026-01-02"), true, "fields are padded")
    assert_eq(padded_as(7, 3, "007"), true, "padding")
    assert_eq(padded_as(-7, 3, "-007"), true, "the sign stays outside the padding")
    assert_eq(padded_as(12345, 2, "12345"), true, "never truncates")
    assert_eq(padded_as(0, 2, "00"), true, "zero is a digit")
}
