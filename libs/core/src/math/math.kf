// Arithmetic needing no C library. The libm functions are in
// core.math_hosted.


/// The lesser of two values, for anything `Compare`.
@prelude
pub fun min<T: Compare>(a: T, b: T): T {
    if a.compare(b) <= 0 { return a }
    return b
}

@prelude
pub fun max<T: Compare>(a: T, b: T): T {
    if a.compare(b) >= 0 { return a }
    return b
}

/// `self` confined to `[lo, hi]`; with `lo > hi` the result is `lo`.
/// `clamp(x, lo, hi)` works too.
@prelude
pub fun <T: Compare + Clone> T.clamp(lo: T, hi: T): T {
    return max<T>(lo, min<T>(self.clone(), hi))
}

/// Distance from zero, for any numeric type; the identity on unsigned ones.
@prelude
pub fun <T: Compare + Sub + Zero + Clone> T.abs(): T {
    val zero = T.zero()
    if self.compare(&zero) < 0 { return zero.sub(self) }
    return self.clone()
}

/// -1, 0 or 1. Zero has sign 0.
@prelude
pub fun float64.sign(): float64 {
    if self > 0.0 { return 1.0 }
    if self < 0.0 { return -1.0 }
    return 0.0
}

/// Toward zero: 2.7 -> 2.0, -2.7 -> -2.0. Beyond int64's range every float is
/// already whole and is returned unchanged.
@prelude
pub fun float64.trunc(): float64 {
    if !fits_int64(self) { return self }
    return (self as int64) as float64
}

/// Toward negative infinity: 2.7 -> 2.0, -2.7 -> -3.0.
@prelude
pub fun float64.floor(): float64 {
    val t = self.trunc()
    if self < 0.0 && t > self { return t - 1.0 }
    return t
}

/// Toward positive infinity: 2.1 -> 3.0, -2.1 -> -2.0.
@prelude
pub fun float64.ceil(): float64 {
    val t = self.trunc()
    if self > 0.0 && t < self { return t + 1.0 }
    return t
}

/// Nearest integer, halves away from zero: 2.5 -> 3.0, -2.5 -> -3.0, so
/// `round(-x)` is `-round(x)`.
@prelude
pub fun float64.round(): float64 {
    if self < 0.0 { return 0.0 - (self.abs() + 0.5).floor() }
    return (self + 0.5).floor()
}

/// Within int64's range; the bound is 2^63 as a float64.
fun fits_int64(x: float64): bool {
    val limit = 9223372036854775808.0
    return x > (0.0 - limit) && x < limit
}

/// `a` and `b` within `tolerance` of each other: 0.1 + 0.2 is not 0.3.
@prelude
pub fun float64.close_to(other: float64, tolerance: float64): bool {
    return (self - other).abs() <= tolerance
}

/// `t` of 0 gives `a`, 1 gives `b`; outside [0, 1] it extrapolates.
@prelude
pub fun float64.lerp(other: float64, t: float64): float64 {
    return self + (other - self) * t
}
