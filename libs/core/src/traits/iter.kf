// Static iteration protocols. The cursor is an associated type chosen by the
// impl; its bound promises `next()`. Dispatch is monomorphized.
pub trait Iterator<T> {
    mutating fun next(): T?
}

/// What `while x in subject` dispatches on, found by key, not name.
@lang("iterable")
pub trait Iterable<T> {
    type Iter: Iterator<T>
    fun iter(): Self.Iter
}

/// Everything `first` yields, then everything `second` yields: `0..5` then
/// `8..10` visits 0-4 and 8-9.
///
/// CONSTRAINT: `T` is explicit: a type parameter reachable only through a
/// bound is not substituted at the use site.
pub struct Chain<A, B, T> {
    pub var first: A
    pub var second: B
    /// A latch: `first` is asked at most once past its end.
    pub var on_first: bool
}

impl Iterator<T> for Chain<A: Iterator<T>, B: Iterator<T>, T> {
    mutating fun next(): T? {
        if self.on_first {
            when (self.first.next()) {
                Some(x) => { return Option.Some(x) }
                None => { self.on_first = false }
            }
        }
        return self.second.next()
    }
}

/// Its own cursor, so `while x in a.chain(b)` works.
impl Iterable<T> for Chain<A: Iterator<T>, B: Iterator<T>, T> {
    type Iter = Chain<A, B, T>
    fun iter(): Chain<A, B, T> {
        return Chain<A, B, T> {
            first: self.first, second: self.second, on_first: self.on_first
        }
    }
}
