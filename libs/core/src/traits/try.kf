// The mechanism behind postfix `?`, which any type may implement.
//
// A bail carries a wrapper, `Option<Never>` or `Result<Never, E>`, not the bare
// error, so one type's residual is not accepted where another's belongs.
// `FromResidual` is separate so one type can absorb several residual shapes.

/// The type with no values: a `Branch` over `Never` is always the other arm.
///
/// CONSTRAINT: derives `Clone` vacuously; `?` on a `Result` goes through
/// `Result<Never, E>` and would otherwise report an unauthorized copy.
@derive(Clone)
pub enum Never { }

/// The two-way choice `?` makes: carry on with a payload, or bail with a
/// residual.
pub enum Branch<O, R> {
    Continue(O)
    Break(R)
}

/// A type `?` can be applied to.
pub trait Try {
    /// What `?` evaluates to when the value carries on.
    type Output
    /// What it bails with: a wrapper, not the bare error.
    type Residual
    /// Borrows the value, so what comes out is a copy of its payload.
    fun branch(): Branch<Self.Output, Self.Residual>
    /// Rebuild from a carried-on payload.
    static fun from_output(o: Self.Output): Self
}

/// Rebuild from a residual. Separate from `Try` so one type can absorb more
/// than one residual shape.
pub trait FromResidual<R> {
    static fun from_residual(r: R): Self
}
