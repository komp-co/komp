import core.assert.*
import core.range.*
import core.option.*

/// A `Chain` is not a `Range`, and no bound names both.
fun sum_chain_i32(c: Chain<RangeIter<int32>, RangeIter<int32>, int32>): int32 {
    var total = 0
    while v in c { total = total + v }
    return total
}

fun count_chain_i32(c: Chain<RangeIter<int32>, RangeIter<int32>, int32>): int32 {
    var n = 0
    while _v in c { n = n + 1 }
    return n
}

// Order, position by position: a sum passes a chain running backwards.
@test fun chain_visits_both_segments_in_order(): void {
    var i = 0
    while v in (0..3).chain(8..10) {
        if i == 0 { assert_eq(v, 0, "first segment starts") }
        if i == 1 { assert_eq(v, 1, "") }
        if i == 2 { assert_eq(v, 2, "first segment ends") }
        if i == 3 { assert_eq(v, 8, "second segment starts") }
        if i == 4 { assert_eq(v, 9, "second segment ends") }
        i = i + 1
    }
    assert_eq(i, 5, "0, 1, 2, 8, 9")
    assert_eq(sum_chain_i32((0..3).chain(8..10)), 20, "3 + 17")
}

// 6 and 7 are covered by no segment.
@test fun chain_leaves_the_gap_out(): void {
    var saw_gap: bool = false
    while v in (0..5).chain(8..10) {
        if v == 6 { saw_gap = true }
        if v == 7 { saw_gap = true }
    }
    assert_eq(saw_gap, false, "6 and 7 lie between the segments")
    assert_eq(count_chain_i32((0..5).chain(8..10)), 7, "0-4 and 8-9")
}

// Each segment keeps its own step, direction and inclusivity.
@test fun each_segment_keeps_its_own_shape(): void {
    assert_eq(sum_chain_i32((0..10).by(5).chain(range_inclusive(20, 21, 1))), 46,
        "0 + 5 + 20 + 21")
    var i = 0
    while v in (0..2).chain(range(9, 6, 1).down()) {
        if i == 2 { assert_eq(v, 9, "the descending segment starts at its top") }
        if i == 4 { assert_eq(v, 7, "and ends above its exclusive end") }
        i = i + 1
    }
    assert_eq(i, 5, "0, 1 then 9, 8, 7")
}

// An empty segment contributes nothing and does not stop the other one.
@test fun an_empty_segment_is_skipped(): void {
    assert_eq(sum_chain_i32((5..5).chain(1..4)), 6, "nothing, then 1 + 2 + 3")
    assert_eq(sum_chain_i32((1..4).chain(5..5)), 6, "1 + 2 + 3, then nothing")
    assert_eq(count_chain_i32((3..3).chain(3..3)), 0, "two empties are empty")
}

/// Resumes after reporting done: 7, nothing, then 42 forever. Legal, and what
/// makes `Chain`'s latch observable.
pub struct ResumingIter { pub var n: int32 }

impl Iterator<int32> for ResumingIter {
    mutating fun next(): int32? {
        self.n = self.n + 1
        if self.n == 1 { return Option.Some(7) }
        if self.n == 2 { return null }
        return Option.Some(42)
    }
}

@test fun an_exhausted_segment_is_never_asked_again(): void {
    val c = Chain<ResumingIter, RangeIter<int32>, int32> {
        first: ResumingIter { n: 0 }, second: (1..3).iter(), on_first: true
    }
    var seen = 0
    var guard = 0
    var saw_resumed: bool = false
    while v in c {
        if v == 42 { saw_resumed = true }
        seen = seen + 1
        guard = guard + 1
        if guard > 20 { break }
    }
    assert_eq(saw_resumed, false, "the latch stops `first` being re-asked")
    assert_eq(seen, 3, "7, then 1, 2")
}

// `Chain` nests over any two iterators.
@test fun chains_nest_to_a_third_segment(): void {
    val inner = (0..3).chain(8..10)
    val outer = Chain<Chain<RangeIter<int32>, RangeIter<int32>, int32>, RangeIter<int32>, int32> {
        first: inner, second: (15..17).iter(), on_first: true
    }
    var i = 0
    var total = 0
    while v in outer {
        if i == 0 { assert_eq(v, 0, "first segment") }
        if i == 3 { assert_eq(v, 8, "second segment") }
        if i == 5 { assert_eq(v, 15, "third segment") }
        i = i + 1
        total = total + v
    }
    assert_eq(i, 7, "0, 1, 2, 8, 9, 15, 16")
    assert_eq(total, 51, "3 + 17 + 31")
}
