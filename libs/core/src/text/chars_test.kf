// "héllo" is 6 bytes and 5 characters, disagreeing from index 1.

import core.assert.assert_eq
import core.text.*

@test fun characters_are_counted_not_bytes(): void {
    assert_eq("hello".char_count(), 5, "ASCII agrees with the byte count")
    assert_eq("hello".byte_len(), 5, "and so it should")
    assert_eq("héllo".char_count(), 5, "five characters")
    assert_eq("héllo".byte_len(), 6, "six bytes -- this is the whole point")
    assert_eq("".char_count(), 0, "empty")
    assert_eq("日本語".char_count(), 3, "three characters")
    assert_eq("日本語".byte_len(), 9, "nine bytes")
}

@test fun chars_walks_every_character_once(): void {
    var seen = 0
    while _ in "héllo".chars() { seen = seen + 1 }
    assert_eq(seen, 5, "one step per character, not per byte")
}

@test fun char_at_indexes_characters_not_bytes(): void {
    assert_eq("héllo".char_at(0) == 'h', true, "first")
    // Byte 1 is the first byte of `é`; character 1 is `é` itself.
    assert_eq("héllo".char_at(1) == 'é', true, "the one a byte offset would split")
    assert_eq("héllo".char_at(4) == 'o', true, "last")
    assert_eq("héllo".char_at(99) == (0 as char), true, "past the end is 0, like byte_at")
}

// A byte offset, as `index_of` answers in.
@test fun decode_at_takes_a_byte_offset_and_reports_the_width(): void {
    val d = "héllo".decode_at(1)
    assert_eq(d.scalar == 'é', true, "the scalar starting at byte 1")
    assert_eq(d.width, 2, "two bytes wide")
    assert_eq(d.well_formed, true, "well formed")
    assert_eq("héllo".decode_at(0).width, 1, "ASCII is one byte")
}

@test fun a_character_encodes_back_to_its_bytes(): void {
    assert_eq('A'.encode_utf8().width, 1, "ASCII")
    assert_eq('é'.encode_utf8().width, 2, "two bytes")
    assert_eq('日'.encode_utf8().width, 3, "three bytes")
    // A surrogate is not encodable.
    assert_eq((55296 as char).encode_utf8().width, 0, "a surrogate encodes to nothing")
}

@test fun classification_reads_as_classification(): void {
    assert_eq('7'.is_digit(), true, "digit")
    assert_eq('x'.is_digit(), false, "not a digit")
    assert_eq('x'.is_alpha(), true, "letter")
    assert_eq('X'.is_upper(), true, "upper")
    assert_eq('x'.is_lower(), true, "lower")
    assert_eq('x'.is_alnum(), true, "alphanumeric")
    assert_eq(' '.is_space(), true, "space")
    assert_eq('\n'.is_space(), true, "newline")
    assert_eq('x'.is_space(), false, "not a space")
    assert_eq('x'.to_upper() == 'X', true, "to upper")
    assert_eq('X'.to_lower() == 'x', true, "to lower")
}

@test fun classification_is_ascii_and_says_so(): void {
    assert_eq('é'.is_alpha(), false, "a letter, but not an ASCII one")
    assert_eq('é'.to_upper() == 'é', true, "passes through unchanged rather than wrongly")
    assert_eq('日'.is_alnum(), false, "not ASCII alphanumeric")
}

@test fun a_digits_value_is_a_number_or_nothing(): void {
    when ('7'.digit_value()) {
        Some(v) => { assert_eq(v, 7, "seven") }
        None => { assert_eq(true, false, "a digit has a value") }
    }
    when ('x'.digit_value()) {
        Some(v) => { assert_eq(true, false, "a letter has none") }
        None => { assert_eq(true, true, "and says so rather than picking a number") }
    }
}
