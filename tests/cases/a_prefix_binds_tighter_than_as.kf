//! run: exit 42
//! deps: core
// `&x as T` is `(&x) as T` and `*p as T` is `(*p) as T`: a prefix `&`,
// `&var` or `*` binds tighter than `as`.

fun main(): int32 {
    var x: int32 = 30
    val p = unsafe { &var x as Ptr<int32> }
    unsafe { *p = 40 }
    val q = unsafe { &x as Ptr<int32> }
    val wide = unsafe { *q as int64 }
    return (wide + 2) as int32
}
