//! run: exit 0
//! deps: core, alloc
// A lambda block yields the value of its trailing `when` or `if`, through
// every arm; a `when` whose arms are statements leaves it `void`.

import alloc.list.*

fun apply<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }

fun name_of<F: Call1<int32>>(f: F, x: int32): String { return f.call(x) }

fun main(): int32 {
    val bonus = 5
    val by_when = apply(|x: int32| {
        val doubled = x * 2
        when doubled {
            24 => 1
            v if v > 100 => 2
            _ => bonus
        }
    }, 12)
    if by_when != 1 { return 1 }
    val by_if = apply(|x: int32| {
        if x > 10 { x - 10 } else { 0 }
    }, 15)
    if by_if != 5 { return 2 }
    val nested = apply(|x: int32| {
        when x {
            0 => 0
            _ => {
                if x < 0 { -1 } else { bonus }
            }
        }
    }, 3)
    if nested != 5 { return 3 }
    val word = name_of(|x: int32| {
        when x {
            1 => String.from("one")
            _ => String.from("many")
        }
    }, 1)
    if !word.equals("one") { return 4 }
    var seen = List.new<int32>()
    val xs = List.new<int32>()
    seen.push(0)
    // A `when` whose arms are statements keeps the lambda `void`.
    val count = apply(|x: int32| {
        when x {
            1 => xs.size()
            _ => { }
        }
        x
    }, 7)
    if count != 7 { return 5 }
    return 0
}
