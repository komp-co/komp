//! run: exit 41
//! deps: core
// `swap` on `Pair<A, B>` builds a `Pair<B, A>`: each parameter is replaced
// once, not again by the argument the other one became.

import core.display.println

struct Pair<A, B> {
    var first: A
    var second: B
}

impl Pair<A: Clone, B: Clone> {
    fun swap(): Pair<B, A> {
        return Pair<B, A> { first: self.second, second: self.first }
    }
}

fun main(): int32 {
    val p = Pair<int32, bool> { first: 1, second: true }
    val q = p.swap()
    println(q.second)
    val r = q.swap()
    return if q.first { r.first + 40 } else { 0 }
}
