//! build: fail
//! deps: core, alloc
// One arm borrows `owned`, which the function drops at the return.

fun pick(x: int32): str {
    val owned = String.from("local")
    val word = when (x) {
        0 => "zero"
        _ => owned.as_str()
    }
    return word
}

fun main(): int32 {
    return pick(1).byte_len() as int32
}
