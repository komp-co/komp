//! run: exit 3
//! deps: core, alloc
// The right of `&&` or `||` runs only when the left does not decide, even
// when it makes a temporary that must be dropped.

struct Counter {
    var calls: int32
}

fun counted(c: &var Counter): List<int32> {
    c.calls = c.calls + 1
    return List.new<int32>()
}

fun main(): int32 {
    var c = Counter { calls: 0 }
    val ready = false
    if ready && counted(&var c).size() == 0 { return 10 }
    val done = true
    if done || counted(&var c).size() == 0 { c.calls = c.calls + 1 }
    val both = !ready && counted(&var c).is_empty()
    if both { c.calls = c.calls + 1 }
    return c.calls
}
