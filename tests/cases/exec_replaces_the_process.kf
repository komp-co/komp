//! run: exit 7
//! deps: core, alloc, std
// `exec` hands the process to the program: its exit code is the process's,
// and nothing after the call runs.

fun main(): int32 {
    var command = Command.new("/bin/sh")
    command.arg("-c")
    command.arg("exit 7")
    val _failed = command.exec()
    return 1
}
