//! run: exit 9
//! deps: core
// A `str` bound from a `when` or `if` value of literals borrows nothing the
// function owns, so it can be returned.

fun label(x: int32): str {
    val word = when (x) {
        0 => "zero"
        _ => "many"
    }
    return word
}

fun sign(x: int32): str {
    val word = if x < 0 { "minus" } else { "plus" }
    return word
}

fun main(): int32 {
    return (label(0).byte_len() + sign(1).byte_len()) as int32 + 1
}
