//! run: exit 9
//! deps: core
// `val b: Box2<int64> = Box2 { v: 5 }` reads `T` off the annotation, so the
// literal `5` is an `int64` and `null` an `int32?`.

struct Box2<T> {
    var v: T
}

fun main(): int32 {
    val b: Box2<int64> = Box2 { v: 5 }
    val o: Box2<int32?> = Box2 { v: null }
    val p: Box2<int32> = Box2 { v: 2 }
    return (b.v + 2) as int32 + (o.v ?: 0) + p.v
}
