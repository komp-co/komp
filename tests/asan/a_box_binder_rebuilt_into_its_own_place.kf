//! asan: clean
// Rebuilding a payload around its own `Box` binder copies the box: the old
// payload is freed by the store, so sharing the pointer would free it twice.

import alloc.list.*

enum Kind {
    Impl(Box<String>, List<String>)
    Empty
}

struct Decl {
    pub var kind: Kind
}

fun renamed(items: &List<String>): List<String> {
    var out = List.new<String>()
    while item in &items { out.push("${item}2") }
    return out
}

mutating fun Decl.stamp(): void {
    when (self.kind) {
        Impl(head, items) => {
            val fresh = renamed(&items)
            self.kind = Kind.Impl(head, fresh)
        }
        Empty => return
    }
}

fun Decl.head_len(): uint64 {
    return when (self.kind) {
        Impl(head, _) => head.byte_len()
        Empty => 0
    }
}

fun main(): int32 {
    var items = List.new<String>()
    items.push(String.from("a"))
    var d = Decl { kind: Kind.Impl(Box.new(String.from("head")), items) }
    d.stamp()
    d.stamp()
    if d.head_len() != 4 { return 1 }
    return 0
}
