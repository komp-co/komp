//! asan: clean
// A field picked by an if-expression is a view of its owner, as a field
// read bound directly is, so the owner's drop alone frees it.

struct Params {
    val lints: List<String>
    val options: List<String>
}

fun read(): Params? {
    var lints = List.new<String>()
    lints.push(String.from("dead_code=allow"))
    return Option.Some(Params { lints: lints, options: List.new<String>() })
}

fun rows_of(field: str): uint64 {
    val params = read() ?: return 0
    val rows = if field == "lints" { params.lints } else { params.options }
    var n: uint64 = 0
    while row in &rows { n = n + row.byte_len() }
    return n
}

fun main(): int32 {
    return rows_of("lints") as int32 - 15
}
