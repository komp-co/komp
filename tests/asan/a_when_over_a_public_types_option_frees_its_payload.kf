//! asan: clean
// A public type's `Option` instance is laid out in the crate's header, and
// an arm binding its payload still drops what it binds.

pub struct Entry {
    pub val name: String
}

pub struct Table {
    pub val entries: List<Entry>
}

impl Table {
    pub fun find(name: str): Entry? {
        while e in &self.entries {
            if e.name.as_str() == name { return Option.Some(Entry { name: e.name.clone() }) }
        }
        return Option.None
    }
}

fun found(table: &Table): bool {
    when (table.find("a")) {
        Some(_entry) => return true
        None => return false
    }
}

fun main(): int32 {
    var entries = List.new<Entry>()
    entries.push(Entry { name: String.from("a") })
    val table = Table { entries: entries }
    var hits = 0
    while _i in 0..4 {
        if found(&table) { hits = hits + 1 }
    }
    return 4 - hits
}
